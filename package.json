{
  "name": "astro-brand-template",
  "type": "module",
  "version": "1.0.0",
  "description": "A complete Astro brand template with e-commerce, blog, and GDPR compliance",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run validate:data && npm run test:locks && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate:data": "node --experimental-strip-types scripts/validate-data.ts",
    "test:locks": "node --experimental-strip-types scripts/test-nested-locks.ts",
    "build:gradients": "node scripts/build-gradients.mjs",
    "build:text-paths": "node scripts/build-text-paths.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@iconify/json": "^2.2.417",
    "@material/material-color-utilities": "^0.3.0",
    "@supabase/supabase-js": "^2.93.3",
    "apca-w3": "^0.1.9",
    "astro": "^5.18.0",
    "astro-icon": "^1.1.5",
    "chroma-js": "^3.2.0",
    "googleapis": "^166.0.0",
    "gsap": "^3.13.0",
    "imagesloaded": "^5.0.0",
    "isotope-layout": "^3.0.6",
    "lottie-web": "^5.13.0",
    "matter-js": "^0.20.0",
    "overlayscrollbars": "^2.14.0",
    "resend": "^6.5.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@phosphor-icons/core": "^2.1.1",
    "@types/imagesloaded": "^4.1.7",
    "@types/isotope-layout": "^3.0.15",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^25.1.0",
    "bliss-svg-builder": "^0.1.0-alpha.20",
    "opentype.js": "^2.0.0",
    "potrace": "^2.1.8",
    "typescript": "^5.6.0",
    "wrangler": "^4.69.0"
  }
}
