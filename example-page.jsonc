// EXAMPLE PAGE — the layout engine end to end.
// Regenerated from the canonical row shape pinned in LAYOUT-ENGINE-SPEC.md §2.2.
//
// Every author-set value here is a FINITE ENUM (validatable). Nothing is a free
// number or string. Columns, pixel sizes, wrapping and reflow are all COMPUTED
// by the engine — the author never writes them.
//
// Shape, top to bottom: a container holds "rows"; each row is an OBJECT
//   { "items": [ ...items ], "distribution": "grid" }   (distribution optional, default grid)
// Page holds rows of Sections; a Section holds rows of Cards/atoms; a Card holds
// rows of atoms. Same shape at every level.
//
// NOTE on Image: src/alt below are SIMPLIFIED for legibility. The real Image atom
// uses the alt-text suite (altWord / altDescriptive, content/label convention) —
// don't copy `alt:` / `src:` verbatim as the atom's real props.
//
// (.jsonc = JSON with comments, for reading. Real data file is plain .json.)

{
  "component": "Page",
  "gap": "2xl",                          // enum: none|xs|sm|md|lg|xl|2xl|3xl
  "rows": [

    // ── ROW 1: the hero. One section, full-bleed band. ──────────────────
    {
      "items": [
        {
          "component": "Section",        // Page cell-content enum = [Section] only
          "weight": "large",             // its share of the page row (enum: small|medium|large)
          "width": "full",              // content width INSIDE the band (enum: prose|standard|wide|full)
          "color": "primary",           // existing Section colour enum
          "rows": [
            // single-item rows → one column (the degenerate grid)
            { "items": [ { "component": "Heading", "weight": "large", "contentHeading": "Welcome to the Shop" } ] },
            { "items": [ { "component": "Text", "weight": "medium", "contentText": "Everything hand-made, built to last." } ] },
            { "items": [ { "component": "Button", "weight": "small", "contentButton": "Browse products", "variant": "fill" } ] }
          ]
        }
      ]
    },

    // ── ROW 2: the product gallery. One section holding a grid of 3 cards. ──
    {
      "items": [
        {
          "component": "Section",
          "weight": "large",
          "width": "wide",              // wide content band for a gallery
          "rows": [
            { "items": [ { "component": "Heading", "weight": "medium", "contentHeading": "Our Products" } ] },

            // MANY items → a grid (distribution defaults to "grid"): equal columns,
            // count from the capacity table. 3 medium cards in a wide section = 3
            // across, reflowing to 1 across on mobile automatically (each card
            // measures its own width).
            {
              "items": [

                // ---- CARD 1 ----
                {
                  "component": "Card",
                  "weight": "medium",    // "card size" IS its weight in this row (D1)
                  "rows": [
                    { "items": [ { "component": "Image", "weight": "large", "mediaMode": "inline", "src": "/img/mug.jpg", "alt": "Stoneware mug", "fit": "cover" } ] },
                    { "items": [ { "component": "Heading", "weight": "medium", "contentHeading": "Stoneware Mug" } ] },
                    // FOOTER: badge left, price right. distribution is a SIBLING of
                    // items; in a content-sized row weight is ignored, so it's omitted.
                    {
                      "items": [
                        { "component": "Badge", "contentBadge": "New" },
                        { "component": "Text", "contentText": "£18" }
                      ],
                      "distribution": "between"
                    }
                  ]
                },

                // ---- CARD 2 ----
                {
                  "component": "Card",
                  "weight": "medium",
                  "rows": [
                    { "items": [ { "component": "Image", "weight": "large", "mediaMode": "inline", "src": "/img/bowl.jpg", "alt": "Ceramic bowl", "fit": "cover" } ] },
                    { "items": [ { "component": "Heading", "weight": "medium", "contentHeading": "Ceramic Bowl" } ] },
                    {
                      "items": [
                        { "component": "Badge", "contentBadge": "Sale" },
                        { "component": "Text", "contentText": "£24" }
                      ],
                      "distribution": "between"
                    }
                  ]
                },

                // ---- CARD 3 ----
                {
                  "component": "Card",
                  "weight": "medium",
                  "rows": [
                    { "items": [ { "component": "Image", "weight": "large", "mediaMode": "inline", "src": "/img/jug.jpg", "alt": "Glazed jug", "fit": "cover" } ] },
                    { "items": [ { "component": "Heading", "weight": "medium", "contentHeading": "Glazed Jug" } ] },
                    {
                      "items": [
                        { "component": "Badge", "contentBadge": "Last one" },
                        { "component": "Text", "contentText": "£32" }
                      ],
                      "distribution": "between"
                    }
                  ]
                }

              ]
            }
          ]
        }
      ]
    },

    // ── ROW 3: a feature section — text beside an image (two items, one row). ──
    {
      "items": [
        {
          "component": "Section",
          "weight": "large",
          "width": "standard",
          "rows": [
            // TWO items in a row → grid, 2 equal columns. Reflows to 1 (stacked)
            // on mobile for free — each item measures itself.
            {
              "items": [
                { "component": "Image", "weight": "medium", "mediaMode": "inline", "src": "/img/workshop.jpg", "alt": "The workshop", "fit": "cover" },
                { "component": "Text", "weight": "medium", "contentText": "Each piece is thrown by hand in our studio and fired twice." }
              ]
            }
          ]
        }
      ]
    }

  ]
}
