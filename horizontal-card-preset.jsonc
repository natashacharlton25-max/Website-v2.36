// HORIZONTAL CARD — defined as a PRESET
// ============================================================
// Two layers. Read them in order.
//
//   LAYER 1 (this file, top): what YOU — the platform designer — define ONCE.
//   All the balance decisions live here: which cells, hug-or-fill, vertical
//   placement. You think hard about this exactly once, per card type.
//
//   LAYER 2 (this file, bottom): what the AUTHOR / AI writes every time.
//   Just a card-type name + content. No sizing. No placement. No weight.
//
// The whole point: the complexity is in Layer 1 (built once), so Layer 2
// (used constantly) is almost nothing.


// ============================================================
// LAYER 1 — THE PRESET DEFINITION  (you write this once, ever)
// ============================================================
// "What does a horizontal card MEAN?" Answered once, frozen.

{
  "preset": "card-horizontal",

  // The card is one row: three cells, left to right.
  "row": {
    "items": [

      // CELL 1 — the image. Hugs its own width (doesn't stretch).
      {
        "slot": "image",          // ← author fills this named slot
        "accepts": "Image",       // only an Image can go here (enum-guarded)
        "sizing": "content"       // hug content width (the "auto" behaviour)
      },

      // CELL 2 — the middle. Fills the remaining width. Holds TWO stacked rows.
      {
        "slot": "middle",
        "sizing": "fill",         // take all remaining space (the "1fr" behaviour)
        "vertical": "start",      // content sits at the TOP of the (tall) cell
        "rows": [
          { "items": [ { "slot": "meta", "accepts": "Text", "style": "small-muted" } ] },
          { "items": [ { "slot": "body", "accepts": "Text" } ] }
        ]
      },

      // CELL 3 — the button. Hugs its label. Centred vertically against the image.
      {
        "slot": "button",
        "accepts": "Button",
        "sizing": "content",      // hug the label width
        "vertical": "center"      // centred against the tall image's height
      }

    ],
    "equalHeight": true           // all three cells match the tallest (the image)
  }
}

// Notice everything that's DECIDED here, once:
//  - three cells, in order (image | middle | button)
//  - image and button hug their content; middle fills the rest  → widths balanced
//  - equalHeight true                                            → heights matched
//  - middle content at top, button centred                       → vertical placement
//  - the middle is itself two stacked rows (meta over body)      → nested rows
//  - which atom each slot accepts                                → enum-guarded
//
// The author never sees any of this. It IS "horizontal card".


// ============================================================
// LAYER 2 — WHAT THE AUTHOR / AI ACTUALLY WRITES  (every time)
// ============================================================
// Pick the card type. Fill the named slots with content. That's all.

{
  "card": "card-horizontal",
  "image":  { "src": "/img/mug.jpg", "alt": "Stoneware mug" },
  "meta":   "In stock",
  "body":   "Hand-thrown stoneware mug, glazed in slate blue.",
  "button": { "contentButton": "Add to cart", "href": "/cart/add/mug" }
}

// That's the whole author input. Five lines of content.
//
// No sizing. No vertical placement. No weight. No measuring. No columns.
// The card is balanced (image left, meta-over-body filling the middle, button
// right centred), responsive (reflows/stacks on narrow screens), and
// unbreakable (each slot only accepts its declared atom) — because Layer 1
// already decided all of that, once.
//
// Want a different arrangement? That's a different PRESET (card-product,
// card-profile, card-feature) — you define each once, the author picks one
// and fills content. The author's job never gets harder than the five lines
// above.
