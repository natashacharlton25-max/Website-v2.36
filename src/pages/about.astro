---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/organisms/sections/HeroSection.astro';
import StorySection from '../components/organisms/sections/StorySection.astro';
import ImageTextSection from '../components/organisms/sections/ImageTextSection.astro';
import PhilosophyFlipCardsSection from '../components/organisms/sections/PhilosophyFlipCardsSection.astro';
import ValuesSection from '../components/organisms/sections/ValuesSection.astro';
import CTASection from '../components/organisms/sections/CTASection.astro';
import Footer from '../components/organisms/Footer/Footer.astro';

// ── Test: new composition components ────────────────────────────────────────
import ScrollMorphZone from '../components/organisms/ScrollMorph/ScrollMorphZone.astro';
import ConnectorTimeline from '../components/molecules/effects/ConnectorTimeline/ConnectorTimeline.astro';
import LiquidRevealZone from '../components/molecules/effects/LiquidReveal/LiquidRevealZone.astro';
import ScrollDrawIcon from '../components/atoms/effects/ScrollDrawIcon/ScrollDrawIcon.astro';
import ParallaxDecor from '../components/atoms/effects/ParallaxDecor/ParallaxDecor.astro';

// Image imports from src/PageImages for Astro optimization
import heroImage from '../PageImages/About/Hero/Hero.png';
import purposeImage from '../PageImages/About/Purpose/What-We-Do.png';
import youFirstImage from '../PageImages/About/Philosophy/You-First.png';
import yourChoicesImage from '../PageImages/About/Philosophy/Your-Choices.png';
import actuallyWorksImage from '../PageImages/About/Philosophy/Actually-Works.png';

// Import JSON data
import heroDataRaw from '../data/about/hero.json';
import storyDataRaw from '../data/about/story.json';
import purposeDataRaw from '../data/about/purpose.json';
import philosophyDataRaw from '../data/about/philosophy.json';
import valuesDataRaw from '../data/about/values.json';
import finalCTADataRaw from '../data/about/final-cta.json';

// Type assertions
const heroData = heroDataRaw as {
  title: string;
  subtitle: string;
  image: string;
  imageAlt: string;
  imagePosition: 'full';
};

const storyData = storyDataRaw as {
  title: string;
  image: string;
  imageAlt: string;
  content: string[];
};

const purposeData = purposeDataRaw as {
  title: string;
  content: string[];
  image: string;
  imageAlt: string;
  imagePosition: 'left';
};

const philosophyData = philosophyDataRaw as typeof philosophyDataRaw;
const valuesData = valuesDataRaw as typeof valuesDataRaw;

const finalCTAData = finalCTADataRaw as {
  title: string;
  content: string[];
  buttons: Array<{ text: string; href: string; variant: 'primary' | 'secondary' }>;
};

// Map philosophy pillar images
const philosophyImages = [youFirstImage, yourChoicesImage, actuallyWorksImage];
---

<BaseLayout
  title="About | Walking With A Smile"
  description="We've walked parts of this journey too. Learn about our story and why we created Walking with a Smile."
  hideFooter={true}
>
  <!-- Hero with Full-Width Image -->
  <HeroSection
    title={heroData.title}
    subtitle={heroData.subtitle}
    variant="image"
    image={heroImage}
    imageAlt={heroData.imageAlt}
    imagePosition={heroData.imagePosition}
  />

  <!-- CTA Section -->
  <CTASection
    title={finalCTAData.title}
    description={finalCTAData.content}
    buttons={finalCTAData.buttons}
  />

  <!-- Our Story -->
  <StorySection
    title={storyData.title}
    content={storyData.content}
    icon="heart-fill"
  />

  <!-- What We're Here To Do -->
  <ImageTextSection
    title={purposeData.title}
    content={purposeData.content}
    image={purposeImage}
    imageAlt={purposeData.imageAlt}
    imagePosition={purposeData.imagePosition}
  />

  <!-- How We See Things - Philosophy Flip Cards -->
  <PhilosophyFlipCardsSection
    title={philosophyData.title}
    intro={philosophyData.intro}
    pillars={philosophyData.pillars}
    pillarImages={philosophyImages}
  />

  <!-- What Matters To Us - Values -->
  <ValuesSection
    title={valuesData.title}
    values={valuesData.values}
    icon="star-fill"
  />

  <!-- ── TEST: ScrollMorphZone ─────────────────────────────────────────── -->
  <ScrollMorphZone
    patternIcon="wellness/heart-fill"
    patternScale={120}
    patternOpacity={0.25}
    sections={[
      {
        bg: 'var(--zone-bg-primary-deep)',
        pattern: 'var(--zone-pattern-secondary)',
        icon: 'wellness/heart-fill',
        title: 'Awareness',
        body: 'Recognise your patterns with compassion.',
        decor: {
          rings: [{ size: 'lg', depth: 0.3 }, { size: 'sm', depth: 0.8, top: '20%', right: '10%' }],
          dots: [{ depth: 2.0, bottom: '25%', right: '15%' }],
        },
      },
      {
        bg: 'var(--zone-bg-earth)',
        pattern: 'var(--zone-pattern-primary-vivid)',
        icon: 'creative/star-fill',
        title: 'Understanding',
        body: 'Connect the dots between past and present.',
      },
      {
        bg: 'var(--zone-bg-forest)',
        pattern: 'var(--zone-pattern-earth)',
        icon: 'nature/flower-lotus-fill',
        title: 'Integration',
        body: 'Weave new patterns into your daily life.',
      },
    ]}
  />

<!-- Footer with Interactive Mask -->
  <Footer animated />
</BaseLayout>
