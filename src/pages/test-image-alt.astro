---
/**
 * Test page for Image atom alt text refactor.
 * Verifies three rendering modes:
 *   1. Content image with assetId (API alt data)
 *   2. Content image without assetId (manual alt)
 *   3. Decorative image (bare <img>)
 *
 * Delete this page after verification.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Image from '../components/atoms/images/Image/Image.astro';
---

<BaseLayout title="Image Alt Text Test">
  <div style="max-width: 800px; margin: 80px auto; padding: 2rem;">
    <h1>Image Alt Text Test</h1>

    <h2>1. Content image with assetId</h2>
    <p>Should render <code>&lt;figure&gt;</code> with hidden alt spans (word, descriptive, aac).</p>
    <Image src="/images/placeholder.jpg" assetId="test-sunset" />

    <h2>2. Content image without assetId</h2>
    <p>Should render <code>&lt;figure&gt;</code> with just the img, no hidden spans.</p>
    <Image src="/images/placeholder.jpg" alt="Manual alt text" />

    <h2>3. Decorative image (role prop)</h2>
    <p>Should render bare <code>&lt;img&gt;</code> with alt="" and aria-hidden.</p>
    <Image src="/images/placeholder.jpg" role="decorative" />

    <h2>4. Decorative image (deprecated boolean)</h2>
    <p>Should render same as #3 — bare <code>&lt;img&gt;</code> via deprecated alias.</p>
    <Image src="/images/placeholder.jpg" decorative />
  </div>
</BaseLayout>
