---
/**
 * Insight/Blog Post Page
 * Dynamic page for individual insight articles
 * Prerendered - generates static HTML during build
 */
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import InsightHeader from '../../components/molecules/insights/InsightHeader.astro';
import InsightContent from '../../components/molecules/insights/InsightContent.astro';
import InsightAuthorSection from '../../components/Insights/InsightAuthorSection.astro';
import ForYouGrid from '../../components/organisms/grids/ForYouGrid.astro';
import Footer from '../../components/organisms/Footer/Footer.astro';
import ShareSection from '../../components/organisms/sections/ShareSection.astro';
import {
  getSuggestedContent,
  formatForRelatedGrid,
  getSlugFromId
} from '../../lib/utils/related-content';

// Generate static paths for all insights
export async function getStaticPaths() {
  const insightEntries = await getCollection('insights');
  return insightEntries.map(entry => ({
    params: { slug: getSlugFromId(entry.id) },
    props: { entry }
  }));
}

// Get entry from props (prerendered)
const { entry } = Astro.props;
const slug = Astro.params.slug;

// Fetch all insights for related content
const allInsights = await getCollection('insights');

// Redirect if not found (shouldn't happen with prerender)
if (!entry) {
  return Astro.redirect('/insights');
}
const { Content } = await entry.render();
const { linkedAssets } = entry.data;

// Calculate read time
const wordsPerMinute = 200;
const wordCount = entry.body.split(/\s+/).length;
const readTime = `${Math.ceil(wordCount / wordsPerMinute)} min read`;

// Get author data from authors collection
const authorSlug = entry.data.author;
const allAuthors = await getCollection('authors');
const authorEntry = allAuthors.find(a => getSlugFromId(a.id) === authorSlug);
const author = authorEntry?.data;

// Get suggested posts using smart content matching
// Priority: tag similarity > same category > latest posts (fallback)
const suggestedEntries = getSuggestedContent(entry, allInsights, {
  maxItems: 3,
  getSlug: (item) => getSlugFromId(item.id)
});
const suggestedPosts = formatForRelatedGrid(suggestedEntries, (item) => getSlugFromId(item.id));

// Get assets collection to look up card images for linked resources
const allAssets = await getCollection('assets');

// Format linked assets for RelatedGrid - look up card images from assets collection
const formattedResources = linkedAssets?.map((asset: { title: string; description?: string; url: string; type?: string }) => {
  // Extract slug from URL (e.g., "/assets/clarity-worksheet" → "clarity-worksheet")
  const urlParts = asset.url.split('/').filter(Boolean);
  const assetSlug = urlParts[urlParts.length - 1];

  // Find matching asset in collection
  const matchedAsset = allAssets.find(a => getSlugFromId(a.id) === assetSlug);

  return {
    title: asset.title,
    description: asset.description,
    url: asset.url,
    type: asset.type || 'Resource',
    cardImage: matchedAsset?.data.cardImage as ImageMetadata | undefined
  };
}) || [];

// Combine resources and posts into one mixed array
// Resources first, then posts - all using the same card style with badges to differentiate
const combinedRecommendations = [
  ...formattedResources,
  ...suggestedPosts.map(post => ({
    slug: post.slug,
    title: post.title,
    description: post.description,
    category: post.category,
    cardImage: post.cardImage as ImageMetadata | undefined
  }))
];
---

<BaseLayout
  title={entry.data.seoTitle || entry.data.title}
  description={entry.data.seoDescription || entry.data.description}
  image={entry.data.cardImage.src}
  hideFooter={true}
>
  <article class="insight-article">
    <InsightHeader
      title={entry.data.title}
      description={entry.data.description}
      publishDate={entry.data.publishDate}
      authorName={author?.name || entry.data.author}
      readTime={readTime}
      tags={entry.data.tags}
      heroImage={entry.data.cardImage}
    />

    <InsightContent>
      <Content />
    </InsightContent>
  </article>

  {author && (
    <InsightAuthorSection
      name={author.name}
      photo={author.photo}
      role={author.role}
      bio={author.bio}
      credentials={author.credentials}
      specialties={author.specialties}
      signature={author.signature}
      signatureText={author.signatureText}
    />
  )}

  <!-- Share Section -->
  <ShareSection />

  {combinedRecommendations.length > 0 && (
    <ForYouGrid
      items={combinedRecommendations}
      basePath="/insights"
      maxItems={6}
    />
  )}

  <Footer animated />
</BaseLayout>


