---
/**
 * Rainbow & Gradient Visual Test
 *
 * Comprehensive side-by-side comparison of every gradient definition,
 * rendered on both SVG atoms (Shape) and CSS atoms (Badge). If a gradient
 * looks different between Shape and Badge, that's a drift bug to fix.
 *
 * Page is fully data-driven from rainbow-gradients.json. To add a new
 * gradient or test variant, edit the JSON — no Astro changes needed.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Renderer from '../../components/Renderer.astro';
import data from '../../data/test/rainbow-gradients.json';
---

<BaseLayout title="Rainbow & Gradient Visual Test">
  <Renderer node={data} />
</BaseLayout>
