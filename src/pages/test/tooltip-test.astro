---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Tooltip } from '../../components/atoms/Tooltip';
import { Badge } from '../../components/atoms/Badge';
import { Heading } from '../../components/atoms/Heading';
import { Section } from '../../components/atoms/Section';

import testData from '../../data/test/tooltip.json';
---

<BaseLayout title={testData.page.title} hideFooter={testData.page.hideFooter}>
  <Section container={testData.page.container} gap={testData.layout.sectionGap}>

    <Heading level={testData.title.level as any} align={testData.title.align as any} flush={testData.title.flush}>{testData.title.text}</Heading>

    {testData.sections.map((section: any) => (
      <Section label={section.label} separator gap={testData.layout.itemGap}>
        <div style="display:flex;flex-wrap:wrap;gap:var(--space-xl);align-items:center;padding:var(--space-2xl) 0;">
          {section.items.map((item: any) => (
            <div class="render-full">
              <Tooltip
                text={item.text}
                aac={item.aac !== false}
                purpose={item.purpose || "label"}
                position={item.position || "top"}
              >
                <Badge label={item.triggerLabel} variant="fill" />
              </Tooltip>
            </div>
          ))}
        </div>
        <div class="render-textonly">
          {section.items.map((item: any) => (
            <Tooltip
              text={item.text}
              aac={item.aac !== false}
              purpose={item.purpose || "label"}
              position={item.position || "top"}
            >
              <span>{item.triggerLabel}</span>
            </Tooltip>
          ))}
        </div>
      </Section>
    ))}

  </Section>
</BaseLayout>
