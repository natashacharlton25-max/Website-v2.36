---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Side-effect imports so .btn / variants get their full styling on this
// preview page (Button atom is normally instantiated via Renderer, which
// triggers these via its index.ts barrel).
import '../../components/atoms/Button/Button.css';
import '../../components/atoms/Button/Button.responsive.css';
import '../../styles/test/split-preview.css';
---

<BaseLayout title="Split effect preview">
  <main class="container container-7xl" style="padding: var(--space-3xl) var(--space-lg);">
    <h1 style="margin-bottom: var(--space-2xl); font-family: var(--font-heading); font-weight: 700;">
      Split effect — preview
    </h1>

    <p style="margin-bottom: var(--space-xl); max-width: 50ch; color: var(--color-Text);">
      Two semi-transparent panels grow inward from left + right edges and meet in the middle on hover. Pseudo-element implementation — no box-shadow conflicts with variant chrome.
    </p>

    <div style="display: flex; flex-wrap: wrap; gap: var(--space-md); margin-bottom: var(--space-2xl);">
      <button type="button" class="btn btn--fill btn--primary btn--rounded btn--split-preview">
        <span class="text text--flush btn__label">
          <span class="text__content">Fill primary</span>
        </span>
      </button>

      <button type="button" class="btn btn--fill btn--secondary btn--rounded btn--split-preview">
        <span class="text text--flush btn__label">
          <span class="text__content">Fill secondary</span>
        </span>
      </button>

      <button type="button" class="btn btn--outline btn--primary btn--rounded btn--split-preview">
        <span class="text text--flush btn__label">
          <span class="text__content">Outline primary</span>
        </span>
      </button>

      <button type="button" class="btn btn--ghost btn--primary btn--rounded btn--split-preview">
        <span class="text text--flush btn__label">
          <span class="text__content">Ghost</span>
        </span>
      </button>

      <button type="button" class="btn btn--glass btn--primary btn--rounded btn--split-preview">
        <span class="text text--flush btn__label">
          <span class="text__content">Glass</span>
        </span>
      </button>

      <button type="button" class="btn btn--liquid-glass btn--primary btn--rounded btn--split-preview">
        <span class="text text--flush btn__label">
          <span class="text__content">Liquid glass</span>
        </span>
      </button>

      <button type="button" class="btn btn--glassic btn--primary btn--rounded btn--split-preview">
        <span class="text text--flush btn__label">
          <span class="text__content">Glassic</span>
        </span>
      </button>

      <button type="button" class="btn btn--glow btn--primary btn--rounded btn--split-preview">
        <span class="text text--flush btn__label">
          <span class="text__content">Glow</span>
        </span>
      </button>

      <button type="button" class="btn btn--neumorphic btn--primary btn--rounded btn--split-preview">
        <span class="text text--flush btn__label">
          <span class="text__content">Neumorphic</span>
        </span>
      </button>

      <button type="button" class="btn btn--neumorphic-3d btn--primary btn--rounded btn--split-preview">
        <span class="text text--flush btn__label">
          <span class="text__content">Neumorphic 3D</span>
        </span>
      </button>

      <button type="button" class="btn btn--neumorphic-inner btn--primary btn--rounded btn--split-preview">
        <span class="text text--flush btn__label">
          <span class="text__content">Neumorphic inner</span>
        </span>
      </button>
    </div>

    <h2 style="margin-bottom: var(--space-md); font-family: var(--font-heading); font-weight: 600;">
      Sizes
    </h2>
    <div style="display: flex; flex-wrap: wrap; gap: var(--space-md); align-items: center;">
      <button type="button" class="btn btn--sm btn--fill btn--primary btn--rounded btn--split-preview">
        <span class="text text--flush btn__label"><span class="text__content">Small</span></span>
      </button>
      <button type="button" class="btn btn--fill btn--primary btn--rounded btn--split-preview">
        <span class="text text--flush btn__label"><span class="text__content">Medium</span></span>
      </button>
      <button type="button" class="btn btn--lg btn--fill btn--primary btn--rounded btn--split-preview">
        <span class="text text--flush btn__label"><span class="text__content">Large</span></span>
      </button>
    </div>
  </main>

</BaseLayout>
