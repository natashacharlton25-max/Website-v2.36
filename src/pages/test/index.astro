---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Renderer from '../../components/Renderer.astro';

const data = {
  component: "Page",
  margin: "comfortable",
  children: [
    {
      component: "Section",
      gap: "none",
      container: "7xl",
      children: [
        { component: "Heading", level: 1, align: "center", flush: true, text: "Test Pages" }
      ]
    },
    {
      component: "Section",
      gap: "md",
      container: "7xl",
      children: [
        { component: "Heading", level: 2, text: "Atoms" },
        { component: "Grid", variant: "inline", gap: "sm", children: [
          { component: "Badge", label: "Badge", icon: "tag", color: "primary", variant: "outline", shape: "pill" },
          { component: "Badge", label: "Heading", icon: "text-h", color: "secondary", variant: "outline", shape: "pill" },
          { component: "Badge", label: "Text", icon: "text-aa", color: "teal", variant: "outline", shape: "pill" },
          { component: "Badge", label: "Button", icon: "cursor-click", color: "blue", variant: "outline", shape: "pill" },
          { component: "Badge", label: "Icon", icon: "star", color: "purple", variant: "outline", shape: "pill" },
          { component: "Badge", label: "Image", icon: "image", color: "pink", variant: "outline", shape: "pill" },
          { component: "Badge", label: "Link", icon: "link", color: "orange", variant: "outline", shape: "pill" },
          { component: "Badge", label: "List", icon: "list-bullets", color: "yellow", variant: "outline", shape: "pill" },
          { component: "Badge", label: "Tooltip", icon: "chat-circle", color: "neutral", variant: "outline", shape: "pill" },
          { component: "Badge", label: "FormField", icon: "textbox", color: "red", variant: "outline", shape: "pill" },
          { component: "Badge", label: "LottieIcon", icon: "play", color: "primary", variant: "outline", shape: "pill" },
          { component: "Badge", label: "TextEffect", icon: "sparkle", color: "secondary", variant: "outline", shape: "pill" }
        ]},

        { component: "Heading", level: 2, text: "Visual Tests" },
        { component: "Grid", variant: "inline", gap: "sm", children: [
          { component: "Badge", label: "Rainbow & Gradients", icon: "rainbow", color: "pink", variant: "fill", shape: "pill", gradient: "hero" },
          { component: "Badge", label: "JSON Page", icon: "code", color: "neutral", variant: "outline", shape: "pill" },
          { component: "Badge", label: "Text Animation", icon: "text-aa", color: "teal", variant: "outline", shape: "pill" }
        ]}
      ]
    }
  ]
};
---

<BaseLayout title="Test Pages">
  <Renderer node={data} />

  <nav style="max-width: var(--container-7xl); margin: 0 auto; padding: var(--space-xl);">
    <h3 style="margin-bottom: var(--space-md); color: var(--color-Text);">Atom Test Pages</h3>
    <ul style="list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-sm);">
      <li><a href="/test/badge-test">Badge</a></li>
      <li><a href="/test/heading-test">Heading</a></li>
      <li><a href="/test/text-test">Text</a></li>
      <li><a href="/test/button-test">Button</a></li>
      <li><a href="/test/icon-test">Icon</a></li>
      <li><a href="/test/image-test">Image</a></li>
      <li><a href="/test/link-test">Link</a></li>
      <li><a href="/test/list-test">List</a></li>
      <li><a href="/test/tooltip-test">Tooltip</a></li>
      <li><a href="/test/formfield-test">FormField</a></li>
      <li><a href="/test/lottie-icon-test">LottieIcon</a></li>
      <li><a href="/test/text-effect-test">TextEffect</a></li>
      <li><a href="/test/text-animation-test">Text Animation</a></li>
    </ul>

    <h3 style="margin-top: var(--space-lg); margin-bottom: var(--space-md); color: var(--color-Text);">Visual Tests</h3>
    <ul style="list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-sm);">
      <li><a href="/test/rainbow-gradients">Rainbow & Gradients</a></li>
      <li><a href="/test/json-page">JSON Page</a></li>
    </ul>
  </nav>
</BaseLayout>
