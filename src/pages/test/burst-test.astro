---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Renderer from '../../components/Renderer.astro';
import data from '../../data/test/burst.json';
---

<BaseLayout title="Burst Atom — Isolated Test">
  <Renderer node={data} />
</BaseLayout>

<style is:global>
  /* Hero text reveal demo — invisible until strings arrive (data-string-landed
   * gets set on the target element by the Burst runtime once particles have
   * converged). Demonstrates the reveal pattern; production usage would put
   * this CSS alongside the actual hero component. */
  .burst-reveal-target {
    color: var(--page-bg);
    transition: color 1.4s ease-out;
  }
  .burst-reveal-target[data-string-landed] {
    color: var(--rainbow-1-base, var(--primary-600));
  }
</style>
