---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Heading } from '../../components/atoms/Heading';
import { Button } from '../../components/atoms/Button';
import { Section } from '../../components/atoms/Section';

import testData from '../../data/test/button.json';

// Pipeline: strip props per render mode
// Reduced: strip animation/effect props. media stays — Icon/LottieIcon
// own their own gates. Pre-Phase 1.6 props (confetti, iconMorphTo, etc.)
// stripped too for any legacy entries that haven't migrated.
function reducedProps(b: any) {
  const { effect, speed, confetti, confettiTrigger, confettiCount, confettiSpread, lottieIcon, lottieLoop, iconMorphTo, iconMorphColor, iconDraw, iconDrawColor, ...rest } = b;
  return rest;
}

// Textonly: contentButton + href only
function textonlyProps(b: any) {
  return { contentButton: b.contentButton, href: b.href, variant: 'outline' as const, disabled: b.disabled };
}
---

<BaseLayout title={testData.page.title} hideFooter={testData.page.hideFooter}>
  <Section container={testData.page.container} gap={testData.layout.sectionGap}>

    <Heading level={testData.title.level as any} align={testData.title.align as any} flush={testData.title.flush} contentHeading={testData.title.contentHeading} />

    {testData.sections.map((section: any) => (
      <Section separator gap={testData.layout.itemGap}>
        <Heading level={2} contentHeading={section.label} />
        <div style="display:flex;flex-wrap:wrap;gap:var(--space-md);align-items:center;">
          {section.items.map((b: any) => (
            <Fragment>
              <div class="render-full">
                <Button
                  contentButton={b.contentButton}
                  contentButtonSplit={b.contentButtonSplit}
                  variant={b.variant}
                  brandColor={b.brandColor}
                  rainbowColor={b.rainbowColor}
                  shape={b.shape}
                  size={b.size}
                  effect={b.effect}
                  speed={b.speed}
                  media={b.media}
                  iconPosition={b.iconPosition}
                  href={b.href}
                  target={b.target}
                  disabled={b.disabled}
                  ariaLabel={b.ariaLabel}
                  dropdownItems={b.dropdownItems}
                  gradient={b.gradient}
                  gradientBlend={b.gradientBlend}
                  style={b.style}
                />
              </div>
              <div class="render-reduced">
                {(() => { const r = reducedProps(b); return (
                  <Button
                    contentButton={r.contentButton}
                    variant={r.variant as any}
                    brandColor={r.brandColor}
                    rainbowColor={r.rainbowColor}
                    shape={r.shape}
                    size={r.size}
                    media={r.media}
                    iconPosition={r.iconPosition}
                    href={r.href}
                    target={r.target}
                    disabled={r.disabled}
                    ariaLabel={r.ariaLabel}
                    dropdownItems={r.dropdownItems}
                    style={r.style}
                  />
                ); })()}
              </div>
              <div class="render-textonly">
                {(() => { const t = textonlyProps(b); return (
                  <Button
                    contentButton={t.contentButton}
                    variant={t.variant}
                    href={t.href}
                    disabled={t.disabled}
                  />
                ); })()}
              </div>
            </Fragment>
          ))}
        </div>
      </Section>
    ))}

  </Section>
</BaseLayout>
