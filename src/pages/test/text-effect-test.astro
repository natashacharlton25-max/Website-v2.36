---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TextEffect } from '../../components/atoms/TextEffect';
import { Heading } from '../../components/atoms/Heading';
import { Section } from '../../components/atoms/Section';

import testData from '../../data/test/text-effect.json';
---

<BaseLayout title={testData.page.title} hideFooter={testData.page.hideFooter}>
  <Section container={testData.page.container} gap={testData.layout.sectionGap}>

    <Heading level={testData.title.level as any} align={testData.title.align as any} flush={testData.title.flush}>{testData.title.text}</Heading>

    {testData.sections.map((section: any) => (
      <Section label={section.label} separator gap={testData.layout.itemGap}>
        {section.items.map((item: any) => (
          <TextEffect
            text={item.text}
            fillImage={item.fillImage}
            fillGradient={item.fillGradient}
            gradientColors={item.gradientColors}
            gradientSpeed={item.gradientSpeed}
            solidColor={item.solidColor}
            textShadow={item.textShadow}
            dropShadow={item.dropShadow}
            textStroke={item.textStroke}
            innerShadow={item.innerShadow}
            size={item.size}
            weight={item.weight}
            family={item.family}
            tracking={item.tracking}
            uppercase={item.uppercase}
            align={item.align}
          />
        ))}
      </Section>
    ))}

  </Section>
</BaseLayout>
