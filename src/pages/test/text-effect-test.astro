---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TextEffect } from '../../components/atoms/TextEffect';
import LetterDrop from '../../components/effects/LetterDrop/LetterDrop.astro';
import TypeWriter from '../../components/effects/TypeWriter/TypeWriter.astro';
import WordRotate from '../../components/effects/WordRotate/WordRotate.astro';
import { Heading } from '../../components/atoms/Heading';
import { Section } from '../../components/atoms/Section';
import '../../components/effects/LetterDrop/LetterDrop.css';
import '../../components/effects/TypeWriter/TypeWriter.css';
import '../../components/effects/WordRotate/WordRotate.css';

import testData from '../../data/test/text-effect.json';
---

<BaseLayout title={testData.page.title} hideFooter={testData.page.hideFooter}>
  <Section container={testData.page.container} gap={testData.layout.sectionGap}>

    <Heading level={testData.title.level as any} align={testData.title.align as any} flush={testData.title.flush}>{testData.title.text}</Heading>

    {testData.sections.map((section: any) => (
      <Section label={section.label} separator gap={testData.layout.itemGap}>
        <div style="display:flex;flex-direction:column;gap:var(--space-lg);">
          {section.items.map((item: any) => (
            <TextEffect
              text={item.text}
              fillImage={item.fillImage}
              fillGradient={item.fillGradient}
              gradientColors={item.gradientColors}
              gradientSpeed={item.gradientSpeed}
              gradientTrigger={item.gradientTrigger}
              solidColor={item.solidColor}
              textShadow={item.textShadow}
              dropShadow={item.dropShadow}
              textStroke={item.textStroke}
              innerShadow={item.innerShadow}
              size={item.size}
              weight={item.weight}
              family={item.family}
              tracking={item.tracking}
              uppercase={item.uppercase}
              align={item.align}
            />
          ))}
        </div>
      </Section>
    ))}

    <!-- Animation Effects -->
    <Section label="Letter Drop — Both (drop + hover)" separator gap="xl">
      <LetterDrop
        mode="both"
        lines={[
          { text: "TURNING", color: "var(--primary-600)" },
          { text: "OBSTACLES", color: "var(--secondary-600)" },
          { text: "INTO", color: "var(--neutral-800)" },
          { text: "OPPORTUNITIES", color: "var(--primary-400)" }
        ]}
        family="heading"
      />
    </Section>

    <Section label="Letter Drop — Drop-In Only (no hover)" separator gap="xl">
      <LetterDrop
        mode="drop-in"
        lines={[
          { text: "HELLO", color: "var(--rainbow-4)" },
          { text: "WORLD", color: "var(--rainbow-6)" }
        ]}
        family="heading"
        size="6vw"
      />
    </Section>

    <Section label="Letter Drop — Hover Only (no fly-in)" separator gap="xl">
      <LetterDrop
        mode="hover"
        lines={[
          { text: "HOVER", color: "var(--secondary-600)" },
          { text: "EACH", color: "var(--primary-600)" },
          { text: "LETTER", color: "var(--rainbow-1)" }
        ]}
        family="heading"
        size="5vw"
      />
    </Section>

    <Section label="TypeWriter" separator gap="xl">
      <TypeWriter
        words={["All About Us.", "Hey There!", "So Glad You Found Us.", "Lovely to meet you here :)", "How are you Today?"]}
        family="display"
      />
    </Section>

    <Section label="Word Rotate" separator gap="xl">
      <div style="min-height: 6rem;">
        <WordRotate
          words={[
            { text: "Love wins.", color: "var(--primary-600)" },
            { text: "Joy wins.", color: "var(--secondary-600)" },
            { text: "Happiness wins.", color: "var(--primary-400)" },
            { text: "Comfort wins.", color: "var(--secondary-400)" },
            { text: "Safety wins.", color: "var(--neutral-700)" },
            { text: "Peace wins.", color: "var(--primary-800)" }
          ]}
          family="display"
        />
      </div>
    </Section>

  </Section>
</BaseLayout>
