---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Renderer from '../../components/Renderer.astro';
import data from '../../data/test/figcaption.json';
---

<BaseLayout title="FigCaption Atom Test" hideFooter>
  <Renderer node={data} />
</BaseLayout>

<!-- FigCaption only renders when html[data-alt-display-mode="tooltip"] is set.
     Normally driven by the Your View panel; for this test page, set it inline
     before paint so the bar appears immediately on page load. -->
<script is:inline>
  document.documentElement.setAttribute('data-alt-display-mode', 'tooltip');
</script>
