---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Image from '../../components/atoms/Image/Image.astro';
import Heading from '../../components/atoms/Heading/Heading.astro';
import Section from '../../components/atoms/Section/Section.astro';
import '../../components/atoms/Section/Section.css';
import '../../styles/global/image-enlarge.css';
import '../../components/atoms/FigCaption/FigCaption.css';

import testData from '../../data/test/image.json';
import { aacInline } from '../../lib/aac/aac-inline';

// Build AAC HTML for items that have aacWords
const apiBase = import.meta.env.PUBLIC_ASSET_API_URL || 'https://asset-library.natashacharlton25.workers.dev';
const aacData = new Map<string, string>();
for (const section of testData.sections) {
  for (const item of section.items) {
    if ((item as any).aacWords) {
      const html = await aacInline((item as any).aacWords, apiBase) || '';
      aacData.set((item as any).aacWords, html);
    }
  }
}
---

<BaseLayout title={testData.page.title} hideFooter={testData.page.hideFooter}>
  <Section container={testData.page.container} gap={testData.layout.sectionGap}>

    <Heading level={testData.title.level as any} align={testData.title.align as any} flush={testData.title.flush}>{testData.title.text}</Heading>

    {testData.sections.map((section: any) => (
      <Section label={section.label} separator gap={testData.layout.itemGap}>
        <div style="display:flex;flex-wrap:wrap;gap:var(--space-xl);align-items:start;">
          {section.items.map((item: any) => (
            <div class="render-full">
              <Image
                src={item.src}
                alt={item.alt}
                role={item.role}
                altWord={item.altWord}
                altDescriptive={item.altDescriptive}
                altAacHtml={item.aacWords ? aacData.get(item.aacWords) : undefined}
                semanticRole={item.semanticRole}
                width={item.width}
                height={item.height}
                fit={item.fit}
                radius={item.radius}
                shadow={item.shadow}
                hover={item.hover}
                responsive={item.responsive}
                sepia={item.sepia}
                blur={item.blur}
                gradientMask={item.gradientMask}
                clipPath={item.clipPath}
                maskShape={item.maskShape}
                maskIcon={item.maskIcon}
                tilt={item.tilt}
                bgFill={item.bgFill}
              />
            </div>
          ))}
        </div>
        <div class="render-reduced">
          {section.items.map((item: any) => (
            <Image
              src={item.src}
              alt={item.alt}
              role={item.role}
              altWord={item.altWord}
              altDescriptive={item.altDescriptive}
              altAacHtml={item.aacWords ? aacData.get(item.aacWords) : undefined}
              semanticRole={item.semanticRole}
              width={item.width}
              height={item.height}
              fit={item.fit}
              radius={item.radius}
              shadow={item.shadow}
              responsive={item.responsive}
            />
          ))}
        </div>
        <div class="render-textonly">
          {section.items.filter((item: any) => item.role !== 'decorative').map((item: any) => (
            <div>
              <Image
                src={item.src}
                alt={item.alt}
                role={item.role}
                altWord={item.altWord}
                altDescriptive={item.altDescriptive}
                altAacHtml={item.aacWords ? aacData.get(item.aacWords) : undefined}
                semanticRole={item.semanticRole}
                width={item.width}
                height={item.height}
                radius={item.radius}
                shadow={item.shadow}
              />
            </div>
          ))}
        </div>
      </Section>
    ))}

  </Section>
</BaseLayout>
