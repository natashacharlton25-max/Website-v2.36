---
import BaseLayout from '../../layouts/BaseLayout.astro';

const rainbowNames = ['red', 'orange', 'yellow', 'green', 'blue', 'indigo', 'pink'];
const tiers = ['tint', 'mid', 'base', 'emphasis'];
const brandColours = ['primary', 'secondary', 'neutral', 'text'];
const brandTiers = ['tint', 'mid', 'base', 'emphasis', 'contrast'];
const statusColours = ['Success', 'Warning', 'Error', 'Info'];
const pageTokens = ['page-bg', 'page-bg-raised', 'page-bg-sunken', 'page-bg-overlay'];
---

<BaseLayout title="Token Swatches">
  <main style="max-width: var(--container-7xl); margin: 0 auto; padding: var(--space-xl);">

    <h1 style="color: var(--color-Text); margin-bottom: var(--space-xl);">Token Swatches</h1>

    <!-- Rainbow Colours — 4 tiers -->
    <h2 style="color: var(--color-Text); margin-bottom: var(--space-md);">Rainbow Colours — 4 tiers</h2>
    <div style="display: grid; grid-template-columns: auto repeat(4, 1fr); gap: 2px; margin-bottom: var(--space-xl);">
      <div></div>
      {tiers.map(t => <div style="text-align: center; font-size: var(--text-fine); color: var(--color-Text); padding: var(--space-xs);">{t}</div>)}
      {rainbowNames.map((c, i) => <>
        <div style={`font-size: var(--text-fine); color: var(--color-Text); padding: var(--space-xs); display: flex; align-items: center;`}>{c}</div>
        <div style={`background: var(--rainbow-${i+1}-tint); height: 48px; border-radius: var(--radius-xs);`}></div>
        <div style={`background: var(--rainbow-${i+1}-mid); height: 48px; border-radius: var(--radius-xs);`}></div>
        <div style={`background: var(--rainbow-${i+1}); height: 48px; border-radius: var(--radius-xs);`}></div>
        <div style={`background: var(--rainbow-${i+1}-emphasis); height: 48px; border-radius: var(--radius-xs);`}></div>
      </>)}
    </div>

    <!-- Brand Colours — semantic tiers + contrast -->
    <h2 style="color: var(--color-Text); margin-bottom: var(--space-md);">Brand Colours — semantic tiers</h2>
    <div style="display: grid; grid-template-columns: auto repeat(5, 1fr); gap: 2px; margin-bottom: var(--space-xl);">
      <div></div>
      {brandTiers.map(t => <div style="text-align: center; font-size: var(--text-fine); color: var(--color-Text); padding: var(--space-xs);">{t}</div>)}
      {brandColours.map(c => <>
        <div style={`font-size: var(--text-fine); color: var(--color-Text); padding: var(--space-xs); display: flex; align-items: center;`}>{c}</div>
        <div style={`background: var(--${c}-tint); height: 48px; border-radius: var(--radius-xs);`}></div>
        <div style={`background: var(--${c}-mid); height: 48px; border-radius: var(--radius-xs);`}></div>
        <div style={`background: var(--${c}-base); height: 48px; border-radius: var(--radius-xs);`}></div>
        <div style={`background: var(--${c}-emphasis); height: 48px; border-radius: var(--radius-xs);`}></div>
        <div style={`background: var(--${c}-contrast, var(--${c}-emphasis)); height: 48px; border-radius: var(--radius-xs); border: 1px dashed var(--neutral-mid);`}></div>
      </>)}
    </div>

    <!-- Status Colours -->
    <h2 style="color: var(--color-Text); margin-bottom: var(--space-md);">Status Colours</h2>
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-sm); margin-bottom: var(--space-xl);">
      {statusColours.map(s =>
        <div style={`background: var(--color-${s}); height: 48px; border-radius: var(--radius-xs); display: flex; align-items: center; justify-content: center;`}>
          <span style="font-size: var(--text-fine); color: white; text-shadow: 0 1px 2px rgba(0,0,0,0.5);">{s}</span>
        </div>
      )}
    </div>

    <!-- Page Backgrounds -->
    <h2 style="color: var(--color-Text); margin-bottom: var(--space-md);">Page Backgrounds</h2>
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-sm); margin-bottom: var(--space-xl);">
      {pageTokens.map(t =>
        <div style={`background: var(--${t}); height: 48px; border-radius: var(--radius-xs); display: flex; align-items: center; justify-content: center; border: 1px solid var(--neutral-mid);`}>
          <span style="font-size: var(--text-fine); color: var(--color-Text);">{t}</span>
        </div>
      )}
    </div>

    <!-- Black/White/Shadow -->
    <h2 style="color: var(--color-Text); margin-bottom: var(--space-md);">Black / White / Shadow</h2>
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-sm); margin-bottom: var(--space-xl);">
      {['color-Black', 'color-White', 'shadow-Black', 'shadow-White'].map(t =>
        <div style={`background: var(--${t}); height: 48px; border-radius: var(--radius-xs); display: flex; align-items: center; justify-content: center; border: 1px solid var(--neutral-mid);`}>
          <span style={`font-size: var(--text-fine); color: ${t.includes('Black') || t.includes('shadow-B') ? 'white' : 'black'};`}>{t}</span>
        </div>
      )}
    </div>

  </main>
</BaseLayout>
