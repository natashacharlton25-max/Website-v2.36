---
/**
 * Search Page - Full-width immersive search experience
 *
 * Dedicated search page with large typography, bold design,
 * and card grid results layout.
 */
import BaseLayout from '../Layouts/BaseLayout.astro';
import Icon from '../components/Icons/Icon.astro';
import { getCollection } from 'astro:content';

// Get insights at build time
const allInsights = await getCollection('insights');

// Helper to get folder slug from entry.id
const getSlug = (id: string) => {
  const normalized = id.replace(/[\\/]index\.md$/, '');
  return normalized.split(/[\\/]/).pop() || id;
};

// Build searchable content array
const searchableContent = [
  ...allInsights.map(entry => ({
    title: entry.data.title,
    description: entry.data.description || '',
    url: `/insights/${getSlug(entry.id)}`,
    category: 'Insight',
    image: entry.data.cardImage?.src || null,
  })),
  // Static pages
  { title: 'About Us', description: 'Learn about Walking With A Smile and our mission.', url: '/about', category: 'Page', image: null },
  { title: 'Contact', description: 'Get in touch with our team.', url: '/contact', category: 'Page', image: null },
  { title: 'Tools & Resources', description: 'Practical resources for your journey.', url: '/assets', category: 'Resource', image: null },
  { title: 'Insights & Articles', description: 'Thoughtful perspectives and guides.', url: '/insights', category: 'Page', image: null },
  { title: 'For Professionals', description: 'Resources for therapists and coaches.', url: '/services', category: 'Service', image: null },
  { title: 'Projects', description: 'Our ongoing and completed work.', url: '/projects', category: 'Project', image: null },
];

const pageTitle = 'Search';
const pageDescription = 'Search our resources, insights, tools, and more.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="search-page">
    <!-- Hero Section -->
    <section class="search-hero">
      <div class="search-hero__content container">
        <h1 class="search-hero__title">
          Find what you're <span class="search-hero__highlight">looking for</span>
        </h1>
        <p class="search-hero__subtitle">
          Search our resources, insights, and tools
        </p>

        <!-- Search Input -->
        <div class="search-input-wrapper">
          <span class="search-input__icon">
            <Icon name="magnifying-glass-fill" size={28} />
          </span>
          <input
            type="text"
            id="searchInput"
            class="search-input"
            placeholder="Type to search..."
            autocomplete="off"
            autofocus
          />
          <button id="clearSearch" class="search-input__clear" aria-label="Clear search">
            <Icon name="x-circle-fill" size={20} />
          </button>
        </div>
      </div>
    </section>

    <!-- Quick Links Section -->
    <section class="quick-links" id="quickLinks">
      <div class="quick-links__container container">
        <div class="quick-links__grid">
          <a href="/assets" class="quick-link-card">
            <div class="quick-link-card__icon">
              <Icon name="package-fill" size={48} />
            </div>
            <h3 class="quick-link-card__title">Tools & Resources</h3>
            <p class="quick-link-card__desc">Practical resources for your journey</p>
          </a>
          <a href="/insights" class="quick-link-card">
            <div class="quick-link-card__icon">
              <Icon name="book-open-fill" size={48} />
            </div>
            <h3 class="quick-link-card__title">Insights & Articles</h3>
            <p class="quick-link-card__desc">Thoughtful perspectives and guides</p>
          </a>
          <a href="/services" class="quick-link-card">
            <div class="quick-link-card__icon">
              <Icon name="users-fill" size={48} />
            </div>
            <h3 class="quick-link-card__title">For Professionals</h3>
            <p class="quick-link-card__desc">Resources for therapists and coaches</p>
          </a>
          <a href="/projects" class="quick-link-card">
            <div class="quick-link-card__icon">
              <Icon name="stack-fill" size={48} />
            </div>
            <h3 class="quick-link-card__title">Projects</h3>
            <p class="quick-link-card__desc">Our ongoing and completed work</p>
          </a>
        </div>
      </div>
    </section>

    <!-- Search Results Section -->
    <section class="search-results" id="searchResults">
      <div class="search-results__container container">
        <div class="search-results__header">
          <h2 class="search-results__title">
            <span id="resultsCount">0</span> Results
          </h2>
          <p class="search-results__query">for "<span id="searchQuery"></span>"</p>
        </div>

        <div class="search-results__grid" id="resultsList">
          <!-- Results populated by JavaScript -->
        </div>

        <!-- No Results -->
        <div class="no-results" id="noResults">
          <div class="no-results__icon">
            <Icon name="magnifying-glass-fill" size={64} />
          </div>
          <h3 class="no-results__title">No results found</h3>
          <p class="no-results__text">Try a different search term or browse our categories above</p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  /* ========== SEARCH PAGE ========== */
  .search-page {
    min-height: 100vh;
    background: var(--color-Background-50);
  }

  /* ========== HERO SECTION ========== */
  .search-hero {
    background: linear-gradient(135deg, var(--color-Primary-500) 0%, var(--color-Primary-700) 100%);
    padding: var(--space-4xl) var(--space-lg);
    padding-top: calc(var(--nav-height, 80px) + var(--space-4xl));
    margin-top: calc(-1 * var(--nav-height, 80px));
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .search-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
  }

  .search-hero__content {
    position: relative;
    z-index: 1;
  }

  .search-hero__title {
    font-family: var(--font-heading);
    font-size: var(--text-5xl);
    font-weight: var(--font-bold);
    color: var(--color-White);
    margin: 0 0 var(--space-md) 0;
    line-height: var(--leading-tight);
  }

  .search-hero__highlight {
    color: var(--color-AccentOne-300);
  }

  .search-hero__subtitle {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    color: color-mix(in srgb, var(--color-White) 85%, transparent);
    margin: 0 0 var(--space-2xl) 0;
  }

  /* ========== SEARCH INPUT ========== */
  .search-input-wrapper {
    position: relative;
    max-width: var(--container-2xl);
    margin: 0 auto;
  }

  .search-input__icon {
    position: absolute;
    left: var(--space-lg);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-Primary-500);
    pointer-events: none;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .search-input {
    width: 100%;
    padding: var(--space-lg) var(--space-3xl);
    padding-left: calc(var(--space-lg) + var(--space-xl) + var(--space-md));
    font-family: var(--font-body);
    font-size: var(--text-lg);
    border: none;
    border-radius: var(--radius-full);
    background: var(--color-White);
    color: var(--color-Text-700);
    box-shadow: var(--shadow-xl);
    transition: all var(--transition-base);
    position: relative;
    z-index: 1;
  }

  .search-input:focus {
    outline: none;
    box-shadow: var(--shadow-2xl), 0 0 0 var(--space-xs) color-mix(in srgb, var(--color-White) 30%, transparent);
  }

  .search-input::placeholder {
    color: var(--color-Text-400);
  }

  .search-input__clear {
    position: absolute;
    right: var(--space-md);
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: var(--color-Text-400);
    cursor: pointer;
    padding: var(--space-xs);
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
    display: none;
    align-items: center;
    justify-content: center;
  }

  .search-input__clear:hover {
    background: var(--color-Neutral-200);
    color: var(--color-Text-600);
  }

  .search-input__clear.show {
    display: flex;
  }

  /* ========== QUICK LINKS ========== */
  .quick-links {
    padding: var(--space-2xl) var(--space-lg);
    background: var(--color-Background-50);
  }

  .quick-links__container {
    /* Uses global .container class */
  }

  .quick-links__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .quick-link-card {
    background: var(--color-White);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    text-decoration: none;
    text-align: center;
    box-shadow: var(--shadow-md);
    transition: all var(--transition-base);
    border: var(--border-width-2) solid transparent;
  }

  .quick-link-card:hover {
    transform: translateY(calc(-1 * var(--space-xs)));
    box-shadow: var(--shadow-xl);
    border-color: var(--color-Primary-200);
  }

  .quick-link-card:hover .quick-link-card__icon {
    color: var(--color-Primary-700);
    transform: scale(1.1);
  }

  .quick-link-card__icon {
    margin: 0 auto var(--space-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-Primary-500);
    transition: all var(--transition-base);
  }

  .quick-link-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--color-Text-700);
    margin: 0 0 var(--space-xs) 0;
  }

  .quick-link-card__desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-Text-500);
    margin: 0;
  }

  /* ========== SEARCH RESULTS ========== */
  .search-results {
    padding: var(--space-4xl) var(--space-lg);
    background: var(--color-Neutral-100);
    display: none;
  }

  .search-results.show {
    display: block;
  }

  .search-results__container {
    /* Uses global .container class */
  }

  .search-results__header {
    text-align: center;
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-lg);
    border-bottom: var(--border-width) solid var(--color-Neutral-200);
  }

  .search-results__title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--color-Text-700);
    margin: 0 0 var(--space-xs) 0;
  }

  .search-results__title span {
    color: var(--color-Primary-600);
    background: linear-gradient(135deg, var(--color-Primary-500) 0%, var(--color-Primary-700) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .search-results__query {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--color-Text-500);
    margin: 0;
  }

  .search-results__query span {
    color: var(--color-Primary-600);
    font-weight: var(--font-semibold);
    font-style: italic;
  }

  .search-results__grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* ========== RESULT ITEM (Card Style) ========== */
  .result-item,
  .search-results__grid .result-item,
  #resultsList .result-item {
    background: var(--color-White);
    border-radius: 1.5rem;
    border: 2px solid var(--color-Neutral-200);
    padding: 1.5rem 2rem;
    text-decoration: none;
    transition: all var(--transition-base);
    display: flex;
    align-items: center;
    gap: 1.5rem;
    box-shadow: var(--shadow-md);
    position: relative;
    overflow: hidden;
  }

  .search-results__grid .result-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: var(--space-xs);
    background: linear-gradient(to bottom, var(--color-Primary-400) 0%, var(--color-Primary-600) 100%);
    transform: scaleY(0);
    transition: transform var(--transition-base);
    transform-origin: center;
  }

  .search-results__grid .result-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 0%, color-mix(in srgb, var(--color-Primary-100) 30%, transparent) 100%);
    opacity: 0;
    transition: opacity var(--transition-base);
    pointer-events: none;
  }

  .search-results__grid .result-item:hover {
    border-color: var(--color-Primary-300);
    box-shadow: var(--shadow-xl);
    transform: translateY(calc(-1 * var(--space-xs)));
  }

  .search-results__grid .result-item:hover::before {
    transform: scaleY(1);
  }

  .search-results__grid .result-item:hover::after {
    opacity: 1;
  }

  .search-results__grid .result-item:hover .result-item__icon {
    transform: scale(1.05) rotate(-2deg);
    box-shadow: var(--shadow-lg);
  }

  .search-results__grid .result-item:hover .result-item__arrow {
    color: var(--color-Primary-600);
    transform: translateX(var(--space-xs));
  }

  .search-results__grid .result-item:hover .result-item__title {
    color: var(--color-Primary-700);
  }

  .search-results__grid .result-item__icon {
    width: 5.5rem;
    height: 5.5rem;
    min-width: 5.5rem;
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, var(--color-Primary-400) 0%, var(--color-Primary-600) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all var(--transition-base);
    box-shadow: var(--shadow-md);
    position: relative;
    z-index: 1;
  }

  .search-results__grid .result-item__icon svg,
  .result-item__icon svg {
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-White);
    fill: var(--color-White);
  }

  .search-results__grid .result-item__main {
    flex: 1;
    min-width: 0;
  }

  .search-results__grid .result-item__breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
    font-size: var(--text-sm);
    font-family: var(--font-body);
  }

  .search-results__grid .result-item__home {
    color: var(--color-Text-400);
    font-weight: var(--font-normal);
  }

  .search-results__grid .result-item__separator {
    color: var(--color-Neutral-300);
  }

  .search-results__grid .result-item__category,
  .result-item__category {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-White);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: var(--text-sm);
    background: var(--color-Primary-500);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-lg);
  }

  .search-results__grid .result-item__title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-Text-800);
    margin: 0 0 var(--space-sm) 0;
    line-height: var(--leading-tight);
    transition: color var(--transition-base);
    letter-spacing: var(--letter-spacing-tight);
  }

  .search-results__grid .result-item__desc {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-normal);
    color: var(--color-Text-500);
    margin: 0;
    line-height: var(--leading-relaxed);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-results__grid .result-item__arrow {
    color: var(--color-Neutral-400);
    flex-shrink: 0;
    transition: all var(--transition-base);
    width: var(--space-xl);
    height: var(--space-xl);
  }

  .search-results__grid .result-item__arrow svg {
    width: var(--space-xl);
    height: var(--space-xl);
  }

  /* ========== CATEGORY COLORS (matches Badge component) ========== */
  /* Insight - AccentOne */
  .result-item--insight .result-item__icon {
    background: linear-gradient(135deg, var(--color-AccentOne-400) 0%, var(--color-AccentOne-600) 100%);
  }
  .result-item--insight .result-item__category {
    background: var(--color-AccentOne-600);
  }

  /* Page - Neutral/Gray */
  .result-item--page .result-item__icon {
    background: linear-gradient(135deg, var(--color-Neutral-400) 0%, var(--color-Neutral-600) 100%);
  }
  .result-item--page .result-item__category {
    background: var(--color-Neutral-500);
  }

  /* Resource - Primary */
  .result-item--resource .result-item__icon {
    background: linear-gradient(135deg, var(--color-Primary-400) 0%, var(--color-Primary-600) 100%);
  }
  .result-item--resource .result-item__category {
    background: var(--color-Primary-600);
  }

  /* Service - AccentTwo */
  .result-item--service .result-item__icon {
    background: linear-gradient(135deg, var(--color-AccentTwo-400) 0%, var(--color-AccentTwo-600) 100%);
  }
  .result-item--service .result-item__category {
    background: var(--color-AccentTwo-600);
  }

  /* Project - Secondary */
  .result-item--project .result-item__icon {
    background: linear-gradient(135deg, var(--color-Secondary-400) 0%, var(--color-Secondary-600) 100%);
  }
  .result-item--project .result-item__category {
    background: var(--color-Secondary-600);
  }

  /* ========== NO RESULTS ========== */
  .no-results {
    text-align: center;
    padding: var(--space-4xl) var(--space-lg);
    display: none;
  }

  .no-results.show {
    display: block;
  }

  .no-results__icon {
    color: var(--color-Neutral-300);
    margin-bottom: var(--space-lg);
  }

  .no-results__title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-Text-600);
    margin: 0 0 var(--space-sm) 0;
  }

  .no-results__text {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-Text-500);
    margin: 0;
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 1024px) {
    .quick-links__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .search-hero {
      padding: var(--space-3xl) var(--space-md);
      padding-top: calc(var(--nav-height, 70px) + var(--space-3xl));
      margin-top: calc(-1 * var(--nav-height, 70px));
    }

    .search-hero__title {
      font-size: var(--text-4xl);
    }

    .search-hero__subtitle {
      font-size: var(--text-lg);
    }

    .search-input {
      font-size: var(--text-base);
      padding: var(--space-md) var(--space-2xl);
      padding-left: calc(var(--space-md) + var(--space-xl) + var(--space-sm));
    }

    .search-input__icon {
      left: var(--space-md);
    }

    .quick-links {
      padding: var(--space-2xl) var(--space-md);
    }

    .search-results {
      padding: var(--space-3xl) var(--space-md);
    }

    /* Center-align result cards on mobile */
    .search-results__grid .result-item {
      flex-direction: column;
      text-align: center;
      padding: var(--space-xl) var(--space-lg);
      gap: var(--space-lg);
    }

    .search-results__grid .result-item::before {
      left: 0;
      right: 0;
      top: 0;
      bottom: auto;
      width: 100%;
      height: calc(var(--space-xs) + var(--border-width-2));
      transform: scaleX(0);
      border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    }

    .search-results__grid .result-item:hover::before {
      transform: scaleX(1);
    }

    .search-results__grid .result-item__icon {
      margin: 0 auto;
      width: var(--space-4xl);
      height: var(--space-4xl);
      min-width: var(--space-4xl);
    }

    .search-results__grid .result-item__icon svg {
      width: var(--space-2xl);
      height: var(--space-2xl);
    }

    .search-results__grid .result-item__main {
      text-align: center;
    }

    .search-results__grid .result-item__breadcrumb {
      justify-content: center;
    }

    .search-results__grid .result-item__title {
      font-size: var(--text-xl);
    }

    .search-results__grid .result-item__desc {
      font-size: var(--text-sm);
    }

    .search-results__grid .result-item__arrow {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .search-hero {
      padding: var(--space-2xl) var(--space-sm);
      padding-top: calc(var(--nav-height, 60px) + var(--space-2xl));
      margin-top: calc(-1 * var(--nav-height, 60px));
    }

    .search-hero__title {
      font-size: var(--text-3xl);
    }

    .search-hero__subtitle {
      font-size: var(--text-base);
      margin-bottom: var(--space-xl);
    }

    .quick-links__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .quick-link-card {
      padding: var(--space-lg);
      display: flex;
      align-items: center;
      text-align: left;
      gap: var(--space-md);
    }

    .quick-link-card__icon {
      width: var(--space-2xl);
      height: var(--space-2xl);
      margin: 0;
      flex-shrink: 0;
    }

    .quick-link-card__title {
      font-size: var(--text-base);
    }

    .quick-link-card__desc {
      font-size: var(--text-xs);
    }

  }

  @media (max-width: 480px) {
    .search-hero {
      padding: var(--space-xl) var(--space-xs);
      padding-top: calc(var(--nav-height, 60px) + var(--space-xl));
      margin-top: calc(-1 * var(--nav-height, 60px));
    }

    .search-hero__title {
      font-size: var(--text-2xl);
    }

    .search-hero__subtitle {
      font-size: var(--text-sm);
    }

    .search-input {
