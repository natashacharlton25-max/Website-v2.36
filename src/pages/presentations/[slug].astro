---
/**
 * Presentation Page
 * Prerendered - generates static HTML during build
 */
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Reader from '../../components/organisms/presentation/Reader.astro';
import ReaderNav from '../../components/organisms/nav/ReaderNav.astro';

// Helper to get folder slug from entry.id
const getSlug = (id: string) => {
  const normalized = id.replace(/[\\/]index\.md$/, '');
  return normalized.split(/[\\/]/).pop() || id;
};

// Generate static paths for all presentations
export async function getStaticPaths() {
  const presentationEntries = await getCollection('presentations');
  return presentationEntries.map(entry => {
    const normalized = entry.id.replace(/[\\/]index\.md$/, '');
    const slug = normalized.split(/[\\/]/).pop() || entry.id;
    return {
      params: { slug },
      props: { entry }
    };
  });
}

// Get entry from props (prerendered)
const { entry } = Astro.props;
const currentSlug = Astro.params.slug;

// Fetch all presentations for related content
const allPresentations = await getCollection('presentations');

// Redirect if not found (shouldn't happen with prerender)
if (!entry) {
  return Astro.redirect('/insights');
}

const presentation = entry.data;

// Get author data if specified
let author = null;
if (presentation.author) {
  const allAuthors = await getCollection('authors');
  const authorEntry = allAuthors.find(a => getSlug(a.id) === presentation.author);
  if (authorEntry) {
    author = {
      name: authorEntry.data.name,
      photo: authorEntry.data.photo,
      role: authorEntry.data.role,
      bio: authorEntry.data.bio,
    };
  }
}

// Get recommended presentations (prioritize matching tags, fall back to same category)
const currentTags = presentation.tags || [];

// Score presentations by relevance (tag matches + category bonus)
const scoredPresentations = allPresentations
  .filter(p => getSlug(p.id) !== currentSlug)
  .map(p => {
    const pTags = p.data.tags || [];
    // Count matching tags
    const tagMatches = currentTags.filter(tag => pTags.includes(tag)).length;
    // Category match bonus
    const categoryBonus = p.data.category === presentation.category ? 2 : 0;
    // Total score
    const score = tagMatches + categoryBonus;

    return {
      presentation: p,
      score,
      tagMatches,
    };
  })
  // Only include items with some relevance (at least same category or 1 tag match)
  .filter(item => item.score > 0)
  // Sort by score (highest first), then by tag matches
  .sort((a, b) => b.score - a.score || b.tagMatches - a.tagMatches)
  .slice(0, 3);

const recommendedPresentations = scoredPresentations.map(item => ({
  slug: getSlug(item.presentation.id),
  title: item.presentation.data.title,
  category: item.presentation.data.category,
  image: item.presentation.data.cardImage,
}));

// Calculate reading time from all section bodies (avg 200 words per minute)
const calculateReadingTime = (sections: typeof presentation.sections): number => {
  const totalWords = sections.reduce((count, section) => {
    const bodyText = section.body || '';
    const words = bodyText.trim().split(/\s+/).filter(w => w.length > 0).length;
    return count + words;
  }, 0);
  // Add description words too
  const descWords = (presentation.description || '').trim().split(/\s+/).filter(w => w.length > 0).length;
  return Math.max(1, Math.ceil((totalWords + descWords) / 200));
};

const readingTime = calculateReadingTime(presentation.sections);

// Build hero section for Reader
const heroSection = {
  title: presentation.hero?.title || presentation.title,
  description: presentation.hero?.description || presentation.description,
  category: presentation.hero?.showCategory !== false ? presentation.category : undefined,
  date: presentation.hero?.showDate !== false ? presentation.publishDate : undefined,
  readingTime,
  image: presentation.hero?.image?.src as string | undefined,
  overlayOpacity: presentation.hero?.overlayOpacity,
  primaryAction: presentation.hero?.primaryAction,
  secondaryAction: presentation.hero?.secondaryAction,
};

// Transform sections to extract .src from processed image objects
const transformedSections = presentation.sections.map(section => ({
  // Core props
  id: section.id,
  title: section.title,
  body: section.body,
  layout: section.layout,

  // Text alignment props
  alignment: section.alignment,
  textAlign: section.textAlign,
  position: section.position,

  // Image props
  image: section.image?.src as string | undefined,
  imagePosition: section.imagePosition,

  // Quote layout props
  quote: section.quote,
  author: section.author,
  role: section.role,
  variant: section.variant,

  // Stats layout props
  stats: section.stats,
  statsLayout: section.statsLayout,

  // Gallery layout props
  images: section.images,
  columns: section.columns,

  // Callout layout props
  calloutType: section.calloutType,
  content: section.content,

  // Compare layout props
  left: section.left,
  right: section.right,
  divider: section.divider,
}));

// Determine what to show in end section
const showAuthor = presentation.endSection?.showAuthor !== false && author;
const showRecommended = presentation.endSection?.showRecommended !== false && recommendedPresentations.length > 0;
const hasEndContent = showAuthor || showRecommended || presentation.linkedAssets?.length || presentation.endSection?.customHtml;

// Build end section for Reader (now rendered INSIDE Reader for proper tracking)
const endSection = hasEndContent ? {
  author: showAuthor && author ? author : undefined,
  linkedAssets: presentation.linkedAssets,
  recommendedItems: showRecommended ? recommendedPresentations : undefined,
  recommendedBasePath: '/presentations',
  customHtml: presentation.endSection?.customHtml,
} : undefined;

// Build nav sections for ReaderNav (use 'title' for first section, 'end' for last)
const navSections = [
  { id: 'title', title: heroSection.title },
  ...presentation.sections.map(s => ({ id: s.id, title: s.title })),
];

if (hasEndContent) {
  navSections.push({ id: 'end', title: 'Finish' });
}
---

<BaseLayout
  title={presentation.seoTitle || presentation.title}
  description={presentation.seoDescription || presentation.description}
  image={presentation.cardImage.src}
  hideFooter={true}
>
  <Reader
    sections={transformedSections}
    heroSection={heroSection}
    endSection={endSection}
  />

  <ReaderNav
    sections={navSections}
    background="primary-glass"
    shadow="glow"
  />
</BaseLayout>
