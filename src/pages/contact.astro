---
/**
 * Contact Page
 *
 * Route: /contact
 * Zero page-specific CSS — pure component composition.
 *
 * Components:
 * - HeroSection (organism) — gradient variant
 * - ContactForm (organism) — topics + fields + submit + success
 * - ContactInfo (molecule) — sidebar with email, response time, safeguarding
 */
import Layout from '../Layouts/BaseLayout.astro';
import HeroSection from '../components/organisms/sections/HeroSection.astro';
import ContactForm from '../components/organisms/contact/ContactForm.astro';
import ContactInfo from '../components/molecules/contact/ContactInfo.astro';
import Grid from '../components/atoms/grid/Grid.astro';
import { BRAND_CONFIG } from '../lib/config/brand';
---

<Layout
  title={`Contact — ${BRAND_CONFIG.name}`}
  description="Get in touch. We're here when you're ready — no pressure."
>

  <HeroSection
    title="Let's have a <span>conversation</span>"
    subtitle="Reach out when you're ready. No pressure, no expectations."
    variant="gradient"
    gradient="primary"
    alignment="left"
  />

  <Grid columns={2} gap="var(--space-2xl)" align="start" container="6xl">
    <ContactForm />
    <ContactInfo />
  </Grid>

</Layout>
