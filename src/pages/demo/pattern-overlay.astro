---
/**
 * PatternOverlay Showcase
 *
 * Each section shows a different PatternOverlay mode against a
 * visible background. Card sits above the pattern layer (z-index 1).
 *
 * Modes:
 *   Static presets  — cross, dots, diagonal, hexagons, waves
 *   Animated SMIL   — cross-spin, dots-pulse, waves-flow
 *   Interactive grid — Phosphor icon DOM grid with CSS hover
 *
 * NOT a production page — excluded via noindex.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/atoms/ui/Card/Card.astro';
import PatternOverlay from '../../components/atoms/effects/PatternOverlay/PatternOverlay.astro';

const gridIcons = [
  'creative/star-fill',
  'nature/leaf-fill',
  'wellness/heart-fill',
  'creative/sparkle-fill',
];
---

<BaseLayout title="PatternOverlay Showcase" hideFooter>

  <div class="po-showcase">

    <section class="po-showcase__section">
      <PatternOverlay preset="cross" opacity={0.08} />
      <Card variant="liquid-glass" radius="xl" padding="xl">
        <h3 class="card__title" style="text-transform:none; letter-spacing:normal;">Cross</h3>
        <p class="card__text">Static cross pattern — tiled SVG mask with CSS-controlled colour.</p>
      </Card>
    </section>

    <section class="po-showcase__section">
      <PatternOverlay preset="dots" opacity={0.1} />
      <Card variant="liquid-glass" radius="xl" padding="xl">
        <h3 class="card__title" style="text-transform:none; letter-spacing:normal;">Dots</h3>
        <p class="card__text">Simple dot grid — minimal, clean, works at any scale.</p>
      </Card>
    </section>

    <section class="po-showcase__section">
      <PatternOverlay preset="diagonal" opacity={0.06} />
      <Card variant="liquid-glass" radius="xl" padding="xl">
        <h3 class="card__title" style="text-transform:none; letter-spacing:normal;">Diagonal</h3>
        <p class="card__text">Diagonal line hatching — subtle texture for editorial layouts.</p>
      </Card>
    </section>

    <section class="po-showcase__section">
      <PatternOverlay preset="hexagons" opacity={0.06} />
      <Card variant="liquid-glass" radius="xl" padding="xl">
        <h3 class="card__title" style="text-transform:none; letter-spacing:normal;">Hexagons</h3>
        <p class="card__text">Honeycomb wireframe — geometric depth without visual weight.</p>
      </Card>
    </section>

    <section class="po-showcase__section">
      <PatternOverlay preset="waves" opacity={0.08} />
      <Card variant="liquid-glass" radius="xl" padding="xl">
        <h3 class="card__title" style="text-transform:none; letter-spacing:normal;">Waves</h3>
        <p class="card__text">Sinusoidal wave pattern — organic, flowing, pairs well with nature themes.</p>
      </Card>
    </section>

    <section class="po-showcase__section">
      <PatternOverlay preset="cross-spin" opacity={0.08} />
      <Card variant="liquid-glass" radius="xl" padding="xl">
        <h3 class="card__title" style="text-transform:none; letter-spacing:normal;">Cross Spin</h3>
        <p class="card__text">Animated — crosses rotate slowly via SMIL. Freezes to static cross on reduce-motion.</p>
      </Card>
    </section>

    <section class="po-showcase__section">
      <PatternOverlay preset="dots-pulse" opacity={0.1} />
      <Card variant="liquid-glass" radius="xl" padding="xl">
        <h3 class="card__title" style="text-transform:none; letter-spacing:normal;">Dots Pulse</h3>
        <p class="card__text">Animated — dots breathe in and out via SMIL. Freezes to static dots on reduce-motion.</p>
      </Card>
    </section>

    <section class="po-showcase__section">
      <PatternOverlay preset="waves-flow" opacity={0.08} />
      <Card variant="liquid-glass" radius="xl" padding="xl">
        <h3 class="card__title" style="text-transform:none; letter-spacing:normal;">Waves Flow</h3>
        <p class="card__text">Animated — wave path undulates via SMIL. Freezes to static waves on reduce-motion.</p>
      </Card>
    </section>

    <section class="po-showcase__section">
      <PatternOverlay icons={gridIcons} scale={80} opacity={0.06} interactive magnetic />
      <Card variant="liquid-glass" radius="xl" padding="xl">
        <h3 class="card__title" style="text-transform:none; letter-spacing:normal;">Icon Grid</h3>
        <p class="card__text">Interactive DOM grid — Phosphor icons with CSS hover rotate + scale. Hover disabled on reduce-motion.</p>
      </Card>
    </section>

  </div>

</BaseLayout>
