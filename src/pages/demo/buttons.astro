---
/**
 * Button Demo Page
 *
 * Visual test bench for the unified Button component.
 * Shows all variants, shapes, sizes, and features.
 * NOT a production page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/atoms/ui/Button/Button.astro';
---

<BaseLayout title="Button Demo" hideFooter>

  <div class="btn-demo">
    <h1 class="text">Button Component Demo</h1>
    <p class="text">All variants, shapes, sizes, and features.</p>

    <!-- ============================================================
         VARIANTS
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Variants</h2>
      <div class="btn-demo__row">
        <Button variant="primary">Primary</Button>
        <Button variant="secondary">Secondary</Button>
        <Button variant="neutral">Neutral</Button>
        <Button variant="outline">Outline</Button>
        <Button variant="ghost">Ghost</Button>
        <Button variant="glass">Glass</Button>
        <Button variant="glow">Glow</Button>
        <Button variant="neumorphic">Neumorphic</Button>
      </div>
    </section>

    <!-- ============================================================
         SIZES
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Sizes</h2>
      <div class="btn-demo__row btn-demo__row--align-end">
        <Button variant="primary" size="sm">Small</Button>
        <Button variant="primary" size="md">Medium</Button>
        <Button variant="primary" size="lg">Large</Button>
      </div>
    </section>

    <!-- ============================================================
         SHAPES
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Shapes</h2>
      <div class="btn-demo__row btn-demo__row--align-end">
        <Button variant="primary" shape="rounded">Rounded</Button>
        <Button variant="primary" shape="pill">Pill</Button>
        <Button variant="primary" shape="sharp">Sharp</Button>
        <Button variant="primary" shape="circle" icon="star-fill" ariaLabel="Star" />
        <Button variant="primary" shape="square" icon="star-fill" ariaLabel="Star" />
      </div>
    </section>

    <!-- ============================================================
         ICONS
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Icons</h2>
      <div class="btn-demo__row">
        <Button variant="primary" icon="star-fill" iconPosition="left">Icon Left</Button>
        <Button variant="secondary" icon="arrow-right-fill" iconPosition="right">Icon Right</Button>
        <Button variant="primary" shape="circle" icon="plus-fill" size="sm" ariaLabel="Add" />
        <Button variant="secondary" shape="circle" icon="plus-fill" size="md" ariaLabel="Add" />
        <Button variant="neutral" shape="circle" icon="plus-fill" size="lg" ariaLabel="Add" />
      </div>
    </section>

    <!-- ============================================================
         ALIGNMENT
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Alignment</h2>
      <div class="btn-demo__align-box">
        <Button variant="primary" alignment="left">Left Aligned</Button>
      </div>
      <div class="btn-demo__align-box">
        <Button variant="secondary" alignment="center">Center Aligned</Button>
      </div>
      <div class="btn-demo__align-box">
        <Button variant="neutral">No Alignment (inline default)</Button>
      </div>
    </section>

    <!-- ============================================================
         LINKS vs BUTTONS
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Links vs Buttons</h2>
      <div class="btn-demo__row">
        <Button variant="primary" href="#link-test">Link (a tag)</Button>
        <Button variant="secondary" type="button">Button (button tag)</Button>
        <Button variant="neutral" type="submit">Submit</Button>
      </div>
    </section>

    <!-- ============================================================
         DISABLED
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Disabled State</h2>
      <div class="btn-demo__row">
        <Button variant="primary" disabled>Disabled Primary</Button>
        <Button variant="secondary" disabled>Disabled Secondary</Button>
        <Button variant="outline" disabled>Disabled Outline</Button>
        <Button variant="ghost" disabled>Disabled Ghost</Button>
      </div>
    </section>

    <!-- ============================================================
         DROPDOWN
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Dropdown</h2>
      <div class="btn-demo__row">
        <Button variant="primary" shape="dropdown" dropdownItems={[
          { label: 'Option A', href: '#' },
          { label: 'Option B', href: '#' },
          { label: 'Option C', href: '#' },
        ]}>Dropdown Primary</Button>
        <Button variant="secondary" shape="dropdown" dropdownItems={[
          { label: 'Choice 1', href: '#' },
          { label: 'Choice 2', href: '#' },
        ]}>Dropdown Secondary</Button>
      </div>
    </section>

    <!-- ============================================================
         GLINT EFFECT
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Glint Effect</h2>
      <div class="btn-demo__row">
        <Button variant="primary" effect="glint">Primary Glint</Button>
        <Button variant="secondary" effect="glint">Secondary Glint</Button>
        <Button variant="neutral" effect="glint">Neutral Glint</Button>
      </div>
    </section>

    <!-- ============================================================
         COLOUR FLOW EFFECT
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Colour Flow Effect</h2>
      <div class="btn-demo__row">
        <Button variant="primary" effect="colour-flow">Primary Flow</Button>
        <Button variant="secondary" effect="colour-flow">Secondary Flow</Button>
        <Button variant="neutral" effect="colour-flow">Neutral Flow</Button>
      </div>
      <div class="btn-demo__row" style="margin-top: var(--space-md);">
        <Button variant="primary" effect="colour-flow" speed="slow">Slow</Button>
        <Button variant="secondary" effect="colour-flow">Normal</Button>
        <Button variant="neutral" effect="colour-flow" speed="fast">Fast</Button>
      </div>
      <div class="btn-demo__row" style="margin-top: var(--space-md);">
        <Button variant="primary" effect="colour-flow" shape="pill">Pill Flow</Button>
        <Button variant="secondary" effect="colour-flow" size="lg">Large Flow</Button>
        <Button variant="primary" effect="colour-flow" icon="star-fill" iconPosition="left">Icon Flow</Button>
      </div>
    </section>

    <!-- ============================================================
         JUMP EFFECT
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Jump Effect</h2>
      <div class="btn-demo__row">
        <Button variant="primary" effect="jump">Primary Jump</Button>
        <Button variant="secondary" effect="jump">Secondary Jump</Button>
        <Button variant="neutral" effect="jump">Neutral Jump</Button>
      </div>
    </section>

    <!-- ============================================================
         COMIC EFFECT
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Comic Effect</h2>
      <div class="btn-demo__row">
        <Button variant="primary" effect="comic">Primary Comic</Button>
        <Button variant="secondary" effect="comic">Secondary Comic</Button>
        <Button variant="neutral" effect="comic">Neutral Comic</Button>
      </div>
    </section>

    <!-- ============================================================
         TECH EFFECT
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Tech Effect</h2>
      <div class="btn-demo__row">
        <Button variant="primary" effect="tech">Primary Tech</Button>
        <Button variant="secondary" effect="tech">Secondary Tech</Button>
        <Button variant="neutral" effect="tech">Neutral Tech</Button>
      </div>
    </section>

    <!-- ============================================================
         EXPAND EFFECT
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Expand Effect</h2>
      <p class="text" style="margin-bottom: var(--space-md); color: var(--brand-c-text-light);">Pill — circle → pill</p>
      <div class="btn-demo__row">
        <Button variant="primary" effect="expand" shape="pill" icon="plus-fill" iconPosition="left">Add Item</Button>
        <Button variant="secondary" effect="expand" shape="pill" icon="heart-fill" iconPosition="left">Like</Button>
        <Button variant="neutral" effect="expand" shape="pill" icon="gear-fill" iconPosition="left">Settings</Button>
      </div>
      <p class="text" style="margin-top: var(--space-lg); margin-bottom: var(--space-md); color: var(--brand-c-text-light);">Rounded — rounded square → rounded rect</p>
      <div class="btn-demo__row">
        <Button variant="primary" effect="expand" shape="rounded" icon="plus-fill" iconPosition="left">Add Item</Button>
        <Button variant="secondary" effect="expand" shape="rounded" icon="heart-fill" iconPosition="left">Like</Button>
        <Button variant="neutral" effect="expand" shape="rounded" icon="gear-fill" iconPosition="left">Settings</Button>
      </div>
      <p class="text" style="margin-top: var(--space-lg); margin-bottom: var(--space-md); color: var(--brand-c-text-light);">Sharp — square → sharp rect</p>
      <div class="btn-demo__row">
        <Button variant="primary" effect="expand" shape="sharp" icon="plus-fill" iconPosition="left">Add Item</Button>
        <Button variant="secondary" effect="expand" shape="sharp" icon="heart-fill" iconPosition="left">Like</Button>
        <Button variant="neutral" effect="expand" shape="sharp" icon="gear-fill" iconPosition="left">Settings</Button>
      </div>
      <div class="btn-demo__row" style="margin-top: var(--space-md);">
        <Button variant="primary" effect="expand" shape="pill" icon="plus-fill" iconPosition="left" size="sm">Add</Button>
        <Button variant="secondary" effect="expand" shape="rounded" icon="star-fill" iconPosition="left" size="lg">Favourite</Button>
      </div>
    </section>

    <!-- ============================================================
         UNDERLINE EFFECT
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Underline Effect</h2>
      <div class="btn-demo__row">
        <Button variant="primary" effect="underline">Primary Underline</Button>
        <Button variant="secondary" effect="underline">Secondary Underline</Button>
        <Button variant="neutral" effect="underline">Neutral Underline</Button>
      </div>
      <div class="btn-demo__row" style="margin-top: var(--space-md);">
        <Button variant="primary" effect="underline" icon="arrow-right-fill" iconPosition="right">With Icon</Button>
      </div>
    </section>

    <!-- ============================================================
         MAGNETIC EFFECT
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Magnetic Effect</h2>
      <div class="btn-demo__row">
        <Button variant="primary" effect="magnetic">Primary Magnetic</Button>
        <Button variant="secondary" effect="magnetic">Secondary Magnetic</Button>
        <Button variant="neutral" effect="magnetic">Neutral Magnetic</Button>
      </div>
    </section>

    <!-- ============================================================
         SPOTLIGHT EFFECT
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Spotlight Effect</h2>
      <div class="btn-demo__row">
        <Button variant="primary" effect="spotlight">Primary Spotlight</Button>
        <Button variant="secondary" effect="spotlight">Secondary Spotlight</Button>
        <Button variant="neutral" effect="spotlight">Neutral Spotlight</Button>
      </div>
    </section>

    <!-- ============================================================
         SPLIT EFFECT
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Split Effect</h2>
      <div class="btn-demo__row">
        <Button variant="primary" effect="split">Primary Split</Button>
        <Button variant="secondary" effect="split">Secondary Split</Button>
        <Button variant="neutral" effect="split">Neutral Split</Button>
      </div>
    </section>

    <!-- ============================================================
         ICON DRAW ANIMATIONS
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Icon Draw Animations</h2>
      <div class="btn-demo__row">
        <Button variant="primary" icon="heart-fill" iconDraw>Draw</Button>
        <Button variant="secondary" icon="star-fill" iconDraw="drawcenter">Draw Center</Button>
        <Button variant="neutral" icon="gear-fill" iconDraw="chachaslide">Cha Cha Slide</Button>
      </div>
      <div class="btn-demo__row" style="margin-top: var(--space-md);">
        <Button variant="primary" icon="heart-fill" iconDraw="flashgordon">Flash Gordon</Button>
        <Button variant="secondary" icon="star-fill" iconDraw="rainbowchase">Rainbow Chase</Button>
        <Button variant="neutral" icon="gear-fill" iconDraw="pulse">Pulse</Button>
      </div>
      <div class="btn-demo__row" style="margin-top: var(--space-md);">
        <Button variant="primary" icon="heart-fill" iconDraw="rainbowchase" iconDrawColor="#ff3366">Custom Color</Button>
      </div>
    </section>

    <!-- ============================================================
         ICON MORPH ANIMATIONS
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Icon Morph Animations</h2>
      <div class="btn-demo__row">
        <Button variant="primary" icon="heart-fill" iconMorphTo="star-fill">Heart → Star</Button>
        <Button variant="secondary" icon="star-fill" iconMorphTo="heart-fill" iconMorphColor="var(--brand-c-secondary)">Star → Heart</Button>
        <Button variant="neutral" icon="gear-fill" iconMorphTo="plus-fill">Gear → Plus</Button>
      </div>
    </section>

    <!-- ============================================================
         LOTTIE ICONS
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Lottie Icons</h2>
      <div class="btn-demo__row">
        <Button variant="primary" lottieIcon="/Icons/Animated Icons/Menu V2/menuV2.json">Lottie Menu</Button>
        <Button variant="secondary" lottieIcon="/Icons/Animated Icons/Menu V2/menuV2.json" lottieLoop>Lottie Loop</Button>
      </div>
    </section>

    <!-- ============================================================
         CONFETTI
         ============================================================ -->
    <section class="btn-demo__section">
      <h2 class="text">Confetti Effects</h2>
      <div class="btn-demo__row">
        <Button variant="primary" confetti="confetti">Click Confetti</Button>
        <Button variant="secondary" confetti="hearts">Click Hearts</Button>
        <Button variant="neutral" confetti="celebration">Click Celebration</Button>
        <Button variant="glow" confetti="confetti" confettiTrigger="hover">Hover Confetti</Button>
      </div>
    </section>

  </div>

</BaseLayout>

<script>
  import { initIconAnimations } from '../../lib/animation/icon-animation';
  initIconAnimations();
  document.addEventListener('astro:page-load', initIconAnimations);
</script>

<style is:global>
  .btn-demo {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-lg);
  }

  .btn-demo h1 {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-sm);
  }

  .btn-demo > p {
    color: var(--brand-c-text-light);
    margin-bottom: var(--space-2xl);
  }

  .btn-demo__section {
    margin-bottom: var(--space-3xl);
  }

  .btn-demo__section h2 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--brand-c-neutral-light);
  }

  .btn-demo__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
  }

  .btn-demo__row--align-end {
    align-items: flex-end;
  }

  .btn-demo__align-box {
    width: 100%;
    padding: var(--space-md);
    border: 1px dashed var(--brand-c-neutral-light);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-md);
  }
</style>
