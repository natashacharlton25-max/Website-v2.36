    position: absolute;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: rgba(255,255,255,0.3);
    pointer-events: none;
  }
  .demo-depth-dot--sm {
    width: 10px;
    height: 10px;
    background: rgba(255,255,255,0.2);
  }


  /* ---- Effects Manager Dashboard ---- */
  .demo-dashboard {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    z-index: 1001;
    width: 260px;
    background: rgba(57, 53, 49, 0.95);
    color: #F8F5F2;
    border-radius: 10px;
    font-size: 0.8rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.25);
    overflow: hidden;
    backdrop-filter: blur(8px);
  }
  .demo-dashboard__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .demo-dashboard__header h3 {
    font-size: 0.85rem;
    font-weight: 700;
    margin: 0;
  }
  .demo-dashboard__toggle {
    background: none;
    border: none;
    color: #F8F5F2;
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0 0.3rem;
    line-height: 1;
    opacity: 0.7;
    transition: opacity 0.15s;
  }
  .demo-dashboard__toggle:hover { opacity: 1; }
  .demo-dashboard__toggle:focus-visible {
    outline: 2px solid #4A90D9;
    outline-offset: 2px;
  }
  .demo-dashboard__body {
    padding: 0.7rem 0.9rem;
  }
  .demo-dashboard__body[hidden] { display: none; }
  .demo-dashboard__row {
    display: flex;
    justify-content: space-between;
    padding: 0.2rem 0;
  }
  .demo-dashboard__row span:first-child {
    opacity: 0.6;
  }
  .demo-dashboard__body hr {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.1);
    margin: 0.5rem 0;
  }
  .demo-dashboard__body h4 {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.6;
    margin: 0 0 0.4rem;
  }
  #em-effects-list em {
    opacity: 0.4;
    font-size: 0.78rem;
  }
  .demo-effect-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.15rem 0;
  }
  .demo-effect-row__status {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    margin-right: 0.4rem;
  }
  .demo-effect-row__status--active  { background: #6BCB77; }
  .demo-effect-row__status--paused  { background: #F39C12; }
  .demo-effect-row__status--unknown { background: #888; }
  .demo-effect-row button {
    background: rgba(255,255,255,0.1);
    border: none;
    color: #F8F5F2;
    font-size: 0.7rem;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    cursor: pointer;
  }
  .demo-effect-row button:hover { background: rgba(255,255,255,0.2); }

  /* ---- Dashboard collapsed state ---- */
  .demo-dashboard--collapsed .demo-dashboard__body { display: none; }
</style>


<!-- ================================================================
     CLIENT-SIDE SCRIPTS
     ================================================================ -->
<script>
  /**
   * Inject noindex meta tag (BaseLayout doesn't expose a head slot)
   */
  const meta = document.createElement('meta');
  meta.name = 'robots';
  meta.content = 'noindex, nofollow';
  document.head.appendChild(meta);

  /**
   * Import the effects manager so it initialises and exposes window.effectsManager
   */
  import { effectsManager } from '../../lib/animation/effects-manager';
  import '../../lib/animation/pattern-morph';
  import '../../lib/animation/scroll-draw';
  import '../../lib/animation/icon-animation';
  import { setParallaxIntensity } from '../../lib/animation/stellar-parallax';

  /* ================================================================
     REGISTER EFFECTS WITH MANAGER
     The individual scripts (pattern-overlay.ts, physics-overlay.ts)
     don't self-register yet. Bridge the gap here for the demo.
     ================================================================ */
  function registerEffectsWithManager(): void {
    const em = effectsManager;

    // Register PatternOverlays
    document.querySelectorAll<HTMLElement>('.pattern-overlay').forEach(el => {
      const isMagnetic = el.getAttribute('data-pattern-magnetic') === 'true';
      em.register('pattern', el, {
        element: el,
        magnetic: isMagnetic,
        pause: () => { el.style.visibility = 'hidden'; },
        resume: () => { el.style.visibility = ''; },
      });
    });

    // Register RevealCanvases
    document.querySelectorAll<HTMLCanvasElement>('.reveal-canvas').forEach(canvas => {
      em.register('reveal-canvas', canvas, {
        canvas,
        active: true,
        animationId: null,
        pause: () => { canvas.style.visibility = 'hidden'; },
        resume: () => { canvas.style.visibility = ''; },
      });
    });

    // Register PhysicsOverlays (limited handle — no engine access from outside)
    document.querySelectorAll<HTMLElement>('.physics-overlay').forEach(el => {
      em.register('pattern', el, {
        element: el,
        magnetic: false,
        pause: () => { el.style.visibility = 'hidden'; },
        resume: () => { el.style.visibility = ''; },
      });
    });
  }

  // Wait for everything to mount
  setTimeout(registerEffectsWithManager, 500);

  /* ================================================================
     A11Y TOGGLE SYSTEM
     ================================================================ */
  const wrapper = document.getElementById('a11y-content-wrapper');
  const statusEl = document.getElementById('a11y-status');
  const toggleBtns = document.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]');

  // Theme classes are mutually exclusive (only one theme at a time)
  const themeClasses = [
    'a11y-theme-dark', 'a11y-theme-high-contrast', 'a11y-theme-monochrome',
    'a11y-theme-deuteranopia', 'a11y-theme-protanopia', 'a11y-theme-tritanopia',
    'a11y-theme-cream',
  ];

  toggleBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cls = btn.dataset.a11yToggle!;
      const isTheme = themeClasses.includes(cls);
      const isActive = btn.classList.contains('demo-toggle--active');

      if (isTheme && !isActive) {
        // Deactivate all other theme toggles
        toggleBtns.forEach(other => {
          if (themeClasses.includes(other.dataset.a11yToggle!) && other !== btn) {
            other.classList.remove('demo-toggle--active');
            wrapper?.classList.remove(other.dataset.a11yToggle!);
            document.documentElement.classList.remove(other.dataset.a11yToggle!);
          }
        });
      }

      // Toggle the class
      btn.classList.toggle('demo-toggle--active');
      const nowActive = btn.classList.contains('demo-toggle--active');

      if (wrapper) {
        wrapper.classList.toggle(cls, nowActive);
      }
      // Mirror to <html> for scrollbar pseudo-element styling
      document.documentElement.classList.toggle(cls, nowActive);

      updateA11yStatus();
    });
  });


  /* ================================================================
     SCROLL COLOUR → PATTERN COLOUR SYNC
     Now handled automatically by CSS:
     - scroll-color-background.ts sets --scroll-pattern-color on wrapper
     - PatternOverlay default color reads var(--scroll-pattern-color, currentColor)
     - All presets use mask-image so background-color controls the pattern colour
     ================================================================ */


  /* ================================================================
     A11Y STATUS CHECKS
     ================================================================ */
  function updateA11yStatus(): void {
    if (!statusEl || !wrapper) return;

    const checks: { label: string; status: 'pass' | 'fail' | 'na' }[] = [];

    const hasReduceMotion = wrapper.classList.contains('a11y-reduce-motion');
    const hasTextOnly = wrapper.classList.contains('a11y-text-only');

    // Check PatternOverlay visibility
    const patterns = document.querySelectorAll<HTMLElement>('.pattern-overlay');
    if (patterns.length > 0) {
      if (hasTextOnly) {
        const allHidden = Array.from(patterns).every(el => {
          const s = getComputedStyle(el);
          return s.display === 'none' || s.visibility === 'hidden' || s.opacity === '0';
        });
        checks.push({
          label: `Patterns hidden (${patterns.length})`,
          status: allHidden ? 'pass' : 'fail',
        });
      } else {
        checks.push({ label: `Patterns visible (${patterns.length})`, status: 'pass' });
      }
    }

    // Check SMIL animations
    const smilEls = document.querySelectorAll('animateTransform, animate');
    if (smilEls.length > 0) {
      if (hasReduceMotion) {
        // SMIL should be paused or removed
        checks.push({ label: 'SMIL: should be paused', status: 'na' });
      } else {
        checks.push({ label: `SMIL active (${smilEls.length})`, status: 'pass' });
      }
    }

    // Check PhysicsOverlay canvas
    const physicsCanvases = document.querySelectorAll<HTMLElement>('.physics-overlay');
    if (physicsCanvases.length > 0) {
      if (hasReduceMotion || hasTextOnly) {
        const allHidden = Array.from(physicsCanvases).every(el => {
          const s = getComputedStyle(el);
          return s.display === 'none' || s.visibility === 'hidden' || s.opacity === '0';
        });
        checks.push({
          label: 'Physics hidden',
          status: allHidden ? 'pass' : 'fail',
        });
      } else {
        checks.push({ label: 'Physics visible', status: 'pass' });
      }
    }

    // Check magnetic (should be disabled on reduce-motion)
    const magneticEls = document.querySelectorAll('[data-pattern-magnetic="true"]');
    if (magneticEls.length > 0) {
      if (hasReduceMotion) {
        checks.push({ label: 'Magnetic: should be disabled', status: 'na' });
      } else {
        checks.push({ label: `Magnetic active (${magneticEls.length})`, status: 'pass' });
      }
    }

    // Render status chips
    statusEl.innerHTML = checks.map(c =>
      `<span class="demo-status-chip demo-status-chip--${c.status}">${c.label}</span>`
    ).join('');
  }

  // Initial status check
  setTimeout(updateA11yStatus, 500);


  /* ================================================================
     PHYSICS CONTROLS
     ================================================================ */
  const physicsWarning = document.getElementById('physics-warning');
  const gravitySlider = document.getElementById('gravity-slider') as HTMLInputElement | null;
  const bounceSlider = document.getElementById('bounce-slider') as HTMLInputElement | null;
  const gravityVal = document.getElementById('gravity-val');
  const bounceVal = document.getElementById('bounce-val');

  // Show warning only if physics fails to load
  setTimeout(() => {
    if (typeof (window as any).physicsOverlay === 'undefined' && physicsWarning) {
      physicsWarning.style.display = '';
    }
  }, 2000);

  // Spawn button
  document.getElementById('physics-spawn')?.addEventListener('click', () => {
    const po = (window as any).physicsOverlay;
    if (po?.spawn) {
      const arena = document.querySelector('#physics-arena-default .physics-overlay');
      if (arena) po.spawn(arena);
    }
  });

  // Cursor mode buttons
  document.querySelectorAll<HTMLButtonElement>('[data-cursor-mode]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-cursor-mode]').forEach(b => b.classList.remove('demo-btn--active'));
      btn.classList.add('demo-btn--active');
      // If physics API is available, update cursor mode
      const po = (window as any).physicsOverlay;
      if (po?.setCursorMode) {
        po.setCursorMode(btn.dataset.cursorMode);
      }
    });
  });

  // Parallax intensity slider
  const parallaxSlider = document.getElementById('parallax-slider') as HTMLInputElement | null;
  const parallaxVal = document.getElementById('parallax-val');
  parallaxSlider?.addEventListener('input', () => {
    if (parallaxVal) parallaxVal.textContent = parallaxSlider.value;
    setParallaxIntensity(parseFloat(parallaxSlider.value));
  });

  /* ================================================================
     LIQUID REVEAL SYNC
     ================================================================ */
  setTimeout(() => {
    const arena = document.getElementById('liquid-reveal-arena');
    if (!arena) return;

    const physicsEl = arena.querySelector<HTMLElement>('.physics-overlay');
    const canvasEl = arena.querySelector<HTMLCanvasElement>('.reveal-canvas');

    if (physicsEl && canvasEl) {
      // Wait for physics engine to init, then sync
      const waitForEngine = setInterval(() => {
        if ((physicsEl as any).__matterEngine) {
          clearInterval(waitForEngine);
          effectsManager.syncLiquidReveal(physicsEl, canvasEl, { mode: 'eraser' });
        }
      }, 200);
      // Give up after 5s
      setTimeout(() => clearInterval(waitForEngine), 5000);
    }
  }, 300);

  // Liquid Reveal controls
  document.getElementById('liquid-reveal-spawn')?.addEventListener('click', () => {
    const arena = document.getElementById('liquid-reveal-arena');
    const physicsEl = arena?.querySelector('.physics-overlay');
    if (physicsEl) {
      physicsEl.dispatchEvent(new CustomEvent('physics-spawn'));
    }
  });

  document.getElementById('liquid-reveal-reset')?.addEventListener('click', () => {
    const arena = document.getElementById('liquid-reveal-arena');
    const canvasEl = arena?.querySelector<HTMLCanvasElement>('.reveal-canvas');
    if (canvasEl) {
      // Clear scratch mask
      (canvasEl as any).__scratchMask = null;
      // Clear external points
      (canvasEl as any).__externalRevealPoints = [];
    }
  });

  // Range sliders
  gravitySlider?.addEventListener('input', () => {
    if (gravityVal) gravityVal.textContent = gravitySlider.value;
    const po = (window as any).physicsOverlay;
    if (po?.setGravity) po.setGravity(parseFloat(gravitySlider.value));
  });
  bounceSlider?.addEventListener('input', () => {
    if (bounceVal) bounceVal.textContent = bounceSlider.value;
    const po = (window as any).physicsOverlay;
    if (po?.setBounce) po.setBounce(parseFloat(bounceSlider.value));
  });


  /* ================================================================
     EFFECTS MANAGER DASHBOARD
     ================================================================ */
  const dashboardToggle = document.getElementById('dashboard-toggle');
  const dashboard = document.getElementById('effects-dashboard');

  // Collapse/expand
  dashboardToggle?.addEventListener('click', () => {
    const collapsed = dashboard?.classList.toggle('demo-dashboard--collapsed');
    if (dashboardToggle) {
      dashboardToggle.textContent = collapsed ? '+' : '\u2212';
      dashboardToggle.setAttribute('aria-label', collapsed ? 'Expand panel' : 'Collapse panel');
    }
  });

  // Poll effects manager
  function updateDashboard(): void {
    const em = effectsManager as any; // access TS-private fields at runtime
    const statusEl = document.getElementById('em-status');
    const fpsEl = document.getElementById('em-fps');
    const throttleEl = document.getElementById('em-throttle');
    const registeredEl = document.getElementById('em-registered');
    const cacheEl = document.getElementById('em-cache');
    const effectsList = document.getElementById('em-effects-list');

    if (!em) {
      if (statusEl) statusEl.textContent = 'not loaded';
      return;
    }

    if (statusEl) statusEl.textContent = 'active';

    // FPS — only meaningful when the unified RAF loop is running
    const hasTickCallbacks = em.tickCallbacks?.size > 0;
    if (fpsEl) {
      if (hasTickCallbacks) {
        fpsEl.textContent = em.currentFps.toFixed(0);
      } else {
        fpsEl.textContent = 'N/A (no tick loop)';
      }
    }

    if (throttleEl) {
      if (!hasTickCallbacks) {
        throttleEl.textContent = 'N/A';
        throttleEl.style.color = '#888';
      } else {
        throttleEl.textContent = em.isThrottling ? 'YES' : 'no';
        throttleEl.style.color = em.isThrottling ? '#E74C3C' : '#6BCB77';
      }
    }

    // Registered effects count — TS "private" is runtime-accessible
    const effectsMap: Map<HTMLElement, any> | undefined = em.effects;
    if (registeredEl) {
      registeredEl.textContent = effectsMap ? String(effectsMap.size) : '--';
    }

    // Cache stats
    if (cacheEl) {
      const cache = em.textureCache;
      if (cache) {
        cacheEl.textContent = `${cache.size} entries`;
      } else {
        cacheEl.textContent = 'N/A';
      }
    }

    // Build active effects list
    if (effectsList && effectsMap) {
      if (effectsMap.size === 0) {
        effectsList.innerHTML = '<em>No effects registered</em>';
      } else {
        let html = '';
        effectsMap.forEach((effect: any, el: HTMLElement) => {
          const statusClass = effect.active
            ? 'demo-effect-row__status--active'
            : effect.visible
              ? 'demo-effect-row__status--paused'
              : 'demo-effect-row__status--unknown';
          const label = effect.type + (effect.handle?.magnetic ? ' (magnetic)' : '');
          const tag = el.id || el.className.split(' ')[0] || '?';
          html += `<div class="demo-effect-row">
            <span><span class="demo-effect-row__status ${statusClass}"></span>${label}</span>
            <span style="opacity:0.5;font-size:0.7rem">${tag}</span>
          </div>`;
        });
        effectsList.innerHTML = html;
      }
    }

    // Physics body count + FPS readout
    const bodyCountEl = document.getElementById('body-count');
    const physicsFpsEl = document.getElementById('physics-fps');
    const po = (window as any).physicsOverlay;
    if (bodyCountEl) {
      bodyCountEl.textContent = po?.bodyCount?.() ?? '0';
    }
    if (physicsFpsEl) {
      const fps = po?.fps?.();
      physicsFpsEl.textContent = fps > 0 ? String(fps) : '--';
    }
  }

  // Poll every 500ms
  setInterval(updateDashboard, 500);
  // First check after 1s (let things initialise)
  setTimeout(updateDashboard, 1000);
</script>
