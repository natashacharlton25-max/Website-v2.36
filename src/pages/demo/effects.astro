---
/**
 * Effects Test Bench
 *
 * Standalone demo page for visually testing and debugging the animation system:
 * PatternOverlay, PhysicsOverlay, ScrollColorBackground, Effects Manager, A11y.
 *
 * NOT a production page — prioritises clarity and toggles over polish.
 * Excluded from sitemap via meta robots (injected by script).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PatternOverlay from '../../components/atoms/effects/PatternOverlay/PatternOverlay.astro';
import PhysicsOverlay from '../../components/atoms/effects/PhysicsOverlay/PhysicsOverlay.astro';
import RevealCanvas from '../../components/atoms/canvas/RevealCanvas/RevealCanvas.astro';
import ScrollColorBackground from '../../components/atoms/effects/ScrollColorBackground/ScrollColorBackground.astro';
import Card from '../../components/atoms/ui/Card/Card.astro';
import Button from '../../components/atoms/ui/Button/Button.astro';
import Icon from '../../components/atoms/icons/Icon.astro';
---

<BaseLayout title="Effects Test Bench" hideFooter>
  <ScrollColorBackground />

  <!-- ============================================================
       SECTION 5: A11Y TEST PANEL — Sticky control bar
       ============================================================ -->
  <div class="demo-a11y-bar" id="demo-a11y-bar">
    <div class="demo-a11y-bar__row">
      <span class="demo-a11y-bar__title">A11y Toggles</span>
      <div class="demo-a11y-bar__toggles">
        <button class="demo-toggle" data-a11y-toggle="a11y-reduce-motion" type="button">
          <span class="demo-toggle__dot"></span>
          Reduce Motion
        </button>
        <button class="demo-toggle" data-a11y-toggle="a11y-text-only" type="button">
          <span class="demo-toggle__dot"></span>
          Text Only
        </button>
        <button class="demo-toggle" data-a11y-toggle="a11y-theme-dark" type="button">
          <span class="demo-toggle__dot"></span>
          Dark
        </button>
        <button class="demo-toggle" data-a11y-toggle="a11y-theme-high-contrast" type="button">
          <span class="demo-toggle__dot"></span>
          High Contrast
        </button>
        <button class="demo-toggle" data-a11y-toggle="a11y-theme-monochrome" type="button">
          <span class="demo-toggle__dot"></span>
          Monochrome
        </button>
        <button class="demo-toggle" data-a11y-toggle="a11y-theme-deuteranopia" type="button">
          <span class="demo-toggle__dot"></span>
          CVD: Deuter.
        </button>
        <button class="demo-toggle" data-a11y-toggle="a11y-theme-protanopia" type="button">
          <span class="demo-toggle__dot"></span>
          CVD: Protan.
        </button>
        <button class="demo-toggle" data-a11y-toggle="a11y-theme-tritanopia" type="button">
          <span class="demo-toggle__dot"></span>
          CVD: Tritan.
        </button>
      </div>
    </div>
    <div class="demo-a11y-bar__row" style="padding-top:0.4rem;">
      <label class="demo-range">
        Parallax Intensity: <output id="parallax-val">1</output>
        <input type="range" id="parallax-slider" min="0" max="2" step="0.1" value="1" />
      </label>
    </div>
    <div class="demo-a11y-bar__status" id="a11y-status"></div>
  </div>


  <!-- ============================================================
       SECTION 1: PatternOverlay Showcase
       ============================================================ -->
  <section class="demo-section" id="pattern-showcase" data-scroll-bg="#F8F5F2">
    <h2 class="demo-section__title">1. PatternOverlay Showcase</h2>
    <p class="demo-section__desc">
      Each card shows a different PatternOverlay mode against a visible background.
    </p>

    <div class="demo-card-grid">
      <!-- 1. Dots (static) -->
      <div class="demo-card" style="background-color: #F8F5F2;">
        <div class="demo-card__label">
          <code>preset="dots" opacity={0.3}</code>
        </div>
        <PatternOverlay preset="dots" opacity={0.3} />
      </div>

      <!-- 2. Dots Pulse (SMIL animated) -->
      <div class="demo-card" style="background-color: #EDE8E3;">
        <div class="demo-card__label">
          <code>preset="dots-pulse"</code> <span class="demo-tag">SMIL</span>
        </div>
        <PatternOverlay preset="dots-pulse" opacity={0.3} />
      </div>

      <!-- 3. Cross -->
      <div class="demo-card" style="background-color: #E8E0D8;">
        <div class="demo-card__label">
          <code>preset="cross"</code>
        </div>
        <PatternOverlay preset="cross" opacity={0.3} />
      </div>

      <!-- 4. Waves Flow (SMIL + angle) -->
      <div class="demo-card" style="background-color: #D4C9BC;">
        <div class="demo-card__label">
          <code>preset="waves-flow" angle={15}</code> <span class="demo-tag">SMIL</span>
        </div>
        <PatternOverlay preset="waves-flow" angle={15} opacity={0.3} />
      </div>

      <!-- 5. Icon mask (Phosphor — uses category path) -->
      <div class="demo-card" style="background-color: #C8B8A8;">
        <div class="demo-card__label">
          <code>icon="wellness/heart-fill"</code> <span class="demo-tag">mask</span>
        </div>
        <PatternOverlay icon="wellness/heart-fill" iconWeight="regular" opacity={0.5} color="#393531" scale={40} />
      </div>

      <!-- 6. Icon grid — interactive hover -->
      <div class="demo-card demo-card--tall" style="background-color: #BCA998;">
        <div class="demo-card__label">
          <code>icons=[...] interactive</code> <span class="demo-tag">grid+hover</span>
        </div>
        <PatternOverlay icons={['heart-fill', 'star-fill', 'flower-lotus-fill']} interactive opacity={0.3} />
      </div>

      <!-- 7. Icon grid — magnetic cursor -->
      <div class="demo-card demo-card--tall" style="background-color: #A89888;">
        <div class="demo-card__label">
          <code>icons=[...] magnetic</code> <span class="demo-tag">GSAP</span>
        </div>
        <PatternOverlay icons={['heart-fill', 'star-fill', 'flower-lotus-fill']} magnetic opacity={0.3} />
      </div>

      <!-- 8. Image fallback -->
      <div class="demo-card" style="background-color: #948478;">
        <div class="demo-card__label">
          <code>image="/Logo/Favicon.png"</code> <span class="demo-tag">image</span>
        </div>
        <PatternOverlay image="/Logo/Favicon.png" opacity={0.4} scale={40} />
      </div>
    </div>
  </section>


  <!-- ============================================================
       SECTION 2: PhysicsOverlay Playground
       ============================================================ -->
  <section class="demo-section" id="physics-playground" data-scroll-bg="#E8E0D8">
    <h2 class="demo-section__title">2. PhysicsOverlay Playground</h2>

    <div class="demo-banner demo-banner--warn" id="physics-warning" style="display:none;">
      <strong>PhysicsOverlay not responding.</strong>
      Check browser console for errors from <code>physics-overlay.ts</code>.
    </div>

    <div class="demo-controls" id="physics-controls">
      <button class="demo-btn" id="physics-spawn" type="button">Spawn Icons</button>

      <fieldset class="demo-fieldset">
        <legend>Cursor Mode</legend>
        <button class="demo-btn demo-btn--sm demo-btn--active" data-cursor-mode="repel" type="button">Repel</button>
        <button class="demo-btn demo-btn--sm" data-cursor-mode="attract" type="button">Attract</button>
        <button class="demo-btn demo-btn--sm" data-cursor-mode="none" type="button">None</button>
      </fieldset>

      <label class="demo-range">
        Gravity: <output id="gravity-val">1</output>
        <input type="range" id="gravity-slider" min="0" max="4" step="0.1" value="1" />
      </label>

      <label class="demo-range">
        Bounce: <output id="bounce-val">0.6</output>
        <input type="range" id="bounce-slider" min="0" max="1" step="0.05" value="0.6" />
      </label>

      <div class="demo-readout">
        Bodies: <strong id="body-count">0</strong>
        &nbsp;|&nbsp;
        FPS: <strong id="physics-fps">--</strong>
      </div>
    </div>

    <!-- Default ball pit config -->
    <div class="demo-physics-arena" id="physics-arena-default">
      <h3 class="demo-arena-label">Default: repel, bounce 0.6, gravity 1</h3>
      <PhysicsOverlay
        icons={['wellness/heart-fill', 'creative/star-fill', 'creative/sparkle-fill', 'nature/flower-lotus-fill']}
        iconWeight="regular"
        count={30}
        bounce={0.6}
        cursorMode="repel"
        color={['#C1440E', '#D4A017', '#5B8C5A', '#2E6B8A']}
        opacity={1}
        iconSize={32}
        contained
      />
    </div>

    <!-- Heavy mode -->
    <div class="demo-physics-arena" id="physics-arena-heavy">
      <h3 class="demo-arena-label">Heavy: gravity 2, bounce 0.9, count 50</h3>
      <PhysicsOverlay
        icons={['wellness/heart-fill', 'creative/star-fill', 'creative/sparkle-fill', 'nature/flower-lotus-fill']}
        iconWeight="regular"
        count={50}
        gravity={2}
        bounce={0.9}
        cursorMode="repel"
        color={['#8B4513', '#B8860B', '#2F4F4F', '#4A235A']}
        opacity={1}
        iconSize={32}
        contained
      />
    </div>
  </section>


  <!-- ============================================================
       SECTION 3: RevealCanvas + Liquid Reveal
       ============================================================ -->
  <section class="demo-section" id="reveal-canvas-section" data-scroll-bg="#D4C9BC">
    <h2 class="demo-section__title">3. RevealCanvas + Liquid Reveal</h2>
    <p class="demo-section__desc">
      Move your cursor over the dark area below to reveal the image via proximity circles.
      Component lives at <code>atoms/canvas/RevealCanvas/</code>.
    </p>

    <div class="demo-card-grid demo-card-grid--reveal">
      <!-- Circle (default) -->
      <div class="demo-reveal-container" id="reveal-circle">
        <div class="demo-reveal-container__label">
          <code>shape="circle"</code> <span class="demo-tag">default</span>
        </div>
        <RevealCanvas canvasId="reveal-demo-circle" shape="circle" />
      </div>

      <!-- Square -->
      <div class="demo-reveal-container" id="reveal-square">
        <div class="demo-reveal-container__label">
          <code>shape="square"</code>
        </div>
        <RevealCanvas canvasId="reveal-demo-square" shape="square" />
      </div>

      <!-- Hexagon -->
      <div class="demo-reveal-container" id="reveal-hex">
        <div class="demo-reveal-container__label">
          <code>shape="hexagon"</code>
        </div>
        <RevealCanvas canvasId="reveal-demo-hex" shape="hexagon" />
      </div>

      <!-- Diamond -->
      <div class="demo-reveal-container" id="reveal-diamond">
        <div class="demo-reveal-container__label">
          <code>shape="diamond"</code>
        </div>
        <RevealCanvas canvasId="reveal-demo-diamond" shape="diamond" />
      </div>

      <!-- Icon (heart) -->
      <div class="demo-reveal-container" id="reveal-icon">
        <div class="demo-reveal-container__label">
          <code>shape="icon" icon="heart"</code> <span class="demo-tag">mask</span>
        </div>
        <RevealCanvas canvasId="reveal-demo-icon" shape="icon" icon="wellness/heart-fill" iconWeight="regular" />
      </div>

      <!-- Icon (star) -->
      <div class="demo-reveal-container" id="reveal-icon-star">
        <div class="demo-reveal-container__label">
          <code>shape="icon" icon="star"</code> <span class="demo-tag">mask</span>
        </div>
        <RevealCanvas canvasId="reveal-demo-icon-star" shape="icon" icon="creative/star-fill" iconWeight="regular" />
      </div>
    </div>

    <div class="demo-banner demo-banner--info">
      <strong>Liquid Reveal sync</strong> — <code>effectsManager.syncLiquidReveal(physicsEl, canvasEl)</code>
      connects a PhysicsOverlay to a RevealCanvas so falling bodies act as erasers.
    </div>

    <!-- Live Liquid Reveal Demo — PhysicsOverlay + RevealCanvas synced -->
    <h3 class="demo-section__title" style="font-size:1.25rem; margin-top:2rem;">Live: Eraser Mode</h3>
    <p class="demo-section__desc" style="margin-bottom:1rem;">
      Falling icons "scratch off" the canvas to reveal the image. Uses <code>mode: 'eraser'</code>.
    </p>
    <div class="demo-liquid-reveal-arena" id="liquid-reveal-arena">
      <PhysicsOverlay
        icons={['wellness/heart-fill', 'creative/star-fill', 'nature/flower-lotus-fill']}
        iconWeight="regular"
        count={20}
        bounce={0.5}
        gravity={0.8}
        cursorMode="repel"
        color={['#C1440E', '#D4A017', '#5B8C5A']}
        opacity={0.8}
        iconSize={28}
        contained
      />
      <RevealCanvas canvasId="liquid-reveal-canvas" shape="circle" cellSize={20} proximity={0} growth={0} />
    </div>
    <div class="demo-controls" style="margin-top:1rem;">
      <button class="demo-btn" id="liquid-reveal-spawn" type="button">Spawn More</button>
      <button class="demo-btn" id="liquid-reveal-reset" type="button">Reset Canvas</button>
    </div>
  </section>


  <!-- ============================================================
       SECTION 3b: Scroll-Draw Connector Lines
       ============================================================ -->
  <section class="demo-section" id="scroll-draw-section" data-scroll-bg="#C8B8A8">
    <h2 class="demo-section__title">3b. Scroll-Draw Connectors</h2>
    <p class="demo-section__desc">
      SVGs draw themselves on scroll via <code>data-scroll-draw</code>.
      Connector lines thread between <code>data-connector-node</code> elements.
    </p>

    <!-- Element Draw variants -->
    <div class="demo-card-grid demo-card-grid--draw" style="min-height:300px;">
      <div class="demo-draw-card" data-scroll-draw data-draw-variant="draw" data-draw-scrub="true" data-draw-start="top 90%" data-draw-end="top 20%">
        <div class="demo-draw-card__label"><code>draw</code> <span class="demo-tag">scrub</span></div>
        <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M128 24a104 104 0 1 0 104 104A104.12 104.12 0 0 0 128 24Zm0 192a88 88 0 1 1 88-88 88.1 88.1 0 0 1-88 88Z" stroke="currentColor" stroke-width="2"/>
          <path d="M128 80v96M80 128h96" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>

      <div class="demo-draw-card" data-scroll-draw data-draw-variant="drawcenter" data-draw-scrub="true" data-draw-start="top 90%" data-draw-end="top 20%">
        <div class="demo-draw-card__label"><code>drawcenter</code> <span class="demo-tag">scrub</span></div>
        <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M178 40L128 128 78 40" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M178 216L128 128 78 216" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <div class="demo-draw-card" data-scroll-draw data-draw-variant="rainbowchase" data-draw-scrub="true" data-draw-start="top 90%" data-draw-end="top 20%">
        <div class="demo-draw-card__label"><code>rainbowchase</code> <span class="demo-tag">scrub</span></div>
        <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M32 128c0-53 43-96 96-96s96 43 96 96-43 96-96 96" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M128 64v128M64 128h128" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>

      <div class="demo-draw-card" data-scroll-draw data-draw-variant="pulse" data-draw-scrub="true" data-draw-start="top 90%" data-draw-end="top 20%">
        <div class="demo-draw-card__label"><code>pulse</code> <span class="demo-tag">scrub</span></div>
        <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 128h48l24-80 32 160 32-160 24 80h48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>

    <!-- Connector Line demo -->
    <h3 class="demo-section__title" style="font-size:1.25rem; margin-top:3rem;">Connector Line</h3>
    <p class="demo-section__desc" style="margin-bottom:1rem;">
      A line draws between nodes as you scroll through the container.
    </p>
    <div class="demo-connector-wrap" data-scroll-connector data-connector-color="#C1440E" data-connector-stroke="3">
      <div class="demo-connector-node" data-connector-node>
        <span class="demo-connector-node__label">Awareness</span>
      </div>
      <div class="demo-connector-node" data-connector-node>
        <span class="demo-connector-node__label">Understanding</span>
      </div>
      <div class="demo-connector-node" data-connector-node>
        <span class="demo-connector-node__label">Integration</span>
      </div>
      <div class="demo-connector-node" data-connector-node>
        <span class="demo-connector-node__label">Transformation</span>
      </div>
    </div>
  </section>


  <!-- ============================================================
       SECTION 4: Button Effects Showcase
       ============================================================ -->
  <section class="demo-section" id="button-effects-section" data-scroll-bg="#E8E0D8">
    <h2 class="demo-section__title">4. Button Effects</h2>
    <p class="demo-section__desc">
      The <code>effect</code> prop controls hover animation. The <code>speed</code> prop controls timing.
    </p>

    <h3 class="demo-section__title" style="font-size:1.1rem; margin-bottom:1.5rem;">Effect Variants</h3>
    <div class="demo-btn-grid">
      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label"><code>glint</code> <span class="demo-tag">default</span></div>
        <Button variant="primary">Glint Sweep</Button>
      </div>

      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label"><code>colour-flow</code></div>
        <Button variant="primary" effect="colour-flow">Colour Flow</Button>
      </div>

      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label"><code>colour-flow-left</code></div>
        <Button variant="primary" effect="colour-flow-left">Flow Left</Button>
      </div>

      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label"><code>colour-flow-reverse</code></div>
        <Button variant="primary" effect="colour-flow-reverse">Flow Reverse</Button>
      </div>

      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label"><code>tray-3d</code></div>
        <Button variant="primary" effect="tray-3d">Tray 3D</Button>
      </div>

      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label"><code>rainbow-border</code></div>
        <Button variant="primary" effect="rainbow-border">Rainbow Border</Button>
      </div>

      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label"><code>glow</code></div>
        <Button variant="primary" effect="glow">Glow</Button>
      </div>

      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label"><code>none</code></div>
        <Button variant="primary" effect="none">No Effect</Button>
      </div>
    </div>

    <h3 class="demo-section__title" style="font-size:1.1rem; margin-top:2.5rem; margin-bottom:1.5rem;">Speed × Variant Matrix</h3>
    <div class="demo-btn-grid">
      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label"><code>slow</code> + colour-flow</div>
        <Button variant="secondary" effect="colour-flow" speed="slow">Slow Flow</Button>
      </div>
      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label"><code>normal</code> + colour-flow</div>
        <Button variant="secondary" effect="colour-flow">Normal Flow</Button>
      </div>
      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label"><code>fast</code> + colour-flow</div>
        <Button variant="secondary" effect="colour-flow" speed="fast">Fast Flow</Button>
      </div>
      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label"><code>slow</code> + glint</div>
        <Button variant="primary" speed="slow">Slow Glint</Button>
      </div>
      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label"><code>fast</code> + glint</div>
        <Button variant="primary" speed="fast">Fast Glint</Button>
      </div>
      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label"><code>fast</code> + glow</div>
        <Button variant="neutral" effect="glow" speed="fast">Fast Glow</Button>
      </div>
    </div>

    <h3 class="demo-section__title" style="font-size:1.1rem; margin-top:2.5rem; margin-bottom:1.5rem;">Shapes × Effects</h3>
    <div class="demo-btn-grid">
      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label">pill + colour-flow</div>
        <Button variant="primary" shape="pill" effect="colour-flow">Pill Flow</Button>
      </div>
      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label">pill + rainbow-border</div>
        <Button variant="primary" shape="pill" effect="rainbow-border">Pill Rainbow</Button>
      </div>
      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label">sharp + tray-3d</div>
        <Button variant="primary" shape="sharp" effect="tray-3d">Sharp Tray</Button>
      </div>
      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label">circle + glow</div>
        <Button variant="primary" shape="circle" effect="glow" icon="creative/star-fill" />
      </div>
      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label">outline + colour-flow</div>
        <Button variant="outline" effect="colour-flow">Outline Flow</Button>
      </div>
      <div class="demo-btn-cell">
        <div class="demo-btn-cell__label">glass + glow</div>
        <Button variant="glass" effect="glow">Glass Glow</Button>
      </div>
    </div>
  </section>


  <!-- ============================================================
       SECTION 5: Icon Draw & Morph
       ============================================================ -->
  <section class="demo-section" id="icon-draw-section" data-scroll-bg="#D4C9BC">
    <h2 class="demo-section__title">5. Icon Draw & Morph</h2>
    <p class="demo-section__desc">
      Icons with <code>draw</code> animate their strokes. <code>morphTo</code> morphs between shapes on hover.
    </p>

    <h3 class="demo-section__title" style="font-size:1.1rem; margin-bottom:1.5rem;">Draw Variants (hover to play)</h3>
    <div class="demo-icon-grid">
      <div class="demo-icon-cell">
        <div class="demo-icon-cell__label"><code>draw</code></div>
        <Icon name="wellness/heart-fill" size={64} draw />
      </div>
      <div class="demo-icon-cell">
        <div class="demo-icon-cell__label"><code>drawcenter</code></div>
        <Icon name="creative/star-fill" size={64} draw="drawcenter" />
      </div>
      <div class="demo-icon-cell">
        <div class="demo-icon-cell__label"><code>rainbowchase</code></div>
        <Icon name="nature/flower-lotus-fill" size={64} draw="rainbowchase" />
      </div>
      <div class="demo-icon-cell">
        <div class="demo-icon-cell__label"><code>pulse</code></div>
        <Icon name="creative/sparkle-fill" size={64} draw="pulse" />
      </div>
      <div class="demo-icon-cell">
        <div class="demo-icon-cell__label"><code>flashgordon</code></div>
        <Icon name="creative/lightning-fill" size={64} draw="flashgordon" />
      </div>
      <div class="demo-icon-cell">
        <div class="demo-icon-cell__label"><code>chachaslide</code></div>
        <Icon name="nature/tree-fill" size={64} draw="chachaslide" />
      </div>
    </div>

    <h3 class="demo-section__title" style="font-size:1.1rem; margin-top:2.5rem; margin-bottom:1.5rem;">Draw on Scroll (scrubbed)</h3>
    <div class="demo-icon-grid">
      <div class="demo-icon-cell">
