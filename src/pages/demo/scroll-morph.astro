---
/**
 * Stellar Parallax Demo
 *
 * Clean page: scattered icon field at varied Z-depths with
 * atmospheric perspective (far=faint, near=bold).
 * Starfield of twinkling dots fills the far background.
 * Cards sit in the mid-ground.
 *
 * STRUCTURE: One ParallaxDecor spans the entire page so warped
 * icons can cross section boundaries without clipping.
 * Each section only defines its card + data-pattern-mode.
 *
 * NOT a production page — excluded via noindex.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/atoms/ui/Card/Card.astro';
import ParallaxDecor from '../../components/atoms/effects/ParallaxDecor/ParallaxDecor.astro';

const iconNames = [
  'creative/star-fill',
  'nature/leaf-fill',
  'wellness/heart-fill',
  'shapes/circles-three-fill',
  'creative/sparkle-fill',
];
---

<BaseLayout title="Stellar Parallax Demo" hideFooter>

  <div class="parallax-demo">

    <ParallaxDecor
      starfield={{ count: 300, seed: 3 }}
      scatter={{ names: iconNames, count: 100, seed: 1 }}
    />

    <section class="parallax-demo__section" data-pattern-mode="warp">
      <Card variant="liquid-glass" radius="xl" padding="xl">
        <h3 class="card__title" style="text-transform:none; letter-spacing:normal;">Warp</h3>
        <p class="card__text">Icons radiate outward from center on scroll. Hyperspace starfield — far dots barely drift, near ones fly past.</p>
      </Card>
    </section>

    <section class="parallax-demo__section" data-pattern-mode="converge">
      <Card variant="liquid-glass" radius="xl" padding="xl">
        <h3 class="card__title" style="text-transform:none; letter-spacing:normal;">Converge</h3>
        <p class="card__text">Reverse warp — icons pull inward as you scroll in. Dramatic entrance that draws the eye to center.</p>
      </Card>
    </section>

    <section class="parallax-demo__section" data-pattern-mode="drift">
      <Card variant="liquid-glass" radius="xl" padding="xl">
        <h3 class="card__title" style="text-transform:none; letter-spacing:normal;">Drift</h3>
        <p class="card__text">Lateral float — background slides left, foreground slides right. Gentle depth without radial drama.</p>
      </Card>
    </section>

    <section class="parallax-demo__section" data-pattern-mode="scatter">
      <Card variant="liquid-glass" radius="xl" padding="xl">
        <h3 class="card__title" style="text-transform:none; letter-spacing:normal;">Scatter</h3>
        <p class="card__text">Each icon gets a random direction. Chaotic energy burst — far ones fade, near ones explode outward.</p>
      </Card>
    </section>

    <section class="parallax-demo__section" data-pattern-mode="warp">
      <Card variant="liquid-glass" radius="xl" padding="xl">
        <h3 class="card__title" style="text-transform:none; letter-spacing:normal;">Full Stack</h3>
        <p class="card__text">All three layers: ambient CSS twinkle/float/breathe + warp scroll spread + stellar Y parallax.</p>
      </Card>
    </section>

  </div>

</BaseLayout>

<script>
  import '../../lib/animation/warp-parallax';
  import '../../lib/animation/scroll-hue-rotate';
</script>

<style>
  :global(body),
  :global(#a11y-content-wrapper) {
    background: var(--brand-c-bg);
  }
</style>
