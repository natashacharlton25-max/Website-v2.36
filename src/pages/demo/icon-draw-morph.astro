---
/**
 * Icon Draw & Morph — Scroll Stage Demo
 * NOT a production page — excluded via noindex.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import IconScrollStage from '../../components/organisms/IconScrollStage/IconScrollStage.astro';
---

<BaseLayout title="Icon Draw & Morph" hideFooter>

  <IconScrollStage icon="wellness/heart-fill" textSide="left">

    <section class="stage-step" data-stage="draw">
      <span class="stage-step__num">01</span>
      <h2 class="stage-step__title">Draw Heart</h2>
      <p class="stage-step__body">
        A heart draws itself stroke-by-stroke as you scroll.
        The leading edge of the stroke moves forward, revealing
        the outline progressively.
      </p>
    </section>

    <section class="stage-step" data-stage="flow">
      <span class="stage-step__num">02</span>
      <h2 class="stage-step__title">Flow</h2>
      <p class="stage-step__body">
        The trailing edge catches up — the stroke continues
        moving forward and flows off the end of the path,
        disappearing in the same direction it was drawn.
      </p>
    </section>

    <section class="stage-step" data-stage="draw" data-stage-morph="creative/star-fill" data-stage-color="var(--brand-c-secondary)">
      <span class="stage-step__num">03</span>
      <h2 class="stage-step__title">Draw Star</h2>
      <p class="stage-step__body">
        The path morphs to a star (invisible at this point),
        then the stroke draws on again. The colour shifts simultaneously.
      </p>
    </section>

    <section class="stage-step" data-stage="flow">
      <span class="stage-step__num">04</span>
      <h2 class="stage-step__title">Flow</h2>
      <p class="stage-step__body">
        The star flows off — same continuous forward motion.
        Draw on, flow off, draw on, flow off.
      </p>
    </section>

    <section class="stage-step" data-stage="draw" data-stage-morph="nature/leaf-fill" data-stage-color="var(--zone-pattern-primary)">
      <span class="stage-step__num">05</span>
      <h2 class="stage-step__title">Draw Leaf</h2>
      <p class="stage-step__body">
        Another shape, another colour — the stroke draws on
        as a leaf in green. MorphSVG swaps the path data
        while the shape is invisible, so the transition is seamless.
      </p>
    </section>

    <section class="stage-step" data-stage="flow">
      <span class="stage-step__num">06</span>
      <h2 class="stage-step__title">Flow</h2>
      <p class="stage-step__body">
        And the leaf flows off to complete the cycle.
        Each shape is one breath of a continuous line.
      </p>
    </section>

    <section class="stage-step" data-stage="draw" data-stage-morph="wellness/heart-fill" data-stage-color="var(--brand-c-primary)">
      <span class="stage-step__num">07</span>
      <h2 class="stage-step__title">Back to Heart</h2>
      <p class="stage-step__body">
        Full circle — the heart reappears in the original
        colour, drawn one last time.
      </p>
    </section>

  </IconScrollStage>

</BaseLayout>
