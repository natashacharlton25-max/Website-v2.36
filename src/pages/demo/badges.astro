---
/**
 * Badge Demo Page
 *
 * Visual test bench for the Badge component.
 * Shows all colour variants, style variants, shapes, and icon usage.
 * NOT a production page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/atoms/ui/Badge/Badge.astro';
---

<BaseLayout title="Badge Demo" hideFooter>

  <div class="badge-demo">
    <h1 class="text">Badge Component Demo</h1>
    <p class="text">All colour variants, style variants, shapes, and icon usage.</p>

    <!-- ============================================================
         COLOUR VARIANTS — FILL (default variant)
         ============================================================ -->
    <section class="badge-demo__section">
      <h2 class="text">Colour Variants (Fill)</h2>
      <div class="badge-demo__row">
        <Badge label="Primary" />
        <Badge label="Secondary" color="secondary" />
        <Badge label="Earth" color="earth" />
        <Badge label="Forest" color="forest" />
        <Badge label="Dusk" color="dusk" />
        <Badge label="Neutral" color="neutral" />
        <Badge label="Mist" color="mist" />
      </div>
    </section>

    <!-- ============================================================
         COLOUR VARIANTS — OUTLINE
         ============================================================ -->
    <section class="badge-demo__section">
      <h2 class="text">Colour Variants (Outline)</h2>
      <div class="badge-demo__row">
        <Badge label="Primary" variant="outline" />
        <Badge label="Secondary" color="secondary" variant="outline" />
        <Badge label="Earth" color="earth" variant="outline" />
        <Badge label="Forest" color="forest" variant="outline" />
        <Badge label="Dusk" color="dusk" variant="outline" />
        <Badge label="Neutral" color="neutral" variant="outline" />
        <Badge label="Mist" color="mist" variant="outline" />
      </div>
    </section>

    <!-- ============================================================
         GLASS VARIANTS
         ============================================================ -->
    <section class="badge-demo__section">
      <h2 class="text">Glass Variants</h2>
      <div class="badge-demo__row badge-demo__glass-bg">
        <Badge label="Glass" variant="glass" />
        <Badge label="Glass Light" variant="glass-light" />
        <Badge label="Glass Dark" variant="glass-dark" />
      </div>
    </section>

    <!-- ============================================================
         SHAPES
         ============================================================ -->
    <section class="badge-demo__section">
      <h2 class="text">Shapes</h2>
      <div class="badge-demo__row">
        <Badge label="Rounded (default)" />
        <Badge label="Pill" shape="pill" />
        <Badge label="Rounded Outline" variant="outline" />
        <Badge label="Pill Outline" variant="outline" shape="pill" />
      </div>
    </section>

    <!-- ============================================================
         TEXT TRANSFORM
         ============================================================ -->
    <section class="badge-demo__section">
      <h2 class="text">Text Transform</h2>
      <div class="badge-demo__row">
        <Badge label="Uppercase (default)" />
        <Badge label="Normal case" uppercase={false} />
        <Badge label="Pill Uppercase" shape="pill" />
        <Badge label="Pill Normal" shape="pill" uppercase={false} />
      </div>
    </section>

    <!-- ============================================================
         SQUARED SHAPE
         ============================================================ -->
    <section class="badge-demo__section">
      <h2 class="text">Squared Shape</h2>
      <div class="badge-demo__row">
        <Badge label="Primary" shape="squared" />
        <Badge label="Secondary" color="secondary" shape="squared" />
        <Badge label="Earth" color="earth" shape="squared" />
        <Badge label="Forest" color="forest" shape="squared" />
        <Badge label="Dusk" color="dusk" shape="squared" />
        <Badge label="Neutral" color="neutral" shape="squared" />
        <Badge label="Mist" color="mist" shape="squared" />
      </div>
      <div class="badge-demo__row" style="margin-top: var(--space-md);">
        <Badge label="Squared Outline" variant="outline" shape="squared" />
        <Badge label="Squared Outline" color="secondary" variant="outline" shape="squared" />
        <Badge label="Squared Outline" color="forest" variant="outline" shape="squared" />
      </div>
    </section>

    <!-- ============================================================
         WITH ICONS
         ============================================================ -->
    <section class="badge-demo__section">
      <h2 class="text">With Icons</h2>
      <div class="badge-demo__row">
        <Badge label="Verified" icon="shield-check-fill" />
        <Badge label="Certified" icon="seal-check-fill" color="forest" />
        <Badge label="Star" icon="star-fill" color="earth" />
        <Badge label="Heart" icon="heart-fill" color="dusk" variant="outline" />
        <Badge label="Award" icon="trophy-fill" color="secondary" shape="pill" />
      </div>
    </section>

    <!-- ============================================================
         FULL MATRIX — FILL × ALL COLOURS × PILL
         ============================================================ -->
    <section class="badge-demo__section">
      <h2 class="text">Full Matrix: Fill + Pill</h2>
      <div class="badge-demo__row">
        <Badge label="Primary" shape="pill" />
        <Badge label="Secondary" color="secondary" shape="pill" />
        <Badge label="Earth" color="earth" shape="pill" />
        <Badge label="Forest" color="forest" shape="pill" />
        <Badge label="Dusk" color="dusk" shape="pill" />
        <Badge label="Neutral" color="neutral" shape="pill" />
        <Badge label="Mist" color="mist" shape="pill" />
      </div>
    </section>

    <!-- ============================================================
         FULL MATRIX — OUTLINE × ALL COLOURS × PILL
         ============================================================ -->
    <section class="badge-demo__section">
      <h2 class="text">Full Matrix: Outline + Pill</h2>
      <div class="badge-demo__row">
        <Badge label="Primary" variant="outline" shape="pill" />
        <Badge label="Secondary" color="secondary" variant="outline" shape="pill" />
        <Badge label="Earth" color="earth" variant="outline" shape="pill" />
        <Badge label="Forest" color="forest" variant="outline" shape="pill" />
        <Badge label="Dusk" color="dusk" variant="outline" shape="pill" />
        <Badge label="Neutral" color="neutral" variant="outline" shape="pill" />
        <Badge label="Mist" color="mist" variant="outline" shape="pill" />
      </div>
    </section>

  </div>

</BaseLayout>

<style is:global>
  .badge-demo {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-lg);
  }

  .badge-demo h1 {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-sm);
  }

  .badge-demo > p {
    color: var(--brand-c-text-light);
    margin-bottom: var(--space-2xl);
  }

  .badge-demo__section {
    margin-bottom: var(--space-3xl);
  }

  .badge-demo__section h2 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--brand-c-neutral-light);
  }

  .badge-demo__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
  }

  .badge-demo__glass-bg {
    background: linear-gradient(135deg, var(--brand-c-primary-light), var(--brand-c-secondary-light));
    padding: var(--space-lg);
    border-radius: var(--radius-md);
  }
</style>
