---
/**
 * Card Demo Page
 *
 * Visual test bench for the Card component.
 * Shows all variants, hover modes, shadow/radius/padding/border scales.
 * NOT a production page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/atoms/ui/Card/Card.astro';
import Grid from '../../components/atoms/grid/Grid.astro';
import RainbowBorderCard from '../../components/molecules/cards/RainbowBorderCard.astro';
import ImageRevealCard from '../../components/molecules/cards/ImageRevealCard.astro';
import ChoiceCard from '../../components/molecules/cards/ChoiceCard.astro';
import SlideCard from '../../components/molecules/cards/SlideCard.astro';
import FlipCard from '../../components/molecules/cards/FlipCard.astro';
import GlowCard from '../../components/molecules/cards/GlowCard.astro';
import BlogCard from '../../components/molecules/cards/BlogCard.astro';
import TeamCard from '../../components/molecules/cards/TeamCard.astro';
import TestimonialCard from '../../components/molecules/cards/TestimonialCard.astro';
import AssetCard from '../../components/molecules/cards/AssetCard.astro';
import InfoCard from '../../components/molecules/cards/InfoCard.astro';
import '../../styles/pages/card-demo.css';
---

<BaseLayout title="Card Demo" hideFooter>

  <div class="card-demo">
    <h1 class="text">Card Component Demo</h1>
    <p class="text">All variants, hover modes, shadow scales, radius, padding, and border options.</p>

    <!-- ============================================================
         VARIANTS
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Variants</h2>
      <Grid minWidth="280px" gap="var(--space-lg)" class="card-demo__tinted-bg">
        <Card variant="default" padding="lg" shadow="lg" radius="md">
          <div class="card__content">
            <h3 class="card__title">Default</h3>
            <p class="card__text">Solid background with shadow.</p>
          </div>
        </Card>

        <Card variant="transparent" padding="lg" radius="md">
          <div class="card__content">
            <h3 class="card__title">Transparent</h3>
            <p class="card__text">No background, no border — content only.</p>
          </div>
        </Card>

        <Card variant="outline" padding="lg" radius="md">
          <div class="card__content">
            <h3 class="card__title">Outline</h3>
            <p class="card__text">Border only, transparent background.</p>
          </div>
        </Card>

        <Card variant="glass" padding="lg" radius="md">
          <div class="card__content">
            <h3 class="card__title">Glass</h3>
            <p class="card__text">Frosted glass with backdrop blur.</p>
          </div>
        </Card>

        <Card variant="liquid-glass" padding="lg" radius="md">
          <div class="card__content">
            <h3 class="card__title" style="color: var(--color-White);">Liquid Glass</h3>
            <p class="card__text" style="color: color-mix(in oklch, var(--color-White) 80%, transparent);">Designed for dark/coloured backgrounds.</p>
          </div>
        </Card>
      </Grid>
    </section>

    <!-- ============================================================
         NEUMORPHIC
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Neumorphic</h2>
      <p class="text card-demo__hint">Two modes: glow border on hover, or inset pressed shadow on hover.</p>
      <Grid minWidth="280px" gap="var(--space-lg)">
        <Card variant="neumorphic" padding="lg" radius="md">
          <div class="card__content">
            <h3 class="card__title">Glow Hover</h3>
            <p class="card__text">Raised shadow + glow border on hover.</p>
          </div>
        </Card>

        <Card variant="neumorphic" padding="lg" radius="lg">
          <div class="card__content">
            <h3 class="card__title">Glow Large</h3>
            <p class="card__text">Larger radius with glow border hover.</p>
          </div>
        </Card>

        <Card variant="neumorphic-pressed" padding="lg" radius="md">
          <div class="card__content">
            <h3 class="card__title">Pressed Hover</h3>
            <p class="card__text">Raised shadow pushes inward on hover.</p>
          </div>
        </Card>

        <Card variant="neumorphic-pressed" padding="lg" radius="lg">
          <div class="card__content">
            <h3 class="card__title">Pressed Large</h3>
            <p class="card__text">Inset shadow with larger radius.</p>
          </div>
        </Card>
      </Grid>
    </section>

    <!-- ============================================================
         COMIC
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Comic</h2>
      <p class="text card-demo__hint">Thick border, hard offset shadow. Pushes in on hover/click.</p>
      <Grid minWidth="280px" gap="var(--space-lg)">
        <Card variant="comic" padding="lg" radius="md">
          <div class="card__content">
            <h3 class="card__title">Comic</h3>
            <p class="card__text">Bold offset shadow with thick border. Click to push flat.</p>
          </div>
        </Card>

        <Card variant="comic" padding="lg" radius="lg">
          <div class="card__content">
            <h3 class="card__title">Comic Rounded</h3>
            <p class="card__text">Larger radius for a softer comic feel.</p>
          </div>
        </Card>

        <Card variant="comic" padding="lg" radius="none">
          <div class="card__content">
            <h3 class="card__title">Comic Sharp</h3>
            <p class="card__text">No radius for a raw comic-panel look.</p>
          </div>
        </Card>
      </Grid>
    </section>

    <!-- ============================================================
         TECH
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Tech</h2>
      <p class="text card-demo__hint">Offset border frame swaps position on hover.</p>
      <Grid minWidth="280px" gap="var(--space-lg)">
        <Card variant="tech" padding="lg" radius="md">
          <div class="card__content">
            <h3 class="card__title">Tech</h3>
            <p class="card__text">Ghost border frame shifts on hover.</p>
          </div>
        </Card>

        <Card variant="tech" padding="lg" radius="none">
          <div class="card__content">
            <h3 class="card__title">Tech Sharp</h3>
            <p class="card__text">Sharp corners for a more mechanical feel.</p>
          </div>
        </Card>

        <Card variant="tech" padding="lg" radius="sm">
          <div class="card__content">
            <h3 class="card__title">Tech Subtle</h3>
            <p class="card__text">Small radius, cleaner look.</p>
          </div>
        </Card>
      </Grid>
    </section>

    <!-- ============================================================
         RAINBOW BORDER
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Rainbow Border</h2>
      <p class="text card-demo__hint">Animated conic gradient border on hover. Three variants: primary, gradient, pulse.</p>
      <Grid minWidth="280px" gap="var(--space-lg)">
        <RainbowBorderCard variant="primary">
          <div class="card__content">
            <h3 class="card__title">Primary</h3>
            <p class="card__text">Solid brand colour expands into rotating gradient on hover.</p>
          </div>
        </RainbowBorderCard>

        <RainbowBorderCard variant="gradient">
          <div class="card__content">
            <h3 class="card__title">Gradient</h3>
            <p class="card__text">Static conic gradient starts rotating on hover.</p>
          </div>
        </RainbowBorderCard>

        <RainbowBorderCard variant="pulse">
          <div class="card__content">
            <h3 class="card__title">Pulse</h3>
            <p class="card__text">Rotation with brightness oscillation on hover.</p>
          </div>
        </RainbowBorderCard>
      </Grid>
    </section>

    <!-- ============================================================
         RAINBOW BORDER — CUSTOM COLOURS
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Rainbow Border — Custom Colours</h2>
      <p class="text card-demo__hint">Override with different brand tokens or custom values.</p>
      <Grid minWidth="280px" gap="var(--space-lg)">
        <RainbowBorderCard
          variant="gradient"
          primaryColor="var(--brand-c-secondary)"
          secondaryColor="var(--brand-c-primary)"
          highlightColor="var(--brand-c-secondary-light)"
        >
          <div class="card__content">
            <h3 class="card__title">Secondary Palette</h3>
            <p class="card__text">Using secondary brand colours for the gradient.</p>
          </div>
        </RainbowBorderCard>

        <RainbowBorderCard
          variant="gradient"
          primaryColor="var(--zone-bg-forest-mid, #4a7c59)"
          secondaryColor="var(--zone-bg-earth-mid, #a67c52)"
          highlightColor="var(--zone-bg-forest-soft, #e8f0e5)"
          borderWidth="4px"
          borderRadius="var(--radius-lg)"
        >
          <div class="card__content">
            <h3 class="card__title">Earth + Forest</h3>
            <p class="card__text">Zone palette tokens with thicker border and larger radius.</p>
          </div>
        </RainbowBorderCard>

        <RainbowBorderCard
          variant="pulse"
          primaryColor="var(--zone-bg-dusk-mid, #7c5a8c)"
          secondaryColor="var(--brand-c-primary)"
          highlightColor="var(--zone-bg-dusk-soft, #ede5f0)"
          borderRadius="var(--radius-xl)"
        >
          <div class="card__content">
            <h3 class="card__title">Dusk Pulse</h3>
            <p class="card__text">Dusk zone colours with pulse brightness effect.</p>
          </div>
        </RainbowBorderCard>
      </Grid>
    </section>

    <!-- ============================================================
         RAINBOW BORDER — WITH IMAGES
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Rainbow Border — With Images</h2>
      <p class="text card-demo__hint">Images sit flush inside the animated border. Text content below.</p>
      <Grid minWidth="280px" gap="var(--space-lg)">
        <RainbowBorderCard variant="gradient" borderRadius="var(--radius-lg)">
          <div class="card__image card__image--video">
            <img src="/_Unused Images/Projects Hero.jpg" alt="Demo project" />
          </div>
          <div class="card__content">
            <h3 class="card__title">Project Showcase</h3>
            <p class="card__text">Image card with gradient rainbow border.</p>
          </div>
        </RainbowBorderCard>

        <RainbowBorderCard variant="primary" borderRadius="var(--radius-lg)">
          <div class="card__image card__image--video">
            <img src="/_Unused Images/3.jpg" alt="Demo landscape" />
          </div>
          <div class="card__content">
            <h3 class="card__title">Primary Image</h3>
            <p class="card__text">Solid border reveals gradient on hover.</p>
          </div>
        </RainbowBorderCard>

        <RainbowBorderCard variant="pulse" borderRadius="var(--radius-lg)" borderWidth="4px">
          <div class="card__image card__image--video">
            <img src="/_Unused Images/7.jpg" alt="Demo scene" />
          </div>
          <div class="card__content">
            <h3 class="card__title">Pulse Image</h3>
            <p class="card__text">Thicker border with pulsing brightness.</p>
          </div>
        </RainbowBorderCard>
      </Grid>
    </section>

    <!-- ============================================================
         IMAGE REVEAL CARDS
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Image Reveal Cards</h2>
      <p class="text card-demo__hint">Image fills the card at rest. Hover to squish and reveal content with staggered animations.</p>
      <div class="card-demo__row-center">
        <ImageRevealCard
          image="/_Unused Images/Projects Hero.jpg"
          imageAlt="Project showcase"
          title="Project Alpha"
          description="A showcase of creative work spanning brand identity, web design, and digital experiences."
          tag="12K"
          size="sm"
        />

        <ImageRevealCard
          image="/_Unused Images/9.jpg"
          imageAlt="Creative scene"
          imagePos="50% 30%"
          title="Studio Work"
          description="Behind the scenes of our latest campaign shoot and creative direction."
          tag="8.5K"
          borderColor="var(--brand-c-secondary)"
        />

        <ImageRevealCard
          image="/_Unused Images/3.jpg"
          imageAlt="Landscape"
          imagePos="50% 50%"
          title="Nature Series"
          description="Exploring natural patterns, textures, and the beauty of organic forms."
          tag="24K"
          size="lg"
          dark
        />
      </div>
    </section>

    <!-- ============================================================
         IMAGE STACK OVERFLOW CARDS
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Image Stack Cards</h2>
      <p class="text card-demo__hint">Image overflows above the card for a stacked/layered look.</p>
      <Grid minWidth="280px" gap="var(--space-lg)">
        <Card variant="outline" radius="lg" padding="none" class="stack-card">
          <section class="stack-card__section">
            <div class="stack-card__inner">
              <div class="stack-card__image stack-card__image--shadow-md">
                <img src="/_Unused Images/Projects Hero.jpg" alt="Project showcase" />
              </div>
              <div class="card__content">
                <h3 class="card__title">Medium Shadow</h3>
                <p class="card__text">Image floats above with medium drop shadow.</p>
              </div>
            </div>
          </section>
        </Card>

        <Card variant="default" radius="lg" padding="none" shadow="lg" class="stack-card">
          <section class="stack-card__section">
            <div class="stack-card__inner">
              <div class="stack-card__image stack-card__image--shadow-lg">
                <img src="/_Unused Images/3.jpg" alt="Landscape" />
              </div>
              <div class="card__content">
                <h3 class="card__title">Large Shadow</h3>
                <p class="card__text">Deeper drop shadow for a more elevated feel.</p>
              </div>
            </div>
          </section>
        </Card>

        <Card variant="outline" radius="lg" padding="none" hover="glow" class="stack-card">
          <section class="stack-card__section">
            <div class="stack-card__inner">
              <div class="stack-card__image stack-card__image--shadow-xl">
                <img src="/_Unused Images/7.jpg" alt="Scene" />
              </div>
              <div class="card__content">
                <h3 class="card__title">XL Shadow + Glow</h3>
                <p class="card__text">Heavy drop shadow with glow hover on the card.</p>
              </div>
            </div>
          </section>
        </Card>
      </Grid>
    </section>

    <!-- ============================================================
         CHOICE / SELECTION CARDS
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Choice Cards</h2>
      <p class="text card-demo__hint">Selectable image cards for quizzes, forms, and polls. Inverted border radius notch on the label tray. Click to toggle.</p>
      <Grid columns={2} gap="var(--space-lg)">
        <ChoiceCard
          image="/_Unused Images/Projects Hero.jpg"
          label="creative direction"
          name="ambitions"
          value="creative"
        />
        <ChoiceCard
          image="/_Unused Images/9.jpg"
          label="brand identity"
          name="ambitions"
          value="brand"
        />
        <ChoiceCard
          image="/_Unused Images/3.jpg"
          label="digital experience"
          name="ambitions"
          value="digital"
        />
        <ChoiceCard
          image="/_Unused Images/7.jpg"
          label="visual storytelling"
          name="ambitions"
          value="visual"
          checked
        />
      </Grid>
    </section>

    <!-- ============================================================
         SLIDE CARDS
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Slide Cards</h2>
      <p class="text card-demo__hint">Two faces overlap at rest. Hover to slide apart and reveal content. Front face changes to accent colour.</p>
      <Grid columns={3} gap="var(--space-xl)">
        <SlideCard
          icon="pencil-simple-fill"
          title="Design"
          description="Crafting visual identities and digital experiences that resonate with your audience."
          href="#"
        />
        <SlideCard
          icon="code-fill"
          title="Code"
          description="Building robust, performant, and accessible web applications from the ground up."
          href="#"
          accentColor="var(--brand-c-secondary)"
        />
        <SlideCard
          icon="rocket-launch-fill"
          title="Launch"
          description="Deploying, optimising, and scaling your digital products for real-world impact."
          href="#"
          accentColor="var(--zone-bg-forest-mid, #4a7c59)"
        />
      </Grid>
    </section>

    <!-- ============================================================
         FLIP CARDS
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Flip Cards</h2>
      <p class="text card-demo__hint">3D perspective flip on hover. Front shows title + arrow, back reveals description + CTA.</p>
      <div class="card-demo__flip-grid">
        <FlipCard
          title="Creative Direction"
          subtitle="Strategy meets aesthetics"
          description="We blend strategic thinking with visual design to create brands that stand out and connect with their audience."
          href="#"
          frontImage="/_Unused Images/Projects Hero.jpg"
        />
        <FlipCard
          title="Development"
          subtitle="Built to perform"
          description="Modern web applications built with best practices — fast, accessible, and scalable from day one."
          href="#"
          frontImage="/_Unused Images/3.jpg"
        />
        <FlipCard
          title="Brand Identity"
          subtitle="Your story, visualised"
          description="From logo to full brand system, we craft identities that are memorable, cohesive, and built to grow."
          href="#"
          frontImage="/_Unused Images/7.jpg"
        />
      </div>
    </section>

    <!-- ============================================================
         FLIP CARDS — COLOUR ONLY
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Flip Cards — Colour Only</h2>
      <p class="text card-demo__hint">No background images — using solid brand colours for front and back faces.</p>
      <div class="card-demo__flip-grid">
        <FlipCard
          title="Primary"
          subtitle="Default brand colour"
          description="Uses --brand-c-primary for front and --brand-c-primary-dark for back."
          href="#"
        />
        <FlipCard
          title="Secondary"
          subtitle="Alternate palette"
          description="Secondary brand colours create a different feel while staying on-brand."
          href="#"
          frontColor="var(--brand-c-secondary)"
          backColor="var(--brand-c-secondary-dark)"
        />
        <FlipCard
          title="Forest"
          subtitle="Zone colour"
          description="Zone palette tokens work great for themed sections or campaigns."
          href="#"
          frontColor="var(--zone-bg-forest-mid, #4a7c59)"
          backColor="var(--zone-bg-forest-deep, #2d5a3a)"
        />
      </div>
    </section>

    <!-- ============================================================
         GLASS VARIANTS ON GRADIENT BACKGROUND
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Glass on Gradient</h2>
      <Grid minWidth="280px" gap="var(--space-lg)" class="card-demo__glass-bg">
        <Card variant="glass" padding="lg" radius="md">
          <div class="card__content">
            <h3 class="card__title" style="color: var(--color-White);">Glass</h3>
            <p class="card__text" style="color: color-mix(in oklch, var(--color-White) 80%, transparent);">Frosted glass on a coloured background.</p>
          </div>
        </Card>

        <Card variant="liquid-glass" padding="lg" radius="md">
          <div class="card__content">
            <h3 class="card__title" style="color: var(--color-White);">Liquid Glass</h3>
            <p class="card__text" style="color: color-mix(in oklch, var(--color-White) 80%, transparent);">Liquid glass on a coloured background.</p>
          </div>
        </Card>
      </Grid>
    </section>

    <!-- ============================================================
         HOVER MODES
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Hover Modes</h2>
      <p class="text card-demo__hint">Hover over each card to see the effect.</p>
      <Grid minWidth="280px" gap="var(--space-lg)">
        <Card variant="outline" padding="lg" radius="md" hover={true}>
          <div class="card__content">
            <h3 class="card__title">Lift</h3>
            <p class="card__text">Card lifts up on hover with enhanced shadow.</p>
          </div>
        </Card>

        <Card variant="outline" padding="lg" radius="md" hover="border">
          <div class="card__content">
            <h3 class="card__title">Border</h3>
            <p class="card__text">Border colour changes on hover.</p>
          </div>
        </Card>

        <Card variant="outline" padding="lg" radius="md" hover="glow">
          <div class="card__content">
            <h3 class="card__title">Glow</h3>
            <p class="card__text">Glowing box-shadow on hover.</p>
          </div>
        </Card>
      </Grid>
    </section>

    <!-- ============================================================
         SHADOW SCALE
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Shadow Scale</h2>
      <Grid minWidth="280px" gap="var(--space-lg)">
        <Card variant="outline" padding="md" radius="md" shadow="none">
          <div class="card__content">
            <h3 class="card__title">None</h3>
          </div>
        </Card>
        <Card variant="outline" padding="md" radius="md" shadow="sm">
          <div class="card__content">
            <h3 class="card__title">Small</h3>
          </div>
        </Card>
        <Card variant="outline" padding="md" radius="md" shadow="md">
          <div class="card__content">
            <h3 class="card__title">Medium</h3>
          </div>
        </Card>
        <Card variant="outline" padding="md" radius="md" shadow="lg">
          <div class="card__content">
            <h3 class="card__title">Large</h3>
          </div>
        </Card>
        <Card variant="outline" padding="md" radius="md" shadow="xl">
          <div class="card__content">
            <h3 class="card__title">XL</h3>
          </div>
        </Card>
      </Grid>
    </section>

    <!-- ============================================================
         DROP SHADOW SCALE
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Drop Shadow Scale</h2>
      <Grid minWidth="280px" gap="var(--space-lg)">
        <Card variant="outline" padding="md" radius="md" dropShadow="sm">
          <div class="card__content">
            <h3 class="card__title">Small</h3>
          </div>
        </Card>
        <Card variant="outline" padding="md" radius="md" dropShadow="md">
          <div class="card__content">
            <h3 class="card__title">Medium</h3>
          </div>
        </Card>
        <Card variant="outline" padding="md" radius="md" dropShadow="lg">
          <div class="card__content">
            <h3 class="card__title">Large</h3>
          </div>
        </Card>
        <Card variant="outline" padding="md" radius="md" dropShadow="xl">
          <div class="card__content">
            <h3 class="card__title">XL</h3>
          </div>
        </Card>
      </Grid>
    </section>

    <!-- ============================================================
         RADIUS SCALE
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Radius Scale</h2>
      <Grid minWidth="280px" gap="var(--space-lg)">
        <Card variant="outline" padding="md" radius="none">
          <div class="card__content">
            <h3 class="card__title">None</h3>
          </div>
        </Card>
        <Card variant="outline" padding="md" radius="sm">
          <div class="card__content">
            <h3 class="card__title">Small</h3>
          </div>
        </Card>
        <Card variant="outline" padding="md" radius="md">
          <div class="card__content">
            <h3 class="card__title">Medium</h3>
          </div>
        </Card>
        <Card variant="outline" padding="md" radius="lg">
          <div class="card__content">
            <h3 class="card__title">Large</h3>
          </div>
        </Card>
        <Card variant="outline" padding="md" radius="xl">
          <div class="card__content">
            <h3 class="card__title">XL</h3>
          </div>
        </Card>
        <Card variant="outline" padding="md" radius="full">
          <div class="card__content">
            <h3 class="card__title">Full</h3>
          </div>
        </Card>
      </Grid>
    </section>

    <!-- ============================================================
         PADDING SCALE
         No .card__content wrapper — shows actual card padding
         ============================================================ -->
    <section class="card-demo__section">
      <h2 class="text">Padding Scale</h2>
      <Grid minWidth="280px" gap="var(--space-lg)">
        <Card variant="outline" radius="md" padding="none">
          <h3 class="card__title" style="padding: 0; margin: 0;">None</h3>
        </Card>
        <Card variant="outline" radius="md" padding="xs">
          <h3 class="card__title" style="padding: 0; margin: 0;">XS</h3>
        </Card>
        <Card variant="outline" radius="md" padding="sm">
          <h3 class="card__title" style="padding: 0; margin: 0;">SM</h3>
        </Card>
        <Card variant="outline" radius="md" padding="md">
          <h3 class="card__title" style="padding: 0; margin: 0;">MD</h3>
        </Card>
        <Card variant="outline" radius="md" padding="lg">
          <h3 class="card__title" style="padding: 0; margin: 0;">LG</h3>
        </Card>
        <Card variant="outline" radius="md" padding="xl">
