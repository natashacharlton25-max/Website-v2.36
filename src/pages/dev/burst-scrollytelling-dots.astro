---
/**
 * Burst scrollytelling — DOTS variant.
 *
 * Layout:
 *   1. Hero section — dots form a word at viewport centre on click.
 *   2. Five card sections — each has a card on one side and the dots
 *      forming a word on the opposite side. Layout alternates
 *      (card-left/dots-right, card-right/dots-left, ...).
 *
 * Each card section uses trigger='viewport' so the dots fire when
 * the section enters viewport. Live-origin tracking in the engine
 * keeps the letters next to the card as the section scrolls. When
 * the section exits, scroll-release sends the dots into a swarm at
 * the edges; the next card section picks them up.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Renderer from '../../components/Renderer.astro';

const sharedBurstProps = {
  engine: 'physics',
  palette: 'rainbow',
  count: 600,
  spread: 100,
  gravity: 0,
  lifespan: 8000,
  collide: false,
  from: 'edges',
  to: 'origin',
  traceSize: 800,
  particle: { component: 'Shape', shape: 'circle', size: 'xs' },
};

// Phrases cycle through the 3 we have in registry.json — user can add
// more phrases there + run npm run build:text-paths to extend.
const PHRASES = ['hello', 'welcome', 'brand', 'hello', 'welcome'];

// Build a card section. side='left' = card-left/dots-right;
// 'right' = card-right/dots-left.
function cardSection(side: 'left' | 'right', phrase: string, cardTitle: string, cardBody: string) {
  const card = {
    component: 'Card',
    variant: 'default',
    padding: 'lg',
    radius: 'lg',
    shadow: 'md',
    class: 'scrolly-card',
    children: [
      { component: 'Heading', level: 3, contentHeading: cardTitle, size: 'md' },
      { component: 'Text', contentText: cardBody },
    ],
  };
  const dots = {
    ...sharedBurstProps,
    component: 'Burst',
    tracePath: `phrase:${phrase}`,
    trigger: 'viewport',
    class: 'scrolly-dots',
    children: [
      { component: 'Text', contentText: ' ', class: 'scrolly-anchor' },
    ],
  };
  return {
    component: 'Section',
    container: '7xl',
    class: `scrolly-card-section card-${side}`,
    children: side === 'left' ? [card, dots] : [dots, card],
  };
}

const data = {
  component: 'Page',
  children: [
    // Hero — viewport trigger fires on load (hero at top of page). The
    // Burst wrapper has its own stage row below the heading/text so the
    // letter centre lands in clear space, not on top of the copy.
    {
      component: 'Section',
      container: '7xl',
      gap: 'lg',
      class: 'scrolly-hero',
      children: [
        { component: 'Heading', level: 1, contentHeading: 'Scrollytelling dot loop', size: 'xl' },
        {
          component: 'Text',
          contentText: 'The first word forms here. Scroll down — each card section forms its word next to the card on the opposite side, reusing the same dots.',
        },
        {
          ...sharedBurstProps,
          component: 'Burst',
          tracePath: 'phrase:welcome',
          trigger: 'viewport',
          traceSize: 800,
          class: 'scrolly-hero-stage',
          children: [
            { component: 'Text', contentText: ' ', class: 'scrolly-anchor' },
          ],
        },
      ],
    },
    // Five card sections alternating left/right
    cardSection('left',  PHRASES[0], 'Card one',   'Body copy on the left, dots forming the word on the right.'),
    cardSection('right', PHRASES[1], 'Card two',   'Card flipped to the right, dots on the left.'),
    cardSection('left',  PHRASES[2], 'Card three', 'And back — card left, dots right.'),
    cardSection('right', PHRASES[3], 'Card four',  'Card right, dots left.'),
    cardSection('left',  PHRASES[4], 'Card five',  'Final beat — card left, dots right.'),
  ],
};
---

<BaseLayout title="Burst scrollytelling — Dots demo">
  <Renderer node={data} />
</BaseLayout>

<style is:global>
  /* Section atom adds margin-top via > * + *. Kill it for our demo
     so grid placement isn't fought by margin offsets. */
  .section-atom.scrolly-hero,
  .section-atom.scrolly-card-section {
    min-height: 100vh;
    padding-top: var(--space-xl, 4rem);
    padding-bottom: var(--space-xl, 4rem);
  }
  .section-atom.scrolly-hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }
  .section-atom.scrolly-hero > * + * {
    margin-top: var(--space-lg, 2rem);
  }

  /* Two-column grid. Card on one side, dots area on the other.
     Higher-specificity selector to beat .section-atom base layout. */
  .section-atom.scrolly-card-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-xl, 4rem);
  }
  /* Cancel Section's > * + * margin-top so grid columns sit side-by-side */
  .section-atom.scrolly-card-section > * + * {
    margin-top: 0;
  }

  /* Hero stage: a dedicated empty row below the heading/text. The Burst
     wrapper's getBoundingClientRect centre is THIS rect's centre —
     letters form here, not over the heading. */
  .scrolly-hero-stage {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    min-height: 300px;
  }

  .scrolly-card {
    padding: var(--space-lg, 2rem);
    text-align: center;
  }
  /* The dots area: just a centred anchor that gives the burst a
     measurable rect. */
  .scrolly-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 200px;
  }
  .scrolly-anchor {
    display: inline-block;
    width: 1px;
    height: 1px;
  }
</style>
