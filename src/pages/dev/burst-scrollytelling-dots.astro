---
/**
 * Burst scrollytelling — DOTS variant.
 *
 * Layout:
 *   1. Hero section — dots form a word at viewport centre on click.
 *   2. Five card sections — each has a card on one side and the dots
 *      forming a word on the opposite side. Layout alternates
 *      (card-left/dots-right, card-right/dots-left, ...).
 *
 * Each card section uses trigger='viewport' so the dots fire when
 * the section enters viewport. Live-origin tracking in the engine
 * keeps the letters next to the card as the section scrolls. When
 * the section exits, scroll-release sends the dots into a swarm at
 * the edges; the next card section picks them up.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Renderer from '../../components/Renderer.astro';
import { TEXT_PATHS_META } from '../../lib/text-paths/generated';

const sharedBurstProps = {
  engine: 'physics',
  palette: 'rainbow',
  spread: 100,
  gravity: 0,
  lifespan: 8000,
  collide: false,
  from: 'edges',
  to: 'origin',
  particle: { component: 'Shape', shape: 'circle', size: 'xs' },
};

// Layout knobs — change these to retune the whole demo.
//   TARGET_LETTER_HEIGHT: visual height we'd LIKE letters to render at.
//     Used to compute the rendered word width per phrase.
//   HALF_COLUMN_WIDTH:    approx width of one column in a side-by-side
//     section (7xl container ~= 1280px, minus gap, halved).
//   FULL_WIDTH:           target traceSize for the centred fallback.
//   DOTS_PER_LETTER:      how many particles each letter outline gets.
//     Total count = letters × this. Long phrases need a higher total so
//     each letter still reads cleanly.
const TARGET_LETTER_HEIGHT = 120;
const HALF_COLUMN_WIDTH = 560;
const FULL_WIDTH = 1100;
// DOTS_PER_LETTER now informs the COUNT CAP — engine's density-per-px
// allocator decides actual sample count; this just sets the upper bound
// per letter so long phrases don't exceed the active-particle cap.
const DOTS_PER_LETTER = 100;
const MAX_COUNT = 1500; // bumped from engine cap 1200 — long phrases need more
                        // dots for fine-grained bead chain

/** Decide layout, traceSize, and count for a phrase. Long phrases that
 *  won't fit half a column fall back to centred full-width below the
 *  card. Particle count scales with letter count so density per letter
 *  stays constant. traceSize is the rendered WIDTH — long phrases get
 *  proportionally larger traceSize so letter height stays at the target
 *  (computeTraceFrame scales by max(width, height), so we feed it the
 *  width we want and rely on the natural aspect ratio for height). */
function layoutFor(phrase: string) {
  const meta = TEXT_PATHS_META[phrase];
  if (!meta) return { layout: 'side' as const, traceSize: 600, count: 600 };
  const letterCount = meta.paths.length;
  const count = Math.min(MAX_COUNT, letterCount * DOTS_PER_LETTER);
  const aspect = meta.width / meta.height;
  const renderedW = TARGET_LETTER_HEIGHT * aspect;
  if (renderedW > HALF_COLUMN_WIDTH) {
    // Centre layout: traceSize = the width we want to render at, scaled
    // up if needed so letters keep their target height even for long
    // phrases. Cap at viewport width minus margin so the word never
    // overflows the screen.
    const VIEWPORT_MAX = 1400;
    const traceSize = Math.min(VIEWPORT_MAX, Math.max(FULL_WIDTH, renderedW));
    return { layout: 'centre' as const, traceSize, count };
  }
  return { layout: 'side' as const, traceSize: renderedW, count };
}

const PHRASES = ['hello', 'welcome', 'brand', 'hello', 'welcome'];

// Build a card section. side='left' = card-left/dots-right;
// 'right' = card-right/dots-left. layout='centre' overrides side and
// stacks card-above-dots full-width.
function cardSection(side: 'left' | 'right', phrase: string, cardTitle: string, cardBody: string) {
  const { layout, traceSize, count } = layoutFor(phrase);
  const card = {
    component: 'Card',
    variant: 'default',
    padding: 'lg',
    radius: 'lg',
    shadow: 'md',
    class: 'scrolly-card',
    children: [
      { component: 'Heading', level: 3, contentHeading: cardTitle, size: 'md' },
      { component: 'Text', contentText: cardBody },
    ],
  };
  const dots = {
    ...sharedBurstProps,
    component: 'Burst',
    tracePath: `phrase:${phrase}`,
    trigger: 'viewport',
    traceSize,
    count,
    class: 'scrolly-dots',
    children: [
      { component: 'Text', contentText: ' ', class: 'scrolly-anchor' },
    ],
  };
  const klass = layout === 'centre'
    ? 'scrolly-card-section layout-centre'
    : `scrolly-card-section layout-side card-${side}`;
  return {
    component: 'Section',
    container: '7xl',
    class: klass,
    children: layout === 'centre'
      ? [card, dots]                                     // stacked
      : (side === 'left' ? [card, dots] : [dots, card]), // side-by-side
  };
}

const data = {
  component: 'Page',
  children: [
    // Hero — viewport trigger fires on load (hero at top of page). The
    // Burst wrapper has its own stage row below the heading/text so the
    // letter centre lands in clear space, not on top of the copy.
    {
      component: 'Section',
      container: '7xl',
      gap: 'lg',
      class: 'scrolly-hero',
      children: [
        { component: 'Heading', level: 1, contentHeading: 'Scrollytelling dot loop', size: 'xl' },
        {
          component: 'Text',
          contentText: 'The first word forms here. Scroll down — each card section forms its word next to the card on the opposite side, reusing the same dots.',
        },
        {
          ...sharedBurstProps,
          component: 'Burst',
          tracePath: 'phrase:welcome',
          trigger: 'viewport',
          // Hero always gets the full-width treatment — it's the centred
          // headline shot, no card to share space with.
          traceSize: FULL_WIDTH,
          count: layoutFor('welcome').count,
          class: 'scrolly-hero-stage',
          children: [
            { component: 'Text', contentText: ' ', class: 'scrolly-anchor' },
          ],
        },
      ],
    },
    // Five card sections alternating left/right
    cardSection('left',  PHRASES[0], 'Card one',   'Body copy on the left, dots forming the word on the right.'),
    cardSection('right', PHRASES[1], 'Card two',   'Card flipped to the right, dots on the left.'),
    cardSection('left',  PHRASES[2], 'Card three', 'And back — card left, dots right.'),
    cardSection('right', PHRASES[3], 'Card four',  'Card right, dots left.'),
    cardSection('left',  PHRASES[4], 'Card five',  'Final beat — card left, dots right.'),
  ],
};
---

<BaseLayout title="Burst scrollytelling — Dots demo">
  <Renderer node={data} />
</BaseLayout>

<style is:global>
  /* Section atom adds margin-top via > * + *. Kill it for our demo
     so grid placement isn't fought by margin offsets. */
  .section-atom.scrolly-hero,
  .section-atom.scrolly-card-section {
    min-height: 100vh;
    padding-top: var(--space-xl, 4rem);
    padding-bottom: var(--space-xl, 4rem);
  }
  .section-atom.scrolly-hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }
  .section-atom.scrolly-hero > * + * {
    margin-top: var(--space-lg, 2rem);
  }

  /* Side-by-side: two-column grid, card on one side dots on the other.
     Higher-specificity selector to beat .section-atom base layout. */
  .section-atom.scrolly-card-section.layout-side {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-xl, 4rem);
  }
  /* Cancel Section's > * + * margin-top so grid columns sit side-by-side */
  .section-atom.scrolly-card-section.layout-side > * + * {
    margin-top: 0;
  }

  /* Centred: card stacked on top, dots span full container width below.
     Used when the phrase is too wide to fit half a column readably. */
  .section-atom.scrolly-card-section.layout-centre {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    gap: var(--space-xl, 4rem);
  }
  .section-atom.scrolly-card-section.layout-centre > * + * {
    margin-top: 0;
  }
  .section-atom.scrolly-card-section.layout-centre .scrolly-card {
    max-width: 60ch;
    align-self: center;
  }
  .section-atom.scrolly-card-section.layout-centre .scrolly-dots {
    min-height: 280px;
  }

  /* Hero stage: a dedicated empty row below the heading/text. The Burst
     wrapper's getBoundingClientRect centre is THIS rect's centre —
     letters form here, not over the heading. */
  .scrolly-hero-stage {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    min-height: 300px;
  }

  .scrolly-card {
    padding: var(--space-lg, 2rem);
    text-align: center;
  }
  /* The dots area: just a centred anchor that gives the burst a
     measurable rect. */
  .scrolly-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 200px;
  }
  .scrolly-anchor {
    display: inline-block;
    width: 1px;
    height: 1px;
  }
</style>
