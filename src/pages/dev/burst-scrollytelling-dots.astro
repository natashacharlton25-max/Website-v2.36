---
/**
 * Burst scrollytelling — DOTS variant, PIN model.
 *
 * Each scrollytelling Burst pins at the top of viewport for an 800px
 * scroll range. After a 2s dwell (so fast-scrolling past doesn't
 * trigger), the animation fires and dots converge to form the word
 * at the pinned position. When the user scrolls past the pin range,
 * dots release and fly out to viewport edges. Next pinned Burst
 * picks them up and re-forms the next word at ITS pinned position.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Renderer from '../../components/Renderer.astro';

const sharedBurstProps = {
  engine: 'physics',
  palette: 'rainbow',
  count: 1000,
  spread: 100,
  gravity: 0,
  lifespan: 8000,
  collide: false,
  from: 'edges',
  to: 'origin',
  traceSize: 1500,
  particle: { component: 'Shape', shape: 'circle', size: 'xs' },
};

const data = {
  component: 'Page',
  children: [
    // Intro section — explainer + click to start
    {
      component: 'Section',
      container: '7xl',
      gap: 'lg',
      class: 'scrolly-intro',
      children: [
        { component: 'Heading', level: 1, contentHeading: 'Scrollytelling dot loop', size: 'xl' },
        {
          component: 'Text',
          contentText: 'Click Begin to form WELCOME. Then scroll down — each pinned section dwells 2s, fires the burst, holds for the scroll range, releases dots into a swarm at the edges. The same 1000 physical dots travel through the whole narrative.',
        },
        {
          ...sharedBurstProps,
          component: 'Burst',
          tracePath: 'phrase:welcome',
          trigger: 'click',
          children: [
            { component: 'Button', contentButton: 'Begin', variant: 'fill', brandColor: 'primary', size: 'lg' },
          ],
        },
      ],
    },
    // Pinned scrollytelling sections — each pins, dwells, fires
    {
      component: 'Section',
      container: '7xl',
      class: 'scrolly-pin',
      children: [
        {
          ...sharedBurstProps,
          component: 'Burst',
          tracePath: 'phrase:hello',
          trigger: 'pin',
          children: [{ component: 'Text', contentText: ' ', class: 'scrolly-anchor' }],
        },
      ],
    },
    {
      component: 'Section',
      container: '7xl',
      class: 'scrolly-pin',
      children: [
        {
          ...sharedBurstProps,
          component: 'Burst',
          tracePath: 'phrase:welcome',
          trigger: 'pin',
          children: [{ component: 'Text', contentText: ' ', class: 'scrolly-anchor' }],
        },
      ],
    },
    {
      component: 'Section',
      container: '7xl',
      class: 'scrolly-pin',
      children: [
        {
          ...sharedBurstProps,
          component: 'Burst',
          tracePath: 'phrase:hello',
          trigger: 'pin',
          children: [{ component: 'Text', contentText: ' ', class: 'scrolly-anchor' }],
        },
      ],
    },
    // Outro — give the page some scroll room after the last pin
    {
      component: 'Section',
      container: '7xl',
      class: 'scrolly-outro',
      children: [
        { component: 'Text', contentText: 'End of narrative.' },
      ],
    },
  ],
};
---

<BaseLayout title="Burst scrollytelling — Dots demo">
  <Renderer node={data} />
</BaseLayout>

<style is:global>
  .scrolly-intro {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: var(--space-lg, 2rem);
    padding: var(--space-xl, 4rem) var(--space-lg, 2rem);
  }
  /* Each pinned section is just a centred Burst wrapper that
     ScrollTrigger pins for 800px of scroll. The wrapper's centre is
     the pinned-position-on-screen where letters form. */
  .scrolly-pin {
    min-height: 50vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .scrolly-pin .burst {
    display: block;
    width: 1px;
    height: 1px;
  }
  .scrolly-anchor {
    display: block;
    width: 1px;
    height: 1px;
  }
  .scrolly-outro {
    min-height: 50vh;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--neutral-700, #555);
    text-align: center;
  }
</style>
