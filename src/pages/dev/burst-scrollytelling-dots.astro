---
/**
 * Burst scrollytelling — DOTS variant.
 *
 * Layout: each section is 100vh tall. Top 30vh = heading + caption.
 * Middle 50vh = empty zone for the Burst (anchor div centred there
 * with no visible content of its own — letters form around it).
 * Bottom 20vh = breathing room before next section.
 *
 * The anchor div has display:block + min-height so getBoundingClientRect
 * gives sensible centre for the convergence target. Each section's
 * anchor sits in a known empty space → letters don't overlap text.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Renderer from '../../components/Renderer.astro';

const sharedBurstProps = {
  engine: 'physics',
  palette: 'rainbow',
  count: 1000,
  spread: 100,
  gravity: 0,
  lifespan: 8000,
  collide: false,
  from: 'edges',
  to: 'origin',
  traceSize: 1500,
  // Letters form ~350px ABOVE the burst anchor. Each section's anchor
  // sits at the bottom of the section (button or invisible spacer);
  // letters land in the empty space above, clear of any text.
  traceOffsetY: -350,
  particle: { component: 'Shape', shape: 'circle', size: 'xs' },
};

// Reusable anchor — invisible centred block that gives the Burst a
// stable rect for the convergence target. min-height + visibility:
// hidden makes it take up space without rendering content.
const anchor = {
  component: 'Section',
  class: 'scrolly-anchor',
  children: [{ component: 'Text', contentText: '·', class: 'scrolly-anchor-dot' }],
};

const data = {
  component: 'Page',
  children: [
    // Section 1 — click to start
    {
      component: 'Section',
      container: '7xl',
      gap: 'lg',
      class: 'scrolly-section',
      children: [
        { component: 'Heading', level: 1, contentHeading: 'Scrollytelling dot loop', size: 'xl' },
        {
          component: 'Text',
          contentText: 'Click Begin. 1000 dots converge to form WELCOME below. Scroll → dots scatter to edges. Each new section → dots re-form the next word in the empty zone.',
        },
        {
          ...sharedBurstProps,
          component: 'Burst',
          tracePath: 'phrase:welcome',
          trigger: 'click',
          children: [
            { component: 'Button', contentButton: 'Begin', variant: 'fill', brandColor: 'primary', size: 'lg' },
          ],
        },
      ],
    },
    // Section 2 — auto-fire on viewport → "Hello"
    {
      component: 'Section',
      container: '7xl',
      gap: 'md',
      class: 'scrolly-section',
      children: [
        { component: 'Heading', level: 2, contentHeading: 'Scroll triggered →', size: 'lg' },
        { component: 'Text', contentText: 'The same 1000 dots fly in and re-form around "Hello".' },
        {
          ...sharedBurstProps,
          component: 'Burst',
          tracePath: 'phrase:hello',
          trigger: 'viewport',
          children: [anchor],
        },
      ],
    },
    // Section 3 — back to "WELCOME"
    {
      component: 'Section',
      container: '7xl',
      gap: 'md',
      class: 'scrolly-section',
      children: [
        { component: 'Heading', level: 2, contentHeading: 'Loop continues →', size: 'lg' },
        { component: 'Text', contentText: 'Same physical dots, re-aimed at each new letter outline.' },
        {
          ...sharedBurstProps,
          component: 'Burst',
          tracePath: 'phrase:welcome',
          trigger: 'viewport',
          children: [anchor],
        },
      ],
    },
    // Section 4 — form "Hello" again
    {
      component: 'Section',
      container: '7xl',
      gap: 'md',
      class: 'scrolly-section',
      children: [
        { component: 'Heading', level: 2, contentHeading: 'And again →', size: 'lg' },
        { component: 'Text', contentText: 'Scroll back up — onEnterBack re-fires earlier sections too.' },
        {
          ...sharedBurstProps,
          component: 'Burst',
          tracePath: 'phrase:hello',
          trigger: 'viewport',
          children: [anchor],
        },
      ],
    },
  ],
};
---

<BaseLayout title="Burst scrollytelling — Dots demo">
  <Renderer node={data} />
</BaseLayout>

<style is:global>
  /* Section layout: heading + caption at top, big empty zone in the
     middle (where the letters form), anchor/button at the bottom.
     traceOffsetY: -350 pushes the dots up from the anchor into the
     empty middle zone. */
  .scrolly-section {
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    padding: var(--space-xl, 4rem) var(--space-lg, 2rem);
    gap: var(--space-md, 1.5rem);
    text-align: center;
    justify-items: center;
    align-items: start;
  }
  .scrolly-section .burst {
    grid-row: 4;
    align-self: end;
    justify-self: center;
    margin-bottom: var(--space-xl, 4rem);
  }
  /* Invisible anchor — gives getBoundingClientRect a stable measurement
     in the section's grid row 4 without rendering visible content. */
  .scrolly-anchor {
    min-width: 100px;
    min-height: 100px;
    display: block;
    visibility: hidden;
  }
</style>
