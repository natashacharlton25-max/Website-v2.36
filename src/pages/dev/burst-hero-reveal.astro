---
/**
 * Burst Hero Reveal — production demo
 *
 * Pattern: silly-string IS the heading. Click → rainbow strands fly in
 * from viewport edges and write the brand phrase by snapping to letter
 * shapes via tracePath: 'phrase:brand'. No HTML heading, no fade
 * handoff — strings are the visual.
 *
 * Use this when you want a one-shot dramatic reveal where the silly-
 * string itself is the typography. The phrase comes from pre-baked SVG
 * paths in src/lib/text-paths/generated.ts (registered in registry.json
 * + npm run build:text-paths).
 *
 * Accessibility:
 *   - This is purely decorative typography. If the phrase is meaningful
 *     content, add an sr-only <h1> with the same text so screen readers
 *     see it. If it's just a brand flourish, no AT presence is fine.
 *   - getAnimationConfig() gates motion — prefers-reduced-motion users
 *     skip the silly-string entirely; for them you'd want a static
 *     fallback (sr-only heading + a regular <h1> that's always visible).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Renderer from '../../components/Renderer.astro';

const data = {
  component: 'Page',
  children: [
    {
      component: 'Section',
      container: '7xl',
      gap: 'lg',
      class: 'hero-reveal-page',
      children: [
        {
          component: 'Text',
          contentText: 'Click the button. 17 rainbow strings fly in from the viewport edges and write the phrase by snapping to letter shapes — strings are the typography.',
        },
        {
          component: 'Burst',
          engine: 'string',
          palette: 'rainbow',
          // 17 non-space chars in "Walking with a Smile" → 17 strands,
          // one per letter, each in its own palette colour (rainbow
          // cycles every 7).
          strands: 17,
          from: 'edges',
          to: 'origin',
          tracePath: 'phrase:brand',
          // Width of the rendered silly-string typography in px.
          // The phrase is auto-centred on the burst origin (the button).
          traceSize: 900,
          // Y offset shifts the typography above the button so they
          // don't overlap. Negative = above.
          traceOffsetY: -200,
          length: 220,
          pressure: 22,
          emitDuration: 600,
          thick: 5,
          // Long-ish lifespan so the trace stays visible.
          lifespan: 8000,
          trigger: 'click',
          children: [
            {
              component: 'Button',
              contentButton: 'Write it',
              variant: 'fill',
              brandColor: 'primary',
              size: 'lg',
            },
          ],
        },
      ],
    },
  ],
};
---

<BaseLayout title="Burst Hero Reveal — Demo">
  <Renderer node={data} />
</BaseLayout>

<style is:global>
  /* Layout only — no heading reveal CSS needed. The silly-string IS
   * the typography; runtime handles its own appearance and fade-out. */
  .hero-reveal-page {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: var(--space-lg, 2rem);
  }
</style>
