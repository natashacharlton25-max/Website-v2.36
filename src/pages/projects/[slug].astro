---
/**
 * Collection Layout (Editorial)
 * Magazine-style page for curated project collections
 * Uses reusable section components like index.astro and about.astro
 */
import BaseLayout from '../../Layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FooterWithMask from '../../components/Footer/FooterWithMask.astro';
import Button from '../../components/Button/Button.astro';
import Icon from '../../components/Icons/Icon.astro';
import Badge from '../../components/Badge/Badge.astro';
import ProductCard from '../../components/Cards/ProductCard.astro';
import ImageTextSection from '../../components/Sections/ImageTextSection.astro';
import IntroTextSection from '../../components/Sections/IntroTextSection.astro';
import ValuesSection from '../../components/Sections/ValuesSection.astro';
import { getIconForAssetType } from '../../lib/utils/iconMapper';
import '../../styles/components/editorial-layout.css';

// Helper to get folder slug from entry.id
const getSlugFromId = (id: string) => {
  const normalized = id.replace(/[\\/]index\.md$/, '');
  return normalized.split(/[\\/]/).pop() || id;
};

// Get all assets from content collection
const assetsEntries = await getCollection('assets');
const assetsMap = new Map(
  assetsEntries.map(entry => [getSlugFromId(entry.id), entry.data])
);

const getAssetBySlug = (slug: string) => assetsMap.get(slug);
const getAssetImagePath = (asset: any) => asset?.cardImage?.src || `/images/Assets/${asset?.slug}/card.png`;

export async function getStaticPaths() {
  const getSlug = (id: string) => {
    const normalized = id.replace(/[\\/]index\.md$/, '');
    return normalized.split(/[\\/]/).pop() || id;
  };

  const projectEntries = await getCollection('projects');
  return projectEntries.map(entry => {
    const slug = getSlug(entry.id);
    return {
      params: { slug },
      props: {
        slug,
        entry
      }
    };
  });
}

const { slug, entry } = Astro.props;
const project = { slug, ...entry.data };
const whoForImage = entry.data.whoForImage;

if (!project) {
  return Astro.redirect('/projects');
}

// Get full resource data with cardImage for ProductCard
const resources = project.resourceSlugs.map((slug: string) => {
  const asset = getAssetBySlug(slug);
  return {
    slug,
    name: asset?.name || slug.split('-').map((word: string) => word.charAt(0).toUpperCase() + word.slice(1)).join(' '),
    description: asset?.description || 'Free resource to download and use',
    type: asset?.type || 'resource',
    category: asset?.category || 'Resource',
    cardImage: asset?.cardImage,
    format: 'PDF'
  };
});

const featuredResource = resources[0];

const typeLabels: Record<string, string> = {
  'worksheet': 'Worksheet',
  'workbook': 'Workbook',
  'guide': 'Guide',
  'toolkit': 'Toolkit',
  'cards': 'Cards',
  'poster': 'Poster',
  'activity': 'Activity',
  'resource': 'Resource'
};

// Get the project's markdown content if available
const projectEntries = await getCollection('projects');
const projectEntry = projectEntries.find(e => getSlugFromId(e.id) === project.slug);
const { Content } = projectEntry ? await projectEntry.render() : { Content: null };
---

<BaseLayout
  title={`${project.title} | Projects | Walking with a Smile`}
  description={project.description}
  hideFooter={true}
>
  <!-- Hero Section -->
  <section class="hero-section hero-section--simple">
    <div class="container">
      <div class="hero-section__content">
        <!-- Tags above title -->
        <div class="editorial-hero__tags">
          {project.tags.slice(0, 3).map((tag: string) => (
            <Badge
              type="default"
              label={tag}
              variant="soft"
              shape="pill"
              uppercase={false}
            />
          ))}
        </div>
        <h1 class="hero-section__title">{project.title}</h1>
        <p class="hero-section__subtitle">{project.description}</p>
        <!-- Resource count below -->
        <div class="editorial-hero__meta">
          <Badge
            type="default"
            label={`${resources.length} Resources`}
            icon="folder-fill"
            variant="outline"
            shape="pill"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Resource Section -->
  {featuredResource?.image && (
    <section class="editorial-featured section">
      <div class="container">
        <div class="editorial-featured__layout">
          <div class="editorial-featured__image">
            <img src={featuredResource.image} alt={featuredResource.name} loading="eager" />
            <div class="editorial-featured__badge">
              <Badge
                type={featuredResource.type}
                label={typeLabels[featuredResource.type]}
                variant="fill"
                shape="pill"
                shadow="drop"
              />
            </div>
          </div>
          <div class="editorial-featured__content">
            <h2>{featuredResource.name}</h2>
            <p class="editorial-featured__description">{featuredResource.description}</p>
            <div class="editorial-featured__actions">
              <Button
                variant="primary"
                className="js-add-to-cart"
                data-product-id={featuredResource.slug}
                data-product-name={featuredResource.name}
                data-product-price="0"
                data-product-image={featuredResource.image}
              >
                <Icon name="interface/plus-circle-fill" size={18} slot="icon" />
                Add to Basket
              </Button>
              <Button href={`/assets/${featuredResource.slug}`} variant="outline">
                View Details
                <Icon name="interface/arrow-right-fill" size={18} />
              </Button>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- About Section -->
  {(() => {
    const paragraphs = project.longDescription.split(/\n\n+/).filter(Boolean);
    const lead = paragraphs[0] || '';
    const subtitles = paragraphs.slice(1);
    return (
      <IntroTextSection
        lead={lead}
        subtitles={subtitles}
      />
    );
  })()}

  <!-- Who It's For Section -->
  {project.whoItsFor && whoForImage && (
    <ImageTextSection
      title="Who it's for"
      content={[project.whoItsFor]}
      image={whoForImage}
      imageAlt={`Who ${project.title} is designed for`}
      imagePosition="left"
    />
  )}
  {project.whoItsFor && !whoForImage && (
    <section class="editorial-about section-sm">
      <div class="container">
        <div class="editorial-about__audience">
          <Icon name="interface/users-fill" size={24} />
          <div>
            <strong>Who it's for</strong>
            <p>{project.whoItsFor}</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Markdown Content -->
  {Content && (
    <section class="editorial-prose section-sm">
      <div class="container">
        <Content />
      </div>
    </section>
  )}

  <!-- Resources List -->
  <section class="editorial-resources section">
    <div class="container">
      <h2 class="editorial__section-title">What's Included</h2>
      <p class="editorial-resources__subtitle">{resources.length} downloadable resources in this collection</p>

      <div class="editorial-resources__grid">
        {resources.map((resource: any) => (
          resource.cardImage && (
            <ProductCard
              slug={resource.slug}
              name={resource.name}
              category={resource.category}
              description={resource.description}
              cardImage={resource.cardImage}
              type={resource.type}
            />
          )
        ))}
      </div>
    </div>
  </section>

  <!-- Evidence-Based Benefits -->
  {project.professional?.evidenceBasedBenefits?.length > 0 && (
    <ValuesSection
      title="Evidence-Based Benefits"
      values={project.professional.evidenceBasedBenefits.map((benefit: string, index: number) => {
        // Parse benefit into title and description
        // Try to split at "by" or "through" to get a short title
        const splitMatch = benefit.match(/^(.+?)\s+(by|through|via)\s+(.+)$/i);
        if (splitMatch) {
          return {
            number: String(index + 1).padStart(2, '0'),
            title: splitMatch[1],
            description: splitMatch[3].charAt(0).toUpperCase() + splitMatch[3].slice(1)
          };
        }
        // Fallback: use first few words as title
        const words = benefit.split(' ');
        const title = words.slice(0, 3).join(' ');
        const description = words.slice(3).join(' ') || benefit;
        return {
          number: String(index + 1).padStart(2, '0'),
          title: title,
          description: description.charAt(0).toUpperCase() + description.slice(1)
        };
      })}
    />
  )}

  <!-- Key Features -->
  {(project.highlights?.length ?? 0) > 0 && (
    <section class="editorial-highlights section-sm">
      <div class="container">
        <h2 class="editorial__section-title">Key Features</h2>
        <div class="editorial-highlights__grid">
          {project.highlights?.map((highlight: any) => (
            <div class="editorial-highlight">
              {highlight.icon && <Icon name={highlight.icon} size={28} />}
              <span>{highlight.text}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Skills -->
  {(project.professional?.linkedSkills?.length ?? 0) > 0 && (
    <section class="editorial-skills section-sm">
      <div class="container">
        <h2 class="editorial__section-title">Related Skills</h2>
        <div class="editorial-skills__list">
          {project.professional?.linkedSkills?.map((skill: string) => (
            <span class="editorial-skill">{skill}</span>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Specifications -->
  {(project.specifications?.length ?? 0) > 0 && (
    <section class="editorial-specs section-sm">
      <div class="container">
        <h2 class="editorial__section-title">Specifications</h2>
        <div class="editorial-specs__grid">
          {project.specifications?.map((spec: any) => (
            <div class="editorial-spec">
              {spec.icon && <Icon name={spec.icon} size={24} />}
              <div>
                <span class="editorial-spec__value">{spec.value}</span>
                <span class="editorial-spec__label">{spec.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Get Complete Collection CTA -->
  <section class="editorial-cta section">
    <div class="container">
      <div class="editorial-cta__content">
        <h2>Get the Complete Collection</h2>
        <p>{resources.length} resources included — add them all to your basket in one click.</p>
        <div class="editorial-cta__buttons">
          <Button
            variant="primary"
            size="lg"
            id="add-all-btn"
            data-resources={JSON.stringify(resources.map(r => ({
              id: r.slug,
              name: r.name,
              price: 0,
              image: r.image
            })))}
          >
            <Icon name="a11y/basket-fill" size={22} slot="icon" />
            Add All {resources.length} Items
          </Button>
          <Button href="/projects" variant="outline" size="lg">
            Browse More Collections
          </Button>
        </div>
      </div>
    </div>
  </section>

  <FooterWithMask />
</BaseLayout>

<script>
  // Smooth accordion animation for details elements
  document.querySelectorAll('.editorial-resource').forEach((details) => {
    const summary = details.querySelector('summary');
    const content = details.querySelector('.editorial-resource__content') as HTMLElement;

    if (!summary || !content) return;

    summary.addEventListener('click', (e) => {
      e.preventDefault();

      const isOpen = details.hasAttribute('open');

      if (isOpen) {
        // Closing: animate then remove open
        content.style.gridTemplateRows = '0fr';
        content.addEventListener('transitionend', function handler() {
          details.removeAttribute('open');
          content.removeEventListener('transitionend', handler);
        }, { once: true });
      } else {
        // Opening: add open then animate
        details.setAttribute('open', '');
        // Force reflow to ensure transition works
        content.offsetHeight;
        content.style.gridTemplateRows = '1fr';
      }
    });
  });

  // Initialize add-to-cart handlers for individual items
  document.querySelectorAll('.js-add-to-cart').forEach(button => {
    button.addEventListener('click', (e) => {
      e.preventDefault();
      const btn = e.currentTarget as HTMLElement;
      const productData = {
        id: btn.dataset.productId,
        name: btn.dataset.productName,
        price: parseFloat(btn.dataset.productPrice || '0'),
        image: btn.dataset.productImage
      };

      if ((window as any).addToCart) {
        (window as any).addToCart(productData);
      } else {
        console.warn('Cart system not initialized');
      }
    });
  });

  // Handle "Add All" button
  const addAllBtn = document.getElementById('add-all-btn');
  if (addAllBtn) {
    addAllBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const resourcesData = addAllBtn.dataset.resources;
      if (!resourcesData) return;

      const resources = JSON.parse(resourcesData);
      let addedCount = 0;

      resources.forEach((resource: any) => {
        if ((window as any).addToCart) {
          // Check if already in cart before adding
          const cartItems = (window as any).cartItems || [];
          const alreadyInCart = cartItems.some((item: any) => item.id === resource.id);
          if (!alreadyInCart) {
            (window as any).addToCart(resource);
            addedCount++;
          }
        }
      });

      // Show summary toast
      if (typeof (window as any).showToast === 'function') {
        if (addedCount > 0) {
          (window as any).showToast({
            message: `Added ${addedCount} item${addedCount > 1 ? 's' : ''} to your cart!`,
            theme: 'professional',
            animation: 'flip',
            lottieUrl: '/Icons/Animated Icons/Basket Icons/lottie-basket-morph-fill.json'
          });
        } else {
          (window as any).showToast({
            message: 'All items are already in your cart!',
            theme: 'professional',
            animation: 'flip',
            lottieUrl: '/Icons/Animated Icons/Basket Icons/lottie-basket-loop-cycle.json'
          });
        }
      }
    });
  }
</script>
