---
/**
 * Collection Layout (Editorial)
 * Magazine-style page for curated project collections
 * Uses reusable section components like index.astro and about.astro
 */
export const prerender = true;

import BaseLayout from '../../Layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FooterWithMask from '../../components/Footer/FooterWithMask.astro';
import Button from '../../components/Button/Button.astro';
import Icon from '../../components/Icons/Icon.astro';
import Badge from '../../components/Badge/Badge.astro';
import ImageTextSection from '../../components/Sections/ImageTextSection.astro';
import IntroTextSection from '../../components/Sections/IntroTextSection.astro';
import ProductCard from '../../components/Cards/ProductCard.astro';
import Breadcrumbs from '../../components/Navigation/Breadcrumbs.astro';
import ProjectSpecGrid from '../../components/Product/ProjectSpecGrid.astro';
import ShareSection from '../../components/Sections/ShareSection.astro';
// Grid layout not needed - ProjectSpecGrid uses simple 4-column layout
import '../../styles/components/editorial-layout.css';

// Helper to get folder slug from entry.id
const getSlugFromId = (id: string) => {
  const normalized = id.replace(/[\\/]index\.md$/, '');
  return normalized.split(/[\\/]/).pop() || id;
};

// Get all assets from content collection
const assetsEntries = await getCollection('assets');
const assetsMap = new Map(
  assetsEntries.map(entry => [getSlugFromId(entry.id), entry.data])
);

const getAssetBySlug = (slug: string) => assetsMap.get(slug);

export async function getStaticPaths() {
  const getSlug = (id: string) => {
    const normalized = id.replace(/[\\/]index\.md$/, '');
    return normalized.split(/[\\/]/).pop() || id;
  };

  const projectEntries = await getCollection('projects');
  return projectEntries.map(entry => {
    const slug = getSlug(entry.id);
    return {
      params: { slug },
      props: {
        slug,
        entry
      }
    };
  });
}

const { slug, entry } = Astro.props;

// Handle missing entry gracefully
if (!entry || !entry.data) {
  return Astro.redirect('/projects');
}

const project = { slug, ...entry.data };
const whoForImage = entry.data.whoForImage;

// Get full resource data with cardImage for ProductCard
const resources = project.resourceSlugs.map((resourceSlug: string) => {
  const asset = getAssetBySlug(resourceSlug);
  return {
    slug: resourceSlug,
    name: asset?.name || resourceSlug.split('-').map((word: string) => word.charAt(0).toUpperCase() + word.slice(1)).join(' '),
    description: asset?.description || 'Free resource to download and use',
    type: asset?.type || 'resource',
    category: asset?.category || 'Resource',
    cardImage: asset?.cardImage,
    format: 'PDF'
  };
});

// Build specs for SpecGrid - combine project data + asset collection data
const variantCycle = ['primary', 'secondary', 'accent'] as const;
type SpecVariant = typeof variantCycle[number];
interface ProjectSpecItem {
  iconName: string;
  label: string;
  value: string;
  variant: SpecVariant;
}

// Helper to convert icon format (ph:sparkle-duotone -> sparkle-fill)
const normalizeIcon = (icon: string | undefined, fallback: string): string => {
  if (!icon) return fallback;
  return icon.replace(/^ph:/, '').replace(/-duotone$/, '-fill');
};

// === PROJECT-LEVEL SPECS ===

// Convert highlights to specs
const highlightSpecs = (project.highlights || []).map((highlight: any, index: number) => ({
  iconName: normalizeIcon(highlight.icon, 'star-fill'),
  label: 'Feature',
  value: highlight.text,
  variant: variantCycle[index % 3]
}));

// Convert linked skills to specs
const skillSpecs = (project.professional?.linkedSkills || []).map((skill: string, index: number) => ({
  iconName: 'brain-fill',
  label: 'Skill',
  value: skill,
  variant: variantCycle[index % 3]
}));

// Convert project-level evidence-based benefits to specs
const projectBenefitSpecs = (project.professional?.evidenceBasedBenefits || []).map((benefit: string, index: number) => ({
  iconName: 'seal-check-fill',
  label: 'Benefit',
  value: benefit,
  variant: variantCycle[index % 3]
}));

// Convert specifications to specs (if any custom ones defined)
const specSpecs = (project.specifications || []).map((spec: any, index: number) => ({
  iconName: normalizeIcon(spec.icon, 'info-fill'),
  label: spec.label,
  value: spec.value,
  variant: variantCycle[index % 3]
}));

// === ASSET-LEVEL SPECS (from linked resources) ===

// Gather specs from each asset in the collection
const assetSpecs: Array<{ iconName: string; label: string; value: string; variant: typeof variantCycle[number] }> = [];
let assetIndex = 0;

resources.forEach((resource: any) => {
  const asset = getAssetBySlug(resource.slug);
  if (!asset) return;

  // Asset features
  (asset.features || []).forEach((feature: string) => {
    assetSpecs.push({
      iconName: 'check-circle-fill',
      label: resource.name,
      value: feature,
      variant: variantCycle[assetIndex++ % 3]
    });
  });

  // Asset evidence-based benefits
  (asset.professional?.evidenceBasedBenefits || []).forEach((benefit: string) => {
    assetSpecs.push({
      iconName: 'heart-fill',
      label: 'Evidence',
      value: benefit,
      variant: variantCycle[assetIndex++ % 3]
    });
  });

  // Asset tags (limit to avoid clutter)
  (asset.tags || []).slice(0, 3).forEach((tag: string) => {
    assetSpecs.push({
      iconName: 'tag-fill',
      label: 'Topic',
      value: tag.charAt(0).toUpperCase() + tag.slice(1),
      variant: variantCycle[assetIndex++ % 3]
    });
  });
});

// === CUSTOM CARDS (from project markdown) ===

// Convert customCards to specs (stat, highlight, etc.)
const customCardSpecs = ((project as any).customCards || []).map((card: any, index: number) => {
  // Map card type to appropriate label
  const typeLabels: Record<string, string> = {
    stat: card.title || 'Stat',
    highlight: 'Highlight',
    tag: 'Tag',
    quote: 'Quote',
    text: card.title || 'Info',
    summary: card.title || 'Summary'
  };

  return {
    iconName: normalizeIcon(card.icon, 'info-fill'),
    label: typeLabels[card.type] || card.type,
    value: card.content || card.title || '',
    variant: variantCycle[index % 3]
  };
});

// Limit each category to 2-3 items to avoid overwhelm
const limitedCustomCards = customCardSpecs.slice(0, 3);
const limitedHighlights = highlightSpecs.slice(0, 2);
const limitedSkills = skillSpecs.slice(0, 3);
const limitedBenefits = projectBenefitSpecs.slice(0, 3);
const limitedAssetSpecs = assetSpecs.slice(0, 6); // A few from assets
const limitedSpecs = specSpecs.slice(0, 2);

// Interleave cards so same types aren't adjacent
const specGroups = [
  limitedCustomCards,
  limitedHighlights,
  limitedSkills,
  limitedBenefits,
  limitedAssetSpecs,
  limitedSpecs
].filter(group => group.length > 0);

// Round-robin interleave: take one from each group in rotation
const interleavedSpecs: ProjectSpecItem[] = [];
let maxLength = Math.max(...specGroups.map(g => g.length));
for (let i = 0; i < maxLength; i++) {
  for (const group of specGroups) {
    if (i < group.length) {
      interleavedSpecs.push(group[i]);
    }
  }
}

// Reassign variants after interleaving for visual variety
const allSpecs: ProjectSpecItem[] = interleavedSpecs.map((spec, index) => ({
  ...spec,
  variant: variantCycle[index % 3]
}));

// ProjectSpecGrid uses simple 4-column layout, no grid calculations needed
---

<BaseLayout
  title={`${project.title} | Projects | Walking with a Smile`}
  description={project.description}
  hideFooter={true}
>
  <Breadcrumbs items={[
    { label: 'Home', href: '/' },
    { label: 'Projects', href: '/projects' },
    { label: project.title }
  ]} />

  <!-- Hero Section -->
  <section class="hero-section hero-section--simple">
    <div class="container">
      <div class="hero-section__content">
        <!-- Tags above title -->
        <div class="editorial-hero__tags">
          {project.tags.slice(0, 3).map((tag: string) => (
            <Badge
              type="default"
              label={tag}
              variant="soft"
              shape="pill"
              uppercase={false}
            />
          ))}
        </div>
        <h1 class="hero-section__title">{project.title}</h1>
        <p class="hero-section__subtitle">{project.description}</p>
        <!-- Resource count below -->
        <small class="editorial-hero__meta">
          <Badge
            type="default"
            label={`${resources.length} Resources`}
            icon="folder-fill"
            variant="outline"
            shape="pill"
          />
        </small>
      </div>
    </div>
  </section>

  <!-- About Section -->
  {(() => {
    const paragraphs = project.longDescription.split(/\n\n+/).filter(Boolean);
    const lead = paragraphs[0] || '';
    const subtitles = paragraphs.slice(1);
    return (
      <IntroTextSection
        lead={lead}
        subtitles={subtitles}
      />
    );
  })()}

  <!-- Evidence-Based Benefits Section -->
  {project.whoItsFor && whoForImage && (
    <ImageTextSection
      title="Who It's For"
      content={[project.whoItsFor]}
      image={whoForImage}
      imageAlt={`Who ${project.title} is designed for`}
      imagePosition="left"
      sectionId="who-benefits"
    />
  )}
  {project.whoItsFor && !whoForImage && (
    <section class="editorial-about section-sm">
      <div class="container">
        <div class="editorial-about__audience">
          <Icon name="interface/users-fill" size={24} />
          <div>
            <strong>Who it's for</strong>
            <p>{project.whoItsFor}</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Project Details (Features, Skills, Specifications) -->
  {allSpecs.length > 0 && (
    <section class="editorial-specs">
      <div class="container">
        <ProjectSpecGrid specs={allSpecs} />
      </div>
    </section>
  )}

  <!-- Resources Gallery -->
  <section class="editorial-resources section">
    <div class="container">
      <div class="products-grid">
        {resources.map((resource) => (
          <ProductCard
            slug={resource.slug}
            name={resource.name}
            category={resource.category}
            description={resource.description}
            cardImage={resource.cardImage}
            type={resource.type}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Share Section -->
  <ShareSection />

  <!-- Get Complete Collection CTA -->
  <section class="section">
    <div class="container text-center">
      <h2>Get the Complete Collection</h2>
      <p class="text-muted mb-lg">{resources.length} resources included — add them all to your basket in one click.</p>
      <div class="flex gap-sm justify-center flex-wrap">
        <Button
          variant="primary"
          size="md"
          id="add-all-btn"
          data-resources={JSON.stringify(resources.map(r => ({
            id: r.slug,
            name: r.name,
            price: 0,
            image: r.cardImage?.src || ''
          })))}
        >
          <Icon name="a11y/basket-fill" size={18} slot="icon" />
          Add All {resources.length} Items
        </Button>
        <Button href="/projects" variant="outline" size="md">
          Browse More Collections
        </Button>
      </div>
    </div>
  </section>

  <FooterWithMask />
</BaseLayout>

<script>
  // Initialize add-to-cart handlers for individual items
  document.querySelectorAll('.js-add-to-cart').forEach(button => {
    button.addEventListener('click', (e) => {
      e.preventDefault();
      const btn = e.currentTarget as HTMLElement;
      const productData = {
        id: btn.dataset.productId,
        name: btn.dataset.productName,
        price: parseFloat(btn.dataset.productPrice || '0'),
        image: btn.dataset.productImage
      };

      if ((window as any).addToCart) {
        (window as any).addToCart(productData);
      } else {
        console.warn('Cart system not initialized');
      }
    });
  });

  // Handle "Add All" button
  const addAllBtn = document.getElementById('add-all-btn');
  if (addAllBtn) {
    addAllBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const resourcesData = addAllBtn.dataset.resources;
      if (!resourcesData) return;

      const resources = JSON.parse(resourcesData);
      let addedCount = 0;

      resources.forEach((resource: any) => {
        if ((window as any).addToCart) {
          // Check if already in cart before adding
          const cartItems = (window as any).cartItems || [];
          const alreadyInCart = cartItems.some((item: any) => item.id === resource.id);
          if (!alreadyInCart) {
            (window as any).addToCart(resource);
            addedCount++;
          }
        }
      });

      // Show summary toast
      if (typeof (window as any).showToast === 'function') {
        if (addedCount > 0) {
          (window as any).showToast({
            message: `Added ${addedCount} item${addedCount > 1 ? 's' : ''} to your cart!`,
            theme: 'professional',
            animation: 'flip',
            lottieUrl: '/Icons/Animated Icons/Basket Icons/lottie-basket-morph-fill.json'
          });
        } else {
          (window as any).showToast({
            message: 'All items are already in your cart!',
            theme: 'professional',
            animation: 'flip',
            lottieUrl: '/Icons/Animated Icons/Basket Icons/lottie-basket-loop-cycle.json'
          });
        }
      }
    });
  }
</script>
