---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMorphAnimation from '../components/organisms/sections/HeroMorphAnimation.astro';
import ImageTextSection from '../components/organisms/sections/ImageTextSection.astro';
import PillarsSection from '../components/organisms/sections/PillarsSection.astro';
import WhoSliderSection from '../components/organisms/sections/WhoSliderSection.astro';
import CTASection from '../components/organisms/sections/CTASection.astro';
import Footer from '../components/organisms/Footer/Footer.astro';
import RainbowBorderCard from '../components/molecules/cards/RainbowBorderCard/RainbowBorderCard.astro';
import BlogCard from '../components/molecules/cards/BlogCard/BlogCard.astro';
import ChoiceCard from '../components/molecules/cards/ChoiceCard/ChoiceCard.astro';
import Card from '../components/atoms/Card/Card.astro';
import Badge from '../components/atoms/Badge/Badge.astro';
import Heading from '../components/atoms/Heading/Heading.astro';
import Text from '../components/atoms/Text/Text.astro';
import Button from '../components/atoms/Button/Button.astro';

// Image imports from src/PageImages for Astro optimization
import bridgeImage from '../PageImages/Home/Bridge/Bridge.png';
import approachImage from '../PageImages/Home/Approach/Our Approach.png';
import pillar1Image from '../PageImages/Home/Pillars/Pillar-1.png';
import pillar2Image from '../PageImages/Home/Pillars/Pillar-2.png';
import pillar3Image from '../PageImages/Home/Pillars/Pillar-3.png';
import sliderTitleImage from '../PageImages/Home/Who/Slider-Title.png';
import slider1Image from '../PageImages/Home/Who/Slider-1.png';
import slider2Image from '../PageImages/Home/Who/Slider-2.png';
import slider3Image from '../PageImages/Home/Who/Slider-3.png';
import slider4Image from '../PageImages/Home/Who/Slider-4.png';
import slider5Image from '../PageImages/Home/Who/Slider-5.png';
import slider6Image from '../PageImages/Home/Who/Slider-6.png';

// Import JSON data
import heroDataRaw from '../data/home/hero.json';
import bridgeDataRaw from '../data/home/bridge.json';
import pillarsDataRaw from '../data/home/pillars.json';
import whoSliderDataRaw from '../data/home/who-slider.json';
import approachDataRaw from '../data/home/approach.json';
import ctaDataRaw from '../data/home/cta.json';

// Type assertions for proper typing
const heroData = heroDataRaw as { buttons: Array<{ text: string; href: string; variant: 'primary' | 'outline' }> };
const bridgeData = bridgeDataRaw as {
  title: string;
  content: string[];
  image: string;
  imageAlt: string;
  imagePosition: 'left' | 'right';
  ctaText: string;
  ctaHref: string;
};
const pillarsData = pillarsDataRaw as typeof pillarsDataRaw;
const whoSliderData = whoSliderDataRaw as typeof whoSliderDataRaw;
const approachData = approachDataRaw as {
  title: string;
  content: string[];
  image: string;
  imageAlt: string;
  imagePosition: 'left' | 'right';
  ctaText: string;
  ctaHref: string;
};
const ctaData = ctaDataRaw as { title: string; description: string[]; buttons: Array<{ text: string; href: string; variant: 'primary' | 'outline' }> };

// Map pillar images
const pillarImages = [pillar1Image, pillar2Image, pillar3Image];
const pillarsWithImages = pillarsData.pillars.map((pillar, index) => ({
  ...pillar,
  image: pillarImages[index]
}));

// Map who slider images
const whoSliderImages = [slider1Image, slider2Image, slider3Image, slider4Image, slider5Image, slider6Image];
---

<BaseLayout
  title="Walking With A Smile | Your past shaped you. It doesn't have to define you."
  description="Support for trauma recovery and healing. Practical resources to help you move from survival to living, at your own pace."
  hideFooter={true}
>
  <!-- Hero Section with Morphing SVG Animation -->
  <HeroMorphAnimation
    ctaButtons={heroData.buttons}
  />

  <!-- The Bridge Section -->
  <ImageTextSection
    sectionId="bridge-section"
    title={bridgeData.title}
    content={bridgeData.content}
    image={bridgeImage}
    imageAlt={bridgeData.imageAlt}
    imagePosition={bridgeData.imagePosition}
    ctaText={bridgeData.ctaText}
    ctaHref={bridgeData.ctaHref}
  />

  <!-- What We Offer Section -->
  <PillarsSection
    title={pillarsData.title}
    description={pillarsData.description}
    pillars={pillarsWithImages}
  />

  <!-- Who This Is For Section -->
  <WhoSliderSection
    title={whoSliderData.title}
    subtitle={whoSliderData.subtitle}
    titleImage={sliderTitleImage}
    slides={whoSliderData.slides}
    slideImages={whoSliderImages}
  />

  <!-- Our Approach Section -->
  <ImageTextSection
    sectionId="approach-section"
    title={approachData.title}
    content={approachData.content}
    image={approachImage}
    imageAlt={approachData.imageAlt}
    imagePosition={approachData.imagePosition}
    ctaText={approachData.ctaText}
    ctaHref={approachData.ctaHref}
  />

  <!-- Card variant visual test — DELETE after visual check -->
  <section style="padding: var(--space-2xl) var(--space-xl);">
    <h2 style="text-align: center; color: var(--brand-c-text); margin-bottom: var(--space-xl);">Card Variant Test</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-xl); max-width: 1200px; margin: 0 auto;">

      <!-- Default -->
      <div class="card card--default card--radius-lg card--pad-xl" style="box-shadow: var(--shadow-elevated);">
        <h3 style="margin: 0 0 var(--space-md); color: var(--brand-c-text);">Default</h3>
        <p style="margin: 0 0 var(--space-lg); color: var(--brand-c-text);">Self-adapting --shadow-elevated. Light=black shadows, dark=black on #121212, HC dark=white glow.</p>
        <button class="btn btn--primary btn--pill" type="button">Button</button>
      </div>

      <!-- Neumorphic -->
      <div class="card card--neumorphic card--hover-glow card--radius-lg card--pad-xl">
        <h3 style="margin: 0 0 var(--space-md); color: var(--brand-c-text);">Neumorphic</h3>
        <p style="margin: 0 0 var(--space-lg); color: var(--brand-c-text);">Raised shadow + glow border on hover. Uses --shadow-elevated.</p>
        <button class="btn btn--primary btn--pill" type="button">Button</button>
      </div>

      <!-- Neumorphic Pressed -->
      <div class="card card--pressed card--hover-glow card--radius-lg card--pad-xl">
        <h3 style="margin: 0 0 var(--space-md); color: var(--brand-c-text);">Neumorphic Pressed</h3>
        <p style="margin: 0 0 var(--space-lg); color: var(--brand-c-text);">Inset/carved shadow (--shadow-neu-pressed). Glow border on hover.</p>
        <button class="btn btn--primary btn--pill" type="button">Button</button>
      </div>

      <!-- Comic -->
      <div class="card card--comic card--radius-lg card--pad-xl card--hover-lift">
        <h3 style="margin: 0 0 var(--space-md); color: var(--brand-c-text);">Comic</h3>
        <p style="margin: 0 0 var(--space-lg); color: var(--brand-c-text);">Thick border + hard offset shadow. Hover shifts on press (gated by animation prop).</p>
        <button class="btn btn--primary btn--pill" type="button">Button</button>
      </div>

      <!-- Tech -->
      <div class="card card--tech card--radius-lg card--pad-xl card--hover-lift">
        <h3 style="margin: 0 0 var(--space-md); color: var(--brand-c-text);">Tech</h3>
        <p style="margin: 0 0 var(--space-lg); color: var(--brand-c-text);">Accent border frame offset. Frame swap on hover (gated by animation prop).</p>
        <button class="btn btn--primary btn--pill" type="button">Button</button>
      </div>

      <!-- Outline -->
      <div class="card card--outline card--radius-lg card--pad-xl">
        <h3 style="margin: 0 0 var(--space-md); color: var(--brand-c-text);">Outline</h3>
        <p style="margin: 0 0 var(--space-lg); color: var(--brand-c-text);">Transparent bg, border only. No shadow.</p>
        <button class="btn btn--primary btn--pill" type="button">Button</button>
      </div>

    </div>
  </section>

  <!-- Glass variant test — full image with cards on top -->
  <section style={`position: relative; min-height: 500px; background: url('${bridgeImage.src}') center/cover no-repeat; padding: var(--space-2xl) var(--space-xl);`}>
    <!-- SVG distortion filter for liquid glass -->
    <svg width="0" height="0" style="position: absolute;" aria-hidden="true">
      <defs>
        <filter id="glass-distortion" x="0%" y="0%" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.02 0.02" numOctaves="2" seed="92" result="noise" />
          <feGaussianBlur in="noise" stdDeviation="2" result="blurred" />
          <feDisplacementMap in="SourceGraphic" in2="blurred" scale="200" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>

    <h2 style="text-align: center; color: white; margin-bottom: var(--space-xl); text-shadow: 0 2px 8px rgba(0,0,0,0.5);">Glass Variants Over Image</h2>
    <div style="display: flex; gap: var(--space-xl); justify-content: center; flex-wrap: wrap;">

      <!-- Glass (frosted) -->
      <div class="card card--glass card--radius-lg card--pad-xl" style="width: 360px;">
        <h3 style="margin: 0 0 var(--space-md); color: white;">Glass</h3>
        <p style="margin: 0 0 var(--space-lg); color: white; opacity: 0.85;">Frosted glassmorphism. Backdrop-blur frosts the image beneath.</p>
        <button class="btn btn--primary btn--pill" type="button">Button</button>
      </div>

      <!-- Liquid Glass (distortion) -->
      <div class="card card--liquid card--radius-lg card--pad-xl" style="width: 360px;">
        <h3 style="margin: 0 0 var(--space-md); color: white;">Liquid Glass</h3>
        <p style="margin: 0 0 var(--space-lg); color: white; opacity: 0.85;">SVG distortion + blur. Inner white glow edges. Liquid warp effect.</p>
        <button class="btn btn--primary btn--pill" type="button">Button</button>
      </div>

    </div>
  </section>

  <!-- RainbowBorderCard test section (DELETE before production) -->
  <section style="padding: var(--space-2xl) var(--space-sm); max-width: 1200px; margin: 0 auto;">
    <h2 style="margin-bottom: var(--space-xl); text-align: center;">Rainbow Border Cards (Audit Test)</h2>
    <div style="margin-bottom: var(--space-lg); display: flex; gap: var(--space-sm); justify-content: center;">
      <button class="btn btn--sm btn--outline" data-set-hover="none">Hover: None</button>
      <button class="btn btn--sm btn--outline" data-set-hover="instant">Instant</button>
      <button class="btn btn--sm btn--outline" data-set-hover="gentle">Gentle</button>
      <button class="btn btn--sm btn--outline" data-set-hover="full">Full</button>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--space-xl);">

      <!-- Full rainbow (default 7 tokens) -->
      <RainbowBorderCard variant="primary" borderWidth="12px">
        <Card as="article" padding="lg" shadow="none" radius="none">
          <Badge label="Workbook" />
          <Heading level={2} size="h4" weight="medium" color="accent" uppercase flush>Boundaries & Self-Worth</Heading>
          <Text weight="light" flush>A 12-page guided workbook for exploring personal boundaries in relationships.</Text>
          <div style="margin-top: var(--space-lg); display: flex; gap: var(--space-md); flex-wrap: wrap;">
            <Button variant="primary" size="sm" href="/workbooks/boundaries">View Workbook</Button>
            <Button shape="circle" variant="glass" size="sm" ariaLabel="Download" icon="download-fill" />
          </div>
        </Card>
      </RainbowBorderCard>

      <!-- Custom 3-colour gradient -->
      <RainbowBorderCard variant="gradient" colors={['var(--rainbow-1)', 'var(--rainbow-3)', 'var(--rainbow-5)']}>
        <Card as="article" padding="lg" shadow="none" radius="none">
          <Badge label="Guide" />
          <Heading level={2} size="h4" weight="medium" color="accent" uppercase flush>Safety Planning Template</Heading>
          <Text weight="light" flush>Step-by-step safety planning guide for practitioners and clients.</Text>
          <div style="margin-top: var(--space-lg); display: flex; gap: var(--space-md); flex-wrap: wrap;">
            <Button variant="primary" size="sm" href="/guides/safety-plan">Read Guide</Button>
            <Button shape="circle" variant="glass" size="sm" ariaLabel="Download" icon="download-fill" />
          </div>
        </Card>
      </RainbowBorderCard>

      <!-- Custom 2-colour duo-tone -->
      <RainbowBorderCard variant="pulse" borderWidth="3px" colors={['var(--brand-c-primary)', 'var(--brand-c-secondary)']}>
        <Card as="article" padding="lg" shadow="none" radius="none">
          <Badge label="Exercise" />
          <Heading level={2} size="h4" weight="medium" color="accent" uppercase flush>Grounding Techniques</Heading>
          <Text weight="light" flush>Five grounding exercises for managing anxiety and distress.</Text>
          <div style="margin-top: var(--space-lg); display: flex; gap: var(--space-md); flex-wrap: wrap;">
            <Button variant="primary" size="sm" href="/exercises/grounding">Start Exercise</Button>
          </div>
        </Card>
      </RainbowBorderCard>

    </div>
  </section>

  <!-- Blog Cards — audit test section (DELETE before production) -->
  <section style="padding: var(--space-2xl) var(--space-sm); max-width: 1200px; margin: 0 auto;">
    <h2 style="margin-bottom: var(--space-xl); text-align: center;">Blog Cards (Audit Test)</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: var(--space-xl);">
      <BlogCard
        title="Finding Your Way Back"
        excerpt="Every recovery journey is different. Here's how to build a path that works for you, at your own pace."
        image="/_Unused Images/Articles hero Image.png"
        category="Recovery"
        author="Natasha Charlton"
        date="March 2026"
        readTime="5 min read"
        tags={["CPTSD", "Self-care", "Recovery"]}
        href="/insights/finding-your-way-back"
      />
      <BlogCard
        title="Boundaries Without Guilt"
        excerpt="Setting boundaries isn't selfish — it's essential. Learn practical steps to protect your energy."
        image="/_Unused Images/Article Hero Card.png"
        category="Wellbeing"
        date="February 2026"
        readTime="4 min read"
        tags={["Boundaries", "Relationships"]}
        href="/insights/boundaries"
        featured
      />
      <BlogCard
        title="Grounding Techniques That Actually Work"
        excerpt="Five evidence-based grounding exercises for managing anxiety and distress in the moment."
        category="Techniques"
        author="Natasha Charlton"
        date="January 2026"
        readTime="3 min read"
        href="/insights/grounding"
      />
    </div>
  </section>

  <!-- Choice Cards — audit test section (DELETE before production) -->
  <section style="padding: var(--space-2xl) var(--space-sm); max-width: 1200px; margin: 0 auto;">
    <h2 style="margin-bottom: var(--space-xl); text-align: center;">Choice Cards (Audit Test)</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); gap: var(--space-lg); align-items: start;">
      <!-- Image + radio -->
      <ChoiceCard
        image="/_Unused Images/3.jpg"
        label="Abstract"
        inputType="radio"
        name="style"
        value="abstract"
        checked
      />
      <!-- Image + checkbox -->
      <ChoiceCard
        image="/_Unused Images/7.jpg"
        label="Colourful"
        inputType="checkbox"
        name="extras"
        value="colourful"
      />
      <!-- Icon + radio -->
      <ChoiceCard
        icon="heart-fill"
        label="Favourite"
        inputType="radio"
        name="style"
        value="favourite"
      />
      <!-- Label only + toggle -->
      <ChoiceCard
        label="Dark Mode"
        description="Switch to dark colour scheme"
        inputType="toggle"
        name="darkmode"
        value="on"
      />
      <!-- Icon + checkbox -->
      <ChoiceCard
        icon="star-fill"
        label="Premium"
        description="Unlock all features"
        inputType="checkbox"
        name="extras"
        value="premium"
      />
      <!-- Image + toggle -->
      <ChoiceCard
        image="/_Unused Images/6.png"
        label="Minimal"
        description="Clean and simple aesthetic"
        inputType="toggle"
        name="minimal"
        value="on"
      />
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title={ctaData.title}
    description={ctaData.description}
    buttons={ctaData.buttons}
  />

  <!-- Footer with Interactive Mask -->
  <Footer animated />
</BaseLayout>

<script>
  // Hover gate test buttons (DELETE before production)
  function initHoverButtons(): void {
    document.querySelectorAll<HTMLButtonElement>('[data-set-hover]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.setHover!;
        if (mode === 'full') {
          document.body.removeAttribute('data-hover');
        } else {
          document.body.dataset.hover = mode;
        }
        document.querySelectorAll<HTMLButtonElement>('[data-set-hover]').forEach((b) => {
          b.classList.toggle('btn--primary', b.dataset.setHover === mode);
          b.classList.toggle('btn--outline', b.dataset.setHover !== mode);
        });
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHoverButtons);
  } else {
    initHoverButtons();
  }
  document.addEventListener('astro:page-load', initHoverButtons);
</script>


