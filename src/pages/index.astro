---
import BaseLayout from '../layouts/BaseLayout.astro';
import Heading from '../components/atoms/Heading/Heading.astro';
import Section from '../components/atoms/Section/Section.astro';
import '../components/atoms/Section/Section.css';
---

<BaseLayout title="Atom Test Hub">
  <Section container="7xl" gap="4xl">

    <Heading level={1} align="center" flush>Atom Test Hub</Heading>
    <Heading level={3} align="center" weight="normal" flush style="--heading-color: var(--neutral-600)">
      Test each atom individually via JSON pipeline
    </Heading>

    <Section gap="lg">
      <a href="/test/heading" style="display:block; padding: var(--space-lg); border: 1px solid var(--neutral-400); border-radius: var(--radius-md); text-decoration: none; color: inherit;">
        <Heading level={3} flush>Heading</Heading>
        <p style="margin-top: var(--space-xs); color: var(--neutral-600);">Levels, sizes, weights, colours, families, variants, dividers, subtitles, media, icons, lottie, images, AAC</p>
      </a>
      <a href="/test/badge" style="display:block; padding: var(--space-lg); border: 1px solid var(--neutral-400); border-radius: var(--radius-md); text-decoration: none; color: inherit;">
        <Heading level={3} flush>Badge</Heading>
        <p style="margin-top: var(--space-xs); color: var(--neutral-600);">Variants, sizes, shapes, icons, colours, heading levels, semantic roles, combinations</p>
      </a>
    </Section>

  </Section>
</BaseLayout>
