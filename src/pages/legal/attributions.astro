---
export const prerender = true;

import LegalLayout from '../../layouts/LegalLayout.astro';
import { aacInline } from '../../lib/aac/aac-inline';
import '../../components/molecules/aac/AacCard/AacCard.css';

const ASSET_API_URL = import.meta.env.ASSET_API_URL || 'http://localhost:8787';

// Fetch licenses from Asset Library API (GET is public, no token needed)
let licenses: any[] = [];
try {
  const res = await fetch(`${ASSET_API_URL}/v1/licenses`);
  if (res.ok) {
    licenses = await res.json();
  } else {
    console.error(`Failed to fetch licenses: ${res.status}`);
  }
} catch (err) {
  console.error('Could not reach Asset Library API:', err);
}

// Only show licenses that have attribution text
const attributed = licenses.filter(l => l.attribution);

// Resolve AAC card HTML for licenses that have aac_summary
type LicenseWithAac = typeof attributed[number] & { aacHtml?: string };

const licensesWithAac: LicenseWithAac[] = [];
for (const license of attributed) {
  if (license.aac_summary) {
    const html = await aacInline(license.aac_summary, ASSET_API_URL);
    licensesWithAac.push({ ...license, aacHtml: html });
  } else {
    licensesWithAac.push(license);
  }
}
---

<LegalLayout
  title="Attributions"
  description="Credits and licence information for third-party assets used across this site."
  lastUpdated="2026-02-28"
  currentSlug="attributions"
>
  <p class="attributions-intro">
    This site uses icons, images, fonts, and other assets from generous open-source
    and Creative Commons projects. Here is where they come from and how they can be used.
  </p>

  {licensesWithAac.length === 0 && (
    <p>No attribution data available.</p>
  )}

  <ul class="attributions-list">
    {licensesWithAac.map(license => (
      <li class="attribution-item">
        <h2 class="attribution-name">{license.name}</h2>

        <p class="attribution-credit">{license.attribution}</p>

        <details class="attribution-details image-alt-descriptive">
          <summary>What does this licence mean?</summary>
          <p>{license.summary}</p>
        </details>

        {license.aacHtml && (
          <blockquote class="attribution-aac image-alt-aac">
            <span class="attribution-aac-label">In simple words:</span>
            <span class="attribution-aac-words" set:html={license.aacHtml} />
          </blockquote>
        )}

        {license.url && (
          <a class="attribution-link" href={license.url} target="_blank" rel="noopener noreferrer">
            Read the full licence
          </a>
        )}
      </li>
    ))}
  </ul>
</LegalLayout>
