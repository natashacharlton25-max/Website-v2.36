---
/**
 * Section Title Component Showcase
 * Visual demonstration of all SectionTitle variants and options
 */
import BaseLayout from '../../Layouts/BaseLayout.astro';
import SectionTitle from '../../components/Typography/SectionTitle.astro';
---

<BaseLayout title="Section Title Showcase">
  <main class="showcase">
    <div class="container">

      <header class="showcase__header">
        <h1>Section Title Component</h1>
        <p>A flexible, reusable component for section headings with multiple variants and styling options.</p>
      </header>

      <!-- DEFAULT VARIANT -->
      <section class="showcase__section">
        <h2 class="showcase__label">Default (Vertical Divider)</h2>
        <div class="showcase__grid">
          <div class="showcase__item">
            <SectionTitle title="Our Story" />
            <code>&lt;SectionTitle title="Our Story" /&gt;</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Services" dividerColor="secondary" />
            <code>dividerColor="secondary"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Featured" dividerColor="neutral" />
            <code>dividerColor="neutral"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Gradient" dividerColor="gradient" />
            <code>dividerColor="gradient"</code>
          </div>
        </div>
      </section>

      <!-- DIVIDER POSITIONS -->
      <section class="showcase__section">
        <h2 class="showcase__label">Divider Positions</h2>
        <div class="showcase__grid">
          <div class="showcase__item">
            <SectionTitle title="Left Divider" dividerPosition="left" />
            <code>dividerPosition="left"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Right Divider" dividerPosition="right" />
            <code>dividerPosition="right"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Both Sides" dividerPosition="both" />
            <code>dividerPosition="both"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="No Divider" dividerPosition="none" />
            <code>dividerPosition="none"</code>
          </div>
        </div>
      </section>

      <!-- DIVIDER STYLES -->
      <section class="showcase__section">
        <h2 class="showcase__label">Divider Styles</h2>
        <div class="showcase__grid">
          <div class="showcase__item">
            <SectionTitle title="Solid" dividerStyle="solid" />
            <code>dividerStyle="solid"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Dashed" dividerStyle="dashed" />
            <code>dividerStyle="dashed"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Dotted" dividerStyle="dotted" />
            <code>dividerStyle="dotted"</code>
          </div>
        </div>
      </section>

      <!-- DIVIDER ENDS -->
      <section class="showcase__section">
        <h2 class="showcase__label">Divider Ends</h2>
        <div class="showcase__grid">
          <div class="showcase__item">
            <SectionTitle title="Rounded Ends" dividerEnds="rounded" />
            <code>dividerEnds="rounded" (default)</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Square Ends" dividerEnds="square" />
            <code>dividerEnds="square"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Square + Dashed" dividerEnds="square" dividerStyle="dashed" />
            <code>dividerEnds="square" dividerStyle="dashed"</code>
          </div>
        </div>
      </section>

      <!-- DIVIDER LENGTHS -->
      <section class="showcase__section">
        <h2 class="showcase__label">Divider Lengths</h2>
        <div class="showcase__grid">
          <div class="showcase__item">
            <SectionTitle title="Auto Length (stretches with text)" dividerLength="auto" />
            <code>dividerLength="auto" (default)</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="XS Length" dividerLength="xs" />
            <code>dividerLength="xs"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="SM Length" dividerLength="sm" />
            <code>dividerLength="sm"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="MD Length" dividerLength="md" />
            <code>dividerLength="md"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="LG Length" dividerLength="lg" />
            <code>dividerLength="lg"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="XL Length" dividerLength="xl" />
            <code>dividerLength="xl"</code>
          </div>
        </div>
      </section>

      <!-- MULTILINE AUTO LENGTH -->
      <section class="showcase__section">
        <h2 class="showcase__label">Auto Length with Multiline Text</h2>
        <div class="showcase__stack">
          <div class="showcase__item">
            <SectionTitle title="Short" dividerLength="auto" />
            <code>Short title - auto length</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="A Much Longer Title That Wraps To Multiple Lines On Smaller Screens" dividerLength="auto" />
            <code>Long title - auto length stretches with text</code>
          </div>
        </div>
      </section>

      <!-- SIZES -->
      <section class="showcase__section">
        <h2 class="showcase__label">Sizes</h2>
        <div class="showcase__stack">
          <div class="showcase__item">
            <SectionTitle title="Extra Small" size="xs" />
            <code>size="xs"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Small" size="sm" />
            <code>size="sm"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Medium" size="md" />
            <code>size="md"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Large (Default)" size="lg" />
            <code>size="lg"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Extra Large" size="xl" />
            <code>size="xl"</code>
          </div>
        </div>
      </section>

      <!-- UNDERLINE VARIANT -->
      <section class="showcase__section">
        <h2 class="showcase__label">Underline Variant</h2>
        <div class="showcase__grid">
          <div class="showcase__item">
            <SectionTitle title="Solid Underline" variant="underline" />
            <code>variant="underline"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Gradient Underline" variant="underline" underlineStyle="gradient" />
            <code>underlineStyle="gradient"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Dashed Underline" variant="underline" underlineStyle="dashed" />
            <code>underlineStyle="dashed"</code>
          </div>
        </div>
      </section>

      <!-- BADGE VARIANT -->
      <section class="showcase__section">
        <h2 class="showcase__label">Badge Variant</h2>
        <div class="showcase__flex">
          <div class="showcase__item">
            <SectionTitle title="NEW" variant="badge" badgeColor="primary" />
            <code>badgeColor="primary"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="SALE" variant="badge" badgeColor="secondary" />
            <code>badgeColor="secondary"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="HOT" variant="badge" badgeColor="neutral" />
            <code>badgeColor="neutral"</code>
          </div>
        </div>
      </section>

      <!-- HIGHLIGHT VARIANT -->
      <section class="showcase__section">
        <h2 class="showcase__label">Highlight Variant</h2>
        <div class="showcase__grid">
          <div class="showcase__item">
            <SectionTitle title="Primary Highlight" variant="highlight" highlightColor="primary" />
            <code>highlightColor="primary"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Secondary Highlight" variant="highlight" highlightColor="secondary" />
            <code>highlightColor="secondary"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Neutral Highlight" variant="highlight" highlightColor="neutral" />
            <code>highlightColor="neutral"</code>
          </div>
        </div>
      </section>

      <!-- MINIMAL VARIANT -->
      <section class="showcase__section">
        <h2 class="showcase__label">Minimal Variant</h2>
        <div class="showcase__item">
          <SectionTitle title="Subtle & Clean" variant="minimal" />
          <code>variant="minimal"</code>
        </div>
      </section>

      <!-- WITH SUBTITLE -->
      <section class="showcase__section">
        <h2 class="showcase__label">With Subtitle</h2>
        <div class="showcase__stack">
          <div class="showcase__item">
            <SectionTitle title="Our Services" subtitle="Discover what we offer" />
            <code>subtitle="Discover what we offer"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Get Started" subtitle="Begin your journey today" variant="underline" underlineStyle="gradient" />
            <code>variant="underline" + subtitle</code>
          </div>
        </div>
      </section>

      <!-- WITH MEDIA -->
      <section class="showcase__section">
        <h2 class="showcase__label">With Icon</h2>
        <div class="showcase__grid">
          <div class="showcase__item">
            <SectionTitle title="Contact Us" icon="envelope-fill" />
            <code>icon="envelope-fill"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Settings" icon="gear-fill" mediaPosition="right" />
            <code>icon="gear-fill" mediaPosition="right"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Search" icon="magnifying-glass-fill" dividerColor="secondary" />
            <code>icon + dividerColor</code>
          </div>
        </div>
      </section>

      <!-- WITH IMAGE -->
      <section class="showcase__section">
        <h2 class="showcase__label">With Image</h2>
        <div class="showcase__grid">
          <div class="showcase__item">
            <SectionTitle title="Featured Project" image="/_Unused Images/Asset-Main-1.png" />
            <code>image="/path/to/img.jpg"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Latest Work" image="/_Unused Images/Asset-Main-2.png" mediaPosition="right" mediaSize="lg" />
            <code>mediaPosition="right" mediaSize="lg"</code>
          </div>
        </div>
      </section>

      <!-- AUTO-SCALING MEDIA -->
      <section class="showcase__section">
        <h2 class="showcase__label">Auto-Scaling Media (scales with title size)</h2>
        <div class="showcase__stack">
          <div class="showcase__item">
            <SectionTitle title="Small Title" size="sm" icon="star-fill" />
            <code>size="sm" icon="star-fill" (auto scales)</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Medium Title" size="md" icon="star-fill" />
            <code>size="md" icon="star-fill" (auto scales)</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Large Title" size="lg" icon="star-fill" />
            <code>size="lg" icon="star-fill" (auto scales)</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="XL Title" size="xl" icon="star-fill" />
            <code>size="xl" icon="star-fill" (auto scales)</code>
          </div>
        </div>
      </section>

      <!-- TEXT STYLING -->
      <section class="showcase__section">
        <h2 class="showcase__label">Text Styling</h2>
        <div class="showcase__stack">
          <div class="showcase__item">
            <SectionTitle title="Uppercase Title" uppercase />
            <code>uppercase</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Medium Weight" fontWeight="medium" />
            <code>fontWeight="medium"</code>
          </div>
          <div class="showcase__item">
            <SectionTitle title="Custom Color" textColor="var(--brand-c-neutral-dark)" />
            <code>textColor="var(--brand-c-neutral-dark)"</code>
          </div>
        </div>
      </section>

      <!-- ALIGNMENT -->
      <section class="showcase__section">
        <h2 class="showcase__label">Alignment</h2>
        <div class="showcase__stack">
          <div class="showcase__item showcase__item--full">
            <SectionTitle title="Left Aligned" align="left" />
            <code>align="left"</code>
          </div>
          <div class="showcase__item showcase__item--full">
            <SectionTitle title="Center Aligned" align="center" dividerPosition="both" />
            <code>align="center" dividerPosition="both"</code>
          </div>
          <div class="showcase__item showcase__item--full">
            <SectionTitle title="Right Aligned" align="right" dividerPosition="right" />
            <code>align="right" dividerPosition="right"</code>
          </div>
        </div>
      </section>

      <!-- CENTERED UNDERLINE -->
      <section class="showcase__section">
        <h2 class="showcase__label">Centered with Underline</h2>
        <div class="showcase__item showcase__item--full">
          <SectionTitle title="Welcome to Our Site" subtitle="We're glad you're here" variant="underline" underlineStyle="gradient" align="center" />
          <code>variant="underline" align="center"</code>
        </div>
      </section>

    </div>
  </main>
</BaseLayout>

<style>
  .showcase {
    padding: var(--space-4xl) 0;
    background: var(--brand-c-bg);
    min-height: 100vh;
  }

  .container {
    max-width: var(--container-6xl);
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }

  .showcase__header {
    text-align: center;
    margin-bottom: var(--space-4xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--brand-c-neutral-light);
  }

  .showcase__header h1 {
    font-size: var(--text-4xl);
    color: var(--brand-c-text);
    margin-bottom: var(--space-md);
  }

  .showcase__header p {
    font-size: var(--text-lg);
    color: var(--brand-c-text-light);
    max-width: 600px;
    margin: 0 auto;
  }

  .showcase__section {
    margin-bottom: var(--space-4xl);
  }

  .showcase__label {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--brand-c-text-light);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-sm);
    border-bottom: 1px dashed var(--brand-c-neutral-light);
  }

  .showcase__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-2xl);
  }

  .showcase__stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .showcase__flex {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    align-items: flex-start;
  }

  .showcase__item {
    background: var(--color-White);
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    border: 1px solid var(--brand-c-neutral-light);
  }

  .showcase__item--full {
    width: 100%;
  }

  .showcase__item code {
    display: block;
    margin-top: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background: var(--brand-c-neutral-light);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    color: var(--brand-c-text);
    font-family: monospace;
  }

  /* Override margin for showcase */
  .showcase__item :global(.section-title) {
    margin-bottom: 0;
  }
</style>
