---
/**
 * GlowCard — Glass card with SVG-draw decorative icons and bioluminescent glow
 *
 * Frosted/glass card body with large stroke-only Phosphor icons positioned
 * half-in, half-out around the card edges. On hover, icons draw in via
 * GSAP DrawSVGPlugin and emit a coloured glow via CSS drop-shadow filter.
 *
 * Optional MorphSVGPlugin support — decoration icons can morph to a
 * different shape on hover alongside the draw animation.
 *
 * @param title        - Card heading
 * @param description  - Card body text
 * @param glowColor    - Glow colour CSS value (default: --brand-c-primary-light)
 * @param dark         - Dark colour scheme (default: false)
 * @param decorations  - Array of icon decorations with positions
 * @param drawVariant  - Draw animation variant: draw | drawcenter | pulse
 * @param grid         - Show subtle grid texture (default: true when dark)
 * @param class        - Extra classes
 */
import Icon from '../../atoms/Icon/Icon.astro';
import fs from 'node:fs';
import path from 'node:path';

interface GlowDecoration {
  icon: string;
  position: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right' | 'left' | 'right';
  size?: number;
  morphTo?: string;
}

interface Props {
  title?: string;
  description?: string;
  glowColor?: string;
  dark?: boolean;
  decorations?: GlowDecoration[];
  drawVariant?: 'draw' | 'drawcenter' | 'pulse';
  grid?: boolean;
  class?: string;
}

const {
  title,
  description = '',
  glowColor = 'var(--brand-c-primary-light)',
  dark = false,
  decorations = [],
  drawVariant = 'draw',
  grid,
  class: className = '',
} = Astro.props;

const showGrid = grid !== undefined ? grid : dark;

// ── Load morph target SVGs at build time ──
const categories = ['nature', 'wellness', 'objects', 'interface', 'communication', 'people', 'creative', 'shapes', 'a11y', 'spec-cards', 'badges', 'trust'];

const tryLoadIcon = (iconPath: string): string | null => {
  try {
    const fullPath = path.join(process.cwd(), 'public', iconPath);
    if (fs.existsSync(fullPath)) {
      return fs.readFileSync(fullPath, 'utf-8');
    }
  } catch {}
  return null;
};

const loadIcon = (name: string): string | null => {
  if (name.includes('/')) return tryLoadIcon(`/Icons/phosphor/${name}.svg`);
  for (const cat of categories) {
    const content = tryLoadIcon(`/Icons/phosphor/${cat}/${name}.svg`);
    if (content) return content;
  }
  return null;
};

const processedDecorations = decorations.map(d => ({
  ...d,
  morphTarget: d.morphTo ? loadIcon(d.morphTo) : null,
}));
---

<div
  class:list={['card', 'glow-card', dark && 'glow-card--dark', showGrid && 'glow-card--grid', className]}
  style={`--_glow: ${glowColor};`}
  data-glow-card
  data-glow-variant={drawVariant}
>
  {processedDecorations.map(d => (
    <div
      class={`glow-card__deco glow-card__deco--${d.position}`}
      style={d.size ? `--_deco-size: ${d.size}px` : ''}
      data-glow-deco
      {...(d.morphTarget ? { 'data-glow-morph': d.morphTarget } : {})}
      aria-hidden="true"
    >
      <Icon name={d.icon} stroke size={d.size || 120} />
    </div>
  ))}

  <div class="glow-card__body">
    {title && <h3 class="glow-card__title text">{title}</h3>}
    {description && <p class="glow-card__text text">{description}</p>}
    <slot />
  </div>
</div>

<style>
  /* ── Card container ── */
  .glow-card {
    --_glow: var(--brand-c-primary-light);
    --_stroke-w: 10;

    position: relative;
    overflow: visible;
    width: 100%;
    max-width: 28rem;
  }

  /* ── Glass body — matches .card--glass variant ── */
  .glow-card__body {
    position: relative;
    background: color-mix(in oklch, var(--brand-c-bg) 60%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid color-mix(in oklch, var(--_glow) 15%, transparent);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl);
    transition: box-shadow 0.5s, border-color 0.5s;
    z-index: 2;
  }

  /* Hover — light mode: glow box-shadow (matches btn--glow pattern) */
  .glow-card:not(.glow-card--dark):hover .glow-card__body {
    border-color: color-mix(in oklch, var(--_glow) 40%, transparent);
    box-shadow:
      0 6px 20px color-mix(in oklch, var(--_glow) 65%, transparent),
      0 0 40px color-mix(in oklch, var(--_glow) 30%, transparent);
  }

  /* Hover — dark mode: full bioluminescent glow */
  .glow-card--dark:hover .glow-card__body {
    box-shadow:
      inset 0 0 40px color-mix(in oklch, var(--_glow) 10%, transparent),
      0 0 30px color-mix(in oklch, var(--_glow) 15%, transparent);
    border-color: color-mix(in oklch, var(--_glow) 50%, transparent);
  }

  /* ── Dark variant — glass so glow bleeds through ── */
  .glow-card--dark .glow-card__body {
    background: color-mix(in oklch, var(--brand-c-bg-dark) 60%, transparent);
    backdrop-filter: blur(20px) saturate(1.3);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    border-color: color-mix(in oklch, var(--_glow) 18%, transparent);
    color: var(--brand-c-bg);
  }

  /* ── Grid texture overlay ── */
  .glow-card--grid .glow-card__body::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background-image:
      linear-gradient(color-mix(in oklch, var(--_glow) 4%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklch, var(--_glow) 4%, transparent) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.5;
    z-index: 0;
  }

  /* ── Typography ── */
  .glow-card__title {
    margin: 0 0 var(--space-md);
    font-family: var(--font-heading);
    font-weight: var(--font-bold);
    font-size: var(--font-size-xl);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: inherit;
    position: relative;
    z-index: 1;
  }

  .glow-card__text {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: inherit;
    opacity: 0.85;
    position: relative;
    z-index: 1;
  }

  .glow-card--dark .glow-card__title {
    color: var(--brand-c-bg);
  }

  .glow-card--dark .glow-card__text {
    color: var(--brand-c-neutral-light);
  }

  /* ── Decoration icons ── */
  .glow-card__deco {
    position: absolute;
    width: var(--_deco-size, 120px);
    height: var(--_deco-size, 120px);
    pointer-events: none;
    z-index: 1;
    color: var(--_glow);
    opacity: 0;
    transition: opacity 0.5s ease, filter 0.6s ease;
    filter: drop-shadow(0 0 0px transparent);
  }

  /* Override Icon stroke-width for decoration scale */
  .glow-card__deco :global(svg path),
  .glow-card__deco :global(svg circle),
  .glow-card__deco :global(svg polygon),
  .glow-card__deco :global(svg polyline) {
    stroke-width: var(--_stroke-w, 10);
  }

  /* Show on hover — light mode: soft single glow so glass picks it up */
  .glow-card:not(.glow-card--dark):hover .glow-card__deco,
  .glow-card:not(.glow-card--dark):focus-within .glow-card__deco {
    opacity: 0.8;
    filter: drop-shadow(0 0 18px var(--_glow));
  }

  /* Show + glow on hover — dark mode: full bioluminescent glow */
  .glow-card--dark:hover .glow-card__deco,
  .glow-card--dark:focus-within .glow-card__deco {
    opacity: 1;
    filter:
      drop-shadow(0 0 4px var(--_glow))
      drop-shadow(0 0 12px var(--_glow))
      drop-shadow(0 0 24px color-mix(in oklch, var(--_glow) 50%, transparent));
  }

  /* ── Position classes — half-in, half-out ── */
  .glow-card__deco--top-left {
    top: 0;
    left: 0;
    transform: translate(-40%, -40%);
  }

  .glow-card__deco--top-right {
    top: 0;
    right: 0;
    transform: translate(40%, -40%);
  }

  .glow-card__deco--bottom-left {
    bottom: 0;
    left: 0;
    transform: translate(-40%, 40%);
  }

  .glow-card__deco--bottom-right {
    bottom: 0;
    right: 0;
    transform: translate(40%, 40%);
  }

  .glow-card__deco--left {
    top: 50%;
    left: 0;
    transform: translate(-50%, -50%);
  }

  .glow-card__deco--right {
    top: 50%;
    right: 0;
    transform: translate(50%, -50%);
  }

  /* ── Reduced motion: show icons statically, no draw ── */
  @media (prefers-reduced-motion: reduce) {
    .glow-card__deco {
      opacity: 0.4;
      transition: none;
    }

    .glow-card:hover .glow-card__deco {
      opacity: 0.7;
      filter: none;
    }

    .glow-card__body {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';
  import { MorphSVGPlugin } from 'gsap/MorphSVGPlugin';

  gsap.registerPlugin(DrawSVGPlugin, MorphSVGPlugin);

  function prefersReducedMotion(): boolean {
    const wrapper = document.querySelector('#a11y-content-wrapper');
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      wrapper?.classList.contains('a11y-reduce-motion') === true ||
      wrapper?.classList.contains('a11y-text-only') === true;
  }

  interface DecoData {
    el: HTMLElement;
    paths: SVGGeometryElement[];
    morphTargetPaths: string[];
    originalPaths: string[];
  }

  function initGlowCards() {
    if (prefersReducedMotion()) return;

    document.querySelectorAll<HTMLElement>('[data-glow-card]:not([data-glow-bound])').forEach(card => {
      card.setAttribute('data-glow-bound', '1');

      const variant = (card.dataset.glowVariant || 'draw') as 'draw' | 'drawcenter' | 'pulse';
      const decoEls = card.querySelectorAll<HTMLElement>('[data-glow-deco]');
      const allDecos: DecoData[] = [];

      decoEls.forEach(deco => {
        const paths = Array.from(
          deco.querySelectorAll<SVGGeometryElement>('path, circle, polygon, polyline')
        ).filter(p => p.tagName.toLowerCase() !== 'rect');

        if (!paths.length) return;

        // Set initial draw state — hidden
        paths.forEach(p => {
          gsap.set(p, { drawSVG: '0%' });
        });

        // Parse morph targets if present
        const morphHTML = deco.dataset.glowMorph;
        let morphTargetPaths: string[] = [];
        if (morphHTML) {
          const temp = document.createElement('div');
          temp.innerHTML = morphHTML;
          morphTargetPaths = Array.from(temp.querySelectorAll('path'))
            .map(p => p.getAttribute('d') || '')
            .filter(Boolean);
        }

        // Store original path data for morph revert
        const originalPaths = paths.map(p => p.getAttribute('d') || '');

        allDecos.push({ el: deco, paths, morphTargetPaths, originalPaths });
      });

      if (!allDecos.length) return;

      let activeTl: gsap.core.Timeline | null = null;

      card.addEventListener('mouseenter', () => {
        if (activeTl) activeTl.kill();
        activeTl = gsap.timeline();

        let pathIndex = 0;
        allDecos.forEach(({ paths, morphTargetPaths }) => {
          paths.forEach((p, i) => {
            const stagger = pathIndex * 0.06;

            // Draw animation
            switch (variant) {
              case 'drawcenter':
                activeTl!.fromTo(p,
                  { drawSVG: '50% 50%' },
                  { drawSVG: '0% 100%', duration: 0.8, ease: 'power2.inOut' },
                  stagger);
                break;
              case 'pulse':
                activeTl!.fromTo(p,
                  { drawSVG: '0%', strokeWidth: 14 },
                  { drawSVG: '100%', duration: 0.4, ease: 'power2.out' },
                  stagger)
                  .to(p, { strokeWidth: 10, duration: 0.4 }, stagger + 0.4);
                break;
              default: // 'draw'
                activeTl!.fromTo(p,
                  { drawSVG: '0%' },
                  { drawSVG: '100%', duration: 0.8, ease: 'power2.inOut' },
                  stagger);
                break;
            }

            // Morph animation (after draw starts)
            if (morphTargetPaths[i]) {
              activeTl!.to(p, {
                morphSVG: { shape: morphTargetPaths[i], type: 'rotational' },
                duration: 0.6,
                ease: 'power2.inOut',
              }, stagger + 0.4);
            }

            pathIndex++;
          });
        });
      });

      card.addEventListener('mouseleave', () => {
        if (activeTl) activeTl.kill();
        activeTl = gsap.timeline();

        allDecos.forEach(({ paths, originalPaths, morphTargetPaths }) => {
          paths.forEach((p, i) => {
            // Revert morph first
            if (morphTargetPaths[i] && originalPaths[i]) {
              activeTl!.to(p, {
                morphSVG: { shape: originalPaths[i], type: 'rotational' },
                duration: 0.3,
                ease: 'power2.inOut',
              }, 0);
            }

            // Retract draw
            activeTl!.to(p, {
              drawSVG: '0%',
              duration: 0.4,
              ease: 'power2.inOut',
            }, 0);
          });
        });
      });

      // IntersectionObserver fallback for touch/mobile — draw on scroll into view
      if ('IntersectionObserver' in window && 'ontouchstart' in window) {
        const osViewport = document.querySelector<HTMLElement>('[data-overlayscrollbars-viewport]');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              card.dispatchEvent(new MouseEvent('mouseenter'));
              observer.disconnect();
            }
          });
        }, { root: osViewport || null, threshold: 0.5 });
        observer.observe(card);
      }
    });
  }

  initGlowCards();
  document.addEventListener('astro:page-load', initGlowCards);
</script>
