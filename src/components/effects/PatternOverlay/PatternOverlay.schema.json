{
  "component": "PatternOverlay",
  "category": "atoms/effects",
  "renders": {
    "base": "PatternOverlay.astro"
  },
  "props": {
    "preset":      { "type": "string",  "required": false, "default": null },
    "icon":        { "type": "string",  "required": false, "default": null },
    "iconWeight":  { "type": "string",  "required": false, "default": "thin" },
    "icons":       { "type": "array",   "required": false, "default": null },
    "smil":        { "type": "array",   "required": false, "default": null },
    "image":       { "type": "string",  "required": false, "default": null },
    "opacity":     { "type": "number",  "required": false, "default": null },
    "angle":       { "type": "number",  "required": false, "default": 0 },
    "scale":       { "type": "number",  "required": false, "default": 60 },
    "color":       { "type": "string",  "required": false, "default": "var(--scroll-pattern-color, currentColor)" },
    "blend":       { "type": "string",  "required": false, "default": "normal" },
    "spacing":     { "type": "number",  "required": false, "default": 0 },
    "interactive": { "type": "boolean", "required": false, "default": false },
    "magnetic":    { "type": "boolean", "required": false, "default": false },
    "scrollColor": { "type": "string",  "required": false, "default": null },
    "scrollReveal":{ "type": "string",  "required": false, "default": null },
    "fallback":    { "type": "string",  "required": false, "default": "none" },
    "class":       { "type": "string",  "required": false, "default": "" }
  }
}
