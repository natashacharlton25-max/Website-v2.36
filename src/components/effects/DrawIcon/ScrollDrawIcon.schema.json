{
  "component": "ScrollDrawIcon",
  "category": "atoms/effects",
  "renders": {
    "base": "ScrollDrawIcon.astro"
  },
  "props": {
    "name":        { "type": "string",  "required": true },
    "variant":     { "type": "string",  "required": false, "default": "draw", "enum": ["draw", "drawcenter", "chachaslide", "flashgordon", "rainbowchase", "pulse"] },
    "size":        { "type": "number",  "required": false, "default": 120 },
    "scrub":       { "type": "boolean", "required": false, "default": false },
    "start":       { "type": "string",  "required": false, "default": "top 90%" },
    "end":         { "type": "string",  "required": false, "default": "top 20%" },
    "color":       { "type": "string",  "required": false },
    "strokeWidth": { "type": "number",  "required": false },
    "repeat":      { "type": "boolean", "required": false, "default": false },
    "class":       { "type": "string",  "required": false, "default": "" }
  }
}
