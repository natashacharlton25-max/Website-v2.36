---
import type { ReaderNavSection } from '../../lib/config/reader-types';
import '../../styles/components/presentation/ReaderNav.css';
import Icon from '../Icons/Icon.astro';
import LottieIcon from '../Icons/LottieIcon.astro';

interface Props {
  sections: ReaderNavSection[];
  position?:
    | 'top-left'
    | 'top-center'
    | 'top-right'
    | 'middle-left'
    | 'middle-center'
    | 'middle-right'
    | 'bottom-left'
    | 'bottom-center'
    | 'bottom-right';
  variant?: 'minimal' | 'detailed';
  background?: 'dark' | 'light' | 'glass';
  foreground?: 'light' | 'dark';
  autoplayInterval?: number; // seconds between sections in autoplay mode
}

const {
  sections,
  position = 'top-left',
  variant = 'detailed',
  background = 'glass',
  foreground = 'light',
  autoplayInterval = 5,
} = Astro.props;
---

<nav
  class={`reader-nav reader-nav--${position} reader-nav--${variant} reader-nav--bg-${background} reader-nav--fg-${foreground} reader-nav--minimized`}
  data-reader-nav
  data-autoplay-interval={autoplayInterval}
  data-view-state="minimized"
  aria-label="Reader navigation"
>
  <div class="reader-nav-container">
    {/* Row 1: Menu button + Autoplay (medium/expanded only) */}
    <div class="nav-row nav-row--top">
      <button
        type="button"
        class="nav-menu-btn"
        data-menu-toggle
        aria-label="Toggle navigation menu"
        title="Menu"
      >
        <LottieIcon
          src="/Icons/Animated Icons/Menu V2/menuV2.json"
          size={28}
          id="reader-nav-menu-icon"
          class="menu-icon-hamburger"
        />
        <LottieIcon
          src="/Icons/Animated Icons/Plus to X/plusToX.json"
          size={28}
          id="reader-nav-plus-icon"
          class="menu-icon-plus"
        />
      </button>

      <button
        type="button"
        class="autoplay-btn"
        data-autoplay-toggle
        aria-label="Toggle autoplay"
        title="Autoplay (A)"
      >
        <span class="autoplay-label" data-autoplay-label>Autoplay</span>
        <svg class="icon-play" viewBox="0 0 256 256" width="10" height="10" fill="currentColor">
          <path d="M232.4,114.49,88.32,26.35a16,16,0,0,0-16.2-.3A15.86,15.86,0,0,0,64,39.87V216.13A15.94,15.94,0,0,0,80,232a16.07,16.07,0,0,0,8.36-2.35L232.4,141.51a15.81,15.81,0,0,0,0-27Z"/>
        </svg>
        <svg class="icon-pause" viewBox="0 0 256 256" width="10" height="10" fill="currentColor" style="display:none;">
          <path d="M216,48V208a16,16,0,0,1-16,16H160a16,16,0,0,1-16-16V48a16,16,0,0,1,16-16h40A16,16,0,0,1,216,48ZM96,32H56A16,16,0,0,0,40,48V208a16,16,0,0,0,16,16H96a16,16,0,0,0,16-16V48A16,16,0,0,0,96,32Z"/>
        </svg>
      </button>
    </div>

    {/* Row 2: Progress circle + Section name */}
    <div class="nav-row nav-row--main">
      <div class="progress-circle-wrapper" data-progress-wrapper>
        <svg
          class="progress-circle"
          width="50"
          height="50"
          viewBox="0 0 50 50"
          aria-hidden="true"
        >
          <circle
            cx="25"
            cy="25"
            r="22"
            class="progress-bg"
            stroke="var(--color-Neutral-300)"
            stroke-width="3"
            fill="none"
          />
          <circle
            cx="25"
            cy="25"
            r="22"
            class="progress-bar"
            stroke="var(--color-Primary-500)"
            stroke-width="3"
            fill="none"
            stroke-linecap="round"
            data-progress-circle
          />
        </svg>
        <div class="progress-percentage" aria-live="polite" aria-atomic="true">
          <span data-percentage>0</span>%
        </div>
      </div>

      {
        variant === 'detailed' && (
          <button
            type="button"
            class="nav-toggle"
            data-nav-toggle
            aria-expanded="false"
            aria-controls="section-dropdown"
            aria-label="Toggle section menu"
          >
            <span class="current-section-title" data-current-title>
              Title
            </span>
          </button>
        )
      }
    </div>

    {/* Row 3: Prev/Next buttons (expanded only) */}
    <div class="nav-row nav-row--controls">
      <button
        type="button"
        class="nav-arrow nav-arrow--prev"
        data-nav-prev
        aria-label="Previous section"
        disabled
      >
        <Icon name="caret-left-fill" size={10} />
        <span>Prev</span>
      </button>

      <button
        type="button"
        class="nav-arrow nav-arrow--next"
        data-nav-next
        aria-label="Next section"
      >
        <span>Next</span>
        <Icon name="caret-right-fill" size={10} />
      </button>
    </div>

    {/* Row 4: Speed slider (expanded only) */}
    <div class="nav-row nav-row--speed" data-speed-dropdown>
      <span class="speed-label" data-speed-value>{autoplayInterval} Sec</span>
      <input
        type="range"
        class="speed-slider"
        data-speed-slider
        min="2"
        max="15"
        value={autoplayInterval}
        step="1"
        aria-label="Autoplay speed in seconds"
      />
    </div>

    {/* Autoplay timer bar (hidden by default) */}
    <div class="autoplay-timer" data-autoplay-timer>
      <div class="autoplay-timer__bar" data-autoplay-timer-bar></div>
    </div>

    {/* Section dropdown (expanded only) */}
    {
      variant === 'detailed' && (
        <div
          class="section-dropdown"
          id="section-dropdown"
          data-dropdown
          role="menu"
        >
          <ul class="section-list">
            {sections.map((section, index) => {
              const isFirst = index === 0;
              const isEnd = section.id === 'end';
              const displayTitle = isFirst ? 'Title' : (isEnd ? 'Finish' : section.title);

              return (
                <li role="none">
                  <button
                    type="button"
                    class="section-item"
                    data-section-nav={section.id}
                    data-section-index={index}
                    data-display-title={displayTitle}
                    role="menuitem"
                    aria-label={`Navigate to ${displayTitle}`}
                  >
                    <span class="section-name">{displayTitle}</span>
                  </button>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }
  </div>
</nav>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  type ViewState = 'minimized' | 'medium' | 'expanded';

  class ReaderNav {
    nav: HTMLElement;
    progressCircle: SVGCircleElement;
    progressText: HTMLElement;
    currentTitleEl: HTMLElement | null;
    toggleBtn: HTMLElement | null;
    dropdown: HTMLElement | null;
    sectionButtons: NodeListOf<HTMLElement>;
    prevBtn: HTMLButtonElement | null;
    nextBtn: HTMLButtonElement | null;
    autoplayBtn: HTMLButtonElement | null;
    autoplayTimer: HTMLElement | null;
    autoplayTimerBar: HTMLElement | null;
    speedDropdown: HTMLElement | null;
    speedSlider: HTMLInputElement | null;
    speedValue: HTMLElement | null;

    isOpen = false;
    isSpeedOpen = false;
    circumference = 138.23; // 2 * π * 22 (updated for r=22)
    sections: Array<{ id: string; title: string; displayTitle: string; element: HTMLElement | null }> = [];
    currentIndex = 0;

    // Autoplay state
    isAutoplay = false;
    autoplayInterval: number;
    autoplayTimeout: number | null = null;

    // Menu toggle button and view state
    menuBtn: HTMLButtonElement | null;
    menuIcon: HTMLElement | null;
    plusIcon: HTMLElement | null;
    viewState: ViewState = 'minimized';

    constructor(nav: HTMLElement) {
      console.log('[ReaderNav] Constructor called');
      this.nav = nav;
      this.progressCircle = nav.querySelector('[data-progress-circle]') as SVGCircleElement;
      this.progressText = nav.querySelector('[data-percentage]') as HTMLElement;
      this.currentTitleEl = nav.querySelector('[data-current-title]');
      this.toggleBtn = nav.querySelector('[data-nav-toggle]');
      this.dropdown = nav.querySelector('[data-dropdown]');
      this.sectionButtons = nav.querySelectorAll('[data-section-nav]');
      this.prevBtn = nav.querySelector('[data-nav-prev]');
      this.nextBtn = nav.querySelector('[data-nav-next]');
      this.autoplayBtn = nav.querySelector('[data-autoplay-toggle]');
      this.autoplayTimer = nav.querySelector('[data-autoplay-timer]');
      this.autoplayTimerBar = nav.querySelector('[data-autoplay-timer-bar]');
      this.speedDropdown = nav.querySelector('[data-speed-dropdown]');
      this.speedSlider = nav.querySelector('[data-speed-slider]');
      this.speedValue = nav.querySelector('[data-speed-value]');
      this.menuBtn = nav.querySelector('[data-menu-toggle]');
      this.menuIcon = nav.querySelector('#reader-nav-menu-icon');
      this.plusIcon = nav.querySelector('#reader-nav-plus-icon');

      console.log('[ReaderNav] autoplayBtn found:', this.autoplayBtn);

      // Get autoplay interval from data attribute (seconds -> ms)
      this.autoplayInterval = (parseInt(nav.dataset.autoplayInterval || '5', 10)) * 1000;

      // Get initial view state from data attribute
      this.viewState = (nav.dataset.viewState as ViewState) || 'minimized';

      this.init();
    }

    init(): void {
      // Build sections array with display titles
      this.sectionButtons.forEach((btn) => {
        const id = btn.dataset.sectionNav;
        const title = btn.querySelector('.section-name')?.textContent || '';
        const displayTitle = btn.dataset.displayTitle || title;
        const element = id ? document.getElementById(`section-${id}`) : null;

        if (id) {
          this.sections.push({ id, title, displayTitle, element });
        }
      });

      // Set initial progress
      this.updateProgress(0);

      // Initialize prev/next button states
      this.updateNavButtonStates();

      // Setup glide in/out animation
      this.setupGlideAnimation();

      // Toggle dropdown
      this.toggleBtn?.addEventListener('click', () => this.toggleDropdown());

      // Section navigation
      this.sectionButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const sectionId = btn.dataset.sectionNav;
          if (sectionId) {
            this.navigateToSection(sectionId);
          }
        });
      });

      // Prev/Next button navigation
      this.prevBtn?.addEventListener('click', () => this.goToPrevSection());
      this.nextBtn?.addEventListener('click', () => this.goToNextSection());

      // Autoplay toggle
      this.autoplayBtn?.addEventListener('click', () => {
        console.log('[ReaderNav] Autoplay button clicked');
        this.toggleAutoplay();
      });

      // Speed slider change
      this.speedSlider?.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        const seconds = parseInt(target.value, 10);
        this.autoplayInterval = seconds * 1000;
        if (this.speedValue) {
          this.speedValue.textContent = `${seconds} Sec`;
        }
        // Reset timer with new interval if autoplay is active
        if (this.isAutoplay) {
          this.resetAutoplayTimer();
        }
      });

      // Menu toggle - cycles through view states with Lottie animation
      // If autoplay is active, clicking menu stops autoplay and restores navs
      this.menuBtn?.addEventListener('click', () => {
        if (this.isAutoplay) {
          this.stopAutoplay();
        } else {
          this.cycleViewState();
        }
      });

      // Listen to reader progress events
      window.addEventListener('reader:progress', ((e: CustomEvent) => {
        const { index, totalProgress } = e.detail;

        // Display RAW progress (0-100%)
        this.updateProgress(totalProgress);

        // Use the index directly from Reader (no offset)
        this.updateActiveSection(index);
      }) as EventListener);

      // Close dropdown on outside click
      document.addEventListener('click', (e) => {
        if (!this.nav.contains(e.target as Node)) {
          this.closeDropdown();
        }
      });

      // Keyboard navigation - global, capture phase
      document.addEventListener('keydown', (e) => this.handleKeydown(e), true);
    }

    handleKeydown(e: KeyboardEvent): void {
      // Skip if in input field
      const target = e.target as HTMLElement;
      if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable) {
        return;
      }

      // Check if we're in the reader area
      const readerWrapper = document.querySelector('[data-reader-wrapper]');
      if (!readerWrapper) return;

      const rect = readerWrapper.getBoundingClientRect();
      const isInReaderArea = rect.top < window.innerHeight && rect.bottom > 0;

      if (!isInReaderArea) return;

      switch (e.key) {
        case ' ':  // Spacebar - advance to next section
          e.preventDefault();
          e.stopPropagation();
          this.goToNextSection();
          break;

        case 'ArrowRight':
        case 'ArrowDown':
          e.preventDefault();
          e.stopPropagation();
          this.goToNextSection();
          break;

        case 'ArrowLeft':
        case 'ArrowUp':
          e.preventDefault();
          e.stopPropagation();
          this.goToPrevSection();
          break;

        case 'a':
        case 'A':  // A key toggles autoplay
          e.preventDefault();
          e.stopPropagation();
          this.toggleAutoplay();
          break;
      }
    }

    updateProgress(percentage: number): void {
      const offset = this.circumference - (percentage / 100) * this.circumference;
      this.progressCircle.style.strokeDashoffset = offset.toString();
      this.progressText.textContent = Math.round(percentage).toString();
    }

    updateActiveSection(index: number): void {
      this.currentIndex = index;
      const section = this.sections[index];

      if (section && this.currentTitleEl) {
        // Use displayTitle for the nav (Title, Finish, etc.)
        this.currentTitleEl.textContent = section.displayTitle;
      }

      // Update active states in dropdown
      this.sectionButtons.forEach((btn, i) => {
        if (i === index) {
          btn.classList.add('is-active');
        } else {
          btn.classList.remove('is-active');
        }
      });

      // Update prev/next button states
      this.updateNavButtonStates();

      // Reset autoplay timer when section changes
      if (this.isAutoplay) {
        this.resetAutoplayTimer();
      }
    }

    updateNavButtonStates(): void {
      const isFirst = this.currentIndex === 0;
      const isLast = this.currentIndex === this.sections.length - 1;

      if (this.prevBtn) {
        this.prevBtn.disabled = isFirst;
      }
      if (this.nextBtn) {
        this.nextBtn.disabled = isLast;
      }
    }

    goToPrevSection(): void {
      if (this.currentIndex > 0) {
        const prevSection = this.sections[this.currentIndex - 1];
        if (prevSection) {
          this.navigateToSection(prevSection.id);
        }
      }
    }

    goToNextSection(): void {
      if (this.currentIndex < this.sections.length - 1) {
        const nextSection = this.sections[this.currentIndex + 1];
        if (nextSection) {
          this.navigateToSection(nextSection.id);
        }
      } else if (this.isAutoplay) {
        // At the end with autoplay - stop autoplay
        this.stopAutoplay();
      }
    }

    navigateToSection(sectionId: string): void {
      // Find the section index
      const sectionIndex = this.sections.findIndex(s => s.id === sectionId);

      if (sectionIndex === -1) {
        this.closeDropdown();
        return;
      }

      // Find the Reader wrapper
      const readerWrapper = document.querySelector('[data-reader-wrapper]') as HTMLElement;
      if (!readerWrapper) {
        this.closeDropdown();
        return;
      }

      // Calculate scroll position to activate this section
      const totalSections = this.sections.length;
      const targetProgress = totalSections > 1 ? sectionIndex / (totalSections - 1) : 0;

      // Total scroll distance for the Reader
      const totalScrollHeight = totalSections * window.innerHeight * 1.5;

      // Calculate scroll position
      const wrapperTop = readerWrapper.offsetTop;
      const targetScrollPosition = wrapperTop + (targetProgress * totalScrollHeight);

      // Smooth scroll to calculated position
      window.scrollTo({
        top: targetScrollPosition,
        behavior: 'smooth'
      });

      this.closeDropdown();
    }

    // Autoplay methods
    toggleAutoplay(): void {
      console.log('[ReaderNav] toggleAutoplay called, isAutoplay:', this.isAutoplay);
      if (this.isAutoplay) {
        this.stopAutoplay();
      } else {
        this.startAutoplay();
      }
    }

    startAutoplay(): void {
      console.log('[ReaderNav] startAutoplay called');
      this.isAutoplay = true;
      this.autoplayBtn?.classList.add('is-active');

      // Toggle icons
      const playIcon = this.autoplayBtn?.querySelector('.icon-play') as HTMLElement;
      const pauseIcon = this.autoplayBtn?.querySelector('.icon-pause') as HTMLElement;
      if (playIcon) playIcon.style.display = 'none';
      if (pauseIcon) pauseIcon.style.display = 'block';

      // Show timer
      if (this.autoplayTimer) {
        this.autoplayTimer.classList.add('is-active');
      }

      // Enter immersive mode
      this.enterImmersiveMode();

      this.resetAutoplayTimer();
      console.log('[ReaderNav] startAutoplay complete, timer started');
    }

    stopAutoplay(): void {
      this.isAutoplay = false;
      this.autoplayBtn?.classList.remove('is-active');

      // Toggle icons
      const playIcon = this.autoplayBtn?.querySelector('.icon-play') as HTMLElement;
      const pauseIcon = this.autoplayBtn?.querySelector('.icon-pause') as HTMLElement;
      if (playIcon) playIcon.style.display = 'block';
      if (pauseIcon) pauseIcon.style.display = 'none';

      // Hide timer
      if (this.autoplayTimer) {
        this.autoplayTimer.classList.remove('is-active');
      }

      if (this.autoplayTimeout) {
        clearTimeout(this.autoplayTimeout);
        this.autoplayTimeout = null;
      }

      // Reset timer bar
      if (this.autoplayTimerBar) {
        gsap.killTweensOf(this.autoplayTimerBar);
        this.autoplayTimerBar.style.width = '0%';
      }

      // Exit immersive mode
      this.exitImmersiveMode();
    }

    // Immersive mode - hides distracting UI elements for autoplay
    enterImmersiveMode(): void {
      console.log('[ReaderNav] enterImmersiveMode called');

      // Hide main navigation bar (GlassNav)
      const mainNav = document.getElementById('main-nav');
      console.log('[ReaderNav] mainNav element:', mainNav);
      if (mainNav) {
        mainNav.classList.add('nav-hidden');
        mainNav.setAttribute('data-immersive-hidden', 'true');
        console.log('[ReaderNav] GlassNav hidden');
      }

      // Hide side tabs
      const sideTabs = document.querySelector('.side-tabs') as HTMLElement;
      console.log('[ReaderNav] sideTabs element:', sideTabs);
      if (sideTabs) {
        sideTabs.style.display = 'none';
        sideTabs.setAttribute('data-immersive-hidden', 'true');
        console.log('[ReaderNav] SideTabs hidden');
      }

      // Auto-minimize the presentation nav (keep it visible but compact)
      this.setViewState('minimized');

      // Close accessibility panel if open
      const a11yPanel = document.getElementById('a11y-panel');
      const a11yBackdrop = document.querySelector('.a11y-panel__backdrop') as HTMLElement;
      if (a11yPanel?.classList.contains('is-open')) {
        a11yPanel.classList.remove('is-open');
        a11yPanel.setAttribute('hidden', '');
        a11yBackdrop?.classList.remove('is-visible');
        a11yBackdrop?.setAttribute('hidden', '');
      }
      console.log('[ReaderNav] enterImmersiveMode complete');
    }

    exitImmersiveMode(): void {
      // Show main navigation bar
      const mainNav = document.getElementById('main-nav');
      if (mainNav?.getAttribute('data-immersive-hidden') === 'true') {
        mainNav.classList.remove('nav-hidden');
        mainNav.removeAttribute('data-immersive-hidden');
      }

      // Show side tabs
      const sideTabs = document.querySelector('.side-tabs') as HTMLElement;
      if (sideTabs?.getAttribute('data-immersive-hidden') === 'true') {
        sideTabs.style.display = '';
        sideTabs.removeAttribute('data-immersive-hidden');
      }
    }

    resetAutoplayTimer(): void {
      if (!this.isAutoplay) return;

      // Clear existing timer
      if (this.autoplayTimeout) {
        clearTimeout(this.autoplayTimeout);
      }

      // Reset and animate timer bar
      if (this.autoplayTimerBar) {
        gsap.killTweensOf(this.autoplayTimerBar);
        gsap.fromTo(this.autoplayTimerBar,
          { width: '0%' },
          {
            width: '100%',
            duration: this.autoplayInterval / 1000,
            ease: 'linear'
          }
        );
      }

      // Set timer to advance section
      this.autoplayTimeout = window.setTimeout(() => {
        this.goToNextSection();
      }, this.autoplayInterval);
    }

    toggleDropdown(): void {
      if (this.isOpen) {
        this.closeDropdown();
      } else {
        this.openDropdown();
      }
    }

    openDropdown(): void {
      this.isOpen = true;
      this.dropdown?.classList.add('is-open');
      this.toggleBtn?.setAttribute('aria-expanded', 'true');

      // Focus first menu item
      const firstItem = this.dropdown?.querySelector('.section-item') as HTMLElement;
      firstItem?.focus();
    }

    closeDropdown(): void {
      this.isOpen = false;
      this.dropdown?.classList.remove('is-open');
      this.toggleBtn?.setAttribute('aria-expanded', 'false');
    }

    // Speed dropdown methods
    openSpeedDropdown(): void {
      this.isSpeedOpen = true;
      this.speedDropdown?.classList.add('is-open');
    }

    closeSpeedDropdown(): void {
      this.isSpeedOpen = false;
      this.speedDropdown?.classList.remove('is-open');
    }

    // View state cycling: minimized -> medium -> expanded -> minimized
    cycleViewState(): void {
      const states: ViewState[] = ['minimized', 'medium', 'expanded'];
      const currentIndex = states.indexOf(this.viewState);
      const nextIndex = (currentIndex + 1) % states.length;
      const nextState = states[nextIndex];

      this.setViewState(nextState);
    }

    setViewState(newState: ViewState): void {
      const oldState = this.viewState;
      this.viewState = newState;

      // Animate Lottie icons with proper timing and CSS transitions
      // Animation flow: Hamburger (minimized) -> Plus (medium) -> X (expanded)
      // Uses Menu V2 for hamburger->plus (with rotation), Plus to X for plus->X

      if (oldState === 'minimized' && newState === 'medium') {
        // minimized -> medium: Hamburger to Plus
        // Play Menu V2 forward (hamburger to X), then CSS rotates it 45° to appear as plus
        if (this.menuIcon) {
          this.menuIcon.dispatchEvent(new CustomEvent('lottie:play'));
        }
        // Update classes immediately to apply rotation
        this.nav.classList.remove('reader-nav--minimized', 'reader-nav--medium', 'reader-nav--expanded');
        this.nav.classList.add(`reader-nav--${newState}`);
        this.nav.dataset.viewState = newState;

      } else if (oldState === 'medium' && newState === 'expanded') {
        // medium -> expanded: Plus to X
        // First update CSS to switch from menuIcon to plusIcon
        this.nav.classList.remove('reader-nav--minimized', 'reader-nav--medium', 'reader-nav--expanded');
        this.nav.classList.add(`reader-nav--${newState}`);
        this.nav.dataset.viewState = newState;

        // Then animate plusIcon after CSS transition
        setTimeout(() => {
          if (this.plusIcon) {
            this.plusIcon.dispatchEvent(new CustomEvent('lottie:goToFrame', { detail: { frame: 0 } }));
            setTimeout(() => {
              this.plusIcon?.dispatchEvent(new CustomEvent('lottie:play'));
            }, 50);
          }
        }, 100);

      } else if (oldState === 'expanded' && newState === 'medium') {
        // expanded -> medium: X to Plus
        // Play Plus to X in reverse, then switch to menuIcon
        if (this.plusIcon) {
          this.plusIcon.dispatchEvent(new CustomEvent('lottie:playReverse'));
        }
        // Wait for animation to complete, then switch CSS
        setTimeout(() => {
          this.nav.classList.remove('reader-nav--minimized', 'reader-nav--medium', 'reader-nav--expanded');
          this.nav.classList.add(`reader-nav--${newState}`);
          this.nav.dataset.viewState = newState;
        }, 500);

      } else if (oldState === 'medium' && newState === 'minimized') {
        // medium -> minimized: Plus to Hamburger
        // Play Menu V2 in reverse (X to hamburger), rotation removed by CSS
        if (this.menuIcon) {
          this.menuIcon.dispatchEvent(new CustomEvent('lottie:playReverse'));
        }
        // Update classes immediately to remove rotation
        this.nav.classList.remove('reader-nav--minimized', 'reader-nav--medium', 'reader-nav--expanded');
        this.nav.classList.add(`reader-nav--${newState}`);
        this.nav.dataset.viewState = newState;

      } else if (oldState === 'expanded' && newState === 'minimized') {
        // expanded -> minimized: This shouldn't happen with cycling
        if (this.plusIcon) {
          this.plusIcon.dispatchEvent(new CustomEvent('lottie:playReverse'));
        }
        setTimeout(() => {
          this.nav.classList.remove('reader-nav--minimized', 'reader-nav--medium', 'reader-nav--expanded');
          this.nav.classList.add('reader-nav--medium');
          this.nav.dataset.viewState = 'medium';

          if (this.menuIcon) {
            this.menuIcon.dispatchEvent(new CustomEvent('lottie:playReverse'));
          }

          setTimeout(() => {
            this.nav.classList.remove('reader-nav--medium');
            this.nav.classList.add(`reader-nav--${newState}`);
            this.nav.dataset.viewState = newState;
          }, 1000);
        }, 500);

      } else if (oldState === 'minimized' && newState === 'expanded') {
        // minimized -> expanded: This shouldn't happen with cycling
        if (this.menuIcon) {
          this.menuIcon.dispatchEvent(new CustomEvent('lottie:play'));
        }
        this.nav.classList.remove('reader-nav--minimized', 'reader-nav--medium', 'reader-nav--expanded');
        this.nav.classList.add('reader-nav--medium');
        this.nav.dataset.viewState = 'medium';

        setTimeout(() => {
          this.nav.classList.remove('reader-nav--medium');
          this.nav.classList.add(`reader-nav--${newState}`);
          this.nav.dataset.viewState = newState;

          if (this.plusIcon) {
            this.plusIcon.dispatchEvent(new CustomEvent('lottie:goToFrame', { detail: { frame: 0 } }));
            setTimeout(() => {
              this.plusIcon?.dispatchEvent(new CustomEvent('lottie:play'));
            }, 50);
          }
        }, 1000);
      } else {
        // Default: just update classes
        this.nav.classList.remove('reader-nav--minimized', 'reader-nav--medium', 'reader-nav--expanded');
        this.nav.classList.add(`reader-nav--${newState}`);
        this.nav.dataset.viewState = newState;
      }

      // Handle state-specific behaviors
      if (newState === 'minimized') {
        // Close dropdowns when minimized (but don't stop autoplay - it uses minimized state)
        this.closeDropdown();
        this.closeSpeedDropdown();
      } else if (newState === 'expanded') {
        // In expanded state, dropdown is pinned open via CSS
        this.toggleBtn?.setAttribute('aria-expanded', 'true');
      } else if (newState === 'medium') {
        // In medium state, dropdown is controlled by toggle
        this.closeDropdown();
      }

      // Update button aria labels
      if (this.menuBtn) {
        const labels: Record<ViewState, string> = {
          minimized: 'Expand navigation',
          medium: 'Show all sections',
          expanded: 'Minimize navigation',
        };
        this.menuBtn.setAttribute('aria-label', labels[newState]);
      }
    }

    setupGlideAnimation(): void {
      // Determine glide direction based on position class
      const position = Array.from(this.nav.classList)
        .find((cls) => cls.startsWith('reader-nav--'))
        ?.replace('reader-nav--', '');

      // Set initial hidden state based on position (horizontal only)
      let initialX = 0;
      let initialY = 0; // No vertical glide

      if (position?.includes('left')) {
        initialX = -100; // Glide in from left
      } else if (position?.includes('right')) {
        initialX = 100; // Glide in from right
      }
      // Center positions don't glide horizontally

      // Animate the container to avoid transform conflicts with fixed positioning
      const container = this.nav.querySelector('.reader-nav-container') as HTMLElement;
      if (!container) return;

      // Set initial hidden state immediately
      gsap.set(container, {
        opacity: 0,
        x: initialX,
        y: initialY,
      });

      // Wait for Reader wrapper to be in DOM
      const waitForWrapper = () => {
        const readerWrapper = document.querySelector('[data-reader-wrapper]');
        if (!readerWrapper) {
          setTimeout(waitForWrapper, 100);
          return;
        }

        // Create ScrollTrigger for glide in/out
        const glideScrollTrigger = ScrollTrigger.create({
          trigger: readerWrapper,
          start: 'top 80%',
          end: 'bottom 20%',
          markers: false,
          onEnter: () => {
            gsap.to(container, {
              opacity: 1,
              x: 0,
              y: 0,
              duration: 0.8,
              ease: 'power3.out',
            });
          },
          onLeave: () => {
            gsap.to(container, {
              opacity: 0,
              x: initialX,
              y: initialY,
              duration: 0.6,
              ease: 'power2.in',
            });
          },
          onEnterBack: () => {
            gsap.to(container, {
              opacity: 1,
              x: 0,
              y: 0,
              duration: 0.8,
              ease: 'power3.out',
            });
          },
          onLeaveBack: () => {
            gsap.to(container, {
              opacity: 0,
              x: initialX,
              y: initialY,
              duration: 0.6,
              ease: 'power2.in',
            });
          },
        });

        // Check initial state - if we're already in the trigger zone, show the nav
        // This handles page refreshes mid-scroll
        if (glideScrollTrigger.isActive) {
          gsap.set(container, {
            opacity: 1,
            x: 0,
            y: 0,
          });
        }
      };

      waitForWrapper();
    }
  }

  function initReaderNav(): void {
    const navs = document.querySelectorAll('[data-reader-nav]');
    navs.forEach((nav) => new ReaderNav(nav as HTMLElement));
  }

  // Initialize on load and page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReaderNav);
  } else {
    initReaderNav();
  }

  document.addEventListener('astro:page-load', initReaderNav);
</script>
