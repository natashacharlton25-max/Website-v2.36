---
import type { ReaderSection, ReaderHeroSection, ReaderEndSection } from '../../lib/config/reader-types';
import '../../styles/components/presentation/Reader.css';

// Import all section components
import {
  TitleSection,
  EndSection,
  TextSection,
  ImageTextSection,
  FullWidthSection,
  QuoteSection,
  StatsSection,
  GallerySection,
  CalloutSection,
  CompareSection,
} from './Sections';

interface Props {
  sections: ReaderSection[];
  heroSection?: ReaderHeroSection;
  endSection?: ReaderEndSection;
}

const { sections, heroSection, endSection } = Astro.props;

// Determine if we have end section content
const hasEndContent = endSection && (
  endSection.author ||
  endSection.linkedAssets?.length ||
  endSection.recommendedItems?.length ||
  endSection.customHtml
);
---

{/* Reader Wrapper - TRACKS all sections including optional hero/end */}
<section class="reader-wrapper" data-reader-wrapper>
  <div class="reader-container" data-reader-container>
    {/* Title Section - TRACKED as first section (always included if heroSection provided) */}
    {heroSection && (
      <div
        class="reader-section reader-section--title"
        data-reader-section
        data-section-id="title"
        data-section-index="0"
        id="section-title"
      >
        <TitleSection
          title={heroSection.title}
          description={heroSection.description}
          category={heroSection.category}
          date={heroSection.date}
          readingTime={heroSection.readingTime}
          image={heroSection.image}
          overlayOpacity={heroSection.overlayOpacity}
          primaryAction={heroSection.primaryAction}
          secondaryAction={heroSection.secondaryAction}
        />
      </div>
    )}

    {/* Main Content Sections - TRACKED */}
    {sections.map((section, index) => {
      const layout = section.layout || 'text-only';
      // Support new props with backwards compatibility
      const textAlign = section.textAlign || section.alignment || 'center';
      const position = section.position || 'center';
      const imagePosition = section.imagePosition || 'right';
      const sectionIndex = heroSection ? index + 1 : index;

      return (
        <div
          class={`reader-section reader-section--${layout}`}
          data-reader-section
          data-section-id={section.id}
          data-section-index={sectionIndex}
          id={`section-${section.id}`}
        >
          {/* Text-only layout */}
          {layout === 'text-only' && (
            <TextSection
              title={section.title}
              body={section.body}
              textAlign={textAlign}
              position={position}
            />
          )}

          {/* Image + Text layout */}
          {layout === 'image-text' && section.image && (
            <ImageTextSection
              title={section.title}
              body={section.body}
              image={section.image}
              imagePosition={imagePosition}
            />
          )}

          {/* Full-width image layout */}
          {layout === 'full-width-image' && section.image && (
            <FullWidthSection
              title={section.title}
              body={section.body}
              image={section.image}
            />
          )}

          {/* Quote layout */}
          {layout === 'quote' && section.quote && (
            <QuoteSection
              quote={section.quote}
              author={section.author}
              role={section.role}
              variant={section.variant}
            />
          )}

          {/* Stats layout */}
          {layout === 'stats' && section.stats && (
            <StatsSection
              stats={section.stats}
              layout={section.statsLayout}
            />
          )}

          {/* Gallery layout */}
          {layout === 'gallery' && section.images && (
            <GallerySection
              images={section.images}
              columns={section.columns}
            />
          )}

          {/* Callout layout */}
          {layout === 'callout' && section.content && (
            <CalloutSection
              title={section.title}
              content={section.content}
              type={section.calloutType}
            />
          )}

          {/* Compare layout */}
          {layout === 'compare' && section.left && section.right && (
            <CompareSection
              left={section.left}
              right={section.right}
              divider={section.divider}
            />
          )}
        </div>
      );
    })}

    {/* End Section - TRACKED as last section (always included if endSection has content) */}
    {hasEndContent && (
      <div
        class="reader-section reader-section--end"
        data-reader-section
        data-section-id="end"
        data-section-index={(heroSection ? 1 : 0) + sections.length}
        id="section-end"
      >
        <EndSection
          author={endSection.author}
          linkedAssets={endSection.linkedAssets}
          recommendedItems={endSection.recommendedItems}
          recommendedBasePath={endSection.recommendedBasePath}
          customHtml={endSection.customHtml}
        />
      </div>
    )}
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initReader() {
    const wrapper = document.querySelector('[data-reader-wrapper]') as HTMLElement;
    if (!wrapper) return;

    // Skip GSAP animations in plain mode and force reset inline styles
    if (document.body.classList.contains('plain')) {
      // Kill any existing ScrollTriggers on this wrapper
      ScrollTrigger.getAll().forEach(st => st.kill());

      // Reset wrapper inline styles
      wrapper.style.minHeight = '0';
      wrapper.style.height = 'auto';
      wrapper.style.position = 'static';

      // Reset container inline styles (GSAP sets these)
      const container = wrapper.querySelector('[data-reader-container]') as HTMLElement;
      if (container) {
        container.style.cssText = '';
      }

      // Reset all section inline styles
      const sections = wrapper.querySelectorAll('[data-reader-section]') as NodeListOf<HTMLElement>;
      sections.forEach(section => {
        section.style.cssText = '';
      });

      // Remove pin-spacer if it exists
      const pinSpacer = wrapper.closest('.pin-spacer');
      if (pinSpacer && pinSpacer.parentNode) {
        pinSpacer.parentNode.insertBefore(wrapper, pinSpacer);
        pinSpacer.remove();
      }
      return;
    }

    const container = wrapper.querySelector('[data-reader-container]') as HTMLElement;
    const sections = Array.from(
      wrapper.querySelectorAll('[data-reader-section]')
    ) as HTMLElement[];

    if (sections.length === 0) return;

    // Set CSS variable for dynamic height calculation
    wrapper.style.setProperty('--section-count', sections.length.toString());

    // Set initial states (including pointer-events for click-through)
    sections.forEach((section, index) => {
      if (index === 0) {
        gsap.set(section, { opacity: 1, pointerEvents: 'auto' });
      } else {
        gsap.set(section, { opacity: 0, pointerEvents: 'none' });
      }
    });

    // Create master timeline with pin AND progress tracking
    const masterTimeline = gsap.timeline({
      scrollTrigger: {
        trigger: wrapper,
        start: 'top top',
        end: `+=${sections.length * window.innerHeight * 1.5}`,
        scrub: 1.5,
        pin: container,
        pinSpacing: true,
        anticipatePin: 1,
        markers: false,
        onUpdate: (self) => {
          // Track progress from the SAME ScrollTrigger as the animations
          const progress = self.progress;
          // Round to nearest section (changes at 50% through transition)
          const currentIndex = Math.round(progress * (sections.length - 1));
          const clampedIndex = Math.max(0, Math.min(currentIndex, sections.length - 1));
          const currentSection = sections[clampedIndex];

          // Dispatch progress event for ReaderNav
          if (currentSection) {
            const sectionId = currentSection.dataset.sectionId;

            // Calculate progress within current section (0-1)
            const totalSections = sections.length;
            const progressPerSection = 1 / Math.max(totalSections - 1, 1);
            const sectionStart = Math.max(0, (clampedIndex - 0.5) * progressPerSection);
            const sectionEnd = Math.min(1, (clampedIndex + 0.5) * progressPerSection);
            const sectionRange = sectionEnd - sectionStart;
            const sectionProgress = sectionRange > 0
              ? Math.max(0, Math.min(1, (progress - sectionStart) / sectionRange))
              : 0;

            window.dispatchEvent(
              new CustomEvent('reader:progress', {
                detail: {
                  index: clampedIndex,
                  id: sectionId || '',
                  progress: progress,
                  totalProgress: progress * 100,
                  sectionProgress: sectionProgress,
                },
              })
            );
          }

          // Update window reference
          (window as any).readerCurrentSection = {
            index: clampedIndex,
            id: currentSection?.dataset.sectionId || '',
            progress: progress,
            totalProgress: progress * 100,
          };
        },
      },
    });

    // Animation sequence: staggered fades with NO overlap
    // Fade-out: 0.3s, Gap: 0.05s, Fade-in: 0.5s
    sections.forEach((section, index) => {
      if (index === sections.length - 1) return; // Last section stays visible

      const nextSection = sections[index + 1];
      const sectionDuration = 1; // Total duration for this section's transition

      // Fade out current section (fast: 0.3s)
      masterTimeline.to(
        section,
        {
          opacity: 0,
          pointerEvents: 'none',
          duration: 0.3,
          ease: 'power2.inOut',
        },
        index * sectionDuration
      );

      // Fade in next section (slower: 0.5s, starts after fade-out + gap)
      masterTimeline.fromTo(
        nextSection,
        { opacity: 0, pointerEvents: 'none' },
        {
          opacity: 1,
          pointerEvents: 'auto',
          duration: 0.5,
          ease: 'power2.inOut',
        },
        index * sectionDuration + 0.35 // 0.35 = 0.3 (fade-out) + 0.05 (gap)
      );
    });

    // Expose current section to window for debugging/external access
    (window as any).readerCurrentSection = {
      index: 0,
      id: sections[0]?.dataset.sectionId,
      progress: 0,
      totalProgress: 0,
    };
  }

  // Cleanup function
  function cleanupReader() {
    ScrollTrigger.getAll().forEach((trigger) => {
      const triggerEl = trigger.vars.trigger;
      if (triggerEl instanceof Element && triggerEl.classList?.contains('reader-wrapper')) {
        trigger.kill();
      }
    });
  }

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReader);
  } else {
    initReader();
  }

  // Support Astro page transitions
  document.addEventListener('astro:page-load', initReader);
  document.addEventListener('astro:before-preparation', cleanupReader);
</script>
