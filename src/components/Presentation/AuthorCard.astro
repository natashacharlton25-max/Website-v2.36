---
/**
 * AuthorCard - Displays author info with photo, name, role, and bio
 * Features offset overlapping photo design (photo overlaps left edge of card)
 * Reusable across presentations, insights, and other content types
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  photo: ImageMetadata;
  role?: string;
  bio: string;
  label?: string;
  variant?: 'default' | 'compact' | 'featured';
  class?: string;
}

const {
  name,
  photo,
  role,
  bio,
  label = 'Written by',
  variant = 'default',
  class: className
} = Astro.props;
---

<div class:list={['card', 'author-card', `author-card--${variant}`, className]}>
  <div class="author-card__photo">
    <Image src={photo} alt={name} width={120} height={120} />
  </div>
  <div class="author-card__content">
    <span class="author-card__label">{label}</span>
    <h3 class="author-card__name">{name}</h3>
    {role && <span class="author-card__role">{role}</span>}
    <p class="author-card__bio">{bio}</p>
  </div>
</div>

<style>
  /* Base - Offset image card design */
  .author-card {
    display: flex;
    align-items: stretch;
    width: 100%;
   
  }

  /* Photo - Rounded square overlapping left edge */
  .author-card__photo {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    position: relative;
    z-index: 2;
    margin-right: -24px;
    align-self: center;
  }

  .author-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Content card - Same as background with shadow */
  .author-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-xl) var(--space-2xl);
    padding-left: calc(var(--space-2xl) + 24px);
    background: var(--brand-c-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    min-height: 100px;
  }

  .author-card__label {
    font-family: var(--font-body);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-c-text-light);
    margin-bottom: var(--space-xs);
  }

  .author-card__name {
    font-family: var(--font-heading);
    font-weight: var(--font-bold);
    color: var(--brand-c-text-dark);
    margin: 0 0 var(--space-xs) 0;
    line-height: var(--leading-tight);
  }

  .author-card__role {
    display: block;
    font-family: var(--font-body);
    font-weight: var(--font-semibold);
    color: var(--brand-c-primary-dark);
    margin-bottom: var(--space-sm);
  }

  .author-card__bio {
    font-family: var(--font-body);
    color: var(--brand-c-text);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Compact variant */
  .author-card--compact {
    max-width: 500px;
  }

  .author-card--compact .author-card__photo {
    width: 80px;
    height: 80px;
    margin-right: -16px;
  }

  .author-card--compact .author-card__content {
    padding: var(--space-lg) var(--space-xl);
    padding-left: calc(var(--space-xl) + 16px);
    min-height: 100px;
  }

  .author-card--compact .author-card__name {
  }

  .author-card--compact .author-card__bio {
  }

  /* Featured variant - wider */
  .author-card--featured {
    max-width: 1000px;
  }

  .author-card--featured .author-card__photo {
    width: 140px;
    height: 140px;
    margin-right: -28px;
  }

  .author-card--featured .author-card__content {
    padding: var(--space-2xl) var(--space-3xl);
    padding-left: calc(var(--space-3xl) + 28px);
    min-height: 160px;
  }

  .author-card--featured .author-card__name {
  }

  .author-card--featured .author-card__bio {
  }

  /* Responsive - Mobile: stack vertically */
  @media (max-width: 640px) {
    .author-card {
      flex-direction: column;
      align-items: center;
    }

    .author-card__photo {
      margin-right: 0;
      margin-bottom: -20px;
      z-index: 2;
    }

    .author-card__content {
      padding: var(--space-xl);
      padding-top: calc(var(--space-xl) + 20px);
      text-align: center;
      width: 100%;
    }

    .author-card--featured .author-card__photo {
      width: 100px;
      height: 100px;
      margin-right: 0;
      margin-bottom: -20px;
    }

    .author-card--featured .author-card__content {
      padding: var(--space-xl);
      padding-top: calc(var(--space-xl) + 20px);
    }

    .author-card--featured .author-card__name {
    }

    .author-card--featured .author-card__bio {
    }
  }

  /* ========== RESPONSIVE - SMALL (500px) ========== */
  @media (max-width: 500px) {
    .author-card__photo {
      width: 80px;
      height: 80px;
      margin-bottom: -16px;
    }

    .author-card__content {
      padding: var(--space-lg);
      padding-top: calc(var(--space-lg) + 16px);
    }

    .author-card__label {
      margin-bottom: 2px;
    }

    .author-card__name {
      margin-bottom: 2px;
    }

    .author-card__role {
      margin-bottom: var(--space-xs);
    }

    .author-card__bio {
      line-height: 1.5;
    }

    .author-card--featured .author-card__photo {
      width: 80px;
      height: 80px;
      margin-bottom: -16px;
    }

    .author-card--featured .author-card__name {
    }

    .author-card--featured .author-card__bio {
    }
  }

  /* ========== RESPONSIVE - VERY SMALL (400px) ========== */
  @media (max-width: 400px) {
    .author-card__photo {
      width: 70px;
      height: 70px;
      margin-bottom: -14px;
    }

    .author-card__content {
      padding: var(--space-md);
      padding-top: calc(var(--space-md) + 14px);
    }

    .author-card__label {
    }

    .author-card__name {
    }

    .author-card__role {
      font-size: 0.6875rem;
    }

    .author-card__bio {
      font-size: 0.6875rem;
      line-height: 1.4;
    }

    .author-card--featured .author-card__photo {
      width: 70px;
      height: 70px;
      margin-bottom: -14px;
    }

    .author-card--featured .author-card__name {
    }

    .author-card--featured .author-card__bio {
      font-size: 0.6875rem;
    }
  }

  /* ========== RESPONSIVE - TINY (300px) ========== */
  @media (max-width: 300px) {
    .author-card__photo {
      width: 60px;
      height: 60px;
      margin-bottom: -12px;
    }

    .author-card__content {
      padding: var(--space-sm);
      padding-top: calc(var(--space-sm) + 12px);
    }

    .author-card__label {
      letter-spacing: 0.05em;
    }

    .author-card__name {
    }

    .author-card__role {
    }

    .author-card__bio {
      line-height: 1.4;
    }

    .author-card--featured .author-card__photo {
      width: 60px;
      height: 60px;
      margin-bottom: -12px;
    }

    .author-card--featured .author-card__name {
    }

    .author-card--featured .author-card__bio {
    }
  }

  /* ========== RESPONSIVE - ULTRA SMALL (200px) ========== */
  @media (max-width: 200px) {
    .author-card__photo {
      width: 50px;
      height: 50px;
      margin-bottom: -10px;
    }

    .author-card__content {
      padding: var(--space-xs);
      padding-top: calc(var(--space-xs) + 10px);
    }

    .author-card__label {
    }

    .author-card__name {
    }

    .author-card__role {
    }

    .author-card__bio {
      line-height: 1.3;
    }

    .author-card--featured .author-card__photo {
      width: 50px;
      height: 50px;
      margin-bottom: -10px;
    }

    .author-card--featured .author-card__name {
    }

    .author-card--featured .author-card__bio {
    }
  }
</style>
