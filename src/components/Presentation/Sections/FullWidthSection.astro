---
/**
 * FullWidthSection - Full viewport image with glass card overlay
 * Used within Reader presentations for full-width-image layouts
 */

export interface Props {
  title: string;
  body?: string;
  image: string;
}

const { title, body, image } = Astro.props;
---

<div class="fullwidth">
  <div class="fullwidth__image">
    <img src={image} alt={title} />
  </div>
  <div class="fullwidth__card-wrapper">
    <div class="fullwidth__card">
      <h2 class="fullwidth__title">{title}</h2>
      {body && <div class="fullwidth__body" set:html={body} />}
    </div>
  </div>
</div>

<style>
  /* Fills parent reader-section which handles full-viewport sizing */
  .fullwidth {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  .fullwidth__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .fullwidth__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fullwidth__card-wrapper {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: var(--space-3xl);
  }

  .fullwidth__card {
    max-width: 800px;
    padding: var(--space-3xl) var(--space-4xl);
    /* Glassmorphic background - more transparent for glass effect */
    background: color-mix(in oklch, var(--brand-c-primary-dark) 55%, transparent);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    /* Rounded corners */
    border-radius: 24px;
    /* Subtle white border for glass edge */
    border: 1px solid rgba(255, 255, 255, 0.18);
    /* Glow shadow like ReaderNav */
    box-shadow:
      0 0 30px color-mix(in oklch, var(--brand-c-primary) 40%, transparent),
      0 0 60px color-mix(in oklch, var(--brand-c-primary) 20%, transparent),
      0 8px 32px rgba(0, 0, 0, 0.25);
    text-align: center;
  }

  .fullwidth__title {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--color-White);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-xl) 0;
  }

  .fullwidth__body {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: var(--font-normal);
    color: var(--color-White);
    line-height: var(--leading-relaxed);
  }

  .fullwidth__body :global(p) {
    margin: 0 0 var(--space-md) 0;
    color: var(--color-White);
  }

  .fullwidth__body :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Ensure all text inside body is white */
  .fullwidth__body :global(*) {
    color: var(--color-White);
  }

  @media (max-width: 968px) {
    .fullwidth__title {
      font-size: var(--text-3xl);
    }

    .fullwidth__body {
      font-size: var(--text-base);
    }
  }

  @media (max-width: 640px) {
    .fullwidth__card-wrapper {
      padding: var(--space-2xl);
    }

    .fullwidth__card {
      padding: var(--space-2xl) var(--space-3xl);
    }

    .fullwidth__title {
      font-size: var(--text-2xl);
      margin-bottom: var(--space-lg);
    }

    .fullwidth__body {
      font-size: var(--text-sm);
    }
  }

  @media (max-width: 480px) {
    .fullwidth__card-wrapper {
      padding: var(--space-lg);
    }

    .fullwidth__card {
      padding: var(--space-xl) var(--space-2xl);
    }

    .fullwidth__title {
      font-size: var(--text-xl);
    }

    .fullwidth__body {
      font-size: var(--text-xs);
    }
  }
</style>
