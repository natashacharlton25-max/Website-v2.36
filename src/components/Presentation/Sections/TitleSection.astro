---
/**
 * TitleSection - Full viewport title/hero section
 * First section of every presentation
 * Supports optional background image with overlay
 */

export interface Props {
  title: string;
  description?: string;
  category?: string;
  date?: string;
  readingTime?: number; // in minutes
  image?: string;
  overlayOpacity?: number;
  primaryAction?: { label: string; href: string };
  secondaryAction?: { label: string; href: string };
}

const { title, description, category, date, readingTime, image, overlayOpacity = 0.6, primaryAction, secondaryAction } = Astro.props;
const hasActions = primaryAction || secondaryAction;
const hasImage = !!image;
---

<div class={`title-section ${hasImage ? 'title-section--has-image' : ''}`}>
  {/* Background image with overlay */}
  {hasImage && (
    <div class="title-section__image-wrapper">
      <img src={image} alt="" class="title-section__image" />
      <div class="title-section__overlay" style={`--overlay-opacity: ${overlayOpacity}`}></div>
    </div>
  )}

  <div class="title-section__content">
    {(category || date || readingTime) && (
      <div class="title-section__meta">
        {category && <span class="title-section__category">{category}</span>}
        {date && <span class="title-section__date">{date}</span>}
        {readingTime && (
          <span class="title-section__reading-time">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
            {readingTime} min read
          </span>
        )}
      </div>
    )}

    <h1 class="title-section__title">{title}</h1>

    {description && <p class="title-section__description">{description}</p>}

    {hasActions && (
      <div class="title-section__actions">
        {primaryAction && (
          <a href={primaryAction.href} class="title-section__btn title-section__btn--primary">
            {primaryAction.label}
            <svg class="title-section__btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        )}
        {secondaryAction && (
          <a href={secondaryAction.href} class="title-section__btn title-section__btn--secondary">
            {secondaryAction.label}
          </a>
        )}
      </div>
    )}
  </div>

  {/* Decorative elements (hidden when image is present) */}
  {!hasImage && (
    <div class="title-section__decor">
      <div class="title-section__circle title-section__circle--1"></div>
      <div class="title-section__circle title-section__circle--2"></div>
    </div>
  )}
</div>

<style>
  .title-section {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--brand-c-bg);
    /* Account for fixed nav height */
    padding-top: var(--body-top-padding, 70px);
  }

  /* ========== IMAGE BACKGROUND ========== */
  .title-section__image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .title-section__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .title-section__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      color-mix(in oklch, var(--brand-c-primary-dark) calc(var(--overlay-opacity, 0.6) * 100%), transparent) 0%,
      color-mix(in oklch, var(--brand-c-primary-dark) calc(var(--overlay-opacity, 0.6) * 80%), transparent) 50%,
      color-mix(in oklch, var(--brand-c-primary-dark) calc(var(--overlay-opacity, 0.6) * 60%), transparent) 100%
    );
  }

  /* Adjust colors when image is present */
  .title-section--has-image .title-section__content {
    z-index: 2;
  }

  .title-section--has-image .title-section__title {
    color: var(--color-White);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
  }

  .title-section--has-image .title-section__description {
    color: var(--brand-c-text-light);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  }

  .title-section--has-image .title-section__date {
    color: var(--brand-c-text-light);
  }

  .title-section--has-image .title-section__category {
    background: var(--color-White);
    color: var(--brand-c-primary-dark);
  }

  .title-section--has-image .title-section__btn--secondary {
    color: var(--color-White);
    border-color: var(--color-White);
  }

  .title-section--has-image .title-section__btn--secondary:hover {
    background: color-mix(in oklch, var(--color-White) 20%, transparent);
    border-color: var(--color-White);
  }

  .title-section__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-3xl);
    text-align: left;
  }

  /* Meta (category + date) */
  .title-section__meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .title-section__category {
    padding: var(--space-xs) var(--space-md);
    background: var(--brand-c-primary-dark);
    color: var(--color-White);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .title-section__date {
    color: var(--brand-c-text-light);
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }

  .title-section__reading-time {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--brand-c-text-light);
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }

  .title-section__reading-time svg {
    opacity: 0.7;
  }

  .title-section--has-image .title-section__reading-time {
    color: var(--brand-c-text-light);
  }

  /* Title */
  .title-section__title {
    font-family: var(--font-heading);
    font-size: var(--text-6xl);
    font-weight: var(--font-extrabold);
    color: var(--brand-c-primary-dark);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-xl) 0;
    max-width: 900px;
  }

  /* Description */
  .title-section__description {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    color: var(--brand-c-text);
    line-height: var(--leading-relaxed);
    max-width: 750px;
    margin: 0 0 var(--space-2xl) 0;
  }

  /* Actions */
  .title-section__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .title-section__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-xl);
    border-radius: var(--radius-lg);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .title-section__btn--primary {
    background: var(--brand-c-primary-dark);
    color: var(--color-White);
  }

  .title-section__btn--primary:hover {
    background: var(--brand-c-primary);
    transform: translateY(-2px);
  }

  .title-section__btn--secondary {
    background: transparent;
    color: var(--brand-c-primary-dark);
    border: 1px solid var(--brand-c-primary-light);
  }

  .title-section__btn--secondary:hover {
    background: var(--brand-c-primary-light);
    border-color: var(--brand-c-primary);
  }

  .title-section__btn-icon {
    width: 1.25em;
    height: 1.25em;
    transition: transform 0.2s ease;
  }

  .title-section__btn--primary:hover .title-section__btn-icon {
    transform: translateX(4px);
  }

  /* Decorative circles */
  .title-section__decor {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .title-section__circle {
    position: absolute;
    border-radius: 50%;
  }

  .title-section__circle--1 {
    width: 600px;
    height: 600px;
    top: -200px;
    right: -100px;
    background: radial-gradient(circle, var(--brand-c-primary-light) 0%, transparent 70%);
    opacity: 0.5;
  }

  .title-section__circle--2 {
    width: 400px;
    height: 400px;
    bottom: -150px;
    left: -100px;
    background: radial-gradient(circle, var(--brand-c-primary-light) 0%, transparent 70%);
    opacity: 0.3;
  }

  /* Responsive - Tablet */
  @media (max-width: 968px) {
    .title-section__content {
      padding: 0 var(--space-2xl);
    }

    .title-section__title {
      font-size: var(--text-5xl);
    }

    .title-section__description {
      font-size: var(--text-lg);
    }
  }

  /* Responsive - Mobile */
  @media (max-width: 768px) {
    .title-section__meta {
      flex-wrap: wrap;
      gap: var(--space-sm);
    }
  }

  @media (max-width: 640px) {
    .title-section__content {
      padding: 0 var(--space-xl);
    }

    .title-section__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    .title-section__title {
      font-size: var(--text-4xl);
      margin-bottom: var(--space-lg);
    }

    .title-section__description {
      font-size: var(--text-base);
      margin-bottom: var(--space-xl);
    }

    .title-section__actions {
      flex-direction: column;
    }

    .title-section__btn {
      justify-content: center;
      width: 100%;
    }
  }

  /* Responsive - Small Mobile */
  @media (max-width: 480px) {
    .title-section__title {
      font-size: var(--text-3xl);
    }

    .title-section__description {
      font-size: var(--text-sm);
    }

    .title-section__btn {
      padding: var(--space-sm) var(--space-lg);
      font-size: var(--text-sm);
    }
  }
</style>
