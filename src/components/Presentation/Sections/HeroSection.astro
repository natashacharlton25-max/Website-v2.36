---
/**
 * HeroSection - Full-screen hero with image background
 * Used within Reader presentations for the hero section
 */

export interface Props {
  title: string;
  description?: string;
  image?: string;
  category?: string;
  date?: string;
}

const { title, description, image, category, date } = Astro.props;
---

<div class="hero">
  {image && (
    <div class="hero__image-container">
      <img src={image} alt={title} class="hero__image" />
    </div>
  )}
  <div class="hero__overlay">
    <div class="hero__content">
      {(category || date) && (
        <div class="hero__meta">
          {category && <span class="hero__category">{category}</span>}
          {date && <span class="hero__date">{date}</span>}
        </div>
      )}
      <h1 class="hero__title">{title}</h1>
      {description && <p class="hero__description">{description}</p>}
    </div>
  </div>
</div>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background-color: var(--color-Neutral-500);
  }

  .hero__image-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.9) 0%,
      rgba(0, 0, 0, 0.6) 50%,
      transparent 100%
    );
    padding: var(--space-4xl) var(--space-2xl) var(--space-3xl);
  }

  .hero__content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }

  .hero__meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .hero__category {
    padding: var(--space-xs) var(--space-md);
    background: var(--color-Primary-600);
    color: var(--color-White, #fff);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero__date {
    color: var(--color-Text-200);
    font-size: var(--text-sm);
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: var(--text-5xl);
    font-weight: var(--font-extrabold);
    color: var(--color-Text-50);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-md) 0;
    max-width: 900px;
  }

  .hero__description {
    font-size: var(--text-xl);
    color: var(--color-Text-200);
    line-height: var(--leading-relaxed);
    max-width: 700px;
    font-style: italic;
    margin: 0;
  }

  @media (max-width: 968px) {
    .hero {
      height: 80vh;
    }

    .hero__title {
      font-size: var(--text-3xl);
    }

    .hero__description {
      font-size: var(--text-lg);
    }
  }

  @media (max-width: 640px) {
    .hero {
      height: 70vh;
    }

    .hero__title {
      font-size: var(--text-2xl);
    }

    .hero__description {
      font-size: var(--text-base);
    }
  }

  @media (max-width: 480px) {
    .hero__title {
      font-size: var(--text-xl);
    }
  }
</style>
