---
/**
 * Stepper - Accessible Increment/Decrement Control
 *
 * A reusable stepper with + and - buttons for numeric values.
 * More accessible alternative to sliders for motor-impaired users.
 *
 * Usage:
 * <Stepper
 *   id="font-size"
 *   setting="fontSize"
 *   label="Font Size"
 *   min={50}
 *   max={200}
 *   step={10}
 *   value={100}
 *   valueId="font-size-value"
 *   unit="%"
 * />
 */

interface Props {
  id: string;
  setting: string;
  label: string;
  min: number;
  max: number;
  step?: number;
  value?: number;
  valueId?: string;
  unit?: string;
}

const {
  id,
  setting,
  label,
  min,
  max,
  step = 1,
  value = min,
  valueId,
  unit = ''
} = Astro.props;
---

<div class="a11y-stepper" data-setting={setting} data-min={min} data-max={max} data-step={step}>
  <button
    type="button"
    class="a11y-stepper__btn a11y-stepper__btn--plus"
    aria-label={`Increase ${label}`}
    data-action="increment"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <line x1="12" y1="5" x2="12" y2="19" />
      <line x1="5" y1="12" x2="19" y2="12" />
    </svg>
  </button>
  <div class="a11y-stepper__center">
    <label for={id} class="a11y-stepper__label">{label}</label>
    <span class="a11y-stepper__value" id={valueId || `${id}-value`} data-unit={unit}>
      {value}{unit}
    </span>
    <input type="hidden" id={id} value={value} data-setting={setting} />
  </div>
  <button
    type="button"
    class="a11y-stepper__btn a11y-stepper__btn--minus"
    aria-label={`Decrease ${label}`}
    data-action="decrement"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <line x1="5" y1="12" x2="19" y2="12" />
    </svg>
  </button>
</div>

<style>
  .a11y-stepper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    background: var(--color-Background-100);
    border: 2px solid color-mix(in srgb, var(--color-Text-900) 20%, transparent);
    border-radius: var(--radius-lg);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .a11y-stepper__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    flex: 1;
  }

  .a11y-stepper__label {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-Text-900);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .a11y-stepper__value {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-Text-900);
    opacity: 0.8;
    font-variant-numeric: tabular-nums;
  }

  .a11y-stepper__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    padding: 0;
    background: color-mix(in srgb, var(--color-Text-900) 8%, transparent);
    border: 2px solid transparent;
    border-radius: var(--radius-md);
    color: var(--color-Primary-500);
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .a11y-stepper__btn svg {
    width: 28px;
    height: 28px;
  }

  .a11y-stepper__btn:hover:not(:disabled) {
    background: transparent;
    border-color: var(--color-Primary-500);
    color: var(--color-Primary-500);
  }

  .a11y-stepper__btn:focus-visible {
    outline: 2px solid var(--color-Primary-500);
    outline-offset: 2px;
  }

  .a11y-stepper__btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .a11y-stepper__btn:active:not(:disabled) {
    transform: scale(0.95);
  }

  /* Responsive - mobile */
  @media (max-width: 768px) {
    .a11y-stepper {
      padding: var(--space-sm) var(--space-md);
      gap: var(--space-sm);
    }

    .a11y-stepper__btn {
      width: 44px;
      height: 44px;
    }

    .a11y-stepper__btn svg {
      width: 22px;
      height: 22px;
    }

    .a11y-stepper__label {
      font-size: var(--font-size-base);
    }

    .a11y-stepper__value {
      font-size: var(--font-size-xl);
    }
  }

  /* Very small screens */
  @media (max-width: 480px) {
    .a11y-stepper__btn {
      width: 40px;
      height: 40px;
    }

    .a11y-stepper__btn svg {
      width: 18px;
      height: 18px;
    }

    .a11y-stepper__label {
      font-size: var(--font-size-sm);
    }

    .a11y-stepper__value {
      font-size: var(--font-size-lg);
    }
  }

  /* ========== REDUCED MOTION ========== */
  :global(#a11y-content-wrapper.a11y-reduce-motion) .a11y-stepper__btn {
    transition: none;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .a11y-stepper__btn:active:not(:disabled) {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .a11y-stepper__btn {
      transition: none;
    }

    .a11y-stepper__btn:active:not(:disabled) {
      transform: none;
    }
  }
</style>
