---
/**
 * NavigationSection - Navigation & Motion Settings Section
 *
 * Contains navigation and motion accessibility settings.
 *
 * Usage:
 * <NavigationSection />
 */
import ToggleCard from './ToggleCard.astro';
---

<div class="a11y-section">
  <h3 class="a11y-section__title">Navigation & Motion</h3>

  <div class="a11y-toggle-grid">
    <ToggleCard
      id="a11y-reduce-motion"
      setting="reduceMotion"
      icon="a11y/lightning-fill"
      label="Reduce Motion"
      description="Stop animations"
    />

    <ToggleCard
      id="a11y-enhanced-focus"
      setting="enhancedFocus"
      icon="a11y/gear-fill"
      label="Enhanced Focus"
      description="Larger indicators"
    />

    <ToggleCard
      id="a11y-screen-reader"
      setting="screenReaderMode"
      icon="a11y/bell-fill"
      label="Screen Reader"
      description="Announce actions"
    />
  </div>
</div>

<style>
  .a11y-section {
    margin-bottom: var(--space-md);
  }

  .a11y-section:last-child {
    margin-bottom: 0;
  }

  .a11y-section__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-Text-900);
    margin-bottom: var(--space-md);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
  }

  .a11y-toggle-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .a11y-section__title {
      font-size: var(--font-size-base);
    }
  }
</style>
