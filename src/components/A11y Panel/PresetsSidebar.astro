---
/**
 * PresetsSidebar - Quick Presets Sidebar
 *
 * Displays preset buttons for quick accessibility configurations.
 *
 * Usage:
 * <PresetsSidebar />
 */
import PresetButton from './PresetButton.astro';
---

<aside class="a11y-panel__sidebar-right">
  <div class="a11y-preset-list">
    <PresetButton
      preset="dyslexia"
      icon="text-aa-fill"
      title="Dyslexia"
      subtitle="Font + spacing"
    />
    <PresetButton
      preset="low-vision"
      icon="eye-fill"
      title="Low Vision"
      subtitle="Large text"
    />
    <PresetButton
      preset="color-blind"
      icon="palette-fill"
      title="Color Blind"
      subtitle="Adapted colors"
    />
    <PresetButton
      preset="motor"
      icon="hand-palm-fill"
      title="Motor"
      subtitle="Enhanced focus"
    />
    <PresetButton
      preset="cognitive"
      icon="brain-fill"
      title="Cognitive"
      subtitle="Reduced motion"
    />
    <PresetButton
      preset="easyread"
      icon="book-open-fill"
      title="Easy Read"
      subtitle="Simple layout"
    />
  </div>
</aside>

<style>
  .a11y-panel__sidebar-right {
    padding: var(--space-md);
    border-left: var(--border-width) solid color-mix(in srgb, var(--brand-c-text-dark) 15%, transparent);
    overflow-y: auto;
  }

  .a11y-sidebar__title {
    font-weight: var(--font-bold);
    color: var(--brand-c-text-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
    text-align: center;
  }

  .a11y-preset-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* Tablet - 2 column grid in sidebar */
  @media (min-width: 769px) and (max-width: 1400px) {
    .a11y-panel__sidebar-right {
      text-align: center;
      border-left: none;
    }

    .a11y-sidebar__title {
      text-align: center;
    }

    .a11y-preset-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-sm);
    }
  }

  /* Mobile - full width with 3 columns */
  @media (max-width: 768px) {
    .a11y-panel__sidebar-right {
      width: 100%;
      border-left: none;
      border-bottom: var(--border-width) solid color-mix(in srgb, var(--brand-c-text-dark) 15%, transparent);
      text-align: center;
    }

    .a11y-sidebar__title {
      text-align: center;
    }

    .a11y-preset-list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-xs);
    }
  }

  /* Small mobile - 2 columns */
  @media (max-width: 480px) {
    .a11y-preset-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Very small - 2 columns tighter */
  @media (max-width: 320px) {
    .a11y-panel__sidebar-right {
      padding: var(--space-sm);
    }

    .a11y-sidebar__title {
      margin-bottom: var(--space-sm);
    }

    .a11y-preset-list {
      gap: var(--space-2xs);
    }
  }
</style>
