---
/**
 * ContactInfo — Contact page sidebar molecule
 *
 * Shows email, response time, and safeguarding note.
 * Uses Card, Icon, Heading, Text, Link atoms.
 *
 * Usage:
 * <ContactInfo />
 */
import Card from '../../atoms/ui/Card/Card.astro';
import Icon from '../../atoms/icons/Icon.astro';
import Heading from '../../atoms/ui/Heading/Heading.astro';
import Text from '../../atoms/ui/Text/Text.astro';
import Link from '../../atoms/ui/Link/Link.astro';
import { BRAND_CONFIG } from '../../../lib/config/brand';
---

<aside class="contact-info">

  <Card variant="outline" padding="xl" radius="lg" shadow="sm" class="contact-info__card">
    <Heading level={3} flush>Other ways to reach us</Heading>

    <div class="contact-info__item">
      <div class="contact-info__icon-wrap">
        <Icon name="contact-popup/envelope-fill" size={20} />
      </div>
      <div class="contact-info__detail">
        <Text as="span" size="xs" uppercase flush>Email</Text>
        <Link href={`mailto:${BRAND_CONFIG.contact.email}`} variant="underline" color="primary" weight="bold">
          {BRAND_CONFIG.contact.email}
        </Link>
      </div>
    </div>

    <div class="contact-info__item">
      <div class="contact-info__icon-wrap">
        <Icon name="contact-popup/timer-fill" size={20} />
      </div>
      <div class="contact-info__detail">
        <Text as="span" size="xs" uppercase flush>Response time</Text>
        <Text as="span" weight="bold" flush>{BRAND_CONFIG.contact.responseTime}</Text>
      </div>
    </div>
  </Card>

  <Card variant="outline" padding="xl" radius="lg" class="contact-info__card contact-info__card--safety">
    <Heading level={3} flush>A note on safety</Heading>
    <Text as="p" color="text-light" flush>
      If you or someone you know is in immediate danger, please contact
      emergency services (999) or the
      <Link href="https://www.samaritans.org" external variant="underline" color="primary">Samaritans</Link> (116 123).
    </Text>
    <Text as="p" color="text-light" flush>
      This form is not monitored 24/7 and is not a crisis service.
    </Text>
  </Card>

</aside>

<!-- Styles: ContactInfo.style.css | ContactInfo.responsive.css | ContactInfo.a11y.css -->
