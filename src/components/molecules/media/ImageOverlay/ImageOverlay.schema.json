{
  "component": "ImageOverlay",
  "category": "molecules/media",
  "renders": {
    "base": "ImageOverlay.astro"
  },
  "props": {
    "overlay":      { "type": "string",  "required": false, "default": "none", "enum": ["gradient-bottom", "gradient-top", "scrim", "glass", "color-blend", "none"] },
    "position":     { "type": "string",  "required": false, "default": "center", "enum": ["top-left", "top-center", "top-right", "center", "bottom-left", "bottom-center", "bottom-right"] },
    "blendMode":    { "type": "string",  "required": false, "default": "multiply", "enum": ["multiply", "overlay", "screen", "soft-light", "color-burn", "color-dodge"] },
    "blendColor":   { "type": "string",  "required": false, "default": "dark" },
    "scrimOpacity": { "type": "number",  "required": false, "default": 0.45 },
    "fullBleed":    { "type": "boolean", "required": false, "default": false },
    "aspectRatio":  { "type": "string",  "required": false },
    "minHeight":    { "type": "string",  "required": false },
    "class":        { "type": "string",  "required": false, "default": "" }
  },
  "slots": {
    "default": "Content displayed over the image (text, headings, etc.)",
    "image":   "Image atom — use <Image slot=\"image\" />"
  }
}
