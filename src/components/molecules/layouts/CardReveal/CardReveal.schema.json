{
  "component": "CardReveal",
  "category": "molecule",
  "renders": {
    "full": "CardReveal.astro",
    "reduced": "CardReveal.astro",
    "assistive": "CardReveal.astro",
    "textonly": "CardReveal.astro"
  },
  "notes": "Two-column card pair layout with click-to-reveal. Items prop defines front/back content. Card atom wraps each side. Used standalone or as FlipCard textonly render target. Keyboard: Enter/Space toggles. Pipeline maps FlipCard props: title→title, subtitle→subtitle, description→detail, href→href, linkLabel→linkLabel.",

  "props": {
    "content": {
      "_description": "Card pair data",
      "items": {
        "type": "array",
        "required": true,
        "items": {
          "type": "object",
          "properties": {
            "title":     { "type": "string", "required": true },
            "subtitle":  { "type": "string", "required": false },
            "detail":    { "type": "string", "required": true },
            "href":      { "type": "string", "required": false },
            "linkLabel": { "type": "string", "required": false, "default": "Learn More" }
          }
        },
        "description": "Array of card pairs."
      }
    },
    "visual": {},
    "animation": {},
    "colour": {
      "_description": "Pipeline-overridable tokens",
      "activeBorder": { "type": "token", "required": false, "default": "brand-c-primary", "cssProperty": "--reveal-active-border", "description": "Active/selected card border." },
      "hoverBorder":  { "type": "token", "required": false, "default": "brand-c-secondary", "cssProperty": "--reveal-hover-border", "description": "Hover border colour." }
    }
  }
}
