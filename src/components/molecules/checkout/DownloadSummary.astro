---
import Button from '../../atoms/Button/Button.astro';

interface Props {
  emptyMessage?: string;
  browseHref?: string;
  browseText?: string;
}

const {
  emptyMessage = "No downloads selected",
  browseHref = "/assets",
  browseText = "Browse Resources"
} = Astro.props;
---

<div class="download-summary">
  <div id="order-items" class="download-summary__items">
    <!-- Items will be populated from cart -->
    <div class="download-summary__empty">
      <p>{emptyMessage}</p>
      <Button href={browseHref} variant="outline" size="sm">{browseText}</Button>
    </div>
  </div>
</div>

<script>
  // Load cart items and populate download summary
  function loadDownloadItems() {
    const orderItemsContainer = document.getElementById('order-items');
    if (!orderItemsContainer) return;

    const cartData = localStorage.getItem('cartItems');
    let cartItems: any[] = [];

    try {
      if (cartData) {
        const parsed = JSON.parse(cartData);
        if (Array.isArray(parsed)) cartItems = parsed;
      }
    } catch (error) {
      console.error('Error loading cart:', error);
    }

    // Empty state
    if (cartItems.length === 0) {
      orderItemsContainer.innerHTML = `
        <div class="download-summary__empty">
          <p>No downloads selected</p>
          <a href="/assets" class="btn btn--outline btn--sm">Browse Resources</a>
        </div>
      `;
      return;
    }

    // Clear and populate items
    orderItemsContainer.innerHTML = '';

    cartItems.forEach((item: any, index: number) => {
      const itemEl = document.createElement('div');
      itemEl.className = 'download-summary__item';
      itemEl.innerHTML = `
        <div class="download-summary__item-info">
          <div class="download-summary__item-image">
            <img src="${item.image || ''}" alt="${item.name}" onerror="if(!this.dataset.fallback){this.dataset.fallback='1';this.src='/MiniKart/MiniKart-Fallback-'+Math.ceil(Math.random()*10)+'.png';}" />
          </div>
          <div class="download-summary__item-details">
            <span class="download-summary__item-name">${item.name}</span>
          </div>
        </div>
        <span class="download-summary__badge">FREE</span>
        <button class="download-summary__item-remove" data-idx="${index}" aria-label="Remove ${item.name}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
            <path d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      `;
      orderItemsContainer.appendChild(itemEl);
    });

    // Remove item handlers
    orderItemsContainer.querySelectorAll('.download-summary__item-remove').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt((btn as HTMLElement).dataset.idx || '0');
        cartItems.splice(idx, 1);
        localStorage.setItem('cartItems', JSON.stringify(cartItems));
        document.dispatchEvent(new CustomEvent('cart:updated', {
          detail: { count: cartItems.length }
        }));
        loadDownloadItems();
      });
    });
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', () => {
    loadDownloadItems();
  });
</script>

<style is:global>
  .download-summary {
    /* No extra padding - parent card handles it */
  }

  .download-summary__items {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .download-summary__empty {
    text-align: center;
    padding: var(--space-lg) var(--space-md);
    color: var(--brand-c-text-light);
  }

  .download-summary__empty p {
    margin-bottom: var(--space-sm);
  }

  .download-summary__item {
    display: flex;
    flex-direction: row !important;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background: color-mix(in oklch, var(--color-White) 60%, transparent);
    border: 1px solid var(--brand-c-neutral-light);
    border-radius: var(--border-radius-lg);
    margin-bottom: var(--space-sm);
  }

  .download-summary__item:last-child {
    margin-bottom: 0;
  }

  .download-summary__item-info {
    display: flex;
    flex-direction: row !important;
    gap: var(--space-sm);
    flex: 1;
    min-width: 0;
    align-items: center;
  }

  .download-summary__item-image {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    overflow: hidden;
    background-color: var(--brand-c-neutral-light);
    flex-shrink: 0;
  }

  .download-summary__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .download-summary__item-details {
    flex: 1;
    min-width: 0;
  }

  .download-summary__item-name {
    font-family: var(--font-body);
    font-weight: var(--font-medium);
    margin: 0;
    color: var(--brand-c-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }

  .download-summary__badge {
    padding: 4px 8px;
    background-color: transparent;
    color: var(--brand-c-primary-dark);
    border-radius: 4px;
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .download-summary__item-remove {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    color: var(--brand-c-text-light);
    opacity: 0.5;
    transition: opacity 0.15s ease;
    flex-shrink: 0;
  }

  .download-summary__item-remove:hover {
    opacity: 1;
    color: var(--brand-c-text);
  }

  /* ========== RESPONSIVE - SMALL (400px) ========== */
  @media (max-width: 400px) {
    .download-summary__item {
      flex-wrap: wrap;
      padding: var(--space-xs) var(--space-sm);
      gap: var(--space-xs);
    }

    .download-summary__item-info {
      flex-basis: 100%;
    }

    .download-summary__item-image {
      width: 32px;
      height: 32px;
    }

    .download-summary__badge {
      padding: 2px 6px;
    }

    .download-summary__empty {
      padding: var(--space-md) var(--space-sm);
    }
  }

  /* ========== RESPONSIVE - VERY SMALL (300px) ========== */
  @media (max-width: 300px) {
    .download-summary__item {
      flex-direction: row !important;
      align-items: center;
      gap: var(--space-xs);
      padding: var(--space-xs);
    }

    .download-summary__item-image {
      display: none;
    }

    .download-summary__item-info {
      flex-direction: row !important;
      align-items: center;
    }

    .download-summary__item-name {
      white-space: normal;
    }

    .download-summary__badge {
      padding: 2px 4px;
    }

    .download-summary__item-remove {
      width: 20px;
      height: 20px;
    }
  }

  /* ========== RESPONSIVE - TINY (200px) ========== */
  @media (max-width: 200px) {
    .download-summary__items {
      max-height: none;
      overflow-y: visible;
    }

    .download-summary__item {
      padding: var(--space-xs);
      gap: var(--space-xs);
    }

    .download-summary__item-image {
      display: none;
    }

    .download-summary__item-name {
      word-break: break-word;
    }

    .download-summary__badge {
      padding: 2px 4px;
    }

    .download-summary__item-remove {
      width: 20px;
      height: 20px;
    }

    .download-summary__empty {
      padding: var(--space-sm) var(--space-xs);
    }

    .download-summary__empty p {
      word-break: break-word;
    }
  }
</style>
