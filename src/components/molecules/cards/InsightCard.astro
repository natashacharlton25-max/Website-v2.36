---
/**
 * InsightCard - Reusable insight/article card component
 *
 * Used on insights page for both insights and presentations
 *
 * Props:
 * @param slug - Article slug for URL
 * @param title - Article title
 * @param excerpt - Article excerpt/description
 * @param cardImage - Article card image (ImageMetadata)
 * @param category - Article category
 * @param readTime - Read time or section count
 * @param type - Content type (insight, presentation) - used for URL routing and filtering
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Badge from '../../atoms/Badge/Badge.astro';
import Button from '../../atoms/Button/Button.astro';
interface Props {
  slug: string;
  title: string;
  excerpt: string;
  cardImage: ImageMetadata;
  category: string;
  readTime: string;
  type: 'insight' | 'presentation';
}

const {
  slug,
  title,
  excerpt,
  cardImage,
  category,
  readTime,
  type
} = Astro.props;

const href = type === 'presentation' ? `/presentations/${slug}` : `/insights/${slug}`;
const categoryId = category.toLowerCase().replace(/\s+/g, '-');
const ctaText = type === 'presentation' ? 'View Presentation' : 'Read Article';
---

<a href={href} class={`card insight-card ${categoryId}`} data-category={categoryId}>
  <div class="insight-card__image">
    <Image src={cardImage} alt={title} width={800} height={500} loading="lazy" />
  </div>

  <div class="insight-card__content">
    <small class="insight-card__badge">
      <Badge label={category} shape="rounded" variant="fill" />
    </small>
    <small class="insight-card__meta">
      <span class="insight-card__read-time">{readTime}</span>
    </small>
    <h2 class="insight-card__title">{title}</h2>
    <p class="insight-card__excerpt">{excerpt}</p>
    <div class="insight-card__cta">
      <Button variant="outline" size="sm">
        {ctaText}
      </Button>
    </div>
  </div>
</a>

<style>
  /* Insight Card - BEM naming */
  /* Float-based layout for Isotope masonry */
  .insight-card {
    float: left;
    width: calc(33.333% - 1.5em - 4px); /* Subtract 4px for 2px border on each side */
    margin: 0.75em;
    padding: var(--space-md);
    padding-bottom: var(--space-md); /* Content section has its own padding */
    box-sizing: border-box;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in oklch, var(--primary-800) 35%, transparent);
    background-color: transparent;
  }

  .insight-card:hover {
    box-shadow: var(--shadow-lg);
    border-color: var(--primary-800);
    transform: none !important;
  }

  .insight-card__image {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

   .insight-card:hover .insight-card__image {
    box-shadow: var(--shadow-xl);
    border: 1px solid color-mix(in oklch, var(--primary-800) 60%, transparent);
  
  }
  

  .insight-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .insight-card__badge {
    margin-bottom: var(--space-sm);
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
  }

  .insight-card__content {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .insight-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
  }

  .insight-card__read-time {
    color: var(--neutral-400);
    font-weight: var(--font-bold);
  }

  .insight-card__title {
    font-weight: var(--font-bold);
    color: var(--neutral-800);
    margin-bottom: var(--space-md);
    font-family: var(--font-heading);
    line-height: 1.3;
  }

  .insight-card__excerpt {
    color: var(--neutral-800);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-lg);
    flex: 1;
  }

  .insight-card__cta {
    display: flex;
  }

  /* Make button small for cards */
  .insight-card__cta :global(.btn) {
    padding: var(--space-sm) var(--space-md);
    font-size: var(--text-small);
    min-height: 2.25rem;
    border-radius: var(--radius-md);
  }

  /* ========== RESPONSIVE - TABLET ========== */
  /* @media-stripped-0 */  /* ========== RESPONSIVE - MOBILE ========== */
  /* @media-stripped-1 */  /* @media-stripped-2 */  /* @media-stripped-3 */  /* @media-stripped-4 */  /* @media-stripped-5 */  /* @media-stripped-6 */  /* @media-stripped-7 */  /* ========== REDUCED MOTION ========== */
  /* No visual change on hover - keep base state */
  :global(#a11y-content-wrapper.a11y-reduce-motion) .insight-card {
    transition: none !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .insight-card:hover {
    box-shadow: var(--shadow) !important;
    border-color: transparent !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .insight-card__image {
    transition: none !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .insight-card:hover .insight-card__image {
    box-shadow: var(--shadow-sm) !important;
    border: none !important;
  }

  /* @media-stripped-8 */</style>
