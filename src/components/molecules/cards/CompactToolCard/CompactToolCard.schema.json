{
  "component": "CompactToolCard",
  "category": "molecule",
  "renders": {
    "full": "CompactToolCard.astro",
    "reduced": "CompactToolCard.astro",
    "assistive": "CompactToolCard.astro",
    "textonly": "CompactToolCard.astro"
  },
  "notes": "Horizontal compact card for tool/resource links. Media slot accepts image, icon, or LottieIcon. Plus icon rotates on hover (gated). Card atom handles chrome, hover lift, border change.",

  "props": {
    "content": {
      "href": { "type": "string", "required": true, "description": "Link destination." },
      "name": { "type": "string", "required": true, "description": "Tool/resource title." },
      "category": { "type": "string", "required": false, "description": "Category badge label." },
      "description": { "type": "string", "required": true, "description": "Short description (clamped to 2 lines)." },
      "image": { "type": "ImageMetadata", "required": false, "description": "Image for media slot." },
      "icon": { "type": "string", "required": false, "description": "Icon slug for media slot." },
      "lottieSlug": { "type": "string", "required": false, "description": "LottieIcon slug for media slot." }
    },
    "visual": {
      "iconWeight": { "type": "string", "required": false, "default": "duotone", "enum": ["fill", "duotone", "regular"], "description": "Icon weight override." }
    },
    "animation": {}
  }
}
