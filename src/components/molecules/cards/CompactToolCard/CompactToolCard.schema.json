{
  "component": "CompactToolCard",
  "category": "molecule",
  "renders": {
    "full": "CompactToolCard.astro",
    "reduced": "CompactToolCard.astro",
    "assistive": "CompactToolCard.astro",
    "textonly": "CompactToolCard.astro"
  },
  "notes": "Horizontal compact card for tool/resource links. Media slot accepts image, icon, or LottieIcon. Plus icon rotates on hover (gated). Card atom handles chrome, hover lift, border change.",

  "props": {
    "content": {
      "_description": "What the card says",
      "href":        { "type": "string", "required": true, "description": "Link destination." },
      "name":        { "type": "string", "required": true, "description": "Tool/resource title." },
      "category":    { "type": "string", "required": false, "description": "Category badge label." },
      "description": { "type": "string", "required": true, "description": "Short description (clamped to 2 lines)." }
    },
    "visual": {
      "_description": "How the card looks — stripped in textonly",
      "image":       { "type": "ImageMetadata", "required": false, "textonly": false, "description": "Image for media slot." },
      "icon":        { "type": "string", "required": false, "textonly": false, "description": "Icon slug for media slot." },
      "lottieSlug":  { "type": "string", "required": false, "textonly": false, "description": "LottieIcon slug for media slot." },
      "iconWeight":  { "type": "string", "required": false, "default": "duotone", "enum": ["fill", "duotone", "regular"], "description": "Icon weight override." },
      "mediaSize":   { "type": "token", "required": false, "default": "var(--img-width-md)", "cssProperty": "--compact-media-size", "description": "Media slot dimensions." },
      "mediaRadius": { "type": "token", "required": false, "default": "var(--radius-md)", "cssProperty": "--compact-media-radius", "description": "Media slot border radius." }
    },
    "colour": {
      "_description": "Pipeline-overridable colour tokens.",
      "mediaBg":     { "type": "token", "required": false, "default": "page-bg-sunken", "cssProperty": "--compact-media-bg", "description": "Media slot background." },
      "iconColor":   { "type": "token", "required": false, "default": "brand-c-primary", "cssProperty": "--compact-icon-color", "description": "Icon colour (static state)." },
      "actionColor": { "type": "token", "required": false, "default": "brand-c-primary", "cssProperty": "--compact-action-color", "description": "Action icon colour (static state)." },
      "hoverAccent": { "type": "token", "required": false, "default": "brand-c-secondary", "cssProperty": "--compact-hover-accent", "description": "Icon + action colour on hover." }
    },
    "animation": {}
  }
}
