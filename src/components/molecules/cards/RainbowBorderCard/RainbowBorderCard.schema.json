{
  "component": "RainbowBorderCard",
  "category": "effect",
  "renders": {
    "full": "RainbowBorderCard.astro",
    "reduced": "RainbowBorderCard.astro",
    "assistive": "RainbowBorderCard.astro",
    "textonly": "RainbowBorderCard.astro"
  },
  "notes": "Animated conic-gradient border wrapper. Slot-based — wraps any content. Hover triggers single 360° spin then lands on first colour. Inner Card atom handles chrome, dark mode, HC, render modes. Rainbow tokens provide CVD-safe colours.",

  "props": {
    "content": {},

    "visual": {
      "_description": "Static border appearance",
      "variant":      { "type": "string", "required": false, "default": "gradient", "enum": ["primary", "gradient", "pulse"], "description": "Border style. Primary: solid→gradient. Gradient: static→rotating. Pulse: rotation + brightness." },
      "borderRadius": { "type": "string", "required": false, "default": "var(--radius-lg)", "description": "Outer border radius." },
      "borderWidth":  { "type": "string", "required": false, "default": "3px", "description": "Border width (padding around inner card)." },
      "class":        { "type": "string", "required": false, "default": "", "description": "Additional CSS classes." }
    },

    "animation": {
      "_description": "Rainbow spin — stripped in reduced/assistive/textonly. Solid first-colour border remains.",
      "spin": {
        "type": "boolean",
        "required": false,
        "default": true,
        "strip": ["reduced", "assistive", "textonly"],
        "description": "Conic gradient spin on hover."
      },
      "colors": {
        "type": "array",
        "items": { "type": "token" },
        "minItems": 2,
        "maxItems": 7,
        "required": false,
        "default": ["var(--rainbow-1)", "var(--rainbow-2)", "var(--rainbow-3)", "var(--rainbow-4)", "var(--rainbow-5)", "var(--rainbow-6)", "var(--rainbow-7)"],
        "strip": ["reduced", "assistive", "textonly"],
        "description": "Gradient stops. First colour is also the static/landed border."
      },
      "rotationSpeed": {
        "type": "number",
        "required": false,
        "default": 20,
        "strip": ["reduced", "assistive", "textonly"],
        "description": "Rotation speed. Ignored when data-hover is none/instant."
      }
    },

    "colour": {}
  }
}
