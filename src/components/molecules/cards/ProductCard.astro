---
/**
 * ProductCard - Reusable product/asset card component
 *
 * Props:
 * @param slug - Product slug for URL
 * @param name - Product name
 * @param category - Product category
 * @param description - Product description
 * @param cardImage - Product card image (ImageMetadata)
 * @param type - Product type (worksheet, workbook, etc.) - used for filtering
 * @param price - Product price (default: "Free")
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Badge from '../../atoms/ui/Badge.astro';
import Button from '../../atoms/ui/Button.astro';

interface Props {
  slug: string;
  name: string;
  category: string;
  description: string;
  cardImage?: ImageMetadata;
  type: string;
  price?: string;
}

const {
  slug,
  name,
  category,
  description,
  cardImage,
  type,
  price = 'Free'
} = Astro.props;

const hasImage = cardImage !== undefined;
---

<a href={`/assets/${slug}`} class={`product-card card ${type}`} data-type={type}>
  <div class="img-default product-card__image">
    {hasImage ? (
      <Image src={cardImage} alt={name} width={800} height={500} />
    ) : (
      <div class="product-card__placeholder">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
          <polyline points="10 9 9 9 8 9"/>
        </svg>
      </div>
    )}
  </div>

  <div class="product-card__info">
    <small class="product-card__badge">
      <Badge label={type} shape="rounded" variant="fill" />
    </small>
    <small class="product-card__category">{category}</small>
    <h3 class="product-card__name">{name}</h3>
    <p class="product-card__description">{description}</p>

    <div class="product-card__footer">
      <div class="product-card__price">
        <span class="price-current">{price}</span>
      </div>
      <div class="product-card__cta">
        <Button
          variant="primary"
          size="sm"
          className="js-add-to-cart"
          data-product-id={slug}
          data-product-name={name}
          data-product-price="0"
          data-product-image={hasImage ? cardImage.src : ''}
          aria-label="Add to cart"
        >
          <p class="add-to-cart-text">Add to Cart</p>
          <span class="add-to-cart-icon">+</span>
        </Button>
      </div>
    </div>
  </div>
</a>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest('.js-add-to-cart');
    if (button) {
      event.preventDefault();
      event.stopPropagation();
    }
  });
</script>

<style>
  /* Product Card - BEM naming */
  /* Inherits background, border-radius, padding, box-shadow from global .card class */
  .product-card {
    float: left;
    width: calc(33.333% - 1.5em - 4px);
    margin: 0.75em;
    box-sizing: border-box;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    color: inherit;
    border: 1px solid color-mix(in oklch, var(--brand-c-primary-dark) 35%, transparent);
    background-color: transparent;
  }

  .product-card:hover {
    box-shadow: var(--shadow-lg);
    border-color: var(--brand-c-primary-dark);
    transform: none;
  }


  .product-card__image {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    margin-inline: auto;
    position: relative;
    background-color: var(--brand-c-neutral-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, var(--brand-c-primary-light), var(--brand-c-primary-light));
    color: var(--brand-c-primary);
  }

  .product-card__placeholder svg {
    width: 48px;
    height: 48px;
    opacity: 0.6;
  }

 

  .product-card__badge {
    margin-bottom: var(--space-sm);
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
  }
  
  .product-card:hover .product-card__image {
    box-shadow: var(--shadow-xl);
    border: 1px solid color-mix(in oklch, var(--brand-c-primary-dark) 35%, transparent);
  
  }

  

  .product-card__info {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-lg);
    padding: var(--space-md);
    flex: 1;
  }

  .product-card__category {
    font-size: inherit;
    color: var(--brand-c-text-light);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-sm);
  }

  .product-card__name {
    font-weight: var(--font-bold);
    margin-bottom: var(--space-sm);
    color: var(--brand-c-text);
    font-family: var(--font-heading);
    line-height: 1.3;
  }

  .product-card__description {
    color: var(--brand-c-text);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-lg);
    flex: 1;
  }

  .product-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    padding-top: var(--space-md);
  }

  .product-card__price {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .price-current {
  }

  .product-card__cta {
    display: flex;
  }

  /* Make button small for cards */
  .product-card__cta :global(.btn) {
    padding: var(--space-sm) var(--space-md);
    font-size: var(--text-small);
    min-height: 2.25rem;
    border-radius: var(--radius-md);
  }

  /* Add to Cart Button Content */
  .add-to-cart-text {
    display: inline;
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
    margin: 0;
    line-height: inherit;
  }

  .add-to-cart-icon {
    display: none;
    font-weight: var(--font-bold);
  }

  /* ========== RESPONSIVE ========== */

  /* Tablet: 2 columns */
  @media (max-width: 1023px) {
    .product-card {
      width: calc(50% - 1.5em - 4px);
    }
  }

  /* Mobile: 1 column */
  @media (max-width: 767px) {
    .product-card {
      width: calc(100% - 1.5em - 4px);
      margin: 0.5em;
    }
  }

  @media (max-width: 480px) {
    .product-card {
      width: calc(100% - 1em - 4px);
      margin: 0.35em;
    }
  }

  @media (max-width: 350px) {
    .product-card {
      width: calc(100% - 0.5em - 4px);
      margin: 0.25em;
    }
  }

  @media (max-width: 768px) {
    .product-card__info {
      padding: var(--space-md);
    }
  }

  @media (max-width: 480px) {
    .product-card__info {
      padding: var(--space-sm);
    }

    .product-card__footer {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-sm);
    }

    .price-current {
    }

    .product-card__cta {
      width: 100%;
    }
  }

  @media (max-width: 350px) {
    .product-card__info {
      padding: var(--space-xs) var(--space-sm);
    }

    .price-current {
    }

    .add-to-cart-text {
      display: none;
    }

    .add-to-cart-icon {
      display: inline;
    }

    .product-card__cta {
      width: auto;
    }

    .product-card__footer {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  @media (max-width: 250px) {
    .product-card__footer {
      flex-direction: column;
      align-items: center;
      gap: var(--space-xs);
    }

    .price-current {
    }

    .product-card__cta {
      width: 100%;
    }
  }

  /* ========== RESPONSIVE - SMALL SCREENS: Center content ========== */
  @media (max-width: 600px) {
    .product-card {
      border-radius: 1.5rem;
    }

    .product-card__image {
      border-radius: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .product-card {
      text-align: center;
      border-radius: 1.5rem;
    }

    .product-card__badge {
      display: flex;
      justify-content: center;
    }

    .product-card__image {
      border-radius: 1.25rem;
    }

    .product-card__info {
      text-align: center;
    }

    .product-card__price {
      justify-content: center;
    }

    .product-card__cta {
      justify-content: center;
    }
  }

  @media (max-width: 400px) {
    .product-card {
      border-radius: 1.25rem;
    }

    .product-card__image {
      border-radius: 1rem;
    }
  }

  @media (max-width: 350px) {
    .product-card {
      border-radius: 1.25rem;
    }

    .product-card__image {
      border-radius: 1rem;
    }

    .product-card__name {
    }

    .product-card__description {
    }

    .product-card__category {
      font-size: calc(var(--text-fine) * 0.9);
    }
  }

  @media (max-width: 300px) {
    .product-card {
      padding: var(--space-sm);
      border-radius: 1rem;
    }

    .product-card__badge {
      margin-bottom: var(--space-xs);
    }

    .product-card__image {
      border-radius: 0.75rem;
    }

    .product-card__info {
      padding: var(--space-xs);
    }

    .product-card__name {
      margin-bottom: var(--space-xs);
    }

    .product-card__description {
      font-size: calc(var(--text-fine) * 0.9);
      margin-bottom: var(--space-sm);
    }
  }

  @media (max-width: 200px) {
    .product-card {
      padding: var(--space-xs);
      border-radius: 0.75rem;
    }

    .product-card__image {
      aspect-ratio: 4 / 3;
      border-radius: 0.5rem;
    }

    .product-card__badge {
      margin-bottom: calc(var(--space-xs) * 0.5);
    }

    .product-card__placeholder svg {
      width: 32px;
      height: 32px;
    }

    .product-card__info {
      margin-top: var(--space-sm);
      padding: var(--space-xs);
    }

    .product-card__name {
    }

    .product-card__description {
      display: none;
    }

    .product-card__footer {
      padding-top: var(--space-xs);
    }
  }

  /* A11Y theme overrides in: src/styles/a11y/components/product-card.css */

  /* ========== REDUCED MOTION ========== */
  /* Remove ALL hover effects - no visual changes on hover */
  :global(#a11y-content-wrapper.a11y-reduce-motion) .product-card,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .product-card__image,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .product-card__image img {
    transition: none !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .product-card:hover {
    box-shadow: var(--shadow) !important; /* Keep base shadow from .card class */
    border-color: color-mix(in oklch, var(--brand-c-primary-dark) 35%, transparent) !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .product-card:hover .product-card__image {
    box-shadow: var(--shadow-sm) !important;
    border: none !important;
  }

  /* System preference reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card__image,
    .product-card__image img {
      transition: none;
    }

    .product-card:hover {
      box-shadow: var(--shadow); /* Keep base shadow from .card class */
      border-color: color-mix(in oklch, var(--brand-c-primary-dark) 35%, transparent);
    }

    .product-card:hover .product-card__image {
      box-shadow: var(--shadow-sm);
      border: none;
    }
  }

  /* ========== REDUCED MOTION - EDITORIAL/PROJECTS PAGE ========== */
  /* Additional specificity for products-grid context - NO visual changes on hover */
  :global(#a11y-content-wrapper.a11y-reduce-motion .editorial-resources) .product-card,
  :global(#a11y-content-wrapper.a11y-reduce-motion .products-grid) .product-card {
    transition: none !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion .editorial-resources) .product-card:hover,
  :global(#a11y-content-wrapper.a11y-reduce-motion .products-grid) .product-card:hover {
    box-shadow: var(--shadow) !important; /* Keep base shadow from .card class */
    border: 1px solid color-mix(in oklch, var(--brand-c-primary-dark) 35%, transparent) !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion .editorial-resources) .product-card:hover .product-card__image,
  :global(#a11y-content-wrapper.a11y-reduce-motion .products-grid) .product-card:hover .product-card__image {
    box-shadow: var(--shadow-sm) !important;
    border: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-resources .product-card,
    .products-grid .product-card {
      transition: none;
    }

    .editorial-resources .product-card:hover,
    .products-grid .product-card:hover {
      box-shadow: var(--shadow); /* Keep base shadow from .card class */
      border: 1px solid color-mix(in oklch, var(--brand-c-primary-dark) 35%, transparent);
      transform: none;
    }

    .editorial-resources .product-card:hover .product-card__image,
    .products-grid .product-card:hover .product-card__image {
      box-shadow: var(--shadow-sm);
      border: none;
      transform: none;
    }

  }
</style>
