---
/**
 * ProductCard - Reusable product/asset card component
 *
 * Props:
 * @param slug - Product slug for URL
 * @param name - Product name
 * @param category - Product category
 * @param description - Product description
 * @param cardImage - Product card image (ImageMetadata)
 * @param type - Product type (worksheet, workbook, etc.) - used for filtering
 * @param price - Product price (default: "Free")
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Badge from '../../atoms/Badge/Badge.astro';
import Button from '../../atoms/Button/Button.astro';
import Icon from '../../atoms/Icon/Icon.astro';

interface Props {
  slug: string;
  name: string;
  category: string;
  description: string;
  cardImage?: ImageMetadata;
  type: string;
  price?: string;
}

const {
  slug,
  name,
  category,
  description,
  cardImage,
  type,
  price = 'Free'
} = Astro.props;

const hasImage = cardImage !== undefined;
---

<a href={`/assets/${slug}`} class={`product-card card ${type}`} data-type={type}>
  <div class="img-default product-card__image">
    {hasImage ? (
      <Image src={cardImage} alt={name} width={800} height={500} />
    ) : (
      <div class="product-card__placeholder">
        <Icon name="file-text" semanticRole="decorative" />
      </div>
    )}
  </div>

  <div class="product-card__info">
    <small class="product-card__badge">
      <Badge label={type} shape="rounded" variant="fill" />
    </small>
    <small class="product-card__category">{category}</small>
    <h3 class="product-card__name">{name}</h3>
    <p class="product-card__description">{description}</p>

    <div class="product-card__footer">
      <div class="product-card__price">
        <span class="price-current">{price}</span>
      </div>
      <div class="product-card__cta">
        <Button
          variant="primary"
          size="sm"
          className="js-add-to-cart"
          data-product-id={slug}
          data-product-name={name}
          data-product-price="0"
          data-product-image={hasImage ? cardImage.src : ''}
          aria-label="Add to cart"
        >
          <p class="add-to-cart-text">Add to Cart</p>
          <span class="add-to-cart-icon">+</span>
        </Button>
      </div>
    </div>
  </div>
</a>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest('.js-add-to-cart');
    if (button) {
      event.preventDefault();
      event.stopPropagation();
    }
  });
</script>

<style>
  /* Product Card - BEM naming */
  /* Inherits background, border-radius, padding, box-shadow from global .card class */
  .product-card {
    float: left;
    width: calc(33.333% - 1.5em - 4px);
    margin: 0.75em;
    box-sizing: border-box;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    color: inherit;
    border: 1px solid color-mix(in oklch, var(--primary-800) 35%, transparent);
    background-color: transparent;
  }

  .product-card:hover {
    box-shadow: var(--shadow-lg);
    border-color: var(--primary-800);
    transform: none;
  }


  .product-card__image {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    margin-inline: auto;
    position: relative;
    background-color: var(--neutral-400);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, var(--primary-200), var(--primary-200));
    color: var(--primary-600);
  }

  .product-card__placeholder svg {
    width: 48px;
    height: 48px;
    opacity: 0.6;
  }

 

  .product-card__badge {
    margin-bottom: var(--space-sm);
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
  }
  
  .product-card:hover .product-card__image {
    box-shadow: var(--shadow-xl);
    border: 1px solid color-mix(in oklch, var(--primary-800) 35%, transparent);
  
  }

  

  .product-card__info {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-lg);
    padding: var(--space-md);
    flex: 1;
  }

  .product-card__category {
    font-size: inherit;
    color: var(--neutral-400);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-sm);
  }

  .product-card__name {
    font-weight: var(--font-bold);
    margin-bottom: var(--space-sm);
    color: var(--neutral-800);
    font-family: var(--font-heading);
    line-height: 1.3;
  }

  .product-card__description {
    color: var(--neutral-800);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-lg);
    flex: 1;
  }

  .product-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    padding-top: var(--space-md);
  }

  .product-card__price {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .price-current {
  }

  .product-card__cta {
    display: flex;
  }

  /* Make button small for cards */
  .product-card__cta :global(.btn) {
    padding: var(--space-sm) var(--space-md);
    font-size: var(--text-small);
    min-height: 2.25rem;
    border-radius: var(--radius-md);
  }

  /* Add to Cart Button Content */
  .add-to-cart-text {
    display: inline;
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
    margin: 0;
    line-height: inherit;
  }

  .add-to-cart-icon {
    display: none;
    font-weight: var(--font-bold);
  }

  /* ========== RESPONSIVE ========== */

  /* Tablet: 2 columns */
  /* @media-stripped-0 */  /* Mobile: 1 column */
  /* @media-stripped-1 */  /* @media-stripped-2 */  /* @media-stripped-3 */  /* @media-stripped-4 */  /* @media-stripped-5 */  /* @media-stripped-6 */  /* @media-stripped-7 */  /* ========== RESPONSIVE - SMALL SCREENS: Center content ========== */
  /* @media-stripped-8 */  /* @media-stripped-9 */  /* @media-stripped-10 */  /* @media-stripped-11 */  /* @media-stripped-12 */  /* @media-stripped-13 */  /* A11Y theme overrides in: src/styles/a11y/components/product-card.css */

  /* ========== REDUCED MOTION ========== */
  /* Remove ALL hover effects - no visual changes on hover */
  :global(#a11y-content-wrapper.a11y-reduce-motion) .product-card,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .product-card__image,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .product-card__image img {
    transition: none !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .product-card:hover {
    box-shadow: var(--shadow) !important; /* Keep base shadow from .card class */
    border-color: color-mix(in oklch, var(--primary-800) 35%, transparent) !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .product-card:hover .product-card__image {
    box-shadow: var(--shadow-sm) !important;
    border: none !important;
  }

  /* System preference reduced motion */
  /* @media-stripped-14 */  /* ========== REDUCED MOTION - EDITORIAL/PROJECTS PAGE ========== */
  /* Additional specificity for products-grid context - NO visual changes on hover */
  :global(#a11y-content-wrapper.a11y-reduce-motion .editorial-resources) .product-card,
  :global(#a11y-content-wrapper.a11y-reduce-motion .products-grid) .product-card {
    transition: none !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion .editorial-resources) .product-card:hover,
  :global(#a11y-content-wrapper.a11y-reduce-motion .products-grid) .product-card:hover {
    box-shadow: var(--shadow) !important; /* Keep base shadow from .card class */
    border: 1px solid color-mix(in oklch, var(--primary-800) 35%, transparent) !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion .editorial-resources) .product-card:hover .product-card__image,
  :global(#a11y-content-wrapper.a11y-reduce-motion .products-grid) .product-card:hover .product-card__image {
    box-shadow: var(--shadow-sm) !important;
    border: none !important;
  }

  /* @media-stripped-15 */</style>
