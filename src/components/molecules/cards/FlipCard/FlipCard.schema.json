{
  "component": "FlipCard",
  "category": "molecule",
  "renders": {
    "full": "FlipCard.astro",
    "reduced": "FlipCard.astro",
    "assistive": "FlipCard.astro",
    "textonly": "CardReveal"
  },
  "notes": "3D flip card. Front: title + subtitle + arrow. Back: title + description + CTA. Trigger: hover (default), click (JS). Reduced: no animation, instant swap. Textonly: pipeline routes to CardReveal molecule — maps title/subtitle/description/href/linkLabel to CardReveal items. Section collects all FlipCard JSON items into one CardReveal.",

  "props": {
    "content": {
      "title":       { "type": "string", "required": true, "description": "Heading on both faces." },
      "subtitle":    { "type": "string", "required": false, "description": "Short text on front face." },
      "description": { "type": "string", "required": true, "description": "Longer text on back face." },
      "href":        { "type": "string", "required": false, "description": "CTA link URL on back face." },
      "linkLabel":   { "type": "string", "required": false, "default": "Learn More", "description": "CTA button text." },
      "frontImage":  { "type": "string", "required": false, "description": "Background image URL for front face." },
      "backImage":   { "type": "string", "required": false, "description": "Background image URL for back face (defaults to frontImage)." }
    },
    "visual": {
      "trigger": { "type": "string", "required": false, "default": "hover", "enum": ["hover", "click", "focus"], "description": "Flip trigger. Assistive render forces focus." }
    },
    "colour": {
      "_description": "Pipeline-overridable colour tokens.",
      "frontBg":  { "type": "token", "required": false, "default": "brand-c-primary", "cssProperty": "--flip-front-bg", "description": "Front face background colour." },
      "backBg":   { "type": "token", "required": false, "default": "brand-c-primary-dark", "cssProperty": "--flip-back-bg", "description": "Back face background colour." },
      "text":     { "type": "token", "required": false, "default": "color-White", "cssProperty": "--flip-text", "description": "Text colour on both faces." }
    },
    "animation": {}
  }
}
