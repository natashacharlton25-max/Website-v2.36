---
// Team Member Card Component
// Uses: Card, Heading, Text, Image, Icon atoms

import Card from '../../atoms/Card/Card.astro';
import Heading from '../../atoms/Heading/Heading.astro';
import Text from '../../atoms/Text/Text.astro';
import { Image } from '../../atoms/Image';
import Icon from '../../atoms/Icon/Icon.astro';

export interface Props {
  name: string;
  title: string;
  department?: string;
  image?: string;
  imageAlt?: string;
  bio?: string;
  email?: string;
  phone?: string;
  socials?: {
    linkedin?: string;
    twitter?: string;
    github?: string;
    website?: string;
  };
  variant?: 'default' | 'compact' | 'detailed';
}

const {
  name,
  title,
  department,
  image,
  imageAlt = name,
  bio,
  email,
  phone,
  socials = {},
  variant = 'default'
} = Astro.props;
---

<Card
  as="article"
  variant="default"
  shadow="sm"
  radius="lg"
  hover={true}
  class={`team-card team-card--${variant}`}
>
  {image && (
    <div class="team-card__image">
      <Image src={image} alt={imageAlt} fit="cover" loading="lazy" class="team-card__img" />
    </div>
  )}

  <div class="team-card__content">
    <Heading level={3} size="h5" weight="bold" flush class="team-card__name">{name}</Heading>
    <Text as="p" weight="semibold" color="primary" flush class="team-card__role">{title}</Text>

    {department && (
      <Text as="p" size="sm" color="text-light" flush>{department}</Text>
    )}

    {bio && variant !== 'compact' && (
      <Text size="sm" leading="relaxed" flush class="team-card__bio">{bio}</Text>
    )}

    {(email || phone) && variant === 'detailed' && (
      <div class="team-card__contact">
        {email && (
          <a href={`mailto:${email}`} class="team-card__contact-item">
            <Icon name="envelope-fill" size={16} />
            <Text as="span" size="sm" flush>{email}</Text>
          </a>
        )}
        {phone && (
          <a href={`tel:${phone}`} class="team-card__contact-item">
            <Icon name="phone" semanticRole="decorative" />
            <Text as="span" size="sm" flush>{phone}</Text>
          </a>
        )}
      </div>
    )}

    {Object.keys(socials).length > 0 && (
      <div class="team-card__socials">
        {socials.linkedin && (
          <a href={socials.linkedin} target="_blank" rel="noopener noreferrer" class="team-card__social-link" aria-label="LinkedIn">
            <Icon name="linkedin-logo" weight="fill" semanticRole="decorative" />
          </a>
        )}
        {socials.twitter && (
          <a href={socials.twitter} target="_blank" rel="noopener noreferrer" class="team-card__social-link" aria-label="Twitter">
            <Icon name="x-logo" weight="fill" semanticRole="decorative" />
          </a>
        )}
        {socials.github && (
          <a href={socials.github} target="_blank" rel="noopener noreferrer" class="team-card__social-link" aria-label="GitHub">
            <Icon name="github-logo" weight="fill" semanticRole="decorative" />
          </a>
        )}
        {socials.website && (
          <a href={socials.website} target="_blank" rel="noopener noreferrer" class="team-card__social-link" aria-label="Website">
            <Icon name="globe" semanticRole="decorative" />
          </a>
        )}
      </div>
    )}
  </div>
</Card>

<style>
  .team-card {
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .team-card__image {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .team-card__img {
    width: 100%;
    height: 100%;
    transition: transform var(--transition-base);
  }

  .team-card:hover .team-card__img {
    transform: scale(1.05);
  }

  .team-card__content {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 1;
  }

  .team-card--compact .team-card__content {
    padding: var(--space-md);
    text-align: center;
  }

  .team-card__bio {
    flex: 1;
  }

  .team-card__contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-top: var(--space-sm);
  }

  .team-card__contact-item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--neutral-800);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .team-card__contact-item:hover {
    color: var(--primary-600);
  }

  .team-card__socials {
    display: flex;
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--neutral-400);
  }

  .team-card--compact .team-card__socials {
    justify-content: center;
  }

  .team-card__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--space-2xl);
    height: var(--space-2xl);
    color: var(--neutral-400);
    transition: all var(--transition-fast);
  }

  .team-card__social-link:hover {
    color: var(--primary-600);
    transform: translateY(-2px);
  }

  /* @media-stripped-0 */  /* @media-stripped-1 */  /* ── Reduce-motion ── */
  /* @media-stripped-2 */</style>
