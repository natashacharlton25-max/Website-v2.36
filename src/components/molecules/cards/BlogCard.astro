---
// Blog/Article Card Component
// Uses: Card, Badge, Heading, Text, Image, Icon atoms

import Card from '../../atoms/ui/Card/Card.astro';
import Badge from '../../atoms/ui/Badge/Badge.astro';
import Heading from '../../atoms/ui/Heading/Heading.astro';
import Text from '../../atoms/ui/Text/Text.astro';
import { Image } from '../../atoms/images/Image';
import Icon from '../../atoms/icons/Icon/Icon.astro';

export interface Props {
  title: string;
  excerpt: string;
  image?: string;
  imageAlt?: string;
  author?: string;
  authorImage?: string;
  date?: string;
  category?: string;
  tags?: string[];
  readTime?: string;
  href: string;
  featured?: boolean;
}

const {
  title,
  excerpt,
  image,
  imageAlt = title,
  author,
  authorImage,
  date,
  category,
  tags = [],
  readTime,
  href,
  featured = false
} = Astro.props;
---

<Card
  as="article"
  variant="default"
  shadow="sm"
  radius="lg"
  hover={true}
  class={`blog-card ${featured ? 'blog-card--featured' : ''}`}
>
  <a href={href} class="blog-card__link">
    {image && (
      <div class="blog-card__image">
        <Image src={image} alt={imageAlt} fit="cover" loading="lazy" class="blog-card__img" />
        {category && (
          <Badge label={category} color="primary" class="blog-card__category" />
        )}
      </div>
    )}

    <div class="blog-card__content">
      <div class="blog-card__meta">
        {date && (
          <Text as="span" size="sm" color="text-light" flush class="blog-card__date">
            <Icon name="calendar-fill" size={14} class="blog-card__meta-icon" />
            {date}
          </Text>
        )}
        {readTime && (
          <Text as="span" size="sm" color="text-light" flush class="blog-card__read-time">
            <Icon name="clock-fill" size={14} class="blog-card__meta-icon" />
            {readTime}
          </Text>
        )}
      </div>

      <Heading level={3} size="h4" weight="bold" flush class="blog-card__title">{title}</Heading>
      <Text size="base" leading="relaxed" flush class="blog-card__excerpt">{excerpt}</Text>

      {tags.length > 0 && (
        <div class="blog-card__tags">
          {tags.slice(0, 3).map(tag => (
            <Badge label={tag} variant="outline" color="neutral" shape="pill" uppercase={false} class="blog-card__tag" />
          ))}
        </div>
      )}

      {author && (
        <div class="blog-card__author">
          {authorImage && (
            <Image src={authorImage} alt={author} width="32" height="32" radius="full" fit="cover" class="blog-card__author-image" />
          )}
          <Text as="span" size="sm" weight="medium" flush>{author}</Text>
        </div>
      )}
    </div>
  </a>
</Card>

<style>
  .blog-card {
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .blog-card--featured {
    border: 2px solid var(--brand-c-primary);
  }

  .blog-card__link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .blog-card__image {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .blog-card__img {
    width: 100%;
    height: 100%;
    transition: transform var(--transition-base);
  }

  .blog-card:hover .blog-card__img {
    transform: scale(1.05);
  }

  .blog-card__category {
    position: absolute;
    top: var(--space-md);
    left: var(--space-md);
    z-index: 1;
  }

  .blog-card__content {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    flex: 1;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .blog-card__meta-icon {
    vertical-align: -2px;
    margin-right: var(--space-xs);
    opacity: 0.6;
  }

  .blog-card__title {
    line-height: var(--leading-tight);
  }

  .blog-card:hover .blog-card__title {
    color: var(--brand-c-primary);
  }

  .blog-card__excerpt {
    flex: 1;
  }

  .blog-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .blog-card__author {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--brand-c-neutral-light);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .blog-card__content {
      padding: var(--space-md);
    }
  }

  @media (max-width: 480px) {
    .blog-card__content {
      gap: var(--space-sm);
    }

    .blog-card__meta {
      gap: var(--space-sm);
    }
  }

  /* ── Reduce-motion ── */
  @media (prefers-reduced-motion: reduce) {
    .blog-card__img {
      transition: none;
    }

    .blog-card:hover .blog-card__img {
      transform: none;
    }
  }
</style>
