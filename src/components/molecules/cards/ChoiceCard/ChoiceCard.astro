---
/**
 * ChoiceCard — Selectable image card
 *
 * Card + Image/Icon + FormField (bare). Click anywhere to toggle.
 * Supports checkbox, radio, toggle, text input types.
 *
 * Styles: ChoiceCard.css | ChoiceCard.responsive.css
 */
import Card from '../../../atoms/Card/Card.astro';
import Image from '../../../atoms/Image/Image.astro';
import Icon from '../../../atoms/Icon/Icon.astro';
import Text from '../../../atoms/Text/Text.astro';
import FormField from '../../../atoms/FormField/FormField.astro';

interface Props {
  image?: string;
  imageAlt?: string;
  icon?: string;
  label: string;
  description?: string;
  inputType?: 'checkbox' | 'radio' | 'toggle' | 'text';
  name?: string;
  value?: string;
  checked?: boolean;
  cardVariant?: 'default' | 'transparent' | 'outline' | 'glass' | 'liquid' | 'neumorphic' | 'pressed' | 'comic' | 'tech';
  class?: string;
}

const {
  image,
  imageAlt = '',
  icon,
  label,
  description,
  inputType = 'checkbox',
  name = 'choice',
  value = '',
  checked = false,
  cardVariant = 'default',
  class: className = '',
} = Astro.props;

const fieldId = `${name}-${(value || label).replace(/\s+/g, '-').toLowerCase()}`;
---

<Card
  variant={cardVariant}
  padding="sm"
  radius="lg"
  shadow="sm"
  class:list={['choice-card', checked && 'active', className]}
  data-choice-card=""
>
  {image && (
    <div class="choice-card__image">
      <Image src={image} alt={imageAlt} fit="cover" role="decorative" />
    </div>
  )}

  {!image && icon && (
    <div class="choice-card__icon">
      <Icon name={icon} size={48} />
    </div>
  )}

  <div class="choice-card__footer">
    <FormField
      id={fieldId}
      type={inputType === 'toggle' ? 'toggle' : inputType}
      fieldStyle="bare"
      label={label}
      name={name}
      value={value || label}
      checked={checked}
    />
  </div>

  {description && (
    <Text size="sm" color="muted" flush class="choice-card__desc">{description}</Text>
  )}
</Card>

<script>
  function initChoiceCards(): void {
    document.querySelectorAll<HTMLElement>('[data-choice-card]:not([data-choice-bound])').forEach(card => {
      card.setAttribute('data-choice-bound', '1');

      const input = card.querySelector<HTMLInputElement>('input');
      if (!input) return;

      function syncActive(): void {
        if (input!.type === 'radio') {
          document.querySelectorAll<HTMLElement>('[data-choice-card]').forEach(c => {
            const other = c.querySelector<HTMLInputElement>(`input[name="${input!.name}"]`);
            if (other) c.classList.toggle('active', other.checked);
          });
        } else if (input!.type === 'checkbox') {
          card.classList.toggle('active', input!.checked);
        }
      }

      // Native change — sync active class
      input.addEventListener('change', syncActive);

      // Card click outside the form field — toggle manually
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.form-field')) return;

        if (input.type === 'text') {
          input.focus();
          return;
        }

        input.checked = input.type === 'radio' ? true : !input.checked;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChoiceCards);
  } else {
    initChoiceCards();
  }
  document.addEventListener('astro:page-load', initChoiceCards);
</script>
