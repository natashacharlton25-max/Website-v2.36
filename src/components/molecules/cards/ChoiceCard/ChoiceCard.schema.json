{
  "component": "ChoiceCard",
  "category": "molecule",
  "renders": {
    "full": "ChoiceCard.astro",
    "reduced": "ChoiceCard.astro",
    "assistive": "ChoiceCard.astro",
    "textonly": "ChoiceCard.astro"
  },
  "notes": "Selectable image card with checkbox toggle. Inverted border radius notch on label tray (concave corners via box-shadow). Click anywhere to toggle. Textonly hides image, shows label + checkbox. Active state adds primary border + glow.",

  "props": {
    "content": {
      "_description": "Card content",
      "image":    { "type": "string", "required": true, "textonly": false, "description": "Image URL." },
      "imageAlt": { "type": "string", "required": false, "description": "Image alt text." },
      "label":    { "type": "string", "required": true, "description": "Label text in tray." },
      "name":     { "type": "string", "required": false, "default": "choice", "description": "Checkbox name for form grouping." },
      "value":    { "type": "string", "required": false, "description": "Checkbox value." },
      "checked":  { "type": "boolean", "required": false, "default": false, "description": "Initial checked state." }
    },

    "visual": {
      "_description": "Card appearance",
      "cardVariant": { "type": "string", "required": false, "default": "default", "enum": ["default", "transparent", "outline", "glass", "liquid", "neumorphic", "pressed", "comic", "tech"], "description": "Card atom variant." },
      "class": { "type": "string", "required": false, "default": "", "description": "Additional CSS classes." }
    },

    "colour": {
      "_description": "Visual tokens — JSON/pipeline overridable",
      "trayBg":       { "type": "token", "cssProperty": "--choice-tray-bg", "default": "var(--page-bg-raised)" },
      "activeBorder": { "type": "token", "cssProperty": "--choice-active-border", "default": "var(--brand-c-primary)" },
      "activeGlow":   { "type": "token", "cssProperty": "--choice-active-glow", "default": "color-mix(in oklch, var(--brand-c-primary) 20%, transparent)" }
    },

    "animation": {}
  }
}
