{
  "component": "BlogCard",
  "category": "molecule",
  "renders": {
    "full": "BlogCard.astro",
    "reduced": "BlogCard.astro",
    "assistive": "BlogCard.astro",
    "textonly": "BlogCard.astro"
  },
  "notes": "Article preview card. Full-bleed hero image, category badge, meta row, title, excerpt, tags, optional author. Image scales on hover, title changes colour on hover. Textonly hides image. Image atom handles alt text — BlogCard does not pass alt. All visual properties JSON-overridable via --blog-* bridge tokens.",

  "props": {
    "content": {
      "_description": "Article information",
      "title":    { "type": "string", "required": true, "description": "Article title." },
      "excerpt":  { "type": "string", "required": true, "description": "Article excerpt/summary." },
      "author":   { "type": "string", "required": false, "description": "Author name." },
      "date":     { "type": "string", "required": false, "description": "Publication date." },
      "category": { "type": "string", "required": false, "description": "Category badge label." },
      "tags":     { "type": "array", "items": { "type": "string" }, "required": false, "description": "Tag labels. Max 3 shown." },
      "readTime": { "type": "string", "required": false, "description": "Reading time text." },
      "href":     { "type": "string", "required": true, "description": "Article URL." },
      "featured": { "type": "boolean", "required": false, "default": false, "description": "Show featured border." }
    },

    "visual": {
      "_description": "Card appearance — stripped in textonly",
      "image":       { "type": "string", "required": false, "textonly": false, "description": "Hero image URL." },
      "authorImage": { "type": "string", "required": false, "textonly": false, "description": "Author avatar URL." },
      "cardVariant": { "type": "string", "required": false, "default": "default", "enum": ["default", "transparent", "outline", "glass", "liquid", "neumorphic", "pressed", "comic", "tech"], "description": "Card atom variant." },
      "class":       { "type": "string", "required": false, "default": "", "description": "Additional CSS classes." }
    },

    "colour": {
      "_description": "Visual tokens — JSON/pipeline overridable",
      "border":         { "type": "token", "cssProperty": "--blog-border", "default": "var(--brand-c-neutral-light)", "description": "Author footer border." },
      "tagBg":          { "type": "token", "cssProperty": "--blog-tag-bg", "default": "var(--page-bg-sunken)", "description": "Tag badge background." },
      "tagText":        { "type": "token", "cssProperty": "--blog-tag-text", "default": "var(--brand-c-text)", "description": "Tag badge text colour." },
      "hoverTitle":     { "type": "token", "cssProperty": "--blog-hover-title", "default": "var(--brand-c-primary)", "description": "Title colour on hover." },
      "featuredBorder": { "type": "token", "cssProperty": "--blog-featured-border", "default": "var(--brand-c-primary)", "description": "Featured card border colour." },
      "metaIcon":       { "type": "token", "cssProperty": "--blog-meta-icon", "default": "var(--brand-c-primary)", "description": "Meta row icon colour." },
      "authorIcon":     { "type": "token", "cssProperty": "--blog-author-icon", "default": "var(--brand-c-primary)", "description": "Author row icon colour." }
    },

    "animation": {}
  }
}
