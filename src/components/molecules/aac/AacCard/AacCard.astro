---
/**
 * AacCard — AAC pictogram card molecule
 *
 * Renders a single AAC concept: pictogram image + word label.
 * Composes Text atom for the word. Pictogram is a bare <img> —
 * Image atom is for content images with alt text displays, not symbols.
 *
 * Two display modes:
 *   pictogram — symbol image above word label (default)
 *   text-only — word label with dashed border (no image available)
 *
 * BCI reference number integration (W3C AAC Symbol Registry):
 *   symbolId = BCI index number — the universal cross-reference key.
 *   Pipeline resolves symbolId → symbolSrc based on user's symbol set
 *   preference (OpenAAC default, or Widgit/PCS/Bliss/Makaton if configured).
 *   The data-bci attribute enables WAI-Adapt personalization agents to
 *   resolve the concept to the user's familiar symbol set.
 *
 * Cognitive level filtering:
 *   data-core-tier on the card + data-cognitive-level on <html>
 *   → CSS in aac-mode.css hides cards above the user's vocabulary tier.
 *
 * @param word       — English word/concept label (required)
 * @param symbolSrc  — Resolved symbol image URL (from pipeline)
 * @param symbolId   — BCI reference number (W3C AAC Symbol Registry index)
 * @param coreTier   — Cognitive vocabulary tier: green | yellow | orange | null (fringe)
 * @param size       — Pictogram size: sm (24px) | md (32px) | lg (48px)
 *
 * Styles: AacCard.css
 */
import { Text } from '../../atoms/Text';

interface Props {
  word: string;
  symbolSrc?: string;
  symbolId?: number;
  coreTier?: 'green' | 'yellow' | 'orange' | null;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  word,
  symbolSrc,
  symbolId,
  coreTier = null,
  size = 'md',
  class: className,
} = Astro.props;

const isTextOnly = !symbolSrc;

const tierValue = coreTier ?? 'fringe';

const sizeMap = { sm: 24, md: 32, lg: 48 };
const px = sizeMap[size] ?? sizeMap.md;

const classes = [
  'aac-card',
  isTextOnly && 'aac-card--text-only',
  `aac-card--${size}`,
  className,
];
---

<span
  class:list={classes}
  data-core-tier={tierValue}
  {...(symbolId != null && { 'data-bci': String(symbolId) })}
>
  {symbolSrc && (
    <img
      class="aac-card__pictogram"
      src={symbolSrc}
      alt={word}
      width={px}
      height={px}
      loading="lazy"
    />
  )}
  <Text as="span" class="aac-card__word" size="sm" flush>
    {word}
  </Text>
</span>
