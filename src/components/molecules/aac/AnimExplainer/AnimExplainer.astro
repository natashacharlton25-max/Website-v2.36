---
/**
 * AnimExplainer — AAC animation sequence cards
 *
 * Scalable card pattern:
 *   First (green)        — starting state
 *   Next/Then (yellow)   — action stage(s), one or more
 *   End   (red)          — final state
 *   Words (dashed blue)  — description
 *
 * Recipe-driven: `type` + `variant` → lookup in recipes table
 * defines first state, action stages, end state, words template.
 *
 * Display gated by data-anim-explainer on <html>.
 * Content mode gated by data-anim-seq-mode on <html>.
 */

import {
  animWords,
  actionLabels,
  getActionSvg,
  getActionSvgByKey,
  getRecipe,
  type CardState,
  type Recipe,
} from './anim-explainer-data';

type AnimType = 'morph' | 'draw' | 'fill' | 'micro' | 'draw+fill';

interface Props {
  type: AnimType;
  /** Variant for recipe lookup (fillMode, drawMode, morphTrigger, etc). */
  variant?: string;
  sourceSvg: string;
  targetSvg?: string;
  displayName: string;
  targetName?: string;
  /** Micro-animation key from shared-enums Animation type */
  animation?: string;
  color?: string | null;
  class?: string;
}

const {
  type, variant, sourceSvg, targetSvg, displayName, targetName,
  animation, color, class: className,
} = Astro.props;

const resolvedTargetName = targetName || displayName;

// ── Resolve recipe — falls back to defaults for micro or unknown ──
const recipe: Recipe | null = getRecipe(type, variant);

// ── Resolve card content from recipe or fallback ──

// Helper: render a card state to (svg, extraClass)
function renderCardState(state: CardState): { svg: string; cls: string } {
  switch (state) {
    case 'ghost':
      return { svg: sourceSvg, cls: 'anim-seq-card__icon--ghost' };
    case 'ghost-colour':
      return { svg: sourceSvg, cls: 'anim-seq-card__icon--ghost-colour' };
    case 'filled':
    case 'drawn':
    case 'static':
      return { svg: sourceSvg, cls: '' };
    case 'first-icon':
      return { svg: sourceSvg, cls: '' };
    case 'last-icon':
      return { svg: targetSvg || sourceSvg, cls: '' };
    default:
      return { svg: sourceSvg, cls: '' };
  }
}

// First card
const firstState: CardState = recipe?.first || 'static';
const firstCard = renderCardState(firstState);

// Action stages
interface ActionStageResolved {
  svg: string;
  word: string;
}

let resolvedActions: ActionStageResolved[];
if (recipe) {
  resolvedActions = recipe.actions.map(a => ({
    svg: getActionSvgByKey(a.icon) || getActionSvg(type, animation),
    word: a.word,
  }));
} else {
  // Fallback for micro / unknown: single action from animation key
  resolvedActions = [{
    svg: getActionSvg(type, animation),
    word: type === 'morph'
      ? 'changes to'
      : (animation ? (actionLabels[animation] || animation) : type),
  }];
}

// End card — only if recipe defines one (micro has no end card by default)
const hasEndCard = !!recipe && type !== 'micro';
const endState: CardState = recipe?.end || 'static';
const endCard = renderCardState(endState);
const endName = endState === 'last-icon' ? resolvedTargetName : displayName;

// Words — recipe template, interpolated — or fallback
const words = recipe
  ? recipe.words.replace('{name}', displayName).replace('{target}', resolvedTargetName)
  : (type === 'micro' && animation
      ? `${displayName} ${animWords[animation] || 'animates'}`
      : `${displayName} animates`);

const ariaLabel = `Animation: ${words}`;

// Arrow SVG — Phosphor arrow-right bold
const arrowSvg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" width="24" height="24"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69l-58.35-58.34a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/></svg>';

// Label for action stages — "Next" for first, "Then" for subsequent
function actionLabelText(index: number): string {
  return index === 0 ? 'Next' : 'Then';
}
function actionPosClass(index: number): string {
  return index === 0 ? 'anim-explainer__pos--next' : 'anim-explainer__pos--then';
}
---

<span class:list={['anim-explainer', color && `color--${color}`, className]}
  role="img" aria-label={ariaLabel} data-anim-seq>

  {/* ── First: source element ─── */}
  <span class="anim-explainer__pos anim-explainer__pos--first" aria-hidden="true">
    <span class="anim-seq-card">
      <span class="anim-seq-card__label">First</span>
      <span class:list={['anim-seq-card__icon', firstCard.cls]}><Fragment set:html={firstCard.svg} /></span>
      <span class="anim-seq-card__name">{displayName}</span>
    </span>
  </span>

  {/* ── Action stages (Next, Then, Then...) ─── */}
  {resolvedActions.map((action, i) => (
    <>
      <span class="anim-explainer__arrow" aria-hidden="true">
        <Fragment set:html={arrowSvg} />
      </span>
      <span class={`anim-explainer__pos ${actionPosClass(i)}`} aria-hidden="true">
        <span class="anim-seq-card">
          <span class="anim-seq-card__label">{actionLabelText(i)}</span>
          <span class="anim-seq-card__icon"><Fragment set:html={action.svg} /></span>
          <span class="anim-seq-card__name">{action.word}</span>
        </span>
      </span>
    </>
  ))}

  {/* ── End: final state ─── */}
  {hasEndCard && (
    <>
      <span class="anim-explainer__arrow" aria-hidden="true">
        <Fragment set:html={arrowSvg} />
      </span>
      <span class="anim-explainer__pos anim-explainer__pos--end" aria-hidden="true">
        <span class="anim-seq-card">
          <span class="anim-seq-card__label">End</span>
          <span class:list={['anim-seq-card__icon', endCard.cls]}><Fragment set:html={endCard.svg} /></span>
          <span class="anim-seq-card__name">{endName}</span>
        </span>
      </span>
    </>
  )}

  <span class="anim-explainer__arrow anim-explainer__arrow--before-words" aria-hidden="true">
    <Fragment set:html={arrowSvg} />
  </span>

  {/* ── Words: text description (screen reader + learners) ─── */}
  <span class="anim-explainer__pos anim-explainer__pos--words">
    <span class="anim-seq-card anim-seq-card--words">
      <span class="anim-seq-card__name">{words}</span>
    </span>
  </span>
</span>
