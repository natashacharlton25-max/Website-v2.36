---
/**
 * AnimExplainer — AAC animation sequence cards
 *
 * Own card class (anim-seq-card) — isolated from AacCard's
 * cognitive level filtering, pictogram filters, and core-tier
 * colours. Same visual pattern, separate CSS namespace.
 *
 * Card patterns:
 *   Morph:  First (icon A) → Next (swap) → Then (icon B) → Words
 *   Draw:   First (ghost)  → Next (scribble) → Then (drawn) → Words
 *   Fill:   First (ghost)  → Next (resize) → Then (filled) → Words
 *   Micro:  First (static) → Next (motion icon) → Words
 *
 * Display gated by data-anim-explainer on <html>.
 * Content mode gated by data-anim-seq-mode on <html>.
 * Runtime behaviour (bar, tooltip) via figcaption.ts.
 */

import { animWords, typeWords, getActionSvg } from './anim-explainer-data';

type AnimType = 'morph' | 'draw' | 'fill' | 'micro';

interface Props {
  type: AnimType;
  sourceSvg: string;
  targetSvg?: string;
  displayName: string;
  targetName?: string;
  animation?: string;
  color?: string | null;
  class?: string;
}

const {
  type, sourceSvg, targetSvg, displayName, targetName,
  animation, color, class: className,
} = Astro.props;

const resolvedTargetName = targetName || displayName;
const actionPhrase = type === 'micro'
  ? (animation ? (animWords[animation] || 'animates') : 'animates')
  : type === 'morph'
    ? `changes to ${resolvedTargetName}`
    : (typeWords[type] || 'animates');
const words = `${displayName} ${actionPhrase}`;
const ariaLabel = `Animation: ${words}`;
// Morph, draw, fill all get a Then card (completed state)
const hasThenCard = type === 'morph' || type === 'draw' || type === 'fill';
const actionSvg = getActionSvg(type, animation);
const actionWord = type === 'morph' ? 'changes to' : (animation || type);

// Arrow SVG — Phosphor arrow-right bold
const arrowSvg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" width="24" height="24"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69l-58.35-58.34a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/></svg>';
---

<span class:list={['anim-explainer', color && `color--${color}`, className]}
  role="img" aria-label={ariaLabel} data-anim-seq>

  {/* ── First: source element ─── */}
  <span class="anim-explainer__pos anim-explainer__pos--first" aria-hidden="true">
    <span class="anim-seq-card">
      <span class="anim-seq-card__label">First</span>
      <span class="anim-seq-card__icon"><Fragment set:html={sourceSvg} /></span>
      <span class="anim-seq-card__name">{displayName}</span>
    </span>
  </span>

  <span class="anim-explainer__arrow" aria-hidden="true">
    <Fragment set:html={arrowSvg} />
  </span>

  {/* ── Next: action icon ─── */}
  <span class="anim-explainer__pos anim-explainer__pos--next" aria-hidden="true">
    <span class="anim-seq-card">
      <span class="anim-seq-card__label">Next</span>
      <span class="anim-seq-card__icon"><Fragment set:html={actionSvg} /></span>
      <span class="anim-seq-card__name">{actionWord}</span>
    </span>
  </span>

  {hasThenCard && (
    <>
      <span class="anim-explainer__arrow" aria-hidden="true">
        <Fragment set:html={arrowSvg} />
      </span>

      {/* ── Then: completed state (morph=target, draw/fill=full colour icon) ─── */}
      <span class="anim-explainer__pos anim-explainer__pos--then" aria-hidden="true">
        <span class="anim-seq-card">
          <span class="anim-seq-card__label">Then</span>
          <span class="anim-seq-card__icon">
            <Fragment set:html={type === 'morph' && targetSvg ? targetSvg : sourceSvg} />
          </span>
          <span class="anim-seq-card__name">{type === 'morph' ? resolvedTargetName : displayName}</span>
        </span>
      </span>
    </>
  )}

  <span class="anim-explainer__arrow anim-explainer__arrow--before-words" aria-hidden="true">
    <Fragment set:html={arrowSvg} />
  </span>

  {/* ── Words: text description (screen reader + learners) ─── */}
  <span class="anim-explainer__pos anim-explainer__pos--words">
    <span class="anim-seq-card anim-seq-card--words">
      <span class="anim-seq-card__name">{words}</span>
    </span>
  </span>
</span>
