---
/**
 * InlineSvg — central registry for hardcoded inline SVG icons used across
 * the project. Different from the Icon atom (which fetches from the Asset
 * Library API). These are tiny chrome SVGs that need to render
 * synchronously with no network — external link indicators, download
 * arrows, etc.
 *
 * Usage:
 *   import InlineSvg from '../../components/InlineSvg.astro';
 *   <InlineSvg name="external" class="link__icon link__icon--external" />
 *
 * To add a new icon:
 *   1. Add the slug to the `name` prop union below
 *   2. Add a corresponding {name === '...' && (<svg>...</svg>)} block
 *   3. Use viewBox 0 0 256 256 for Phosphor-style icons (1em sizes nicely)
 *
 * All SVGs use currentColor + aria-hidden — colour is inherited from the
 * parent text colour, screen readers ignore them (they're decorative; the
 * <a> href + label carry the meaning).
 */
interface Props {
  name: 'external' | 'download';
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

{name === 'external' && (
  <svg
    class={className}
    viewBox="0 0 256 256"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="20"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <polyline points="144 40 216 40 216 112" />
    <line x1="216" y1="40" x2="112" y2="144" />
    <path d="M184 144v64a8 8 0 0 1-8 8H48a8 8 0 0 1-8-8V80a8 8 0 0 1 8-8h64" />
  </svg>
)}

{name === 'download' && (
  <svg
    class={className}
    viewBox="0 0 256 256"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="20"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <line x1="128" y1="144" x2="128" y2="32" />
    <polyline points="216 144 216 208 40 208 40 144" />
    <polyline points="168 104 128 144 88 104" />
  </svg>
)}
