---
import Button from '../Button/Button.astro';

interface Props {
  emptyMessage?: string;
  browseHref?: string;
  browseText?: string;
}

const {
  emptyMessage = "No downloads selected",
  browseHref = "/assets",
  browseText = "Browse Resources"
} = Astro.props;
---

<div class="download-summary">
  <div id="order-items" class="download-summary__items">
    <!-- Items will be populated from cart -->
    <div class="download-summary__empty">
      <p>{emptyMessage}</p>
      <Button href={browseHref} variant="outline" size="sm">{browseText}</Button>
    </div>
  </div>
</div>

<script>
  // Load cart items and populate download summary
  function loadDownloadItems() {
    const cartData = localStorage.getItem('cartItems');
    if (!cartData) return;

    try {
      const cartItems = JSON.parse(cartData);
      if (!Array.isArray(cartItems) || cartItems.length === 0) return;

      const orderItemsContainer = document.getElementById('order-items');
      if (!orderItemsContainer) return;

      // Clear empty message
      orderItemsContainer.innerHTML = '';

      // Populate items (compact list view)
      cartItems.forEach((item: any) => {
        const itemEl = document.createElement('div');
        itemEl.className = 'download-summary__item';
        itemEl.innerHTML = `
          <div class="download-summary__item-info">
            <div class="download-summary__item-image">
              <img src="${item.image || ''}" alt="${item.name}" onerror="if(!this.dataset.fallback){this.dataset.fallback='1';this.src='/MiniKart/MiniKart-Fallback-'+Math.ceil(Math.random()*10)+'.png';}" />
            </div>
            <div class="download-summary__item-details">
              <span class="download-summary__item-name">${item.name}</span>
            </div>
          </div>
          <span class="download-summary__badge">FREE</span>
        `;
        orderItemsContainer.appendChild(itemEl);
      });
    } catch (error) {
      console.error('Error loading cart:', error);
    }
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', () => {
    loadDownloadItems();
  });
</script>

<style is:global>
  .download-summary {
    /* No extra padding - parent card handles it */
  }

  .download-summary__items {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-height: 300px;
    overflow-y: auto;
  }

  .download-summary__empty {
    text-align: center;
    padding: var(--space-lg) var(--space-md);
    color: var(--color-Text-500);
  }

  .download-summary__empty p {
    margin-bottom: var(--space-sm);
    font-size: var(--text-xs);
  }

  .download-summary__item {
    display: flex;
    flex-direction: row !important;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--color-Neutral-100);
    border-radius: var(--border-radius-lg);
    margin-bottom: var(--space-sm);
  }

  .download-summary__item:last-child {
    margin-bottom: 0;
  }

  .download-summary__item-info {
    display: flex;
    flex-direction: row !important;
    gap: var(--space-sm);
    flex: 1;
    min-width: 0;
    align-items: center;
  }

  .download-summary__item-image {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    overflow: hidden;
    background-color: var(--color-Neutral-100);
    flex-shrink: 0;
  }

  .download-summary__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .download-summary__item-details {
    flex: 1;
    min-width: 0;
  }

  .download-summary__item-name {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    margin: 0;
    color: var(--color-Text-700);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }

  .download-summary__badge {
    padding: 4px 8px;
    background-color: var(--color-Primary-50);
    color: var(--color-Primary-600);
    border-radius: 4px;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  /* ========== RESPONSIVE - SMALL (400px) ========== */
  @media (max-width: 400px) {
    .download-summary__items {
      max-height: 200px;
    }

    .download-summary__item {
      padding: var(--space-xs) var(--space-sm);
      gap: var(--space-sm);
    }

    .download-summary__item-image {
      width: 32px;
      height: 32px;
    }

    .download-summary__item-name {
      font-size: var(--text-xs);
    }

    .download-summary__badge {
      padding: 2px 6px;
      font-size: 10px;
    }

    .download-summary__empty {
      padding: var(--space-md) var(--space-sm);
    }

    .download-summary__empty p {
      font-size: 10px;
    }
  }

  /* ========== RESPONSIVE - VERY SMALL (300px) ========== */
  @media (max-width: 300px) {
    .download-summary__item {
      flex-direction: column !important;
      align-items: center;
      text-align: center;
      gap: var(--space-xs);
    }

    .download-summary__item-info {
      flex-direction: column !important;
      align-items: center;
      text-align: center;
    }

    .download-summary__item-name {
      white-space: normal;
      text-align: center;
    }

    .download-summary__badge {
      align-self: center;
    }
  }

  /* ========== RESPONSIVE - TINY (200px) ========== */
  @media (max-width: 200px) {
    .download-summary__items {
      max-height: 150px;
    }

    .download-summary__item {
      padding: var(--space-xs);
    }

    .download-summary__item-image {
      width: 28px;
      height: 28px;
    }

    .download-summary__item-name {
      font-size: 10px;
    }

    .download-summary__badge {
      font-size: 8px;
      padding: 2px 4px;
    }
  }
</style>
