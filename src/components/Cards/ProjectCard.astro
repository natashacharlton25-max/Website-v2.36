---
/**
 * ProjectCard - Project showcase section with alternating image/text layout
 *
 * Displays project information with image on left or right
 * Used on projects page to showcase curated resource collections
 *
 * Props:
 * @param slug - Project URL slug
 * @param title - Project title
 * @param description - Project description
 * @param category - Project category label
 * @param cardImage - Project image (imported from astro:assets)
 * @param scrollBg - Optional background color for scroll trigger (e.g., 'var(--color-AccentOne-300)')
 * @param imagePosition - 'left' or 'right' (default: 'left')
 */

import { Image } from 'astro:assets';
import Button from '../Button/Button.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  cardImage: ImageMetadata;
  scrollBg?: string;
  imagePosition?: 'left' | 'right';
}

const {
  slug,
  title,
  description,
  category,
  cardImage,
  scrollBg,
  imagePosition = 'left'
} = Astro.props;

const layoutClass = imagePosition === 'left' ? 'image-left' : 'image-right';
---

<section
  class={`project-card ${layoutClass}`}
  data-scroll-bg={scrollBg}
>
  <div class="container">
    <div class="project-card__wrapper">
      <div class="img-defaut project-card__image">
        <Image src={cardImage} alt={title} loading="lazy" />
      </div>
      <div class="card-transparent project-card__content">
        <span class="project-card__category">{category}</span>
        <h2 class="project-card__title">{title}</h2>
        <p class="project-card__description">{description}</p>
        <div class="project-card__cta">
          <Button href={`/projects/${slug}`} variant="primary">
            View Project
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ========== PROJECT CARD SECTION ========== */
  .project-card {
    padding: var(--space-5xl) 0;
    transition: opacity var(--transition-base);
    background-color: transparent; /* Let ScrollColorBackground show through */
  }

  /* ========== PROJECT WRAPPER ========== */
  .project-card__wrapper {
    display: flex;
    gap: var(--space-3xl);
    align-items: center;
  }

  /* ========== IMAGE LEFT LAYOUT ========== */
  .image-left .project-card__wrapper {
    flex-direction: row;
  }

  /* ========== IMAGE RIGHT LAYOUT ========== */
  .image-right .project-card__wrapper {
    flex-direction: row-reverse;
  }

  /* ========== IMAGE CONTAINER ========== */
  .project-card__image {
    flex-shrink: 0;
    width: 50%;
    height: var(--img-height-lg);
    position: relative;
    overflow: hidden;
    border-radius: 3rem;
  }

  .project-card__image picture {
    width: 100%;
    height: 100%;
    display: block;
  }

  .project-card__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: inherit;
  }



  /* ========== TEXT CONTENT ========== */
  .project-card__content {
    flex: 1;
  }

  .image-left .project-card__content {
    padding-left: var(--space-sm);
    text-align: left;
  }

  .image-right .project-card__content {
    padding-right: var(--space-sm);
    text-align: right;
  }

  /* ========== CATEGORY LABEL ========== */
  .project-card__category {
    display: block;
    font-size: var(--text-md);
    font-weight: var(--font-semibold);
    color: var(--color-Primary-600);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
  }

  /* ========== TITLE ========== */
  .project-card__title {
    margin-bottom: var(--space-lg);
    color: var(--color-Text-800);
    line-height: 1.2;
  }

  /* ========== DESCRIPTION ========== */
  .project-card__description {
    line-height: 1.7;
    color: var(--color-Text-700);
    margin-bottom: var(--space-xl);
  }

  /* ========== CTA BUTTON ========== */
  .project-card__cta {
    margin-top: var(--space-lg);
  }

  .image-right .project-card__cta {
    display: flex;
    justify-content: flex-end;
  }

  /* ========== RESPONSIVE - TABLET (800px) ========== */
  @media (max-width: 800px) {
    .project-card {
      padding: var(--space-3xl) 0;
    }

    .project-card__wrapper {
      flex-direction: column !important;
      gap: var(--space-xl);
    }

    .project-card__image {
      width: 100%;
      height: auto;
      aspect-ratio: 4/3;
      max-height: 400px;
      border-radius: 2rem;
    }

    .project-card__image img {
      border-radius: 2rem;
    }

    .project-card__content {
      padding-left: 0 !important;
      padding-right: 0 !important;
      text-align: center !important;
    }

    .project-card__cta {
      justify-content: center !important;
      display: flex;
    }
  }

  /* ========== RESPONSIVE - PHONE (480px) ========== */
  @media (max-width: 480px) {
    .project-card {
      padding: var(--space-2xl) 0;
    }

    .project-card__wrapper {
      gap: var(--space-lg);
    }

    .project-card__image {
      max-height: 300px;
      border-radius: 1.5rem;
    }

    .project-card__image img {
      border-radius: 1.5rem;
    }

    .project-card__category {
      font-size: var(--text-sm);
    }

    .project-card__description {
      font-size: var(--text-sm);
    }
  }

  /* ========== RESPONSIVE - SMALL MOBILE (300px) ========== */
  @media (max-width: 300px) {
    .project-card {
      padding: var(--space-xl) 0;
    }

    .project-card__image {
      max-height: 200px;
      border-radius: 1rem;
    }

    .project-card__image img {
      border-radius: 1rem;
    }

    .project-card__category {
      font-size: var(--text-xs);
    }

    .project-card__title {
      font-size: var(--text-xl);
    }

    .project-card__description {
      font-size: var(--text-xs);
    }
  }
</style>
