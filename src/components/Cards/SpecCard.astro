---
import Icon from '../Icons/Icon.astro';

interface Props {
  iconName: string; // Icon name (e.g., 'file-pdf-fill' or 'spec-cards/file-pdf-fill')
  label: string;
  value: string;
  variant?: 'primary' | 'secondary' | 'accent';
}

const { iconName, label, value, variant = 'primary' } = Astro.props;
---

<div class={`spec-card spec-card--${variant}`}>
  <div class="spec-card__icon">
    <Icon name={iconName} size={40} />
  </div>
  <div class="spec-card__content">
    <span class="spec-card__label">{label}</span>
    <span class="spec-card__value">{value}</span>
  </div>
</div>

<style>
  .spec-card {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-Neutral-200);
    border-radius: var(--border-radius-md);
    transition: all var(--transition-base);
  }

  .spec-card:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .spec-card__icon {
    flex-shrink: 1;
    color: var(--color-Primary-800);

  }

  .spec-card__icon :global(.icon) {
    width: 35px;
    height: 35px;
  }

  .spec-card__icon :global(svg) {
    width: 35px;
    height: 35px;
  }

  .spec-card__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .spec-card__label {
    font-size: var(--text-md);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-Text-500);
  }

  .spec-card__value {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    line-height: var(--leading-normal);
    color: var(--color-Text-700);
  }


</style>
