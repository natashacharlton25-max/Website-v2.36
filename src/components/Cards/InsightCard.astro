---
/**
 * InsightCard - Reusable insight/article card component
 *
 * Used on insights page for both insights and presentations
 *
 * Props:
 * @param slug - Article slug for URL
 * @param title - Article title
 * @param excerpt - Article excerpt/description
 * @param cardImage - Article card image (ImageMetadata)
 * @param category - Article category
 * @param readTime - Read time or section count
 * @param type - Content type (insight, presentation) - used for URL routing and filtering
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Badge from '../Badge/Badge.astro';
import Button from '../Button/Button.astro';
import Icon from '../Icons/Icon.astro';

interface Props {
  slug: string;
  title: string;
  excerpt: string;
  cardImage: ImageMetadata;
  category: string;
  readTime: string;
  type: 'insight' | 'presentation';
}

const {
  slug,
  title,
  excerpt,
  cardImage,
  category,
  readTime,
  type
} = Astro.props;

const href = type === 'presentation' ? `/presentations/${slug}` : `/insights/${slug}`;
const categoryId = category.toLowerCase().replace(/\s+/g, '-');
const ctaText = type === 'presentation' ? 'View Presentation' : 'Read Article';
---

<a href={href} class={`card insight-card ${categoryId}`} data-category={categoryId}>
  <div class="insight-card__image">
    <Image src={cardImage} alt={title} width={800} height={500} loading="lazy" />
  </div>

  <div class="insight-card__content">
    <div class="insight-card__badge">
      <Badge type={category} label={category} shape="pill" variant="fill" size="sm" shadow="drop"/>
    </div>
    <div class="insight-card__meta">
      <span class="insight-card__read-time">{readTime}</span>
    </div>
    <h2 class="insight-card__title">{title}</h2>
    <p class="insight-card__excerpt">{excerpt}</p>
    <div class="insight-card__cta">
      <Button variant="outline" size="sm">
        {ctaText}
      </Button>
    </div>
  </div>
</a>

<style>
  /* Insight Card - BEM naming */
  /* Float-based layout for Isotope masonry */
  .insight-card {
    float: left;
    width: calc(33.333% - 1.5em - 4px); /* Subtract 4px for 2px border on each side */
    margin: 0.75em;
    padding: var(--space-md);
    padding-bottom: var(--space-md); /* Content section has its own padding */
    box-sizing: border-box;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in oklch, var(--brand-c-primary-dark) 35%, transparent);
    background-color: transparent;
  }

  .insight-card:hover {
    box-shadow: var(--shadow-lg);
    border-color: var(--brand-c-primary-dark);
    transform: none !important;
  }

  .insight-card__image {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

   .insight-card:hover .insight-card__image {
    box-shadow: var(--shadow-xl);
    border: 1px solid color-mix(in oklch, var(--brand-c-primary-dark) 60%, transparent);
  
  }
  

  .insight-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .insight-card__badge {
    margin-bottom: var(--space-sm);
  }

  .insight-card__content {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .insight-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .insight-card__read-time {
    color: var(--brand-c-text-light);
  }

  .insight-card__title {
    font-weight: var(--font-bold);
    color: var(--brand-c-text);
    margin-bottom: var(--space-md);
    font-family: var(--font-heading);
    line-height: 1.3;
  }

  .insight-card__excerpt {
    color: var(--brand-c-text);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-lg);
    flex: 1;
  }

  .insight-card__cta {
    display: flex;
  }

  /* ========== RESPONSIVE - TABLET ========== */
  @media (max-width: 1023px) {
    .insight-card {
      width: calc(50% - 1.5em - 4px);
    }
  }

  /* ========== RESPONSIVE - MOBILE ========== */
  @media (max-width: 767px) {
    .insight-card {
      width: calc(100% - 1.5em - 4px);
      margin: 0.5em;
    }
  }

  @media (max-width: 600px) {
    .insight-card {
      border-radius: 1.5rem;
    }

    .insight-card__image {
      border-radius: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .insight-card {
      width: calc(100% - 1em - 4px);
      margin: 0.35em;
      text-align: center;
      border-radius: 1.5rem;
    }

    .insight-card__badge {
      display: flex;
      justify-content: center;
    }

    .insight-card__image {
      border-radius: 1.25rem;
    }

    .insight-card__content {
      text-align: center;
      padding: var(--space-md);
    }

    .insight-card__meta {
      justify-content: center;
    }

    .insight-card__cta {
      justify-content: center;
    }

    .insight-card__title {
    }

    .insight-card__excerpt {
    }
  }

  @media (max-width: 400px) {
    .insight-card {
      border-radius: 1.25rem;
    }

    .insight-card__image {
      border-radius: 1rem;
    }
  }

  @media (max-width: 350px) {
    .insight-card {
      width: calc(100% - 0.5em - 4px);
      margin: 0.25em;
      border-radius: 1.25rem;
    }

    .insight-card__image {
      border-radius: 1rem;
    }

    .insight-card__title {
    }

    .insight-card__excerpt {
    }

    .insight-card__read-time {
    }
  }

  @media (max-width: 300px) {
    .insight-card {
      padding: var(--space-sm);
      border-radius: 1rem;
    }

    .insight-card__badge {
      margin-bottom: var(--space-xs);
    }

    .insight-card__image {
      border-radius: 0.75rem;
    }

    .insight-card__content {
      padding: var(--space-xs);
    }

    .insight-card__title {
      margin-bottom: var(--space-sm);
    }

    .insight-card__excerpt {
      font-size: calc(var(--text-fine) * 0.9);
      margin-bottom: var(--space-sm);
    }
  }

  @media (max-width: 200px) {
    .insight-card {
      padding: var(--space-xs);
      border-radius: 0.75rem;
    }

    .insight-card__image {
      aspect-ratio: 4 / 3;
      border-radius: 0.5rem;
    }

    .insight-card__badge {
      margin-bottom: calc(var(--space-xs) * 0.5);
    }

    .insight-card__content {
      padding: var(--space-xs);
    }

    .insight-card__title {
    }

    .insight-card__excerpt {
      display: none;
    }

    .insight-card__meta {
      margin-bottom: var(--space-xs);
    }
  }

  /* ========== REDUCED MOTION ========== */
  /* No visual change on hover - keep base state */
  :global(#a11y-content-wrapper.a11y-reduce-motion) .insight-card {
    transition: none !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .insight-card:hover {
    box-shadow: var(--shadow) !important;
    border-color: transparent !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .insight-card__image {
    transition: none !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .insight-card:hover .insight-card__image {
    box-shadow: var(--shadow-sm) !important;
    border: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .insight-card {
      transition: none;
    }

    .insight-card:hover {
      box-shadow: var(--shadow);
      border-color: transparent;
      transform: none;
    }

    .insight-card__image {
      transition: none;
    }

    .insight-card:hover .insight-card__image {
      box-shadow: var(--shadow-sm);
      border: none;
    }
  }
</style>
