---
/**
 * FooterWithMask - Footer with optional canvas reveal animation
 *
 * Props:
 * - animated: boolean (default: true) - Enable/disable canvas animation
 * - backgroundImage: string - Image for reveal animation
 *
 * Usage:
 * <FooterWithMask /> <!-- Animated footer -->
 * <FooterWithMask animated={false} /> <!-- Plain footer -->
 */
import Footer from './Footer.astro';
import RevealCanvas from '../Canvas/RevealCanvas.astro';
import { BRAND_CONFIG } from '../../lib/config/brand';

export interface Props {
  /** Enable canvas reveal animation (default: true) */
  animated?: boolean;
  /** Background image for reveal effect */
  backgroundImage?: string;
}

const {
  animated = true,
  backgroundImage = BRAND_CONFIG.footer.defaultImage
} = Astro.props;
---

{animated ? (
  <!-- Animated footer with canvas reveal -->
  <div class="footer-mask">
    <RevealCanvas
      backgroundImage={backgroundImage}
      canvasId="footer-canvas"
      minHeight="600px"
    />
    <div class="footer-mask__content">
      <Footer variant="light" />
    </div>
  </div>
) : (
  <!-- Plain footer without animation -->
  <Footer variant="dark" />
)}

<style is:global>
  /* ========== FOOTER MASK WRAPPER ========== */
  .footer-mask {
    position: relative;
    width: 100%;
    overflow: hidden;
    min-height: 600px;
    background: var(--brand-c-bg);
  }

  /* ========== FOOTER CONTENT OVERLAY ========== */
  .footer-mask__content {
    position: relative;
    z-index: 10;
    pointer-events: none;
  }

  /* Re-enable pointer events for interactive elements */
  .footer-mask__content a,
  .footer-mask__content button {
    pointer-events: auto;
  }

  /* Make footer background transparent to show canvas */
  .footer-mask__content .footer {
    background-color: transparent;
  }

  /* Add text shadow to improve readability over canvas */
  .footer-mask__content .footer__brand-name,
  .footer-mask__content .footer__description,
  .footer-mask__content .footer__copyright {
    text-shadow: var(--space-xs) var(--space-xs) var(--space-md) var(--brand-c-bg);
  }

  /* ========== RESPONSIVE - TABLET ========== */
  @media (max-width: 768px) {
    .footer-mask {
      min-height: 500px;
    }
  }

  /* ========== RESPONSIVE - PHONE ========== */
  @media (max-width: 640px) {
    .footer-mask {
      min-height: 450px;
    }
  }

  /* ========== RESPONSIVE - EXTRA SMALL ========== */
  @media (max-width: 400px) {
    .footer-mask {
      min-height: 400px;
    }
  }

  /* ========== RESPONSIVE - ULTRA SMALL ========== */
  @media (max-width: 280px) {
    .footer-mask {
      min-height: 350px;
    }
  }

  /* ========== RESPONSIVE - MICRO ========== */
  @media (max-width: 200px) {
    .footer-mask {
      min-height: 300px;
    }
  }

  /* ========== REDUCED MOTION FALLBACK ========== */
  @media (prefers-reduced-motion: reduce) {
    .footer-mask {
      min-height: auto;
    }

    .footer-mask__content .footer {
      background-color: var(--brand-c-bg);
    }

    .footer-mask__content .footer__brand-name,
    .footer-mask__content .footer__description,
    .footer-mask__content .footer__copyright {
      text-shadow: none;
    }
  }
</style>
