---
/**
 * Footer - Base footer component
 * Used standalone or wrapped by FooterWithMask for canvas reveal effect
 *
 * CSS Standards Compliant:
 * - BEM-lite naming (.footer, .footer__container, .footer__section, etc)
 * - Global typography - no font overrides in component
 * - All design tokens from tokens/ folder
 * - No hardcoded values
 */
import { BRAND_CONFIG } from '../../lib/config/brand';

interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'dark' } = Astro.props;

// Footer navigation links
const footerLinks = [
  { label: 'Legal', href: '/legal/terms' },
  { label: 'Contact Us', href: '#', id: 'contactUsBtn', isButton: true },
  { label: 'Cookie Settings', href: '#', id: 'cookieSettings', isButton: true }
];
---

<footer class={`footer footer--${variant}`}>
  <div class="footer__container container container-7xl">
    <!-- Logo & Brand -->
    <div class="footer__brand-section">
      <img
        src="/Logo/BrandLogoFooter.png"
        alt={`${BRAND_CONFIG.name} logo`}
        class="footer__logo"
        width="120"
        height="120"
      />
      <h2 class="footer__brand-name">{BRAND_CONFIG.name}</h2>
    </div>

    <!-- Navigation Links -->
    <nav class="footer__nav" aria-label="Footer navigation">
      {footerLinks.map((link, index) => (
        <>
          {link.isButton ? (
            <button
              type="button"
              class="footer__link"
              id={link.id}
            >
              {link.label}
            </button>
          ) : (
            <a href={link.href} class="footer__link">
              {link.label}
            </a>
          )}
          {index < footerLinks.length - 1 && (
            <span class="footer__nav-dot" aria-hidden="true"></span>
          )}
        </>
      ))}
    </nav>

    <!-- Copyright -->
    <p class="footer__copyright">
      © {new Date().getFullYear()} <strong>{BRAND_CONFIG.name}</strong>. All rights reserved.
    </p>
  </div>
</footer>

<style>
  /* ========== FOOTER BASE ========== */
  .footer {
    width: 100%;
    padding: var(--space-4xl) 0 var(--space-lg);
    text-align: center;
  }

  /* ========== VARIANT - DARK ========== */
  .footer--dark {
    background: var(--color-Background-50);
    color: var(--color-Text-700);
  }

  .footer--dark .footer__brand-name {
    color: var(--color-Text-800);
  }

  .footer--dark .footer__link {
    color: var(--color-Text-700);
  }

  .footer--dark .footer__link:hover {
    color: var(--color-Text-900);
  }

  .footer--dark .footer__nav-dot {
    background: var(--color-Primary-500);
  }

  .footer--dark .footer__copyright {
    color: var(--color-Text-500);
  }

  .footer--dark .footer__copyright:hover {
    color: var(--color-Text-900);
  }

  /* ========== VARIANT - LIGHT ========== */
  /* Used with animated canvas - needs contrast for varying backgrounds */
  .footer--light {
    color: var(--color-Text-700);
  }

  .footer--light .footer__brand-name {
    color: var(--color-Text-800);
  }

  .footer--light .footer__link {
    color: var(--color-Text-600);
  }

  .footer--light .footer__link:hover {
    color: var(--color-Text-900);
  }

  .footer--light .footer__nav-dot {
    background: var(--color-Primary-500);
  }

  .footer--light .footer__copyright {
    color: var(--color-Text-500);
  }

  .footer--light .footer__copyright:hover {
    color: var(--color-Text-900);
  }

  /* ========== REVEAL ACTIVE STATE ========== */
  /* When cursor is interacting with the canvas reveal */
  .footer--light.footer--reveal-active .footer__link:hover {
    color: var(--color-White);
    text-shadow:
      -1px -1px 0 var(--color-Text-900),
      1px -1px 0 var(--color-Text-900),
      -1px 1px 0 var(--color-Text-900),
      1px 1px 0 var(--color-Text-900);
  }

  .footer--light.footer--reveal-active .footer__copyright:hover {
    color: var(--color-White);
    text-shadow:
      -1px -1px 0 var(--color-Text-900),
      1px -1px 0 var(--color-Text-900),
      -1px 1px 0 var(--color-Text-900),
      1px 1px 0 var(--color-Text-900);
  }

  /* ========== CONTAINER ========== */
  .footer__container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    max-width: 100%;
    width: 100%;
    margin: 0 auto;
    padding-left: var(--space-xl);
    padding-right: var(--space-xl);
  }

  /* ========== BRAND SECTION ========== */
  .footer__brand-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
  }

  .footer__logo {
    width: 180px;
    height: auto;
  }

  .footer__brand-name {
    font-family: var(--font-heading);
    font-size: var(--text-6xl);
    font-weight: var(--font-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0;
  }

  /* ========== NAVIGATION ========== */
  .footer__nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-extrabold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    transition: color var(--transition-fast);
    /* Ensure consistent alignment between <a> and <button> */
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    line-height: 1;
  }

  .footer__nav-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ========== COPYRIGHT ========== */
  .footer__copyright {
    font-size: var(--text-sm);
    font-style: italic;
    margin: 0;
    margin-top: var(--space-sm);
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 768px) {
    .footer {
      padding: var(--space-3xl) 0 var(--space-xl);
    }

    .footer__brand-name {
      font-size: var(--text-2xl);
    }

    .footer__nav {
      gap: var(--space-md);
    }

    .footer__link {
      font-size: var(--text-xs);
    }

    .footer__nav-dot {
      width: 6px;
      height: 6px;
    }
  }

  /* Stack nav items when they start wrapping awkwardly */
  @media (max-width: 600px) {
    .footer__nav {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .footer__nav-dot {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .footer {
      padding: var(--space-2xl) 0 var(--space-lg);
    }

    .footer__logo {
      width: 60px;
    }

    .footer__brand-name {
      font-size: var(--text-xl);
      letter-spacing: 0.05em;
    }
  }

  @media (max-width: 250px) {
    .footer {
      padding: var(--space-xl) 0 var(--space-md);
    }

    .footer__logo {
      width: 48px;
    }

    .footer__brand-name {
      font-size: var(--text-lg);
    }

    .footer__link {
      font-size: var(--text-xs);
    }

    .footer__copyright {
      font-size: var(--text-xs);
    }
  }

  /* ========== REDUCED MOTION ========== */
  @media (prefers-reduced-motion: reduce) {
    .footer__link {
      transition: none;
    }
  }
</style>

<script>
  // Wait for DOM to be ready before attaching event listeners
  function initFooterButtons() {
    // Contact Us button - opens contact popup
    const contactUsBtn = document.getElementById('contactUsBtn');
    if (contactUsBtn) {
      contactUsBtn.addEventListener('click', () => {
        if ((window as any).openContactPopup) {
          (window as any).openContactPopup();
        }
      });
    }

    // Cookie settings button - reopens cookie banner
    const cookieSettingsBtn = document.getElementById('cookieSettings');
    if (cookieSettingsBtn) {
      cookieSettingsBtn.addEventListener('click', () => {
        const cookieBanner = document.getElementById('cookieBanner');
        if (cookieBanner) {
          cookieBanner.classList.remove('hidden');
          cookieBanner.style.display = '';
        }
      });
    }
  }

  // Detect when cursor is interacting with reveal canvas
  function initRevealDetection() {
    const footerMask = document.querySelector('.footer-mask');
    const footer = document.querySelector('.footer--light');

    if (!footerMask || !footer) return;

    footerMask.addEventListener('mouseenter', () => {
      footer.classList.add('footer--reveal-active');
    });

    footerMask.addEventListener('mouseleave', () => {
      footer.classList.remove('footer--reveal-active');
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initFooterButtons();
    initRevealDetection();
  });
  document.addEventListener('astro:page-load', () => {
    initFooterButtons();
    initRevealDetection();
  });
</script>
