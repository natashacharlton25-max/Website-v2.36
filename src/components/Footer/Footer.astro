---
/**
 * Footer - Base footer component
 * Used standalone or wrapped by FooterWithMask for canvas reveal effect
 *
 * CSS Standards Compliant:
 * - BEM-lite naming (.footer, .footer__container, .footer__section, etc)
 * - Global typography - no font overrides in component
 * - All design tokens from tokens/ folder
 * - No hardcoded values
 */
import { BRAND_CONFIG } from '../../lib/config/brand';

interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'dark' } = Astro.props;

// Footer navigation links - all use <a> tags for consistent styling
const footerLinks = [
  { label: 'Legal', href: '/legal/terms' },
  { label: 'Contact Us', href: '#', id: 'contactUsBtn', isAction: true },
  { label: 'Cookie Settings', href: '#', id: 'cookieSettings', isAction: true }
];
---

<footer class={`footer footer--${variant}`}>
  <div class="footer__container container container-7xl">
    <!-- Logo & Brand -->
    <div class="footer__brand-section">
      <img
        src="/Logo/BrandLogoFooter.png"
        alt={`${BRAND_CONFIG.name} logo`}
        class="footer__logo"
        width="120"
        height="120"
      />
      <h2 class="footer__brand-name">{BRAND_CONFIG.name}</h2>
    </div>

    <!-- Navigation Links - All use <a> tags for consistent styling -->
    <nav class="footer__nav" aria-label="Footer navigation">
      {footerLinks.map((link, index) => (
        <>
          <a
            href={link.href}
            class="footer__link"
            id={link.id}
            role={link.isAction ? 'button' : undefined}
          >
            {link.label}
          </a>
          {index < footerLinks.length - 1 && (
            <span class="footer__nav-dot" aria-hidden="true"></span>
          )}
        </>
      ))}
    </nav>

    <!-- Copyright -->
    <p class="footer__copyright">
      © {new Date().getFullYear()} <strong>{BRAND_CONFIG.name}</strong>. All rights reserved.
    </p>
  </div>
</footer>

<style>
  /* ========== FOOTER BASE ========== */
  .footer {
    width: 100%;
    padding: var(--space-xl) 0 var(--space-lg);
    text-align: center;
  }

  /* ========== VARIANT - DARK ========== */
  .footer--dark {
    background: var(--color-Background-50);
    color: var(--color-Text-700);
  }

  .footer--dark .footer__brand-name {
    color: var(--color-Text-800);
  }

  .footer--dark .footer__link {
    color: var(--color-Primary-700);
  }

  .footer--dark .footer__link:hover {
    color: var(--color-Text-900);
  }

  .footer--dark .footer__nav-dot {
    background: var(--color-Primary-500);
  }

  .footer--dark .footer__copyright {
    color: var(--color-Text-500);
  }

  .footer--dark .footer__copyright:hover {
    color: var(--color-Text-900);
  }

  /* ========== VARIANT - LIGHT ========== */
  /* Used with animated canvas - needs contrast for varying backgrounds */
  .footer--light {
    color: var(--color-Text-700);
  }

  .footer--light .footer__brand-name {
    color: var(--color-Text-800);
  }

  .footer--light .footer__link {
    color: var(--color-Primary-700);
  }

  .footer--light .footer__link:hover {
    color: var(--color-Text-900);
  }

  .footer--light .footer__nav-dot {
    background: var(--color-Primary-500);
  }

  .footer--light .footer__copyright {
    color: var(--color-Text-500);
  }

  .footer--light .footer__copyright:hover {
    color: var(--color-Text-900);
  }

  /* ========== REVEAL ACTIVE STATE ========== */
  /* When cursor is interacting with the canvas reveal */
  .footer--light.footer--reveal-active .footer__link:hover {
    color: var(--color-Text-600);
    border-color: color-mix(in srgb, var(--color-Background-300) 40%, transparent);
  }

  .footer--light.footer--reveal-active .footer__copyright:hover {
    color: var(--color-Text-600);
    border-color: color-mix(in srgb, var(--color-Background-300) 40%, transparent);
  }

  /* ========== CONTAINER ========== */
  .footer__container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    max-width: 100%;
    width: 100%;
    margin: 0 auto;
    padding-left: var(--space-xl);
    padding-right: var(--space-xl);
  }

  /* ========== BRAND SECTION ========== */
  .footer__brand-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .footer__logo {
    width: 180px;
    height: auto;
  }

  .footer__brand-name {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0;
  }

  /* ========== NAVIGATION ========== */
  .footer__nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-extrabold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    background: color-mix(in srgb, var(--color-Background-100) 50%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    padding: var(--space-xs) var(--space-lg);
    margin: 0;
    cursor: pointer;
    transition: color var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast);
    /* Ensure consistent alignment between <a> and <button> */
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    line-height: 1;
  }

  .footer__nav-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ========== COPYRIGHT ========== */
  .footer__copyright {
    font-size: var(--text-sm);
    font-style: italic;
    margin: 0;
    margin-top: var(--space-sm);
    background: color-mix(in srgb, var(--color-Background-100) 50%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    padding: var(--space-xs) var(--space-lg);
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 768px) {
    .footer {
      padding: var(--space-lg) 0 var(--space-md);
    }

    .footer__brand-name {
      font-size: var(--text-2xl);
    }

    .footer__nav {
      gap: var(--space-md);
    }

    .footer__link {
      font-size: var(--text-xs);
    }

    .footer__nav-dot {
      width: 6px;
      height: 6px;
    }
  }

  /* Stack nav items when they start wrapping awkwardly */
  @media (max-width: 600px) {
    .footer__nav {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .footer__nav-dot {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .footer {
      padding: var(--space-md) 0 var(--space-sm);
    }

    .footer__container {
      padding-left: var(--space-md);
      padding-right: var(--space-md);
      gap: var(--space-md);
    }

    .footer__logo {
      width: 60px;
    }

    .footer__brand-name {
      font-size: var(--text-xl);
      letter-spacing: 0.05em;
    }
  }

  @media (max-width: 250px) {
    .footer {
      padding: var(--space-sm) 0 var(--space-xs);
    }

    .footer__container {
      padding-left: var(--space-sm);
      padding-right: var(--space-sm);
      gap: var(--space-sm);
    }

    .footer__logo {
      width: 48px;
    }

    .footer__brand-name {
      font-size: var(--text-lg);
      letter-spacing: 0;
      word-break: break-word;
    }

    .footer__link {
      font-size: var(--text-xs);
      padding: var(--space-xs) var(--space-sm);
    }

    .footer__copyright {
      font-size: var(--text-xs);
      padding: var(--space-xs) var(--space-sm);
      word-break: break-word;
    }
  }

  /* ========== HIGHLIGHT LINKS ========== */
  /* Ensure ALL footer links have same color when highlight-links is active */
  :global(#a11y-content-wrapper.a11y-highlight-links) .footer__link,
  :global(#a11y-content-wrapper.a11y-highlight-links) .footer--dark .footer__link,
  :global(#a11y-content-wrapper.a11y-highlight-links) .footer--light .footer__link {
    color: var(--color-Text-700) !important;
    text-decoration: underline !important;
    text-underline-offset: 3px !important;
    text-decoration-color: var(--color-Primary-500) !important;
    padding: var(--space-sm) var(--space-xl) !important;
  }

  :global(#a11y-content-wrapper.a11y-highlight-links) .footer__link:hover,
  :global(#a11y-content-wrapper.a11y-highlight-links) .footer--dark .footer__link:hover,
  :global(#a11y-content-wrapper.a11y-highlight-links) .footer--light .footer__link:hover {
    color: var(--color-Text-900) !important;
    text-decoration-thickness: 2px !important;
  }

  /* ========== REDUCED MOTION ========== */
  /* Class-based reduced motion - NO hover effects, no pointer cursor */
  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer__link {
    transition: none !important;
    cursor: default !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer__copyright {
    cursor: default !important;
  }

  /* Ensure all links same color - both <a> and <button> */
  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer--dark .footer__link,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer--dark a.footer__link,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer--dark button.footer__link {
    color: var(--color-Text-700) !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer--dark .footer__link:hover,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer--dark a.footer__link:hover,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer--dark button.footer__link:hover {
    color: var(--color-Text-700) !important;
    background: color-mix(in srgb, var(--color-Background-100) 50%, transparent) !important;
    border-color: transparent !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer--dark .footer__copyright:hover {
    color: var(--color-Text-500) !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer--light .footer__link,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer--light a.footer__link,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer--light button.footer__link {
    color: var(--color-Text-600) !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer--light .footer__link:hover,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer--light a.footer__link:hover,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer--light button.footer__link:hover {
    color: var(--color-Text-600) !important;
    text-shadow: none !important;
    background: color-mix(in srgb, var(--color-Background-100) 50%, transparent) !important;
    border-color: transparent !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer--light .footer__copyright:hover {
    color: var(--color-Text-500) !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer--light.footer--reveal-active .footer__link:hover {
    color: var(--color-Text-600) !important;
    text-shadow: none !important;
    background: color-mix(in srgb, var(--color-Background-100) 50%, transparent) !important;
    border-color: transparent !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .footer--light.footer--reveal-active .footer__copyright:hover {
    color: var(--color-Text-500) !important;
    text-shadow: none !important;
  }

  /* System preference reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .footer__link {
      transition: none;
      cursor: default;
    }

    .footer__copyright {
      cursor: default;
    }

    .footer--dark .footer__link,
    .footer--dark a.footer__link,
    .footer--dark button.footer__link {
      color: var(--color-Text-700);
    }

    .footer--dark .footer__link:hover {
      color: var(--color-Text-700);
      background: color-mix(in srgb, var(--color-Background-100) 50%, transparent);
      border-color: transparent;
    }

    .footer--dark .footer__copyright:hover {
      color: var(--color-Text-500);
    }

    .footer--light .footer__link,
    .footer--light a.footer__link,
    .footer--light button.footer__link {
      color: var(--color-Text-600);
    }

    .footer--light .footer__link:hover {
      color: var(--color-Text-600);
      background: color-mix(in srgb, var(--color-Background-100) 50%, transparent);
      border-color: transparent;
    }

    .footer--light .footer__copyright:hover {
      color: var(--color-Text-500);
    }

    .footer--light.footer--reveal-active .footer__link:hover {
      color: var(--color-Text-600);
      text-shadow: none;
      background: color-mix(in srgb, var(--color-Background-100) 50%, transparent);
      border-color: transparent;
    }

    .footer--light.footer--reveal-active .footer__copyright:hover {
      color: var(--color-Text-500);
      text-shadow: none;
    }
  }
</style>

<script>
  // Wait for DOM to be ready before attaching event listeners
  function initFooterLinks() {
    // Contact Us link - opens contact popup
    const contactUsLink = document.getElementById('contactUsBtn');
    if (contactUsLink) {
      contactUsLink.addEventListener('click', (e) => {
        e.preventDefault();
        if ((window as any).openContactPopup) {
          (window as any).openContactPopup();
        }
      });
    }

    // Cookie settings link - reopens cookie banner
    const cookieSettingsLink = document.getElementById('cookieSettings');
    if (cookieSettingsLink) {
      cookieSettingsLink.addEventListener('click', (e) => {
        e.preventDefault();
        const cookieBanner = document.getElementById('cookieBanner');
        if (cookieBanner) {
          cookieBanner.classList.remove('hidden');
          cookieBanner.style.display = '';
        }
      });
    }
  }

  // Detect when cursor is interacting with reveal canvas
  function initRevealDetection() {
    const footerMask = document.querySelector('.footer-mask');
    const footer = document.querySelector('.footer--light');

    if (!footerMask || !footer) return;

    footerMask.addEventListener('mouseenter', () => {
      footer.classList.add('footer--reveal-active');
    });

    footerMask.addEventListener('mouseleave', () => {
      footer.classList.remove('footer--reveal-active');
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initFooterLinks();
    initRevealDetection();
  });
  document.addEventListener('astro:page-load', () => {
    initFooterLinks();
    initRevealDetection();
  });
</script>
