---
/**
 * Tooltip — Passive contextual display atom
 *
 * Wraps a trigger element and shows content on hover/focus.
 * Two purpose modes:
 *   label — visual duplicate of trigger's aria-label (aria-hidden, decorative)
 *   info  — real content (consumer links via aria-describedby on their focusable)
 *
 * Fixed-position (viewport-level) — never clipped by overflow:hidden.
 * Tiny inline script reads trigger rect on hover/focus, sets CSS vars.
 * Animation gated by entrance prop.
 *
 * Styles: Tooltip.css | Tooltip.responsive.css
 *
 * Usage:
 *   <Tooltip text="Search" purpose="label">
 *     <Button aria-label="Search"><Icon name="magnifying-glass" /></Button>
 *   </Tooltip>
 *
 *   <Tooltip text="We'll email your links" purpose="info" id="email-tip">
 *     <FormField label="Email" type="email" aria-describedby="email-tip" />
 *   </Tooltip>
 *
 *   <Tooltip purpose="info" id="aac-tip">
 *     <Image slot="default" ... />
 *     <span slot="content">{aacCards}</span>
 *   </Tooltip>
 *
 * IMPORTANT: Tooltip content must be text or AAC cards only.
 * No links, buttons, or interactive elements — tooltips are
 * not focusable containers and interactive children break a11y.
 */
import { Text } from '../Text';

interface Props {
  text?: string;
  purpose: 'label' | 'info';
  id?: string;
  position?: 'top' | 'bottom' | 'left' | 'right';
  textTone?: 'light' | 'dark';
  class?: string;
}

const {
  text,
  purpose,
  id = `tooltip-${Math.random().toString(36).slice(2, 8)}`,
  position = 'top',
  textTone,
  class: className,
} = Astro.props;

const isLabel = purpose === 'label';

const wrapperClasses = [
  'tooltip',
  `tooltip--${purpose}`,
  `tooltip--${position}`,
  className,
];
---

<span class:list={wrapperClasses} data-tooltip-position={position}>
  <span class="tooltip__trigger" tabindex="0" aria-describedby={!isLabel ? id : undefined}>
    <slot />
  </span>

  <span
    class="tooltip__content"
    id={id}
    role="tooltip"
    {...(isLabel && { 'aria-hidden': 'true' })}
  >
    {text ? (
      <Text as="span" class="tooltip__text" textTone={textTone} flush>
        {text}
      </Text>
    ) : (
      <slot name="content" />
    )}
  </span>
</span>

<script>
  // Shared bottom bar element for textonly mode — persists text between tooltips
  let sharedBar: HTMLElement | null = null;
  let barHideTimeout: ReturnType<typeof setTimeout> | null = null;

  function getSharedBar(): HTMLElement {
    if (sharedBar) return sharedBar;
    const bar = document.createElement('div');
    bar.className = 'tooltip-bar';
    bar.setAttribute('role', 'status');
    bar.setAttribute('aria-live', 'polite');
    bar.style.cssText = `
      position: fixed; bottom: 0; left: 0; right: 0;
      z-index: var(--z-tooltip, 9000);
      text-align: center; white-space: normal;
      padding: var(--space-md, 12px) var(--space-lg, 24px);
      background: var(--page-bg-raised, #f5f5f5);
      color: var(--neutral-800, #333);
      border-top: 2px solid var(--primary-600, #666);
      font-weight: 500;
      opacity: 0; visibility: hidden;
      transition: opacity 0.2s ease, visibility 0.2s ease;
    `;
    document.body.appendChild(bar);
    sharedBar = bar;
    return bar;
  }

  function isBarMode(): boolean {
    const hover = document.body.dataset.hover;
    if (hover === 'none') return false; // hover none always = inline, no bar
    const render = document.body.dataset.render;
    const isMobile = window.innerWidth <= 640;
    return render === 'textonly' || isMobile;
  }

  function showBar(text: string): void {
    const bar = getSharedBar();
    // Cancel any pending hide — new tooltip keeps bar open
    if (barHideTimeout) { clearTimeout(barHideTimeout); barHideTimeout = null; }
    bar.textContent = text;
    bar.style.opacity = '1';
    bar.style.visibility = 'visible';
  }

  function hideBar(): void {
    // Cancel previous hide timer, restart fresh
    if (barHideTimeout) clearTimeout(barHideTimeout);
    barHideTimeout = setTimeout(() => {
      const bar = getSharedBar();
      bar.style.opacity = '0';
      bar.style.visibility = 'hidden';
      barHideTimeout = null;
    }, 2000); // 2s — generous for assistive users, bar lingers after leaving
  }

  function initTooltips() {
    document.querySelectorAll<HTMLElement>('.tooltip').forEach((wrapper) => {
      if (wrapper.dataset.tooltipInit) return;
      wrapper.dataset.tooltipInit = 'true';

      const triggerEl = wrapper.querySelector<HTMLElement>('.tooltip__trigger')!;
      const contentEl = wrapper.querySelector<HTMLElement>('.tooltip__content')!;
      if (!triggerEl || !contentEl) return;

      const position = wrapper.dataset.tooltipPosition || 'top';
      const inDialog = !!wrapper.closest('dialog');

      function updatePosition() {
        if (inDialog) return;

        const rect = triggerEl.getBoundingClientRect();
        let x = 0, y = 0;

        switch (position) {
          case 'top':
            x = rect.left + rect.width / 2;
            y = rect.top;
            break;
          case 'bottom':
            x = rect.left + rect.width / 2;
            y = rect.bottom;
            break;
          case 'left':
            x = rect.left;
            y = rect.top + rect.height / 2;
            break;
          case 'right':
            x = rect.right;
            y = rect.top + rect.height / 2;
            break;
        }

        contentEl.style.setProperty('--_tooltip-x', `${x}px`);
        contentEl.style.setProperty('--_tooltip-y', `${y}px`);
      }

      function onEnter() {
        if (isBarMode()) {
          const text = contentEl.textContent?.trim() || '';
          if (text) showBar(text);
        } else {
          updatePosition();
        }
      }

      function onLeave() {
        if (isBarMode()) {
          hideBar();
        }
      }

      wrapper.addEventListener('mouseenter', onEnter);
      wrapper.addEventListener('mouseleave', onLeave);
      wrapper.addEventListener('focusin', onEnter);
      wrapper.addEventListener('focusout', onLeave);

      // Reposition on resize
      let isVisible = false;
      wrapper.addEventListener('mouseenter', () => { isVisible = true; });
      wrapper.addEventListener('mouseleave', () => { isVisible = false; });

      const ro = new ResizeObserver(() => {
        if (isVisible && !isBarMode()) updatePosition();
      });
      ro.observe(triggerEl);
    });
  }

  // Scroll = user moved on, hide bar immediately
  window.addEventListener('scroll', () => {
    if (sharedBar && sharedBar.style.opacity === '1') {
      if (barHideTimeout) clearTimeout(barHideTimeout);
      sharedBar.style.opacity = '0';
      sharedBar.style.visibility = 'hidden';
    }
  }, { passive: true });

  // Hide bar when hover/render mode changes, kill bar entirely for hover none
  const barObserver = new MutationObserver(() => {
    if (sharedBar) {
      if (barHideTimeout) clearTimeout(barHideTimeout);
      sharedBar.style.opacity = '0';
      sharedBar.style.visibility = 'hidden';
      // Hover none = no bar ever
      if (document.body.dataset.hover === 'none') {
        sharedBar.style.display = 'none';
      } else {
        sharedBar.style.display = '';
      }
    }
  });
  barObserver.observe(document.body, {
    attributes: true,
    attributeFilter: ['data-hover', 'data-render']
  });

  initTooltips();
  document.addEventListener('astro:page-load', initTooltips);
</script>
