---
/**
 * Tooltip — Passive contextual display atom
 *
 * Wraps a trigger element and shows content on hover/focus.
 * Two purpose modes:
 *   label — visual duplicate of trigger's aria-label (aria-hidden, decorative)
 *   info  — real content (consumer links via aria-describedby on their focusable)
 *
 * Fixed-position (viewport-level) — never clipped by overflow:hidden.
 * Tiny inline script reads trigger rect on hover/focus, sets CSS vars.
 * Animation gated by entrance prop.
 *
 * Styles: Tooltip.css | Tooltip.responsive.css
 *
 * Usage:
 *   <Tooltip text="Search" purpose="label">
 *     <Button aria-label="Search"><Icon name="magnifying-glass" /></Button>
 *   </Tooltip>
 *
 *   <Tooltip text="We'll email your links" purpose="info" id="email-tip">
 *     <FormField label="Email" type="email" aria-describedby="email-tip" />
 *   </Tooltip>
 *
 *   <Tooltip purpose="info" id="aac-tip">
 *     <Image slot="default" ... />
 *     <span slot="content">{aacCards}</span>
 *   </Tooltip>
 *
 * IMPORTANT: Tooltip content must be text or AAC cards only.
 * No links, buttons, or interactive elements — tooltips are
 * not focusable containers and interactive children break a11y.
 */
import { Text } from '../Text';

interface Props {
  text?: string;
  purpose: 'label' | 'info';
  id?: string;
  position?: 'top' | 'bottom' | 'left' | 'right';
  textTone?: 'light' | 'dark';
  entrance?: 'fade' | 'scale' | 'slide';
  class?: string;
}

const {
  text,
  purpose,
  id = `tooltip-${Math.random().toString(36).slice(2, 8)}`,
  position = 'top',
  textTone,
  entrance,
  class: className,
} = Astro.props;

const isLabel = purpose === 'label';

const wrapperClasses = [
  'tooltip',
  `tooltip--${purpose}`,
  `tooltip--${position}`,
  entrance && `tooltip--animate-${entrance}`,
  className,
];
---

<span class:list={wrapperClasses} data-tooltip-position={position}>
  <span class="tooltip__trigger">
    <slot />
  </span>

  <span
    class="tooltip__content"
    id={id}
    role="tooltip"
    {...(isLabel && { 'aria-hidden': 'true' })}
  >
    {text ? (
      <Text as="span" class="tooltip__text" textTone={textTone} flush>
        {text}
      </Text>
    ) : (
      <slot name="content" />
    )}
  </span>
</span>

<script>
  function initTooltips() {
    document.querySelectorAll<HTMLElement>('.tooltip').forEach((wrapper) => {
      if (wrapper.dataset.tooltipInit) return;
      wrapper.dataset.tooltipInit = 'true';

      const triggerEl = wrapper.querySelector<HTMLElement>('.tooltip__trigger')!;
      const contentEl = wrapper.querySelector<HTMLElement>('.tooltip__content')!;
      if (!triggerEl || !contentEl) return;

      const position = wrapper.dataset.tooltipPosition || 'top';

      // Inside dialogs, CSS switches to position:absolute (no JS coords needed).
      // JS positioning only runs for non-dialog tooltips.
      const inDialog = !!wrapper.closest('dialog');

      function updatePosition() {
        if (inDialog) return;

        const rect = triggerEl.getBoundingClientRect();
        let x = 0, y = 0;

        switch (position) {
          case 'top':
            x = rect.left + rect.width / 2;
            y = rect.top;
            break;
          case 'bottom':
            x = rect.left + rect.width / 2;
            y = rect.bottom;
            break;
          case 'left':
            x = rect.left;
            y = rect.top + rect.height / 2;
            break;
          case 'right':
            x = rect.right;
            y = rect.top + rect.height / 2;
            break;
        }

        contentEl.style.setProperty('--_tooltip-x', `${x}px`);
        contentEl.style.setProperty('--_tooltip-y', `${y}px`);
      }

      wrapper.addEventListener('mouseenter', updatePosition);
      wrapper.addEventListener('focusin', updatePosition);

      // Reposition when trigger resizes (text-size change, zoom, layout shift)
      let isVisible = false;
      wrapper.addEventListener('mouseenter', () => { isVisible = true; });
      wrapper.addEventListener('mouseleave', () => { isVisible = false; });
      wrapper.addEventListener('focusin', () => { isVisible = true; });
      wrapper.addEventListener('focusout', () => { isVisible = false; });

      const ro = new ResizeObserver(() => {
        if (isVisible) updatePosition();
      });
      ro.observe(triggerEl);
    });
  }

  initTooltips();
  document.addEventListener('astro:page-load', initTooltips);
</script>
