{
  "component": "Accordion",
  "category": "atom",
  "renders": {
    "full": "Accordion.astro",
    "reduced": "Accordion.astro",
    "assistive": "Accordion.astro",
    "textonly": "Accordion.astro"
  },
  "notes": "Expandable panel group. Uses native <details>/<summary> for zero-JS fallback and AT support. Accordion mode: only one open. Independent mode: multiple open. Content fades in on open (gated by render mode).",

  "props": {
    "content": {
      "items": { "type": "array", "required": true, "description": "Array of {title, content, icon?, open?} objects." },
      "mode": { "type": "string", "required": false, "default": "accordion", "enum": ["accordion", "independent"], "description": "Accordion = one open at a time. Independent = multiple open." }
    },
    "visual": {},
    "colour": {
      "_description": "Pipeline-overridable colour tokens.",
      "bg":          { "type": "token", "required": false, "default": "page-bg-raised", "cssProperty": "--accordion-bg", "description": "Panel background." },
      "border":      { "type": "token", "required": false, "default": "brand-c-neutral-light", "cssProperty": "--accordion-border", "description": "Panel border colour." },
      "activeColor": { "type": "token", "required": false, "default": "brand-c-primary", "cssProperty": "--accordion-active-color", "description": "Active/open state colour." }
    },
    "animation": {}
  }
}
