---
/**
 * Text - Atomic typography primitive for body text
 *
 * Every piece of body text should go through this component.
 * Text.css is the single source of truth for all body text
 * typography on the site. Other components (Button, Link, List)
 * use .text as their base and add their own modifiers.
 *
 * Styles: Text.css | Text.responsive.css
 *
 * Usage:
 *   <Text>Body text content here.</Text>
 *   <Text size="lg">Lead paragraph.</Text>
 *   <Text as="span" size="sm" color="text-light">Caption</Text>
 *   <Text as="small" size="xs">Fine print.</Text>
 *   <Text as="strong" weight="bold">Important</Text>
 *   <Text clamp={3}>{card.description}</Text>
 *   <Text as="blockquote" family="body-alt">Pull quote.</Text>
 *   <Text flush>No margin below.</Text>
 *   <Text aac>This text gets an AAC pictogram version.</Text>
 *
 * For lists, use <List>. For headings, use <Heading>.
 */
import { aacInline } from '../../../lib/aac/aac-inline';
import '../../../components/molecules/aac/AacCard/AacCard.css';

interface Props {
  /** Text display content. Pipeline content key. */
  contentText?: string;

  /** HTML element to render */
  as?: 'p' | 'span' | 'div' | 'small' | 'strong' | 'em' | 'figcaption' | 'blockquote';

  /** Font size variant */
  size?: 'xs' | 'sm' | 'base' | 'lg' | 'xl';

  /** Font weight override */
  weight?: 'light' | 'normal' | 'medium' | 'semibold' | 'bold' | 'extrabold';

  /** Line height override */
  leading?: 'tight' | 'snug' | 'normal' | 'relaxed';

  /** Colour token */
  color?: 'default' | 'primary' | 'secondary' | 'neutral' | 'text' | 'rainbow-1' | 'rainbow-2' | 'rainbow-3' | 'rainbow-4' | 'rainbow-5' | 'rainbow-6' | 'rainbow-7';

  /** Font family variant */
  family?: 'heading' | 'body' | 'body-alt' | 'handwriting' | 'mono';

  /** Text alignment */
  align?: 'left' | 'center' | 'right' | 'justify';

  /** Highlight background bar behind text */
  highlight?: boolean;

  /** Highlight bar colour (independent from text colour) */
  highlightColor?: 'primary' | 'secondary' | 'neutral' | 'rainbow-1' | 'rainbow-2' | 'rainbow-3' | 'rainbow-4' | 'rainbow-5' | 'rainbow-6' | 'rainbow-7';
  highlightHeight?: 'sm' | 'md' | 'lg' | 'full';
  highlightOpacity?: 'faint' | 'soft' | 'bold' | 'solid';
  highlightShape?: 'sharp' | 'rounded';
  /** Contrast shadow on solid highlights: auto (default, on for solid), on, off */
  highlightShadow?: 'auto' | 'on' | 'off';
  /** Animate highlight colour through tier tokens (tint → mid → base). */
  highlightCycle?: boolean;

  /** Uppercase with letter-spacing */
  uppercase?: boolean;

  /** Limit visible lines */
  clamp?: number;

  /** Remove default bottom margin */
  flush?: boolean;

  /** Text contrast tone for glass surfaces */
  textTone?: 'light' | 'dark';

  /** Render AAC pictogram version of content (build-time) */
  aac?: boolean;

  /** Additional CSS classes */
  class?: string;
}

const {
  contentText,
  as: Tag = 'p',
  size,
  weight,
  leading,
  color,
  family,
  align,
  textTone,
  highlight = false,
  highlightColor = 'primary',
  highlightHeight,
  highlightOpacity,
  highlightShape,
  highlightShadow = 'auto',
  highlightCycle = false,
  uppercase = false,
  clamp,
  flush = false,
  aac = false,
  class: className,
} = Astro.props;

// Highlight colour — don't use .color--* mixin (it overrides text colour).
// Instead set tier tokens directly via inline style on the highlight span.
const highlightColourTokenMap: Record<string, string> = {
  primary: 'primary', secondary: 'secondary', neutral: 'neutral',
  'rainbow-1': 'rainbow-1', 'rainbow-2': 'rainbow-2', 'rainbow-3': 'rainbow-3',
  'rainbow-4': 'rainbow-4', 'rainbow-5': 'rainbow-5', 'rainbow-6': 'rainbow-6', 'rainbow-7': 'rainbow-7',
};
const hc = highlightColourTokenMap[highlightColor] || 'primary';
const isRainbow = hc.startsWith('rainbow-');
const highlightStyle = highlight ? [
  `--_tier-tint: var(--${hc}-tint)`,
  `--_tier-mid: var(--${isRainbow ? hc + '-mid' : hc + '-mid'})`,
  `--_color: var(--${isRainbow ? hc : hc + '-base'})`,
  `--_tier-emphasis: var(--${isRainbow ? hc + '-emphasis' : hc + '-emphasis'})`,
].join(';') : undefined;

// Build-time AAC resolution
let aacHtml = '';
if (aac) {
  const slotContent = await Astro.slots.render('default');
  const plainText = slotContent.replace(/<[^>]*>/g, '').trim();
  if (plainText) {
    const apiBase = import.meta.env.ASSET_API_URL || 'http://localhost:8787';
    aacHtml = await aacInline(plainText, apiBase);
  }
}

const classes = [
  'text',
  size && `text--${size}`,
  weight && `text--weight-${weight}`,
  leading && `text--leading-${leading}`,
  color && color !== 'default' && `text--${color}`,
  family && `text--family-${family}`,
  align && `text--align-${align}`,
  textTone && `text--tone-${textTone}`,
  uppercase && 'text--uppercase',
  clamp && 'text--clamp',
  flush && 'text--flush',
  className,
];

const highlightClasses = highlight ? [
  'text-highlight',
  highlightHeight && `text-highlight--${highlightHeight}`,
  highlightOpacity && `text-highlight--${highlightOpacity}`,
  highlightShape && `text-highlight--${highlightShape}`,
  highlightCycle && 'text-highlight--cycle',
  highlightShadow === 'on' && 'text-highlight--shadow',
  highlightShadow === 'off' && 'text-highlight--no-shadow',
] : [];

const inlineStyle = clamp ? `--text-clamp: ${clamp}` : undefined;
---

<Tag class:list={classes} style={inlineStyle}>
  <span class:list={['text__content', ...highlightClasses]} style={highlightStyle}>{contentText}</span>
  {aacHtml && <span class="text__aac content-aac" set:html={aacHtml} />}
</Tag>
