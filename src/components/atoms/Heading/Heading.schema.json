{
  "component": "Heading",
  "category": "atom",
  "renders": { "full": "Heading.astro", "reduced": "Heading.astro", "assistive": "Heading.astro", "textonly": "Heading.astro" },
  "notes": "Every heading on the site should go through this component. Heading.css is the single source of truth for all heading typography.",

  "props": {
    "content": {
      "_description": "What the heading communicates",
      "level":    { "type": "number",  "required": true, "enum": [1,2,3,4,5,6], "description": "Semantic heading level (h1-h6)." },
      "subtitle": { "type": "string",  "required": false, "default": null, "description": "Supporting text below the heading." },
      "icon":     { "type": "string",  "required": false, "default": null, "textonly": false, "description": "Phosphor icon slug. Decorative (aria-hidden)." },
      "image":    { "type": "string",  "required": false, "default": null, "textonly": false, "description": "Image URL for media slot. Decorative." }
    },

    "visual": {
      "_description": "How the heading looks",
      "size":           { "type": "string",  "required": false, "default": "matches level", "enum": ["h1","h2","h3","h4","h5","h6"], "description": "Visual size override." },
      "weight":         { "type": "string",  "required": false, "default": null, "enum": ["normal","medium","semibold","bold","extrabold"], "description": "Font weight override." },
      "color":          { "type": "string",  "required": false, "default": null, "enum": ["primary","primary-dark","secondary","text","text-light","neutral","inherit"], "description": "Text colour override." },
      "family":         { "type": "string",  "required": false, "default": null, "enum": ["heading","body","mono"], "description": "Font family override." },
      "align":          { "type": "string",  "required": false, "default": null, "enum": ["left","center","right"], "description": "Text alignment." },
      "tracking":       { "type": "string",  "required": false, "default": null, "enum": ["normal","wide","wider"], "description": "Letter spacing." },
      "uppercase":      { "type": "boolean", "required": false, "default": false, "description": "Uppercase text transform." },
      "flush":          { "type": "boolean", "required": false, "default": false, "description": "Remove bottom margin." },
      "variant":        { "type": "string",  "required": false, "default": "default", "enum": ["default","underline","badge","highlight","minimal"], "description": "Decorated treatment style." },
      "underlineStyle": { "type": "string",  "required": false, "default": "solid", "enum": ["solid","gradient","dashed"], "description": "Underline variant style." },
      "badgeColor":     { "type": "string",  "required": false, "default": "primary", "enum": ["primary","secondary","neutral"], "description": "Badge variant colour." },
      "highlightColor": { "type": "string",  "required": false, "default": "primary", "enum": ["primary","secondary","neutral"], "description": "Highlight variant colour." },
      "divider":        { "type": "string",  "required": false, "default": null, "enum": ["left","right","both","none"], "description": "Divider bar position." },
      "dividerColor":   { "type": "string",  "required": false, "default": "primary", "enum": ["primary","secondary","text","neutral","gradient"], "description": "Divider colour." },
      "dividerStyle":   { "type": "string",  "required": false, "default": "solid", "enum": ["solid","dashed","dotted"], "description": "Divider pattern." },
      "dividerEnds":    { "type": "string",  "required": false, "default": "rounded", "enum": ["rounded","square"], "description": "Divider end caps." },
      "mediaPosition":  { "type": "string",  "required": false, "default": "left", "enum": ["left","right"], "description": "Icon/image position." },
      "mediaSize":      { "type": "string",  "required": false, "default": "auto", "enum": ["sm","md","lg","auto"], "description": "Media container size." },
      "iconColor":      { "type": "string",  "required": false, "default": "text", "enum": ["primary","secondary","neutral","text"], "description": "Icon colour." },
      "iconStyle":      { "type": "string",  "required": false, "default": "contained", "enum": ["contained","bare"], "description": "Icon container style." },
      "spacing":        { "type": "string",  "required": false, "default": "normal", "enum": ["tight","normal","loose"], "description": "Wrapper gap size." },
      "class":          { "type": "string",  "required": false, "default": "", "description": "Additional CSS classes." }
    },

    "animation": {
      "_description": "Motion behaviour — stripped in reduced/assistive/textonly renders",
      "lottieIcon": { "type": "string", "required": false, "default": null, "description": "Lottie animation slug for media slot. When present, renders LottieIcon instead of static Icon. Stripped in reduced/assistive (falls back to content.icon) and textonly (no media). Only rendered when full animation props are available." }
    }
  },

  "slots": {
    "default": "Heading text content"
  }
}
