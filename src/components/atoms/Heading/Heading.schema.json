{
  "component": "Heading",
  "category": "atom",
  "renders": { "full": "Heading.astro", "reduced": "Heading.astro", "assistive": "Heading.astro", "textonly": "Heading.astro" },
  "notes": "Every heading goes through this component. Media (Icon/LottieIcon/Image) passed as nested component node — child atoms own their props. Subtitle renders via Text atom. Pipeline strips visual/animation props in textonly.",

  "props": {
    "content": {
      "contentHeading": { "type": "string", "required": true, "description": "Heading text. Pipeline content key." },
      "level":    { "type": "number", "required": true, "enum": [1, 2, 3, 4, 5, 6] },
      "subtitle": { "type": "string" },
      "aac":      { "type": "boolean", "default": false }
    },

    "colour": {
      "brandColor": { "type": "string", "enum": ["primary", "secondary", "neutral", "text"], "_description": "'text' = body text scale, always readable, never overridden by brand neutral changes." }
    },

    "rainbow": {
      "rainbowColor": { "type": "string", "enum": ["rainbow-1", "rainbow-2", "rainbow-3", "rainbow-4", "rainbow-5", "rainbow-6", "rainbow-7"] },
      "colorTier":    { "type": "string", "default": "base", "enum": ["tint", "mid", "base", "emphasis"] }
    },

    "gradient": {
      "gradient":          { "type": "boolean", "default": false },
      "gradientBlend":     { "type": "string", "enum": ["hero", "sunset", "brand-emerge", "brand-fade"] },
      "gradientDirection": { "type": "string", "default": "diagonal", "enum": ["vertical", "vertical-reverse", "horizontal", "horizontal-reverse", "diagonal", "diagonal-reverse", "diagonal-alt", "diagonal-alt-reverse"] },
      "gradientType":      { "type": "string", "default": "linear", "enum": ["linear", "radial"] },
      "gradientFocus":     { "type": "string", "default": "center", "enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"], "_note": "Radial origin point — only used when gradientType=radial." },
      "gradientEmerge":    { "type": "boolean", "default": false, "_description": "Fade-in modifier — bg-context holds then fades to colour." },
      "gradientFade":      { "type": "boolean", "default": false, "_description": "Fade-out modifier — bg-context holds then fades to colour (softer hold than emerge)." },
      "gradientFlip":      { "type": "boolean", "default": false, "_description": "Reverse gradient direction on the text — mirrors the wrap gradient for contrast." }
    },

    "typography": {
      "size":       { "type": "string", "enum": ["h1", "h2", "h3", "h4", "h5", "h6", "xs", "sm", "base", "lg", "xl"], "_note": "Text sizes (xs-xl) for gradient body text via Heading" },
      "weight":     { "type": "string", "enum": ["normal", "medium", "semibold", "bold", "extrabold"] },
      "family":     { "type": "string", "enum": ["heading", "body", "body-alt", "handwriting", "mono"] },
      "align":      { "type": "string", "enum": ["left", "center", "right"] },
      "tracking":   { "type": "string", "enum": ["normal", "wide", "wider"] },
      "uppercase":  { "type": "boolean", "default": false },
      "flush":      { "type": "boolean", "default": false },
      "textShadow": { "type": "string", "default": "none", "enum": ["none", "out", "drop", "in", "elevated", "glow", "glow-intense", "glow-inner"] }
    },

    "media": {
      "media": {
        "type": "object",
        "textonly": false,
        "_description": "Nested atom node. When mediaBg=false (default) media is a single atom (Icon | LottieIcon | Image | Shape). When mediaBg=true media must be a Shape containing a child atom (Icon | LottieIcon | Image) via its own media prop.",
        "properties": {
          "component":    { "type": "string", "required": true, "enum": ["Icon", "LottieIcon", "Image", "Shape"] },
          "semanticRole": { "type": "string", "required": true, "default": "decorative", "enum": ["decorative", "ui-control", "content-symbol"] }
        }
      },
      "mediaBg":       { "type": "boolean", "default": false, "_description": "true = media is a Shape wrapping a child atom (used as background container). false = media is a single atom rendered directly." },
      "mediaPosition": { "type": "string", "default": "left", "enum": ["left", "right"] },
      "mediaSize":     { "type": "string", "default": "auto", "enum": ["sm", "md", "lg", "auto"] }
    },

    "visual": {
      "variant":          { "type": "string", "default": "default", "enum": ["default", "underline", "highlight", "minimal"] },
      "highlightColor":   { "type": "string", "enum": ["primary", "secondary", "neutral", "rainbow-1", "rainbow-2", "rainbow-3", "rainbow-4", "rainbow-5", "rainbow-6", "rainbow-7"] },
      "highlightTier":    { "type": "string", "default": "tint", "enum": ["tint", "mid", "base", "emphasis"] },
      "highlightHeight":  { "type": "string", "default": "md", "enum": ["sm", "md", "lg", "full"] },
      "highlightOpacity": { "type": "string", "default": "soft", "enum": ["faint", "soft", "bold", "solid"] },
      "highlightShadow":  { "type": "string", "default": "auto", "enum": ["auto", "on", "off"], "_description": "Contrast shadow on solid highlights. 'auto' = applies only to solid (default), 'on' = force on, 'off' = force off." },
      "highlightCycle":   { "type": "boolean", "default": false, "_description": "Animate highlight colour through tier tokens (tint → mid → base → back). Gated by motion settings." },
      "underlineColor":   { "type": "string", "enum": ["primary", "secondary", "neutral", "rainbow-1", "rainbow-2", "rainbow-3", "rainbow-4", "rainbow-5", "rainbow-6", "rainbow-7"] },
      "underlineTier":    { "type": "string", "default": "base", "enum": ["tint", "mid", "base", "emphasis"] },
      "underlineStyle":     { "type": "string", "default": "solid", "enum": ["solid", "gradient", "dashed", "dotted"] },
      "underlineGap":       { "type": "string", "default": "default", "enum": ["close", "default", "loose"] },
      "underlineThickness": { "type": "string", "default": "md", "enum": ["sm", "md", "lg"] },
      "divider":          { "type": "string", "enum": ["left", "right", "both", "none"] },
      "dividerColor":     { "type": "string", "enum": ["primary", "secondary", "neutral", "rainbow-1", "rainbow-2", "rainbow-3", "rainbow-4", "rainbow-5", "rainbow-6", "rainbow-7"] },
      "dividerTier":      { "type": "string", "default": "base", "enum": ["tint", "mid", "base", "emphasis"] },
      "dividerStyle":     { "type": "string", "default": "solid", "enum": ["solid", "gradient", "dashed", "dotted"] },
      "dividerEnds":      { "type": "string", "default": "rounded", "enum": ["rounded", "square"] },
      "spacing":          { "type": "string", "default": "normal", "enum": ["tight", "normal", "loose"] },
      "subtitleSize":     { "type": "string", "default": "base", "enum": ["xs", "sm", "base", "lg", "xl"] }
    },

    "animation": {
      "animatedGradient":          { "type": "boolean", "default": false },
      "gradientAnimateDirection":  { "type": "string", "default": "cw", "enum": ["cw", "ccw", "sway"], "_description": "Animation direction — clockwise, counter-clockwise, or sway." },
      "gradientAnimateSpeed":      { "type": "string", "default": "default", "enum": ["slow", "default", "fast"], "_description": "Animation speed — slow (20s), default (12s), fast (6s). Gated by motion settings." },
      "gradientCycle":             { "type": "boolean", "default": false, "_description": "Colour cycle — cross-fades through the element's own tier tokens (tint→mid→base→emphasis)." }
    }
  }
}
