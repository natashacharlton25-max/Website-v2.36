{
  "component": "Heading",
  "category": "atom",
  "renders": { "full": "Heading.astro", "reduced": "Heading.astro", "textonly": "Heading.astro" },
  "notes": "Every heading goes through this component. Pipeline strips visual/animation props in textonly. Subtitle renders via Text atom.",

  "props": {
    "content": {
      "level":    { "type": "number", "required": true, "enum": [1, 2, 3, 4, 5, 6] },
      "subtitle": { "type": "string" },
      "aac":      { "type": "boolean", "default": false }
    },

    "colour": {
      "brandColor": { "type": "string", "enum": ["primary", "secondary", "neutral"] }
    },

    "rainbow": {
      "rainbowColor": { "type": "string", "enum": ["red", "orange", "yellow", "teal", "blue", "purple", "pink"] },
      "colorTier":    { "type": "string", "default": "base", "enum": ["tint", "mid", "base", "emphasis"] }
    },

    "gradient": {
      "gradient":          { "type": "boolean", "default": false },
      "gradientBlend":     { "type": "string", "enum": ["hero", "sunset", "brand-emerge", "brand-fade", "emerge", "fade", "preset-tint", "preset-mid", "preset-base", "preset-emphasis"] },
      "gradientDirection": { "type": "string", "default": "diagonal", "enum": ["vertical", "vertical-reverse", "horizontal", "horizontal-reverse", "diagonal", "diagonal-reverse", "diagonal-alt", "diagonal-alt-reverse"] },
      "gradientSpread":    { "type": "string", "default": "balanced", "enum": ["soft", "balanced", "tight"] }
    },

    "typography": {
      "size":       { "type": "string", "enum": ["h1", "h2", "h3", "h4", "h5", "h6"] },
      "weight":     { "type": "string", "enum": ["normal", "medium", "semibold", "bold", "extrabold"] },
      "family":     { "type": "string", "enum": ["heading", "body", "body-alt", "handwriting", "mono"] },
      "align":      { "type": "string", "enum": ["left", "center", "right"] },
      "tracking":   { "type": "string", "enum": ["normal", "wide", "wider"] },
      "uppercase":  { "type": "boolean", "default": false },
      "flush":      { "type": "boolean", "default": false },
      "textShadow": { "type": "string", "default": "none", "enum": ["none", "drop", "text", "glow"] }
    },

    "icon": {
      "icon":       { "type": "string", "textonly": false },
      "iconWeight": { "type": "string", "enum": ["brand", "fill", "duotone", "regular", "bold", "thin", "light"] },
      "iconStyle":  { "type": "string", "default": "contained", "enum": ["contained", "bare"] },
      "lottieIcon": { "type": "string", "textonly": false },
      "image":      { "type": "string", "textonly": false },
      "mediaPosition": { "type": "string", "default": "left", "enum": ["left", "right"] },
      "mediaSize":     { "type": "string", "default": "auto", "enum": ["sm", "md", "lg", "auto"] }
    },

    "visual": {
      "variant":          { "type": "string", "default": "default", "enum": ["default", "underline", "highlight", "minimal"] },
      "highlightColor":   { "type": "string", "enum": ["primary", "secondary", "neutral", "red", "orange", "yellow", "teal", "blue", "purple", "pink"] },
      "highlightTier":    { "type": "string", "default": "tint", "enum": ["tint", "mid", "base", "emphasis"] },
      "highlightHeight":  { "type": "string", "default": "md", "enum": ["sm", "md", "lg", "full"] },
      "highlightOpacity": { "type": "string", "default": "soft", "enum": ["faint", "soft", "bold", "solid"] },
      "underlineColor":   { "type": "string", "enum": ["primary", "secondary", "neutral", "red", "orange", "yellow", "teal", "blue", "purple", "pink"] },
      "underlineTier":    { "type": "string", "default": "base", "enum": ["tint", "mid", "base", "emphasis"] },
      "underlineStyle":   { "type": "string", "default": "solid", "enum": ["solid", "gradient", "dashed", "dotted"] },
      "underlineGap":     { "type": "string", "default": "default", "enum": ["close", "default", "loose"] },
      "divider":          { "type": "string", "enum": ["left", "right", "both", "none"] },
      "dividerColor":     { "type": "string", "enum": ["primary", "secondary", "neutral", "red", "orange", "yellow", "teal", "blue", "purple", "pink"] },
      "dividerTier":      { "type": "string", "default": "base", "enum": ["tint", "mid", "base", "emphasis"] },
      "dividerStyle":     { "type": "string", "default": "solid", "enum": ["solid", "dashed", "dotted"] },
      "dividerEnds":      { "type": "string", "default": "rounded", "enum": ["rounded", "square"] },
      "spacing":          { "type": "string", "default": "normal", "enum": ["tight", "normal", "loose"] },
      "subtitleSize":     { "type": "string", "default": "base", "enum": ["xs", "sm", "base", "lg", "xl"] }
    },

    "animation": {
      "animation":        { "type": "string", "enum": ["spin", "bounce", "shake", "float", "drift", "slide-up", "slide-down", "slide-left", "slide-right", "flip", "pulse", "ping", "pop", "squish", "heartbeat", "rubber-band", "fade", "blink", "flash", "glint", "shimmer", "twinkle", "wiggle", "swing", "rock", "nod", "attention", "celebrate", "enter", "exit"] },
      "animationTrigger": { "type": "string", "default": "viewport", "enum": ["viewport", "autoplay", "loop", "interval", "none"] },
      "animatedGradient": { "type": "boolean", "default": false }
    }
  }
}
