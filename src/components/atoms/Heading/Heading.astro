---
/**
 * Heading - Atomic typography primitive for h1–h6 elements
 *
 * Every heading should go through this component.
 * Heading.css is the single source of truth for all heading
 * typography on the site. Components that use headings (cards, sections)
 * inherit from .heading and add context-specific overrides.
 *
 * Styles: Heading.css | Heading.responsive.css
 *
 * Usage:
 *   <Heading level={1}>Page Title</Heading>
 *   <Heading level={3} size="h1">Visually large h3</Heading>
 *   <Heading level={2} weight="medium" color="text">Softer</Heading>
 *   <Heading level={2} divider="left">Our Story</Heading>
 *   <Heading level={2} variant="badge" badgeColor="neutral">NEW</Heading>
 *   <Heading level={2} icon="envelope-fill" divider="left">Contact</Heading>
 *   <Heading level={3} flush>No margin</Heading>
 *
 * For body text, use <Text>. For lists, use <List>.
 */
import { Icon } from '../Icon';
import { LottieIcon } from '../LottieIcon';
import { Text } from '../Text';
import { aacInline } from '../../../lib/aac/aac-inline';
import '../../../components/molecules/aac/AacCard/AacCard.css';

interface Props {
  // ── Core typography ──────────────────────────────────────
  level: 1 | 2 | 3 | 4 | 5 | 6;
  size?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
  weight?: 'normal' | 'medium' | 'semibold' | 'bold' | 'extrabold';
  family?: 'heading' | 'body' | 'body-alt' | 'handwriting' | 'mono';
  align?: 'left' | 'center' | 'right';
  uppercase?: boolean;
  tracking?: 'normal' | 'wide' | 'wider';
  flush?: boolean;

  // ── Subtitle ─────────────────────────────────────────────
  subtitle?: string;
  subtitleSize?: 'xs' | 'sm' | 'base' | 'lg' | 'xl';

  // ── Divider ──────────────────────────────────────────────
  divider?: 'left' | 'right' | 'both' | 'none';
  dividerStyle?: 'solid' | 'dashed' | 'dotted';
  dividerEnds?: 'rounded' | 'square';

  // ── Variant ──────────────────────────────────────────────
  variant?: 'default' | 'underline' | 'highlight' | 'minimal';
  underlineStyle?: 'solid' | 'gradient' | 'dashed';

  // ── Media ────────────────────────────────────────────────
  lottieIcon?: string | Record<string, any>;
  image?: string;
  icon?: string;
  mediaPosition?: 'left' | 'right';
  mediaSize?: 'sm' | 'md' | 'lg' | 'auto';
  iconStyle?: 'contained' | 'bare';

  // ── Layout ───────────────────────────────────────────────
  spacing?: 'tight' | 'normal' | 'loose';

  /** Fill text with an image — CSS background-clip: text */
  fillImage?: string;
  /** Text shadow */
  textShadow?: string;
  /** Drop shadow (for fill-image text) */
  dropShadow?: string;
  /** Text stroke outline */
  textStroke?: string;

  /** Render AAC pictogram version of content (build-time) */
  aac?: boolean;

  class?: string;
  [key: string]: any;
}

const {
  level,
  size,
  weight,
  family,
  align,
  uppercase = false,
  tracking,
  flush = false,
  subtitle,
  subtitleSize = 'base',
  divider,
  dividerStyle = 'solid',
  dividerEnds = 'rounded',
  variant = 'default',
  underlineStyle = 'solid',
  lottieIcon,
  image,
  icon,
  mediaPosition = 'left',
  mediaSize = 'auto',
  iconStyle = 'contained',
  spacing = 'normal',
  fillImage,
  textShadow,
  dropShadow,
  textStroke,
  aac = false,
  class: className,
  ...rest
} = Astro.props;

// Build-time AAC resolution
let aacHtml = '';
if (aac) {
  const slotContent = await Astro.slots.render('default');
  const plainText = slotContent.replace(/<[^>]*>/g, '').trim();
  if (plainText) {
    const apiBase = import.meta.env.ASSET_API_URL || 'http://localhost:8787';
    aacHtml = await aacInline(plainText, apiBase);
  }
}

const Tag = `h${level}` as any;
const visualSize = size ?? `h${level}`;

// Resolve lottieIcon — string (slug only) or object (slug + trigger + interval)
const lottieSlug = typeof lottieIcon === 'string' ? lottieIcon : lottieIcon?.slug;
const lottieProps = typeof lottieIcon === 'object' ? lottieIcon : {};

const isDecorated = !!(divider || image || icon || lottieSlug || subtitle || variant !== 'default');

const sizeKey = visualSize.replace('h', '');
const iconSizeMap: Record<string, number> = { '1': 56, '2': 44, '3': 32, '4': 28, '5': 24, '6': 20 };
const mediaSizeMapAuto: Record<string, string> = { '1': 'lg', '2': 'lg', '3': 'md', '4': 'md', '5': 'sm', '6': 'sm' };
const computedMediaSize = mediaSize === 'auto' ? mediaSizeMapAuto[sizeKey] ?? 'md' : mediaSize;
const computedIconSize = mediaSize === 'auto' ? (iconSizeMap[sizeKey] ?? 32) : (mediaSize === 'sm' ? 24 : mediaSize === 'md' ? 32 : 56);

// Build shadow styles from props
const shadowStyles = [
  fillImage && `background-image: url('${fillImage}')`,
  textShadow && `--heading-text-shadow: ${textShadow}`,
  dropShadow && `--heading-drop-shadow: drop-shadow(${dropShadow})`,
  textStroke && `--heading-text-stroke: ${textStroke}`,
].filter(Boolean).join('; ');

const headingClassList = [
  'heading',
  `heading--${visualSize}`,
  weight && `heading--weight-${weight}`,
  family && `heading--family-${family}`,
  align && `heading--align-${align}`,
  tracking && `heading--tracking-${tracking}`,
  uppercase && 'heading--uppercase',
  flush && 'heading--flush',
  fillImage && 'heading--fill-image',
];
---

{isDecorated ? (
  <div class:list={[
    'heading-wrap',
    `heading-wrap--align-${align ?? 'left'}`,
    `heading-wrap--spacing-${spacing}`,
    `heading-wrap--variant-${variant}`,
    divider && `heading-wrap--divider-${divider}`,
    divider && `heading-wrap--divider-ends-${dividerEnds}`,
    divider && dividerStyle !== 'solid' && `heading-wrap--divider-style-${dividerStyle}`,
    variant === 'underline' && `heading-wrap--underline-${underlineStyle}`,
    (image || icon || lottieSlug) && 'heading-wrap--has-media',
    (image || icon || lottieSlug) && `heading-wrap--media-${mediaPosition}`,
    (image || icon || lottieSlug) && `heading-wrap--media-size-${computedMediaSize}`,
    (icon || lottieSlug) && `heading-wrap--icon-${iconStyle}`,
    className,
  ]} {...rest}>
    {(image || icon || lottieSlug) && mediaPosition === 'left' && (
      <div class="heading-wrap__media">
        {image ? (
          <img src={image} alt="" class="heading-wrap__img" />
        ) : lottieSlug ? (
          <LottieIcon slug={lottieSlug} size={computedIconSize} {...lottieProps} class="heading-wrap__icon" />
        ) : icon ? (
          <Icon name={icon} size={computedIconSize} class="heading-wrap__icon" />
        ) : null}
      </div>
    )}

    {divider && (divider === 'left' || divider === 'both') && (
      <div class="heading-wrap__divider" aria-hidden="true"></div>
    )}

    <div class="heading-wrap__content">
      <Tag class:list={[...headingClassList]}>
        {variant === 'highlight' && <span class="heading-wrap__highlight" aria-hidden="true"></span>}
        <span class="heading-wrap__text-inner"><slot /></span>
      </Tag>
      {subtitle && <Text as="p" size={subtitleSize} flush class="heading-wrap__subtitle" style="--heading-color: var(--neutral-600)">{subtitle}</Text>}
      {variant === 'underline' && <div class="heading-wrap__underline" aria-hidden="true"></div>}
      {aacHtml && <span class="heading__aac content-aac" set:html={aacHtml} />}
    </div>

    {divider && (divider === 'right' || divider === 'both') && (
      <div class="heading-wrap__divider" aria-hidden="true"></div>
    )}

    {(image || icon || lottieSlug) && mediaPosition === 'right' && (
      <div class="heading-wrap__media">
        {image ? (
          <img src={image} alt="" class="heading-wrap__img" />
        ) : lottieSlug ? (
          <LottieIcon slug={lottieSlug} size={computedIconSize} {...lottieProps} class="heading-wrap__icon" />
        ) : icon ? (
          <Icon name={icon} size={computedIconSize} class="heading-wrap__icon" />
        ) : null}
      </div>
    )}
  </div>
) : (
  <Tag class:list={[...headingClassList, className]} style={[shadowStyles, rest.style].filter(Boolean).join('; ') || undefined} {...Object.fromEntries(Object.entries(rest).filter(([k]) => k !== 'style'))}>
    <span class="heading__text-inner"><slot /></span>
    {aacHtml && <span class="heading__aac content-aac" set:html={aacHtml} />}
  </Tag>
)}
