---
/**
 * Heading - Atomic typography primitive for h1–h6 elements
 *
 * Every heading should go through this component.
 * Heading.css is the single source of truth for all heading
 * typography on the site. Components that use headings (cards, sections)
 * inherit from .heading and add context-specific overrides.
 *
 * Styles: Heading.css | Heading.responsive.css
 *
 * Usage:
 *   <Heading level={1}>Page Title</Heading>
 *   <Heading level={3} size="h1">Visually large h3</Heading>
 *   <Heading level={2} weight="medium" color="text">Softer</Heading>
 *   <Heading level={2} divider="left">Our Story</Heading>
 *   <Heading level={2} variant="badge" badgeColor="neutral">NEW</Heading>
 *   <Heading level={2} icon="envelope-fill" divider="left">Contact</Heading>
 *   <Heading level={3} flush>No margin</Heading>
 *
 * For body text, use <Text>. For lists, use <List>.
 */
import { Icon } from '../Icon';
import { LottieIcon } from '../LottieIcon';
import { Text } from '../Text';
import { aacInline } from '../../../lib/aac/aac-inline';
import '../../../components/molecules/aac/AacCard/AacCard.css';
import type {
  BrandColour, RainbowColour, ColourTier,
  FontWeight, FontFamily, TextShadow,
  UnderlineStyle, UnderlineGap, UnderlineThickness,
  GradientBlend, GradientDirection, GradientSpread,
} from '../../../lib/shared-enums';

interface Props {
  // ── Content ─────────────────────────────────────────────
  level: 1 | 2 | 3 | 4 | 5 | 6;
  subtitle?: string;
  subtitleSize?: 'xs' | 'sm' | 'base' | 'lg' | 'xl';
  aac?: boolean;

  // ── Colour ──────────────────────────────────────────────
  brandColor?: BrandColour;
  rainbowColor?: RainbowColour;
  colorTier?: ColourTier;

  // ── Typography ──────────────────────────────────────────
  size?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
  weight?: FontWeight;
  family?: FontFamily;
  align?: 'left' | 'center' | 'right';
  uppercase?: boolean;
  tracking?: 'normal' | 'wide' | 'wider';
  flush?: boolean;
  textShadow?: TextShadow;

  // ── Highlight ────────────────────────────────────────────
  variant?: 'default' | 'underline' | 'highlight' | 'minimal';
  highlightColor?: BrandColour | RainbowColour;
  highlightTier?: ColourTier;
  highlightHeight?: 'sm' | 'md' | 'lg' | 'full';
  highlightOpacity?: 'faint' | 'soft' | 'bold' | 'solid';

  // ── Underline ───────────────────────────────────────────
  underlineColor?: BrandColour | RainbowColour;
  underlineTier?: ColourTier;
  underlineStyle?: UnderlineStyle;
  underlineGap?: UnderlineGap;
  underlineThickness?: UnderlineThickness;

  // ── Divider ─────────────────────────────────────────────
  divider?: 'left' | 'right' | 'both' | 'none';
  dividerColor?: BrandColour | RainbowColour;
  dividerTier?: ColourTier;
  dividerStyle?: 'solid' | 'dashed' | 'dotted';
  dividerEnds?: 'rounded' | 'square';

  // ── Visual ──────────────────────────────────────────────
  spacing?: 'tight' | 'normal' | 'loose';

  // ── Gradient ────────────────────────────────────────────
  gradient?: boolean;
  gradientBlend?: GradientBlend;
  gradientDirection?: GradientDirection;
  gradientSpread?: GradientSpread;

  // ── Media — component node { component: "Icon"|"LottieIcon"|"Image", ...props }
  media?: Record<string, any>;
  mediaPosition?: 'left' | 'right';
  mediaSize?: 'sm' | 'md' | 'lg' | 'auto';

  // ── Animation ───────────────────────────────────────────
  animatedGradient?: boolean;

  class?: string;
  style?: string;
}

const {
  level,
  brandColor,
  rainbowColor,
  colorTier,
  size,
  weight,
  family,
  align,
  uppercase = false,
  tracking,
  flush = false,
  textShadow,
  subtitle,
  subtitleSize = 'base',
  divider,
  dividerStyle = 'solid',
  dividerEnds = 'rounded',
  variant = 'default',
  highlightColor,
  highlightTier,
  highlightHeight,
  highlightOpacity,
  underlineColor,
  underlineTier,
  underlineStyle = 'solid',
  underlineGap,
  underlineThickness,
  dividerColor,
  dividerTier,
  gradient = false,
  gradientBlend,
  gradientDirection,
  gradientSpread,
  media,
  mediaPosition = 'left',
  mediaSize = 'auto',
  animatedGradient = false,
  spacing = 'normal',
  aac = false,
  class: className,
  style: incomingStyle,
} = Astro.props;

// Resolve colours — each element independently
const textColor = rainbowColor || brandColor || null;
const resolvedHighlightColor = highlightColor || textColor;
const resolvedUnderlineColor = underlineColor || textColor;
const resolvedDividerColor = dividerColor || textColor;

// Build-time AAC resolution
let aacHtml = '';
if (aac) {
  const slotContent = await Astro.slots.render('default');
  const plainText = slotContent.replace(/<[^>]*>/g, '').trim();
  if (plainText) {
    const apiBase = import.meta.env.ASSET_API_URL || 'http://localhost:8787';
    aacHtml = await aacInline(plainText, apiBase);
  }
}

const Tag = `h${level}` as any;
const visualSize = size ?? `h${level}`;

const hasMedia = !!media;
const isDecorated = !!(divider || hasMedia || subtitle || variant !== 'default');

// Media component type and props — spread onto the atom, Heading only adds size
const mediaComponent = media?.component;
const { component: _mc, ...mediaProps } = media || {};


const sizeKey = visualSize.replace('h', '');
const iconSizeMap: Record<string, number> = { '1': 56, '2': 44, '3': 32, '4': 28, '5': 24, '6': 20 };
const mediaSizeMapAuto: Record<string, string> = { '1': 'lg', '2': 'lg', '3': 'md', '4': 'md', '5': 'sm', '6': 'sm' };
const computedMediaSize = mediaSize === 'auto' ? mediaSizeMapAuto[sizeKey] ?? 'md' : mediaSize;
const computedIconSize = mediaSize === 'auto' ? (iconSizeMap[sizeKey] ?? 32) : (mediaSize === 'sm' ? 24 : mediaSize === 'md' ? 32 : 56);

const mergedStyle = incomingStyle || '';

const headingClassList = [
  'heading',
  textColor && `color--${textColor}`,
  colorTier && colorTier !== 'base' && `color--tier-${colorTier}`,
  `heading--${visualSize}`,
  weight && `heading--weight-${weight}`,
  family && `heading--family-${family}`,
  align && `heading--align-${align}`,
  tracking && `heading--tracking-${tracking}`,
  uppercase && 'heading--uppercase',
  flush && 'heading--flush',
  textShadow && textShadow !== 'none' && `text-shadow--${textShadow}`,
];
---

{isDecorated ? (
  <div class:list={[
    'heading-wrap',
    `heading-wrap--align-${align ?? 'left'}`,
    `heading-wrap--spacing-${spacing}`,
    `heading-wrap--variant-${variant}`,
    divider && `heading-wrap--divider-${divider}`,
    divider && `heading-wrap--divider-ends-${dividerEnds}`,
    divider && dividerStyle !== 'solid' && `heading-wrap--divider-style-${dividerStyle}`,
    (gradient || gradientBlend) && 'gradient',
    (gradient || gradientBlend) && `gradient--${variant === 'default' ? 'fill' : variant}`,
    gradientBlend && `gradient--blend-${gradientBlend}`,
    animatedGradient && 'gradient--animated',
    hasMedia && 'heading-wrap--has-media',
    hasMedia && `heading-wrap--media-${mediaPosition}`,
    hasMedia && `heading-wrap--media-size-${computedMediaSize}`,
    className,
  ]}
    data-grad-dir={gradientDirection || undefined}
    data-grad-spread={gradientSpread || undefined}
    style={mergedStyle || undefined}>
    {hasMedia && mediaPosition === 'left' && (
      <div class="heading-wrap__media">
        {mediaComponent === 'Icon' && <Icon {...mediaProps} size={mediaProps.size || computedIconSize} class="heading-wrap__icon" />}
        {mediaComponent === 'LottieIcon' && <LottieIcon {...mediaProps} size={mediaProps.size || computedIconSize} class="heading-wrap__icon" />}
        {mediaComponent === 'Image' && <img src={mediaProps.src} alt={mediaProps.alt || ''} class="heading-wrap__img" />}
      </div>
    )}

    {divider && (divider === 'left' || divider === 'both') && (
      <div class:list={['heading-wrap__divider', resolvedDividerColor && `color--${resolvedDividerColor}`, dividerTier && dividerTier !== 'base' && `color--tier-${dividerTier}`]} aria-hidden="true"></div>
    )}

    <div class="heading-wrap__content">
      <Tag class:list={[
        ...headingClassList,
        variant === 'highlight' && 'text-highlight',
        variant === 'highlight' && highlightHeight && `text-highlight--${highlightHeight}`,
        variant === 'highlight' && highlightOpacity && `text-highlight--${highlightOpacity}`,
      ]}>
        {variant === 'highlight' && <span class:list={['text-highlight__bar', resolvedHighlightColor && `color--${resolvedHighlightColor}`, highlightTier && highlightTier !== 'base' && `color--tier-${highlightTier}`]} aria-hidden="true"></span>}
        <span class="heading__text-inner"><slot /></span>
      </Tag>
      {variant === 'underline' && <div class:list={['underline', underlineStyle !== 'solid' && `underline--${underlineStyle}`, underlineGap && underlineGap !== 'default' && `underline--gap-${underlineGap}`, underlineThickness && `underline--thickness-${underlineThickness}`, resolvedUnderlineColor && `color--${resolvedUnderlineColor}`, underlineTier && underlineTier !== 'base' && `color--tier-${underlineTier}`, underlineStyle === 'gradient' && gradientBlend && `gradient--blend-${gradientBlend}`, underlineStyle === 'gradient' && gradient && 'gradient']} aria-hidden="true"></div>}
      {subtitle && <Text as="p" size={subtitleSize} flush class="heading-wrap__subtitle" color="neutral">{subtitle}</Text>}
      {aacHtml && <span class="heading__aac content-aac" set:html={aacHtml} />}
    </div>

    {divider && (divider === 'right' || divider === 'both') && (
      <div class:list={['heading-wrap__divider', resolvedDividerColor && `color--${resolvedDividerColor}`, dividerTier && dividerTier !== 'base' && `color--tier-${dividerTier}`]} aria-hidden="true"></div>
    )}

    {hasMedia && mediaPosition === 'right' && (
      <div class="heading-wrap__media">
        {mediaComponent === 'Icon' && <Icon {...mediaProps} size={mediaProps.size || computedIconSize} class="heading-wrap__icon" />}
        {mediaComponent === 'LottieIcon' && <LottieIcon {...mediaProps} size={mediaProps.size || computedIconSize} class="heading-wrap__icon" />}
        {mediaComponent === 'Image' && <img src={mediaProps.src} alt={mediaProps.alt || ''} class="heading-wrap__img" />}
      </div>
    )}
  </div>
) : (
  <Tag class:list={[...headingClassList, className]} style={mergedStyle || undefined}>
    <span class="heading__text-inner"><slot /></span>
    {aacHtml && <span class="heading__aac content-aac" set:html={aacHtml} />}
  </Tag>
)}
