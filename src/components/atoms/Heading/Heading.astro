---
/**
 * Heading - Atomic typography primitive for h1–h6 elements
 *
 * Every heading should go through this component.
 * Heading.css is the single source of truth for all heading
 * typography on the site. Components that use headings (cards, sections)
 * inherit from .heading and add context-specific overrides.
 *
 * Styles: Heading.css | Heading.responsive.css
 *
 * Usage:
 *   <Heading level={1}>Page Title</Heading>
 *   <Heading level={3} size="h1">Visually large h3</Heading>
 *   <Heading level={2} weight="medium" brandColor="text">Softer</Heading>
 *   <Heading level={2} divider="left">Our Story</Heading>
 *   <Heading level={2} variant="highlight" highlightColor="primary">NEW</Heading>
 *   <Heading level={2} media={{ component: 'Icon', slug: 'envelope-fill' }} divider="left">Contact</Heading>
 *   <Heading level={3} flush>No margin</Heading>
 *
 * For body text, use <Text>. For lists, use <List>.
 */
import { Icon } from '../Icon';
import { LottieIcon } from '../LottieIcon';
import { Image } from '../Image';
import { Shape } from '../Shape';
import { Text } from '../Text';
import { aacInline } from '../../../lib/aac/aac-inline';
import { GRADIENT_ANIMATION_SPEED, randomGradientDelayVar } from '../../../lib/animation/animation-config';
import '../../../components/molecules/aac/AacCard/AacCard.css';
import type {
  BrandColour, TextColour, RainbowColour, ColourTier,
  FontWeight, FontFamily, TextShadow,
  HeadingSize, HeadingVariant, TextSize, Alignment, Tracking, Spacing,
  HighlightHeight, HighlightOpacity,
  UnderlineStyle, UnderlineGap, UnderlineThickness,
  DividerPosition, DividerEnds, MediaPosition, MediaSize,
  GradientBlend, GradientDirection,
} from '../../../lib/shared-enums';

interface Props {
  // ── Content ─────────────────────────────────────────────
  level: 1 | 2 | 3 | 4 | 5 | 6;
  /** Heading display text. Pipeline content key. */
  contentHeading?: string;
  contentHeadingSubtitle?: string;
  subtitleSize?: TextSize;
  aac?: boolean;

  // ── Colour ──────────────────────────────────────────────
  /** Brand or text scale colour. 'text' = body text scale (always readable, never brand-overridden). */
  brandColor?: TextColour;
  rainbowColor?: RainbowColour;
  colorTier?: ColourTier;

  // ── Typography ──────────────────────────────────────────
  size?: HeadingSize;
  weight?: FontWeight;
  family?: FontFamily;
  align?: Alignment;
  uppercase?: boolean;
  tracking?: Tracking;
  flush?: boolean;
  textShadow?: TextShadow;

  // ── Highlight ────────────────────────────────────────────
  variant?: HeadingVariant;
  highlightColor?: BrandColour | RainbowColour;
  highlightTier?: ColourTier;
  highlightHeight?: HighlightHeight;
  highlightOpacity?: HighlightOpacity;
  /** Contrast shadow on solid highlights: auto (default, on for solid), on, off */
  highlightShadow?: 'auto' | 'on' | 'off';
  /** Animate highlight colour through tier tokens (tint → mid → base). */
  highlightCycle?: boolean;

  // ── Underline ───────────────────────────────────────────
  underlineColor?: BrandColour | RainbowColour;
  underlineTier?: ColourTier;
  underlineStyle?: UnderlineStyle;
  underlineGap?: UnderlineGap;
  underlineThickness?: UnderlineThickness;

  // ── Divider ─────────────────────────────────────────────
  divider?: DividerPosition;
  dividerColor?: BrandColour | RainbowColour;
  dividerTier?: ColourTier;
  dividerStyle?: UnderlineStyle;
  dividerEnds?: DividerEnds;

  // ── Visual ──────────────────────────────────────────────
  spacing?: Spacing;

  // ── Gradient ────────────────────────────────────────────
  gradient?: boolean;
  gradientBlend?: GradientBlend;
  gradientDirection?: GradientDirection;
  gradientEmerge?: boolean;
  gradientFade?: boolean;
  /** Reverse gradient direction on text for contrast with a wrap gradient. */
  gradientFlip?: boolean;

  // ── Media — component node
  // mediaBg=false (default): media is a single atom (Icon | LottieIcon | Image | Shape).
  // mediaBg=true: media MUST be a Shape wrapping a child atom (Icon | LottieIcon | Image).
  media?: Record<string, any>;
  mediaBg?: boolean;
  mediaPosition?: MediaPosition;
  mediaSize?: MediaSize;

  // ── Animation ───────────────────────────────────────────
  gradientAnimated?: boolean;
  gradientAnimateDirection?: 'cw' | 'ccw' | 'sway';
  gradientAnimateSpeed?: 'slow' | 'default' | 'fast';
  gradientCycle?: boolean;

  class?: string;
  style?: string;
}

const {
  level,
  contentHeading: contentText,
  brandColor,
  rainbowColor,
  colorTier,
  size,
  weight,
  family,
  align,
  uppercase = false,
  tracking,
  flush = false,
  textShadow,
  contentHeadingSubtitle,
  subtitleSize = 'base',
  divider,
  dividerStyle = 'solid',
  dividerEnds = 'rounded',
  variant = 'default',
  highlightColor,
  highlightTier,
  highlightHeight,
  highlightOpacity,
  highlightShadow = 'auto',
  highlightCycle = false,
  underlineColor,
  underlineTier,
  underlineStyle = 'solid',
  underlineGap,
  underlineThickness,
  dividerColor,
  dividerTier,
  gradient = false,
  gradientBlend,
  gradientDirection,
  gradientEmerge = false,
  gradientFade = false,
  gradientFlip = false,
  media,
  mediaBg = false,
  mediaPosition = 'left',
  mediaSize = 'auto',
  gradientAnimated = false,
  gradientAnimateDirection,
  gradientAnimateSpeed,
  gradientCycle = false,
  spacing = 'normal',
  aac = false,
  class: className,
  style: incomingStyle,
} = Astro.props;

// Resolve colours — each element independently
// Default to 'text' colour class so the global .color--text mixin always
// fires — sets --_color/--_tier-tint reliably so Heading.css internal
// tokens have a definite value (no fallback chain needed).
const textColor = rainbowColor || brandColor || 'text';
const resolvedHighlightColor = highlightColor || textColor;
const resolvedUnderlineColor = underlineColor || textColor;
const resolvedDividerColor = dividerColor || textColor;

// Resolve gradient name (matches Badge logic):
//   1. gradientBlend (named blends)
//   2. emerge/fade prefix + colour (fade-rainbow-4 etc.)
//   3. baseColour (primary, rainbow-1 etc.)
// Heading does not support radial gradients (linear only — radial is for Card/Section).
const tierSuffix = (gradient && colorTier && colorTier !== 'base') ? `-preset-${colorTier}` : '';
const emergePrefix = gradientEmerge ? 'emerge-' : gradientFade ? 'fade-' : '';
const resolvedGradientName = gradientBlend
  || (gradient && textColor ? `${emergePrefix}${textColor}${tierSuffix}` : null)
  || (gradient ? `${emergePrefix}primary` : null);

// Flip direction for gradient text when gradientFlip is set
const reverseDir: Record<string, GradientDirection> = {
  'vertical': 'vertical-reverse', 'vertical-reverse': 'vertical',
  'horizontal': 'horizontal-reverse', 'horizontal-reverse': 'horizontal',
  'diagonal': 'diagonal-reverse', 'diagonal-reverse': 'diagonal',
  'diagonal-alt': 'diagonal-alt-reverse', 'diagonal-alt-reverse': 'diagonal-alt',
};
const textGradientDirection: GradientDirection | undefined = gradientFlip
  ? (gradientDirection ? reverseDir[gradientDirection] : 'diagonal-reverse')
  : gradientDirection;

// Fade/emerge on heading text: text uses an oversized background so the soft
// fade actually lands across the narrow glyph bounds (not compressed at one edge).
// Non-flip: matches underline direction (bg → colour). Flip: swaps the stops (colour → bg).
const flipTextStyle = (() => {
  if (!gradientFade && !gradientEmerge) return undefined;
  const colourVar = textColor?.startsWith('rainbow-') ? `var(--${textColor})` : `var(--${textColor || 'primary'}-base)`;
  const bgVar = 'var(--_bg-context, var(--page-bg))';
  const hold = gradientEmerge ? 38 : 30;
  const stops = gradientFlip
    ? `${colourVar} 0%, ${colourVar} ${hold}%, ${bgVar} ${hold + 15}%, ${bgVar} 100%`
    : `${bgVar} 0%, ${bgVar} ${hold}%, ${colourVar} ${hold + 15}%, ${colourVar} 100%`;
  return `--_grad-computed: linear-gradient(var(--_grad-angle, 135deg), ${stops}); background-size: 170% 100%; background-position: center`;
})();

// Build-time AAC resolution
let aacHtml = '';
if (aac && contentText) {
  const plainText = contentText.replace(/<[^>]*>/g, '').trim();
  if (plainText) {
    const apiBase = import.meta.env.ASSET_API_URL || 'http://localhost:8787';
    aacHtml = await aacInline(plainText, apiBase);
  }
}

const Tag = `h${level}` as any;
const visualSize = size ?? `h${level}`;

const hasMedia = !!media;
const isDecorated = !!(divider || hasMedia || contentHeadingSubtitle || variant !== 'default');

// Media component type and props
const mediaComponent = media?.component;
const { component: _mc, ...rawMediaProps } = media || {};

// Media sizing comes from CSS — .heading-wrap--{level} sets font-size to
// var(--text-h{N}), which the .heading-wrap__media sibling inherits, and
// the em-based --media-* tokens on Icon/Shape children resolve against
// that. Token-driven: if --text-h1 changes in tokens, media follows.
// mediaSize prop kept for explicit overrides via author.
//
// mediaBg=true means the Shape is wallpaper for a child atom — auto-inject
// semanticRole='background' so authors can't accidentally mark it decorative
// or claim a label. Runtime guarantee, not authoring discipline.
const mediaProps = (mediaBg && mediaComponent === 'Shape')
  ? { ...rawMediaProps, semanticRole: 'background' }
  : rawMediaProps;

// Animated gradient / colour cycle — random delay + optional speed
const headingAnimParts: string[] = [];
if ((gradientAnimated && resolvedGradientName) || gradientCycle) {
  if (gradientAnimateSpeed && gradientAnimateSpeed !== 'default') headingAnimParts.push(`--_grad-anim-duration:${GRADIENT_ANIMATION_SPEED[gradientAnimateSpeed]}s`);
  headingAnimParts.push(randomGradientDelayVar());
}
const headingAnimStyle = headingAnimParts.length ? headingAnimParts.join(';') : '';

const mergedStyle = [incomingStyle, headingAnimStyle].filter(Boolean).join(';') || '';
const tagInlineStyle = flipTextStyle || undefined;

const headingClassList = [
  'heading',
  textColor && `color--${textColor}`,
  colorTier && colorTier !== 'base' && `color--tier-${colorTier}`,
  `heading--${visualSize}`,
  weight && `heading--weight-${weight}`,
  family && `heading--family-${family}`,
  align && `heading--align-${align}`,
  tracking && `heading--tracking-${tracking}`,
  uppercase && 'heading--uppercase',
  flush && 'heading--flush',
  textShadow && textShadow !== 'none' && `text-shadow--${textShadow}`,
  (gradient || gradientBlend) && 'gradient__text',
  (gradient || gradientBlend) && gradientAnimated && 'gradient__text--animated',
  /* Emerge/fade on text needs a contrast halo so the faded portion stays readable */
  (gradientEmerge || gradientFade) && 'gradient__text--emerge-fade',
  gradientCycle && 'gradient--cycle',
  /* Resolved gradient name handles blends, solo colours, emerge/fade, radial */
  resolvedGradientName && !flipTextStyle && `gradient--blend-${resolvedGradientName}`,
];
---

{isDecorated ? (
  <div class:list={[
    'heading-wrap',
    /* Level class on the wrap sets font-size: var(--text-h{N}) so the
       sibling .heading-wrap__media inherits the heading's text scale.
       Em-based --media-* tokens on Icon/Shape children then resolve to
       the right pixel size automatically. Token-driven, no JS pixel maps. */
    `heading-wrap--${visualSize}`,
    /* Apply colour class to the wrap so --_color cascades to media (icons,
       dividers) AND to the Tag below. Without this, the Tag has --_color
       but the icon inherits nothing. */
    textColor && `color--${textColor}`,
    colorTier && colorTier !== 'base' && `color--tier-${colorTier}`,
    `heading-wrap--align-${align ?? 'left'}`,
    `heading-wrap--spacing-${spacing}`,
    `heading-wrap--variant-${variant}`,
    divider && `heading-wrap--divider-${divider}`,
    divider && `heading-wrap--divider-ends-${dividerEnds}`,
    divider && dividerStyle !== 'solid' && `heading-wrap--divider-style-${dividerStyle}`,
    (gradient || gradientBlend) && 'gradient',
    (gradient || gradientBlend) && variant !== 'default' && `gradient--${variant}`,
    resolvedGradientName && `gradient--blend-${resolvedGradientName}`,
    gradientAnimated && 'gradient--animated',
    gradientCycle && 'gradient--cycle',
    hasMedia && 'heading-wrap--has-media',
    hasMedia && `heading-wrap--media-${mediaPosition}`,
    className,
  ]}
    data-grad-dir={gradientDirection || undefined}
    data-grad-anim-dir={gradientAnimated && gradientAnimateDirection && gradientAnimateDirection !== 'cw' ? gradientAnimateDirection : undefined}
    style={mergedStyle || undefined}>
    {hasMedia && mediaPosition === 'left' && (
      <div class="heading-wrap__media">
        {mediaBg && <Shape {...(mediaProps as any)} class="heading-wrap__shape" />}
        {!mediaBg && mediaComponent === 'Icon' && <Icon {...(mediaProps as any)} class="heading-wrap__icon" />}
        {!mediaBg && mediaComponent === 'LottieIcon' && <LottieIcon {...(mediaProps as any)} class="heading-wrap__icon" />}
        {!mediaBg && mediaComponent === 'Image' && <Image {...(mediaProps as any)} class="heading-wrap__img" />}
        {!mediaBg && mediaComponent === 'Shape' && <Shape {...(mediaProps as any)} class="heading-wrap__shape" />}
      </div>
    )}

    {divider && (divider === 'left' || divider === 'both') && (
      <div
        class:list={['divider', 'heading-wrap__divider', dividerStyle !== 'solid' && `divider--${dividerStyle}`, resolvedDividerColor && `color--${resolvedDividerColor}`, dividerTier && dividerTier !== 'base' && `color--tier-${dividerTier}`, dividerStyle === 'gradient' && 'gradient', dividerStyle === 'gradient' && resolvedGradientName && `gradient--blend-${resolvedGradientName}`, gradientAnimated && 'divider--animated']}
        data-grad-dir={dividerStyle === 'gradient' ? gradientDirection : undefined}
        aria-hidden="true"></div>
    )}

    <div class="heading-wrap__content">
      <Tag class:list={[
        ...headingClassList,
        variant === 'highlight' && 'text-highlight',
        variant === 'highlight' && highlightHeight && `text-highlight--${highlightHeight}`,
        variant === 'highlight' && highlightOpacity && `text-highlight--${highlightOpacity}`,
        variant === 'highlight' && highlightCycle && 'text-highlight--cycle',
        variant === 'highlight' && highlightShadow === 'on' && 'text-highlight--shadow',
        variant === 'highlight' && highlightShadow === 'off' && 'text-highlight--no-shadow',
      ]}
        data-grad-dir={gradientDirection || undefined}
        style={tagInlineStyle}>
        {variant === 'highlight' && <span class:list={['text-highlight__bar', resolvedHighlightColor && `color--${resolvedHighlightColor}`, highlightTier && highlightTier !== 'base' && `color--tier-${highlightTier}`]} aria-hidden="true"></span>}
        <span class="heading__text-inner">{contentText}</span>
      </Tag>
      {variant === 'underline' && (
        <div
          class:list={['underline', underlineStyle !== 'solid' && `underline--${underlineStyle}`, underlineGap && underlineGap !== 'default' && `underline--gap-${underlineGap}`, underlineThickness && `underline--thickness-${underlineThickness}`, resolvedUnderlineColor && `color--${resolvedUnderlineColor}`, underlineTier && underlineTier !== 'base' && `color--tier-${underlineTier}`, underlineStyle === 'gradient' && 'gradient', underlineStyle === 'gradient' && resolvedGradientName && `gradient--blend-${resolvedGradientName}`, gradientAnimated && 'underline--animated']}
          data-grad-dir={underlineStyle === 'gradient' ? gradientDirection : undefined}
          aria-hidden="true"></div>
      )}
      {contentHeadingSubtitle && <Text as="p" size={subtitleSize} flush class="heading-wrap__subtitle" brandColor="text" contentText={contentHeadingSubtitle} />}
      {aacHtml && <span class="heading__aac content-aac" set:html={aacHtml} />}
    </div>

    {divider && (divider === 'right' || divider === 'both') && (
      <div
        class:list={['divider', 'heading-wrap__divider', dividerStyle !== 'solid' && `divider--${dividerStyle}`, resolvedDividerColor && `color--${resolvedDividerColor}`, dividerTier && dividerTier !== 'base' && `color--tier-${dividerTier}`, dividerStyle === 'gradient' && 'gradient', dividerStyle === 'gradient' && resolvedGradientName && `gradient--blend-${resolvedGradientName}`, gradientAnimated && 'divider--animated']}
        data-grad-dir={dividerStyle === 'gradient' ? gradientDirection : undefined}
        aria-hidden="true"></div>
    )}

    {hasMedia && mediaPosition === 'right' && (
      <div class="heading-wrap__media">
        {mediaBg && <Shape {...(mediaProps as any)} class="heading-wrap__shape" />}
        {!mediaBg && mediaComponent === 'Icon' && <Icon {...(mediaProps as any)} class="heading-wrap__icon" />}
        {!mediaBg && mediaComponent === 'LottieIcon' && <LottieIcon {...(mediaProps as any)} class="heading-wrap__icon" />}
        {!mediaBg && mediaComponent === 'Image' && <Image {...(mediaProps as any)} class="heading-wrap__img" />}
        {!mediaBg && mediaComponent === 'Shape' && <Shape {...(mediaProps as any)} class="heading-wrap__shape" />}
      </div>
    )}
  </div>
) : (
  <Tag class:list={[...headingClassList, className]} style={[mergedStyle, tagInlineStyle].filter(Boolean).join(';') || undefined} data-grad-dir={textGradientDirection || undefined}>
    <span class="heading__text-inner">{contentText}</span>
    {aacHtml && <span class="heading__aac content-aac" set:html={aacHtml} />}
  </Tag>
)}
