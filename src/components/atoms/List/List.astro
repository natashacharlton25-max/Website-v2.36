---
/**
 * List — Atomic list primitive
 *
 * Every list should go through this component.
 * Item text renders through Text atom (colour + family passed through).
 * List.css is the single source of truth for list styling.
 *
 * Styles: List.css | List.responsive.css
 *
 * Usage:
 *   <List items={['One', 'Two', 'Three']} />
 *   <List as="ol" items={['First', 'Second']} />
 *   <List icon="check-circle-fill" items={['Done', 'Done']} />
 *   <List icon="arrow-right-fill" color="secondary" items={['Go', 'Go']} />
 *   <List variant="dot" items={['Custom dots']} />
 *   <List variant="dot" dotSize="lg" items={['Big dots']} />
 *   <List variant="none" items={['Clean', 'No bullets']} />
 *   <List variant="inline" items={['Tag', 'Tag', 'Tag']} />
 *   <List flush items={['Tight', 'No margin']} />
 *   <List textColor="text" textFamily="body" items={['Body text']} />
 */
import { Icon } from '../Icon';
import { Shape } from '../Shape';
import { Link } from '../Link';
import { Text } from '../Text';
import type { TextColour, RainbowColour } from '../../../lib/shared-enums';

type ListItem = string | { contentLink: string; href: string; };

interface Props {
  as?: 'ul' | 'ol';
  variant?: 'default' | 'none' | 'inline' | 'dot';
  dotSize?: 'sm' | 'md' | 'lg';
  icon?: string;
  /** Marker colour (bullet, icon, dot, ordered counter). */
  color?: TextColour | RainbowColour;
  /** Text atom props for item text — spread onto each item's nested Text.
   *  Accepts any Text prop (color, family, size, weight, leading, uppercase, etc).
   *  List always sets `as="span"` and `flush` internally. */
  text?: Record<string, any>;
  spacing?: 'tight' | 'normal' | 'loose';
  flush?: boolean;
  /** Nested atom node used as the list marker — { component: 'Icon'|'Shape', ...atomProps }. */
  media?: Record<string, any>;
  /** Text atom styling props forwarded to each item's Text. */
  textStyle?: Record<string, any>;
  class?: string;
  /** List items. Pipeline content key. */
  contentList?: ListItem[];
  [key: string]: any;
}

const {
  as: Tag = 'ul',
  variant = 'default',
  dotSize = 'md',
  icon,
  color = 'primary',
  textStyle: textProps,
  spacing = 'normal',
  flush = false,
  media,
  class: className,
  contentList: items,
  ...rest
} = Astro.props;

const mediaComponent = media?.component;
const { component: _mc, ...mediaProps } = media || {};
const hasMedia = !!media;
// Default marker size if the author didn't specify one.
// Authors override by setting media.size (e.g. "xl" for a chunkier marker).
const mediaPropsWithSize = hasMedia && mediaProps.size == null
  ? { ...mediaProps, size: 'lg' }
  : mediaProps;

// Extract data-* attributes
const dataAttrs = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key.startsWith('data-'))
);

const hasIcon = !!icon;

// Fallback icon size — uses em-based media tokens so it scales with text
const iconSizeMap: Record<string, string> = { sm: 'sm', md: 'base', lg: 'lg' };
const iconSize = iconSizeMap[dotSize] || 'base';

const classes = [
  'list',
  `list--${variant}`,
  hasIcon && 'list--has-icon',
  hasMedia && 'list--has-media',
  variant === 'dot' && `list--dot-${dotSize}`,
  `list--${color}`,
  spacing !== 'normal' && `list--spacing-${spacing}`,
  flush && 'list--flush',
  className,
];
---

<Tag class:list={classes} {...dataAttrs}>
  {(items || []).map((item: ListItem) => {
    const text = typeof item === 'string' ? item : item.contentLink;
    const href = typeof item === 'string' ? undefined : item.href;
    return (
      <li class="list__item">
        {hasMedia && mediaComponent === 'Icon' && <Icon {...(mediaPropsWithSize as any)} class="list__media" />}
        {hasMedia && mediaComponent === 'Shape' && <Shape {...(mediaPropsWithSize as any)} class="list__media" />}
        {!hasMedia && hasIcon && (
          <Icon name={icon!} size={iconSize as any} semanticRole="content-symbol" class="list__icon" />
        )}
        {!hasMedia && variant === 'dot' && (
          <span class="list__dot" aria-hidden="true"></span>
        )}
        {href ? (
          <Link contentLink={text} href={href} class="list__content" variant="underline" />
        ) : (
          <Text {...(textProps as any)} contentText={text} as="span" class="list__content" flush />
        )}
      </li>
    );
  })}
</Tag>
