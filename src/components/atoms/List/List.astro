---
/**
 * List — Atomic list primitive
 *
 * Every list should go through this component.
 * Item text renders through Text atom (colour + family passed through).
 * List.css is the single source of truth for list styling.
 *
 * Colour comes from the global .color--{name} mixin (colour.css).
 * Marker pattern matches Heading.media: a single `media` prop accepts
 * { component: 'Icon'|'Shape', ...atomProps }. Each list item renders
 * its own instance.
 *
 * Styles: List.css | List.responsive.css
 *
 * Usage:
 *   <List contentList={['One', 'Two', 'Three']} />
 *   <List variant="numbered" contentList={['First', 'Second']} />
 *   <List media={{ component: 'Icon', name: 'check-circle-fill' }} contentList={['Done', 'Done']} />
 *   <List variant="dot" dotSize="lg" contentList={['Big dots']} />
 *   <List variant="none" contentList={['Clean', 'No bullets']} />
 *   <List variant="inline" contentList={['Tag', 'Tag', 'Tag']} />
 *   <List flush contentList={['Tight', 'No margin']} />
 *   <List textStyle={{ family: 'body' }} contentList={['Body text']} />
 */
import { Icon } from '../Icon';
import { Shape } from '../Shape';
import { Link } from '../Link';
import { Text } from '../Text';
import type { TextColour, RainbowColour } from '../../../lib/shared-enums';

type ListItem = string | { contentLink: string; href: string; };

interface Props {
  /** List items. Pipeline content key. */
  contentList?: ListItem[];
  variant?: 'default' | 'numbered' | 'none' | 'inline' | 'dot';
  dotSize?: 'sm' | 'md' | 'lg';
  /** Brand-scale marker colour. Use one of brandColor or rainbowColor. */
  brandColor?: TextColour;
  /** Rainbow palette marker colour (1-7). Use one of brandColor or rainbowColor. */
  rainbowColor?: RainbowColour;
  /** Text atom styling props forwarded to each item's Text. */
  textStyle?: Record<string, any>;
  spacing?: 'tight' | 'normal' | 'loose';
  flush?: boolean;
  /** Per-item marker atom — { component: 'Icon'|'Shape', ...atomProps }.
   *  Pattern matches Heading.media. mediaBg=true wraps in Shape container. */
  media?: Record<string, any>;
  /** true = media is a Shape wrapping a child atom (background container). */
  mediaBg?: boolean;
  /** Padding around child in Shape container mode. */
  mediaBgSize?: 'compact' | 'normal' | 'spacious';
  /** Marker size: 'auto' inherits item text size via em. */
  mediaSize?: 'auto' | 'xs' | 'sm' | 'md' | 'lg' | 'xl' | 'base' | '2xl' | '3xl';
  class?: string;
}

const {
  variant = 'default',
  dotSize = 'md',
  brandColor,
  rainbowColor,
  textStyle: textProps,
  spacing = 'normal',
  flush = false,
  media,
  mediaBg = false,
  mediaBgSize = 'normal',
  mediaSize = 'auto',
  class: className,
  contentList: items,
} = Astro.props;

// Resolve tag: numbered → ol, everything else → ul.
const Tag = variant === 'numbered' ? 'ol' : 'ul';

// Resolve colour: rainbow wins over brand if both set; default to 'primary'
// for marker visibility (markers are accents, body-text-coloured markers
// would be invisible against text).
const colour = rainbowColor || brandColor || 'primary';

const mediaComponent = media?.component;
const { component: _mc, ...rawMediaProps } = media || {};
const hasMedia = !!media;

// Marker sizing strategy:
//   - mediaSize="auto" (default): forward nothing — Icon/Shape base CSS
//     uses width:1em so the marker inherits the list item's text size.
//     Visual proportion lives in CSS (.list__media), not in JS literals.
//   - explicit mediaSize: pass through to the atom verbatim.
//   - author-set media.size: always wins (explicit per-instance override).
const mediaPropsWithSize = rawMediaProps.size != null
  ? rawMediaProps
  : mediaSize === 'auto'
    ? rawMediaProps
    : { ...rawMediaProps, size: mediaSize };

const classes = [
  'list',
  `list--${variant}`,
  hasMedia && 'list--has-media',
  hasMedia && mediaBg && 'list--has-media-bg',
  hasMedia && mediaBg && `list--media-bg-${mediaBgSize}`,
  variant === 'dot' && `list--dot-${dotSize}`,
  `color--${colour}`,
  spacing !== 'normal' && `list--spacing-${spacing}`,
  flush && 'list--flush',
  className,
];
---

<Tag class:list={classes}>
  {(items || []).map((item: ListItem) => {
    const text = typeof item === 'string' ? item : item.contentLink;
    const href = typeof item === 'string' ? undefined : item.href;
    return (
      <li class="list__item">
        {hasMedia && mediaComponent === 'Icon' && <Icon {...(mediaPropsWithSize as any)} class="list__media" />}
        {hasMedia && mediaComponent === 'Shape' && <Shape {...(mediaPropsWithSize as any)} class="list__media" />}
        {!hasMedia && variant === 'dot' && (
          <span class="list__dot" aria-hidden="true"></span>
        )}
        {href ? (
          <Link contentLink={text} href={href} class="list__content" variant="underline" />
        ) : (
          <Text {...(textProps as any)} contentText={text} as="span" class="list__content" flush />
        )}
      </li>
    );
  })}
</Tag>
