{
  "component": "List",
  "category": "atom",
  "renders": { "full": "List.astro", "reduced": "List.astro", "textonly": "List.astro" },
  "notes": "Every list goes through this component. Items render via Text atom (per-item content). Marker pattern matches Heading.media — single media prop accepts { component: 'Icon'|'Shape', ...atomProps }. Pipeline strips media in textonly (native bullets replace). Colour comes from the global .color--{name} mixin.",

  "props": {
    "content": {
      "contentList": { "type": "array", "required": true, "description": "Array of items. Each item is a string (plain text) or { contentLink, href } (linked item). Pipeline content key." }
    },

    "colour": {
      "brandColor": { "type": "string", "default": "primary", "enum": ["primary", "secondary", "neutral", "text"], "_description": "Marker colour. 'text' = body text scale, always readable." }
    },

    "rainbow": {
      "rainbowColor": { "type": "string", "enum": ["rainbow-1", "rainbow-2", "rainbow-3", "rainbow-4", "rainbow-5", "rainbow-6", "rainbow-7"] }
    },

    "media": {
      "media":       { "type": "object", "textonly": false, "_description": "Per-item marker atom. mediaBg=false: single Icon | Shape. mediaBg=true: Shape wrapping a child Icon via its own media prop.", "properties": { "component": { "type": "string", "required": true, "enum": ["Icon", "Shape"] }, "semanticRole": { "type": "string", "required": true, "default": "decorative", "enum": ["decorative", "ui-control", "content-symbol"] } } },
      "mediaBg":     { "type": "boolean", "default": false, "_description": "true = media is a Shape wrapping a child atom (background container)." },
      "mediaBgSize": { "type": "string", "default": "normal", "enum": ["compact", "normal", "spacious"], "_description": "Padding around child in Shape container. Only used when mediaBg=true." },
      "mediaSize":   { "type": "string", "default": "auto", "enum": ["auto", "xs", "sm", "md", "lg", "xl", "base", "2xl", "3xl"], "_description": "Marker size. 'auto' inherits item text size via em." }
    },

    "text": {
      "textStyle": { "type": "object", "_description": "Partial spread of Text styling props forwarded to each item's Text. List controls content + 'as' internally.", "properties": {
        "size":                  { "type": "string",  "enum": ["xs","sm","base","lg","xl"] },
        "weight":                { "type": "string",  "enum": ["light","normal","medium","semibold","bold","extrabold"] },
        "leading":               { "type": "string",  "enum": ["tight","snug","normal","relaxed"] },
        "family":                { "type": "string",  "enum": ["heading","body","body-alt","handwriting","mono"] },
        "align":                 { "type": "string",  "enum": ["left","center","right","justify"] },
        "brandColor":            { "type": "string",  "enum": ["primary","secondary","neutral","text"] },
        "rainbowColor":          { "type": "string",  "enum": ["rainbow-1","rainbow-2","rainbow-3","rainbow-4","rainbow-5","rainbow-6","rainbow-7"] },
        "highlight":             { "type": "boolean" },
        "highlightBrandColor":   { "type": "string",  "enum": ["primary","secondary","neutral","text"] },
        "highlightRainbowColor": { "type": "string",  "enum": ["rainbow-1","rainbow-2","rainbow-3","rainbow-4","rainbow-5","rainbow-6","rainbow-7"] },
        "highlightHeight":       { "type": "string",  "enum": ["sm","md","lg","full"] },
        "highlightOpacity":      { "type": "string",  "enum": ["faint","soft","bold","solid"] },
        "highlightShape":        { "type": "string",  "enum": ["sharp","rounded"] },
        "highlightShadow":       { "type": "string",  "enum": ["auto","on","off"] },
        "highlightCycle":        { "type": "boolean" },
        "uppercase":             { "type": "boolean" },
        "textTone":              { "type": "string",  "enum": ["light","dark"] }
      } }
    },

    "visual": {
      "variant": { "type": "string", "default": "default", "enum": ["default", "numbered", "none", "inline", "dot"], "_description": "default=bullets, numbered=ol, none=no markers, inline=horizontal, dot=custom circles." },
      "dotSize": { "type": "string", "default": "md", "enum": ["sm", "md", "lg"], "_description": "Dot marker size for variant=dot only." },
      "spacing": { "type": "string", "default": "normal", "enum": ["tight", "normal", "loose"] },
      "flush":   { "type": "boolean", "default": false, "_description": "Remove outer margin." }
    },

    "animation": {}
  }
}
