{
  "component": "List",
  "category": "atom",
  "renders": {
    "full": "List.astro",
    "reduced": "List.astro",
    "assistive": "List.astro",
    "textonly": "List.astro"
  },
  "notes": "Every list on the site goes through this component. Items render through Text atom. Icon variant uses Icon atom for decorative markers. No animation. All 4 renders use List.astro — pipeline strips icon prop in textonly (native bullets replace). Assistive render: all variants normalise to vertical stacked with large dot markers, icons hidden. Textonly render: native disc/decimal bullets, icons hidden, inline collapses to vertical.",

  "props": {
    "content": {
      "_description": "What the list contains",
      "as":             { "type": "string",  "required": false, "default": "ul", "enum": ["ul", "ol"], "description": "HTML element — unordered or ordered." },
      "items":          { "type": "array",   "required": false, "default": null, "description": "Simple string items. For complex content, use slot instead." },
      "icon":           { "type": "string",  "required": false, "default": null, "textonly": false, "description": "Phosphor icon slug for list markers. Decorative — stripped in textonly, native bullets replace." },
      "iconCollection": { "type": "string",  "required": false, "default": "interface", "description": "Icon collection override." }
    },

    "visual": {
      "_description": "How the list looks",
      "variant":   { "type": "string",  "required": false, "default": "default", "enum": ["default", "none", "inline", "dot"], "description": "List style variant." },
      "dotSize":   { "type": "string",  "required": false, "default": "md", "enum": ["sm", "md", "lg"], "description": "Dot variant marker size." },
      "color":     { "type": "string",  "required": false, "default": "primary", "enum": ["primary", "secondary", "neutral", "red", "orange", "yellow", "teal", "blue", "purple", "pink"], "description": "Colour variant for markers, icons, and dots." },
      "spacing":   { "type": "string",  "required": false, "default": "normal", "enum": ["tight", "normal", "loose"], "description": "Item spacing." },
      "flush":     { "type": "boolean", "required": false, "default": false, "description": "Remove outer margin." },
      "class":     { "type": "string",  "required": false, "default": "", "description": "Additional CSS classes." }
    },

    "animation": {},

    "colour": {
      "_description": "Pipeline colour tokens — set as inline styles. 'auto' = pipeline resolves from context.",
      "listMarker":       { "type": "token", "required": false, "default": "auto", "cssProperty": "--list-marker",        "description": "Marker/icon/dot colour." },
      "listMarkerAccent": { "type": "token", "required": false, "default": "auto", "cssProperty": "--list-marker-accent", "description": "Accent colour for icon/dot markers." },
      "listText":         { "type": "token", "required": false, "default": "auto", "cssProperty": "--list-text",          "description": "Text colour for icon/dot markers." }
    }
  },

  "slots": {
    "default": "Complex list items — use <li class=\"list__item\"><Text as=\"span\" flush>content</Text></li> for each"
  }
}
