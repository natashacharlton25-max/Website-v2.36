{
  "component": "Shape",
  "category": "atom",
  "renders": { "full": "Shape.astro", "reduced": "Shape.astro", "assistive": "Shape.astro", "textonly": null },
  "notes": "Decorative shape or container background. Built-in geometric shapes via CSS/SVG. API shapes from D1. Can wrap child atoms (Icon, text). textonly: null for decorative. Container behaviour auto-detected from slot/media. Shapes can be ui-control / content-symbol for interactive scrollytelling — they get tabindex, role=img, aria-label, focus indicators just like Icon.",

  "_rules": [
    { "rule": "icon-contrast-on-fill", "condition": "variant === 'fill' && media?.component === 'Icon' && (media.brandColor === brandColor || media.rainbowColor === rainbowColor || !media.brandColor && !media.rainbowColor)", "action": "Icon gets auto-contrast colour (oklch inversion) so it's visible against the filled shape background" },
    { "rule": "label-required-for-informational", "condition": "semanticRole === 'ui-control' || semanticRole === 'content-symbol'", "requires": "label", "note": "ui-control and content-symbol shapes must have label for screen readers" },
    { "rule": "draw-colour-base-only", "condition": "draw", "note": "drawColor only accepts base colour variants or rainbow — no tier modifiers (tint/mid/emphasis). Atom strips them at runtime via normalizeDrawColour." },
    { "rule": "draw-fill-mutual-exclusion", "condition": "draw && fillAnimation && fillTiming === 'overlap'", "note": "When draw and fillAnimation are both used, fillTiming controls whether fill bloom overlaps draw at 50% (default) or starts after draw completes ('after')" }
  ],

  "props": {
    "content": {
      "shape":        { "type": "string", "default": "circle", "enum": ["circle", "square", "subtle", "soft", "rounded", "rounded-lg", "pill", "hexagon", "diamond", "triangle", "star", "blob", "custom"] },
      "mode":         { "type": "string", "default": "shape", "enum": ["shape", "mask"], "_note": "shape: renders as visible shape. mask: uses shape as clip-path on content." },
      "renderAs":     { "type": "string", "default": "auto", "enum": ["auto", "css", "svg"], "_note": "auto: CSS for circle/square/rounded/pill, SVG for everything else. css: force CSS path (only valid for css-capable shapes). svg: force SVG path." },
      "slug":         { "type": "string", "_format": "shape-slug", "_note": "API shape slug — fetches SVG from Asset Library" },
      "semanticRole": { "type": "string", "default": "decorative", "enum": ["decorative", "ui-control", "content-symbol"], "_note": "decorative: aria-hidden. ui-control: tabindex 0 + role=img + label. content-symbol: role=img + label. Container behaviour is auto-detected from slot/media — no separate value needed." },
      "label":        { "type": "string", "_note": "Required for ui-control and content-symbol." }
    },

    "colour": {
      "brandColor": { "type": "string", "enum": ["primary", "secondary", "neutral"] }
    },

    "rainbow": {
      "rainbowColor": { "type": "string", "enum": ["rainbow-1", "rainbow-2", "rainbow-3", "rainbow-4", "rainbow-5", "rainbow-6", "rainbow-7"] },
      "colorTier":    { "type": "string", "default": "base", "enum": ["tint", "mid", "base", "emphasis"] }
    },

    "media": {
      "media": {
        "type": "object",
        "textonly": false,
        "_description": "Nested atom node. Shape becomes a container for the child atom. Icon/Image/LottieIcon handle their own props (colour, weight, animation).",
        "properties": {
          "component":    { "type": "string", "required": true, "enum": ["Icon", "LottieIcon", "Image"] },
          "semanticRole": { "type": "string", "required": true, "default": "decorative", "enum": ["decorative", "ui-control", "content-symbol"] }
        }
      }
    },

    "gradient": {
      "gradient":                 { "type": "boolean", "default": false },
      "gradientBlend":            { "type": "string", "enum": ["hero", "sunset", "brand-emerge", "brand-fade", "preset-tint", "preset-mid", "preset-base", "preset-emphasis", "primary", "secondary", "neutral", "red", "orange", "yellow", "teal", "blue", "purple", "pink", "rainbow"] },
      "gradientDirection":        { "type": "string", "default": "diagonal", "enum": ["vertical", "vertical-reverse", "horizontal", "horizontal-reverse", "diagonal", "diagonal-reverse", "diagonal-alt", "diagonal-alt-reverse"] },
      "gradientType":             { "type": "string", "default": "linear", "enum": ["linear", "radial"] },
      "gradientFocus":            { "type": "string", "default": "center", "enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"], "_note": "Radial origin point — only used when gradientType=radial." },
      "gradientEmerge":           { "type": "boolean", "default": false, "_description": "Fade-in modifier — first 50% transparent, fades to solid. Combines with any gradient or solid colour." },
      "gradientFade":             { "type": "boolean", "default": false, "_description": "Fade-out modifier — last 20% fades to transparent. Combines with any gradient or solid colour." },
      "gradientAnimated":         { "type": "boolean" },
      "gradientAnimateMode":      { "type": "string", "default": "rotate", "enum": ["rotate"] },
      "gradientAnimateSpeed":     { "type": "string", "default": "default", "enum": ["slow", "default", "fast"], "_note": "Animation speed — slow (20s), default (12s), fast (6s). Matches Icon/Heading/Badge. Gated by motion settings." },
      "gradientAnimateEase":      { "type": "string", "enum": ["jelly", "wobble", "bounce", "snap"] },
      "gradientAnimateDirection": { "type": "string", "default": "cw", "enum": ["cw", "ccw", "sway"] },
      "gradientAnimateScale":     { "type": "boolean", "_note": "Pulse scale 0.8→1.5 alongside rotation" }
    },

    "visual": {
      "size":         { "type": "string", "default": "base", "enum": ["xs", "sm", "md", "lg", "xl", "base", "2xl", "3xl", "4xl", "5xl", "6xl", "7xl", "8xl"] },
      "variant":      { "type": "string", "default": "fill", "enum": ["fill", "outline", "glass", "liquid-glass"] },
      "borderWeight": { "type": "string", "enum": ["sm", "md", "lg"] },
      "shadow":       { "type": "string", "enum": ["sm", "md", "lg", "elevated"] },
      "glow":         { "type": "string", "enum": ["sm", "md", "lg"] }
    },

    "animation": {
      "animation":        { "type": "string", "enum": ["spin", "bounce", "shake", "float", "drift", "slide-up", "slide-down", "slide-left", "slide-right", "flip", "pulse", "ping", "pop", "squish", "heartbeat", "rubber-band", "fade", "blink", "flash", "glint", "shimmer", "twinkle", "wiggle", "swing", "rock", "nod", "attention", "celebrate", "enter", "exit"] },
      "animationTrigger":  { "type": "string", "default": "hover", "enum": ["hover", "viewport", "autoplay", "loop", "interval", "click", "focus", "none"] },
      "animationRepeat":   { "type": "string", "default": "threeloop", "enum": ["once", "loop", "three", "threeloop"], "description": "How many times to play: once, loop (infinite), three (3x then stop), threeloop (3x then pause [interval] then repeat). Default = threeloop, matches Icon/LottieIcon." },
      "animationInterval": { "type": "string", "default": "base", "enum": ["short", "base", "long", "longer"], "description": "Gap between attention-pulse bursts. Token-driven (motion-mode scaled). Used by animationRepeat=threeloop and animationTrigger=interval. Matches Icon/LottieIcon." },

      "draw":             { "type": ["boolean", "string"], "enum": [true, "draw", "drawcenter", "pulse"] },
      "drawMode":         { "type": "string", "default": "static", "enum": ["static", "yoyo", "reverse-yoyo", "reveal"] },
      "drawOnce":         { "type": "boolean" },
      "drawLaser":        { "type": "boolean" },
      "drawGhost":        { "type": "boolean", "_note": "Use --svg-ghost-color token for ghost stroke (no separate ghostColor prop needed)" },
      "drawColor":        { "type": "string", "enum": ["primary", "secondary", "neutral", "rainbow-1", "rainbow-2", "rainbow-3", "rainbow-4", "rainbow-5", "rainbow-6", "rainbow-7", "hero", "sunset", "brand-emerge", "brand-fade", "rainbow"], "_note": "BASE colours only — no tier modifiers. Tier suffixes are stripped at runtime. Rainbow colours use positional names (rainbow-1..7) matching CSS tokens." },
      "drawStagger":      { "type": "string", "default": "normal", "enum": ["none", "tight", "normal", "loose"] },
      "drawStaggerFrom":  { "type": "string", "default": "start", "enum": ["start", "center", "end", "edges", "random"] },
      "drawWormSize":     { "type": "number", "default": 10, "_note": "Laser worm segment size as percentage of path length (1-99)" },
      "drawOnScroll":     { "type": "boolean", "_note": "Trigger draw when element enters viewport" },
      "drawScrub":        { "type": "boolean", "_note": "Scrub draw progress with scroll position (only with drawOnScroll)" },

      "morphTo":          { "type": "string", "_format": "shape-slug", "_note": "Built-in shape name OR D1 slug. Goo morph technique applies automatically." },
      "morphTrigger":     { "type": "string", "default": "hover", "enum": ["hover", "viewport", "scroll"] },
      "morphStagger":     { "type": "string", "enum": ["none", "tight", "normal", "loose"] },
      "morphStaggerFrom": { "type": "string", "default": "start", "enum": ["start", "center", "end", "edges", "random"] },

      "fillAnimation":    { "type": "boolean", "_note": "Bloom fill from centre on trigger" },
      "fillOutline":      { "type": "boolean", "_note": "Also draw stroke outline using addVariant — combines with fillDrawVariant/fillDrawLaser" },
      "fillDrawVariant":  { "type": "string", "enum": ["draw", "drawcenter", "pulse"] },
      "fillDrawLaser":    { "type": "boolean" },
      "fillMode":         { "type": "string", "default": "once", "enum": ["once", "yoyo", "static", "fade", "ghost", "ghoststatic", "twinkle", "reduced"] },
      "fillTrigger":      { "type": "string", "default": "hover", "enum": ["hover", "viewport", "scrub", "rainbow", "loop", "autoplay"] },
      "fillDuration":     { "type": "string", "default": "normal", "enum": ["fast", "normal", "slow", "slower"] },
      "fillEase":         { "type": "string", "enum": ["jelly", "wobble", "bounce", "snap"] },
      "fillColor":        { "type": "string", "enum": ["primary", "secondary", "neutral", "text", "rainbow-1", "rainbow-2", "rainbow-3", "rainbow-4", "rainbow-5", "rainbow-6", "rainbow-7"] },
      "fillStagger":      { "type": "string", "default": "normal", "enum": ["none", "tight", "normal", "loose"] },
      "fillStaggerFrom":  { "type": "string", "default": "start", "enum": ["start", "center", "end", "edges", "random"] },
      "fillTiming":       { "type": "string", "default": "overlap", "enum": ["overlap", "after"], "_note": "When draw + fill combined: overlap starts fill at 50% draw, after waits for draw to finish" }
    }
  }
}
