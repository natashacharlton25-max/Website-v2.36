---
/**
 * Shape — all shapes rendered as SVG.
 * Fill/stroke/glass controlled by variant.
 * Same system as Icon — works with draw, morph, gradient, GSAP.
 */

import { Icon } from '../Icon';
import { Image } from '../Image';
import { LottieIcon } from '../LottieIcon';

import type {
  BrandColour, RainbowColour, ColourTier,
  Variant, Shadow,
  GradientBlend, GradientDirection,
  Animation, AnimationTriggerInteractive, AnimationRepeat, AnimationInterval,
  ShapeSemanticRole, ShapeSize, ShapeBorderWeight,
  DrawVariant, DrawMode, DrawColour, DrawWormSize,
  Stagger, StaggerFrom,
  MorphTrigger,
  FillMode, FillTrigger, FillDuration, FillTiming,
  GradientAnimateDirection,
} from '../../../lib/shared-enums';
import { normalizeDrawColour } from '../../../lib/shared-enums';
import { resolveInlineGradient, getGradientStopColours } from '../../../lib/gradient-inline';
import { SHAPE_PATHS } from '../../../lib/shape-paths';
import { resolveLogoToSvg, resolvePhraseToSvg } from '../../../lib/text-paths/resolver';
import type { LogoKey } from '../../../lib/text-paths/resolver';

const ASSET_API_URL = import.meta.env.ASSET_API_URL || 'http://localhost:8787';
const ASSET_API_TOKEN = import.meta.env.ASSET_API_TOKEN || '';

type ShapeType = 'circle' | 'square' | 'rounded' | 'pill' | 'hexagon' | 'diamond' | 'triangle' | 'star' | 'blob' | 'custom';
type ShapeMode = 'shape' | 'mask';
type ShapeRenderAs = 'auto' | 'css' | 'svg';

interface Props {
  shape?: ShapeType;
  mode?: ShapeMode;
  /** Force a specific render path. 'auto' (default) uses CSS for circle/square/rounded/pill and SVG for everything else. */
  renderAs?: ShapeRenderAs;
  slug?: string;
  /** BRAND_CONFIG.logo key shorthand — resolves to inline SVG at build
   *  time via the shared text-paths resolver. Mutually exclusive with
   *  slug and phraseKey. Use for animated brand logos in headers/footers,
   *  hero intros, etc. */
  logoKey?: LogoKey;
  /** registry.json phrase key shorthand — resolves to inline SVG at
   *  build time via the shared text-paths resolver. The path data is
   *  pre-baked by scripts/build-text-paths.mjs. Mutually exclusive with
   *  slug and logoKey. Use for animated brand phrases / decorative
   *  typography. */
  phraseKey?: string;
  semanticRole?: ShapeSemanticRole;
  /** Human-readable label. Required for ui-control and content-symbol.
   *  Forbidden when semanticRole='background' (the child atom owns meaning).
   *  Atom-suffixed name (label<Atom>) avoids collisions when Shape is composed inside other atoms. */
  labelShape?: string;
  brandColor?: BrandColour;
  rainbowColor?: RainbowColour;
  colorTier?: ColourTier;
  size?: ShapeSize;
  /** Padding around child atom when Shape contains media. Only applies when
   *  Shape wraps a child (auto-detected from slot/media). compact = tight
   *  hug, normal = default, spacious = generous breathing room. Matches
   *  Heading.mediaBgSize and List.mediaBgSize. */
  mediaBgSize?: 'compact' | 'normal' | 'spacious';
  variant?: Variant;
  borderWeight?: ShapeBorderWeight;
  shadow?: Shadow;
  glow?: 'sm' | 'md' | 'lg';
  gradient?: boolean;
  gradientBlend?: GradientBlend;
  gradientDirection?: GradientDirection;
  /** linear (default) or radial */
  gradientType?: 'linear' | 'radial';
  /** Radial origin — only used when gradientType=radial */
  gradientFocus?: 'center' | 'top' | 'bottom' | 'left' | 'right' | 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';
  /** Fade-in modifier — first 50% transparent, fades to solid */
  gradientEmerge?: boolean;
  /** Fade-out modifier — last 20% fades to transparent */
  gradientFade?: boolean;
  /** Colour cycle — cross-fades through the element's own tier tokens (tint→mid→base→emphasis). */
  gradientCycle?: boolean;
  gradientAnimated?: boolean;
  /** Animation speed — slow (20s), default (12s), fast (6s). Matches Icon/Heading/Badge. */
  gradientAnimateSpeed?: 'slow' | 'default' | 'fast';
  gradientAnimateEase?: string;
  gradientAnimateDirection?: GradientAnimateDirection;
  gradientAnimateScale?: boolean;
  media?: Record<string, any>;
  animation?: Animation;
  animationTrigger?: AnimationTriggerInteractive;
  /** How many times to play. Matches Icon/LottieIcon. */
  animationRepeat?: AnimationRepeat;
  /** Gap between attention-pulse bursts. Token-driven. Matches Icon/LottieIcon. */
  animationInterval?: AnimationInterval;
  draw?: boolean | DrawVariant;
  drawMode?: DrawMode;
  /** Draws then disappears. Not valid with drawGhost. Mirrors Icon.drawOnce. */
  drawOnce?: boolean;
  drawLaser?: boolean;
  drawGhost?: boolean;
  drawColor?: DrawColour | string;
  drawStagger?: Stagger;
  drawStaggerFrom?: StaggerFrom;
  drawWormSize?: DrawWormSize;
  drawOnScroll?: boolean;
  drawScrub?: boolean;
  morphTo?: string;
  morphTrigger?: MorphTrigger;
  morphStagger?: Stagger;
  morphStaggerFrom?: StaggerFrom;
  fillAnimation?: boolean;
  fillOutline?: boolean;
  fillDrawVariant?: DrawVariant;
  fillDrawLaser?: boolean;
  fillMode?: FillMode;
  fillTrigger?: FillTrigger;
  fillDuration?: FillDuration;
  fillEase?: string;
  fillColor?: string;
  fillStagger?: Stagger;
  fillStaggerFrom?: StaggerFrom;
  fillTiming?: FillTiming;
  class?: string;
}

const {
  shape = 'circle', mode = 'shape', renderAs = 'auto', slug, logoKey, phraseKey, semanticRole = 'decorative', labelShape,
  brandColor, rainbowColor, colorTier,
  size = 'base', mediaBgSize = 'normal', variant = 'fill', borderWeight, shadow, glow,
  gradient = false, gradientBlend, gradientDirection = 'diagonal', gradientType, gradientFocus, gradientEmerge = false, gradientFade = false, gradientCycle = false, gradientAnimated, gradientAnimateSpeed, gradientAnimateEase, gradientAnimateDirection, gradientAnimateScale,
  media, animation, animationTrigger = 'hover', animationRepeat = 'threeloop', animationInterval = 'base',
  draw, drawMode: rawDrawMode = 'static', drawOnce, drawLaser, drawGhost, drawColor: rawDrawColor, drawStagger = 'normal', drawStaggerFrom = 'start', drawWormSize = 'sm', drawOnScroll, drawScrub, morphTo, morphTrigger = 'hover', morphStagger, morphStaggerFrom = 'start',
  fillAnimation, fillOutline, fillDrawVariant, fillDrawLaser, fillMode, fillTrigger = 'hover', fillDuration = 'normal', fillEase, fillColor, fillStagger = 'normal', fillStaggerFrom = 'start', fillTiming = 'overlap',
  class: className,
} = Astro.props;

// Strip tier suffixes from drawColor (e.g. "red-tint" → "red") since draw
// strokes need full opacity — tiers are opacity-based and would render the
// stroke partially transparent.
const drawColor = normalizeDrawColour(rawDrawColor);

// drawOnce overrides drawMode to 'once'. Combined with drawGhost (persistent
// strokes) it cancels — drawGhost wins. Mirrors Icon's same-named override.
const drawMode = (drawOnce && !drawGhost) ? 'once' : rawDrawMode;

const resolvedColor = rainbowColor || brandColor || null;
const hasSlot = Astro.slots.has('default');
const hasMedia = !!media;
const mediaComponent = media?.component;
// Child sizing: when Shape contains media, the child atom keeps its own
// size (or inherits text-size from context) and Shape wraps to fit + the
// padding controlled by mediaBgSize. No size injection on the child here —
// the visual hierarchy is "Shape is wallpaper, child owns its size".
const { component: _mc, ...mediaProps } = media || {};

// Auto-contrast safeguard: when Shape variant=fill and the child Icon/LottieIcon
// has the same brand/rainbow colour + tier as Shape, the child would render in
// the same colour as the fill — invisible. Strip the redundant colour prop so
// the child falls back to inheriting currentColor, which Shape.css already
// computes as an oklch contrast against --_color.
// Detection: explicit colour matches (primary===primary, rainbow-1===rainbow-1)
// AND tier matches (default 'base' both sides if either is undefined).
const _shapeBaseColour = rainbowColor || brandColor;
const _iconBaseColour = (mediaProps as any).rainbowColor || (mediaProps as any).brandColor;
const _shapeTier = colorTier || 'base';
const _iconTier = (mediaProps as any).colorTier || 'base';
const _childInvisible = (
  variant === 'fill' &&
  (mediaComponent === 'Icon' || mediaComponent === 'LottieIcon') &&
  !!_shapeBaseColour &&
  _iconBaseColour === _shapeBaseColour &&
  _iconTier === _shapeTier
);
if (_childInvisible) {
  delete (mediaProps as any).brandColor;
  delete (mediaProps as any).rainbowColor;
  delete (mediaProps as any).colorTier;
}
// Container is auto-detected from slot/media — no separate prop needed
const isContainer = hasSlot || hasMedia;
// A11y: ui-control and content-symbol need labels, focus, and role.
// background = explicit "I'm wallpaper around a child atom" — child owns
// meaning, Shape stays aria-hidden with no label. Behaviour is identical to
// 'decorative' but the explicit value lets the validator forbid labelShape
// and require media, and lets authors signal intent in JSON.
const isInformational = semanticRole === 'ui-control' || semanticRole === 'content-symbol';
const isBackground = semanticRole === 'background';
if (isInformational && !labelShape && import.meta.env.DEV) {
  console.warn(`[Shape] semanticRole="${semanticRole}" requires labelShape for accessibility`);
}
if (isBackground && labelShape && import.meta.env.DEV) {
  console.warn(`[Shape] semanticRole="background" forbids labelShape — child atom owns meaning`);
}
if (isBackground && !hasMedia && !hasSlot && import.meta.env.DEV) {
  console.warn(`[Shape] semanticRole="background" requires media (Shape is wallpaper for a child atom)`);
}

// A11y: any shape with an interaction (hover/click/focus animation, draw,
// morph, fill animation) MUST be focusable. Eye-gaze, switch access,
// keyboard users — all OS-level AT translates input into focus/click events.
// Interactivity is independent of decorative-vs-informational semanticRole.
const interactiveTriggers = ['hover', 'click', 'focus'];
const animationIsInteractive = !!animation && interactiveTriggers.includes(animationTrigger);
const drawIsInteractive = !!draw && (drawOnScroll || drawScrub
  ? false
  : interactiveTriggers.includes((animationTrigger as string)));
const morphIsInteractive = !!morphTo && morphTrigger === 'hover';
const fillIsInteractive = !!fillAnimation && fillTrigger === 'hover';
const isInteractive = isInformational
  || animationIsInteractive
  || drawIsInteractive
  || morphIsInteractive
  || fillIsInteractive;
// Resolve role: informational shapes stay role="img"; pure-interactive
// (hover/click animations without semanticRole) become role="button" so
// screen readers announce them as activatable.
const a11yRole = isInformational ? 'img' : (isInteractive ? 'button' : undefined);

// Resolve inline SVG content. Three sources, evaluated in priority order:
//   1. logoKey   → BRAND_CONFIG.logo lookup via shared resolver (build-time)
//   2. phraseKey → registry.json phrase via shared resolver (build-time)
//   3. slug      → Asset Library API fetch (build-time HTTP)
// First match wins. svgContent flows into the same downstream render path
// regardless of source, so GSAP draw / colour / stagger / gradient all
// behave identically.
let svgContent: string | null = null;
if (logoKey) {
  const resolved = resolveLogoToSvg(logoKey);
  if (resolved) svgContent = resolved.markup;
} else if (phraseKey) {
  const resolved = resolvePhraseToSvg(phraseKey);
  if (resolved) svgContent = resolved.markup;
} else if (slug) {
  try {
    const headers: Record<string, string> = {};
    if (ASSET_API_TOKEN) headers['Authorization'] = `Bearer ${ASSET_API_TOKEN}`;
    const res = await fetch(`${ASSET_API_URL}/v1/assets/${slug}`, { headers });
    if (res.ok) svgContent = await res.text();
  } catch { /* fallback to built-in */ }
}

// Stroke width per borderWeight tier. Draw mode needs thicker lines because
// GSAP renders an overlay path at viewBox 256 with sw=10; the built-in
// shapes are viewBox 100 so we proportionally bump the stroke by ~2 to
// keep visual weight consistent. Local map (only Shape uses it) — Icon
// has its own stroke logic baked into its API SVGs.
const STROKE_WIDTH_MAP = {
  draw:   { sm: 4, md: 5, lg: 6 },
  normal: { sm: 2, md: 3, lg: 4 },
} as const;
const swKey = (borderWeight ?? 'sm') as keyof typeof STROKE_WIDTH_MAP['draw'];
const sw = (draw ? STROKE_WIDTH_MAP.draw : STROKE_WIDTH_MAP.normal)[swKey];
const pad = sw;
const SHAPE_VIEWBOX_BASE = 100; // Built-in shapes are designed in 100×100 — see src/lib/shape-paths.ts
const vb = `-${pad} -${pad} ${SHAPE_VIEWBOX_BASE + pad * 2} ${SHAPE_VIEWBOX_BASE + pad * 2}`;

// Built-in shape paths come from src/lib/shape-paths.ts (shared so morph.ts
// and other handlers can import the same source of truth).
const cssCapableShapes = ['circle', 'square', 'subtle', 'soft', 'rounded', 'rounded-lg', 'pill'];
const cssCapable = cssCapableShapes.includes(shape) && !draw && !morphTo && !fillAnimation;
// renderAs decides: 'css' requests CSS path (only valid for cssCapable shapes — falls
// back to SVG if the shape isn't CSS-capable), 'svg' forces SVG path, 'auto' (default)
// picks CSS for cssCapable shapes and SVG for everything else. Author-facing docs
// suggest 'css' is a forcing flag, but the runtime can't render hexagon-via-CSS, so
// the silent fallback is real — flag it in dev so the mismatch is visible.
if (renderAs === 'css' && !cssCapable && import.meta.env.DEV) {
  console.warn(`[Shape] renderAs="css" requested but shape="${shape}" isn't CSS-capable (draw/morph/fillAnimation also disable CSS). Falling back to SVG.`);
}
const isCssShape = renderAs === 'svg' ? false : cssCapable;
const isSvgShape = !isCssShape;
const builtinSvg = isSvgShape ? SHAPE_PATHS[shape] : undefined;

// Draw data attributes.
// `data-icon-*` is the shared SVG-animation contract used by both Icon and
// Shape — handlers live in src/lib/animation/svg-animation/. The "icon"
// prefix is historical, not Icon-specific. Shape participates in the same
// draw/morph/fill/gradient pipeline.
const drawVariant = typeof draw === 'string' ? draw : 'draw';
const dataAttrs: Record<string, string | undefined> = {};
if (draw) {
  dataAttrs['data-icon-draw'] = drawVariant;
  dataAttrs['data-icon-draw-mode'] = drawMode;
  dataAttrs['data-icon-draw-sw'] = String(sw);
  if (drawLaser) dataAttrs['data-icon-draw-laser'] = 'true';
  if (drawGhost) dataAttrs['data-icon-draw-ghost'] = 'true';
  if (drawColor) dataAttrs['data-icon-draw-color'] = drawColor;
  if (drawStagger) dataAttrs['data-icon-draw-stagger'] = drawStagger;
  if (drawStaggerFrom) dataAttrs['data-icon-draw-stagger-from'] = drawStaggerFrom;
  if (drawWormSize) dataAttrs['data-icon-draw-worm-size'] = drawWormSize;
  if (drawOnScroll) dataAttrs['data-icon-draw-scroll'] = 'true';
  if (drawScrub) dataAttrs['data-icon-draw-scrub'] = 'true';
  if (animationTrigger && animationTrigger !== 'hover') dataAttrs['data-icon-draw-trigger'] = animationTrigger;
}
// Fill animation
if (fillAnimation) {
  dataAttrs['data-icon-fill'] = 'true';
  if (fillMode && fillMode !== 'once') dataAttrs['data-icon-fill-mode'] = fillMode;
  if (fillTrigger !== 'hover') dataAttrs['data-icon-fill-trigger'] = fillTrigger;
  if (fillDuration) dataAttrs['data-icon-fill-duration'] = fillDuration;
  if (fillEase) dataAttrs['data-icon-fill-ease'] = fillEase;
  if (fillOutline) dataAttrs['data-icon-fill-outline'] = 'true';
  if (fillDrawVariant) dataAttrs['data-icon-fill-draw-variant'] = fillDrawVariant;
  if (fillDrawLaser) dataAttrs['data-icon-fill-draw-laser'] = 'true';
  if (fillColor) dataAttrs['data-icon-fill-color'] = fillColor;
  if (fillStagger) dataAttrs['data-icon-fill-stagger'] = fillStagger;
  if (fillStaggerFrom) dataAttrs['data-icon-fill-stagger-from'] = fillStaggerFrom;
  if (fillTiming) dataAttrs['data-icon-fill-timing'] = fillTiming;
}
// Morph target: built-in shape name or D1 slug
let morphTargetSvg: string | null = null;
if (morphTo) {
  // Check if it's a built-in shape name
  const builtinTarget = SHAPE_PATHS[morphTo];
  if (builtinTarget) {
    morphTargetSvg = `<svg viewBox="${vb}"><g>${builtinTarget}</g></svg>`;
  } else {
    // Fetch from D1
    try {
      const headers: Record<string, string> = {};
      if (ASSET_API_TOKEN) headers['Authorization'] = `Bearer ${ASSET_API_TOKEN}`;
      const res = await fetch(`${ASSET_API_URL}/v1/assets/${morphTo}`, { headers });
      if (res.ok) {
        let s = await res.text();
        if (!s.includes('viewBox')) s = s.replace(/<svg/, '<svg viewBox="0 0 256 256"');
        s = s.replace(/\s*width="\d+"/g, '');
        s = s.replace(/\s*height="\d+"/g, '');
        s = s.replace(/fill="rgb\([^"]*\)"/g, 'fill="currentColor"');
        s = s.replace(/fill="#[a-fA-F0-9]+"/g, 'fill="currentColor"');
        morphTargetSvg = s;
      }
    } catch { /* ignore */ }
  }
  dataAttrs['data-icon-morph'] = 'true';
  if (morphTargetSvg) dataAttrs['data-icon-morph-target'] = morphTargetSvg;
  if (morphTrigger && morphTrigger !== 'hover') dataAttrs['data-icon-morph-trigger'] = morphTrigger;
  if (morphStagger) dataAttrs['data-icon-morph-stagger'] = morphStagger;
  if (morphStaggerFrom) dataAttrs['data-icon-morph-stagger-from'] = morphStaggerFrom;
}

// Resolve which gradient ID to reference. Priority:
//   1. gradientBlend (named blends like hero/sunset/brand-emerge/brand-fade/rainbow)
//   2. rainbowColor + colorTier (e.g. rainbow-1 + tint → grad-rainbow-1-preset-tint)
//   3. rainbowColor (rainbow-1..7 → grad-rainbow-1..7)
//   4. brandColor + colorTier (primary + mid → grad-primary-preset-mid)
//   5. brandColor (primary/secondary/neutral → grad-primary etc.)
//   6. fallback to primary if gradient enabled with no colour
// gradientType=radial appends `-radial` to ANY of the above (catalogue generates radial twins).
// All IDs come from the generated catalogue (scripts/build-gradients.mjs).
// Radial gradients only read as radial above a size threshold. Below 2xl
// they compress into apparent flat colour. Runtime gates the radial path so
// AI-generated JSON requesting radial on tiny shapes silently downgrades to
// linear (the safer fallback) instead of rendering a broken-looking shape.
// Authors who really want radial on small elements should use Card/Section.
const RADIAL_MIN_SIZES = new Set(['2xl', '3xl', '4xl', '5xl', '6xl', '7xl', '8xl']);
const radialAllowed = !!size && RADIAL_MIN_SIZES.has(size);
if (gradientType === 'radial' && !radialAllowed && import.meta.env.DEV) {
  console.warn(`[Shape] gradientType="radial" only renders well at size 2xl+. Got size="${size ?? 'unset'}" — downgrading to linear.`);
}
const effectiveGradientType = gradientType === 'radial' && !radialAllowed ? 'linear' : gradientType;

const baseColour = rainbowColor || brandColor;
const tierSuffix = (gradient && colorTier && colorTier !== 'base') ? `-preset-${colorTier}` : '';
const radialSuffix = effectiveGradientType === 'radial' ? '-radial' : '';
const baseGradientName = gradientBlend
  || (gradient && baseColour ? `${baseColour}${tierSuffix}` : null)
  || (gradient ? 'primary' : null);
const gradientName = baseGradientName ? `${baseGradientName}${radialSuffix}` : null;
// Animated gradient via GSAP — SVG render path. Handler reads speed from
// --_grad-anim-duration (set by .gradient--speed-* class), so no data-attr
// for duration is needed. Direction/ease/scale stay as data-attrs because
// they're discrete enums consumed only by the GSAP handler.
if (gradientAnimated && gradientName && !isCssShape) {
  dataAttrs['data-icon-grad-anim'] = ''; // presence flag
  if (gradientAnimateEase) dataAttrs['data-icon-grad-ease'] = gradientAnimateEase;
  if (gradientAnimateDirection !== 'cw') dataAttrs['data-icon-grad-dir'] = gradientAnimateDirection;
  if (gradientAnimateScale) dataAttrs['data-icon-grad-scale'] = 'true';
}

// Colour cycle stop tokens — these are the only legitimate inline-style values.
// They depend on gradientName (resolved per instance from the catalogue), so
// they can't go in CSS classes. Speed is class-based (.gradient--speed-*),
// phase desync is GSAP's job. No --_grad-anim-delay or --_grad-anim-duration
// emitted from here.
const animStyleParts: string[] = [];
if (gradientCycle) {
  const stopColours = gradientName ? getGradientStopColours(gradientName) : null;
  if (stopColours && stopColours.length >= 2) {
    const a = stopColours[0];
    const b = stopColours.length > 2 ? stopColours[Math.floor(stopColours.length / 2)] : stopColours[1];
    const c = stopColours[stopColours.length - 1];
    animStyleParts.push(`--_cycle-a:${a}`);
    animStyleParts.push(`--_cycle-b:${b}`);
    animStyleParts.push(`--_cycle-c:${c}`);
  }
}
const animInlineStyle = animStyleParts.length ? animStyleParts.join(';') : undefined;
// Gradient reference for SVG fill — GSAP creates its own local gradient at runtime for animated.
// For solo emerge/fade we generate an inline gradient per shape so the direction can be
// computed dynamically (the baked grad-emerge-{colour} defs are 135° only).
// Solo emerge/fade — when no underlying gradient, use catalogue id `emerge-{colour}` / `fade-{colour}`.
// gradientType=radial appends `-radial` to use the radial catalogue variant.
const modifierColour = rainbowColor || brandColor || 'primary';
const soloRadialSuffix = effectiveGradientType === 'radial' ? '-radial' : '';
const soloModifierId = !gradientName && gradientEmerge ? `emerge-${modifierColour}${soloRadialSuffix}`
  : !gradientName && gradientFade ? `fade-${modifierColour}${soloRadialSuffix}`
  : null;
const effectiveGradientName = gradientName || soloModifierId;

// Inline SVG gradient — resolved from the catalogue when a direction or focus is set,
// since the baked defs in SvgGradientDefs.astro are fixed-angle / center-only.
// Returns null for the default (135° linear, center radial) — uses baked def in that case.
const needsInline = effectiveGradientName && (gradientDirection || effectiveGradientType === 'radial');
const inlineGradient = needsInline
  ? resolveInlineGradient(effectiveGradientName, { direction: gradientDirection, focus: gradientFocus })
  : null;
const svgGradRef = inlineGradient?.id
  || (effectiveGradientName ? `grad-${effectiveGradientName}` : null);

const isMask = mode === 'mask';
const maskId = isMask ? `shape-mask-${Math.random().toString(36).substring(2, 9)}` : undefined;
---

<div
  class:list={[
    'shape',
    !svgContent && `shape--${shape}`,
    svgContent && 'shape--api',
    !isCssShape && 'shape--svg',
    size && `shape--${size}`,
    `shape--${variant}`,
    resolvedColor && `color--${resolvedColor}`,
    colorTier && colorTier !== 'base' && `color--tier-${colorTier}`,
    shadow && `shape--shadow-${shadow}`,
    glow && `shape--glow-${glow}`,
    gradientName && 'gradient',
    gradientName && `gradient--${variant}`,
    /* Always emit blend class from gradientName so generated CSS rules match
       (handles blends, single colours, AND tier presets like rainbow-1-preset-tint). */
    gradientName && `gradient--blend-${gradientName}`,
    gradientEmerge && 'gradient--emerge',
    gradientFade && 'gradient--fade',
    gradientAnimated && 'gradient--animated',
    gradientAnimated && gradientAnimateSpeed && gradientAnimateSpeed !== 'default' && `gradient--speed-${gradientAnimateSpeed}`,
    gradientCycle && 'gradient--cycle',
    animation && `anim--${animation}`,
    draw && 'shape--draw',
    isContainer && 'shape--container',
    isContainer && `shape--bg-${mediaBgSize}`,
    className,
  ]}
  aria-hidden={!isInteractive && (semanticRole === 'decorative' || semanticRole === 'background' || !semanticRole) ? "true" : undefined}
  aria-label={isInformational ? labelShape : (isInteractive && labelShape ? labelShape : undefined)}
  tabindex={isInteractive ? "0" : undefined}
  role={a11yRole}
  data-semantic-role={semanticRole}
  data-grad-dir={gradientDirection || undefined}
  data-grad-focus={effectiveGradientType === 'radial' ? (gradientFocus || 'center') : undefined}
  data-grad-anim-dir={gradientAnimated && gradientAnimateDirection && gradientAnimateDirection !== 'cw' ? gradientAnimateDirection : undefined}
  data-anim-trigger={animation && animationTrigger !== 'hover' ? animationTrigger : undefined}
  data-anim-repeat={animation && animationRepeat !== 'once' ? animationRepeat : undefined}
  data-anim-interval={animation && (animationRepeat === 'threeloop' || animationTrigger === 'interval') ? animationInterval : undefined}
  style={animInlineStyle}
  {...dataAttrs}
>
  {builtinSvg && !svgContent && (
    <svg class:list={['shape__svg', `shape__svg--${variant}`, (gradientName || inlineGradient) && 'shape__svg--gradient']} viewBox={vb} overflow="visible" aria-hidden="true">
      {/* Inline gradient def — built from catalogue stops with direction or focus override.
          Only rendered when a direction/focus is set; otherwise the baked SvgGradientDefs def is used. */}
      {inlineGradient && inlineGradient.kind === 'linear' && (
        <defs>
          <linearGradient id={inlineGradient.id} x1={inlineGradient.x1} y1={inlineGradient.y1} x2={inlineGradient.x2} y2={inlineGradient.y2}>
            {inlineGradient.stops.map((s) => (
              <stop offset={`${s.offset}%`} stop-color={s.colour} />
            ))}
          </linearGradient>
        </defs>
      )}
      {inlineGradient && inlineGradient.kind === 'radial' && (
        <defs>
          <radialGradient id={inlineGradient.id} cx={inlineGradient.cx} cy={inlineGradient.cy} r={inlineGradient.r}>
            {inlineGradient.stops.map((s) => (
              <stop offset={`${s.offset}%`} stop-color={s.colour} />
            ))}
          </radialGradient>
        </defs>
      )}
      {/* When gradientCycle is on, don't inline a fill — the CSS animation on .shape__svg g
          handles it directly via anim-colour-cycle-svg-fill. */}
      <g
        stroke-width={String(sw)}
        stroke-linejoin="round"
        stroke-linecap="round"
        style={gradientCycle
          ? undefined
          : svgGradRef
          ? variant === 'outline'
            ? `fill: none; stroke: url(#${svgGradRef});`
            : `fill: url(#${svgGradRef}); ${(variant === 'glass' || variant === 'liquid-glass') ? `stroke: url(#${svgGradRef});` : ''}`
          : undefined}
      >
        <Fragment set:html={builtinSvg} />
      </g>
    </svg>
  )}

  {svgContent && !isMask && <Fragment set:html={(() => {
    let s = svgContent;
    // Add viewBox if missing (API shapes are 256x256), pad for stroke in draw mode.
    // API_VIEWBOX_BASE matches the Asset Library convention; built-ins use SHAPE_VIEWBOX_BASE (100).
    const API_VIEWBOX_BASE = 256;
    const API_DRAW_STROKE_PAD = 4;
    const svgPad = draw ? API_DRAW_STROKE_PAD : 0;
    if (!s.includes('viewBox')) {
      s = s.replace(/<svg/, `<svg viewBox="${-svgPad} ${-svgPad} ${API_VIEWBOX_BASE + svgPad * 2} ${API_VIEWBOX_BASE + svgPad * 2}"`);
    } else if (draw) {
      // Expand existing viewBox for stroke padding
      s = s.replace(/viewBox="(\d+)\s+(\d+)\s+(\d+)\s+(\d+)"/, (_, x, y, w, h) => {
        return `viewBox="${Number(x) - svgPad} ${Number(y) - svgPad} ${Number(w) + svgPad * 2} ${Number(h) + svgPad * 2}"`;
      });
    }
    // Remove fixed dimensions so SVG scales to container
    s = s.replace(/\s*width="\d+"/g, '');
    s = s.replace(/\s*height="\d+"/g, '');
    // Strip overflow, add visible for draw mode
    s = s.replace(/\s*overflow="[^"]*"/g, '');
    if (draw) s = s.replace(/<svg/, '<svg overflow="visible"');
    if (draw) {
      // Draw mode: convert fill to stroke for DrawSVG animation
      s = s.replace(/fill="rgb\([^"]*\)"/g, 'fill="none" stroke="currentColor" stroke-width="3"');
      s = s.replace(/fill="#[a-fA-F0-9]+"/g, 'fill="none" stroke="currentColor" stroke-width="3"');
      s = s.replace(/fill="currentColor"/g, 'fill="none" stroke="currentColor" stroke-width="3"');
      s = s.replace(/fill="none"(?=\s*>)/, 'fill="none"');
    } else if (svgGradRef) {
      // Gradient: replace fills with gradient URL reference (animated or static)
      const gradFill = `fill="url(#${svgGradRef})"`;
      s = s.replace(/fill="rgb\([^"]*\)"/g, gradFill);
      s = s.replace(/fill="#[a-fA-F0-9]+"/g, gradFill);
      s = s.replace(/fill="currentColor"/g, gradFill);
      // GSAP handles animated gradient via data-icon-grad-anim — no animateTransform needed
    } else {
      // Normal: replace hardcoded fills with currentColor
      s = s.replace(/fill="rgb\([^"]*\)"/g, 'fill="currentColor"');
      s = s.replace(/fill="#[a-fA-F0-9]+"/g, 'fill="currentColor"');
    }
    return s;
  })()} />}

  {svgContent && isMask && maskId && (
    <svg class="shape__mask-def" aria-hidden="true">
      <defs>
        <clipPath id={maskId} clipPathUnits="objectBoundingBox">
          <Fragment set:html={svgContent.replace(/<svg[^>]*>/, '').replace(/<\/svg>/, '').replace(/<rect[^/]*\/>/, '')} />
        </clipPath>
      </defs>
    </svg>
  )}

  {isContainer && (
    <div class="shape__content">
      {mediaComponent === 'Icon' && <Icon {...mediaProps as any} />}
      {mediaComponent === 'Image' && <Image {...mediaProps as any} />}
      {mediaComponent === 'LottieIcon' && <LottieIcon {...mediaProps as any} />}
      <slot />
    </div>
  )}
</div>
