---
/**
 * FormField - Reusable Form Input Atom
 *
 * Covers: text, email, textarea, checkbox, radio, toggle, search, select,
 *         number, tel, url, password
 * Includes label, optional description, error state, and focus ring.
 *
 * Token system: --_field-brand / --_field-brand-dark / --_field-brand-light / --_field-border
 * Colour variants: primary (default), secondary, neutral
 * Contrast variants: normal (default), high (darker borders, larger controls)
 * Style variants: outlined (default), filled, underlined
 *
 * Usage:
 * <FormField id="name" label="Your name" type="text" required />
 * <FormField id="email" label="Email" type="email" variant="secondary" />
 * <FormField id="msg" label="Message" type="textarea" fieldStyle="filled" />
 * <FormField id="terms" label="I agree" type="checkbox" />
 * <FormField id="opt1" label="Option A" type="radio" name="choice" radioValue="a" />
 * <FormField id="dark" label="Dark mode" type="toggle" />
 * <FormField id="q" type="search" placeholder="Search..." hideLabel label="Search" />
 * <FormField id="country" label="Country" type="select" options={[{value:'uk',label:'UK'}]} />
 */

interface SelectOption {
  value: string;
  label: string;
}

interface Props {
  id: string;
  name?: string;
  label: string;
  type?: 'text' | 'email' | 'textarea' | 'checkbox' | 'radio' | 'toggle' | 'search' | 'select' | 'number' | 'tel' | 'url' | 'password';
  variant?: 'primary' | 'secondary' | 'neutral';
  contrast?: 'normal' | 'high';
  fieldStyle?: 'outlined' | 'filled' | 'underlined' | 'glass' | 'neumorphic' | 'glow';
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  error?: string;
  description?: string;
  value?: string;
  checked?: boolean;
  rows?: number;
  min?: number;
  max?: number;
  step?: number;
  options?: SelectOption[];
  hideLabel?: boolean;
  radioValue?: string;
  class?: string;
}

const {
  id,
  name,
  label,
  type = 'text',
  variant = 'primary',
  contrast = 'normal',
  fieldStyle = 'outlined',
  placeholder,
  required = false,
  disabled = false,
  error,
  description,
  value,
  checked = false,
  rows = 3,
  min,
  max,
  step,
  options = [],
  hideLabel = false,
  radioValue,
  class: className,
} = Astro.props;

const isCheckbox = type === 'checkbox';
const isRadio = type === 'radio';
const isToggle = type === 'toggle';
const isTextarea = type === 'textarea';
const isSelect = type === 'select';
const fieldName = name || id;

const describedBy = [
  error && `${id}-error`,
  description && `${id}-desc`,
].filter(Boolean).join(' ') || undefined;

const groupClasses = [
  'text',       /* base typography from Text atom — sets font, color, line-height */
  'form-field',
  isCheckbox && 'form-field--checkbox',
  isRadio && 'form-field--radio',
  isToggle && 'form-field--toggle',
  error && 'form-field--error',
  disabled && 'form-field--disabled',
  variant !== 'primary' && `form-field--${variant}`,
  contrast === 'high' && 'form-field--high-contrast',
  fieldStyle !== 'outlined' && `form-field--${fieldStyle}`,
  className,
].filter(Boolean).join(' ');
---

<div class={groupClasses}>

  {isCheckbox ? (
    <!-- Checkbox: input + label inline -->
    <label class="form-field__checkbox-wrap" for={id}>
      <input
        type="checkbox"
        id={id}
        name={fieldName}
        checked={checked}
        required={required}
        disabled={disabled}
        class="form-field__checkbox"
        aria-describedby={describedBy}
        aria-invalid={error ? 'true' : undefined}
      />
      <span class="form-field__checkmark" aria-hidden="true"></span>
      <span class="form-field__label-text">{label}</span>
    </label>
  ) : isRadio ? (
    <!-- Radio: input + label inline -->
    <label class="form-field__radio-wrap" for={id}>
      <input
        type="radio"
        id={id}
        name={fieldName}
        value={radioValue || value}
        checked={checked}
        required={required}
        disabled={disabled}
        class="form-field__radio"
        aria-describedby={describedBy}
        aria-invalid={error ? 'true' : undefined}
      />
      <span class="form-field__radio-indicator" aria-hidden="true"></span>
      <span class="form-field__label-text">{label}</span>
    </label>
  ) : isToggle ? (
    <!-- Toggle: checkbox-backed switch -->
    <label class="form-field__toggle-wrap" for={id}>
      <input
        type="checkbox"
        id={id}
        name={fieldName}
        checked={checked}
        required={required}
        disabled={disabled}
        class="form-field__toggle"
        role="switch"
        aria-checked={checked ? 'true' : 'false'}
        aria-describedby={describedBy}
        aria-invalid={error ? 'true' : undefined}
      />
      <span class="form-field__toggle-track" aria-hidden="true">
        <span class="form-field__toggle-thumb"></span>
      </span>
      <span class="form-field__label-text">{label}</span>
    </label>
  ) : (
    <Fragment>
      <!-- Label -->
      <label
        for={id}
        class:list={['form-field__label', hideLabel && 'sr-only']}
      >
        {label}
        {required && <span class="form-field__required" aria-hidden="true">*</span>}
      </label>

      <!-- Description -->
      {description && (
        <span class="form-field__desc" id={`${id}-desc`}>{description}</span>
      )}

      <!-- Textarea -->
      {isTextarea && (
        <textarea
          id={id}
          name={fieldName}
          placeholder={placeholder}
          required={required}
          disabled={disabled}
          rows={rows}
          class="form-field__input form-field__input--textarea"
          aria-describedby={describedBy}
          aria-invalid={error ? 'true' : undefined}
        >{value}</textarea>
      )}

      <!-- Select — use Button component with shape="dropdown" instead -->
      {isSelect && (
        <select
          id={id}
          name={fieldName}
          required={required}
          disabled={disabled}
          class="form-field__input form-field__input--select"
          aria-describedby={describedBy}
          aria-invalid={error ? 'true' : undefined}
        >
          {placeholder && <option value="" disabled selected>{placeholder}</option>}
          {options.map((opt) => (
            <option value={opt.value} selected={value === opt.value}>{opt.label}</option>
          ))}
        </select>
      )}

      <!-- Standard input -->
      {!isTextarea && !isSelect && (
        <input
          type={type}
          id={id}
          name={fieldName}
          value={value}
          placeholder={placeholder}
          required={required}
          disabled={disabled}
          min={min}
          max={max}
          step={step}
          class="form-field__input"
          aria-describedby={describedBy}
          aria-invalid={error ? 'true' : undefined}
        />
      )}
    </Fragment>
  )}

  <!-- Error message -->
  {error && (
    <span class="form-field__error" id={`${id}-error`} role="alert">{error}</span>
  )}
</div>

<!-- Styles: FormField.css | FormField.responsive.css | FormField.a11y.css -->
