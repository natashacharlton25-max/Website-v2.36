{
  "component": "FormField",
  "category": "atoms/form",
  "renders": {
    "base": "FormField.astro"
  },
  "notes": "Extends .text class from Text atom for base typography defaults.",
  "reducedMotion": "Border-color and box-shadow transitions killed. Focus ring instant.",
  "props": {
    "id":          { "type": "string",  "required": true },
    "name":        { "type": "string",  "required": false },
    "label":       { "type": "string",  "required": true },
    "type":        { "type": "string",  "required": false, "default": "text", "enum": ["text", "email", "textarea", "checkbox", "radio", "toggle", "search", "select", "number", "tel", "url", "password"] },
    "variant":     { "type": "string",  "required": false, "default": "primary", "enum": ["primary", "secondary", "neutral"] },
    "contrast":    { "type": "string",  "required": false, "default": "normal", "enum": ["normal", "high"] },
    "fieldStyle":  { "type": "string",  "required": false, "default": "outlined", "enum": ["outlined", "filled", "underlined", "glass", "neumorphic", "glow"] },
    "placeholder": { "type": "string",  "required": false },
    "required":    { "type": "boolean", "required": false, "default": false },
    "disabled":    { "type": "boolean", "required": false, "default": false },
    "error":       { "type": "string",  "required": false },
    "description": { "type": "string",  "required": false },
    "value":       { "type": "string",  "required": false },
    "checked":     { "type": "boolean", "required": false, "default": false },
    "rows":        { "type": "number",  "required": false, "default": 3 },
    "min":         { "type": "number",  "required": false },
    "max":         { "type": "number",  "required": false },
    "step":        { "type": "number",  "required": false },
    "options":     { "type": "array",   "required": false, "default": [] },
    "hideLabel":   { "type": "boolean", "required": false, "default": false },
    "radioValue":  { "type": "string",  "required": false },
    "class":       { "type": "string",  "required": false, "default": "" }
  }
}
