---
/**
 * Button — Unified button component
 *
 * Handles: links, buttons, dropdowns, confetti effects.
 * Uses brand tokens for all colours. Icon component for icons.
 *
 * @param variant   - 'primary' (default), 'secondary', 'neutral', 'outline', 'ghost', 'glass', 'glow', 'neumorphic'
 * @param shape     - 'rounded' (default), 'pill', 'circle', 'square', 'sharp', 'dropdown'
 * @param size      - 'sm', 'md' (default), 'lg'
 * @param alignment - 'left', 'center' — wraps button in alignment container
 * @param icon      - Phosphor icon name e.g. 'star-fill'
 * @param iconPosition - 'left' (default) or 'right'
 * @param iconCollection - Icon folder (optional — auto-searches if omitted)
 * @param href      - Makes it an <a> tag
 * @param target    - Link target
 * @param download  - Download attribute
 * @param type      - Button type: 'button', 'submit', 'reset'
 * @param disabled  - Disabled state
 * @param id        - Element ID
 * @param ariaLabel - Accessible label
 * @param confetti  - Particle effect: 'confetti', 'hearts', 'celebration', 'mixed'
 * @param confettiTrigger - 'click' (default) or 'hover'
 * @param confettiCount   - Particle count (default 30)
 * @param confettiSpread  - Particle spread (default 150)
 * @param dropdownItems   - Array of {label, href?, value?, fontFamily?} for dropdown mode
 */
import { Icon } from '../Icon';
import { LottieIcon } from '../LottieIcon';
import { Text } from '../Text';

export interface DropdownItem {
  label: string;
  value?: string;
  href?: string;
  fontFamily?: string;
}

export interface Props {
  variant?: 'primary' | 'secondary' | 'neutral' | 'outline' | 'ghost' | 'glass' | 'liquid-glass' | 'glassic' | 'glow' | 'rainbow-glow' | 'neumorphic' | 'neumorphic-3d' | 'neumorphic-inner';
  shape?: 'rounded' | 'pill' | 'circle' | 'square' | 'sharp' | 'dropdown';
  size?: 'sm' | 'md' | 'lg';
  effect?: 'glint' | 'colour-flow' | 'jump' | 'comic' | 'tech' | 'expand' | 'magnetic' | 'spotlight' | 'split';
  speed?: 'slow' | 'normal' | 'fast';
  alignment?: 'left' | 'center';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  id?: string;
  href?: string;
  target?: string;
  download?: string | boolean;
  icon?: string;
  iconPosition?: 'left' | 'right';
  iconCollection?: string;
  iconMorphTo?: string;
  iconMorphColor?: string;
  iconDraw?: boolean | 'draw' | 'drawcenter' | 'chachaslide' | 'flashgordon' | 'rainbowchase' | 'pulse';
  iconDrawColor?: string;
  lottieIcon?: string;
  lottieLoop?: boolean;
  ariaLabel?: string;
  confetti?: 'confetti' | 'hearts' | 'celebration' | 'mixed';
  confettiTrigger?: 'click' | 'hover';
  confettiCount?: number;
  confettiSpread?: number;
  /** Text revealed after split effect opens — button sizes to longest */
  splitText?: string;
  /** Icon animation — forwarded to Icon atom */
  iconSpin?: boolean;
  iconBounce?: boolean;
  /** Rainbow glow custom colours — 2-7 token stops. Defaults to --rainbow-1 thru 7 */
  glowColors?: string[];
  dropdownItems?: DropdownItem[];
  class?: string;
  style?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  variant = 'primary',
  shape = 'rounded',
  size = 'md',
  effect,
  speed,
  alignment,
  type = 'button',
  disabled = false,
  id,
  href,
  target,
  download,
  icon,
  iconPosition = 'left',
  iconCollection,
  iconMorphTo,
  iconMorphColor,
  iconDraw,
  iconDrawColor,
  lottieIcon,
  lottieLoop = false,
  ariaLabel,
  confetti,
  confettiTrigger = 'click',
  confettiCount = 30,
  confettiSpread = 150,
  splitText,
  iconSpin,
  iconBounce,
  glowColors,
  dropdownItems = [],
  class: className = '',
  ...rest
} = Astro.props;

// Extract data-* attributes
const dataAttrs = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key.startsWith('data-'))
);

const isLink = !!href;
const isDropdown = shape === 'dropdown';
const hasIcon = !!icon || !!lottieIcon;
const isIconOnly = hasIcon && (shape === 'circle' || shape === 'square');

// Rainbow glow: build custom gradient from colors array
let glowGradientStyle = '';
if (glowColors && glowColors.length >= 2) {
  const stops = [...glowColors, glowColors[0]].join(', ');
  glowGradientStyle = `--_glow-gradient: linear-gradient(90deg, ${stops})`;
}

// Icon sizes per button size
// Semantic role for AT context
const semanticRole = type === 'submit' ? 'form-submit' : isIconOnly && ariaLabel ? 'control' : 'action';

// Icon size omitted — .btn__icon CSS (1.25em) scales with button font-size.
// Size variants handled by .btn--sm/.btn--lg font-size differences.
const iconSize = undefined;

// Build icon name — only prefix with collection if explicitly provided
const iconName = icon ? (iconCollection ? `${iconCollection}/${icon}` : icon) : '';

// Icon props — all forwarded to Icon atom. Icon owns its own gates.
const iconAnimProps = {
  ...(iconMorphTo ? { morphTo: iconMorphTo } : {}),
  ...(iconMorphColor ? { morphColor: iconMorphColor } : {}),
  ...(iconDraw ? { draw: iconDraw } : {}),
  ...(iconDrawColor ? { drawColor: iconDrawColor } : {}),
  ...(iconSpin ? { spin: iconSpin } : {}),
  ...(iconBounce ? { bounce: iconBounce } : {}),
};

// Build classes
const classes = [
  'btn',
  `btn--${variant}`,
  `btn--${shape}`,
  size !== 'md' && `btn--${size}`,
  effect && `btn--${effect}`,
  speed && `btn--speed-${speed}`,
  hasIcon && 'btn--has-icon',
  hasIcon && `btn--icon-${iconPosition}`,
  isIconOnly && 'btn--icon-only',
  confetti && 'btn--confetti',
  confetti === 'hearts' && 'btn--confetti-hearts',
  confetti === 'celebration' && 'btn--confetti-celebration',
  alignment && `btn-align--${alignment}`,
  className,
].filter(Boolean);

// Confetti data attributes
const confettiAttrs = confetti ? {
  'data-particle-burst': '',
  'data-particle-type': confetti === 'celebration' ? 'mixed' : confetti,
  'data-particle-trigger': confettiTrigger,
  'data-particle-count': String(confettiCount),
  'data-particle-spread': String(confettiSpread),
} : {};

// Lottie vs static icon
const useLottie = !!lottieIcon;

// Shared inner content
const iconLeft = iconPosition === 'left' && hasIcon;
const iconRight = iconPosition === 'right' && hasIcon;

---

{isDropdown ? (
  <div class="dropdown-wrapper">
    <button
      class:list={[...classes, 'btn--dropdown', 'dropdown-btn']}
      type={type}
      disabled={disabled}
      id={id}
      aria-label={ariaLabel}
      aria-expanded="false"
      aria-haspopup="true"
      data-semantic-role={semanticRole}
      {...dataAttrs}
      {...confettiAttrs}
    >
      {iconLeft && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
      <Text as="span" class="btn__label" flush><slot /></Text>
      {iconRight && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
      <Icon name="caret-down-fill" size={14} class="btn__chevron" />
    </button>

    <div
      class={`dropdown-menu dropdown-theme--${variant}`}
      role="menu"
    >
      {dropdownItems.map((item) => (
        item.href ? (
          <a href={item.href} class="dropdown-item" role="menuitem">{item.label}</a>
        ) : (
          <button
            type="button"
            class="dropdown-item"
            data-value={item.value}
            role="menuitem"
            style={item.fontFamily ? `font-family: ${item.fontFamily};` : undefined}
          >{item.label}</button>
        )
      ))}
    </div>
  </div>
) : isLink ? (
  variant === 'rainbow-glow' ? (
    <div class="btn-rainbow-glow-wrap" style={glowGradientStyle || undefined}>
      <a
        href={href}
        target={target}
        download={download}
        class:list={classes}
        id={id}
        aria-disabled={disabled}
        aria-label={ariaLabel}
        data-semantic-role={semanticRole}
        {...dataAttrs}
        {...confettiAttrs}
      >
        {iconLeft && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
        <Text as="span" class="btn__label" flush><slot /></Text>
        {iconRight && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
      </a>
    </div>
  ) : (
    <a
      href={href}
      target={target}
      download={download}
      class:list={classes}
      id={id}
      aria-disabled={disabled}
      aria-label={ariaLabel}
      data-semantic-role={semanticRole}
      {...dataAttrs}
      {...confettiAttrs}
    >
      {iconLeft && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
      <Text as="span" class="btn__label" flush><slot /></Text>
      {iconRight && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
    </a>
  )
) : variant === 'rainbow-glow' ? (
  <div class="btn-rainbow-glow-wrap" style={glowGradientStyle || undefined}>
    <button
      class:list={classes}
      type={type}
      disabled={disabled}
      id={id}
      aria-label={ariaLabel}
      data-semantic-role={semanticRole}
      {...dataAttrs}
      {...confettiAttrs}
    >
      {iconLeft && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
      <Text as="span" class="btn__label" flush><slot /></Text>
      {iconRight && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
    </button>
  </div>
) : (
  <button
    class:list={classes}
    type={type}
    disabled={disabled}
    id={id}
    aria-label={ariaLabel}
    data-semantic-role={semanticRole}
    {...dataAttrs}
    {...confettiAttrs}
  >
    {iconLeft && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
    <Text as="span" class="btn__label" flush><slot /></Text>
    {iconRight && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
  </button>
)}

<script>
  // Dropdown toggle
  function initDropdowns() {
    const wrappers = document.querySelectorAll('.dropdown-wrapper');

    wrappers.forEach((wrapper) => {
      if ((wrapper as HTMLElement).dataset.dropdownInit) return;
      (wrapper as HTMLElement).dataset.dropdownInit = '1';

      const btn = wrapper.querySelector('.dropdown-btn') as HTMLButtonElement;
      const menu = wrapper.querySelector('.dropdown-menu');
      if (!btn || !menu) return;

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = wrapper.classList.contains('open');

        // Close all others
        document.querySelectorAll('.dropdown-wrapper.open').forEach(w => {
          w.classList.remove('open');
          w.querySelector('.dropdown-menu')?.classList.remove('show');
          w.querySelector('.dropdown-btn')?.setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          wrapper.classList.add('open');
          menu.classList.add('show');
          btn.setAttribute('aria-expanded', 'true');
        }
      });

      // Keyboard: Escape closes
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && wrapper.classList.contains('open')) {
          wrapper.classList.remove('open');
          menu.classList.remove('show');
          btn.setAttribute('aria-expanded', 'false');
          btn.focus();
        }
      });
    });

    // Close on outside click (only attach once)
    if (!(window as any).__dropdownOutsideClick) {
      (window as any).__dropdownOutsideClick = true;
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('.dropdown-wrapper')) {
          document.querySelectorAll('.dropdown-wrapper.open').forEach(w => {
            w.classList.remove('open');
            w.querySelector('.dropdown-menu')?.classList.remove('show');
            w.querySelector('.dropdown-btn')?.setAttribute('aria-expanded', 'false');
          });
        }
      });
    }
  }

  // Run immediately (module scripts are deferred — DOM is ready)
  initDropdowns();
  // Also support ClientRouter navigations
  document.addEventListener('astro:page-load', initDropdowns);
</script>

<script>
  // Focus gate: set data-focus-active ONLY on keyboard focus (not mouse click).
  // Track if last interaction was keyboard via keydown before focus.
  function initFocusHoverGate() {
    let lastKeyTime = 0;

    document.addEventListener('keydown', () => {
      lastKeyTime = Date.now();
    });

    // Focus label element (created once, reused)
    let focusLabel: HTMLElement | null = null;

    function getFocusLabel(): HTMLElement {
      if (!focusLabel) {
        focusLabel = document.createElement('div');
        focusLabel.className = 'focus-label';
        focusLabel.setAttribute('aria-hidden', 'true');
        document.body.appendChild(focusLabel);
      }
      return focusLabel;
    }

    function getElementLabel(el: Element): string {
      const tag = el.tagName.toLowerCase();
      const role = el.getAttribute('role') || '';
      const label = el.getAttribute('aria-label') || '';
      const text = (el.textContent || '').trim().slice(0, 30);

      if (label) return label;
      if (tag === 'a') return text || 'Link';
      if (tag === 'button' || role === 'button') return text || 'Button';
      if (tag === 'input') return (el as HTMLInputElement).type || 'Input';
      if (tag === 'figure') return 'Image';
      return text || tag;
    }

    function showFocusLabel(el: Element) {
      const label = getFocusLabel();
      label.textContent = getElementLabel(el);
      label.style.display = 'block';

      const rect = el.getBoundingClientRect();
      label.style.top = `${rect.top + window.scrollY - 28}px`;
      label.style.left = `${rect.left + window.scrollX}px`;
    }

    function hideFocusLabel() {
      if (focusLabel) focusLabel.style.display = 'none';
    }

    document.addEventListener('focusin', (e) => {
      // Only activate if focus came from keyboard (within 100ms of a keypress)
      if (Date.now() - lastKeyTime > 100) return;
      const el = (e.target as HTMLElement).closest('[tabindex], button, a, [role="button"]');
      // Don't activate focus system on a11y panel/page controls
      if (el && !el.closest('#a11y-page, #a11y-panel, .a11y-panel')) {
        el.setAttribute('data-focus-active', '');
        el.classList.add('focus-entering');
        // Rainbow: cycle through colours on each tab
        if (document.documentElement.hasAttribute('data-focus-rainbow')) {
          if (!initFocusHoverGate._rainbowIndex) initFocusHoverGate._rainbowIndex = 0;
          initFocusHoverGate._rainbowIndex = (initFocusHoverGate._rainbowIndex + 1) % 7;
          const angle = initFocusHoverGate._rainbowIndex * (360 / 7);
          (el as HTMLElement).style.setProperty('--focus-angle', `${angle}deg`);

          // Set focus-color to current rainbow, highlight to complementary
          const rainbowTokens = ['--rainbow-1', '--rainbow-2', '--rainbow-3', '--rainbow-4', '--rainbow-5', '--rainbow-6', '--rainbow-7'];
          const idx = initFocusHoverGate._rainbowIndex;
          const complementIdx = (idx + 3) % 7; // opposite side of the rainbow
          const styles = getComputedStyle(document.documentElement);
          const currentColor = styles.getPropertyValue(rainbowTokens[idx]).trim();
          const complementColor = styles.getPropertyValue(rainbowTokens[complementIdx]).trim();
          if (currentColor) {
            document.documentElement.style.setProperty('--focus-color', currentColor);
          }
          if (complementColor) {
            document.documentElement.style.setProperty('--highlight-link-color', complementColor);
          }
          // GSAP tween the dim overlay colour
          if (document.documentElement.hasAttribute('data-focus-dim') && currentColor) {
            const gsap = (window as any).gsap;
            let overlay = document.querySelector('.focus-dim-overlay') as HTMLElement;
            if (!overlay) {
              overlay = document.createElement('div');
              overlay.className = 'focus-dim-overlay';
              overlay.setAttribute('aria-hidden', 'true');
              document.body.appendChild(overlay);
            }
            const probe = document.createElement('div');
            probe.style.backgroundColor = currentColor;
            document.body.appendChild(probe);
            const rgb = getComputedStyle(probe).backgroundColor;
            probe.remove();
            const match = rgb.match(/(\d+),\s*(\d+),\s*(\d+)/);
            if (gsap && match) {
              gsap.to(overlay, {
                backgroundColor: `rgba(${match[1]}, ${match[2]}, ${match[3]}, 0.35)`,
                duration: 0.3,
                ease: 'power2.out',
              });
            }
          }
        }
        el.addEventListener('animationend', () => {
          el.classList.remove('focus-entering');
        }, { once: true });
        if (document.documentElement.hasAttribute('data-focus-scroll')) {
          const osViewport = document.querySelector('[data-overlayscrollbars-viewport]');
          const scroller = osViewport || document.documentElement;
          const rect = el.getBoundingClientRect();
          const scrollerRect = scroller.getBoundingClientRect();
          const targetY = scroller.scrollTop + rect.top - scrollerRect.top - (scrollerRect.height / 2) + (rect.height / 2);

          const gsap = (window as any).gsap;
          if (gsap) {
            gsap.to(scroller, {
              scrollTop: targetY,
              duration: 0.35,
              ease: 'power3.out',
            });
          } else {
            scroller.scrollTo({ top: targetY, behavior: 'smooth' });
          }
        }
        if (document.documentElement.hasAttribute('data-focus-label')) {
          showFocusLabel(el);
        }
        // Focus colour journey: three synchronised tweens
        if (document.documentElement.hasAttribute('data-focus-color-journey')) {
        const section = el.closest('[data-scroll-bg]');
        if (section) {
          const rawBg = (section as HTMLElement).dataset.scrollBg || '';
          // Resolve var(--token) to computed hex
          const probe = document.createElement('div');
          probe.style.color = rawBg;
          document.body.appendChild(probe);
          const resolved = getComputedStyle(probe).color;
          probe.remove();

          const gsap = (window as any).gsap;
          if (gsap && resolved) {
            // 1. Page background morphs to section colour
            const wrapper = document.getElementById('a11y-content-wrapper');
            if (wrapper) {
              gsap.to(wrapper, {
                backgroundColor: resolved,
                duration: 0.6,
                ease: 'power2.out',
              });
            }

            // 2. Focus ring adapts to section colour
            gsap.to(document.documentElement, {
              '--focus-color': resolved,
              duration: 0.4,
              ease: 'power2.out',
            });

            // 3. Glow adapts
            gsap.to(document.documentElement, {
              '--glow-spread': `0 0 30px ${resolved}, 0 0 60px ${resolved}`,
              duration: 0.5,
              ease: 'power2.out',
            });
          }
        }
        }
      }
    });

    document.addEventListener('focusout', (e) => {
      const el = (e.target as HTMLElement).closest('[data-focus-active]') as HTMLElement | null;
      if (el) {
        // Always instant out
        el.style.transition = 'none';
        el.classList.remove('focus-entering');
        el.removeAttribute('data-focus-active');
        requestAnimationFrame(() => { el.style.transition = ''; });
      }
      // Fade out dim overlay
      const gsap = (window as any).gsap;
      const overlay = document.querySelector('.focus-dim-overlay');
      if (gsap && overlay) {
        gsap.to(overlay, {
          backgroundColor: 'rgba(0, 0, 0, 0)',
          duration: 0.2,
          ease: 'power2.out',
        });
      }
      hideFocusLabel();
    });
  }
  initFocusHoverGate();
  document.addEventListener('astro:page-load', initFocusHoverGate);
</script>

<script>
  // Import triggers auto-init in particle-burst.ts
  import '../../../lib/animation/particle-burst';
</script>

<script>
  // Magnetic + Spotlight — cursor-tracking effects
  function initCursorEffects() {
    // Magnetic: shift button toward cursor
    document.querySelectorAll<HTMLElement>('.btn--magnetic:not([data-mag-bound])').forEach(el => {
      el.setAttribute('data-mag-bound', '1');
      const strength = 8; // max px shift

      el.addEventListener('mousemove', (e) => {
        // Gate: no movement in highlight-links or hover-none mode
        if (document.documentElement.hasAttribute('data-highlight-links') ||
            document.documentElement.hasAttribute('data-highlight') ||
            document.body.dataset.hover === 'none') return;

        const rect = el.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const dx = ((e.clientX - cx) / (rect.width / 2)) * strength;
        const dy = ((e.clientY - cy) / (rect.height / 2)) * strength;
        el.style.transform = `translate(${dx}px, ${dy}px)`;
      });

      el.addEventListener('mouseleave', () => {
        el.style.transform = '';
      });
    });

    // Spotlight: radial gradient follows cursor
    document.querySelectorAll<HTMLElement>('.btn--spotlight:not([data-spot-bound])').forEach(el => {
      el.setAttribute('data-spot-bound', '1');

      el.addEventListener('mousemove', (e) => {
        // Gate: no spotlight in highlight-links or hover-none mode
        if (document.documentElement.hasAttribute('data-highlight-links') ||
            document.documentElement.hasAttribute('data-highlight') ||
            document.body.dataset.hover === 'none') return;

        const rect = el.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        el.style.setProperty('--_spot-x', `${x}px`);
        el.style.setProperty('--_spot-y', `${y}px`);
      });

      el.addEventListener('mouseleave', () => {
        el.style.removeProperty('--_spot-x');
        el.style.removeProperty('--_spot-y');
      });
    });
  }

  initCursorEffects();
  document.addEventListener('astro:page-load', initCursorEffects);
</script>

<script>
  // Lottie icons inside buttons — play on hover/focus, reverse on leave/blur
  function initButtonLottie() {
    document.querySelectorAll<HTMLElement>('.btn [data-lottie-icon]:not([data-btn-lottie-bound])').forEach(el => {
      el.setAttribute('data-btn-lottie-bound', '1');
      const trigger = el.closest('button, a') || el;

      trigger.addEventListener('mouseenter', () => {
        el.dispatchEvent(new CustomEvent('lottie:play'));
      });
      trigger.addEventListener('mouseleave', () => {
        el.dispatchEvent(new CustomEvent('lottie:playReverse'));
      });
      trigger.addEventListener('focusin', () => {
        el.dispatchEvent(new CustomEvent('lottie:play'));
      });
      trigger.addEventListener('focusout', () => {
        el.dispatchEvent(new CustomEvent('lottie:playReverse'));
      });
    });
  }

  initButtonLottie();
  document.addEventListener('astro:page-load', initButtonLottie);
</script>
