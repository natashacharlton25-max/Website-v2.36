---
/**
 * Button — Unified button component
 *
 * Handles: links, buttons, dropdowns, confetti effects.
 * Uses brand tokens for all colours. Icon component for icons.
 *
 * @param variant   - 'primary' (default), 'secondary', 'neutral', 'outline', 'ghost', 'glass', 'glow', 'neumorphic'
 * @param shape     - 'rounded' (default), 'pill', 'circle', 'square', 'sharp', 'dropdown'
 * @param size      - 'sm', 'md' (default), 'lg'
 * @param alignment - 'left', 'center' — wraps button in alignment container
 * @param icon      - Phosphor icon name e.g. 'star-fill'
 * @param iconPosition - 'left' (default) or 'right'
 * @param iconCollection - Icon folder (optional — auto-searches if omitted)
 * @param href      - Makes it an <a> tag
 * @param target    - Link target
 * @param download  - Download attribute
 * @param type      - Button type: 'button', 'submit', 'reset'
 * @param disabled  - Disabled state
 * @param id        - Element ID
 * @param ariaLabel - Accessible label
 * @param confetti  - Particle effect: 'confetti', 'hearts', 'celebration', 'mixed'
 * @param confettiTrigger - 'click' (default) or 'hover'
 * @param confettiCount   - Particle count (default 30)
 * @param confettiSpread  - Particle spread (default 150)
 * @param dropdownItems   - Array of {label, href?, value?, fontFamily?} for dropdown mode
 */
import { Icon } from '../Icon';
import { LottieIcon } from '../LottieIcon';
import { Text } from '../Text';

export interface DropdownItem {
  label: string;
  value?: string;
  href?: string;
  fontFamily?: string;
}

export interface Props {
  variant?: 'primary' | 'secondary' | 'neutral' | 'outline' | 'ghost' | 'glass' | 'liquid-glass' | 'glassic' | 'glow' | 'rainbow-glow' | 'neumorphic' | 'neumorphic-3d' | 'neumorphic-inner';
  shape?: 'rounded' | 'pill' | 'circle' | 'square' | 'sharp' | 'dropdown';
  size?: 'sm' | 'md' | 'lg';
  effect?: 'glint' | 'colour-flow' | 'jump' | 'comic' | 'tech' | 'expand' | 'underline' | 'magnetic' | 'spotlight' | 'split';
  speed?: 'slow' | 'normal' | 'fast';
  alignment?: 'left' | 'center';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  id?: string;
  href?: string;
  target?: string;
  download?: string | boolean;
  icon?: string;
  iconPosition?: 'left' | 'right';
  iconCollection?: string;
  iconMorphTo?: string;
  iconMorphColor?: string;
  iconDraw?: boolean | 'draw' | 'drawcenter' | 'chachaslide' | 'flashgordon' | 'rainbowchase' | 'pulse';
  iconDrawColor?: string;
  lottieIcon?: string;
  lottieLoop?: boolean;
  ariaLabel?: string;
  confetti?: 'confetti' | 'hearts' | 'celebration' | 'mixed';
  confettiTrigger?: 'click' | 'hover';
  confettiCount?: number;
  confettiSpread?: number;
  dropdownItems?: DropdownItem[];
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  variant = 'primary',
  shape = 'rounded',
  size = 'md',
  effect,
  speed,
  alignment,
  type = 'button',
  disabled = false,
  id,
  href,
  target,
  download,
  icon,
  iconPosition = 'left',
  iconCollection,
  iconMorphTo,
  iconMorphColor,
  iconDraw,
  iconDrawColor,
  lottieIcon,
  lottieLoop = false,
  ariaLabel,
  confetti,
  confettiTrigger = 'click',
  confettiCount = 30,
  confettiSpread = 150,
  dropdownItems = [],
  class: className = '',
  ...rest
} = Astro.props;

// Extract data-* attributes
const dataAttrs = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key.startsWith('data-'))
);

const isLink = !!href;
const isDropdown = shape === 'dropdown';
const hasIcon = !!icon || !!lottieIcon;
const isIconOnly = hasIcon && (shape === 'circle' || shape === 'square');

// Icon sizes per button size
// Semantic role for AT context
const semanticRole = type === 'submit' ? 'form-submit' : isIconOnly && ariaLabel ? 'control' : 'action';

const iconSizes: Record<string, number> = { sm: 18, md: 22, lg: 26 };
const iconSize = iconSizes[size] || 18;

// Build icon name — only prefix with collection if explicitly provided
const iconName = icon ? (iconCollection ? `${iconCollection}/${icon}` : icon) : '';

// Icon animation props — passed through to Icon component
const iconAnimProps = {
  ...(iconMorphTo ? { morphTo: iconMorphTo } : {}),
  ...(iconMorphColor ? { morphColor: iconMorphColor } : {}),
  ...(iconDraw ? { draw: iconDraw } : {}),
  ...(iconDrawColor ? { drawColor: iconDrawColor } : {}),
};

// Build classes
const classes = [
  'btn',
  `btn--${variant}`,
  `btn--${shape}`,
  size !== 'md' && `btn--${size}`,
  effect && `btn--${effect}`,
  speed && `btn--speed-${speed}`,
  hasIcon && `btn--icon-${iconPosition}`,
  isIconOnly && 'btn--icon-only',
  confetti && 'btn--confetti',
  confetti === 'hearts' && 'btn--confetti-hearts',
  confetti === 'celebration' && 'btn--confetti-celebration',
  alignment && `btn-align--${alignment}`,
  className,
].filter(Boolean);

// Confetti data attributes
const confettiAttrs = confetti ? {
  'data-particle-burst': '',
  'data-particle-type': confetti === 'celebration' ? 'mixed' : confetti,
  'data-particle-trigger': confettiTrigger,
  'data-particle-count': String(confettiCount),
  'data-particle-spread': String(confettiSpread),
} : {};

// Lottie vs static icon
const useLottie = !!lottieIcon;

// Shared inner content
const iconLeft = iconPosition === 'left' && hasIcon;
const iconRight = iconPosition === 'right' && hasIcon;

---

{isDropdown ? (
  <div class="dropdown-wrapper">
    <button
      class:list={[...classes, 'btn--dropdown', 'dropdown-btn']}
      type={type}
      disabled={disabled}
      id={id}
      aria-label={ariaLabel}
      aria-expanded="false"
      aria-haspopup="true"
      data-semantic-role={semanticRole}
      {...dataAttrs}
      {...confettiAttrs}
    >
      {iconLeft && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
      <Text as="span" class="btn__label" flush><slot /></Text>
      {iconRight && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
      <Icon name="caret-down-fill" size={14} class="btn__chevron" />
    </button>

    <div
      class={`dropdown-menu dropdown-theme--${variant}`}
      role="menu"
    >
      {dropdownItems.map((item) => (
        item.href ? (
          <a href={item.href} class="dropdown-item" role="menuitem">{item.label}</a>
        ) : (
          <button
            type="button"
            class="dropdown-item"
            data-value={item.value}
            role="menuitem"
            style={item.fontFamily ? `font-family: ${item.fontFamily};` : undefined}
          >{item.label}</button>
        )
      ))}
    </div>
  </div>
) : isLink ? (
  variant === 'rainbow-glow' ? (
    <div class="btn-rainbow-glow-wrap">
      <a
        href={href}
        target={target}
        download={download}
        class:list={classes}
        id={id}
        aria-disabled={disabled}
        aria-label={ariaLabel}
        data-semantic-role={semanticRole}
        {...dataAttrs}
        {...confettiAttrs}
      >
        {iconLeft && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
        <Text as="span" class="btn__label" flush><slot /></Text>
        {iconRight && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
      </a>
    </div>
  ) : (
    <a
      href={href}
      target={target}
      download={download}
      class:list={classes}
      id={id}
      aria-disabled={disabled}
      aria-label={ariaLabel}
      data-semantic-role={semanticRole}
      {...dataAttrs}
      {...confettiAttrs}
    >
      {iconLeft && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
      <Text as="span" class="btn__label" flush><slot /></Text>
      {iconRight && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
    </a>
  )
) : variant === 'rainbow-glow' ? (
  <div class="btn-rainbow-glow-wrap">
    <button
      class:list={classes}
      type={type}
      disabled={disabled}
      id={id}
      aria-label={ariaLabel}
      data-semantic-role={semanticRole}
      {...dataAttrs}
      {...confettiAttrs}
    >
      {iconLeft && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
      <Text as="span" class="btn__label" flush><slot /></Text>
      {iconRight && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
    </button>
  </div>
) : (
  <button
    class:list={classes}
    type={type}
    disabled={disabled}
    id={id}
    aria-label={ariaLabel}
    data-semantic-role={semanticRole}
    {...dataAttrs}
    {...confettiAttrs}
  >
    {iconLeft && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
    <Text as="span" class="btn__label" flush><slot /></Text>
    {iconRight && (useLottie ? <LottieIcon slug={lottieIcon!} size={iconSize} class="btn__icon" loop={lottieLoop} /> : <Icon name={iconName} size={iconSize} class="btn__icon" {...iconAnimProps} />)}
  </button>
)}

<script>
  // Dropdown toggle
  function initDropdowns() {
    const wrappers = document.querySelectorAll('.dropdown-wrapper');

    wrappers.forEach((wrapper) => {
      if ((wrapper as HTMLElement).dataset.dropdownInit) return;
      (wrapper as HTMLElement).dataset.dropdownInit = '1';

      const btn = wrapper.querySelector('.dropdown-btn') as HTMLButtonElement;
      const menu = wrapper.querySelector('.dropdown-menu');
      if (!btn || !menu) return;

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = wrapper.classList.contains('open');

        // Close all others
        document.querySelectorAll('.dropdown-wrapper.open').forEach(w => {
          w.classList.remove('open');
          w.querySelector('.dropdown-menu')?.classList.remove('show');
          w.querySelector('.dropdown-btn')?.setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          wrapper.classList.add('open');
          menu.classList.add('show');
          btn.setAttribute('aria-expanded', 'true');
        }
      });

      // Keyboard: Escape closes
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && wrapper.classList.contains('open')) {
          wrapper.classList.remove('open');
          menu.classList.remove('show');
          btn.setAttribute('aria-expanded', 'false');
          btn.focus();
        }
      });
    });

    // Close on outside click (only attach once)
    if (!(window as any).__dropdownOutsideClick) {
      (window as any).__dropdownOutsideClick = true;
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('.dropdown-wrapper')) {
          document.querySelectorAll('.dropdown-wrapper.open').forEach(w => {
            w.classList.remove('open');
            w.querySelector('.dropdown-menu')?.classList.remove('show');
            w.querySelector('.dropdown-btn')?.setAttribute('aria-expanded', 'false');
          });
        }
      });
    }
  }

  // Run immediately (module scripts are deferred — DOM is ready)
  initDropdowns();
  // Also support ClientRouter navigations
  document.addEventListener('astro:page-load', initDropdowns);
</script>

<script>
  // Confetti — direct binding
  async function initConfetti() {
    const els = document.querySelectorAll<HTMLElement>('[data-particle-burst]:not([data-confetti-bound])');
    if (els.length === 0) return;

    const { createParticleBurst } = await import('../../../lib/animation/particle-burst');

    els.forEach(el => {
      el.setAttribute('data-confetti-bound', 'true');

      const type = (el.getAttribute('data-particle-type') || 'confetti') as any;
      const trigger = el.getAttribute('data-particle-trigger') || 'click';
      const count = parseInt(el.getAttribute('data-particle-count') || '30');
      const spread = parseInt(el.getAttribute('data-particle-spread') || '150');
      const opts = { type, particleCount: count, spread };

      if (trigger === 'hover') {
        let cooldown = false;
        el.addEventListener('mouseenter', () => {
          if (cooldown) return;
          createParticleBurst(el, opts);
          cooldown = true;
          setTimeout(() => { cooldown = false; }, 2000);
        });
      } else {
        el.addEventListener('click', () => {
          createParticleBurst(el, opts);
        });
      }
    });
  }

  initConfetti();
  document.addEventListener('astro:page-load', initConfetti);
</script>

<script>
  // Magnetic + Spotlight — cursor-tracking effects
  function initCursorEffects() {
    // Magnetic: shift button toward cursor
    document.querySelectorAll<HTMLElement>('.btn--magnetic:not([data-mag-bound])').forEach(el => {
      el.setAttribute('data-mag-bound', '1');
      const strength = 8; // max px shift

      el.addEventListener('mousemove', (e) => {
        const rect = el.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const dx = ((e.clientX - cx) / (rect.width / 2)) * strength;
        const dy = ((e.clientY - cy) / (rect.height / 2)) * strength;
        el.style.transform = `translate(${dx}px, ${dy}px)`;
      });

      el.addEventListener('mouseleave', () => {
        el.style.transform = '';
      });
    });

    // Spotlight: radial gradient follows cursor
    document.querySelectorAll<HTMLElement>('.btn--spotlight:not([data-spot-bound])').forEach(el => {
      el.setAttribute('data-spot-bound', '1');

      el.addEventListener('mousemove', (e) => {
        const rect = el.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        el.style.setProperty('--_spot-x', `${x}px`);
        el.style.setProperty('--_spot-y', `${y}px`);
      });

      el.addEventListener('mouseleave', () => {
        el.style.removeProperty('--_spot-x');
        el.style.removeProperty('--_spot-y');
      });
    });
  }

  initCursorEffects();
  document.addEventListener('astro:page-load', initCursorEffects);
</script>

<script>
  // Lottie icons inside buttons — play on hover/focus, reverse on leave/blur
  function initButtonLottie() {
    document.querySelectorAll<HTMLElement>('.btn [data-lottie-icon]:not([data-btn-lottie-bound])').forEach(el => {
      el.setAttribute('data-btn-lottie-bound', '1');
      const trigger = el.closest('button, a') || el;

      trigger.addEventListener('mouseenter', () => {
        el.dispatchEvent(new CustomEvent('lottie:play'));
      });
      trigger.addEventListener('mouseleave', () => {
        el.dispatchEvent(new CustomEvent('lottie:playReverse'));
      });
      trigger.addEventListener('focusin', () => {
        el.dispatchEvent(new CustomEvent('lottie:play'));
      });
      trigger.addEventListener('focusout', () => {
        el.dispatchEvent(new CustomEvent('lottie:playReverse'));
      });
    });
  }

  initButtonLottie();
  document.addEventListener('astro:page-load', initButtonLottie);
</script>
