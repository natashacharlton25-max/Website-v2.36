---
/**
 * Button — Unified button component (links, buttons, dropdowns).
 *
 * Colour: global .color--{name} mixin via brandColor / rainbowColor.
 * Tiers NOT supported — preset variant styling (fill/outline/glass/glow/etc.)
 * would break at non-base tiers.
 *
 * Decorative icon (Icon | LottieIcon) lives on the `media` nested atom node —
 * matches Heading/Badge/List family pattern. Heavy SVG features (morph/draw/
 * fillAnimation) are NOT exposed for button chrome (see schema._rules).
 *
 * Confetti is no longer a Button prop — wrap with the Confetti atom.
 */
import { Icon } from '../Icon';
import { LottieIcon } from '../LottieIcon';
import { Text } from '../Text';
import type { BrandColour, RainbowColour, GradientBlend, GradientDirection, GradientAnimateDirection } from '../../../lib/shared-enums';
import { FORBIDDEN_COMBOS } from './forbidden-combos';

export interface DropdownItem {
  label: string;
  value?: string;
  href?: string;
  fontFamily?: string;
}

export interface Props {
  /** Button label text. Forwarded to nested Text atom. Pipeline content key. */
  contentButton?: string;
  variant?: 'fill' | 'outline' | 'ghost' | 'glass' | 'liquid-glass' | 'glassic' | 'glow' | 'rainbow-glow' | 'neumorphic' | 'neumorphic-3d' | 'neumorphic-inner';
  brandColor?: BrandColour;
  rainbowColor?: RainbowColour;
  shape?: 'sharp' | 'subtle' | 'soft' | 'rounded' | 'pill' | 'square' | 'circle' | 'dropdown' | 'i-sharp' | 'i-subtle' | 'i-soft' | 'i-rounded';
  size?: 'sm' | 'md' | 'lg';
  effect?: 'glint' | 'colour-flow' | 'jump' | 'tech' | 'magnetic' | 'spotlight' | 'split' | 'expand';
  speed?: 'slow' | 'normal' | 'fast';
  alignment?: 'left' | 'center';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  id?: string;
  href?: string;
  target?: string;
  download?: string | boolean;
  /** Decorative chrome — Icon | LottieIcon nested atom node. Mirrors Heading/Badge/List media pattern. */
  media?: Record<string, any>;
  /** Layout — icon left or right of label. Applies to whichever media is nested. */
  iconPosition?: 'left' | 'right';
  ariaLabel?: string;
  /** Gradient fill / glow — matches Shape/Icon/Heading/Badge gradient spec. */
  gradient?: boolean;
  gradientBlend?: GradientBlend;
  gradientDirection?: GradientDirection;
  gradientEmerge?: boolean;
  gradientFade?: boolean;
  gradientAnimated?: boolean;
  gradientAnimateDirection?: GradientAnimateDirection;
  gradientAnimateSpeed?: 'slow' | 'default' | 'fast';
  gradientCycle?: boolean;
  dropdownItems?: DropdownItem[];
  class?: string;
  style?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  contentButton,
  variant: rawVariant = 'fill',
  brandColor: rawColor = 'primary',
  rainbowColor,
  shape = 'rounded',
  size = 'md',
  effect,
  speed,
  alignment,
  type = 'button',
  disabled = false,
  id,
  href,
  target,
  download,
  media,
  iconPosition = 'left',
  ariaLabel,
  gradient = false,
  gradientBlend,
  gradientDirection = 'diagonal',
  gradientEmerge = false,
  gradientFade = false,
  gradientAnimated = false,
  gradientAnimateDirection,
  gradientAnimateSpeed,
  gradientCycle = false,
  dropdownItems = [],
  class: className = '',
  ...rest
} = Astro.props;

// Migrate legacy variant="primary|secondary|neutral" → variant="fill" + color
const colorVariants = ['primary', 'secondary', 'neutral'] as const;
const isLegacyVariant = colorVariants.includes(rawVariant as any);
const variant = isLegacyVariant ? 'fill' : rawVariant;
// rainbowColor wins over brandColor when both set (matches Heading/Badge convention)
const color = isLegacyVariant ? rawVariant : (rainbowColor || rawColor);

// Rule: forbidden-variant-effect-combos — these combinations conflict
// visually because the effect owns chrome that fights the variant's
// styling (e.g. expand's transparent bg + circle ::before vs glassic's
// 3D layers). Strip the effect, keep the variant.
// Mirrors validator + schema._rules. Three layers: schema documents,
// validator warns, atom enforces.
const _effectForbidden = !!effect && FORBIDDEN_COMBOS[variant]?.includes(effect);
if (_effectForbidden && import.meta.env.DEV) {
  console.warn(`[Button] effect="${effect}" not supported with variant="${variant}". Effect stripped.`);
}
const _effect = _effectForbidden ? undefined : effect;

// Gradient resolution — same pattern as Heading/Badge. No tier preset
// suffix because Button doesn't accept colorTier (see _rules.no-tiers-on-button).
const _emergePrefix = gradientEmerge ? 'emerge-' : gradientFade ? 'fade-' : '';
const gradientName = gradientBlend
  || (gradient && color ? `${_emergePrefix}${color}` : null)
  || (gradient ? `${_emergePrefix}primary` : null);

// Extract data-* attributes
const dataAttrs: Record<string, string | undefined> = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key.startsWith('data-'))
);
// Gradient direction data-attrs (matches Heading/Badge/Shape pattern)
if (gradientName && gradientDirection) dataAttrs['data-grad-dir'] = gradientDirection;
if (gradientAnimated && gradientAnimateDirection && gradientAnimateDirection !== 'cw') {
  dataAttrs['data-grad-anim-dir'] = gradientAnimateDirection;
}

const isLink = !!href;
const isDropdown = shape === 'dropdown';

// Media nesting (Phase 1.6): icon/lottie chrome lives on the `media` prop —
// matches Heading/Badge/List family pattern. Only Icon | LottieIcon allowed.
const effectiveMedia = media;
const mediaComponent = effectiveMedia?.component;
const hasIcon = mediaComponent === 'Icon' || mediaComponent === 'LottieIcon';
const isIconOnly = hasIcon && (shape === 'circle' || shape?.startsWith('i-'));
const { component: _mediaComponent, ...rawMediaProps } = effectiveMedia || {};

// ─── Runtime rule enforcement (Phase 2) ────────────────────────────
// Mirrors validator + schema._rules. Three layers, same rules: schema
// documents, validator warns, atom enforces. AI-generated JSON or pipeline
// drift can't render a broken button — we silently fix or strip here.

// Rule: heavy-svg-icon-only — when the button has a text label or non-
// icon-only shape, strip morph/draw/fillAnimation props from the media
// spread. The icon is supplementary chrome in those cases; heavy SVG
// would distract from the label.
const heavySvgProps = ['morphTo', 'morphTrigger', 'draw', 'drawMode', 'drawColor', 'fillAnimation', 'fillMode', 'fillTrigger', 'fillColor'] as const;
const _heavySvgAllowed = !contentButton && (shape === 'circle' || shape?.startsWith('i-'));
let mediaProps: Record<string, any> = rawMediaProps;
if (hasIcon && !_heavySvgAllowed) {
  mediaProps = { ...rawMediaProps };
  for (const k of heavySvgProps) delete mediaProps[k];
}

// Rule: icon-contrast-on-fill — when variant is fill/glow/rainbow-glow
// and the child icon shares Button's brand/rainbow colour at the same
// tier, the icon would render in the same colour as the fill (invisible).
// Strip the matching colour props so the child inherits currentColor —
// Button.css computes contrast via oklch lightness inversion (Phase 3 CSS).
// Mirrors Shape's identical safeguard.
const _fillVariants = ['fill', 'glow', 'rainbow-glow'];
const _shapeBaseColour = rainbowColor || rawColor;
const _iconBaseColour = mediaProps.rainbowColor || mediaProps.brandColor;
const _iconTier = mediaProps.colorTier || 'base';
const _childInvisible = (
  hasIcon &&
  _fillVariants.includes(variant) &&
  !!_shapeBaseColour &&
  _iconBaseColour === _shapeBaseColour &&
  _iconTier === 'base'
);
if (_childInvisible) {
  mediaProps = { ...mediaProps };
  delete mediaProps.brandColor;
  delete mediaProps.rainbowColor;
  delete mediaProps.colorTier;
}

// Rule: no-tiers-on-button — already structurally enforced. colorTier
// is not in Props (TS error if typed) and not in the destructure (lands
// in `rest`); `rest` is filtered to `data-*` attrs only at line 108-110,
// so colorTier silently disappears even if a non-typed caller passes it.
// No explicit strip needed.

// Semantic role for AT context
const semanticRole = type === 'submit' ? 'form-submit' : isIconOnly && ariaLabel ? 'control' : 'action';

// Icon size omitted — .btn__icon CSS (1.25em) scales with button font-size.
// Size variants handled by .btn--sm/.btn--lg font-size differences.

// Build classes — confetti classes dropped (Phase 1.6: confetti extracted
// to its own atom). Tier classes never emitted on Button (preset variant
// styling; see Button.schema._rules.no-tiers).
const classes = [
  'btn',
  `btn--${variant}`,
  `btn--${color}`,
  `btn--${shape}`,
  size !== 'md' && `btn--${size}`,
  _effect && `btn--${_effect}`,
  speed && `btn--speed-${speed}`,
  hasIcon && 'btn--has-icon',
  hasIcon && `btn--icon-${iconPosition}`,
  isIconOnly && 'btn--icon-only',
  alignment && `btn-align--${alignment}`,
  // Gradient classes — same shape as Heading/Badge/Shape. Phase 3 CSS
  // hooks .btn--rainbow-glow + gradient--blend-* into --_glow-gradient
  // (currently the wrap::before falls back to the static rainbow gradient).
  gradientName && 'gradient',
  gradientName && `gradient--${variant}`,
  gradientName && `gradient--blend-${gradientName}`,
  gradientEmerge && 'gradient--emerge',
  gradientFade && 'gradient--fade',
  gradientCycle && 'gradient--cycle',
  gradientAnimated && 'gradient--animated',
  gradientAnimated && gradientAnimateSpeed && gradientAnimateSpeed !== 'default' && `gradient--speed-${gradientAnimateSpeed}`,
  className,
].filter(Boolean);

// Shared inner content
const iconLeft = iconPosition === 'left' && hasIcon;
const iconRight = iconPosition === 'right' && hasIcon;

---

{isDropdown ? (
  <div class="dropdown-wrapper">
    <button
      class:list={[...classes, 'dropdown-btn']}
      type={type}
      disabled={disabled}
      id={id}
      aria-label={ariaLabel}
      aria-expanded="false"
      aria-haspopup="true"
      data-semantic-role={semanticRole}
      {...dataAttrs}
    >
      {iconLeft && mediaComponent === 'Icon' && <Icon {...(mediaProps as any)} class="btn__icon" />}
      {iconLeft && mediaComponent === 'LottieIcon' && <LottieIcon {...(mediaProps as any)} class="btn__icon" />}
      <Text as="span" class="btn__label" flush>{contentButton ?? <slot />}</Text>      {iconRight && mediaComponent === 'Icon' && <Icon {...(mediaProps as any)} class="btn__icon" />}
      {iconRight && mediaComponent === 'LottieIcon' && <LottieIcon {...(mediaProps as any)} class="btn__icon" />}
      <Icon name="caret-down-fill" size={14} class="btn__chevron" />
    </button>

    <div
      class={`dropdown-menu dropdown-theme--${color}`}
      role="menu"
    >
      {dropdownItems.map((item) => (
        item.href ? (
          <a
            href={item.href}
            class:list={['dropdown-item', item.fontFamily && `dropdown-item--font-${item.fontFamily}`]}
            role="menuitem"
          >{item.label}</a>
        ) : (
          <button
            type="button"
            class:list={['dropdown-item', item.fontFamily && `dropdown-item--font-${item.fontFamily}`]}
            data-value={item.value}
            role="menuitem"
          >{item.label}</button>
        )
      ))}
    </div>
  </div>
) : isLink ? (
  variant === 'rainbow-glow' ? (
    <div class="btn-rainbow-glow-wrap">
      <a
        href={href}
        target={target}
        download={download}
        class:list={classes}
        id={id}
        aria-disabled={disabled}
        aria-label={ariaLabel}
        data-semantic-role={semanticRole}
        {...dataAttrs}
        >
        {iconLeft && mediaComponent === 'Icon' && <Icon {...(mediaProps as any)} class="btn__icon" />}
      {iconLeft && mediaComponent === 'LottieIcon' && <LottieIcon {...(mediaProps as any)} class="btn__icon" />}
        <Text as="span" class="btn__label" flush>{contentButton ?? <slot />}</Text>        {iconRight && mediaComponent === 'Icon' && <Icon {...(mediaProps as any)} class="btn__icon" />}
      {iconRight && mediaComponent === 'LottieIcon' && <LottieIcon {...(mediaProps as any)} class="btn__icon" />}
      {target === '_blank' && !hasIcon && <Icon name="arrow-square-out" weight="bold" semanticRole="decorative" class="btn__external" />}
      </a>
    </div>
  ) : (
    <a
      href={href}
      target={target}
      download={download}
      class:list={classes}
      id={id}
      aria-disabled={disabled}
      aria-label={ariaLabel}
      data-semantic-role={semanticRole}
      {...dataAttrs}
    >
      {iconLeft && mediaComponent === 'Icon' && <Icon {...(mediaProps as any)} class="btn__icon" />}
      {iconLeft && mediaComponent === 'LottieIcon' && <LottieIcon {...(mediaProps as any)} class="btn__icon" />}
      <Text as="span" class="btn__label" flush>{contentButton ?? <slot />}</Text>      {iconRight && mediaComponent === 'Icon' && <Icon {...(mediaProps as any)} class="btn__icon" />}
      {iconRight && mediaComponent === 'LottieIcon' && <LottieIcon {...(mediaProps as any)} class="btn__icon" />}
      {target === '_blank' && !hasIcon && <Icon name="arrow-square-out" weight="bold" semanticRole="decorative" class="btn__external" />}
    </a>
  )
) : variant === 'rainbow-glow' ? (
  <div class="btn-rainbow-glow-wrap">
    <button
      class:list={classes}
      type={type}
      disabled={disabled}
      id={id}
      aria-label={ariaLabel}
      data-semantic-role={semanticRole}
      {...dataAttrs}
    >
      {iconLeft && mediaComponent === 'Icon' && <Icon {...(mediaProps as any)} class="btn__icon" />}
      {iconLeft && mediaComponent === 'LottieIcon' && <LottieIcon {...(mediaProps as any)} class="btn__icon" />}
      <Text as="span" class="btn__label" flush>{contentButton ?? <slot />}</Text>      {iconRight && mediaComponent === 'Icon' && <Icon {...(mediaProps as any)} class="btn__icon" />}
      {iconRight && mediaComponent === 'LottieIcon' && <LottieIcon {...(mediaProps as any)} class="btn__icon" />}
    </button>
  </div>
) : (
  <button
    class:list={classes}
    type={type}
    disabled={disabled}
    id={id}
    aria-label={ariaLabel}
    data-semantic-role={semanticRole}
    {...dataAttrs}
  >
    {iconLeft && mediaComponent === 'Icon' && <Icon {...(mediaProps as any)} class="btn__icon" />}
    {iconLeft && mediaComponent === 'LottieIcon' && <LottieIcon {...(mediaProps as any)} class="btn__icon" />}
    <Text as="span" class="btn__label" flush>{contentButton ?? <slot />}</Text>    {iconRight && mediaComponent === 'Icon' && <Icon {...(mediaProps as any)} class="btn__icon" />}
    {iconRight && mediaComponent === 'LottieIcon' && <LottieIcon {...(mediaProps as any)} class="btn__icon" />}
  </button>
)}

<script>
  // Dropdown toggle
  function initDropdowns() {
    const wrappers = document.querySelectorAll('.dropdown-wrapper');

    wrappers.forEach((wrapper) => {
      if ((wrapper as HTMLElement).dataset.dropdownInit) return;
      (wrapper as HTMLElement).dataset.dropdownInit = '1';

      const btn = wrapper.querySelector('.dropdown-btn') as HTMLButtonElement;
      const menu = wrapper.querySelector('.dropdown-menu');
      if (!btn || !menu) return;

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = wrapper.classList.contains('open');

        // Close all others
        document.querySelectorAll('.dropdown-wrapper.open').forEach(w => {
          w.classList.remove('open');
          w.querySelector('.dropdown-menu')?.classList.remove('show');
          w.querySelector('.dropdown-btn')?.setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          wrapper.classList.add('open');
          menu.classList.add('show');
          btn.setAttribute('aria-expanded', 'true');
        }
      });

      // Keyboard: Escape closes, arrows navigate, tab wraps
      wrapper.addEventListener('keydown', (ev) => {
        const e = ev as KeyboardEvent;
        const isOpen = wrapper.classList.contains('open');
        if (!isOpen) return;

        const items = [...menu.querySelectorAll('.dropdown-item:not([disabled])')] as HTMLElement[];
        const currentIndex = items.indexOf(document.activeElement as HTMLElement);

        if (e.key === 'Escape') {
          e.preventDefault();
          wrapper.classList.remove('open');
          menu.classList.remove('show');
          btn.setAttribute('aria-expanded', 'false');
          btn.focus();
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          const next = currentIndex < items.length - 1 ? currentIndex + 1 : 0;
          items[next]?.focus();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          const prev = currentIndex > 0 ? currentIndex - 1 : items.length - 1;
          items[prev]?.focus();
        } else if (e.key === 'Tab') {
          // Tab past last item → close and let focus move naturally
          if (!e.shiftKey && currentIndex === items.length - 1) {
            wrapper.classList.remove('open');
            menu.classList.remove('show');
            btn.setAttribute('aria-expanded', 'false');
          }
          // Shift+Tab past first item → close and return to button
          if (e.shiftKey && (currentIndex === 0 || document.activeElement === btn)) {
            wrapper.classList.remove('open');
            menu.classList.remove('show');
            btn.setAttribute('aria-expanded', 'false');
          }
        } else if (e.key === 'Enter' || e.key === ' ') {
          if (document.activeElement !== btn && currentIndex >= 0) {
            e.preventDefault();
            items[currentIndex]?.click();
          }
        }
      });

      // When dropdown opens, focus first item
      const observer = new MutationObserver(() => {
        if (wrapper.classList.contains('open')) {
          const firstItem = menu.querySelector('.dropdown-item:not([disabled])') as HTMLElement;
          if (firstItem) setTimeout(() => firstItem.focus(), 50);
        }
      });
      observer.observe(wrapper, { attributes: true, attributeFilter: ['class'] });

      // Close when mouse leaves — only if setting enabled and keyboard focus not inside
      wrapper.addEventListener('mouseleave', () => {
        if (document.documentElement.hasAttribute('data-dropdown-mouseclose') &&
            wrapper.classList.contains('open') &&
            !wrapper.contains(document.activeElement)) {
          wrapper.classList.remove('open');
          menu.classList.remove('show');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    });

    // Close on outside click (only attach once)
    if (!(window as any).__dropdownOutsideClick) {
      (window as any).__dropdownOutsideClick = true;
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('.dropdown-wrapper')) {
          document.querySelectorAll('.dropdown-wrapper.open').forEach(w => {
            w.classList.remove('open');
            w.querySelector('.dropdown-menu')?.classList.remove('show');
            w.querySelector('.dropdown-btn')?.setAttribute('aria-expanded', 'false');
          });
        }
      });
    }
  }

  // Run immediately (module scripts are deferred — DOM is ready)
  initDropdowns();
  // Also support ClientRouter navigations
  document.addEventListener('astro:page-load', initDropdowns);
</script>

