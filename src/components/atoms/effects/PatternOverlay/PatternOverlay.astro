---
/**
 * PatternOverlay — Decorative pattern backgrounds
 *
 * Positioned overlay that renders tiled patterns via CSS mask-image,
 * background-image presets (static + SMIL animated), icon grids,
 * or custom images. Purely decorative, always aria-hidden.
 *
 * Modes:
 * - preset:     SVG data URI in background-image (static or SMIL animated)
 * - icon:       Phosphor SVG as mask-image, colour via background-color
 * - image:      Custom image URL as background-image
 * - grid:       DOM grid of <Icon> components (enables CSS hover)
 * - smil:       DOM grid of inline SMIL SVGs (enables hover animations)
 *
 * Integrations:
 * - Scroll colour: add data-scroll-bg to sync with ScrollColorBackground
 * - Scroll reveal: add data-scroll-reveal to fade in on scroll
 * - Magnetic cursor: set magnetic={true} for GSAP proximity effect
 *
 * CSS: PatternOverlay.style.css, PatternOverlay.responsive.css, PatternOverlay.a11y.css
 * JS:  lib/animation/pattern-overlay.ts (magnetic mode only)
 *
 * @example
 * <!-- Static preset -->
 * <PatternOverlay preset="dots" opacity={0.05} />
 *
 * <!-- Animated SMIL preset -->
 * <PatternOverlay preset="dots-pulse" opacity={0.04} angle={15} />
 *
 * <!-- Phosphor icon mask (colour changes with CSS) -->
 * <PatternOverlay icon="heart" iconWeight="thin" color="var(--brand-c-primary)" />
 *
 * <!-- Interactive icon grid with hover -->
 * <PatternOverlay icons={['heart', 'star', 'flower']} interactive />
 *
 * <!-- Scroll-synced colour -->
 * <PatternOverlay preset="cross" scrollColor="var(--brand-c-primary-light)" />
 */
import Icon from '../../icons/Icon.astro';

type PresetStatic = 'cross' | 'dots' | 'diagonal' | 'grid' | 'waves' | 'hexagons';
type PresetAnimated = 'cross-spin' | 'dots-pulse' | 'waves-flow';
type Preset = PresetStatic | PresetAnimated;

interface Props {
  /* ---- Source (pick one) ---- */
  preset?: Preset;
  icon?: string;
  iconWeight?: 'thin' | 'light' | 'regular' | 'bold' | 'fill' | 'duotone';
  icons?: string[];
  smil?: string[];
  image?: string;

  /* ---- Appearance ---- */
  opacity?: number;
  angle?: number;
  scale?: number;
  color?: string;
  blend?: string;
  spacing?: number;

  /* ---- Behaviour ---- */
  interactive?: boolean;
  magnetic?: boolean;
  scrollColor?: string;
  scrollReveal?: string;

  /* ---- Fallback ---- */
  fallback?: 'cross' | 'dots' | 'none';

  /* ---- HTML ---- */
  class?: string;
}

const {
  preset,
  icon,
  iconWeight = 'thin',
  icons,
  smil,
  image,
  opacity,
  angle = 0,
  scale = 60,
  color = 'var(--scroll-pattern-color, currentColor)',
  blend = 'normal',
  spacing = 0,
  interactive = false,
  magnetic = false,
  scrollColor,
  scrollReveal,
  fallback = 'none',
  class: className = '',
} = Astro.props;

/* ---- Determine render mode ---- */
type Mode = 'preset' | 'icon-mask' | 'image' | 'grid' | 'smil-grid';
let mode: Mode = 'preset';
if (icons && icons.length > 0) mode = 'grid';
else if (smil && smil.length > 0) mode = 'smil-grid';
else if (icon) mode = 'icon-mask';
else if (image) mode = 'image';

/* ---- Build icon mask URL for Phosphor icons ---- */
const iconMaskUrl = icon
  ? `/Icons/phosphor/${icon}${iconWeight !== 'regular' ? `-${iconWeight}` : ''}.svg`
  : '';

/* ---- Tile pool for grid modes ---- */
const GRID_POOL_SIZE = 150;
const tilePool: string[] = [];
if (mode === 'grid' && icons) {
  for (let i = 0; i < GRID_POOL_SIZE; i++) {
    tilePool.push(icons[i % icons.length]);
  }
}

/* ---- CSS custom properties ---- */
const cssVars = [
  opacity !== undefined ? `--po-opacity: ${opacity}` : '',
  `--po-angle: ${angle}deg`,
  `--po-scale: ${scale}px`,
  `--po-color: ${color}`,
  `--po-blend: ${blend}`,
  spacing > 0 ? `--po-spacing: ${spacing}px` : '',
].filter(Boolean).join('; ');

/* ---- Data attributes for JS hooks ---- */
const dataAttrs: Record<string, string> = {};
if (scrollColor) dataAttrs['data-scroll-bg'] = scrollColor;
if (scrollReveal) dataAttrs['data-scroll-reveal'] = scrollReveal;
if (magnetic) dataAttrs['data-pattern-magnetic'] = 'true';
if (preset) dataAttrs['data-pattern-preset'] = preset;
---

{/* ================================================================
    MODE: Preset (static or SMIL) / Image / Icon mask
    Single div, no children. All rendering via CSS.
    ================================================================ */}
{(mode === 'preset' || mode === 'image' || mode === 'icon-mask') && (
  <div
    class:list={[
      'pattern-overlay',
      mode === 'preset' && `pattern-overlay--preset-${preset}`,
      mode === 'icon-mask' && 'pattern-overlay--icon-mask',
      mode === 'image' && 'pattern-overlay--image',
      className,
    ]}
    style={[
      cssVars,
      mode === 'icon-mask' ? `--po-mask-url: url('${iconMaskUrl}')` : '',
      mode === 'image' ? `--po-image-url: url('${image}')` : '',
    ].filter(Boolean).join('; ')}
    aria-hidden="true"
    {...dataAttrs}
  />
)}

{/* ================================================================
    MODE: Icon grid (DOM nodes, enables CSS hover + magnetic)
    ================================================================ */}
{mode === 'grid' && (
  <div
    class:list={[
      'pattern-overlay',
      'pattern-overlay--grid',
      interactive && 'pattern-overlay--interactive',
      className,
    ]}
    style={cssVars}
    aria-hidden="true"
    {...dataAttrs}
  >
    {tilePool.map((iconName) => (
      <div class="pattern-overlay__cell">
        <Icon name={iconName} size={scale * 0.6} />
      </div>
    ))}
  </div>
)}

{/* ================================================================
    MODE: SMIL grid (inline SVGs with hover animations)
    ================================================================ */}
{mode === 'smil-grid' && smil && (
  <div
    class:list={[
      'pattern-overlay',
      'pattern-overlay--grid',
      'pattern-overlay--smil',
      interactive && 'pattern-overlay--interactive',
      className,
    ]}
    style={cssVars}
    aria-hidden="true"
    {...dataAttrs}
  >
    {Array.from({ length: GRID_POOL_SIZE }).map((_, i) => (
      <div class="pattern-overlay__cell">
        <Fragment set:html={smil[i % smil.length]} />
      </div>
    ))}
  </div>
)}

{magnetic && (
  <script>
    import '../../../../lib/animation/pattern-overlay';
  </script>
)}
