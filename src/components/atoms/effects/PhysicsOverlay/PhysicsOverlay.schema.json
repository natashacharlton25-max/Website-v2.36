{
  "component": "PhysicsOverlay",
  "category": "atoms/effects",
  "renders": {
    "base": "PhysicsOverlay.astro"
  },
  "props": {
    "icons":          { "type": "array",           "required": true },
    "iconWeight":     { "type": "string",           "required": false, "default": "light" },
    "count":          { "type": "number",           "required": false, "default": 30 },
    "maxCount":       { "type": "number",           "required": false, "default": 80 },
    "gravity":        { "type": "number",           "required": false, "default": 1 },
    "bounce":         { "type": "number",           "required": false, "default": 0.6 },
    "friction":       { "type": "number",           "required": false, "default": 0.1 },
    "airFriction":    { "type": "number",           "required": false, "default": 0.01 },
    "iconSize":       { "type": "number",           "required": false, "default": 24 },
    "cursorMode":     { "type": "string",           "required": false, "default": "repel" },
    "cursorRadius":   { "type": "number",           "required": false, "default": 150 },
    "cursorStrength": { "type": "number",           "required": false, "default": 0.005 },
    "color":          { "type": "string|array",     "required": false, "default": "var(--brand-c-primary)" },
    "opacity":        { "type": "number",           "required": false, "default": 0.15 },
    "scrollColor":    { "type": "boolean",          "required": false, "default": false },
    "contained":      { "type": "boolean",          "required": false, "default": false },
    "lifespan":       { "type": "number",           "required": false, "default": 0 },
    "spawnDelay":     { "type": "number",           "required": false, "default": 0 },
    "spawnStagger":   { "type": "number",           "required": false, "default": 80 },
    "class":          { "type": "string",           "required": false, "default": "" }
  }
}
