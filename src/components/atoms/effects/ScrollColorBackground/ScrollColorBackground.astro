---
/**
 * ScrollColorBackground - GSAP-powered scroll-triggered background color changes
 *
 * Creates a fixed background layer that smoothly transitions colors
 * as the user scrolls through sections with data-scroll-bg attributes.
 *
 * Usage:
 * 1. Add this component to your page layout
 * 2. Add data-scroll-bg="var(--color-Name-100)" to sections
 * 3. Colors will smoothly transition as user scrolls
 *
 * Features:
 * - Resolves CSS variables and OKLCH colors to RGB for GSAP
 * - Respects a11y settings — disables when active
 * - Smooth bidirectional scrolling
 * - Kills previous tweens to prevent conflicts
 *
 * CSS: ScrollColorBackground.style.css, ScrollColorBackground.a11y.css
 * JS:  lib/animation/scroll-color-background.ts
 *
 * @param initialColor - Optional initial background color (default: var(--brand-c-bg))
 */

interface Props {
  initialColor?: string;
}

const { initialColor = 'var(--brand-c-bg)' } = Astro.props;
---

<!-- Fixed background layer for scroll-triggered color changes -->
<div class="scroll-bg-layer" id="scroll-bg-layer"></div>

<script>
  import '../../../../lib/animation/scroll-color-background';
</script>
