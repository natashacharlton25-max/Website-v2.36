---
/**
 * ParallaxDecor
 * src/components/atoms/effects/ParallaxDecor/ParallaxDecor.astro
 *
 * Decorative parallax elements — icons, rings, and dots at different
 * Z-depths via stellar-parallax.ts data-depth attributes.
 *
 * Atmospheric perspective: far icons (low depth) are smaller, lighter,
 * more transparent. Near icons (high depth) are larger, darker, bolder.
 *
 * Modes:
 *   scatter — auto-generate a field of icons at varied depths
 *   icons   — manual placement of individual icons
 *   rings/dots — geometric shapes (legacy)
 *
 * Usage:
 * <!-- Auto-scatter field -->
 * <ParallaxDecor scatter={{
 *   names: ['wellness/heart-fill', 'creative/star-fill', 'nature/leaf-fill'],
 *   count: 30,
 * }} />
 *
 * <!-- Starfield — distant twinkling dots that lose shape -->
 * <ParallaxDecor starfield={{ count: 80, seed: 7 }} />
 *
 * <!-- Combined — icons up close, stars in the distance -->
 * <ParallaxDecor
 *   scatter={{ names: [...], count: 25 }}
 *   starfield={{ count: 60 }}
 * />
 *
 * <!-- Manual placement -->
 * <ParallaxDecor icons={[
 *   { name: 'wellness/heart-fill', size: 'lg', depth: 0.3, top: '10%', left: '5%' },
 * ]} />
 */
import Icon from '../../icons/Icon/Icon.astro';

type MotionType = 'twinkle' | 'breathe' | 'float' | 'drift' | 'pulse' | 'orbit' | 'sway' | 'static' | 'none';

interface IconDecor {
  name: string;
  size?: 'sm' | 'md' | 'lg';
  depth: number;
  motion?: MotionType;
  top?: string;
  left?: string;
  right?: string;
  bottom?: string;
}

interface ScatterConfig {
  names: string[];
  count?: number;
  depthRange?: [number, number];
  seed?: number;
  motion?: MotionType | 'depth';  // 'depth' = auto-derive from depth (default)
}

interface StarfieldConfig {
  count?: number;              // default 80
  depthRange?: [number, number]; // default [0.05, 0.45] — far background only
  seed?: number;               // default 7
}

interface Ring {
  size: 'sm' | 'md' | 'lg';
  depth: number;
  top?: string;
  left?: string;
  right?: string;
  bottom?: string;
}

interface Dot {
  size?: 'sm' | 'md';
  depth: number;
  top?: string;
  left?: string;
  right?: string;
  bottom?: string;
}

interface Props {
  scatter?: ScatterConfig;
  starfield?: StarfieldConfig;
  icons?: IconDecor[];
  rings?: Ring[];
  dots?: Dot[];
  color?: string;
  class?: string;
}

const {
  scatter,
  starfield,
  icons = [],
  rings = [],
  dots = [],
  color,
  class: className = '',
} = Astro.props;

/* ---- Depth constants (sync with stellar-parallax.ts & images.css tokens) ---- */
const DEPTH_MIN = 0.2;
const DEPTH_MAX = 2.0;
const DEPTH_RANGE = DEPTH_MAX - DEPTH_MIN;

/* ---- Deterministic pseudo-random (Mulberry32) ---- */
function mulberry32(seed: number) {
  return () => {
    seed |= 0; seed = seed + 0x6D2B79F5 | 0;
    let t = Math.imul(seed ^ seed >>> 15, 1 | seed);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}

/* ---- Scatter generation ---- */
interface ScatteredIcon {
  name: string;
  depth: number;
  x: number;       // % left
  y: number;       // % top
  size: 'sm' | 'md' | 'lg';
  opacity: number;
  depthMix: number; // 0–100% for color-mix (0=light/far, 100=dark/near)
  motion: MotionType;
  stagger: number;  // seconds — stagger delay for ambient animation
  speed: number;    // seconds — animation cycle duration (far=slow, near=fast)
}

function generateScatter(config: ScatterConfig): ScatteredIcon[] {
  const {
    names,
    count = 25,
    depthRange = [0.2, 2.0],
    seed = 42,
  } = config;

  const rand = mulberry32(seed);
  const [minD, maxD] = depthRange;
  const result: ScatteredIcon[] = [];

  for (let i = 0; i < count; i++) {
    const depth = minD + rand() * (maxD - minD);
    const name = names[i % names.length];

    // Position: spread across full area
    let x = rand() * 90 + 5;   // 5–95%
    let y = rand() * 85 + 5;   // 5–90%

    // Atmospheric perspective: depth drives size, opacity, and color
    // depth 0.2 = far (small, faint, light)   depth 2.0 = near (large, solid, dark)
    const t = (depth - minD) / (maxD - minD); // 0..1 normalised

    // Size: far=sm, mid=md, near=lg
    const size: 'sm' | 'md' | 'lg' = t < 0.35 ? 'sm' : t < 0.7 ? 'md' : 'lg';

    // Color mix: 0% = light washed-out, 100% = dark saturated (no opacity — color only)
    const depthMix = Math.round(t * 100);

    // Motion: derive from depth or use explicit override
    const motionMode = config.motion === 'depth' || !config.motion
      ? (t < 0.35 ? 'twinkle' : t < 0.7 ? 'float' : 'breathe') as MotionType
      : config.motion;

    // Stagger: random delay so icons don't all animate in sync
    const stagger = rand() * 6; // 0–6s offset

    // Speed: far icons animate slowly (8s), near icons faster (2s)
    const speed = 8 - t * 6; // 8s (far) → 2s (near)

    result.push({ name, depth: Math.round(depth * 100) / 100, x, y, size, opacity: 1, depthMix, motion: motionMode, stagger, speed });
  }

  return result;
}

// Sort by depth ascending — far (light) renders first (behind), near (dark) renders last (on top)
const scattered = scatter ? generateScatter(scatter).sort((a, b) => a.depth - b.depth) : [];

/* ---- Starfield generation ---- */
interface Star {
  depth: number;
  x: number;       // % left
  y: number;       // % top
  size: number;    // px (2–5)
  opacity: number;
  twinkleDuration: number; // seconds
  twinkleDelay: number;    // seconds
}

function generateStarfield(config: StarfieldConfig): Star[] {
  const {
    count = 80,
    depthRange = [0.05, 0.45],
    seed = 7,
  } = config;

  const rand = mulberry32(seed);
  const [minD, maxD] = depthRange;
  const result: Star[] = [];

  for (let i = 0; i < count; i++) {
    const depth = minD + rand() * (maxD - minD);

    // Spread across entire area
    const x = rand() * 96 + 2;  // 2–98%
    const y = rand() * 94 + 3;  // 3–97%

    // Farther = smaller, fainter
    const t = (depth - minD) / (maxD - minD); // 0..1
    const size = 2 + t * 3;     // 2px (far) → 5px (near-ish)
    const opacity = 0.06 + t * 0.18; // 0.06 → 0.24

    // Stagger twinkle so they don't all pulse in sync
    const twinkleDuration = 2.5 + rand() * 3;   // 2.5–5.5s
    const twinkleDelay = rand() * 6;             // 0–6s offset

    result.push({
      depth: Math.round(depth * 100) / 100,
      x, y, size, opacity,
      twinkleDuration, twinkleDelay,
    });
  }

  return result;
}

const stars = starfield ? generateStarfield(starfield) : [];

/* ---- Helpers ---- */
function posStyle(item: { top?: string; left?: string; right?: string; bottom?: string }): string {
  const parts: string[] = [];
  if (item.top) parts.push(`top:${item.top}`);
  if (item.left) parts.push(`left:${item.left}`);
  if (item.right) parts.push(`right:${item.right}`);
  if (item.bottom) parts.push(`bottom:${item.bottom}`);
  return parts.join(';');
}

/** Depth-driven color mix % for manual icons. */
function depthMix(depth: number): number {
  const t = Math.max(0, Math.min(1, (depth - DEPTH_MIN) / DEPTH_RANGE));
  return Math.round(t * 100);
}
---

<div class={`parallax-decor ${className}`} aria-hidden="true">
  {/* Starfield — distant twinkling dots */}
  {stars.map((star) => (
    <div
      class="parallax-decor__star"
      data-depth={star.depth}
      style={`top:${star.y}%;left:${star.x}%;width:${star.size.toFixed(1)}px;height:${star.size.toFixed(1)}px;--star-base:${star.opacity.toFixed(3)};--star-peak:${Math.min(star.opacity * 2.5, 0.6).toFixed(3)};--twinkle-dur:${star.twinkleDuration.toFixed(1)}s;--twinkle-delay:${star.twinkleDelay.toFixed(1)}s`}
    />
  ))}

  {/* Scatter-generated field — outer div = GSAP parallax, inner div = CSS ambient motion */}
  {scattered.map((s) => (
    <div
      class={`parallax-decor__icon parallax-decor__icon--${s.size}`}
      data-depth={s.depth}
      style={`top:${s.y}%;left:${s.x}%;--depth-mix:${s.depthMix}`}
    >
      <div data-motion={s.motion} style={`--pm-drift-speed:${s.speed.toFixed(1)}s;--pm-stagger:${s.stagger.toFixed(1)}s`}>
        <Icon name={s.name} />
      </div>
    </div>
  ))}

  {/* Manual icons — outer = GSAP, inner = CSS ambient */}
  {icons.map((icon) => (
    <div
      class={`parallax-decor__icon parallax-decor__icon--${icon.size || 'md'}`}
      data-depth={icon.depth}
      style={posStyle(icon) + `;--depth-mix:${depthMix(icon.depth)}` + (color ? `;color:${color}` : '')}
    >
      <div data-motion={icon.motion || 'breathe'}>
        <Icon name={icon.name} />
      </div>
    </div>
  ))}

  {rings.map((ring) => (
    <div
      class={`parallax-decor__ring parallax-decor__ring--${ring.size}`}
      data-depth={ring.depth}
      style={posStyle(ring) + (color ? `;border-color:${color}` : '')}
    />
  ))}

  {dots.map((dot) => (
    <div
      class={`parallax-decor__dot ${dot.size === 'sm' ? 'parallax-decor__dot--sm' : ''}`}
      data-depth={dot.depth}
      style={posStyle(dot) + (color ? `;background:${color}` : '')}
    />
  ))}
</div>
