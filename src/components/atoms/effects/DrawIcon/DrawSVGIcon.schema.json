{
  "component": "DrawSVGIcon",
  "category": "atoms/effects",
  "renders": {
    "base": "DrawSVGIcon.astro"
  },
  "props": {
    "variant":        { "type": "string",  "required": true, "enum": ["draw", "drawcenter", "chachaslide", "flashgordon", "rainbowchase", "pulse"] },
    "svgIcon":        { "type": "string",  "required": true },
    "animateOnHover": { "type": "boolean", "required": false, "default": true },
    "primaryColor":   { "type": "string",  "required": false },
    "class":          { "type": "string",  "required": false, "default": "" }
  }
}
