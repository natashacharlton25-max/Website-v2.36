---
/**
 * Card — Atomic container shell + layout-preset atom
 *
 * TWO modes, selected by whether `cardType` is set:
 *
 *  1. LAYOUT PRESET (cardType set) — the new model (LAYOUT-ENGINE-SPEC §11/§12).
 *     A designed layout keyed by `.card--{cardType}` in Card.css. Content comes
 *     in as nested component-node slots (title/meta/body/button/media) — each is
 *     `{ component, …childProps }`; the child atom owns its own props. Composed
 *     the same way Heading composes its media. Author picks cardType + fills
 *     slots; the preset owns all sizing/placement.
 *
 *  2. LEGACY CONTAINER (cardType absent) — pure container shell with chrome
 *     props + `<slot/>`. Molecule cards render <Card> as their outer wrapper.
 *     Kept until each is rebuilt as a cardType and migrated to the JSON card
 *     test page. UNTOUCHED by the preset work.
 *
 * Styles: Card.css | Card.responsive.css
 */
import { Heading } from '../Heading';
import { Text } from '../Text';
import { Button } from '../Button';
import { Icon } from '../Icon';
import { LottieIcon } from '../LottieIcon';
import { Image } from '../Image';
import { Shape } from '../Shape';

export interface Props {
  // ── Layout-preset model (new) ──────────────────────────────
  cardType?: 'horizontal';
  /** Nested component nodes: { component, …childProps }. Child atom owns its props. */
  title?: Record<string, any>;
  meta?: Record<string, any>;
  body?: Record<string, any>;
  button?: Record<string, any>;
  media?: Record<string, any>;
  /** Card-level reading-mode intent (textonly keep/drop). */
  semanticRole?: 'decorative' | 'ui-control' | 'content-symbol';
  mediaBg?: boolean;
  mediaBgSize?: 'compact' | 'normal' | 'spacious';
  mediaSize?: 'auto' | 'xs' | 'sm' | 'md' | 'lg' | 'xl' | 'base' | '2xl' | '3xl';

  // ── Legacy container model (cardType absent) ───────────────
  as?: 'div' | 'article' | 'section' | 'aside' | 'li';
  variant?: 'default' | 'transparent' | 'outline' | 'glass' | 'liquid' | 'neumorphic' | 'pressed' | 'comic' | 'tech';
  hover?: boolean | 'border' | 'glow' | ('lift' | 'border' | 'glow')[];
  shadow?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  dropShadow?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  radius?: 'none' | 'sm' | 'md' | 'lg' | 'xl' | 'full';
  padding?: 'none' | 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  border?: 'none' | 'thin' | 'medium' | 'thick';
  bg?: string;
  layout?: 'masonry';
  flush?: boolean;
  href?: string;
  separator?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  cardType,
  title, meta, body, button, media,
  semanticRole,
  mediaBg = false,
  mediaBgSize,
  mediaSize,
  // legacy
  as = 'div',
  variant = 'default',
  hover,
  shadow,
  dropShadow,
  radius,
  padding,
  border,
  bg,
  layout,
  flush,
  href,
  separator,
  class: className,
  ...rest
} = Astro.props;

// ── Layout-preset model — split each component node into its child props ──
// (mirrors Heading: const { component, ...rawProps } = media)
const mediaComponent = media?.component;
const { component: _mc, ...rawMediaProps } = media || {};
// mediaBg=true → Shape is wallpaper for a child atom: auto-inject
// semanticRole='background' (runtime guarantee, not authoring discipline) and
// forward the padding size — same as Heading/List/Badge.
const baseMediaProps = (mediaBg && mediaComponent === 'Shape')
  ? { ...rawMediaProps, semanticRole: 'background', mediaBgSize: rawMediaProps.mediaBgSize ?? mediaBgSize }
  : rawMediaProps;
const mediaProps = (mediaSize && mediaSize !== 'auto' && baseMediaProps.size == null)
  ? { ...baseMediaProps, size: mediaSize }
  : baseMediaProps;

const { component: _tc, ...titleProps } = title || {};
const { component: _mtc, ...metaProps } = meta || {};
const { component: _bc, ...bodyProps } = body || {};
const { component: _btc, ...buttonProps } = button || {};

// ── Legacy container model ──
const Tag = href ? 'a' : as;
const classes = [
  'card',
  `card--${variant}`,
  (hover === true || (Array.isArray(hover) && hover.includes('lift'))) && 'card--hover-lift',
  (hover === 'border' || (Array.isArray(hover) && hover.includes('border'))) && 'card--hover-border',
  (hover === 'glow' || (Array.isArray(hover) && hover.includes('glow'))) && 'card--hover-glow',
  shadow && shadow !== 'none' && `card--shadow-${shadow}`,
  dropShadow && dropShadow !== 'none' && `card--drop-${dropShadow}`,
  radius && `card--radius-${radius}`,
  padding && `card--pad-${padding}`,
  border && border !== 'none' && `card--border-${border}`,
  layout === 'masonry' && 'card--masonry',
  flush && 'card--flush',
  href && 'card--link',
  separator && 'card--separator',
  className,
].filter(Boolean);

const linkAttrs = href ? {
  href,
  ...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
} : {};
---

{cardType ? (
  /* ── Layout-preset model ── */
  <div
    class:list={['card', `card--${cardType}`, (media && mediaComponent === 'Image' && !mediaBg) ? 'card--media-fill' : 'card--media-hug', className]}
    data-card
    data-semantic-role={semanticRole || undefined}
    {...rest}
  >
    {media && (
      <div class:list={['card__media', (mediaComponent === 'Image' && !mediaBg) ? 'card__media--fill' : 'card__media--center']}>
        {mediaBg && <Shape {...(mediaProps as any)} class="card__media-shape" />}
        {!mediaBg && mediaComponent === 'Icon' && <Icon {...(mediaProps as any)} class="card__media-icon" />}
        {!mediaBg && mediaComponent === 'LottieIcon' && <LottieIcon {...(mediaProps as any)} class="card__media-icon" />}
        {/* Preset controls the fill: force fit="cover" + drop any authored width/height
            so the image fills the cell and an author can't set a fixed width that breaks it. */}
        {!mediaBg && mediaComponent === 'Image' && <Image {...(mediaProps as any)} width={undefined} height={undefined} cover fit="cover" class="card__media-img" />}
        {!mediaBg && mediaComponent === 'Shape' && <Shape {...(mediaProps as any)} class="card__media-shape" />}
      </div>
    )}

    <div class="card__main">
      {/* DOM order title → meta → body (document/screen-reader order); visual
          order meta → title → body via CSS `order` on .card__meta. */}
      {title && <Heading {...(titleProps as any)} flush class="card__title" />}
      {meta && <Text size="sm" {...(metaProps as any)} flush class="card__meta" />}
      {body && <Text size="sm" {...(bodyProps as any)} flush class="card__body-text" />}
      {button && (
        <div class="card__footer">
          {/* shape="soft" (--radius-md) = the inner radius, matching the image; a
              step inside the card's --radius-lg (concentric, §12.7). Default —
              author can still override the shape. */}
          <Button size="sm" shape="soft" {...(buttonProps as any)} />
        </div>
      )}
    </div>
  </div>
) : (
  /* ── Legacy container model (untouched) ── */
  <Fragment>
    {variant === 'liquid' && (
      <svg width="0" height="0" style="position: absolute;" aria-hidden="true">
        <defs>
          <filter id="glass-distortion" x="0%" y="0%" width="100%" height="100%">
            <feTurbulence type="fractalNoise" baseFrequency="0.02 0.02" numOctaves="2" seed="92" result="noise" />
            <feGaussianBlur in="noise" stdDeviation="2" result="blurred" />
            <feDisplacementMap in="SourceGraphic" in2="blurred" scale="200" xChannelSelector="R" yChannelSelector="G" />
          </filter>
        </defs>
      </svg>
    )}

    <Tag
      class:list={classes}
      data-card
      style={bg ? `--card-bg: ${bg}` : undefined}
      {...linkAttrs}
      {...rest}
    >
      <slot />
    </Tag>
  </Fragment>
)}
