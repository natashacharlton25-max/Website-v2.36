---
/**
 * Badge — Simple inline label
 *
 * Colour set by global .color--{name} mixin (colour.css).
 * --_color, --_tier-tint/mid/emphasis available on .badge element.
 *
 * @param label - Display text
 * @param variant - 'fill' (default), 'outline', 'glass'
 * @param size - 'sm', 'md' (default), 'lg'
 * @param shape - 'sharp', 'subtle', 'soft' (default), 'rounded'
 * @param icon - Optional Phosphor icon slug e.g. 'shield-check-fill'
 * @param uppercase - Uppercase text (default true)
 * @param semanticRole - 'status' (default), 'tag', 'label', 'none'
 */
import { Icon } from '../Icon';
import { LottieIcon } from '../LottieIcon';
import { Text } from '../Text';
import { Heading } from '../Heading';
import type {
  BrandColour, RainbowColour, ColourTier,
  Variant, Shadow, GradientBlend, GradientDirection,
  Size, BorderWeight,
  FontFamily, FontWeight, SemanticRole,
} from '../../../lib/shared-enums';

/** Badge-specific shape — narrower than the shared Shape enum which
 *  includes 'pill' (Badge has no pill CSS rule and the schema enum
 *  rejects it). Local type keeps schema, CSS, and TS aligned. */
type BadgeShape = 'sharp' | 'subtle' | 'soft' | 'rounded';
import { getGradientStopColours } from '../../../lib/gradient-inline';

interface Props {
  /** Badge display text. Pipeline content key. */
  contentBadge: string;
  /** Brand colour — primary/secondary/neutral, changes per theme */
  brandColor?: BrandColour;
  /** Rainbow colour — red through pink, universal accents */
  rainbowColor?: RainbowColour;
  colorTier?: ColourTier;
  variant?: Variant;
  shadow?: Shadow;
  /** Show colour as gradient instead of flat */
  gradient?: boolean;
  /** Mixed blend — overrides single-colour gradient with two-colour blend */
  gradientBlend?: GradientBlend;
  gradientDirection?: GradientDirection;
  /** Fade-in modifier — first 50% transparent, fades to solid */
  gradientEmerge?: boolean;
  /** Fade-out modifier — last 20% fades to transparent */
  gradientFade?: boolean;
  /** Colour cycle — cross-fades through the element's own tier tokens (tint→mid→base→emphasis). */
  gradientCycle?: boolean;
  /** Reverse gradient direction on text (outline/glass: text runs opposite to border) */
  gradientFlip?: boolean;
  gradientAnimated?: boolean;
  /** Animation direction — cw (default), ccw, or sway */
  gradientAnimateDirection?: 'cw' | 'ccw' | 'sway';
  /** Animation speed — slow (20s), default (12s), fast (6s) */
  gradientAnimateSpeed?: 'slow' | 'default' | 'fast';
  size?: Size;
  shape?: BadgeShape;
  borderWeight?: BorderWeight;
  /** Media — component node { component: "Icon"|"LottieIcon", ...atomProps } */
  media?: Record<string, any>;
  fontFamily?: FontFamily;
  fontWeight?: FontWeight;
  uppercase?: boolean;
  semanticRole?: SemanticRole;
  level?: 1 | 2 | 3 | 4 | 5 | 6;
}

const {
  contentBadge: label,
  brandColor = 'primary',
  rainbowColor,
  colorTier = 'base',
  variant = 'fill',
  shadow = 'none',
  gradient = false,
  gradientBlend,
  gradientDirection = 'diagonal',
  gradientEmerge = false,
  gradientFade = false,
  gradientFlip = false,
  gradientAnimated = false,
  gradientAnimateDirection = 'cw',
  gradientAnimateSpeed = 'default',
  gradientCycle = false,
  size = 'md',
  shape = 'soft',
  borderWeight,
  media,
  fontFamily,
  fontWeight = 'bold',
  uppercase = true,
  semanticRole = 'status',
  level,
} = Astro.props;

// Resolve colour: rainbow takes precedence if set, else brand
const color = rainbowColor || brandColor;

// Resolve gradient name (matches Shape.astro logic):
//   1. gradientBlend (named blends — hero, sunset, rainbow etc.)
//   2. baseColour + colorTier (e.g. rainbow-1 + mid → rainbow-1-preset-mid)
//   3. baseColour (rainbow-1, primary etc.)
// Badge does not support radial gradients (linear only — radial is for Card/Section).
// Flip direction for gradient text when gradientFlip is set
const reverseDir: Record<string, GradientDirection> = {
  'vertical': 'vertical-reverse', 'vertical-reverse': 'vertical',
  'horizontal': 'horizontal-reverse', 'horizontal-reverse': 'horizontal',
  'diagonal': 'diagonal-reverse', 'diagonal-reverse': 'diagonal',
  'diagonal-alt': 'diagonal-alt-reverse', 'diagonal-alt-reverse': 'diagonal-alt',
};
const textGradientDirection: GradientDirection | undefined = gradientFlip
  ? (gradientDirection ? reverseDir[gradientDirection] : 'diagonal-reverse')
  : gradientDirection;

// Flip inline style is handled by the nested Heading atom — Badge just forwards
// gradientEmerge/gradientFade/gradientFlip props and Heading owns the mirror logic.

const tierSuffix = (gradient && colorTier && colorTier !== 'base') ? `-preset-${colorTier}` : '';
const emergePrefix = gradientEmerge ? 'emerge-' : gradientFade ? 'fade-' : '';
const gradientName = gradientBlend
  || (gradient && color ? `${emergePrefix}${color}${tierSuffix}` : null)
  || (gradient ? `${emergePrefix}primary` : null);

// Cycle reads the active gradient's stop tokens from the catalogue — these
// are per-instance values (resolved from gradientName) so they stay inline.
// Speed is class-based (.gradient--speed-{slow|fast}); phase desync is GSAP's
// job. No --_grad-anim-delay or --_grad-anim-duration emitted from here.
const badgeAnimParts: string[] = [];
if (gradientCycle && gradientName) {
  const stopColours = getGradientStopColours(gradientName);
  if (stopColours && stopColours.length >= 2) {
    const a = stopColours[0];
    const b = stopColours.length > 2 ? stopColours[Math.floor(stopColours.length / 2)] : stopColours[1];
    const c = stopColours[stopColours.length - 1];
    badgeAnimParts.push(`--_cycle-a:${a}`);
    badgeAnimParts.push(`--_cycle-b:${b}`);
    badgeAnimParts.push(`--_cycle-c:${c}`);
  }
}
const badgeAnimStyle = badgeAnimParts.length ? badgeAnimParts.join(';') : undefined;

// Shared props forwarded to the nested Heading when the badge label
// renders as a heading (level prop set, OR gradient on non-fill variant).
// Both code paths spread the same set; extracted so the JSX stays
// readable and the two branches stay in sync if props are added.
const headingLabelProps = {
  contentHeading: label,
  flush: true,
  weight: fontWeight !== 'bold' ? fontWeight : undefined,
  gradient,
  gradientBlend,
  gradientDirection,
  gradientEmerge,
  gradientFade,
  gradientFlip,
  brandColor: !rainbowColor ? brandColor : undefined,
  rainbowColor,
  colorTier,
  class: 'badge__label',
};
---

<span
  role={semanticRole !== 'none' ? 'note' : undefined}
  data-semantic-role={semanticRole !== 'none' ? semanticRole : undefined}
  data-grad-dir={gradientDirection || undefined}
  data-grad-anim-dir={gradientAnimated && gradientAnimateDirection && gradientAnimateDirection !== 'cw' ? gradientAnimateDirection : undefined}
  style={badgeAnimStyle}
  class:list={[
    'badge',
    `color--${color}`,
    colorTier && colorTier !== 'base' && `color--tier-${colorTier}`,
    `badge--${variant}`,
    shadow !== 'none' && `badge--shadow-${shadow}`,
    gradientName && 'gradient',
    gradientName && `gradient--${variant}`,
    /* Always emit blend class from gradientName so generated CSS rules match
       (handles blends, single colours, AND tier presets like rainbow-1-preset-tint). */
    gradientName && `gradient--blend-${gradientName}`,
    gradientEmerge && 'gradient--emerge',
    gradientFade && 'gradient--fade',
    gradientCycle && 'gradient--cycle',
    gradientAnimated && 'gradient--animated',
    gradientAnimated && gradientAnimateSpeed && gradientAnimateSpeed !== 'default' && `gradient--speed-${gradientAnimateSpeed}`,
    size !== 'md' && `badge--${size}`,
    `badge--${shape}`,
    borderWeight && `badge--border-${borderWeight}`,
    level && 'badge--heading',
    media && 'badge--has-icon',
    !uppercase && 'badge--lowercase',
  ]}
>
  {media?.component === 'Icon' && <Icon {...media} class="badge__icon" aria-hidden="true" />}
  {media?.component === 'LottieIcon' && <LottieIcon {...media} class="badge__icon" aria-hidden="true" />}
  {level ? (
    <Heading {...headingLabelProps} level={level} family={fontFamily} />
  ) : ((gradient || gradientBlend) && (variant !== 'fill' || gradientFlip)) ? (
    <Heading {...headingLabelProps} level={6} family={fontFamily || 'body'} />
  ) : (
    <Text contentText={label} as="span" class="badge__label" flush family={fontFamily} weight={fontWeight !== 'bold' ? fontWeight : undefined} color={(gradientEmerge || gradientFade) ? (rainbowColor || brandColor) : undefined} />
  )}
</span>
