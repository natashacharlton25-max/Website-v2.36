---
/**
 * Badge — Simple inline label
 *
 * Token system: --_badge-bg / --_badge-text / --_badge-border
 * Colour set by JSON pipeline via inline style.
 *
 * @param label - Display text
 * @param variant - 'fill' (default), 'outline', 'glass'
 * @param size - 'sm', 'md' (default), 'lg'
 * @param shape - 'sharp', 'subtle', 'soft' (default), 'rounded', 'pill'
 * @param icon - Optional Phosphor icon slug e.g. 'shield-check-fill'
 * @param uppercase - Uppercase text (default true)
 * @param semanticRole - 'status' (default), 'tag', 'label', 'none'
 */
import { Icon } from '../Icon';
import { Text } from '../Text';
import Heading from '../Heading/Heading.astro';

interface Props {
  label: string;
  /** Colour variant — sets brand tokens for dark mode */
  color?: 'primary' | 'secondary' | 'neutral' | 'success' | 'warning' | 'error' | 'info';
  colorTier?: 'tint' | 'mid' | 'base' | 'emphasis';
  variant?: 'fill' | 'outline' | 'glass' | 'liquid-glass';
  shadow?: 'none' | 'out' | 'drop' | 'in' | 'elevated' | 'glow' | 'glow-intense';
  gradient?: 'primary' | 'secondary' | 'neutral' | 'hero' | 'sunset' | 'red' | 'orange' | 'yellow' | 'teal' | 'blue' | 'purple' | 'pink';
  size?: 'sm' | 'md' | 'lg';
  shape?: 'sharp' | 'subtle' | 'soft' | 'rounded' | 'pill';
  borderWeight?: 'thin' | 'thick';
  borderGradient?: 'primary' | 'secondary' | 'neutral' | 'hero' | 'sunset' | 'red' | 'orange' | 'yellow' | 'teal' | 'blue' | 'purple' | 'pink';
  icon?: string;
  iconWeight?: 'brand' | 'fill' | 'duotone' | 'regular' | 'bold' | 'thin' | 'light';
  iconColor?: 'primary' | 'secondary' | 'neutral' | 'red' | 'orange' | 'yellow' | 'teal' | 'blue' | 'purple' | 'pink';
  animation?: 'spin' | 'bounce' | 'shake' | 'float' | 'drift' | 'slide-up' | 'slide-down' | 'slide-left' | 'slide-right' | 'flip' | 'pulse' | 'ping' | 'pop' | 'squish' | 'heartbeat' | 'rubber-band' | 'fade' | 'blink' | 'flash' | 'glint' | 'shimmer' | 'twinkle' | 'wiggle' | 'swing' | 'rock' | 'nod' | 'attention' | 'celebrate' | 'enter' | 'exit';
  animationTrigger?: 'viewport' | 'autoplay' | 'loop' | 'interval' | 'none';
  fontFamily?: 'heading' | 'body' | 'body-alt' | 'handwriting' | 'mono';
  fontWeight?: 'normal' | 'medium' | 'semibold' | 'bold' | 'extrabold';
  uppercase?: boolean;
  semanticRole?: 'status' | 'tag' | 'label' | 'none';
  /** Render as heading element (h1-h6) instead of span */
  level?: 1 | 2 | 3 | 4 | 5 | 6;
}

const {
  label,
  color = 'primary',
  colorTier,
  variant = 'fill',
  shadow = 'none',
  gradient,
  size = 'md',
  shape = 'soft',
  borderWeight,
  borderGradient,
  icon,
  iconWeight,
  iconColor,
  animation,
  animationTrigger = 'viewport',
  fontFamily,
  fontWeight,
  uppercase = true,
  semanticRole = 'status',
  level,
} = Astro.props;

---

<span
  data-semantic-role={semanticRole !== 'none' ? semanticRole : undefined}
  class:list={[
    'badge',
    `badge--${color}`,
    colorTier && colorTier !== 'base' && `badge--tier-${colorTier}`,
    `badge--${variant}`,
    shadow !== 'none' && `badge--shadow-${shadow}`,
    gradient && `badge--gradient-${gradient}`,
    size !== 'md' && `badge--${size}`,
    `badge--${shape}`,
    borderWeight && `badge--border-${borderWeight}`,
    borderGradient && `badge--border-gradient badge--border-gradient-${borderGradient}`,
    level && 'badge--heading',
    icon && 'badge--has-icon',
    !uppercase && 'badge--lowercase',
  ]}
>
  {icon ? (
    <Icon name={icon} weight={iconWeight !== 'brand' ? iconWeight : undefined} color={iconColor} gradient={variant !== 'fill' ? gradient : undefined} animation={animation} animationTrigger={animationTrigger} class="badge__icon" aria-hidden="true" />
  ) : null}
  {level ? (
    <Heading level={level} flush family={fontFamily} weight={fontWeight !== 'bold' ? fontWeight : undefined} class="badge__label">{label}</Heading>
  ) : (
    <Text as="span" class="badge__label" flush family={fontFamily !== 'heading' ? fontFamily : undefined} weight={fontWeight !== 'bold' ? fontWeight : undefined}>{label}</Text>
  )}
</span>
