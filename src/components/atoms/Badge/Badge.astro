---
/**
 * Badge — Simple inline label
 *
 * Token system: --_badge-bg / --_badge-text / --_badge-border
 * Colour set by JSON pipeline via inline style.
 *
 * @param label - Display text
 * @param variant - 'fill' (default), 'outline', 'glass'
 * @param size - 'sm', 'md' (default), 'lg'
 * @param shape - 'sharp', 'subtle', 'soft' (default), 'rounded', 'pill'
 * @param icon - Optional Phosphor icon slug e.g. 'shield-check-fill'
 * @param uppercase - Uppercase text (default true)
 * @param semanticRole - 'status' (default), 'tag', 'label', 'none'
 */
import { Icon } from '../Icon';
import { LottieIcon } from '../LottieIcon';
import { Text } from '../Text';
import Heading from '../Heading/Heading.astro';

interface Props {
  label: string;
  /** Colour variant — sets brand tokens for dark mode */
  color?: 'primary' | 'secondary' | 'neutral' | 'success' | 'warning' | 'error' | 'info';
  variant?: 'fill' | 'outline' | 'glass';
  shadow?: 'none' | 'out' | 'in';
  size?: 'sm' | 'md' | 'lg';
  shape?: 'sharp' | 'subtle' | 'soft' | 'rounded' | 'pill';
  borderWeight?: 'thin' | 'thick';
  icon?: string;
  lottieIcon?: string;
  lottieTrigger?: 'autoplay' | 'loop' | 'hover' | 'viewport' | 'interval' | 'none';
  uppercase?: boolean;
  semanticRole?: 'status' | 'tag' | 'label' | 'none';
  /** Render as heading element (h1-h6) instead of span */
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  class?: string;
}

const {
  label,
  color = 'primary',
  variant = 'fill',
  shadow = 'out',
  size = 'md',
  shape = 'soft',
  borderWeight,
  icon,
  lottieIcon,
  lottieTrigger = 'none',
  uppercase = true,
  semanticRole = 'status',
  level,
  class: className,
} = Astro.props;

---

<span
  data-semantic-role={semanticRole !== 'none' ? semanticRole : undefined}
  class:list={[
    'badge',
    `badge--${color}`,
    `badge--${variant}`,
    `badge--shadow-${shadow}`,
    size !== 'md' && `badge--${size}`,
    `badge--${shape}`,
    borderWeight && `badge--border-${borderWeight}`,
    level && 'badge--heading',
    (icon || lottieIcon) && 'badge--has-icon',
    !uppercase && 'badge--lowercase',
    className,
  ]}
>
  {lottieIcon ? (
    <LottieIcon slug={lottieIcon} trigger={lottieTrigger} fallbackIcon={icon} class="badge__icon" aria-hidden="true" />
  ) : icon ? (
    <Icon name={icon} class="badge__icon" aria-hidden="true" />
  ) : null}
  {level ? (
    <Heading level={level} flush class="badge__label">{label}</Heading>
  ) : (
    <Text as="span" class="badge__label" flush>{label}</Text>
  )}
</span>
