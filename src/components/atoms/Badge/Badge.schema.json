{
  "component": "Badge",
  "category": "atom",
  "renders": { "full": "Badge.astro", "reduced": "Badge.astro", "assistive": "Badge.astro", "textonly": "Badge.astro" },
  "notes": "Simple inline label. Colour set by JSON pipeline via --badge-bg/text/border tokens. Non-interactive — no animation, no hover.",

  "props": {
    "content": {
      "_description": "What the badge communicates",
      "label":     { "type": "string",  "required": true, "description": "Display text." },
      "icon":      { "type": "string",  "required": false, "textonly": false, "description": "Phosphor icon slug. Decorative (aria-hidden). Stripped in textonly render." }
    },

    "visual": {
      "_description": "How the badge looks",
      "variant":      { "type": "string",  "required": false, "default": "fill", "enum": ["fill", "outline", "glass"], "description": "Fill style." },
      "size":         { "type": "string",  "required": false, "default": "md", "enum": ["sm", "md", "lg"], "description": "Size scale. md is the default." },
      "shape":        { "type": "string",  "required": false, "default": "rounded", "enum": ["rounded", "pill", "squared"], "description": "Border radius style." },
      "uppercase":    { "type": "boolean", "required": false, "default": true, "description": "Uppercase text transform." },
      "semanticRole": { "type": "string",  "required": false, "default": "status", "enum": ["status", "tag", "label", "none"], "description": "Semantic role for the badge. Controls data-semantic-role attribute." },
      "class":        { "type": "string",  "required": false, "default": "", "description": "Additional CSS classes." }
    },

    "colour": {
      "_description": "Colour tokens — passed as inline style by pipeline",
      "bg":     { "type": "token", "required": false, "default": "primary-200", "description": "Badge background colour." },
      "text":   { "type": "token", "required": false, "default": "auto", "description": "Badge text colour. Auto = pipeline computes contrast." },
      "border": { "type": "token", "required": false, "default": "primary-400", "description": "Badge border colour (outline variant)." }
    },

    "animation": {}
  }
}
