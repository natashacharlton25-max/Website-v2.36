{
  "component": "Badge",
  "category": "atom",
  "renders": { "full": "Badge.astro", "reduced": "Badge.astro", "textonly": "Badge.astro" },
  "notes": "Simple inline label. Colour via class enum. Icon is base name only — weight resolved from brand config or explicit iconWeight.",

  "props": {
    "content": {
      "label": { "type": "string", "required": true }
    },

    "colour": {
      "brandColor": { "type": "string", "default": "primary", "enum": ["primary", "secondary", "neutral"] }
    },

    "rainbow": {
      "rainbowColor": { "type": "string", "enum": ["red", "orange", "yellow", "teal", "blue", "purple", "pink"] },
      "colorTier":    { "type": "string", "default": "base", "enum": ["tint", "mid", "base", "emphasis"] }
    },

    "gradient": {
      "gradient":          { "type": "boolean", "default": false },
      "gradientBlend":     { "type": "string", "enum": ["hero", "sunset", "brand-emerge", "brand-fade", "emerge", "fade", "preset-tint", "preset-mid", "preset-base", "preset-emphasis"] },
      "gradientDirection": { "type": "string", "default": "diagonal", "enum": ["vertical", "vertical-reverse", "horizontal", "horizontal-reverse", "diagonal", "diagonal-reverse", "diagonal-alt", "diagonal-alt-reverse"] },
      "gradientSpread":    { "type": "string", "default": "balanced", "enum": ["soft", "balanced", "tight"] }
    },

    "typography": {
      "fontFamily": { "type": "string", "default": "heading", "enum": ["heading", "body", "body-alt", "handwriting", "mono"] },
      "fontWeight": { "type": "string", "default": "bold", "enum": ["normal", "medium", "semibold", "bold", "extrabold"] },
      "uppercase":  { "type": "boolean", "default": true }
    },

    "media": {
      "media": { "type": "object", "textonly": false, "_description": "Component node: { component: 'Icon'|'LottieIcon', ...atomProps }. Validated by the child atom's own schema." }
    },

    "visual": {
      "variant":      { "type": "string", "default": "fill", "enum": ["fill", "outline", "glass", "liquid-glass"] },
      "shape":        { "type": "string", "default": "soft", "enum": ["sharp", "subtle", "soft", "rounded", "pill"] },
      "size":         { "type": "string", "default": "md", "enum": ["sm", "md", "lg"] },
      "shadow":       { "type": "string", "default": "none", "enum": ["none", "out", "drop", "in", "elevated", "glow", "glow-intense", "glow-inner"] },
      "borderWeight": { "type": "string", "default": "thin", "enum": ["thin", "thick"] },
      "semanticRole": { "type": "string", "default": "status", "enum": ["status", "tag", "label", "none"] },
      "level":        { "type": "number", "enum": [1, 2, 3, 4, 5, 6] }
    },

    "animation": {
      "animatedGradient": { "type": "boolean", "default": false }
    }
  },

  "pipelineRules": {
    "altTextRule": {
      "action": "append-to-adjacent-image",
      "field": "label",
      "description": "When Badge is a sibling of Image inside any container, Badge.label is appended to Image.altWord by the pipeline."
    }
  }
}
