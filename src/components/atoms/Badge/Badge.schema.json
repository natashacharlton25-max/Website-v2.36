{
  "component": "Badge",
  "category": "atom",
  "renders": { "full": "Badge.astro", "reduced": "Badge.astro", "textonly": "Badge.astro" },
  "notes": "Simple inline label. Colour via .color--{name} mixin. Icon props passed inside media object. Label renders via Text atom (default) or Heading atom (when level set or gradient text needed).",

  "props": {
    "content": {
      "contentBadge": { "type": "string", "required": true, "description": "Badge display text. Pipeline content key." }
    },

    "colour": {
      "brandColor": { "type": "string", "default": "primary", "enum": ["primary", "secondary", "neutral"] }
    },

    "rainbow": {
      "rainbowColor": { "type": "string", "enum": ["rainbow-1", "rainbow-2", "rainbow-3", "rainbow-4", "rainbow-5", "rainbow-6", "rainbow-7"] },
      "colorTier":    { "type": "string", "default": "base", "enum": ["tint", "mid", "base", "emphasis"] }
    },

    "gradient": {
      "gradient":          { "type": "boolean", "default": false },
      "gradientBlend":     { "type": "string", "enum": ["hero", "sunset", "brand-emerge", "brand-fade", "preset-tint", "preset-mid", "preset-base", "preset-emphasis", "primary", "secondary", "neutral", "red", "orange", "yellow", "teal", "blue", "purple", "pink", "rainbow"] },
      "gradientDirection": { "type": "string", "default": "diagonal", "enum": ["vertical", "vertical-reverse", "horizontal", "horizontal-reverse", "diagonal", "diagonal-reverse", "diagonal-alt", "diagonal-alt-reverse"] },
      "gradientEmerge":    { "type": "boolean", "default": false, "_description": "Fade-in modifier — first 50% transparent, fades to solid. Combines with any gradient or solid colour." },
      "gradientFade":      { "type": "boolean", "default": false, "_description": "Fade-out modifier — last 20% fades to transparent. Combines with any gradient or solid colour." },
      "gradientFlip":      { "type": "boolean", "default": false, "_description": "Reverse gradient direction on text. Outline/glass: always available. Fill: only with emerge/fade." }
    },

    "typography": {
      "fontFamily": { "type": "string", "enum": ["heading", "body", "body-alt", "handwriting", "mono"], "_description": "Default: body via Text atom. When 'heading' is set, Text uses heading font. When level is set, Heading atom handles it." },
      "fontWeight": { "type": "string", "default": "bold", "enum": ["normal", "medium", "semibold", "bold", "extrabold"] },
      "uppercase":  { "type": "boolean", "default": true }
    },

    "media": {
      "media": {
        "type": "object",
        "textonly": false,
        "_description": "Nested atom node. Badge is the container — the child atom owns its own props (colour, weight, animation).",
        "properties": {
          "component":    { "type": "string", "required": true, "enum": ["Icon", "LottieIcon"] },
          "semanticRole": { "type": "string", "required": true, "default": "decorative", "enum": ["decorative", "ui-control", "content-symbol"] }
        }
      }
    },

    "visual": {
      "variant":      { "type": "string", "default": "fill", "enum": ["fill", "outline", "glass", "liquid-glass"] },
      "shape":        { "type": "string", "default": "soft", "enum": ["sharp", "subtle", "soft", "rounded"] },
      "size":         { "type": "string", "default": "md", "enum": ["sm", "md", "lg", "xl"] },
      "shadow":       { "type": "string", "default": "none", "enum": ["none", "out", "drop", "in", "elevated", "glow", "glow-intense", "glow-inner"] },
      "borderWeight": { "type": "string", "default": "thin", "enum": ["thin", "thick"] },
      "semanticRole": { "type": "string", "default": "status", "enum": ["status", "tag", "label", "none"] },
      "level":        { "type": "number", "enum": [1, 2, 3, 4, 5, 6] }
    },

    "animation": {
      "animatedGradient":          { "type": "boolean", "default": false },
      "gradientAnimateDirection":  { "type": "string", "default": "cw", "enum": ["cw", "ccw", "sway"], "_description": "Animation direction — clockwise, counter-clockwise, or sway." },
      "gradientAnimateSpeed":      { "type": "string", "default": "default", "enum": ["slow", "default", "fast"], "_description": "Animation speed — slow (20s), default (12s), fast (6s). Gated by motion settings." },
      "gradientCycle":             { "type": "boolean", "default": false, "_description": "Colour cycle — cross-fades through the element's own tier tokens (tint→mid→base→emphasis)." }
    }
  },

  "pipelineRules": {
    "altTextRule": {
      "action": "append-to-adjacent-image",
      "field": "contentBadge",
      "description": "When Badge is a sibling of Image inside any container, Badge.contentBadge is appended to Image.altWord by the pipeline."
    }
  }
}
