{
  "component": "Badge",
  "category": "atom",
  "renders": { "full": "Badge.astro", "reduced": "Badge.astro", "textonly": "Badge.astro" },
  "notes": "Simple inline label. Colour via class enum. Assistive rules in assistive-gate.css. Icon is base name only — weight resolved from brand config or explicit iconWeight enum.",

  "props": {
    "content": {
      "label":     { "type": "string", "required": true },
      "icon":      { "type": "string", "textonly": false }
    },

    "visual": {
      "variant":      { "type": "string", "default": "fill", "enum": ["fill", "outline", "glass", "liquid-glass"] },
      "color":        { "type": "string", "default": "default", "enum": ["default", "primary", "secondary", "neutral", "red", "orange", "yellow", "teal", "blue", "purple", "pink"] },
      "colorTier":    { "type": "string", "default": "base", "enum": ["tint", "mid", "base", "emphasis"] },
      "shadow":       { "type": "string", "default": "none", "enum": ["none", "out", "drop", "in", "elevated", "glow", "glow-intense"] },
      "gradient":     { "type": "string", "enum": ["primary", "secondary", "neutral", "primary-soft", "primary-light", "secondary-soft", "hero", "sunset", "brand-emerge", "brand-fade", "red", "orange", "yellow", "teal", "blue", "purple", "pink", "red-wash", "orange-wash", "yellow-wash", "teal-wash", "blue-wash", "purple-wash", "pink-wash", "red-light", "orange-light", "yellow-light", "teal-light", "blue-light", "purple-light", "pink-light", "red-dark", "orange-dark", "yellow-dark", "teal-dark", "blue-dark", "purple-dark", "pink-dark", "red-deep", "orange-deep", "yellow-deep", "teal-deep", "blue-deep", "purple-deep", "pink-deep"] },
      "size":         { "type": "string", "default": "md", "enum": ["sm", "md", "lg"] },
      "shape":        { "type": "string", "default": "soft", "enum": ["sharp", "subtle", "soft", "rounded", "pill"] },
      "borderWeight":   { "type": "string", "default": "thin", "enum": ["thin", "thick"] },
      "borderGradient": { "type": "string", "enum": ["primary", "secondary", "neutral", "hero", "sunset", "red", "orange", "yellow", "teal", "blue", "purple", "pink"] },
      "fontFamily":   { "type": "string", "default": "heading", "enum": ["heading", "body", "body-alt", "handwriting", "mono"] },
      "fontWeight":   { "type": "string", "default": "bold", "enum": ["normal", "medium", "semibold", "bold", "extrabold"] },
      "uppercase":    { "type": "boolean", "default": true },
      "iconWeight":   { "type": "string", "default": "brand", "enum": ["brand", "fill", "duotone", "regular", "bold", "thin", "light"] },
      "iconColor":    { "type": "string", "default": "default", "enum": ["default", "primary", "secondary", "neutral", "red", "orange", "yellow", "teal", "blue", "purple", "pink"] },
      "semanticRole": { "type": "string", "default": "status", "enum": ["status", "tag", "label", "none"] }
    },

    "animation": {
      "animation":        { "type": "string", "enum": ["spin","bounce","shake","float","drift","slide-up","slide-down","slide-left","slide-right","flip","pulse","ping","pop","squish","heartbeat","rubber-band","fade","blink","flash","glint","shimmer","twinkle","wiggle","swing","rock","nod","attention","celebrate","enter","exit"] },
      "animationTrigger": { "type": "string", "default": "viewport", "enum": ["viewport","autoplay","loop","interval","none"] }
    },

    "colour": {}
  },

  "pipelineRules": {
    "altTextRule": {
      "action": "append-to-adjacent-image",
      "field": "label",
      "description": "When Badge is a sibling of Image inside any container, Badge.label is appended to Image.altWord by the pipeline."
    }
  }
}
