{
  "component": "Text",
  "category": "atom",
  "renders": { "full": "Text.astro", "reduced": "Text.astro", "assistive": "Text.astro", "textonly": "Text.astro" },
  "notes": "Single source of truth for all body text typography. Other components (Badge, Button, Link, List) use .text as their base class.",

  "props": {
    "content": {
      "_description": "What the text communicates",
      "as":    { "type": "string", "required": false, "default": "p", "enum": ["p","span","div","small","strong","em","figcaption","blockquote"], "description": "Semantic HTML element." }
    },

    "visual": {
      "_description": "How the text looks",
      "size":      { "type": "string",  "required": false, "default": null, "enum": ["xs","sm","base","lg","xl"], "description": "Font size scale." },
      "weight":    { "type": "string",  "required": false, "default": null, "enum": ["light","normal","medium","semibold","bold","extrabold"], "description": "Font weight." },
      "leading":   { "type": "string",  "required": false, "default": null, "enum": ["tight","snug","normal","relaxed"], "description": "Line height." },
      "color":     { "type": "string",  "required": false, "default": null, "enum": ["text","text-light","primary","secondary","neutral","inherit"], "description": "Text colour." },
      "family":    { "type": "string",  "required": false, "default": null, "enum": ["body","body-alt","handwriting","mono"], "description": "Font family." },
      "align":     { "type": "string",  "required": false, "default": null, "enum": ["left","center","right"], "description": "Text alignment." },
      "uppercase": { "type": "boolean", "required": false, "default": false, "description": "Uppercase text transform." },
      "clamp":     { "type": "number",  "required": false, "default": null, "description": "Line clamp count." },
      "flush":     { "type": "boolean", "required": false, "default": false, "description": "Remove bottom margin." },
      "class":     { "type": "string",  "required": false, "default": "", "description": "Additional CSS classes." }
    },

    "animation": {}
  },

  "slots": {
    "default": "Text content"
  }
}
