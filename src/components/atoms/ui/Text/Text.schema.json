{
  "component": "Text",
  "category": "atoms/ui",
  "renders": { "base": "Text.astro" },
  "notes": "Single source of truth for all body text typography. Other components (Badge, Button, Link, List) use .text as their base class.",
  "props": {
    "as":        { "type": "string", "enum": ["p","span","div","small","strong","em","figcaption","blockquote"], "default": "p" },
    "size":      { "type": "string", "enum": ["xs","sm","base","lg","xl"], "default": null },
    "weight":    { "type": "string", "enum": ["light","normal","medium","semibold","bold","extrabold"], "default": null },
    "leading":   { "type": "string", "enum": ["tight","snug","normal","relaxed"], "default": null },
    "color":     { "type": "string", "enum": ["text","text-light","primary","secondary","neutral","inherit"], "default": null },
    "family":    { "type": "string", "enum": ["body","body-alt","handwriting","mono"], "default": null },
    "align":     { "type": "string", "enum": ["left","center","right"], "default": null },
    "uppercase": { "type": "boolean", "default": false },
    "clamp":     { "type": "number", "default": null },
    "flush":     { "type": "boolean", "default": false },
    "class":     { "type": "string" }
  },
  "slots": {
    "default": "Text content"
  }
}
