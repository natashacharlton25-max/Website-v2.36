{
  "component": "Heading",
  "category": "atoms/ui",
  "renders": { "base": "Heading.astro" },
  "notes": "Every heading on the site should go through this component. Heading.css is the single source of truth for all heading typography. Components that use headings (cards, sections) inherit from .heading and add context-specific overrides.",
  "reducedMotion": "Divider/underline transitions killed on heading-wrap.",
  "props": {
    "level":          { "type": "number", "enum": [1,2,3,4,5,6], "required": true },
    "size":           { "type": "string", "enum": ["h1","h2","h3","h4","h5","h6"], "default": "matches level" },
    "weight":         { "type": "string", "enum": ["normal","medium","semibold","bold","extrabold"], "default": null },
    "color":          { "type": "string", "enum": ["primary","primary-dark","secondary","text","text-light","neutral","inherit"], "default": null },
    "family":         { "type": "string", "enum": ["heading","body","mono"], "default": null },
    "align":          { "type": "string", "enum": ["left","center","right"], "default": null },
    "uppercase":      { "type": "boolean", "default": false },
    "tracking":       { "type": "string", "enum": ["normal","wide","wider"], "default": null },
    "flush":          { "type": "boolean", "default": false },
    "subtitle":       { "type": "string", "default": null },
    "divider":        { "type": "string", "enum": ["left","right","both","none"], "default": null },
    "dividerColor":   { "type": "string", "enum": ["primary","secondary","text","neutral","gradient"], "default": "primary" },
    "dividerStyle":   { "type": "string", "enum": ["solid","dashed","dotted"], "default": "solid" },
    "dividerEnds":    { "type": "string", "enum": ["rounded","square"], "default": "rounded" },
    "dividerLength":  { "type": "string", "enum": ["auto","xs","sm","md","lg","xl"], "default": "auto" },
    "variant":        { "type": "string", "enum": ["default","underline","badge","highlight","minimal"], "default": "default" },
    "underlineStyle": { "type": "string", "enum": ["solid","gradient","dashed"], "default": "solid" },
    "badgeColor":     { "type": "string", "enum": ["primary","secondary","neutral"], "default": "primary" },
    "highlightColor": { "type": "string", "enum": ["primary","secondary","neutral"], "default": "primary" },
    "image":          { "type": "string", "default": null },
    "icon":           { "type": "string", "default": null },
    "mediaPosition":  { "type": "string", "enum": ["left","right"], "default": "left" },
    "mediaSize":      { "type": "string", "enum": ["sm","md","lg","auto"], "default": "auto" },
    "iconColor":      { "type": "string", "enum": ["primary","secondary","neutral","text"], "default": "text" },
    "iconStyle":      { "type": "string", "enum": ["contained","bare"], "default": "contained" },
    "spacing":        { "type": "string", "enum": ["tight","normal","loose"], "default": "normal" },
    "class":          { "type": "string" }
  },
  "slots": {
    "default": "Heading text content"
  }
}
