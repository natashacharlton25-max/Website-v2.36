---
/**
 * Badge — Simple inline label
 *
 * Token system: --_badge-bg / --_badge-text / --_badge-border
 * Zone colour tokens give a rich palette across all themes.
 *
 * @param label - Display text
 * @param color - 'primary' (default), 'secondary', 'earth', 'forest', 'dusk', 'neutral', 'mist'
 * @param variant - 'fill' (default), 'outline', 'glass', 'glass-light', 'glass-dark'
 * @param shape - 'rounded' (default), 'pill', 'squared'
 * @param icon - Optional Phosphor icon name e.g. 'shield-check-fill'
 * @param iconCollection - Icon folder: 'badges' (default)
 * @param uppercase - Uppercase text (default true)
 */
// TODO: update to barrel import once Icon/D1 built
import Icon from '../../icons/Icon/Icon.astro';

interface Props {
  label: string;
  color?: 'primary' | 'secondary' | 'earth' | 'forest' | 'dusk' | 'neutral' | 'mist';
  variant?: 'fill' | 'outline' | 'glass' | 'glass-light' | 'glass-dark';
  shape?: 'rounded' | 'pill' | 'squared';
  icon?: string;
  iconCollection?: string;
  uppercase?: boolean;
  class?: string;
}

const {
  label,
  color = 'primary',
  variant = 'fill',
  shape = 'rounded',
  icon,
  iconCollection = 'badges',
  uppercase = true,
  class: className,
} = Astro.props;
---

<span
  class:list={[
    'text',       /* base typography from Text atom — sets font, color, line-height */
    'badge',
    `badge--${variant}`,
    `badge--${shape}`,
    color !== 'primary' && `badge--c-${color}`,
    icon && 'badge--has-icon',
    !uppercase && 'badge--lowercase',
    className,
  ]}
>
  {icon && (
    <Icon name={`${iconCollection}/${icon}`} class="badge__icon" aria-hidden="true" />
  )}
  <span class="badge__label">{label}</span>
</span>
