{
  "component": "Badge",
  "category": "atoms/ui",
  "renders": { "full": "Badge.astro", "reduced": "Badge.astro", "textonly": "Badge.astro" },
  "notes": "Extends .text class from Text atom for base typography defaults. Zone colour tokens for palette.",

  "props": {
    "content": {
      "_description": "What the badge communicates",
      "label":     { "type": "string",  "required": true, "description": "Display text." },
      "icon":      { "type": "string",  "required": false, "textonly": false, "description": "Phosphor icon slug. Decorative (aria-hidden). Stripped in textonly render." }
    },

    "visual": {
      "_description": "How the badge looks",
      "color":     { "type": "string",  "required": false, "default": "primary", "enum": ["primary", "secondary", "earth", "forest", "dusk", "neutral", "mist"], "description": "Zone colour palette." },
      "variant":   { "type": "string",  "required": false, "default": "fill", "enum": ["fill", "outline", "glass", "glass-light", "glass-dark"], "description": "Fill style." },
      "shape":     { "type": "string",  "required": false, "default": "rounded", "enum": ["rounded", "pill", "squared"], "description": "Border radius style." },
      "uppercase": { "type": "boolean", "required": false, "default": true, "description": "Uppercase text transform." },
      "class":     { "type": "string",  "required": false, "default": "", "description": "Additional CSS classes." }
    },

    "animation": {}
  }
}
