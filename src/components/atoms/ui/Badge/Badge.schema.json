{
  "component": "Badge",
  "category": "atoms/ui",
  "renders": { "base": "Badge.astro" },
  "notes": "Extends .text class from Text atom for base typography defaults.",
  "props": {
    "label":          { "type": "string",  "required": true },
    "color":          { "type": "string",  "required": false, "default": "primary", "enum": ["primary", "secondary", "earth", "forest", "dusk", "neutral", "mist"] },
    "variant":        { "type": "string",  "required": false, "default": "fill", "enum": ["fill", "outline", "glass", "glass-light", "glass-dark"] },
    "shape":          { "type": "string",  "required": false, "default": "rounded", "enum": ["rounded", "pill", "squared"] },
    "icon":           { "type": "string",  "required": false },
    "iconCollection": { "type": "string",  "required": false, "default": "badges" },
    "uppercase":      { "type": "boolean", "required": false, "default": true },
    "class":          { "type": "string",  "required": false, "default": "" }
  }
}
