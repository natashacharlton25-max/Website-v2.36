{
  "component": "Link",
  "category": "atoms/ui",
  "renders": { "base": "Link.astro" },
  "notes": "Extends .text class from Text atom for base typography defaults. Central definition for link a11y — bare <a> components (GlassNav, Breadcrumbs) need their own a11y rules.",
  "reducedMotion": "All transitions killed. Underline animation disabled. Glass backdrop immediate.",
  "props": {
    "href":      { "type": "string", "required": true },
    "variant":   { "type": "string", "enum": ["default","underline","glass","ghost"], "default": "default" },
    "color":     { "type": "string", "enum": ["primary","primary-dark","secondary","text","text-light","inherit"], "default": null },
    "weight":    { "type": "string", "enum": ["normal","medium","semibold","bold","extrabold"], "default": null },
    "uppercase": { "type": "boolean", "default": false },
    "flush":     { "type": "boolean", "default": false },
    "external":  { "type": "boolean", "default": false },
    "target":    { "type": "string", "default": null },
    "download":  { "type": ["string","boolean"], "default": null },
    "rel":       { "type": "string", "default": null },
    "id":        { "type": "string", "default": null },
    "role":      { "type": "string", "default": null },
    "ariaLabel": { "type": "string", "default": null },
    "class":     { "type": "string" }
  },
  "slots": {
    "default": "Link text content"
  }
}
