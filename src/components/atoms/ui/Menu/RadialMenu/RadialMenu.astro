---
/**
 * RadialMenu — Circular hamburger with radial fan-out
 *
 * Pure CSS checkbox hack — no JavaScript required.
 * Items fan out in a circle when toggled.
 *
 * @param items   - Array of { icon, href?, ariaLabel? }
 * @param variant - 'primary' (default), 'secondary', 'neutral'
 */
import Icon from '../../../icons/Icon/Icon.astro';

export interface RadialMenuItem {
  icon: string;
  href?: string;
  ariaLabel?: string;
}

export interface Props {
  items: RadialMenuItem[];
  variant?: 'primary' | 'secondary' | 'neutral';
}

const {
  items = [],
  variant = 'primary',
} = Astro.props;

const uid = `radial-${Math.random().toString(36).slice(2, 8)}`;
const radius = 105;

const positions = items.map((_, i) => {
  const angle = (2 * Math.PI / items.length) * i - Math.PI / 2;
  return {
    x: Math.round(radius * Math.cos(angle) * 100) / 100,
    y: Math.round(radius * Math.sin(angle) * 100) / 100,
    delay: 180 + i * 100,
  };
});
---

<nav class={`radial-menu radial-menu--${variant}`}>
  <input type="checkbox" class="radial-menu__toggle" id={uid} />
  <label class="radial-menu__trigger" for={uid}>
    <span class="radial-menu__line"></span>
    <span class="radial-menu__line"></span>
    <span class="radial-menu__line"></span>
  </label>

  {items.map((item, i) => (
    <a
      href={item.href || '#'}
      class="radial-menu__item"
      aria-label={item.ariaLabel || item.icon}
      style={`--_x: ${positions[i].x}px; --_y: ${positions[i].y}px; --_delay: ${positions[i].delay}ms;`}
    >
      <Icon name={item.icon} size={26} />
    </a>
  ))}
</nav>

