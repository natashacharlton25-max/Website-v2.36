---
/**
 * Button — Unified button component
 *
 * Handles: links, buttons, dropdowns, confetti effects, hover effects.
 * Uses brand tokens for all colours. Icon component for icons.
 *
 * @param variant   - 'primary' (default), 'secondary', 'neutral', 'outline', 'ghost', 'glass', 'neumorphic'
 * @param shape     - 'rounded' (default), 'pill', 'circle', 'square', 'sharp', 'dropdown'
 * @param size      - 'sm', 'md' (default), 'lg'
 * @param effect    - 'glint' (default), 'colour-flow', 'colour-flow-left', 'colour-flow-reverse', 'tray-3d', 'rainbow-border', 'glow', 'none'
 * @param speed     - 'slow', 'normal' (default), 'fast' — controls effect transition speed
 * @param icon      - Phosphor icon name e.g. 'star-fill'
 * @param iconPosition - 'left' (default) or 'right'
 * @param iconCollection - Icon folder: 'ui' (default)
 * @param href      - Makes it an <a> tag
 * @param target    - Link target
 * @param download  - Download attribute
 * @param type      - Button type: 'button', 'submit', 'reset'
 * @param disabled  - Disabled state
 * @param id        - Element ID
 * @param ariaLabel - Accessible label
 * @param confetti  - Particle effect: 'confetti', 'hearts', 'celebration', 'mixed'
 * @param confettiTrigger - 'click' (default) or 'hover'
 * @param confettiCount   - Particle count (default 30)
 * @param confettiSpread  - Particle spread (default 150)
 * @param dropdownItems   - Array of {label, href?, value?, fontFamily?} for dropdown mode
 */
import Icon from '../../icons/Icon.astro';

export interface DropdownItem {
  label: string;
  value?: string;
  href?: string;
  fontFamily?: string;
}

export interface Props {
  variant?: 'primary' | 'secondary' | 'neutral' | 'outline' | 'ghost' | 'glass' | 'neumorphic';
  shape?: 'rounded' | 'pill' | 'circle' | 'square' | 'sharp' | 'dropdown';
  size?: 'sm' | 'md' | 'lg';
  effect?: 'glint' | 'colour-flow' | 'colour-flow-left' | 'colour-flow-reverse' | 'tray-3d' | 'rainbow-border' | 'glow' | 'none';
  speed?: 'slow' | 'normal' | 'fast';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  id?: string;
  href?: string;
  target?: string;
  download?: string | boolean;
  icon?: string;
  iconPosition?: 'left' | 'right';
  iconCollection?: string;
  ariaLabel?: string;
  confetti?: 'confetti' | 'hearts' | 'celebration' | 'mixed';
  confettiTrigger?: 'click' | 'hover';
  confettiCount?: number;
  confettiSpread?: number;
  dropdownItems?: DropdownItem[];
  className?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  variant = 'primary',
  shape = 'rounded',
  size = 'md',
  effect = 'glint',
  speed = 'normal',
  type = 'button',
  disabled = false,
  id,
  href,
  target,
  download,
  icon,
  iconPosition = 'left',
  iconCollection = 'ui',
  ariaLabel,
  confetti,
  confettiTrigger = 'click',
  confettiCount = 30,
  confettiSpread = 150,
  dropdownItems = [],
  className = '',
  ...rest
} = Astro.props;

// Extract data-* attributes
const dataAttrs = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key.startsWith('data-'))
);

const isLink = !!href;
const isDropdown = shape === 'dropdown';
const hasIcon = !!icon;
const isIconOnly = hasIcon && (shape === 'circle' || shape === 'square');
const needsWrapper = effect === 'rainbow-border';

// Icon sizes per button size
const iconSizes: Record<string, number> = { sm: 16, md: 18, lg: 22 };
const iconSize = iconSizes[size] || 18;

// Build classes
const classes = [
  'text',
  'btn',
  `btn--${variant}`,
  `btn--${shape}`,
  size !== 'md' && `btn--${size}`,
  effect !== 'glint' && `btn--fx-${effect}`,
  speed !== 'normal' && `btn--speed-${speed}`,
  hasIcon && `btn--icon-${iconPosition}`,
  isIconOnly && 'btn--icon-only',
  confetti && 'btn--confetti',
  confetti === 'hearts' && 'btn--confetti-hearts',
  confetti === 'celebration' && 'btn--confetti-celebration',
  className,
].filter(Boolean);

// Confetti data attributes
const confettiAttrs = confetti ? {
  'data-particle-burst': '',
  'data-particle-type': confetti === 'celebration' ? 'mixed' : confetti,
  'data-particle-trigger': confettiTrigger,
  'data-particle-count': String(confettiCount),
  'data-particle-spread': String(confettiSpread),
} : {};

// Shared inner content
const iconLeft = iconPosition === 'left' && hasIcon;
const iconRight = iconPosition === 'right' && hasIcon;
---

{isDropdown ? (
  <div class="dropdown-wrapper">
    <button
      class:list={[...classes, 'btn--dropdown', 'dropdown-btn']}
      type={type}
      disabled={disabled}
      id={id}
      aria-label={ariaLabel}
      aria-expanded="false"
      aria-haspopup="true"
      {...dataAttrs}
      {...confettiAttrs}
    >
      {iconLeft && <Icon name={`${iconCollection}/${icon}`} size={iconSize} class="btn__icon" />}
      <slot />
      {iconRight && <Icon name={`${iconCollection}/${icon}`} size={iconSize} class="btn__icon" />}
      <Icon name="ui/caret-down-fill" size={14} class="btn__chevron" />
    </button>

    <div
      class={`dropdown-menu dropdown-theme--${variant}`}
      role="menu"
    >
      {dropdownItems.map((item) => (
        item.href ? (
          <a href={item.href} class="dropdown-item" role="menuitem">{item.label}</a>
        ) : (
          <button
            type="button"
            class="dropdown-item"
            data-value={item.value}
            role="menuitem"
            style={item.fontFamily ? `font-family: ${item.fontFamily};` : undefined}
          >{item.label}</button>
        )
      ))}
    </div>
  </div>
) : needsWrapper ? (
  /* Rainbow-border needs a wrapper for the mask-composite border trick */
  <div class={`btn-rainbow-wrap btn-rainbow-wrap--${shape} ${speed !== 'normal' ? `btn--speed-${speed}` : ''}`}>
    {isLink ? (
      <a
        href={href}
        target={target}
        download={download}
        class:list={classes}
        id={id}
        aria-disabled={disabled}
        aria-label={ariaLabel}
        {...dataAttrs}
        {...confettiAttrs}
      >
        {iconLeft && <Icon name={`${iconCollection}/${icon}`} size={iconSize} class="btn__icon" />}
        <slot />
        {iconRight && <Icon name={`${iconCollection}/${icon}`} size={iconSize} class="btn__icon" />}
      </a>
    ) : (
      <button
        class:list={classes}
        type={type}
        disabled={disabled}
        id={id}
        aria-label={ariaLabel}
        {...dataAttrs}
        {...confettiAttrs}
      >
        {iconLeft && <Icon name={`${iconCollection}/${icon}`} size={iconSize} class="btn__icon" />}
        <slot />
        {iconRight && <Icon name={`${iconCollection}/${icon}`} size={iconSize} class="btn__icon" />}
      </button>
    )}
  </div>
) : isLink ? (
  <a
    href={href}
    target={target}
    download={download}
    class:list={classes}
    id={id}
    aria-disabled={disabled}
    aria-label={ariaLabel}
    {...dataAttrs}
    {...confettiAttrs}
  >
    {iconLeft && <Icon name={`${iconCollection}/${icon}`} size={iconSize} class="btn__icon" />}
    <slot />
    {iconRight && <Icon name={`${iconCollection}/${icon}`} size={iconSize} class="btn__icon" />}
  </a>
) : (
  <button
    class:list={classes}
    type={type}
    disabled={disabled}
    id={id}
    aria-label={ariaLabel}
    {...dataAttrs}
    {...confettiAttrs}
  >
    {iconLeft && <Icon name={`${iconCollection}/${icon}`} size={iconSize} class="btn__icon" />}
    <slot />
    {iconRight && <Icon name={`${iconCollection}/${icon}`} size={iconSize} class="btn__icon" />}
  </button>
)}

<script>
  // Dropdown toggle
  document.addEventListener('astro:page-load', () => {
    const wrappers = document.querySelectorAll('.dropdown-wrapper');

    wrappers.forEach((wrapper) => {
      const btn = wrapper.querySelector('.dropdown-btn') as HTMLButtonElement;
      const menu = wrapper.querySelector('.dropdown-menu');
      if (!btn || !menu) return;

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = menu.classList.contains('show');

        // Close all others
        document.querySelectorAll('.dropdown-menu.show').forEach(m => {
          m.classList.remove('show');
          m.closest('.dropdown-wrapper')?.querySelector('.dropdown-btn')?.setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          menu.classList.add('show');
          btn.setAttribute('aria-expanded', 'true');
        }
      });

      // Keyboard: Escape closes
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu.classList.contains('show')) {
          menu.classList.remove('show');
          btn.setAttribute('aria-expanded', 'false');
          btn.focus();
        }
      });
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('.dropdown-wrapper')) {
        document.querySelectorAll('.dropdown-menu.show').forEach(m => {
          m.classList.remove('show');
          m.closest('.dropdown-wrapper')?.querySelector('.dropdown-btn')?.setAttribute('aria-expanded', 'false');
        });
      }
    });
  });
</script>

<script>
  // Confetti — lazy init
  document.addEventListener('astro:page-load', async () => {
    const confettiBtns = document.querySelectorAll('[data-particle-burst]');
    if (confettiBtns.length === 0) return;

    const { initParticleBurst } = await import('../../../../lib/animation/particle-burst');
    initParticleBurst();
  });
</script>
