{
  "component": "Button",
  "category": "atoms/ui",
  "notes": "Extends .text class from Text atom. Renders as <button>, <a>, or dropdown wrapper depending on props.",
  "reducedMotion": "All transitions killed. Expand/spot/glow animations disabled. Hover states instant.",
  "renders": { "base": "Button.astro" },
  "slots": { "default": "Button label text" },
  "props": {
    "variant":        { "type": "string",  "required": false, "default": "primary", "enum": ["primary", "secondary", "neutral", "outline", "ghost", "glass", "glow", "neumorphic"] },
    "shape":          { "type": "string",  "required": false, "default": "rounded", "enum": ["rounded", "pill", "circle", "square", "sharp", "dropdown"] },
    "size":           { "type": "string",  "required": false, "default": "md", "enum": ["sm", "md", "lg"] },
    "effect":         { "type": "string",  "required": false, "enum": ["glint", "colour-flow", "jump", "comic", "tech", "expand", "underline", "magnetic", "spotlight", "split"] },
    "speed":          { "type": "string",  "required": false, "enum": ["slow", "normal", "fast"] },
    "alignment":      { "type": "string",  "required": false, "enum": ["left", "center"] },
    "href":           { "type": "string",  "required": false },
    "target":         { "type": "string",  "required": false },
    "download":       { "type": "string",  "required": false },
    "type":           { "type": "string",  "required": false, "default": "button", "enum": ["button", "submit", "reset"] },
    "disabled":       { "type": "boolean", "required": false, "default": false },
    "id":             { "type": "string",  "required": false },
    "icon":           { "type": "string",  "required": false },
    "iconPosition":   { "type": "string",  "required": false, "default": "left", "enum": ["left", "right"] },
    "iconCollection": { "type": "string",  "required": false },
    "iconMorphTo":    { "type": "string",  "required": false },
    "iconMorphColor": { "type": "string",  "required": false },
    "iconDraw":       { "type": "string",  "required": false, "enum": ["draw", "drawcenter", "chachaslide", "flashgordon", "rainbowchase", "pulse"] },
    "iconDrawColor":  { "type": "string",  "required": false },
    "lottieIcon":     { "type": "string",  "required": false },
    "lottieLoop":     { "type": "boolean", "required": false, "default": false },
    "ariaLabel":      { "type": "string",  "required": false },
    "confetti":       { "type": "string",  "required": false, "enum": ["confetti", "hearts", "celebration", "mixed"] },
    "confettiTrigger":{ "type": "string",  "required": false, "default": "click", "enum": ["click", "hover"] },
    "confettiCount":  { "type": "number",  "required": false, "default": 30 },
    "confettiSpread": { "type": "number",  "required": false, "default": 150 },
    "dropdownItems":  { "type": "array",   "required": false, "default": [] },
    "class":          { "type": "string",  "required": false, "default": "" }
  }
}
