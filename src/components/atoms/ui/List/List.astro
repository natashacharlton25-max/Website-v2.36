---
/**
 * List — Atomic list primitive
 *
 * Every list should go through this component.
 * Each <li> uses .text as base class for font-family inheritance.
 * List.css is the single source of truth for list styling.
 *
 * Styles: List.css | List.responsive.css | List.a11y.css
 *
 * Usage:
 *   <List items={['One', 'Two', 'Three']} />
 *   <List as="ol" items={['First', 'Second']} />
 *   <List icon="check-circle-fill" items={['Done', 'Done']} />
 *   <List icon="arrow-right-fill" iconColor="secondary" items={['Go', 'Go']} />
 *   <List variant="dot" items={['Custom dots']} />
 *   <List variant="dot" dotSize="lg" items={['Big dots']} />
 *   <List variant="none" items={['Clean', 'No bullets']} />
 *   <List variant="inline" items={['Tag', 'Tag', 'Tag']} />
 *   <List flush items={['Tight', 'No margin']} />
 *
 *   <!-- Slot for complex content -->
 *   <List>
 *     <li class="text list__item">Complex <strong>content</strong></li>
 *   </List>
 */
// TODO: update to barrel import once Icon/D1 built
import Icon from '../../icons/Icon/Icon.astro';

interface Props {
  as?: 'ul' | 'ol';
  variant?: 'default' | 'none' | 'inline' | 'dot';
  dotSize?: 'sm' | 'md' | 'lg';
  icon?: string;
  iconCollection?: string;
  iconColor?: 'primary' | 'primary-dark' | 'secondary' | 'text' | 'inherit';
  spacing?: 'tight' | 'normal' | 'loose';
  flush?: boolean;
  class?: string;
  items?: string[];
  [key: string]: any;
}

const {
  as: Tag = 'ul',
  variant = 'default',
  dotSize = 'md',
  icon,
  iconCollection = 'interface',
  iconColor = 'primary',
  spacing = 'normal',
  flush = false,
  class: className,
  items,
  ...rest
} = Astro.props;

// Extract data-* attributes
const dataAttrs = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key.startsWith('data-'))
);

const hasIcon = !!icon;

// Icon sizes per dot size
const iconSizes: Record<string, number> = { sm: 14, md: 16, lg: 20 };
const iconSize = iconSizes[dotSize] || 16;

const classes = [
  'list',
  `list--${variant}`,
  hasIcon ? 'list--has-icon' : '',
  variant === 'dot' ? `list--dot-${dotSize}` : '',
  iconColor !== 'primary' ? `list--icon-color-${iconColor}` : '',
  spacing !== 'normal' ? `list--spacing-${spacing}` : '',
  flush ? 'list--flush' : '',
  className,
].filter(Boolean);
---

<Tag class:list={classes} {...dataAttrs}>
  {items ? (
    items.map((item) => (
      <li class="text list__item">
        {hasIcon && (
          <Icon name={`${iconCollection}/${icon}`} size={iconSize} class="list__icon" />
        )}
        {variant === 'dot' && (
          <span class="list__dot" aria-hidden="true"></span>
        )}
        {/* A11y dot — hidden by default, shown in text-only mode to replace icons */}
        {hasIcon && (
          <span class="list__a11y-dot" aria-hidden="true"></span>
        )}
        <span class="list__content">{item}</span>
      </li>
    ))
  ) : (
    <slot />
  )}
</Tag>
