{
  "component": "List",
  "category": "atoms/ui",
  "renders": { "base": "List.astro" },
  "notes": "Each <li> uses .text class from Text atom for base typography defaults. Icon variant includes hidden .list__a11y-dot for text-only mode fallback.",
  "props": {
    "as":             { "type": "string", "enum": ["ul","ol"], "default": "ul" },
    "variant":        { "type": "string", "enum": ["default","none","inline","dot"], "default": "default" },
    "dotSize":        { "type": "string", "enum": ["sm","md","lg"], "default": "md" },
    "icon":           { "type": "string", "default": null },
    "iconCollection": { "type": "string", "default": "interface" },
    "iconColor":      { "type": "string", "enum": ["primary","primary-dark","secondary","text","inherit"], "default": "primary" },
    "spacing":        { "type": "string", "enum": ["tight","normal","loose"], "default": "normal" },
    "flush":          { "type": "boolean", "default": false },
    "class":          { "type": "string" },
    "items":          { "type": "array", "items": { "type": "string" }, "default": null }
  },
  "slots": {
    "default": "Complex list items — use <li class=\"text list__item\"> for each"
  }
}
