{
  "component": "Card",
  "category": "atoms/ui",
  "renders": { "base": "Card.astro" },
  "notes": "Pure container shell — visual chrome only (bg, border, radius, shadow, hover). Children handle their own internal layout. Molecule cards render <Card> as their outer wrapper.",
  "reducedMotion": "Hover lift/border/glow transitions killed. All state changes instant.",
  "props": {
    "as":         { "type": "string", "enum": ["div","article","section","aside","li"], "default": "div" },
    "variant":    { "type": "string", "enum": ["default","transparent","outline","glass","liquid-glass","neumorphic","neumorphic-pressed","comic","tech"], "default": "default" },
    "hover":      { "type": ["boolean","string"], "enum": [true,"border","glow"], "default": null },
    "shadow":     { "type": "string", "enum": ["none","sm","md","lg","xl"], "default": null },
    "dropShadow": { "type": "string", "enum": ["none","sm","md","lg","xl"], "default": null },
    "radius":     { "type": "string", "enum": ["none","sm","md","lg","xl","full"], "default": null },
    "padding":    { "type": "string", "enum": ["none","xs","sm","md","lg","xl","2xl"], "default": null },
    "border":     { "type": "string", "enum": ["none","thin","medium","thick"], "default": null },
    "layout":     { "type": "string", "enum": ["masonry"], "default": null },
    "flush":      { "type": "boolean", "default": false },
    "href":       { "type": "string", "default": null },
    "separator":  { "type": "boolean", "default": false },
    "class":      { "type": "string" }
  },
  "slots": {
    "default": "Card content — use .card__header / .card__body / .card__footer for structure"
  }
}
