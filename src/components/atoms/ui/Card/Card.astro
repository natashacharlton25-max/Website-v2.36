---
/**
 * Card — Atomic container shell
 *
 * Pure container with visual chrome (background, border, radius, shadow).
 * Children handle their own internal layout. Hover is animation — stripped in reduced render.
 *
 * Molecule cards render <Card> as their outer wrapper.
 * Grid handles external layout. Card handles the box itself.
 * In textonly, card becomes transparent bordered box — child atoms handle their own visibility.
 *
 * @param as          - HTML element: div | article | section | aside | li (default: div)
 * @param variant     - Visual style: default | transparent | outline | glass | liquid-glass | neumorphic | neumorphic-pressed | comic | tech
 * @param hover       - Hover effect (animation group): true (lift), 'border', 'glow'. Stripped in reduced/assistive/textonly.
 * @param shadow      - Box shadow: none | sm | md | lg | xl
 * @param dropShadow  - Filter drop-shadow (better for non-rect shapes): none | sm | md | lg | xl
 * @param radius      - Border radius: none | sm | md | lg | xl | full
 * @param padding     - Internal padding: none | xs | sm | md | lg | xl | 2xl
 * @param border      - Border width: none | thin | medium | thick
 * @param layout      - Context: 'masonry' (break-inside:avoid, inline-block, width:100%)
 * @param flush       - Remove margin-bottom
 * @param href        - If set, renders as <a> with .card--link styles
 * @param separator   - Visible border between .card__header / .card__body / .card__footer
 *
 * Use Heading, Text, Badge, Button, Image atoms inside.
 * Structure with .card__header / .card__body / .card__footer.
 *
 * Styles: Card.css | Card.responsive.css
 */

export interface Props {
  as?: 'div' | 'article' | 'section' | 'aside' | 'li';
  variant?: 'default' | 'transparent' | 'outline' | 'glass' | 'liquid-glass' | 'neumorphic' | 'neumorphic-pressed' | 'comic' | 'tech';
  hover?: boolean | 'border' | 'glow';
  shadow?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  dropShadow?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  radius?: 'none' | 'sm' | 'md' | 'lg' | 'xl' | 'full';
  padding?: 'none' | 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  border?: 'none' | 'thin' | 'medium' | 'thick';
  layout?: 'masonry';
  flush?: boolean;
  href?: string;
  separator?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  as = 'div',
  variant = 'default',
  hover,
  shadow,
  dropShadow,
  radius,
  padding,
  border,
  layout,
  flush,
  href,
  separator,
  class: className,
  ...rest
} = Astro.props;

// Determine element: <a> if href provided, otherwise `as` prop
const Tag = href ? 'a' : as;

// Build class list
const classes = [
  'card',
  `card--${variant}`,
  hover === true && 'card--hover-lift',
  hover === 'border' && 'card--hover-border',
  hover === 'glow' && 'card--hover-glow',
  shadow && shadow !== 'none' && `card--shadow-${shadow}`,
  dropShadow && dropShadow !== 'none' && `card--drop-${dropShadow}`,
  radius && `card--radius-${radius}`,
  padding && `card--pad-${padding}`,
  border && border !== 'none' && `card--border-${border}`,
  layout === 'masonry' && 'card--masonry',
  flush && 'card--flush',
  href && 'card--link',
  separator && 'card--separator',
  className,
].filter(Boolean);

// Link attributes
const linkAttrs = href ? {
  href,
  ...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
} : {};
---

<Tag
  class:list={classes}
  data-card
  {...linkAttrs}
  {...rest}
>
  <slot />
</Tag>
