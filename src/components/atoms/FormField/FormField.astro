---
/**
 * FormField — Reusable Form Input Atom
 *
 * Covers: text, email, textarea, checkbox, radio, toggle, search, select,
 *         number, tel, url, password, card-select.
 *
 * The only atom allowed raw <input>, <select>, <textarea> elements.
 * Author-facing text lives in labelForm (primary) + contentForm*
 * sub-content props (Placeholder, Description, Error, Suggestion); all
 * other props are enums/booleans/data per project schema rules.
 *
 * Card-select renders choices as pictogram/text cards. Each option's media
 * slot composes Image OR Icon — child atom owns its own props.
 *
 * Token system: --_field-brand / --_field-brand-dark / --_field-brand-light / --_field-border
 * Colour: brandColor (primary/secondary/neutral) + rainbowColor (rainbow-1..7) + colorTier (tint/mid/base/emphasis)
 *         consumed via the global .color--{name} mixin (src/styles/global/colour.css).
 * High contrast + dark mode: gated by zone data attributes, not component props.
 *
 * WCAG 2.2 AA audit: formfield-wcag-audit-2026-05-14.md (repo root).
 */

import { Text } from '../Text';
import { Image } from '../Image';
import { Icon } from '../Icon';
import { Button } from '../Button';
import type { Shape, InputType, InputMode, AutocompleteToken, BrandColour, RainbowColour, ColourTier } from '../../../lib/shared-enums';

// ── Per-option media slot — Image OR Icon. Child atom owns its own props. ──
type SelectOptionMedia =
  | ({ component: 'Image'; src: string; alt: string } & Record<string, any>)
  | ({ component: 'Icon'; name: string } & Record<string, any>);

interface SelectOption {
  /** Form submission value. */
  value: string;
  /** Primary option text. */
  contentOption: string;
  /** Simplified option text for low-cognitive-level rendering (card-select). Falls back to contentOption. */
  contentOptionSimple?: string;
  /** Helper text below the option (card-select only). */
  contentOptionDescription?: string;
  /** Check indicator style override (card-select only). */
  display?: 'checkbox' | 'radio' | 'toggle';
  /** AAC keyword for build-time pictogram resolution (card-select only). Overridden by media if both set. */
  aacPhrase?: string;
  /** Per-option visual atom (card-select only). */
  media?: SelectOptionMedia;
}

interface Props {
  // identity
  id: string;
  name?: string;
  type?: InputType;

  // content (author free-text — all content* props are renderable copy)
  labelForm: string;
  contentFormPlaceholder?: string;
  contentFormDescription?: string;
  contentFormError?: string;
  contentFormSuggestion?: string;

  // state — value accepts string[] for card-select multi-select pre-tick;
  // string for everything else. Runtime is unaffected by the wider type.
  value?: string | string[];
  checked?: boolean;
  radioValue?: string;

  // behaviour
  required?: boolean;
  disabled?: boolean;
  rows?: number;
  min?: number;
  max?: number;
  step?: number;
  minLength?: number;
  maxLength?: number;
  pattern?: string;
  inputMode?: InputMode;
  autocomplete?: AutocompleteToken;
  spellcheck?: boolean;
  options?: SelectOption[];
  maxSelections?: number;

  // a11y
  hideLabel?: boolean;

  // visual
  brandColor?: BrandColour;
  rainbowColor?: RainbowColour;
  colorTier?: ColourTier;
  fieldStyle?: 'outlined' | 'filled' | 'underlined' | 'glass' | 'inset' | 'neumorphic' | 'glow' | 'bare';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  shape?: Shape;
  cardSize?: 'sm' | 'md' | 'lg';
  cardColumns?: 1 | 2 | 3 | 4;

  // Astro composition
  class?: string;
}

const {
  id,
  name,
  type = 'text',
  labelForm,
  contentFormPlaceholder,
  contentFormDescription,
  contentFormError,
  contentFormSuggestion,
  value,
  checked = false,
  radioValue,
  required = false,
  disabled = false,
  rows = 3,
  min,
  max,
  step,
  minLength,
  maxLength,
  pattern,
  inputMode,
  autocomplete,
  spellcheck,
  options = [],
  maxSelections = 1,
  hideLabel = false,
  brandColor = 'neutral',
  rainbowColor,
  colorTier,
  fieldStyle = 'outlined',
  size = 'md',
  shape = 'soft',
  cardSize = 'md',
  cardColumns = 3,
  class: className,
} = Astro.props;

const isCheckbox = type === 'checkbox';
const isRadio = type === 'radio';
const isToggle = type === 'toggle';
const isTextarea = type === 'textarea';
const isSelect = type === 'select';
const isCardSelect = type === 'card-select';
const isSingleSelect = (maxSelections ?? 1) === 1;
const fieldName = name || id;

// ── WCAG runtime guards ─────────────────────────────────────
// 2.4.6 / 3.3.2 — label must be non-empty. TypeScript catches missing but
// not whitespace strings. Throw at build so authoring errors surface in CI.
if (!labelForm || !labelForm.trim()) {
  throw new Error(
    `FormField id="${id}" requires a non-empty labelForm (WCAG 2.4.6 / 3.3.2). ` +
    `Pass a descriptive label, or set hideLabel=true if the field is contextually labelled elsewhere.`
  );
}

// 1.4.10 — textarea rows must be >= 2. Single-row textareas should be type='text'.
const safeRows = Math.max(typeof rows === 'number' ? rows : 3, 2);

// ── Smart per-type defaults (WCAG 1.3.5) ─────────────────────
const INPUT_MODE_DEFAULTS: Partial<Record<InputType, InputMode>> = {
  email: 'email',
  tel: 'tel',
  number: 'decimal',
  search: 'search',
  url: 'url',
  password: 'text',
};

const AUTOCOMPLETE_DEFAULTS: Partial<Record<InputType, AutocompleteToken>> = {
  email: 'email',
  tel: 'tel',
  password: 'current-password',
};

const SPELLCHECK_DEFAULTS: Partial<Record<InputType, boolean>> = {
  textarea: true,
  text: true,
  search: true,
  email: false,
  password: false,
  tel: false,
  url: false,
  number: false,
};

const resolvedInputMode = inputMode ?? INPUT_MODE_DEFAULTS[type] ?? undefined;
const resolvedAutocomplete = autocomplete ?? AUTOCOMPLETE_DEFAULTS[type] ?? undefined;
const resolvedSpellcheck = spellcheck ?? SPELLCHECK_DEFAULTS[type];

const describedBy = [
  contentFormError && `${id}-error`,
  contentFormSuggestion && `${id}-suggestion`,
  contentFormDescription && `${id}-desc`,
].filter(Boolean).join(' ') || undefined;

// Colour resolution — rainbowColor wins over brandColor (rainbow is more specific).
const colourName = rainbowColor || brandColor;
---

<div class:list={[
  'form-field',
  `color--${colourName}`,
  colorTier && colorTier !== 'base' && `color--tier-${colorTier}`,
  isCheckbox && 'form-field--checkbox',
  isRadio && 'form-field--radio',
  isToggle && 'form-field--toggle',
  contentFormError && 'form-field--error',
  disabled && 'form-field--disabled',
  `form-field--${fieldStyle}`,
  shape !== 'soft' && `form-field--${shape}`,
  size && size !== 'md' && `form-field--${size}`,
  isCardSelect && 'form-field--card-select',
  isCardSelect && `form-field--card-cols-${cardColumns}`,
  isCardSelect && `form-field--card-size-${cardSize}`,
  className,
]}>

  {isCheckbox ? (
    <!-- Checkbox: input + label inline -->
    <label class="form-field__checkbox-wrap" for={id}>
      <input
        type="checkbox"
        id={id}
        name={fieldName}
        checked={checked}
        required={required}
        disabled={disabled}
        autocomplete={resolvedAutocomplete}
        class="form-field__checkbox"
        aria-describedby={describedBy}
        aria-invalid={contentFormError ? 'true' : undefined}
        aria-required={required ? 'true' : undefined}
      />
      <span class="form-field__checkmark" aria-hidden="true"></span>
      <Text as="span" class="form-field__label-text" flush>{labelForm}</Text>
    </label>
  ) : isRadio ? (
    <!-- Radio: input + label inline -->
    <label class="form-field__radio-wrap" for={id}>
      <input
        type="radio"
        id={id}
        name={fieldName}
        value={radioValue || value}
        checked={checked}
        required={required}
        disabled={disabled}
        autocomplete={resolvedAutocomplete}
        class="form-field__radio"
        aria-describedby={describedBy}
        aria-invalid={contentFormError ? 'true' : undefined}
        aria-required={required ? 'true' : undefined}
      />
      <span class="form-field__radio-indicator" aria-hidden="true"></span>
      <Text as="span" class="form-field__label-text" flush>{labelForm}</Text>
    </label>
  ) : isToggle ? (
    <!-- Toggle: checkbox-backed switch.
         aria-checked syncs via JS on change events (see script) — WCAG 4.1.2. -->
    <label class="form-field__toggle-wrap" for={id}>
      <input
        type="checkbox"
        id={id}
        name={fieldName}
        checked={checked}
        required={required}
        disabled={disabled}
        autocomplete={resolvedAutocomplete}
        class="form-field__toggle"
        role="switch"
        aria-checked={checked ? 'true' : 'false'}
        aria-describedby={describedBy}
        aria-invalid={contentFormError ? 'true' : undefined}
        aria-required={required ? 'true' : undefined}
      />
      <span class="form-field__toggle-track" aria-hidden="true">
        <span class="form-field__toggle-thumb"></span>
      </span>
      <Text as="span" class="form-field__label-text" flush>{labelForm}</Text>
    </label>
  ) : (
    <Fragment>
      <!-- Label -->
      <label
        id={`${id}-label`}
        for={id}
        class:list={['form-field__label', hideLabel && 'sr-only']}
      >
        <Text as="span" flush>{labelForm}</Text>
        {required && <span class="form-field__required" aria-hidden="true">*</span>}
      </label>

      <!-- Description -->
      {contentFormDescription && (
        <Text as="span" class="form-field__desc" id={`${id}-desc`} size="sm" flush>{contentFormDescription}</Text>
      )}

      <!-- Textarea -->
      {isTextarea && (
        <textarea
          id={id}
          name={fieldName}
          placeholder={contentFormPlaceholder}
          required={required}
          disabled={disabled}
          rows={safeRows}
          minlength={minLength}
          maxlength={maxLength}
          autocomplete={resolvedAutocomplete}
          spellcheck={resolvedSpellcheck}
          class="form-field__input form-field__input--textarea"
          aria-describedby={describedBy}
          aria-invalid={contentFormError ? 'true' : undefined}
          aria-required={required ? 'true' : undefined}
        >{value}</textarea>
      )}

      <!-- Select — uses Button dropdown + hidden native select for form submission -->
      {isSelect && (
        <div class="form-field__select-wrap" data-select-field={id}>
          <select
            id={id}
            name={fieldName}
            required={required}
            disabled={disabled}
            autocomplete={resolvedAutocomplete}
            class="form-field__select-native"
            tabindex="-1"
            aria-describedby={describedBy}
            aria-invalid={contentFormError ? 'true' : undefined}
          >
            {options.map((opt) => (
              <option value={opt.value} selected={value === opt.value}>{opt.contentOption}</option>
            ))}
          </select>
          <Button
            variant="outline"
            shape="dropdown"
            disabled={disabled}
            class="form-field__select-btn"
            dropdownItems={options.filter(o => o.value !== '').map(o => ({
              label: o.contentOption,
              value: o.value,
            }))}
          >{value ? (options.find(o => o.value === value)?.contentOption || contentFormPlaceholder || labelForm) : (contentFormPlaceholder || labelForm || 'Select...')}</Button>
        </div>
      )}

      {/* Card-select — pictogram/text cards for reflective inputs */}
      {isCardSelect && (
        <Fragment>
        <div
          class="form-field__card-grid"
          role="group"
          aria-labelledby={`${id}-label`}
          data-max-selections={maxSelections}
        >
          {options.map((opt, i) => {
            const cardId = `${id}-card-${i}`;
            const inputType = isSingleSelect ? 'radio' : 'checkbox';
            // Composed accessible name: when media is content-symbol (default)
            // and has a label, append it to the <label>'s text content via
            // an sr-only span. The icon/image itself is wrapped in an
            // aria-hidden span so it doesn't double-announce. Keeps the
            // icon visible in textonly (semanticRole stays content-symbol),
            // but a11y is owned by the label wrapper.
            const mediaRole = (opt.media?.semanticRole as string | undefined) ?? 'content-symbol';
            const mediaLabel = opt.media?.component === 'Image'
              ? (opt.media as any).alt
              : opt.media?.component === 'Icon'
                ? (opt.media as any).labelIcon
                : null;
            const mediaTypeWord = opt.media?.component === 'Image' ? 'image' : 'icon';
            const composedSuffix = (mediaRole === 'content-symbol' && mediaLabel)
              ? `, with ${mediaTypeWord} ${mediaLabel}`
              : null;
            return (
              <label class="form-field__card" for={cardId}>
                <input
                  type={inputType}
                  id={cardId}
                  name={fieldName}
                  value={opt.value}
                  checked={isSingleSelect
                    ? value === opt.value
                    : Array.isArray(value) && value.includes(opt.value)}
                  class="form-field__card-input"
                  aria-describedby={describedBy}
                />
                <span class="form-field__card-face">
                  {opt.media && (
                    <span aria-hidden="true">
                      {opt.media.component === 'Image' && (
                        <Image {...(opt.media as any)} class="form-field__card-image" />
                      )}
                      {opt.media.component === 'Icon' && (
                        <Icon {...(opt.media as any)} class="form-field__card-icon" />
                      )}
                    </span>
                  )}
                  <span class="form-field__card-footer">
                    <span class:list={['form-field__card-check', `form-field__card-check--${opt.display || (isSingleSelect ? 'radio' : 'checkbox')}`]} aria-hidden="true"></span>
                    <Text as="span" class="form-field__card-label" weight="bold" flush>
                      {opt.contentOptionSimple || opt.contentOption}
                    </Text>
                  </span>
                  {opt.contentOptionDescription && (
                    <Text as="span" size="sm" color="muted" class="form-field__card-desc" flush>
                      {opt.contentOptionDescription}
                    </Text>
                  )}
                  {composedSuffix && <span class="sr-only">{composedSuffix}</span>}
                </span>
              </label>
            );
          })}
        </div>
        {!isSingleSelect && (
          <div class="sr-only" aria-live="polite" aria-atomic="true" data-card-limit-announcer></div>
        )}
        </Fragment>
      )}

      <!-- Standard input — wrapped so a placeholder "…" marker can render via
           ::after at very narrow widths (native <input> can't host pseudo-
           elements). Wrapper is layout-transparent: full-width block. -->
      {!isTextarea && !isSelect && !isCardSelect && (
        <span class="form-field__input-wrap">
          <input
            type={type}
            id={id}
            name={fieldName}
            value={value}
            placeholder={contentFormPlaceholder}
            required={required}
            disabled={disabled}
            min={min}
            max={max}
            step={step}
            minlength={minLength}
            maxlength={maxLength}
            pattern={pattern}
            inputmode={resolvedInputMode}
            autocomplete={resolvedAutocomplete}
            spellcheck={resolvedSpellcheck}
            class="form-field__input"
            aria-describedby={describedBy}
            aria-invalid={contentFormError ? 'true' : undefined}
            aria-required={required ? 'true' : undefined}
          />
        </span>
      )}
    </Fragment>
  )}

  <!-- Error + suggestion — live region announces when errors appear/change (WCAG 3.3.1, 4.1.3) -->
  {(contentFormError || contentFormSuggestion) && (
    <div class="form-field__feedback" aria-live="assertive" aria-atomic="true">
      {contentFormError && (
        <Text as="span" class="form-field__error" id={`${id}-error`} role="alert" size="sm" flush>{contentFormError}</Text>
      )}
      {contentFormSuggestion && (
        <Text as="span" class="form-field__suggestion" id={`${id}-suggestion`} size="sm" flush>{contentFormSuggestion}</Text>
      )}
    </div>
  )}
</div>

<!-- Styles: FormField.css | FormField.responsive.css -->

<script>
  // Sync Button dropdown selection → hidden native select + update button label + close dropdown
  document.addEventListener('click', (e) => {
    const item = (e.target as HTMLElement).closest('.dropdown-item') as HTMLElement;
    if (!item) return;

    const wrap = item.closest('[data-select-field]') as HTMLElement;
    if (!wrap) return;

    const value = item.dataset.value || item.textContent?.trim() || '';
    const selectId = wrap.dataset.selectField;

    // Update hidden native select
    const nativeSelect = document.getElementById(selectId!) as HTMLSelectElement;
    if (nativeSelect) {
      nativeSelect.value = value;
      nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));
    }

    // Update button label — find the text node inside .btn__label
    const btnLabel = wrap.querySelector('.btn__label');
    if (btnLabel) {
      const textEl = btnLabel.querySelector('.text') || btnLabel;
      textEl.textContent = item.textContent?.trim() || value;
    }

    // Close dropdown — remove .open and .show classes
    const wrapper = item.closest('.dropdown-wrapper');
    if (wrapper) {
      wrapper.classList.remove('open');
      const menu = wrapper.querySelector('.dropdown-menu');
      if (menu) menu.classList.remove('show');
      const btn = wrapper.querySelector('.dropdown-btn');
      if (btn) btn.setAttribute('aria-expanded', 'false');
    }
  });

  // Toggle has-value class on inputs for CSS state targeting
  document.querySelectorAll('.form-field__input').forEach(input => {
    const check = () => {
      const hasVal = (input as HTMLInputElement).value && (input as HTMLInputElement).value.trim().length > 0;
      input.closest('.form-field')?.classList.toggle('has-value', !!hasVal);
    };
    input.addEventListener('input', check);
    input.addEventListener('change', check);
    check();
  });

  // Toggle has-value on dropdown selection
  document.querySelectorAll('.form-field .dropdown-item').forEach(item => {
    item.addEventListener('click', () => {
      const field = item.closest('.form-field');
      if (field) field.classList.add('has-value');
    });
  });

  // WCAG 4.1.2 — Sync aria-checked on role="switch" toggles when native
  // checkbox state changes. Without this, AT users hear stale state.
  document.querySelectorAll<HTMLInputElement>('.form-field__toggle').forEach((toggle) => {
    const sync = () => toggle.setAttribute('aria-checked', toggle.checked ? 'true' : 'false');
    toggle.addEventListener('change', sync);
    sync();
  });

  // Card-select multi-select: enforce maxSelections.
  // Single-select (maxSelections=1, radio inputs) needs no JS — radio
  // semantics already prevent multi-pick. For multi-select (checkbox
  // inputs) we count checked, disable unchecked at limit, announce via
  // sr-only live region. Initial pass also handles server pre-ticks.
  function initCardSelectLimits() {
    document.querySelectorAll<HTMLElement>('.form-field__card-grid:not([data-card-limit-bound])').forEach((grid) => {
      const max = parseInt(grid.dataset.maxSelections || '1', 10);
      if (max <= 1) return;
      grid.dataset.cardLimitBound = '1';

      const inputs = Array.from(grid.querySelectorAll<HTMLInputElement>('.form-field__card-input'));
      const announcer = grid.parentElement?.querySelector<HTMLElement>('[data-card-limit-announcer]') || null;

      const applyLimitState = () => {
        const checkedCount = inputs.filter((i) => i.checked).length;
        const atLimit = checkedCount >= max;
        inputs.forEach((input) => {
          const card = input.closest('.form-field__card') as HTMLElement | null;
          if (!card) return;
          const lockOut = atLimit && !input.checked;
          input.disabled = lockOut;
          if (lockOut) card.setAttribute('aria-disabled', 'true');
          else card.removeAttribute('aria-disabled');
        });
      };

      inputs.forEach((input) => {
        input.addEventListener('change', () => {
          applyLimitState();
          if (!announcer) return;
          const checkedCount = inputs.filter((i) => i.checked).length;
          if (checkedCount >= max) {
            announcer.textContent = `Limit reached. ${max} selections.`;
          } else {
            announcer.textContent = '';
          }
        });

        // Click on a locked-out card lands on the <label>; native input
        // is disabled so no change fires — announce why the click did
        // nothing. Clear first to force AT re-announcement.
        const card = input.closest('.form-field__card');
        if (!card) return;
        card.addEventListener('click', () => {
          if (!input.disabled || !announcer) return;
          announcer.textContent = '';
          requestAnimationFrame(() => {
            announcer.textContent = `Limit of ${max} reached. Uncheck a selection to add this one.`;
          });
        });
      });

      applyLimitState();
    });
  }

  initCardSelectLimits();
  document.addEventListener('astro:page-load', initCardSelectLimits);
</script>
