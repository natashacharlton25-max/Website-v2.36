---
/**
 * FormField - Reusable Form Input Atom
 *
 * Covers: text, email, textarea, checkbox, radio, toggle, search, select,
 *         number, tel, url, password, card-select
 * Label, description, error render through Text atom.
 * Native HTML controls for AT/AAC compatibility.
 * Card-select renders choices as pictogram/text cards with hidden native inputs.
 *
 * Token system: --_field-brand / --_field-brand-dark / --_field-brand-light / --_field-border
 * Colour variants: primary (default), secondary, neutral
 * Style variants: outlined (default), filled, underlined, glass, neumorphic, glow
 * High contrast + dark mode: gated by zone data attributes, not component props
 */

import { Text } from '../Text';
import { Image } from '../Image';
import Icon from '../Icon/Icon.astro';

interface SelectOption {
  value: string;
  label: string;
  symbol?: string;
  simple?: string;
  image?: string;
  icon?: string;
  description?: string;
  display?: 'checkbox' | 'radio' | 'toggle';
}

interface Props {
  id: string;
  name?: string;
  label: string;
  type?: 'text' | 'email' | 'textarea' | 'checkbox' | 'radio' | 'toggle' | 'search' | 'select' | 'number' | 'tel' | 'url' | 'password' | 'card-select';
  variant?: 'primary' | 'secondary' | 'neutral';

  fieldStyle?: 'outlined' | 'filled' | 'underlined' | 'glass' | 'inset' | 'neumorphic' | 'glow' | 'bare';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  error?: string;
  description?: string;
  value?: string;
  checked?: boolean;
  rows?: number;
  min?: number;
  max?: number;
  step?: number;
  options?: SelectOption[];
  hideLabel?: boolean;
  radioValue?: string;
  maxSelections?: number;
  cardSize?: 'sm' | 'md' | 'lg';
  cardColumns?: number;
  class?: string;
}

const {
  id,
  name,
  label,
  type = 'text',
  variant = 'primary',

  fieldStyle = 'outlined',
  size,
  placeholder,
  required = false,
  disabled = false,
  error,
  description,
  value,
  checked = false,
  rows = 3,
  min,
  max,
  step,
  options = [],
  hideLabel = false,
  radioValue,
  maxSelections = 1,
  cardSize = 'md',
  cardColumns = 3,
  class: className,
} = Astro.props;

const isCheckbox = type === 'checkbox';
const isRadio = type === 'radio';
const isToggle = type === 'toggle';
const isTextarea = type === 'textarea';
const isSelect = type === 'select';
const isCardSelect = type === 'card-select';
const isSingleSelect = (maxSelections ?? 1) === 1;
const fieldName = name || id;

const describedBy = [
  error && `${id}-error`,
  description && `${id}-desc`,
].filter(Boolean).join(' ') || undefined;

---

<div class:list={[
  'form-field',
  isCheckbox && 'form-field--checkbox',
  isRadio && 'form-field--radio',
  isToggle && 'form-field--toggle',
  error && 'form-field--error',
  disabled && 'form-field--disabled',
  variant !== 'primary' && `form-field--${variant}`,
  fieldStyle !== 'outlined' && `form-field--${fieldStyle}`,
  size && size !== 'md' && `form-field--${size}`,
  isCardSelect && 'form-field--card-select',
  isCardSelect && `form-field--card-cols-${cardColumns}`,
  isCardSelect && `form-field--card-size-${cardSize}`,
  className,
]}>

  {isCheckbox ? (
    <!-- Checkbox: input + label inline -->
    <label class="form-field__checkbox-wrap" for={id}>
      <input
        type="checkbox"
        id={id}
        name={fieldName}
        checked={checked}
        required={required}
        disabled={disabled}
        class="form-field__checkbox"
        aria-describedby={describedBy}
        aria-invalid={error ? 'true' : undefined}
      />
      <span class="form-field__checkmark" aria-hidden="true"></span>
      <Text as="span" class="form-field__label-text" flush>{label}</Text>
    </label>
  ) : isRadio ? (
    <!-- Radio: input + label inline -->
    <label class="form-field__radio-wrap" for={id}>
      <input
        type="radio"
        id={id}
        name={fieldName}
        value={radioValue || value}
        checked={checked}
        required={required}
        disabled={disabled}
        class="form-field__radio"
        aria-describedby={describedBy}
        aria-invalid={error ? 'true' : undefined}
      />
      <span class="form-field__radio-indicator" aria-hidden="true"></span>
      <Text as="span" class="form-field__label-text" flush>{label}</Text>
    </label>
  ) : isToggle ? (
    <!-- Toggle: checkbox-backed switch -->
    <label class="form-field__toggle-wrap" for={id}>
      <input
        type="checkbox"
        id={id}
        name={fieldName}
        checked={checked}
        required={required}
        disabled={disabled}
        class="form-field__toggle"
        role="switch"
        aria-checked={checked ? 'true' : 'false'}
        aria-describedby={describedBy}
        aria-invalid={error ? 'true' : undefined}
      />
      <span class="form-field__toggle-track" aria-hidden="true">
        <span class="form-field__toggle-thumb"></span>
      </span>
      <Text as="span" class="form-field__label-text" flush>{label}</Text>
    </label>
  ) : (
    <Fragment>
      <!-- Label -->
      <label
        id={`${id}-label`}
        for={id}
        class:list={['form-field__label', hideLabel && 'sr-only']}
      >
        <Text as="span" flush>{label}</Text>
        {required && <span class="form-field__required" aria-hidden="true">*</span>}
      </label>

      <!-- Description -->
      {description && (
        <Text as="span" class="form-field__desc" id={`${id}-desc`} size="sm" flush>{description}</Text>
      )}

      <!-- Textarea -->
      {isTextarea && (
        <textarea
          id={id}
          name={fieldName}
          placeholder={placeholder}
          required={required}
          disabled={disabled}
          rows={rows}
          class="form-field__input form-field__input--textarea"
          aria-describedby={describedBy}
          aria-invalid={error ? 'true' : undefined}
        >{value}</textarea>
      )}

      <!-- Select — CSS-only dropdown using radio inputs + minimal JS for close-on-select -->
      {isSelect && (
        <div class="form-field__select" role="listbox" aria-labelledby={`${id}-label`} data-select-id={id}>
          <input
            type="checkbox"
            class="form-field__select-toggle"
            id={`${id}-toggle`}
            disabled={disabled}
            aria-hidden="true"
          />
          <span class="form-field__select-arrow" aria-hidden="true">
            <Icon name="plus-fill" size={16} />
          </span>
          <span class="form-field__select-placeholder">{placeholder || 'Select...'}</span>
          {options.map((opt, i) => (
            <label class="form-field__select-option" for={`${id}-opt-${i}`}>
              <input
                type="radio"
                name={fieldName}
                value={opt.value}
                id={`${id}-opt-${i}`}
                checked={value === opt.value}
                disabled={disabled || opt.value === ''}
                class="form-field__select-radio"
                role="option"
                data-select-toggle={`${id}-toggle`}
              />
              <span class="form-field__select-label">
                {opt.icon && <Icon name={opt.icon} size={16} class="form-field__select-icon" />}
                <span class="form-field__select-text">{opt.label}</span>
              </span>
            </label>
          ))}
        </div>
      )}

      {/* Card-select — pictogram/text cards for reflective inputs */}
      {isCardSelect && (
        <div class="form-field__card-grid" role="group" aria-labelledby={`${id}-label`}>
          {options.map((opt, i) => {
            const cardId = `${id}-card-${i}`;
            const inputType = isSingleSelect ? 'radio' : 'checkbox';
            return (
              <label class="form-field__card" for={cardId}>
                <input
                  type={inputType}
                  id={cardId}
                  name={fieldName}
                  value={opt.value}
                  checked={isSingleSelect ? value === opt.value : false}
                  class="form-field__card-input"
                  aria-describedby={describedBy}
                />
                <span class="form-field__card-face">
                  {opt.image && (
                    <Image
                      src={opt.image}
                      alt=""
                      class="form-field__card-image"
                      semanticRole="decorative"
                      fit="cover"
                    />
                  )}
                  {!opt.image && opt.icon && (
                    <span class="form-field__card-icon">
                      <Icon name={opt.icon} size={36} />
                    </span>
                  )}
                  {!opt.image && opt.symbol && (
                    <Image
                      src={`/api/aac/symbol/${opt.symbol}`}
                      alt=""
                      class="form-field__card-symbol"
                      semanticRole="decorative"
                    />
                  )}
                  <span class="form-field__card-footer">
                    <span class:list={['form-field__card-check', `form-field__card-check--${opt.display || (isSingleSelect ? 'radio' : 'checkbox')}`]} aria-hidden="true"></span>
                    <Text as="span" class="form-field__card-label" weight="bold" flush>
                      {opt.simple || opt.label}
                    </Text>
                  </span>
                  {opt.description && (
                    <Text as="span" size="sm" color="muted" class="form-field__card-desc" flush>
                      {opt.description}
                    </Text>
                  )}
                </span>
              </label>
            );
          })}
        </div>
      )}

      <!-- Standard input -->
      {!isTextarea && !isSelect && !isCardSelect && (
        <input
          type={type}
          id={id}
          name={fieldName}
          value={value}
          placeholder={placeholder}
          required={required}
          disabled={disabled}
          min={min}
          max={max}
          step={step}
          class="form-field__input"
          aria-describedby={describedBy}
          aria-invalid={error ? 'true' : undefined}
        />
      )}
    </Fragment>
  )}

  <!-- Error message -->
  {error && (
    <Text as="span" class="form-field__error" id={`${id}-error`} role="alert" size="sm" flush>{error}</Text>
  )}
</div>

<!-- Styles: FormField.css | FormField.responsive.css -->

<script>
  // Close select dropdown when option is chosen
  document.addEventListener('change', (e) => {
    const radio = e.target as HTMLInputElement;
    if (radio.classList.contains('form-field__select-radio')) {
      const toggleId = radio.dataset.selectToggle;
      if (toggleId) {
        const toggle = document.getElementById(toggleId) as HTMLInputElement;
        if (toggle) toggle.checked = false;
      }
    }
  });
</script>
