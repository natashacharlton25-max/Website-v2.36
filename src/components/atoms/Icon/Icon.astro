---
/**
 * Icon — API-backed, multi-brand aware.
 *
 * Fetches SVG from Asset Library API at build time.
 * Weight: light, regular, bold, fill, duotone (brand default via ICON_WEIGHT env).
 * Colour: global .color--{name} mixin (brandColor/rainbowColor/colorTier).
 * Gradient: SVG linearGradient fill via SvgGradientDefs.
 * Draw: GSAP DrawSVGPlugin (client-side, data attributes).
 * Morph: GSAP MorphSVGPlugin (hover toggle).
 */

import { AnimExplainer } from '../../molecules/aac/AnimExplainer';
import phosphorMeta from '../../../../phosphor-meta.json';

import type {
  BrandColour, RainbowColour, ColourTier,
  IconWeight,
  Animation, AnimationTriggerInteractive,
  GradientBlend, GradientDirection,
  IconSemanticRole,
  DrawVariant, DrawMode, DrawColour,
  Stagger, StaggerFrom,
  MorphTrigger,
  FillMode, FillTrigger,
} from '../../../lib/shared-enums';
import { normalizeDrawColour } from '../../../lib/shared-enums';
import { resolveInlineGradient } from '../../../lib/gradient-inline';

// ─── Brand config ───────────────────────────────────────
const ASSET_API_URL = import.meta.env.ASSET_API_URL || 'http://localhost:8787';
const ASSET_API_TOKEN = import.meta.env.ASSET_API_TOKEN || '';
const DEFAULT_WEIGHT = import.meta.env.ICON_WEIGHT || 'fill';

type IconShadow = 'sm' | 'md' | 'lg' | 'elevated';
type IconGlow = 'sm' | 'md' | 'lg';

interface Props {
  // ── Content ─────────────────────────────────────────────
  name: string;
  weight?: IconWeight;
  semanticRole?: IconSemanticRole;
  label?: string;

  // ── Colour ──────────────────────────────────────────────
  brandColor?: BrandColour;
  rainbowColor?: RainbowColour;
  colorTier?: ColourTier;

  // ── Visual ──────────────────────────────────────────────
  /** Named em-based size scale (xs–8xl) or explicit pixel number.
   *  Named sizes use --media-* tokens and scale with parent font-size.
   *  Numeric sizes output fixed px for absolute control. */
  size?: number | 'xs' | 'sm' | 'base' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | '6xl' | '7xl' | '8xl';
  shadow?: IconShadow;
  glow?: IconGlow;

  // ── Gradient ────────────────────────────────────────────
  gradient?: boolean;
  gradientBlend?: GradientBlend;
  gradientDirection?: GradientDirection;
  gradientType?: 'linear' | 'radial';
  gradientFocus?: 'center' | 'top' | 'bottom' | 'left' | 'right' | 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';
  gradientAnimate?: boolean;
  gradientAnimateDirection?: 'cw' | 'ccw' | 'sway';
  gradientAnimateSpeed?: 'slow' | 'default' | 'fast';

  // ── Animation ───────────────────────────────────────────
  animation?: Animation;
  animationTrigger?: AnimationTriggerInteractive;
  animationRepeat?: 'once' | 'loop' | 'three' | 'threeloop';
  draw?: boolean | DrawVariant;
  drawMode?: DrawMode;
  drawOnce?: boolean;
  drawLaser?: boolean;
  drawGhost?: boolean;
  drawOnScroll?: boolean;
  drawScrub?: boolean;
  drawColor?: DrawColour | string;
  drawStagger?: Stagger;
  drawStaggerFrom?: StaggerFrom;
  drawWormSize?: number;
  morphTo?: string;
  morphViaCircle?: boolean;
  morphTrigger?: MorphTrigger;
  morphStagger?: Stagger;
  morphStaggerFrom?: StaggerFrom;
  fillAnimation?: boolean;
  fillOutline?: boolean;
  fillDrawVariant?: DrawVariant;
  fillDrawLaser?: boolean;
  fillMode?: FillMode;
  fillTrigger?: FillTrigger;
  fillDuration?: number;
  fillEase?: string;
  fillColor?: string;
  fillStagger?: Stagger;
  fillStaggerFrom?: StaggerFrom;

  class?: string;
}

const {
  name, weight, size, class: className = '',
  brandColor, rainbowColor, colorTier,
  shadow, glow,
  gradient, gradientBlend, gradientDirection, gradientType, gradientFocus, gradientAnimate, gradientAnimateDirection, gradientAnimateSpeed,
  animation, animationTrigger = 'hover', animationRepeat = 'once',
  draw, drawMode: rawDrawMode = 'static', drawOnce, drawLaser, drawGhost, drawOnScroll, drawScrub, drawColor: rawDrawColor, drawStagger, drawStaggerFrom, drawWormSize,
  morphTo, morphViaCircle, morphTrigger = 'hover', morphStagger, morphStaggerFrom,
  fillAnimation, fillOutline, fillDrawVariant, fillDrawLaser, fillMode = 'once', fillTrigger = 'hover', fillDuration, fillEase, fillColor, fillStagger, fillStaggerFrom,
  semanticRole, label,
} = Astro.props;

// Resolve drawMode: drawOnce overrides to 'once', drawOnce+drawGhost → strip drawOnce
const drawMode = (drawOnce && !drawGhost) ? 'once' : rawDrawMode;

// Strip tier suffixes from drawColor (e.g. "red-tint" → "red") since draw
// strokes need full opacity — tiers are opacity-based and would render the
// stroke partially transparent.
const drawColor = normalizeDrawColour(rawDrawColor);

// A11y: ui-control and content-symbol need labels
const isInformational = semanticRole === 'ui-control' || semanticRole === 'content-symbol';
if (isInformational && !label && import.meta.env.DEV) {
  console.warn(`[Icon ${name}] semanticRole="${semanticRole}" requires a label for accessibility`);
}

// A11y: any icon with an interaction (hover/click/focus animation, draw, morph,
// fill animation) MUST be focusable. Eye-gaze trackers, switch access, keyboard
// users — all OS-level AT translates input into focus/click events. If the
// element isn't in the tab order, those users have NO way to trigger it.
//
// We don't gate on semanticRole here — interactivity is independent of
// "decorative vs informational". An icon can be visually decorative AND have
// a hover effect; that hover effect is still an interaction that needs a
// non-mouse input path.
const interactiveTriggers = ['hover', 'click', 'focus'];
const animationIsInteractive = !!animation && interactiveTriggers.includes(animationTrigger);
const drawIsInteractive = !!draw && (drawOnScroll || drawScrub
  ? false
  : interactiveTriggers.includes((animationTrigger as string)));
const morphIsInteractive = !!morphTo && morphTrigger === 'hover';
const fillIsInteractive = !!fillAnimation && fillTrigger === 'hover';
const isInteractive = isInformational
  || animationIsInteractive
  || drawIsInteractive
  || morphIsInteractive
  || fillIsInteractive;
// Resolve role: informational icons stay role="img"; pure-interactive
// (hover/click animations without semanticRole) become role="button" so
// screen readers announce them as activatable.
const a11yRole = isInformational ? 'img' : (isInteractive ? 'button' : undefined);

// Resolve colour: rainbow takes precedence, else brand
const resolvedColor = rainbowColor || brandColor || null;

// Weight rules: draw+morph → fill (single solid path), draw only → light, morph only → fill
const resolvedWeight = morphTo
  ? (weight || 'fill')
  : draw && (weight === 'fill' || (!weight && DEFAULT_WEIGHT === 'fill'))
    ? 'light'
    : (draw ? (weight || 'light') : weight);

// ─── Weight suffixes (for slug detection) ───────────────

const WEIGHTS = ['light', 'regular', 'bold', 'fill', 'duotone'];

function hasWeightSuffix(slug: string): boolean {
  return WEIGHTS.some(w => slug.endsWith(`-${w}`));
}

function resolveSlug(iconName: string, weightOverride?: string, stripWeight?: boolean): string {
  // Strip legacy 'ph:' prefix
  let resolved = iconName.startsWith('ph:') ? iconName.slice(3) : iconName;

  // Strip folder prefix — "interface/users-fill" → "users-fill"
  if (resolved.includes('/')) {
    resolved = resolved.split('/').pop()!;
  }

  // If name has a weight suffix: strip it when forced (draw/morph weight rules), else use as-is
  if (hasWeightSuffix(resolved)) {
    if (stripWeight) {
      for (const w of WEIGHTS) {
        if (resolved.endsWith(`-${w}`)) {
          resolved = resolved.slice(0, -(w.length + 1));
          break;
        }
      }
    } else {
      return resolved;
    }
  }

  // Append weight: explicit override → brand default
  const w = weightOverride || DEFAULT_WEIGHT;
  return `${resolved}-${w}`;
}

// ─── Fetch icon from Asset Library API ──────────────────

async function fetchIcon(slug: string): Promise<string | null> {
  try {
    const headers: Record<string, string> = {};
    if (ASSET_API_TOKEN) {
      headers['Authorization'] = `Bearer ${ASSET_API_TOKEN}`;
    }
    const res = await fetch(`${ASSET_API_URL}/v1/assets/${slug}`, { headers });
    if (!res.ok) return null;
    return await res.text();
  } catch {
    return null;
  }
}

// ─── Resolve primary icon ───────────────────────────────

const needsWeightStrip = !!(draw || morphTo);
const slug = resolveSlug(name, resolvedWeight, needsWeightStrip);
// Morph (with or without draw): flat for single clean path. Draw only: standard multi-stroke.
const fetchSlug = morphTo ? `${slug}-flat` : slug;
let iconContent = await fetchIcon(fetchSlug);

// Fallback: non-flat, then fill weight
if (!iconContent && morphTo) {
  iconContent = await fetchIcon(slug);
}
if (!iconContent && !name.endsWith('-fill') && weight !== 'fill') {
  iconContent = await fetchIcon(resolveSlug(name, 'fill'));
}

// ─── Resolve morph target ───────────────────────────────

let morphTargetContent: string | null = null;
if (morphTo && !draw) {
  // Fill morph (MorphSVG): force fill weight, flat suffix for single-path
  const morphSlug = `${resolveSlug(morphTo, 'fill')}-flat`;
  morphTargetContent = await fetchIcon(morphSlug);
  if (!morphTargetContent) {
    morphTargetContent = await fetchIcon(resolveSlug(morphTo, 'fill'));
  }
} else if (morphTo && draw) {
  // Draw morph: light weight flat — single clean path
  const morphSlug = resolveSlug(morphTo, resolvedWeight);
  morphTargetContent = await fetchIcon(`${morphSlug}-flat`) || await fetchIcon(morphSlug);
}

// ─── Fill source for draw+fill combined (fill-weight SVG for bloom) ───
let fillSvgContent: string | null = null;
if (draw && fillAnimation) {
  const fillSlug = resolveSlug(name, 'fill', true);
  fillSvgContent = await fetchIcon(`${fillSlug}-flat`) || await fetchIcon(fillSlug);
}

// ─── SVG Transforms ─────────────────────────────────────

// Draw animation: GSAP DrawSVGPlugin handles everything client-side.
// Icon.astro just outputs the normal icon + data attributes.
// No server-side SVG surgery needed.

// Gradient: reference shared SvgGradientDefs via url(#grad-{name}) OR inline a direction-aware def.
// SvgGradientDefs.astro must be included once in the layout.
// gradient (boolean) + gradientBlend (named blend) — same as Badge/Heading
const gradientName = gradientBlend || (gradient ? 'primary' : null);

// If a direction is set, build an inline gradient def from the catalogue (baked defs are 135° only).
const inlineGradient = (gradientName && gradientDirection)
  ? resolveInlineGradient(gradientName, { direction: gradientDirection })
  : null;

if (gradientName && iconContent && !draw) {
  if (gradientAnimate) {
    // GSAP gradient.ts handles animation via data-icon-grad-anim.
    // Still need to apply the gradient fill to paths.
    const gradientId = inlineGradient?.id || `grad-${gradientName}`;
    if (inlineGradient && inlineGradient.kind === 'linear') {
      const stopsXml = inlineGradient.stops
        .map((s: any) => `<stop offset="${s.offset}%" stop-color="${s.colour}" />`)
        .join('');
      const inlineDef = `<defs><linearGradient id="${inlineGradient.id}" x1="${inlineGradient.x1}" y1="${inlineGradient.y1}" x2="${inlineGradient.x2}" y2="${inlineGradient.y2}">${stopsXml}</linearGradient></defs>`;
      iconContent = iconContent.replace(/<svg([^>]*)>/, `<svg$1>${inlineDef}`);
    }
    iconContent = iconContent
      .replace(/fill="currentColor"/g, `fill="url(#${gradientId})"`)
      .replace(/fill="CurrentColor"/g, `fill="url(#${gradientId})"`);
    iconContent = iconContent.replace(/<path(?![^>]*fill=)/g, `<path fill="url(#${gradientId})"`);
  } else {
    const gradientId = inlineGradient?.id || `grad-${gradientName}`;
    // If we have an inline gradient, inject its def into the SVG
    if (inlineGradient && inlineGradient.kind === 'linear') {
      const stopsXml = inlineGradient.stops
        .map((s) => `<stop offset="${s.offset}%" stop-color="${s.colour}" />`)
        .join('');
      const inlineDef = `<defs><linearGradient id="${inlineGradient.id}" x1="${inlineGradient.x1}" y1="${inlineGradient.y1}" x2="${inlineGradient.x2}" y2="${inlineGradient.y2}">${stopsXml}</linearGradient></defs>`;
      iconContent = iconContent.replace(/<svg([^>]*)>/, `<svg$1>${inlineDef}`);
    }
    iconContent = iconContent
      .replace(/fill="currentColor"/g, `fill="url(#${gradientId})"`)
      .replace(/fill="CurrentColor"/g, `fill="url(#${gradientId})"`);
    iconContent = iconContent.replace(/<path(?![^>]*fill=)/g, `<path fill="url(#${gradientId})"`);
  }
}

// ─── Fallback ───────────────────────────────────────────

const fallbackIcon = `<svg viewBox="0 0 256 256"${size != null ? ` width="${size}" height="${size}"` : ''} fill="currentColor"><circle cx="128" cy="128" r="96" opacity="0.2"/><circle cx="128" cy="128" r="96" fill="none" stroke="currentColor" stroke-width="16"/></svg>`;

// ─── Build classes and data attrs ───────────────────────

const drawVariant = typeof draw === 'string' ? draw : 'draw';

const effectClasses = [
  resolvedColor && `color--${resolvedColor}`,
  colorTier && colorTier !== 'base' && `color--tier-${colorTier}`,
  shadow && `icon--shadow-${shadow}`,
  glow && `icon--glow-${glow}`,
  gradientName && 'icon--has-gradient',
  animation && `anim--${animation}`,
  draw && 'icon--stroke',
  draw && 'icon--draw',
  morphTo && 'icon--morph',
];

const dataAttrs: Record<string, string | undefined> = {};

if (draw) {
  dataAttrs['data-icon-draw'] = drawVariant;
  dataAttrs['data-icon-draw-mode'] = drawMode;
  if (drawLaser) dataAttrs['data-icon-draw-laser'] = 'true';
  if (drawGhost) dataAttrs['data-icon-draw-ghost'] = 'true';
  if (drawOnScroll) dataAttrs['data-icon-draw-scroll'] = 'true';
  if (drawScrub) dataAttrs['data-icon-draw-scrub'] = 'true';
  if (drawColor) dataAttrs['data-icon-draw-color'] = drawColor;
  if (drawStagger) dataAttrs['data-icon-draw-stagger'] = drawStagger;
  if (drawStaggerFrom) dataAttrs['data-icon-draw-stagger-from'] = drawStaggerFrom;
  if (drawWormSize) dataAttrs['data-icon-draw-worm-size'] = String(drawWormSize);
  if (animationTrigger && animationTrigger !== 'hover') dataAttrs['data-icon-draw-trigger'] = animationTrigger;
}

if (morphTo && morphTargetContent) {
  dataAttrs['data-icon-morph'] = 'true';
  dataAttrs['data-icon-morph-target'] = morphTargetContent;
  if (morphViaCircle) dataAttrs['data-icon-morph-circle'] = 'true';
  if (morphTrigger && morphTrigger !== 'hover') dataAttrs['data-icon-morph-trigger'] = morphTrigger;
  if (morphStagger) dataAttrs['data-icon-morph-stagger'] = morphStagger;
  if (morphStaggerFrom) dataAttrs['data-icon-morph-stagger-from'] = morphStaggerFrom;
}

if (fillAnimation) {
  dataAttrs['data-icon-fill'] = 'true';
  if (fillOutline) dataAttrs['data-icon-fill-outline'] = 'true';
  if (fillDrawVariant) dataAttrs['data-icon-fill-draw-variant'] = fillDrawVariant;
  if (fillDrawLaser) dataAttrs['data-icon-fill-draw-laser'] = 'true';
  if (fillMode !== 'once') dataAttrs['data-icon-fill-mode'] = fillMode;
  if (fillTrigger !== 'hover') dataAttrs['data-icon-fill-trigger'] = fillTrigger;
  if (fillDuration) dataAttrs['data-icon-fill-duration'] = String(fillDuration);
  if (fillEase) dataAttrs['data-icon-fill-ease'] = fillEase;
  if (fillColor) dataAttrs['data-icon-fill-color'] = fillColor;
  if (fillStagger) dataAttrs['data-icon-fill-stagger'] = fillStagger;
  if (fillStaggerFrom) dataAttrs['data-icon-fill-stagger-from'] = fillStaggerFrom;
  if (fillSvgContent) dataAttrs['data-icon-fill-svg'] = fillSvgContent;
}

// Gradient animation — GSAP via gradient.ts (replaces baked <animateTransform>)
if (gradientAnimate && gradientName && !draw) {
  const speedMap: Record<string, string> = { slow: '16', default: '8', fast: '4' };
  dataAttrs['data-icon-grad-anim'] = 'true';
  if (gradientAnimateDirection && gradientAnimateDirection !== 'cw') dataAttrs['data-icon-grad-dir'] = gradientAnimateDirection;
  if (gradientAnimateSpeed && gradientAnimateSpeed !== 'default') dataAttrs['data-icon-grad-dur'] = speedMap[gradientAnimateSpeed] || '8';
}

// ─── Animation explainer — resolve everything for the molecule ─────
const isUiControl = semanticRole === 'ui-control';
const hasAnimation = !!(morphTo || draw || fillAnimation || animation);
const showExplainer = hasAnimation && !isUiControl;
const explainerType = morphTo ? 'morph' : draw ? 'draw' : fillAnimation ? 'fill' : 'micro';

// Resolve short display name from a Phosphor slug
function resolvePhosphorName(slug: string): string {
  const ws = ['light', 'regular', 'bold', 'fill', 'duotone', 'flat'];
  const parts = slug.split('-');
  while (parts.length > 1 && ws.includes(parts[parts.length - 1])) parts.pop();
  const baseName = parts.join('-');
  const entry = phosphorMeta.find((e: any) => e.name === baseName);
  if (entry) return entry.pascal_name.replace(/([A-Z])/g, ' $1').trim().split(' ')[0].toLowerCase();
  return parts[0];
}

// Display name: always use phosphor name (what it looks like)
// Label is for screen readers (intention), explainer describes the visual
const explainerName = resolvePhosphorName(name);

// Morph target name
const explainerTargetName = morphTo ? resolvePhosphorName(morphTo) : undefined;


---

{/* Semantic roles: decorative=hidden, ui-control=labelled+focusable, content-symbol=labelled */}
<span
  class:list={['icon', typeof size === 'string' && `icon--size-${size}`, ...effectClasses, className]}
  style={typeof size === 'number' ? `width: ${size}px; height: ${size}px;` : undefined}
  aria-hidden={!isInteractive && (semanticRole === 'decorative' || !semanticRole) ? "true" : undefined}
  aria-label={isInformational ? label : (isInteractive && label ? label : undefined)}
  tabindex={isInteractive ? "0" : undefined}
  role={a11yRole}
  data-semantic-role={semanticRole}
  data-anim-trigger={animation && animationTrigger !== 'hover' ? animationTrigger : undefined}
  data-anim-repeat={animation && animationRepeat !== 'once' ? animationRepeat : undefined}
  {...dataAttrs}
>
  <Fragment set:html={iconContent || fallbackIcon} />
  {label && semanticRole === 'ui-control' && <span class="icon__label">{label}</span>}
</span>
{/* Animation explainer — AAC sequence cards (molecule handles layout + API fetches) */}
{showExplainer && (
  <AnimExplainer
    type={explainerType as any}
    sourceSvg={iconContent || fallbackIcon}
    targetSvg={morphTargetContent || undefined}
    displayName={explainerName}
    targetName={explainerTargetName}
    animation={animation}
    color={resolvedColor}
  />
)}
