{
  "component": "Icon",
  "category": "atom",
  "renders": { "full": "Icon.astro", "reduced": "Icon.astro", "assistive": "Icon.astro", "textonly": null },
  "notes": "API-backed icon atom. Fetches SVG from Asset Library at build time. Weight resolved via brand config or explicit override. textonly: null for decorative icons. ui-control and content-symbol icons stay visible in textonly/calm.",

  "props": {
    "content": {
      "name":         { "type": "string", "required": true },
      "weight":       { "type": "string", "enum": ["light", "regular", "bold", "fill", "duotone"] },
      "semanticRole": { "type": "string", "enum": ["decorative", "ui-control", "content-symbol"] }
    },

    "colour": {
      "brandColor":  { "type": "string", "enum": ["primary", "secondary", "neutral"] },
      "rainbowColor": { "type": "string", "enum": ["red", "orange", "yellow", "teal", "blue", "purple", "pink"] },
      "colorTier":   { "type": "string", "default": "base", "enum": ["tint", "mid", "base", "emphasis"] }
    },

    "gradient": {
      "gradient": { "type": "string", "enum": ["hero", "sunset", "brand-emerge", "brand-fade", "emerge", "fade", "preset-tint", "preset-mid", "preset-base", "preset-emphasis", "primary", "secondary", "neutral", "red", "orange", "yellow", "teal", "blue", "purple", "pink"] }
    },

    "visual": {
      "size":    { "type": "number", "default": 24 },
      "shadow":  { "type": "string", "enum": ["sm", "md", "lg"] },
      "glow":    { "type": "string", "enum": ["sm", "md", "lg", "secondary", "white"] }
    },

    "animation": {
      "animation":        { "type": "string", "enum": ["spin", "bounce", "shake", "float", "drift", "slide-up", "slide-down", "slide-left", "slide-right", "flip", "pulse", "ping", "pop", "squish", "heartbeat", "rubber-band", "fade", "blink", "flash", "glint", "shimmer", "twinkle", "wiggle", "swing", "rock", "nod", "attention", "celebrate", "enter", "exit"] },
      "animationTrigger": { "type": "string", "default": "hover", "enum": ["hover", "viewport", "autoplay", "loop", "interval", "click", "focus", "none"] },
      "draw":             { "type": ["boolean", "string"], "enum": [true, "draw", "drawcenter", "chachaslide", "flashgordon", "rainbowchase", "pulse"] },
      "drawOnScroll":     { "type": "boolean" },
      "drawScrub":        { "type": "boolean" },
      "drawColor":        { "type": "string" },
      "morphTo":          { "type": "string" },
      "morphColor":       { "type": "string" }
    }
  }
}
