{
  "component": "Icon",
  "category": "atom",
  "renders": { "full": "Icon.astro", "reduced": "Icon.astro", "assistive": "Icon.astro", "textonly": null },
  "notes": "API-backed icon atom. Fetches SVG from Asset Library at build time. Weight resolved via brand config or explicit override. textonly: null for decorative. morph forces fill weight, draw forces non-fill (auto-corrected).",

  "_rules": [
    { "rule": "morph-requires-fill", "condition": "morphTo", "requires": "weight === 'fill' || weight === undefined" },
    { "rule": "draw-excludes-fill", "condition": "draw", "excludes": "weight === 'fill'" },
    { "rule": "gradient-draw-passthrough", "condition": "gradient && draw", "note": "gradient value used as drawColor for gradient stroke lines" },
    { "rule": "draw-colour-base-only", "condition": "draw", "note": "drawColor only accepts base colour variants or rainbow — no tier modifiers (tint/mid/emphasis). Atom strips them at runtime via normalizeDrawColour." },
    { "rule": "label-required-for-informational", "condition": "semanticRole === 'ui-control' || semanticRole === 'content-symbol'", "requires": "label", "note": "ui-control and content-symbol icons must have label for screen readers and textonly swap" }
  ],

  "props": {
    "content": {
      "name":         { "type": "string", "required": true, "_format": "icon-slug", "description": "Phosphor icon slug from Asset Library (e.g. heart-fill, rocket-launch)." },
      "weight":       { "type": "string", "enum": ["light", "regular", "bold", "fill", "duotone"] },
      "semanticRole": { "type": "string", "required": true, "default": "decorative", "enum": ["decorative", "ui-control", "content-symbol"], "description": "Required. Declares intent — pipeline uses this to show/hide per render mode. Default: decorative (hidden in textonly/calm)." },
      "label":        { "type": "string", "_note": "Required for ui-control and content-symbol. Screen reader text + textonly label swap for ui-control." }
    },

    "colour": {
      "brandColor":   { "type": "string", "enum": ["primary", "secondary", "neutral", "text"] },
      "rainbowColor": { "type": "string", "enum": ["rainbow-1", "rainbow-2", "rainbow-3", "rainbow-4", "rainbow-5", "rainbow-6", "rainbow-7"] },
      "colorTier":    { "type": "string", "default": "base", "enum": ["tint", "mid", "base", "emphasis"] }
    },

    "gradient": {
      "gradient":          { "type": "boolean", "default": false },
      "gradientBlend":     { "type": "string", "enum": ["hero", "sunset", "brand-emerge", "brand-fade", "preset-tint", "preset-mid", "preset-base", "preset-emphasis", "primary", "secondary", "neutral", "red", "orange", "yellow", "teal", "blue", "purple", "pink", "rainbow"] },
      "gradientDirection":        { "type": "string", "default": "diagonal", "enum": ["vertical", "vertical-reverse", "horizontal", "horizontal-reverse", "diagonal", "diagonal-reverse", "diagonal-alt", "diagonal-alt-reverse"] },
      "gradientType":             { "type": "string", "default": "linear", "enum": ["linear", "radial"] },
      "gradientFocus":            { "type": "string", "default": "center", "enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"], "_note": "Radial origin — only used when gradientType=radial." },
      "gradientEmerge":           { "type": "boolean", "default": false },
      "gradientFade":             { "type": "boolean", "default": false },
      "gradientAnimate":          { "type": "boolean" },
      "gradientAnimateDirection": { "type": "string", "default": "cw", "enum": ["cw", "ccw", "sway"] },
      "gradientAnimateSpeed":     { "type": "string", "default": "default", "enum": ["slow", "default", "fast"] }
    },

    "visual": {
      "size":   { "type": "string", "default": "base", "enum": ["xs", "sm", "md", "lg", "xl", "base", "2xl", "3xl", "4xl", "5xl", "6xl", "7xl", "8xl"] },
      "shadow": { "type": "string", "enum": ["sm", "md", "lg", "elevated"] },
      "glow":   { "type": "string", "enum": ["sm", "md", "lg"] }
    },

    "animation": {
      "animation":        { "type": "string", "enum": ["spin", "bounce", "shake", "float", "drift", "slide-up", "slide-down", "slide-left", "slide-right", "flip", "pulse", "ping", "pop", "squish", "heartbeat", "rubber-band", "fade", "blink", "flash", "glint", "shimmer", "twinkle", "wiggle", "swing", "rock", "nod", "attention", "celebrate", "enter", "exit"] },
      "animationTrigger": { "type": "string", "default": "hover", "enum": ["hover", "viewport", "autoplay", "loop", "interval", "click", "focus", "none"] },
      "animationRepeat":  { "type": "string", "default": "once", "enum": ["once", "loop", "three", "threeloop"], "description": "How many times to play: once, loop (infinite), three (3x), threeloop (3x then pause then repeat)" },

      "draw":             { "type": ["boolean", "string"], "enum": [true, "draw", "drawcenter", "pulse"] },
      "drawMode":         { "type": "string", "default": "static", "enum": ["fade", "static", "yoyo", "reverse-yoyo", "reveal"] },
      "drawLaser":        { "type": "boolean" },
      "drawGhost":        { "type": "boolean", "_note": "Use --svg-ghost-color token for ghost stroke" },
      "drawColor":        { "type": "string", "enum": ["primary", "secondary", "neutral", "text", "rainbow-1", "rainbow-2", "rainbow-3", "rainbow-4", "rainbow-5", "rainbow-6", "rainbow-7", "hero", "sunset", "brand-emerge", "brand-fade", "rainbow"], "_note": "BASE colours only — no tier modifiers. Tier suffixes are stripped at runtime." },
      "drawStagger":      { "type": "string", "default": "normal", "enum": ["none", "tight", "normal", "loose"] },
      "drawStaggerFrom":  { "type": "string", "default": "start", "enum": ["start", "center", "end", "edges", "random"] },
      "drawWormSize":     { "type": "string", "default": "normal", "enum": ["tiny", "small", "normal", "large", "huge"], "_note": "Laser worm segment size relative to path length." },
      "drawOnScroll":     { "type": "boolean" },
      "drawScrub":        { "type": "boolean" },

      "morphTo":          { "type": "string", "_format": "icon-slug", "description": "Target icon slug for morph animation." },
      "morphViaCircle":   { "type": "boolean", "_note": "Legacy — goo morph is now the default convergence technique" },
      "morphTrigger":     { "type": "string", "default": "hover", "enum": ["hover", "viewport", "scroll"] },
      "morphStagger":     { "type": "string", "enum": ["none", "tight", "normal", "loose"] },
      "morphStaggerFrom": { "type": "string", "default": "start", "enum": ["start", "center", "end", "edges", "random"] },

      "fillAnimation":    { "type": "boolean" },
      "fillOutline":      { "type": "boolean" },
      "fillDrawVariant":  { "type": "string", "enum": ["draw", "drawcenter", "pulse"] },
      "fillDrawLaser":    { "type": "boolean" },
      "fillMode":         { "type": "string", "default": "once", "enum": ["once", "yoyo", "static", "fade", "ghost", "ghoststatic", "twinkle", "reduced"], "_note": "reduced: dims fill during outline draw. ghoststatic: static ghost-colour fill, outline draws on trigger." },
      "fillTrigger":      { "type": "string", "default": "hover", "enum": ["hover", "viewport", "scrub", "rainbow", "loop", "autoplay"] },
      "fillDuration":     { "type": "string", "default": "normal", "enum": ["fast", "normal", "slow", "slower"] },
      "fillEase":         { "type": "string", "enum": ["jelly", "wobble", "bounce", "snap"] },
      "fillColor":        { "type": "string", "enum": ["primary", "secondary", "neutral", "text", "rainbow-1", "rainbow-2", "rainbow-3", "rainbow-4", "rainbow-5", "rainbow-6", "rainbow-7"] },
      "fillStagger":      { "type": "string", "default": "normal", "enum": ["none", "tight", "normal", "loose"] },
      "fillStaggerFrom":  { "type": "string", "default": "start", "enum": ["start", "center", "end", "edges", "random"] }
    }
  }
}
