---
/**
 * Image — Atomic image primitive (pure, no fetching)
 *
 * Every image (photos, illustrations, decorative SVGs, logos)
 * should go through this component. Icon SVGs use Icon.astro instead.
 *
 * Consumes theme tokens: --media-brightness, --media-saturation, --media-contrast
 * so monochrome/dark/high-contrast themes apply automatically.
 *
 * Styles: Image.css | Image.responsive.css
 *
 * Alt text data comes from the page/section that fetches it, not this atom.
 * Pages call fetchAltData() and pass results as altWord/altDescriptive/altAacHtml.
 *
 * Props:
 *   role      — "content" (default) wraps in <figure> with alt spans
 *               "decorative" renders bare <img alt="" aria-hidden="true">
 *   altWord        — Short word-level alt text (from API or manual)
 *   altDescriptive — Long descriptive alt text
 *   altAacHtml     — Pre-rendered AAC card HTML
 *   decorative     — DEPRECATED alias for role="decorative"
 *
 * Usage:
 *   <Image src="/images/photo.jpg" alt="A sunset" />
 *   <Image src="/images/photo.jpg" alt="A sunset" fit="cover" />
 *   <Image src="/images/hero.jpg" role="decorative" />
 *   <Image src="/images/card.jpg" alt="Product" radius="lg" shadow="md" />
 *   <Image src="/images/sunset.jpg" altWord="sunset" altDescriptive="A golden sunset" />
 */

interface Props {
  src: string;
  alt?: string;
  role?: 'content' | 'decorative';
  altWord?: string;
  altDescriptive?: string;
  altAacHtml?: string;
  width?: number | string;
  height?: number | string;
  fit?: 'cover' | 'contain' | 'fill' | 'none';
  radius?: 'none' | 'sm' | 'md' | 'lg' | 'full';
  shadow?: 'none' | 'sm' | 'md' | 'lg';
  hover?: boolean;
  responsive?: boolean;
  /** @deprecated Use role="decorative" instead */
  decorative?: boolean;
  loading?: 'lazy' | 'eager';
  sepia?: 'light' | 'default' | 'heavy';
  blur?: 'sm' | 'md' | 'lg' | 'xl';
  gradientMask?: 'fade-bottom' | 'fade-top' | 'fade-edges' | 'vignette';
  clipPath?: 'circle' | 'ellipse' | 'diamond' | 'hexagon' | 'blob' | 'slant-left' | 'slant-right';
  tilt?: 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: any;
}

const {
  src,
  alt,
  role: roleProp,
  altWord,
  altDescriptive,
  altAacHtml,
  width,
  height,
  fit,
  radius,
  shadow,
  hover = false,
  responsive = false,
  decorative = false,
  loading = 'lazy',
  sepia,
  blur,
  gradientMask,
  clipPath,
  tilt,
  class: className,
  ...rest
} = Astro.props;

// Resolve role — decorative boolean is deprecated alias
const isDecorative = roleProp === 'decorative' || decorative;

// Extract data-* attributes
const dataAttrs = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key.startsWith('data-'))
);

// Resolve alt text: altWord wins over manual alt prop
const resolvedAlt = isDecorative
  ? ''
  : (altWord || alt || '');

// Image element classes (visual treatment)
const imgClasses = [
  'image__img',
  fit ? `image--fit-${fit}` : '',
  radius ? `image--radius-${radius}` : '',
  shadow ? `image--shadow-${shadow}` : '',
  hover ? 'image--hover' : '',
  responsive ? 'image--responsive' : '',
  sepia ? `image--sepia-${sepia}` : '',
  blur ? `image--blur-${blur}` : '',
  gradientMask ? `image--mask-${gradientMask}` : '',
  clipPath ? `image--clip-${clipPath}` : '',
  tilt ? `image--tilt-${tilt}` : '',
  className,
].filter(Boolean);
---

{isDecorative ? (
  <img
    src={src}
    alt=""
    width={width}
    height={height}
    loading={loading}
    class:list={imgClasses}
    aria-hidden="true"
    role="presentation"
    {...dataAttrs}
  />
) : (
  <figure class="image" data-role="content">
    <img
      src={src}
      alt={resolvedAlt}
      width={width}
      height={height}
      loading={loading}
      class:list={imgClasses}
      {...dataAttrs}
    />
    {altWord && (
      <span class="image-alt-word" aria-hidden="true">{altWord}</span>
    )}
    {altDescriptive && (
      <span class="image-alt-descriptive" aria-hidden="true">{altDescriptive}</span>
    )}
    {altAacHtml && (
      <span class="image-alt-aac" aria-hidden="true">
        <Fragment set:html={altAacHtml} />
      </span>
    )}
  </figure>
)}
