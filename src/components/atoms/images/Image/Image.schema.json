{
  "component": "Image",
  "category": "atoms/images",
  "renders": {
    "base": "Image.astro"
  },
  "reducedMotion": "Hover scale transition killed.",
  "props": {
    "src":          { "type": "string",  "required": true },
    "alt":          { "type": "string",  "required": true },
    "width":        { "type": "string",  "required": false },
    "height":       { "type": "string",  "required": false },
    "fit":          { "type": "string",  "required": false, "enum": ["cover", "contain", "fill", "none"] },
    "radius":       { "type": "string",  "required": false, "enum": ["none", "sm", "md", "lg", "full"] },
    "shadow":       { "type": "string",  "required": false, "enum": ["none", "sm", "md", "lg"] },
    "hover":        { "type": "boolean", "required": false, "default": false },
    "responsive":   { "type": "boolean", "required": false, "default": false },
    "decorative":   { "type": "boolean", "required": false, "default": false },
    "loading":      { "type": "string",  "required": false, "default": "lazy", "enum": ["lazy", "eager"] },
    "sepia":        { "type": "string",  "required": false, "enum": ["light", "default", "heavy"] },
    "blur":         { "type": "string",  "required": false, "enum": ["sm", "md", "lg", "xl"] },
    "gradientMask": { "type": "string",  "required": false, "enum": ["fade-bottom", "fade-top", "fade-edges", "vignette"] },
    "clipPath":     { "type": "string",  "required": false, "enum": ["circle", "ellipse", "diamond", "hexagon", "blob", "slant-left", "slant-right"] },
    "tilt":         { "type": "string",  "required": false, "enum": ["sm", "md", "lg"] },
    "class":        { "type": "string",  "required": false, "default": "" }
  }
}
