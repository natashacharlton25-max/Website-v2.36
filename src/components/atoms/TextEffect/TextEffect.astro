---
/**
 * TextEffect — Visual text treatment atom
 *
 * Decorative text with image fill, gradient fill, animated gradients,
 * shadows, strokes, SVG inner shadow filters.
 * Separate from Heading/Text atoms which are semantic — this is pure visual.
 *
 * Hover gates: animation gated by data-hover on body
 * Render modes: textonly strips to plain text, reduced kills animation
 *
 * ─────────────────────────────────────────────────────────────────────────
 * AUDIT TODO — text-as-SVG-paths integration
 * ─────────────────────────────────────────────────────────────────────────
 * The Burst atom's text-to-SVG pipeline (`scripts/build-text-paths.mjs` →
 * `src/lib/text-paths/generated.ts` → TEXT_PATHS map of pre-baked
 * per-character SVG path arrays) is the right primitive for unlocking
 * advanced text effects on this atom:
 *
 *   - Draw-in stroke animation — text "writes itself" stroke-by-stroke
 *     on viewport entry using GSAP DrawSVG (same engine as Icon's draw)
 *   - SVG gradient fills that flow through the actual letter shapes
 *     (not just CSS gradient on a text bounding box)
 *   - Phrase morph — "BEFORE" → "AFTER" via GSAP MorphSVG, letters
 *     interpolate between their path data
 *   - No FOUT — paths render exactly the same way regardless of font
 *     load state, since the path is pre-baked at build time
 *
 * Implementation when audited:
 *   - Add `renderAs: 'svg'` opt-in (default 'html' stays for SEO/AT)
 *   - SVG mode reads phrase from registry.json (or runtime opentype if
 *     dynamic text needed — bigger bundle cost)
 *   - Existing Burst.astro already resolves `phrase:KEY` shorthand;
 *     extract that resolver to a shared lib so TextEffect can call it
 *   - Wire DrawSVG / MorphSVG via the existing Icon animation hooks
 *     (svg-animation/draw.ts and morph.ts)
 *
 * Not blocked on anything — defer to the per-effect audit pass.
 * ─────────────────────────────────────────────────────────────────────────
 */

interface Props {
  text: string;
  fillImage?: string;
  fillGradient?: string;
  /** Animated gradient — colors array builds flowing gradient */
  gradientColors?: string[];
  /** Gradient animation speed */
  gradientSpeed?: 'fast' | 'slow';
  /** Gradient trigger — always or hover-only */
  gradientTrigger?: 'always' | 'hover';
  /** Solid colour shown before hover gradient triggers */
  solidColor?: string;
  /** Shadow effect */
  shadow?: 'drop' | 'text' | 'glow';
  textStroke?: string;
  innerShadow?: boolean;
  size?: string;
  weight?: 'normal' | 'medium' | 'semibold' | 'bold' | 'extrabold' | 'black';
  family?: 'body' | 'heading' | 'mono' | 'handwriting' | 'display';
  tracking?: 'tight' | 'normal' | 'wide' | 'wider';
  uppercase?: boolean;
  align?: 'left' | 'center' | 'right';
  tag?: 'span' | 'div' | 'p' | 'h1' | 'h2' | 'h3';
  class?: string;
  [key: string]: any;
}

const {
  text,
  fillImage,
  fillGradient,
  gradientColors,
  gradientSpeed = 'slow',
  gradientTrigger = 'always',
  solidColor,
  shadow,
  textStroke,
  innerShadow = false,
  size,
  weight = 'black',
  family = 'display',
  tracking,
  uppercase = true,
  align,
  tag = 'span',
  class: className,
  ...rest
} = Astro.props;

const Tag = tag as any;

const filterId = innerShadow ? `inner-shadow-${Math.random().toString(36).slice(2, 8)}` : null;

const hasFill = fillImage || fillGradient || gradientColors;
const hasGradientAnim = gradientColors && gradientColors.length > 1;
const gradientCss = hasGradientAnim ? `linear-gradient(90deg, ${gradientColors.join(', ')})` : null;

const classes = [
  'text-effect',
  hasFill && 'text-effect--fill',
  hasGradientAnim && 'text-effect--gradient-anim',
  hasGradientAnim && `text-effect--gradient-${gradientSpeed}`,
  innerShadow && 'text-effect--inner-shadow',
  weight && `text-effect--weight-${weight}`,
  family && `text-effect--family-${family}`,
  tracking && `text-effect--tracking-${tracking}`,
  uppercase && 'text-effect--uppercase',
  align && `text-effect--align-${align}`,
  className,
];

const styles = [
  size && `font-size: ${size}`,
  fillImage && `background-image: url('${fillImage}')`,
  fillGradient && !gradientCss && `background-image: ${fillGradient}`,
  gradientCss && `--_te-gradient: ${gradientCss}`,
  solidColor && `--_te-solid: ${solidColor}`,
  shadow === 'text' && `text-shadow: 2px 2px 4px var(--neutral-600)`,
  shadow === 'drop' && `filter: drop-shadow(4px 4px 8px var(--neutral-600))`,
  shadow === 'glow' && `text-shadow: 0 0 20px var(--primary-600), 0 0 40px var(--primary-400)`,
  textStroke && `-webkit-text-stroke: ${textStroke}`,
  filterId && `filter: url(#${filterId})`,
  rest.style,
].filter(Boolean).join('; ');
---

{innerShadow && (
  <svg class="text-effect__svg" width="0" height="0" aria-hidden="true">
    <defs>
      <filter id={filterId} x="-50%" y="-50%" width="200%" height="200%">
        <feComponentTransfer in="SourceAlpha">
          <feFuncA type="table" tableValues="1 0" />
        </feComponentTransfer>
        <feGaussianBlur stdDeviation="3" />
        <feOffset dx="2" dy="2" result="offsetblur" />
        <feFlood flood-color="rgba(0,0,0,0.5)" result="color" />
        <feComposite in2="offsetblur" operator="in" />
        <feComposite in2="SourceAlpha" operator="in" />
        <feMerge>
          <feMergeNode in="SourceGraphic" />
          <feMergeNode />
        </feMerge>
      </filter>
    </defs>
  </svg>
)}

<Tag
  class:list={classes}
  style={styles || undefined}
  data-gradient-trigger={hasGradientAnim ? gradientTrigger : undefined}
  aria-hidden={tag === 'span' ? 'true' : undefined}
  {...Object.fromEntries(Object.entries(rest).filter(([k]) => k !== 'style'))}
>
  {text}
</Tag>

