{
  "component": "Grid",
  "category": "atom",
  "renders": { "full": "Grid.astro", "reduced": "Grid.astro", "textonly": "Grid.astro" },
  "notes": "Pure layout shell. Handles column count, gap, alignment. Children handle their own render mode behaviour.",

  "props": {
    "content": {
      "id":        { "type": "string",  "default": null },
      "separator": { "type": "boolean", "default": false }
    },

    "visual": {
      "variant":  { "type": "string",  "default": "fixed",    "enum": ["fixed", "inline", "auto-fit", "auto-fill"] },
      "columns":  { "type": "number",  "default": 3,          "enum": [1, 2, 3, 4, 5, 6] },
      "gap":      { "type": "string",  "default": "md",       "enum": ["none", "xs", "sm", "md", "lg", "xl", "2xl"] },
      "align":    { "type": "string",  "default": null,       "enum": ["start", "center", "end", "stretch"] },
      "flow":     { "type": "string",  "default": "row",      "enum": ["row", "dense", "column", "masonry"] }
    },

    "animation": {
      "gallery": { "type": "string", "default": null, "enum": ["showcase", "product"], "description": "Interactive gallery mode. Requires GSAP + Flip." }
    },

    "colour": {}
  },

  "slots": {
    "default": "Grid children — Cards, Badges, any atoms"
  }
}
