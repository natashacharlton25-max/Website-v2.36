---
/**
 * Image — Atomic image primitive (pure, no fetching)
 *
 * Every image (photos, illustrations, decorative SVGs, logos)
 * should go through this component. Icon SVGs use Icon.astro instead.
 *
 * Consumes theme tokens: --media-brightness, --media-saturation, --media-contrast
 * so monochrome/dark/high-contrast themes apply automatically.
 *
 * Styles: Image.css | Image.responsive.css
 *
 * Alt text data comes from the page/section that fetches it, not this atom.
 * Pages call fetchAltData() and pass results as altWord/altDescriptive/altAacHtml.
 *
 * Props:
 *   role      — "content" (default) wraps in <figure> with alt spans
 *               "decorative" renders bare <img alt="" aria-hidden="true">
 *   altWord        — Short word-level alt text (from API or manual)
 *   altDescriptive — Long descriptive alt text
 *   altAacCards    — Array of AacCardData objects (from load-alt-text.ts cards[])
 *   altAacHtml     — DEPRECATED: Pre-rendered AAC card HTML (use altAacCards)
 *   decorative     — DEPRECATED alias for role="decorative"
 *
 * Usage:
 *   <Image src="/images/photo.jpg" alt="A sunset" />
 *   <Image src="/images/photo.jpg" alt="A sunset" fit="cover" />
 *   <Image src="/images/hero.jpg" role="decorative" />
 *   <Image src="/images/card.jpg" alt="Product" radius="lg" shadow="md" />
 *   <Image src="/images/sunset.jpg" altWord="sunset" altDescriptive="A golden sunset" />
 */

import { Image as AstroImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { AacCard } from '../../molecules/aac/AacCard';
import type { AacCardData } from '../../../data/load-alt-text';

interface Props {
  src: string | ImageMetadata;
  alt?: string;
  role?: 'content' | 'decorative';
  altWord?: string;
  altDescriptive?: string;
  altAacCards?: AacCardData[];
  /** @deprecated Use altAacCards instead */
  altAacHtml?: string;
  semanticRole?: 'decorative' | 'ui-control' | 'content-symbol';
  width?: number | string;
  height?: number | string;
  fit?: 'cover' | 'contain' | 'fill' | 'none';
  radius?: 'none' | 'sm' | 'md' | 'lg' | 'full';
  shadow?: 'none' | 'sm' | 'md' | 'lg';
  hover?: boolean;
  responsive?: boolean;
  /** @deprecated Use role="decorative" instead */
  decorative?: boolean;
  loading?: 'lazy' | 'eager';
  sepia?: 'light' | 'default' | 'heavy';
  blur?: 'sm' | 'md' | 'lg' | 'xl';
  gradientMask?: 'fade-bottom' | 'fade-top' | 'fade-edges' | 'vignette';
  clipPath?: 'circle' | 'ellipse' | 'diamond' | 'hexagon' | 'blob' | 'slant-left' | 'slant-right';
  tilt?: 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: any;
}

const {
  src,
  alt,
  role: roleProp,
  altWord,
  altDescriptive,
  altAacCards,
  altAacHtml,
  semanticRole,
  width,
  height,
  fit,
  radius,
  shadow,
  hover = false,
  responsive = false,
  decorative = false,
  loading = 'lazy',
  sepia,
  blur,
  gradientMask,
  clipPath,
  tilt,
  class: className,
  ...rest
} = Astro.props;

// Resolve role — decorative boolean is deprecated alias
const isDecorative = roleProp === 'decorative' || decorative;

// Determine if src is an imported asset (ImageMetadata) or a URL string
const isOptimised = typeof src !== 'string';

// Extract data-* attributes
const dataAttrs = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key.startsWith('data-'))
);

// Resolve alt text: richest description wins for screen readers
const resolvedAlt = isDecorative
  ? ''
  : (altDescriptive || altWord || alt || '');

// Animation gate — true when any motion prop is set
const hasMotion = hover || tilt;

// Image element classes (visual treatment)
const imgClasses = [
  'image__img',
  fit && `image--fit-${fit}`,
  radius && `image--radius-${radius}`,
  shadow && `image--shadow-${shadow}`,
  hover && 'image--hover',
  responsive && 'image--responsive',
  sepia && `image--sepia-${sepia}`,
  blur && `image--blur-${blur}`,
  gradientMask && `image--mask-${gradientMask}`,
  clipPath && `image--clip-${clipPath}`,
  tilt && `image--tilt-${tilt}`,
  className,
];

// Figure wrapper classes — radius passed to figure so ::after can inherit
const figureClasses = [
  'image',
  hasMotion && 'image--animate',
  radius && `image--radius-${radius}`,
];
---

{isDecorative ? (
  isOptimised ? (
    <AstroImage
      src={src as ImageMetadata}
      alt=""
      width={width as number}
      height={height as number}
      loading={loading}
      class:list={imgClasses}
      aria-hidden="true"
      role="presentation"
      {...dataAttrs}
    />
  ) : (
    <img
      src={src as string}
      alt=""
      width={width}
      height={height}
      loading={loading}
      class:list={imgClasses}
      aria-hidden="true"
      role="presentation"
      {...dataAttrs}
    />
  )
) : (
  <figure class:list={figureClasses} data-role="content" data-semantic-role={semanticRole} tabindex="0">
    {isOptimised ? (
      <AstroImage
        src={src as ImageMetadata}
        alt={resolvedAlt}
        width={width as number}
        height={height as number}
        loading={loading}
        class:list={imgClasses}
        {...dataAttrs}
      />
    ) : (
      <img
        src={src as string}
        alt={resolvedAlt}
        width={width}
        height={height}
        loading={loading}
        class:list={imgClasses}
        {...dataAttrs}
      />
    )}
    {altWord && (
      <span class="image-alt-word" aria-hidden="true">{altWord}</span>
    )}
    {altDescriptive && (
      <span class="image-alt-descriptive" aria-hidden="true">{altDescriptive}</span>
    )}
    {altAacCards && altAacCards.length > 0 ? (
      <span class="image-alt-aac" aria-hidden="true">
        {altAacCards.map((card) => (
          <AacCard
            word={card.word}
            bciIndex={card.bciIndex ?? undefined}
            symbolSrc={card.symbolSrc ?? undefined}
            symbolId={card.symbolId ?? undefined}
            coreTier={card.coreTier}
            isIndicator={card.isIndicator}
          />
        ))}
      </span>
    ) : altAacHtml ? (
      <span class="image-alt-aac" aria-hidden="true">
        <Fragment set:html={altAacHtml} />
      </span>
    ) : null}
  </figure>
)}

<script>
  function initBlurReveal() {
    document.querySelectorAll<HTMLElement>('.image--hover').forEach((img) => {
      if (img.dataset.blurRevealInit) return;
      img.dataset.blurRevealInit = 'true';

      img.addEventListener('click', () => {
        const hover = document.body.dataset.hover;
        if (hover === 'none' && img.className.includes('image--blur')) {
          img.classList.toggle('image--revealed');
        }
      });
    });
  }

  initBlurReveal();
  document.addEventListener('astro:page-load', initBlurReveal);
</script>
