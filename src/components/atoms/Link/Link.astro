---
/**
 * Link — Atomic link primitive
 *
 * Every link should go through this component (except buttons — use <Button href>).
 * For links that need visual weight (glass, pill, padding), use Button with href.
 * The label renders through the Text atom — any Text prop can be forwarded via `text`.
 *
 * Styles: Link.css | Link.responsive.css
 *
 * Usage:
 *   { "component": "Link", "label": "About", "href": "/about" }
 *   { "component": "Link", "label": "About", "href": "/about", "variant": "underline" }
 *   { "component": "Link", "label": "Legal", "href": "/legal", "variant": "ghost",
 *     "text": { "family": "body", "weight": "medium" } }
 *   { "component": "Link", "label": "Example", "href": "https://example.com", "external": true }
 */
import { Text } from '../Text';
import type { TextColour, RainbowColour } from '../../../lib/shared-enums';

interface Props {
  /** Link display text. Pipeline content key. Renders through the Text atom. */
  contentLink: string;
  href: string;
  variant?: 'default' | 'underline' | 'highlight' | 'border' | 'ghost';
  /** Link colour — sets marker tokens. 'text' = body text scale (always readable). */
  color?: TextColour | RainbowColour;
  /** Text atom styling props forwarded to the nested Text — accepts any Text prop
   *  (family, size, weight, leading, uppercase, etc). Link locks 'as=span' and 'flush'. */
  textStyle?: Record<string, any>;
  weight?: 'normal' | 'medium' | 'semibold' | 'bold' | 'extrabold';
  uppercase?: boolean;
  flush?: boolean;
  /** Disabled state — ghost appearance, no hover, not-allowed cursor, aria-disabled. */
  disabled?: boolean;
  external?: boolean;
  target?: string;
  download?: string | boolean;
  rel?: string;
  id?: string;
  role?: string;
  ariaLabel?: string;
  underlineGrow?: boolean;
  highlightGrow?: boolean;
  shadowFill?: boolean;
  textSlide?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  contentLink: label,
  href,
  variant = 'default',
  color,
  textStyle: textProps,
  weight,
  uppercase = false,
  flush = false,
  disabled = false,
  external = false,
  target: targetProp,
  download,
  rel: relProp,
  id,
  role,
  ariaLabel,
  underlineGrow = false,
  highlightGrow = false,
  shadowFill = false,
  textSlide = false,
  class: className,
  ...rest
} = Astro.props;

// External links get safety attributes
const target = external ? '_blank' : targetProp;
const rel = external ? (relProp ?? 'noopener noreferrer') : relProp;

// Extract data-* attributes
const dataAttrs = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key.startsWith('data-'))
);

const classes = [
  'link',
  `link--${variant}`,
  color && `link--${color}`,
  weight && `link--weight-${weight}`,
  uppercase && 'link--uppercase',
  flush && 'link--flush',
  disabled && 'link--disabled',
  !disabled && underlineGrow && 'link--animate-underline-grow',
  !disabled && highlightGrow && 'link--animate-highlight-grow',
  !disabled && shadowFill && 'link--animate-shadow-fill',
  !disabled && textSlide && 'link--animate-text-slide',
  className,
];
---

<a
  href={href}
  class:list={classes}
  target={target}
  download={download}
  rel={rel}
  id={id}
  role={role as astroHTML.JSX.HTMLAttributes['role']}
  aria-label={ariaLabel}
  aria-disabled={disabled ? 'true' : undefined}
  tabindex={disabled ? -1 : undefined}
  {...dataAttrs}
><Text {...(textProps as any)} contentText={label} as="span" flush />{external && (
  <svg class="link__icon link__icon--external" viewBox="0 0 256 256" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="20" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="144 40 216 40 216 112" />
    <line x1="216" y1="40" x2="112" y2="144" />
    <path d="M184 144v64a8 8 0 0 1-8 8H48a8 8 0 0 1-8-8V80a8 8 0 0 1 8-8h64" />
  </svg>
)}{download && (
  <svg class="link__icon link__icon--download" viewBox="0 0 256 256" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="20" stroke-linecap="round" stroke-linejoin="round">
    <line x1="128" y1="144" x2="128" y2="32" />
    <polyline points="216 144 216 208 40 208 40 144" />
    <polyline points="168 104 128 144 88 104" />
  </svg>
)}</a>
