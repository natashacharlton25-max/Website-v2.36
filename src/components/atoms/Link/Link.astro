---
/**
 * Link — Atomic link primitive
 *
 * Every link should go through this component (except buttons — use <Button href>).
 * For links that need visual weight (glass, pill, padding), use Button with href.
 * Renders slot through Text atom for typography inheritance.
 *
 * Styles: Link.css | Link.responsive.css
 *
 * Usage:
 *   <Link href="/about">About</Link>
 *   <Link href="/about" variant="underline">About</Link>
 *   <Link href="/about" variant="underline" underlineGrow>About</Link>
 *   <Link href="/legal" variant="ghost" color="text-light">Quiet link</Link>
 *   <Link href="https://example.com" external>External</Link>
 */
import { Text } from '../Text';

interface Props {
  href: string;
  variant?: 'default' | 'underline' | 'highlight' | 'border' | 'ghost';
  color?: 'primary' | 'accent' | 'text' | 'muted' | 'inherit';
  weight?: 'normal' | 'medium' | 'semibold' | 'bold' | 'extrabold';
  uppercase?: boolean;
  flush?: boolean;
  external?: boolean;
  target?: string;
  download?: string | boolean;
  rel?: string;
  id?: string;
  role?: string;
  ariaLabel?: string;
  underlineGrow?: boolean;
  highlightGrow?: boolean;
  shadowFill?: boolean;
  textSlide?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  href,
  variant = 'default',
  color,
  weight,
  uppercase = false,
  flush = false,
  external = false,
  target: targetProp,
  download,
  rel: relProp,
  id,
  role,
  ariaLabel,
  underlineGrow = false,
  highlightGrow = false,
  shadowFill = false,
  textSlide = false,
  class: className,
  ...rest
} = Astro.props;

// External links get safety attributes
const target = external ? '_blank' : targetProp;
const rel = external ? (relProp ?? 'noopener noreferrer') : relProp;

// Extract data-* attributes
const dataAttrs = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key.startsWith('data-'))
);

const classes = [
  'link',
  `link--${variant}`,
  color && `link--color-${color}`,
  weight && `link--weight-${weight}`,
  uppercase && 'link--uppercase',
  flush && 'link--flush',
  underlineGrow && 'link--animate-underline-grow',
  highlightGrow && 'link--animate-highlight-grow',
  shadowFill && 'link--animate-shadow-fill',
  textSlide && 'link--animate-text-slide',
  className,
];
---

<a
  href={href}
  class:list={classes}
  target={target}
  download={download}
  rel={rel}
  id={id}
  role={role as astroHTML.JSX.HTMLAttributes['role']}
  aria-label={ariaLabel}
  {...dataAttrs}
><Text as="span" flush><slot /></Text></a>
