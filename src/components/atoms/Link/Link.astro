---
/**
 * Link — Atomic link primitive
 *
 * Every link should go through this component (except buttons — use <Button href>).
 * For links that need visual weight (glass, pill, padding), use Button with href.
 * The label renders through the Text atom — any Text prop can be forwarded via `textStyle`.
 *
 * Colour comes from the global .color--{name} mixin (colour.css). Link reads
 * --_color, --_tier-tint/mid/emphasis from the mixin to set its bridge tokens.
 *
 * Styles: Link.css | Link.responsive.css
 *
 * Usage:
 *   { "component": "Link", "contentLink": "About", "href": "/about" }
 *   { "component": "Link", "contentLink": "About", "href": "/about", "variant": "underline" }
 *   { "component": "Link", "contentLink": "Legal", "href": "/legal", "variant": "ghost",
 *     "textStyle": { "family": "body", "weight": "medium" } }
 *   { "component": "Link", "contentLink": "Example", "href": "https://example.com", "external": true }
 */
import { Text } from '../Text';
import { Icon } from '../Icon';
import type { TextColour, RainbowColour } from '../../../lib/shared-enums';

/** A single segment of a multi-part Link — either a plain text run or a clickable run. */
type LinkSegment = { nolink: string } | { link: string };

interface Props {
  /** Link content.
   *  - String: whole phrase is the link (one <a href> wraps everything).
   *  - Array of segments: each { link: "..." } becomes its own <a href> sharing this href,
   *    each { nolink: "..." } renders as plain inline text. All segments share textStyle.
   *  Pipeline content key. Renders through the Text atom. */
  contentLink: string | LinkSegment[];
  href: string;
  variant?: 'default' | 'bare' | 'underline' | 'highlight' | 'border' | 'ghost' | 'frame';
  /** Brand-scale colour. Use one of brandColor or rainbowColor. */
  brandColor?: TextColour;
  /** Rainbow palette colour (1-7). Use one of brandColor or rainbowColor. */
  rainbowColor?: RainbowColour;
  /** Text atom styling props forwarded to the nested Text — accepts any Text prop
   *  (family, size, weight, leading, uppercase, etc). Link locks 'as=span' and 'flush'.
   *  Default weight is semibold (set on .link CSS). Override via textStyle.weight. */
  textStyle?: Record<string, any>;
  uppercase?: boolean;
  flush?: boolean;
  /** Disabled state — strikethrough, not-allowed cursor, no hover/focus changes,
   *  href dropped so the <a> can't navigate. Sets aria-disabled=true and tabindex=-1. */
  disabled?: boolean;
  external?: boolean;
  target?: string;
  download?: string | boolean;
  rel?: string;
  id?: string;
  role?: string;
  ariaLabel?: string;
  underlineGrow?: boolean;
  highlightGrow?: boolean;
  shadowFill?: boolean;
  textSlide?: boolean;
  /** Animate the variant="underline" wavy line so it slides on hover.
   *  Only visible when paired with variant="underline" (the static wave
   *  is what's being animated). Harmless on other variants. */
  squiggle?: boolean;
  class?: string;
}

const {
  contentLink: label,
  href,
  variant = 'default',
  brandColor = 'text',
  rainbowColor,
  textStyle: textProps,
  uppercase = false,
  flush = false,
  disabled = false,
  external = false,
  target: targetProp,
  download,
  rel: relProp,
  id,
  role,
  ariaLabel,
  underlineGrow = false,
  highlightGrow = false,
  shadowFill = false,
  textSlide = false,
  squiggle = false,
  class: className,
} = Astro.props;

// External links get safety attributes
const target = external ? '_blank' : targetProp;
const rel = external ? (relProp ?? 'noopener noreferrer') : relProp;

// Resolve colour: rainbow wins over brand if both set; default to 'text'
// so blank links render at body-text colour (the expected default for
// links inside paragraphs). Setting brandColor/rainbowColor explicitly
// opts the link into a louder brand-coloured rest state.
// Always emits a color--{name} class so the global mixin sets --_color
// and Link.css reads from it via .link bridge tokens.
const colour = rainbowColor || brandColor || 'text';

const classes = [
  'link',
  `link--${variant}`,
  `color--${colour}`,
  uppercase && 'link--uppercase',
  flush && 'link--flush',
  disabled && 'link--disabled',
  !disabled && underlineGrow && 'link--animate-underline-grow',
  !disabled && highlightGrow && 'link--animate-highlight-grow',
  !disabled && shadowFill && 'link--animate-shadow-fill',
  !disabled && textSlide && 'link--animate-text-slide',
  !disabled && squiggle && 'link--animate-squiggle',
  className,
];

// Wrapper picks up className for the array-form parent (the per-segment <a>s
// only need the link styling classes, not consumer-supplied wrapper classes).
const phraseClasses = ['link-phrase', className];

// Normalise contentLink into segments. String stays string (single-link
// shorthand handled separately for back-compat). Array form is rendered
// segment-by-segment below.
const isArray = Array.isArray(label);
const segments: LinkSegment[] = isArray ? (label as LinkSegment[]) : [];
---

{isArray ? (
  <span class:list={phraseClasses} id={id}>
    {segments.map((seg) => (
      'link' in seg ? (
        <a
          href={disabled ? undefined : href}
          class:list={classes}
          target={target}
          download={download}
          rel={rel}
          role={role as astroHTML.JSX.HTMLAttributes['role']}
          aria-label={ariaLabel}
          aria-disabled={disabled ? 'true' : undefined}
          tabindex={disabled ? -1 : undefined}
        ><Text {...(textProps as any)} contentText={seg.link} as="span" flush /></a>
      ) : (
        <span class="link-phrase__plain"><Text {...(textProps as any)} contentText={seg.nolink} as="span" flush /></span>
      )
    ))}
    {external && <Icon name="arrow-square-out" weight="bold" semanticRole="decorative" class="link__icon link__icon--external" />}
    {download && <Icon name="download-simple" weight="bold" semanticRole="decorative" class="link__icon link__icon--download" />}
  </span>
) : (
  <a
    href={disabled ? undefined : href}
    class:list={classes}
    target={target}
    download={download}
    rel={rel}
    id={id}
    role={role as astroHTML.JSX.HTMLAttributes['role']}
    aria-label={ariaLabel}
    aria-disabled={disabled ? 'true' : undefined}
    tabindex={disabled ? -1 : undefined}
  ><Text {...(textProps as any)} contentText={label as string} as="span" flush />{external && <Icon name="arrow-square-out" weight="bold" semanticRole="decorative" class="link__icon link__icon--external" />}{download && <Icon name="download-simple" weight="bold" semanticRole="decorative" class="link__icon link__icon--download" />}</a>
)}
