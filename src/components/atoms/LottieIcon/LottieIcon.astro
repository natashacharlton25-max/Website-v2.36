---
/**
 * LottieIcon — API-backed animated icon using Lottie.
 *
 * Fetches Lottie JSON from the Asset Library API at build/render time
 * and inlines it as animationData. Falls back to `src` (legacy filesystem
 * path). When slug is provided, the API also returns the paired Phosphor
 * fallbackIcon so authors don't have to declare it manually.
 *
 * Colour: Lottie animations have baked-in colours by default
 * (nativeMode=true). Set nativeMode=false + brandColor/rainbowColor to
 * override every fill+stroke in the SVG with the global .color--{name}
 * mixin's --_color (post-init style strip, no !important).
 *
 * Motion: animation runtime is dynamically imported — when motion=none
 * lottie-web is never loaded, the static fallback Icon renders instead.
 *
 * Usage:
 *   <LottieIcon slug="lottie-menu" semanticRole="ui-control" labelLottieIcon="Open menu" />
 *   <LottieIcon slug="lottie-heart" animationTrigger="hover" animationRepeat="threeloop" />
 *   <LottieIcon slug="lottie-spinner" animationTrigger="autoplay" animationRepeat="loop" nativeMode={false} brandColor="primary" />
 *
 * Control via events:
 *   icon.dispatchEvent(new CustomEvent('lottie:play'));
 *   icon.dispatchEvent(new CustomEvent('lottie:stop'));
 *   icon.dispatchEvent(new CustomEvent('lottie:goToFrame', { detail: { frame: 0 } }));
 */

import { Icon } from '../Icon';
import type { TextColour, RainbowColour } from '../../../lib/shared-enums';

const ASSET_API_URL = import.meta.env.ASSET_API_URL || 'http://localhost:8787';
const ASSET_API_TOKEN = import.meta.env.ASSET_API_TOKEN || '';

interface Props {
  slug?: string;
  src?: string;
  /** Phosphor icon name for static fallback. Auto-resolved from API meta when slug is set. */
  fallbackIcon?: string;
  /** Free-form label. Required when semanticRole is ui-control or content-symbol. */
  labelLottieIcon?: string;
  /** Semantic role — matches Icon's vocabulary so atoms compose cleanly. */
  semanticRole?: 'decorative' | 'ui-control' | 'content-symbol';
  /** Named em-based size token (xs–8xl).
   *  Undefined = inherit text size via 1em (matches Icon atom). */
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | 'base' | '2xl' | '3xl' | '4xl' | '5xl' | '6xl' | '7xl' | '8xl';
  /** true (default) preserves Lottie baked colours. false applies brand/rainbow colour via mixin. */
  nativeMode?: boolean;
  /** Brand colour override (only used when nativeMode=false). */
  brandColor?: TextColour;
  /** Rainbow colour override (only used when nativeMode=false). */
  rainbowColor?: RainbowColour;
  /** Animation trigger — matches Icon's vocabulary exactly. */
  animationTrigger?: 'hover' | 'viewport' | 'autoplay' | 'loop' | 'interval' | 'click' | 'focus' | 'none';
  /** Repeat behaviour — matches Icon's vocabulary exactly. */
  animationRepeat?: 'once' | 'loop' | 'three' | 'threeloop';
  /** Gap between attention-pulse bursts. Token-driven (short/base/long/longer)
   *  with motion-mode scaling — gentle = 2× longer pause. Matches Icon. */
  animationInterval?: 'short' | 'base' | 'long' | 'longer';
  class?: string;
  id?: string;
}

const {
  slug,
  src,
  fallbackIcon,
  labelLottieIcon,
  semanticRole = 'decorative',
  size,
  nativeMode = true,
  brandColor,
  rainbowColor,
  animationTrigger = 'hover',
  animationRepeat = 'threeloop',
  animationInterval = 'base',
  class: className = '',
  id,
} = Astro.props;

// Resolve colour: rainbow wins over brand. Only emitted when nativeMode=false.
const colour = !nativeMode ? (rainbowColor || brandColor || 'primary') : null;

// ui-control / content-symbol need a label for accessibility
const isInformational = semanticRole === 'ui-control' || semanticRole === 'content-symbol';
if (isInformational && !labelLottieIcon && import.meta.env.DEV) {
  console.warn(`[LottieIcon] semanticRole="${semanticRole}" requires labelLottieIcon for accessibility`);
}

// Fetch Lottie JSON + fallback icon from API at build/render time
let animationData: string | null = null;
let resolvedFallbackIcon: string | null = fallbackIcon || null;

if (slug) {
  try {
    const headers: Record<string, string> = {};
    if (ASSET_API_TOKEN) {
      headers['Authorization'] = `Bearer ${ASSET_API_TOKEN}`;
    }

    // Fetch animation data
    const res = await fetch(`${ASSET_API_URL}/v1/assets/${slug}`, { headers });
    if (res.ok) {
      animationData = await res.text();
    }

    // Fetch fallback icon slug from lottie_mappings (if not passed as prop)
    if (!resolvedFallbackIcon) {
      const metaRes = await fetch(`${ASSET_API_URL}/v1/assets/${slug}/meta`, { headers });
      if (metaRes.ok) {
        const meta = await metaRes.json() as Record<string, any>;
        if (meta.fallbackIcon) {
          resolvedFallbackIcon = meta.fallbackIcon;
        }
      }
    }
  } catch {
    // Fall through to src-based loading
  }
}

const classes = [
  'lottie-icon',
  size && `lottie-icon--size-${size}`,
  colour && `color--${colour}`,
  className,
];
---

<div
  class:list={classes}
  data-lottie-icon
  data-anim-trigger={animationTrigger}
  data-anim-repeat={animationRepeat}
  data-anim-interval={animationInterval}
  data-lottie-native={nativeMode ? 'true' : 'false'}
  data-semantic-role={semanticRole}
  {...(labelLottieIcon ? { role: 'img', 'aria-label': labelLottieIcon } : { 'aria-hidden': 'true' })}
  tabindex={semanticRole === 'ui-control' || animationTrigger === 'hover' || animationTrigger === 'click' || animationTrigger === 'focus' ? '0' : undefined}
  id={id}
  {...(src && !animationData ? { 'data-lottie-src': src } : {})}
>
  {animationData ? (
    <div class="lottie-icon__container" data-lottie-container></div>
  ) : null}
  {resolvedFallbackIcon ? (
    <Icon name={resolvedFallbackIcon} size={size} class={animationData ? "lottie-icon__static" : "lottie-icon__fallback-only"} />
  ) : !animationData ? (
    <span class="lottie-icon__empty" aria-hidden="true"></span>
  ) : null}
  {animationData && (
    <script is:inline type="application/json" data-lottie-data set:html={animationData} />
  )}
</div>

<script>
  // LottieIcon plays back via Lottie, but trigger orchestration goes
  // through registerTrigger so motion/hover/render gates, viewport
  // stagger queue, and click/focus/interval all behave consistently
  // with Icon. Repeat semantics (once/loop/three/threeloop) match Icon.
  // motion=none = no Lottie loaded at all (static fallback Icon shows).
  import {
    getAnimationConfig,
    onThemeChange,
    registerTrigger,
    getIntervalSeconds,
  } from '../../../lib/animation/animation-config';

  interface LottieIconElement extends HTMLElement {
    _lottieAnim?: any;
    _lottieDirection?: 1 | -1;
    _lottieUnsubscribe?: () => void;
  }

  /**
   * Strip Lottie's runtime-injected inline fill/stroke styles so the
   * global .color--{name} mixin colour can win via currentColor.
   *
   * Runs once on DOMLoaded (covers the initial paint of all layers).
   * For Lottie animations that DON'T animate colour values (the common
   * case — most animated icons keep static layer colours), one strip is
   * sufficient: Lottie only writes inline fill/stroke when a layer's
   * keyframe value changes. Static colours = no rewrites = our strip
   * persists.
   *
   * Edge case: colour-animated Lotties with nativeMode=false will only
   * have their FIRST frame's colours overridden. Document if that becomes
   * a real-world problem.
   *
   * nativeMode=true skips this entirely — the baked colours are preserved.
   */
  function stripLottieInlineColours(container: HTMLElement) {
    const targets = container.querySelectorAll('path, rect, circle, line, ellipse, polygon, polyline');
    targets.forEach(el => {
      const svg = el as SVGElement;
      svg.style.removeProperty('fill');
      svg.style.removeProperty('stroke');
    });
  }

  async function initLottieIcon(element: LottieIconElement) {
    const container = element.querySelector('[data-lottie-container]') as HTMLElement;
    if (!container || element._lottieAnim) return;

    // Motion gate — bail if animation is off site-wide.
    if (!getAnimationConfig().canAnimate) return;

    const animTrigger = element.dataset.animTrigger || 'hover';
    const animRepeat = (element.dataset.animRepeat || 'threeloop') as 'once' | 'loop' | 'three' | 'threeloop';
    const intervalToken = (element.dataset.animInterval || 'base') as 'short' | 'base' | 'long' | 'longer';
    const nativeMode = element.dataset.lottieNative !== 'false';

    // Lottie's loop flag — only true when repeat=loop (continuous infinite).
    // three/threeloop manage their own repeat counts via onComplete, so
    // Lottie itself only plays once per "play" call in those modes.
    const lottieLoop = animRepeat === 'loop';

    // Try inlined animation data first, then fall back to src URL
    const dataScript = element.querySelector('[data-lottie-data]');
    const src = element.dataset.lottieSrc;

    // Dynamic import — only loads lottie-web when an animation actually fires
    const { default: lottie } = await import('lottie-web');

    let animConfig: any;

    if (dataScript?.textContent) {
      try {
        const animationData = JSON.parse(dataScript.textContent);
        animConfig = { container, renderer: 'svg', loop: lottieLoop, autoplay: false, animationData };
      } catch {
        return; // Invalid JSON — skip
      }
    } else if (src) {
      animConfig = { container, renderer: 'svg', loop: lottieLoop, autoplay: false, path: src };
    } else {
      return; // No data source
    }

    try {
      const anim = lottie.loadAnimation(animConfig);

      element._lottieAnim = anim;
      element._lottieDirection = 1;

      // Apply duration scale so LottieIcon respects motion mode the same
      // way Icon does. gentle = 2x slower, full = native speed. setSpeed(0.5)
      // halves playback, setSpeed(1) is native. Inverse of durationScale
      // because longer duration = slower speed. Re-applies on theme change
      // so live mode-switching takes effect without remount.
      const applySpeed = () => {
        const cfg = getAnimationConfig();
        anim.setSpeed(1 / cfg.durationScale);
      };
      applySpeed();
      // Re-apply when theme/mode changes via the shared pub/sub. Single
      // observer site-wide (in gates/theme-change.ts), every LottieIcon
      // registers a callback into it. Stored on the element so cleanup
      // can unsubscribe before unmount.
      element._lottieUnsubscribe = onThemeChange(applySpeed);

      // Colour override: when nativeMode=false, strip Lottie's inline
      // fill/stroke styles after initial paint so the global .color--{name}
      // mixin's currentColor inherits. One-shot on DOMLoaded — sufficient
      // for static-colour Lotties (the common case). See function docstring.
      if (!nativeMode) {
        anim.addEventListener('DOMLoaded', () => stripLottieInlineColours(container));
      }

      // Custom events for control
      element.addEventListener('lottie:play', () => {
        element._lottieDirection = 1;
        anim.setDirection(1);
        anim.play();
      });

      element.addEventListener('lottie:playReverse', () => {
        element._lottieDirection = -1;
        anim.setDirection(-1);
        anim.play();
      });

      element.addEventListener('lottie:stop', () => { anim.stop(); });
      element.addEventListener('lottie:pause', () => { anim.pause(); });

      element.addEventListener('lottie:goToFrame', ((e: CustomEvent) => {
        const frame = e.detail?.frame ?? 0;
        anim.goToAndStop(frame, true);
      }) as EventListener);

      element.addEventListener('lottie:toggle', () => {
        if (element._lottieDirection === 1) {
          element._lottieDirection = -1;
          anim.setDirection(-1);
        } else {
          element._lottieDirection = 1;
          anim.setDirection(1);
        }
        anim.play();
      });

      anim.stop();

      // Repeat handler — counts plays per "burst" and rewinds/pauses
      // per animationRepeat semantics. Wired once (we attach a single
      // 'complete' listener); reset playCount each time onEnter is
      // invoked so each new trigger starts a fresh burst.
      let playCount = 0;
      const handleComplete = () => {
        playCount++;
        if (animRepeat === 'three' && playCount < 3) {
          anim.goToAndStop(0, true);
          anim.play();
        } else if (animRepeat === 'threeloop') {
          if (playCount < 3) {
            anim.goToAndStop(0, true);
            anim.play();
          } else {
            anim.stop();
            playCount = 0;
            // Read interval at fire time so motion-mode scaling is current.
            // getIntervalSeconds returns seconds; setTimeout takes ms.
            const cfg = getAnimationConfig();
            const intervalMs = getIntervalSeconds(intervalToken, cfg.durationScale) * 1000;
            setTimeout(() => {
              if (!getAnimationConfig().canAnimate) return;
              anim.goToAndStop(0, true);
              anim.play();
            }, intervalMs);
          }
        }
        // 'once' = stop naturally; 'loop' = Lottie's own loop handles it.
      };
      anim.addEventListener('complete', handleComplete);

      // Wire trigger via registerTrigger — same orchestration pipeline
      // as Icon. Lottie remains the playback engine; registerTrigger
      // handles motion/hover/render gating, viewport stagger queue,
      // explainer click remap, re-trigger guard.
      registerTrigger({
        el: element,
        trigger: animTrigger,
        onEnter: () => {
          playCount = 0;
          element._lottieDirection = 1;
          anim.setDirection(1);
          anim.goToAndStop(0, true);
          anim.play();
          // No GSAP timeline to return — registerTrigger's re-trigger
          // guard only protects against simultaneous fires, not Lottie
          // playback overlap. Lottie handles overlap itself by ignoring
          // play() on an already-playing instance.
          return null;
        },
        onLeave: () => {
          // Hover-leave: reverse playback for symmetric exit.
          element._lottieDirection = -1;
          anim.setDirection(-1);
          anim.play();
          return null;
        },
        onStatic: () => {
          // motion=none — fallback Icon already in DOM via CSS swap.
          // Nothing to do here; the dynamic Lottie import never runs.
        },
      });

    } catch (e) {
      console.error('Failed to load Lottie animation:', e);
    }
  }

  function initAllLottieIcons() {
    const icons = document.querySelectorAll('[data-lottie-icon]') as NodeListOf<LottieIconElement>;
    icons.forEach(el => { void initLottieIcon(el); });
  }

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllLottieIcons);
  } else {
    initAllLottieIcons();
  }

  // Support Astro page transitions
  document.addEventListener('astro:page-load', initAllLottieIcons);

  // Cleanup before page swap — destroy animations and unregister theme
  // listeners so callbacks don't pile up across navigations.
  document.addEventListener('astro:before-swap', () => {
    const icons = document.querySelectorAll('[data-lottie-icon]') as NodeListOf<LottieIconElement>;
    icons.forEach(el => {
      if (el._lottieAnim) {
        el._lottieAnim.destroy();
        el._lottieAnim = undefined;
      }
      if (el._lottieUnsubscribe) {
        el._lottieUnsubscribe();
        el._lottieUnsubscribe = undefined;
      }
    });
  });
</script>
