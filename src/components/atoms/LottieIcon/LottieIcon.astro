---
/**
 * LottieIcon — API-backed animated icon using Lottie
 *
 * Fetches Lottie JSON from the Asset Library API at build/render time
 * and inlines it as animationData (no runtime network dependency).
 * Falls back to `src` prop (legacy filesystem path) if slug is not provided.
 *
 * Usage (API-backed):
 *   <LottieIcon slug="lottie-menu" size={24} />
 *
 * Usage (legacy — filesystem path):
 *   <LottieIcon src="/Icons/Animated Icons/Menu V2/menuV2.json" size={24} />
 *
 * Control via JavaScript:
 *   const icon = document.querySelector('[data-lottie-icon]');
 *   icon.dispatchEvent(new CustomEvent('lottie:play'));
 *   icon.dispatchEvent(new CustomEvent('lottie:playReverse'));
 *   icon.dispatchEvent(new CustomEvent('lottie:stop'));
 *   icon.dispatchEvent(new CustomEvent('lottie:goToFrame', { detail: { frame: 0 } }));
 */

import { Icon } from '../Icon';

const ASSET_API_URL = import.meta.env.ASSET_API_URL || 'http://localhost:8787';
const ASSET_API_TOKEN = import.meta.env.ASSET_API_TOKEN || '';

interface Props {
  slug?: string;
  src?: string;
  label?: string;
  /** Phosphor icon name for static fallback (shown in reduced/highlight/focus/textonly) */
  fallbackIcon?: string;
  size?: number;
  /** Animation trigger mode — replaces autoplay/loop */
  trigger?: 'autoplay' | 'loop' | 'hover' | 'viewport' | 'interval' | 'none';
  /** Interval in ms (only used with trigger="interval") */
  interval?: number;
  loop?: boolean;
  autoplay?: boolean;
  class?: string;
  id?: string;
  [key: string]: any;
}

const {
  slug,
  src,
  label,
  fallbackIcon,
  size = 24,
  trigger = 'none',
  interval = 3000,
  loop = false,
  autoplay = false,
  class: className = '',
  id,
  ...rest
} = Astro.props;

// Resolve trigger to loop/autoplay for backward compat
const resolvedLoop = trigger === 'loop' || loop;
const resolvedAutoplay = trigger === 'autoplay' || trigger === 'loop' || autoplay;

// Fetch Lottie JSON + fallback icon from API at build/render time
let animationData: string | null = null;
let resolvedFallbackIcon: string | null = fallbackIcon || null;

if (slug) {
  try {
    const headers: Record<string, string> = {};
    if (ASSET_API_TOKEN) {
      headers['Authorization'] = `Bearer ${ASSET_API_TOKEN}`;
    }

    // Fetch animation data
    const res = await fetch(`${ASSET_API_URL}/v1/assets/${slug}`, { headers });
    if (res.ok) {
      animationData = await res.text();
    }

    // Fetch fallback icon slug from lottie_mappings (if not passed as prop)
    if (!resolvedFallbackIcon) {
      const metaRes = await fetch(`${ASSET_API_URL}/v1/assets/${slug}/meta`, { headers });
      if (metaRes.ok) {
        const meta = await metaRes.json() as Record<string, any>;
        if (meta.fallbackIcon) {
          resolvedFallbackIcon = meta.fallbackIcon;
        }
      }
    }
  } catch {
    // Fall through to src-based loading
  }
}
---

<div
  class:list={['lottie-icon', className]}
  data-lottie-icon
  data-lottie-trigger={trigger}
  data-lottie-interval={trigger === 'interval' ? interval : undefined}
  data-lottie-loop={resolvedLoop}
  data-lottie-autoplay={resolvedAutoplay}
  data-semantic-role="decorative"
  {...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' })}
  style={`width: ${size}px; height: ${size}px;`}
  id={id}
  {...(src && !animationData ? { 'data-lottie-src': src } : {})}
>
  <div class="lottie-icon__container" data-lottie-container></div>
  {resolvedFallbackIcon && (
    <Icon name={resolvedFallbackIcon} class="lottie-icon__static" />
  )}
  {animationData && (
    <script is:inline type="application/json" data-lottie-data set:html={animationData} />
  )}
</div>

<script>
  import lottie from 'lottie-web';
  import type { AnimationItem } from 'lottie-web';

  interface LottieIconElement extends HTMLElement {
    _lottieAnim?: AnimationItem;
    _lottieDirection?: 1 | -1;
  }

  function initLottieIcon(element: LottieIconElement) {
    const container = element.querySelector('[data-lottie-container]') as HTMLElement;
    if (!container || element._lottieAnim) return;

    const loop = element.dataset.lottieLoop === 'true';
    const autoplay = element.dataset.lottieAutoplay === 'true';

    // Try inlined animation data first, then fall back to src URL
    const dataScript = element.querySelector('[data-lottie-data]');
    const src = element.dataset.lottieSrc;

    let animConfig: Parameters<typeof lottie.loadAnimation>[0];

    if (dataScript?.textContent) {
      try {
        const animationData = JSON.parse(dataScript.textContent);
        animConfig = { container, renderer: 'svg', loop, autoplay, animationData };
      } catch {
        return; // Invalid JSON — skip
      }
    } else if (src) {
      animConfig = { container, renderer: 'svg', loop, autoplay, path: src };
    } else {
      return; // No data source
    }

    try {
      const anim = lottie.loadAnimation(animConfig);

      element._lottieAnim = anim;
      element._lottieDirection = 1;

      // Custom events for control
      element.addEventListener('lottie:play', () => {
        element._lottieDirection = 1;
        anim.setDirection(1);
        anim.play();
      });

      element.addEventListener('lottie:playReverse', () => {
        element._lottieDirection = -1;
        anim.setDirection(-1);
        anim.play();
      });

      element.addEventListener('lottie:stop', () => {
        anim.stop();
      });

      element.addEventListener('lottie:pause', () => {
        anim.pause();
      });

      element.addEventListener('lottie:goToFrame', ((e: CustomEvent) => {
        const frame = e.detail?.frame ?? 0;
        anim.goToAndStop(frame, true);
      }) as EventListener);

      element.addEventListener('lottie:toggle', () => {
        if (element._lottieDirection === 1) {
          element._lottieDirection = -1;
          anim.setDirection(-1);
        } else {
          element._lottieDirection = 1;
          anim.setDirection(1);
        }
        anim.play();
      });

      // Trigger modes
      const trigger = element.dataset.lottieTrigger || 'none';

      if (trigger === 'hover') {
        anim.autoplay = false;
        anim.stop();

        function isHoverGated(): boolean {
          return document.body.dataset.hover === 'none';
        }

        element.addEventListener('mouseenter', () => {
          if (isHoverGated()) return;
          anim.setDirection(1); anim.play();
        });
        element.addEventListener('mouseleave', () => {
          if (isHoverGated()) return;
          anim.setDirection(-1); anim.play();
        });
        // Focus always works — keyboard/AT users need it regardless of hover gate
        element.addEventListener('focusin', () => { anim.setDirection(1); anim.play(); });
        element.addEventListener('focusout', () => { anim.setDirection(-1); anim.play(); });
      }

      if (trigger === 'viewport') {
        anim.autoplay = false;
        anim.stop();
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              anim.goToAndStop(0, true);
              anim.play();
              observer.unobserve(element);
            }
          }
        }, { threshold: 0.5 });
        observer.observe(element);
      }

      if (trigger === 'interval') {
        const ms = parseInt(element.dataset.lottieInterval || '3000', 10);
        const repeats = parseInt(element.dataset.lottieRepeats || '3', 10);
        anim.autoplay = false;
        anim.stop();
        let playCount = 0;
        anim.addEventListener('complete', () => {
          playCount++;
          if (playCount < repeats) {
            anim.goToAndStop(0, true);
            anim.play();
          } else {
            anim.stop();
            playCount = 0;
            setTimeout(() => { anim.goToAndStop(0, true); anim.play(); }, ms);
          }
        });
        anim.play();
      }

    } catch (e) {
      console.error('Failed to load Lottie animation:', e);
    }
  }

  function initAllLottieIcons() {
    const icons = document.querySelectorAll('[data-lottie-icon]') as NodeListOf<LottieIconElement>;
    icons.forEach(initLottieIcon);
  }

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllLottieIcons);
  } else {
    initAllLottieIcons();
  }

  // Support Astro page transitions
  document.addEventListener('astro:page-load', initAllLottieIcons);
</script>
