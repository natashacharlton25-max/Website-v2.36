---
/**
 * Section — Layout atom for content grouping
 *
 * Pure class mapping. CSS defines all visual behaviour.
 * JSON provides enum values → Astro maps to classes → CSS handles the rest.
 *
 * Usage:
 *   <Section>Content here</Section>
 *   <Section container="md" gap="lg" separator>Constrained with dividers</Section>
 *   <Section color="teal" separator separatorWeight="medium">Coloured zone</Section>
 */

interface Props {
  as?: 'section' | 'div' | 'article' | 'aside' | 'main';
  container?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | '6xl' | '7xl' | 'full' | 'prose';
  gap?: 'none' | 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | '6xl' | '7xl';
  color?: 'primary' | 'secondary' | 'neutral' | 'red' | 'orange' | 'yellow' | 'teal' | 'blue' | 'purple' | 'pink';
  separator?: boolean;
  separatorWeight?: 'thin' | 'medium' | 'thick';
  label?: string;
  labelSize?: 'h5' | 'h6';
  flush?: boolean;
  class?: string;
}

const {
  as: Tag = 'section',
  container,
  gap = 'lg',
  color,
  separator = false,
  separatorWeight = 'thin',
  label,
  labelSize = 'h6',
  flush = false,
  class: className,
} = Astro.props;
---

<Tag
  class:list={[
    'section-atom',
    `section-atom--gap-${gap}`,
    color && `section-atom--${color}`,
    container && `container container-${container}`,
    separator && 'section-atom--separated',
    separator && `section-atom--sep-${separatorWeight}`,
    flush && 'section-atom--flush',
    className,
  ]}
>
  {label && (
    <div class="section-atom__label">
      <span class:list={['section-atom__label-text', `section-atom__label--${labelSize}`]}>{label}</span>
    </div>
  )}
  <div class="section-atom__content">
    <slot />
  </div>
</Tag>
