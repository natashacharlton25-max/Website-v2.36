{
  "component": "Section",
  "category": "atom",
  "renders": { "full": "Section.astro", "reduced": "Section.astro", "assistive": "Section.astro", "textonly": "Section.astro" },
  "notes": "Layout atom for grouping content with consistent spacing, separators, and optional labels. Used as chroma zone wrapper for colour context.",

  "props": {
    "content": {
      "_description": "What the section contains",
      "label": { "type": "string", "required": false, "default": null, "description": "Section label text." }
    },

    "visual": {
      "_description": "How the section looks",
      "as":              { "type": "string",  "required": false, "default": "section", "enum": ["section","div","article","aside","main"], "description": "HTML element." },
      "maxWidth":        { "type": "string",  "required": false, "default": null, "description": "Max width constraint (e.g. 960px)." },
      "padding":         { "type": "string",  "required": false, "default": "none", "enum": ["none","sm","md","lg","xl","2xl"], "description": "Inner padding." },
      "gap":             { "type": "string",  "required": false, "default": "lg", "enum": ["none","xs","sm","md","lg","xl","2xl","3xl"], "description": "Spacing between children." },
      "separator":       { "type": "boolean", "required": false, "default": false, "description": "Show divider below label." },
      "separatorWeight": { "type": "string",  "required": false, "default": "thin", "enum": ["thin","medium","thick"], "description": "Separator line weight." },
      "labelSize":       { "type": "string",  "required": false, "default": "h6", "enum": ["h5","h6"], "description": "Label font size." },
      "flush":           { "type": "boolean", "required": false, "default": false, "description": "Remove bottom margin." }
    },

    "colour": {
      "_description": "Pipeline colour tokens — passed as inline style",
      "sectionSeparator": { "type": "token", "required": false, "default": "neutral-400", "cssProperty": "--section-separator", "description": "Separator line colour." }
    },

    "animation": {}
  },

  "slots": {
    "default": "Section content — any atoms or molecules"
  }
}
