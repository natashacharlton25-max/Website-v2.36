      "gap":             { "type": "string",  "default": "lg",      "enum": ["none","xs","sm","md","lg","xl","2xl","3xl"] },
      "color":           { "type": "string",  "default": null,      "enum": ["primary","secondary","neutral","red","orange","yellow","teal","blue","purple","pink"] },
      "bg":              { "type": "string",  "default": null,      "enum": ["none","tint","light","solid"] },
      "separator":       { "type": "boolean", "default": false },
      "separatorWeight": { "type": "string",  "default": "thin",    "enum": ["thin","medium","thick"] }
    },

    "animation": {},
    "colour": {}
  },

  "slots": {
    "default": "Section content — any atoms or molecules"
  }
