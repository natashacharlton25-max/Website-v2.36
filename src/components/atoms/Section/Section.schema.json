{
  "component": "Section",
  "category": "atom",
  "renders": { "full": "Section.astro", "reduced": "Section.astro", "textonly": "Section.astro" },
  "notes": "Pure container. Owns background, spacing, separator, colour zone. Children slotted.",

  "props": {
    "content": {},

    "visual": {
      "as":              { "type": "string",  "default": "section", "enum": ["section","div","article","aside","main"] },
