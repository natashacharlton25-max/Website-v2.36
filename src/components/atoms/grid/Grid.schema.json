{
  "component": "Grid",
  "category": "atoms/grid",
  "renders": {
    "base": "Grid.astro"
  },
  "props": {
    "columns":   { "type": "number",  "required": false, "default": 3, "enum": [1, 2, 3, 4, 5, 6] },
    "gap":       { "type": "string",  "required": false, "default": "var(--space-xl)" },
    "align":     { "type": "string",  "required": false, "default": "stretch", "enum": ["stretch", "start", "center", "end"] },
    "minWidth":  { "type": "string",  "required": false },
    "container": { "type": "string",  "required": false, "default": "none", "enum": ["4xl", "6xl", "7xl", "full", "none"] },
    "flow":      { "type": "string",  "required": false, "default": "row", "enum": ["row", "dense", "column", "masonry"] },
    "gallery":   { "type": "string",  "required": false, "enum": ["showcase", "product"] },
    "separator": { "type": "boolean", "required": false, "default": true },
    "class":     { "type": "string",  "required": false, "default": "" },
    "id":        { "type": "string",  "required": false }
  }
}
