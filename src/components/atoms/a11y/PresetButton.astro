---
/**
 * PresetButton - Accessibility Preset Button Component
 *
 * A button for quick accessibility presets with icon and title.
 * Used in the a11y panel sidebar for preset selection.
 *
 * Usage:
 * <PresetButton
 *   preset="dyslexia"
 *   icon="text-aa-fill"
 *   title="Dyslexia"
 * />
 */
import Icon from '../icons/Icon.astro';

interface Props {
  preset: string;
  icon: string;
  title: string;
  iconSize?: number;
}

const { preset, icon, title, iconSize = 40 } = Astro.props;
---

<button
  class="a11y-preset-btn"
  data-preset={preset}
  aria-label={`${title} optimized settings`}
>
  <Icon name={`a11y-panel/${icon}`} size={iconSize} color="var(--brand-c-primary)" class="a11y-preset-btn__icon" />
  <h4 class="a11y-preset-btn__title">{title}</h4>
</button>

<style>
  .a11y-preset-btn {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    width: 100%;
    padding: var(--space-xs) var(--space-lg);
    background: var(--brand-c-bg);
    border: 2px solid color-mix(in oklch, var(--brand-c-text-dark) 20%, transparent);
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: var(--transition-fast);
    text-align: left;
    box-shadow: 0 2px 8px color-mix(in oklch, var(--color-Black) 8%, transparent);
  }

  .a11y-preset-btn:hover {
    border-color: var(--brand-c-primary);
    box-shadow: 0 4px 12px color-mix(in oklch, var(--color-Black) 12%, transparent);
  }

  .a11y-preset-btn:focus-visible {
    outline: 2px solid var(--brand-c-primary);
    outline-offset: 2px;
  }

  .a11y-preset-btn.active {
    border-color: var(--brand-c-primary);
    box-shadow: 0 4px 12px color-mix(in oklch, var(--color-Black) 15%, transparent);
  }

  .a11y-preset-btn__icon {
    flex-shrink: 0;
    transition: var(--transition-fast);
  }

  .a11y-preset-btn__title {
    font-weight: var(--font-bold);
    color: var(--brand-c-text-dark);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* Tablet - stacked layout */
  @media (min-width: 769px) and (max-width: 1400px) {
    .a11y-preset-btn {
      flex-direction: column;
      padding: var(--space-sm);
      gap: var(--space-xs);
      text-align: center;
    }

    .a11y-preset-btn__icon {
      width: 32px !important;
      height: 32px !important;
    }
  }

  /* Mobile - smaller buttons */
  @media (max-width: 768px) {
    .a11y-preset-btn {
      flex-direction: column;
      padding: var(--space-xs) var(--space-sm);
      gap: var(--space-2xs);
      text-align: center;
    }

    .a11y-preset-btn__icon {
      width: 24px !important;
      height: 24px !important;
    }
  }

  /* Small mobile */
  @media (max-width: 480px) {
    .a11y-preset-btn {
      padding: var(--space-xs);
    }

    .a11y-preset-btn__icon {
      width: 20px !important;
      height: 20px !important;
    }
  }

  /* Very small screens */
  @media (max-width: 320px) {
    .a11y-preset-btn {
      padding: var(--space-2xs);
      gap: var(--space-3xs);
    }

    .a11y-preset-btn__icon {
      width: 18px !important;
      height: 18px !important;
    }
  }

  /* ========== REDUCED MOTION ========== */
  :global(#a11y-content-wrapper.a11y-reduce-motion) .a11y-preset-btn,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .a11y-preset-btn__icon {
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .a11y-preset-btn,
    .a11y-preset-btn__icon {
      transition: none !important;
    }
  }
</style>