---
/**
 * Burst — Particle burst wrapper.
 *
 * Wraps any child (Button, Link, Card, raw element) and fires a particle
 * burst on click or hover. Particle visual is delegated to a Shape config
 * — the Shape is rendered into a hidden <template> at build time and the
 * runtime clones it per particle. Shape covers everything (primitives,
 * Phosphor icons via media, D1 logos via slug, custom SVG).
 *
 * Two engines:
 *   - fly      → DOM particles, Web Animations API, fade-out (particle-burst.ts)
 *   - physics  → DOM particles, gravity + AABB collision against page text,
 *                optional cursor magnet (particle-physics.ts)
 *
 * Colour:
 *   - Solid: brandColor (+ colorTier) OR rainbowColor — single colour
 *   - palette="tiers"   → cycle particles through 4 tiers of brandColor
 *   - palette="rainbow" → cycle particles through all 7 rainbow colours
 *
 * Both modules are imported globally via BaseLayout so Burst doesn't need
 * its own <script>. The wrapper element holds all data-particle-* attrs;
 * the runtime auto-binds click/hover.
 */
import fs from 'node:fs';
import path from 'node:path';
import { Shape } from '../Shape';
import { Icon } from '../Icon';
import { BRAND_CONFIG } from '../../../lib/config/brand';
import { resolveTraceShorthand } from '../../../lib/text-paths/resolver';
import type { LogoKey } from '../../../lib/text-paths/resolver';
import type { BrandColour, RainbowColour, ColourTier } from '../../../lib/shared-enums';

type Engine = 'fly' | 'physics' | 'string';
type Trigger = 'click' | 'hover' | 'hover-hold';
type Palette = 'tiers' | 'rainbow';
type PhysicsMode = 'fall' | 'explode' | 'float' | 'orbit' | 'shake';
type Preset = 'starfall' | 'vortex';
/** Where each particle/strand spawns. origin = burst element centre.
 *  Edge values (top/bottom/left/right) sample a random position along that
 *  viewport edge. edges = random pick from all four. viewport = random
 *  anywhere on screen. */
type SpawnFrom = 'origin' | 'top' | 'bottom' | 'left' | 'right' | 'edges' | 'viewport';
/** Where particles head. away = radial outward (current default). origin =
 *  converge on burst element centre (reverse confetti). cursor = aim at
 *  cursor position at fire time. target = converge on the element matched
 *  by `target` selector (used for hero text reveal etc.). */
type SpawnTo = 'away' | 'origin' | 'cursor' | 'target';

// Named presets — pre-configured prop bundles. Author still overrides any
// individual prop (the preset only fills in undefined values). Presets are
// the canonical "this is the look we want" entry point; modes are the
// underlying physics primitives.
const PRESETS: Record<Preset, Record<string, any>> = {
  // Starfall — the beautiful cascading rainbow icons that fly high, pass
  // through most text, and pool spectacularly on the viewport floor.
  // Higher pressure for taller arcs, low stickiness for the cascade effect.
  starfall: {
    engine: 'physics',
    mode: 'fall',
    palette: 'rainbow',
    count: 80,
    spread: 220,         // wider arc + higher launch
    gravity: 0.4,
    stickiness: 0.35,    // mostly cascade past text, pile on floor
    lifespan: 6500,
    particle: { component: 'Icon', name: 'star-fill', weight: 'fill', size: 'sm' },
  },
  // Vortex — sparkles fly inward from viewport edges to the cursor, then
  // magnet-orbit the cursor as it moves. Stellar-parallax depth (large
  // sparkles arrive fast and bright, small ones drift slow and faded).
  vortex: {
    engine: 'physics',
    from: 'edges',
    to: 'cursor',
    magnet: true,        // continuous attraction → orbit after arrival
    palette: 'rainbow',
    count: 70,
    lifespan: 5000,
    gravity: 0,
    collide: false,
    particle: { component: 'Icon', name: 'sparkle-fill', weight: 'fill', size: 'sm' },
  },
};

interface Props {
  /** Pre-configured prop bundle — applies a named preset. Author-supplied
   *  individual props still win (preset fills only undefined props). */
  preset?: Preset;

  /** Shape or Icon config used as the particle visual. Build-time rendered
   *  into a hidden template; runtime clones it per particle. */
  particle?: Record<string, any>;

  /** Raw SVG markup OR public/-relative path (e.g. "Animations/Hero Morph/1.svg").
   *  Read at build time and embedded verbatim into a hidden template. Bypasses
   *  the Shape/Icon delegation — use when you have an arbitrary logo or custom
   *  SVG that isn't in the Asset Library. Paths get fill="currentColor"
   *  injected so colour/palette props apply via the .color--{name} mixin. */
  particleSvg?: string;
  /** Particle size in px (Shape/Icon size tokens are honoured by their own
   *  components; particleSvg needs an explicit dimension). Default 32. */
  particleSize?: number;

  /** Single brand colour applied to every particle. Mutually exclusive with palette. */
  brandColor?: BrandColour;
  /** Tier modifier for brandColor (single-colour mode). */
  colorTier?: ColourTier;
  /** Single rainbow colour applied to every particle. Mutually exclusive with palette. */
  rainbowColor?: RainbowColour;
  /** Multi-particle colour cycle. tiers: 4 tiers of brandColor. rainbow: 7 rainbow colours. */
  palette?: Palette;

  /** fly: DOM particles fly outward + fade. physics: gravity + collide with text + optional magnet. */
  engine?: Engine;
  /** Where each particle/strand spawns. Default 'origin' (burst element centre). */
  from?: SpawnFrom;
  /** Where particles head. Default 'away' (radial outward). 'target' pairs
   *  with the `target` selector to converge on a specific element. */
  to?: SpawnTo;
  /** CSS selector used when to='target'. The element's centre becomes the
   *  destination, and `data-string-landed` is set on first contact (CSS can
   *  hook this for reveal effects, e.g. hero-text fade-in). */
  target?: string;
  /** [physics only] Force preset. fall = upward burst + gravity. explode = radial.
   *  float = rise + drift. orbit = circle the cursor. shake = bounce on collision. */
  mode?: PhysicsMode;
  trigger?: Trigger;
  /** Number of particles per burst. */
  count?: number;
  /** Spread radius (fly) / initial velocity range (physics) in px. */
  spread?: number;
  /** Lifespan in ms before fade. */
  lifespan?: number;

  /** [physics only] Gravity strength (px/frame²). Default 0.4. */
  gravity?: number;
  /** [physics only] Particles attract toward cursor while alive. */
  magnet?: boolean;
  /** [physics only] Particles stop on contact with p/h1-h3/button/a rects. Default true. */
  collide?: boolean;
  /** [physics + string] 0–1 probability a falling particle/strand-point sticks
   *  on a top-edge contact. 0.5 default — half pass through to the next rect
   *  below, distributing across rows instead of clumping on the highest. 1.0
   *  = original behaviour (stick on first contact). */
  stickiness?: number;

  /** [string only] Strands emitted per click. Default 1. */
  strands?: number;
  /** [string only] Points per strand. Default 60. */
  length?: number;
  /** [string only] Initial point speed in px/frame. Default 8. */
  pressure?: number;
  /** [string only] Emit duration in ms — strand grows over this period. Default 350. */
  emitDuration?: number;
  /** [string only] Stroke width in px. Default 3. */
  thick?: number;
  /** [string only] SVG path data, OR a `logo:KEY` shorthand. After the
   *  strand flies in, each point lerps to a sampled position along this
   *  path — strand "writes" or "draws" the shape. Path is auto-centred
   *  on the burst origin and scaled to traceSize px wide. Examples:
   *    "M-100,0 Q0,-50 100,0"  → strand traces a curve
   *    "logo:primary"          → strand traces the brand logo paths */
  tracePath?: string;
  /** [string only] Target width in px for the traced shape. Path is
   *  auto-centred and scaled so its bounding box matches this size.
   *  Default 240. */
  traceSize?: number;
  /** [string only] Offset the traced shape from the burst origin in px.
   *  Default 0,0 (centred on origin). Useful when the source button
   *  would obscure the trace — e.g. traceOffsetY: -180 moves the
   *  shape above the button. */
  traceOffsetX?: number;
  traceOffsetY?: number;
  /** Render the trace target as a visible SVG inside the burst wrapper
   *  AND animate a GSAP DrawSVG stroke-in on the same trigger as the
   *  particle/strand spawn. Useful for the hero-reveal pattern where
   *  silly-string flies in around a heading while the heading writes
   *  itself. Combines with tracePath (logo:KEY / phrase:KEY / raw path).
   *  Position + size of the rendered SVG follow traceOffsetX/Y and
   *  traceSize. */
  tracePathDrawIn?: boolean;
  /** ms after burst trigger before the GSAP draw starts. Lets the
   *  silly-string flight phase land first, then the letters appear to
   *  write themselves as the strings settle. Default 700. */
  traceDrawDelay?: number;
  /** ms over which the GSAP draw completes. Default 1200. */
  traceDrawDuration?: number;
  /** [string only] After emit completes, every live point applies a
   *  soft per-frame pull toward the live cursor. The strand becomes a
   *  Verlet-rope swarm-cloud that follows the cursor as it moves.
   *  Mutually exclusive with tracePath — if both set, magnetCursor wins.
   *  'attract' (default when true): swarm follows cursor.
   *  'repel': cursor pushes points away (parts the rope mid-flight).
   *  Boolean true → 'attract' for backwards-compat. */
  magnetCursor?: boolean | 'attract' | 'repel';
  /** [string only] When tethered (magnetCursor=attract + collide=true),
   *  each strand reads its colour from the anchor element's computed
   *  text colour instead of the burst's palette. Tendrils blend into
   *  whatever element they're hanging from. */
  inheritAnchorColour?: boolean;

  class?: string;
}

// Resolve preset first. Author-supplied props win — preset only fills
// keys that the author left undefined.
const _rawProps = Astro.props as Record<string, any>;
const _presetDefaults = _rawProps.preset && PRESETS[_rawProps.preset as Preset]
  ? PRESETS[_rawProps.preset as Preset]
  : {};
const _resolvedProps: Record<string, any> = { ..._presetDefaults };
for (const [k, v] of Object.entries(_rawProps)) {
  if (v !== undefined) _resolvedProps[k] = v;
}

const {
  particle,
  particleSvg,
  particleSize = 32,
  brandColor,
  colorTier,
  rainbowColor,
  palette,
  engine = 'fly',
  mode,
  from = 'origin',
  to = 'away',
  target,
  trigger = 'click',
  count = 30,
  spread = 150,
  lifespan,
  gravity = 0.4,
  magnet = false,
  collide,
  stickiness,
  strands,
  length,
  pressure,
  emitDuration,
  thick,
  tracePath,
  traceSize = 240,
  traceOffsetX = 0,
  traceOffsetY = 0,
  tracePathDrawIn = false,
  traceDrawDelay = 700,
  traceDrawDuration = 1200,
  magnetCursor,
  inheritAnchorColour = false,
  class: className = '',
} = _resolvedProps;

// Per-engine default for collide: string defaults off (silly-string flies
// across surfaces), physics defaults on (particles land on text/buttons).
const _collideDefault = engine === 'string' ? false : true;
const _effectiveCollide = collide === undefined ? _collideDefault : collide;

// Per-engine lifespan default. String strands need long lives so they
// have time to settle on the floor and pool — 8s minimum looks like
// silly-string. Fly/physics bursts die in 2.5s.
const _lifespanDefault = engine === 'string' ? 12000 : 2500;
const _effectiveLifespan = lifespan === undefined ? _lifespanDefault : lifespan;

// Resolve particleSvg — three input shapes:
//   1. Inline SVG markup ("<svg>...</svg>")
//   2. "logo:KEY" shorthand → looks up BRAND_CONFIG.logo[KEY] for the path
//   3. public/-relative path ("Animations/Hero Morph/1.svg")
let svgMarkup: string | null = null;
let resolvedSvgPath: string | null = particleSvg ?? null;
if (resolvedSvgPath && resolvedSvgPath.startsWith('logo:')) {
  const key = resolvedSvgPath.slice('logo:'.length) as LogoKey;
  const path_ = (BRAND_CONFIG as any).logo?.[key];
  if (path_) {
    resolvedSvgPath = path_.startsWith('/') ? path_.slice(1) : path_;
  } else {
    console.warn(`[Burst] Unknown logo key "${key}" — valid keys: primary, monochrome, favicon, wordmark`);
    resolvedSvgPath = null;
  }
}
// Resolve tracePath via the shared resolver (logo:KEY → BRAND_CONFIG
// lookup + file read + path extraction; phrase:KEY → TEXT_PATHS_META
// lookup). Raw SVG path data passes through as a single-element array.
// undefined → empty array, no path tracing.
let resolvedTracePaths: string[] = [];
let resolvedTraceMarkup: string | null = null;
if (tracePath) {
  const resolved = resolveTraceShorthand(tracePath);
  if (resolved) {
    // Multi-path logos give N paths; phrases give one per letter.
    // Auto-strands logic downstream sets strands = letter count when
    // palette is in play ("WELCOME" → 7 strands → 7 palette colours).
    resolvedTracePaths = resolved.paths;
    if (tracePathDrawIn) {
      // For the draw-in pattern we render the trace target as a visible
      // SVG and animate stroke-dashoffset. Swap fill="currentColor" →
      // stroke="currentColor" fill="none" so the paths read as outlines
      // ready for DrawSVG to animate. The runtime owns the timing.
      resolvedTraceMarkup = resolved.markup
        .replace(/fill="currentColor"/g, 'fill="none" stroke="currentColor" stroke-width="3"')
        .replace(/<svg /, '<svg overflow="visible" ');
    }
  } else if (!tracePath.startsWith('logo:') && !tracePath.startsWith('phrase:')) {
    // Not a shorthand — treat as raw SVG path data.
    resolvedTracePaths = [tracePath];
  }
}

// When tracePath resolves to multiple paths (multi-path logo), force
// strands count to match so each strand traces one path. User's strands
// value is ignored here — "one strand per path" is the right default for
// logo tracing. Single-path traces respect user's strands count.
const _effectiveStrands = resolvedTracePaths.length > 1
  ? resolvedTracePaths.length
  : strands;

if (resolvedSvgPath) {
  if (resolvedSvgPath.trim().startsWith('<svg') || resolvedSvgPath.includes('<?xml')) {
    svgMarkup = resolvedSvgPath;
  } else {
    try {
      const resolved = path.join(process.cwd(), 'public', resolvedSvgPath);
      svgMarkup = fs.readFileSync(resolved, 'utf-8');
    } catch (err) {
      console.warn(`[Burst] Could not read particleSvg "${resolvedSvgPath}":`, err);
    }
  }
  // Normalise the SVG so it picks up CSS colour from the wrapper:
  //   - Strip XML prelude + DOCTYPE (Astro's HTML parser chokes on them)
  //   - Inject fill="currentColor" on paths that don't declare a fill,
  //     so .color--{name} on the wrapper sets the actual paint
  //   - Force width/height to 100% so wrapper-driven sizing works
  if (svgMarkup) {
    svgMarkup = svgMarkup
      .replace(/<\?xml[^?]*\?>/g, '')
      .replace(/<!DOCTYPE[^>]*>/g, '')
      .replace(/<path(\s)([^>]*)\/?>/g, (m, ws, attrs) => {
        if (/\bfill\s*=/.test(attrs)) return m;
        return `<path${ws}fill="currentColor" ${attrs}>`;
      })
      .replace(/<svg([^>]*)>/, (_m, attrs) => {
        // Strip any explicit width/height; keep viewBox for aspect ratio
        const cleaned = (attrs as string)
          .replace(/\s*width="[^"]*"/g, '')
          .replace(/\s*height="[^"]*"/g, '');
        return `<svg width="100%" height="100%"${cleaned}>`;
      })
      .trim();
  }
}

// Strip structural keys — particle component receives the rest. Shape
// is the default; Icon allows clean glyph particles without a wrapper.
const { component: particleComponent = 'Shape', ...particleProps } = particle || {};
const ParticleComponent = particleComponent === 'Icon' ? Icon : Shape;

// Build the per-particle colour overrides for palette modes. Each entry
// becomes a separate hidden <template>; the runtime picks one at random
// per particle. Single-colour mode uses one template with the prop's
// colour applied (or whatever the particle config already declared).
type ColourOverride = Partial<{ brandColor: BrandColour; colorTier: ColourTier; rainbowColor: RainbowColour }>;

let variants: ColourOverride[] = [{}];

if (palette === 'tiers' && brandColor) {
  const tiers: ColourTier[] = ['tint', 'mid', 'base', 'emphasis'];
  variants = tiers.map(t => ({ brandColor, colorTier: t }));
} else if (palette === 'rainbow') {
  const rainbows: RainbowColour[] = [
    'rainbow-1','rainbow-2','rainbow-3','rainbow-4','rainbow-5','rainbow-6','rainbow-7',
  ];
  variants = rainbows.map(r => ({ rainbowColor: r }));
} else if (brandColor) {
  variants = [{ brandColor, ...(colorTier ? { colorTier } : {}) }];
} else if (rainbowColor) {
  variants = [{ rainbowColor }];
}

// One unique template ID per Burst instance so multiple Bursts on a page
// don't collide. Random suffix is fine — IDs only need to be unique
// within the document.
const burstId = `burst-${Math.random().toString(36).slice(2, 10)}`;
const templateIds = variants.map((_, i) => `${burstId}-tpl-${i}`);
---

<span
  class:list={['burst', className]}
  data-particle-burst
  data-particle-engine={engine}
  data-particle-mode={engine === 'physics' && mode ? mode : undefined}
  data-particle-from={from !== 'origin' ? from : undefined}
  data-particle-to={to !== 'away' ? to : undefined}
  data-particle-target={to === 'target' && target ? target : undefined}
  data-particle-trigger={trigger}
  data-particle-count={String(count)}
  data-particle-spread={String(spread)}
  data-particle-lifespan={String(_effectiveLifespan)}
  data-particle-templates={(particle || svgMarkup || engine === 'string') ? templateIds.join(',') : undefined}
  data-particle-gravity={(engine === 'physics' || engine === 'string') ? String(gravity) : undefined}
  data-particle-magnet={engine === 'physics' && magnet ? '' : undefined}
  data-particle-collide={(engine === 'physics' || engine === 'string') ? (_effectiveCollide ? 'on' : 'off') : undefined}
  data-particle-stickiness={(engine === 'physics' || engine === 'string') && stickiness !== undefined ? String(stickiness) : undefined}
  data-particle-strands={engine === 'string' && _effectiveStrands ? String(_effectiveStrands) : undefined}
  data-particle-length={engine === 'string' && length ? String(length) : undefined}
  data-particle-pressure={engine === 'string' && pressure ? String(pressure) : undefined}
  data-particle-emit-duration={engine === 'string' && emitDuration ? String(emitDuration) : undefined}
  data-particle-thick={engine === 'string' && thick ? String(thick) : undefined}
  data-particle-trace={engine === 'string' && resolvedTracePaths.length ? resolvedTracePaths.join('|') : undefined}
  data-particle-trace-size={engine === 'string' && resolvedTracePaths.length ? String(traceSize) : undefined}
  data-particle-trace-offset-x={engine === 'string' && resolvedTracePaths.length && traceOffsetX !== 0 ? String(traceOffsetX) : undefined}
  data-particle-trace-offset-y={engine === 'string' && resolvedTracePaths.length && traceOffsetY !== 0 ? String(traceOffsetY) : undefined}
  data-particle-magnet-cursor={
    engine === 'string' && magnetCursor
      ? (magnetCursor === 'repel' ? 'repel' : 'attract')
      : undefined
  }
  data-particle-inherit-anchor-colour={engine === 'string' && inheritAnchorColour ? '' : undefined}
  data-trace-draw={resolvedTraceMarkup ? '' : undefined}
  data-trace-draw-delay={resolvedTraceMarkup ? String(traceDrawDelay) : undefined}
  data-trace-draw-duration={resolvedTraceMarkup ? String(traceDrawDuration) : undefined}
  style={resolvedTraceMarkup ? 'position: relative; display: inline-block;' : undefined}
>
  {svgMarkup ? variants.map((override, i) => {
    // Wrap each SVG variant in a sized + colour-keyed span. The .color--{name}
    // mixin sets currentColor; the SVG's injected fill="currentColor" picks
    // it up. One template per palette variant so the runtime can pick.
    const colourClass = override.rainbowColor
      ? `color--${override.rainbowColor}`
      : override.brandColor
      ? `color--${override.brandColor}${override.colorTier ? ` color--tier-${override.colorTier}` : ''}`
      : '';
    return (
      <template id={templateIds[i]} data-burst-template>
        <span
          class={`burst-svg ${colourClass}`}
          style={`display:inline-block;width:${particleSize}px;height:${particleSize}px;line-height:0;`}
        >
          <Fragment set:html={svgMarkup} />
        </span>
      </template>
    );
  }) : particle ? variants.map((override, i) => (
    <template id={templateIds[i]} data-burst-template>
      <ParticleComponent {...(particleProps as any)} {...override} />
    </template>
  )) : engine === 'string' ? variants.map((override, i) => {
    // String engine doesn't clone particles — but the runtime still probes
    // these templates for their computed colour. Minimal colour-keyed span
    // is enough.
    const colourClass = override.rainbowColor
      ? `color--${override.rainbowColor}`
      : override.brandColor
      ? `color--${override.brandColor}${override.colorTier ? ` color--tier-${override.colorTier}` : ''}`
      : '';
    return (
      <template id={templateIds[i]} data-burst-template>
        <span class={colourClass}>.</span>
      </template>
    );
  }) : null}
  {resolvedTraceMarkup && (
    <span
      class="burst-trace-draw"
      data-burst-trace-draw-target
      style={`position: absolute; left: 50%; top: 50%; width: ${traceSize}px; height: auto; transform: translate(calc(-50% + ${traceOffsetX}px), calc(-50% + ${traceOffsetY}px)); pointer-events: none; line-height: 0;`}
      aria-hidden="true"
    >
      <Fragment set:html={resolvedTraceMarkup} />
    </span>
  )}
  <slot />
</span>
