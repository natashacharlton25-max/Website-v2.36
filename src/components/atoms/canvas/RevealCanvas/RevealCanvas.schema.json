{
  "component": "RevealCanvas",
  "category": "atoms/canvas",
  "renders": {
    "base": "RevealCanvas.astro"
  },
  "props": {
    "backgroundImage": { "type": "string",  "required": false, "default": "BRAND_CONFIG.footer.defaultImage" },
    "canvasId":        { "type": "string",  "required": false, "default": "reveal-canvas" },
    "shape":           { "type": "string",  "required": false, "default": "circle" },
    "icon":            { "type": "string",  "required": false, "default": "heart" },
    "iconWeight":      { "type": "string",  "required": false, "default": "regular" },
    "cellSize":        { "type": "number",  "required": false, "default": 30 },
    "proximity":       { "type": "number",  "required": false, "default": 125 },
    "growth":          { "type": "number",  "required": false, "default": 60 },
    "ease":            { "type": "number",  "required": false, "default": 0.075 },
    "class":           { "type": "string",  "required": false, "default": "" }
  }
}
