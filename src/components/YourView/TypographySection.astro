---
/**
 * TypographySection - Font Selection Section
 *
 * Contains font selection cards for accessible fonts.
 * Typography sliders are now in VisualSection.
 *
 * Usage:
 * <TypographySection />
 */
import FontCard from './FontCard.astro';

// Font options for cards
const fontOptions = [
  { label: 'Default', value: 'default' },
  { label: 'OpenDyslexic', value: 'opendyslexic', fontFamily: "'OpenDyslexic', sans-serif" },
  { label: 'Atkinson', value: 'atkinson', fontFamily: "'Atkinson Hyperlegible', sans-serif" },
  { label: 'Comic Sans', value: 'comic-sans', fontFamily: "'Comic Sans MS', cursive" },
  { label: 'Verdana', value: 'verdana', fontFamily: "Verdana, Geneva, sans-serif" },
  { label: 'Arial', value: 'arial', fontFamily: "Arial, Helvetica, sans-serif" },
  { label: 'Tahoma', value: 'tahoma', fontFamily: "Tahoma, Geneva, sans-serif" }
];
---

<div class="a11y-section a11y-section--typography">
  <h3 class="a11y-section__title">Font</h3>

  <!-- Font Cards -->
  <div class="a11y-font-grid" data-setting="fontFamily">
    {fontOptions.map((font) => (
      <FontCard
        value={font.value}
        label={font.label}
        fontFamily={font.fontFamily}
      />
    ))}
  </div>
</div>

<style>
  .a11y-section--typography {
    margin-bottom: var(--space-md);
  }

  .a11y-section--typography:last-child {
    margin-bottom: 0;
  }

  .a11y-section__title {
    font-weight: var(--font-bold);
    color: var(--brand-c-text-dark);
    margin-bottom: var(--space-md);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
  }

  @media (max-width: 768px) {
    .a11y-section__title {
    }
  }

  /* Font Cards - Single Column */
  .a11y-font-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
</style>
