---
/**
 * TypographyAdjustmentsSection - Typography Steppers Section
 *
 * Contains typography adjustment steppers (font size, spacing, line height).
 *
 * Usage:
 * <TypographyAdjustmentsSection />
 */
import { Stepper } from './Stepper';
---

<div class="a11y-section--typography-adjustments">
  <h3 class="a11y-section__title">Type</h3>

  <div class="a11y-stepper-grid">
    <Stepper
      id="a11y-font-size"
      setting="fontSize"
      label="Font Size"
      min={50}
      max={200}
      step={10}
      value={100}
      valueId="font-size-value"
      unit="%"
    />

    <Stepper
      id="a11y-letter-spacing"
      setting="letterSpacing"
      label="Letter Spacing"
      min={0}
      max={10}
      step={1}
      value={0}
      valueId="letter-spacing-value"
      unit="px"
    />

    <Stepper
      id="a11y-word-spacing"
      setting="wordSpacing"
      label="Word Spacing"
      min={0}
      max={20}
      step={2}
      value={0}
      valueId="word-spacing-value"
      unit="px"
    />

    <Stepper
      id="a11y-line-height"
      setting="lineHeight"
      label="Line Height"
      min={100}
      max={200}
      step={10}
      value={100}
      valueId="line-height-value"
      unit="%"
    />
  </div>
</div>

<style>
  .a11y-section--typography-adjustments {
    margin-bottom: var(--space-md);
  }

  .a11y-section__title {
    font-weight: var(--font-bold);
    color: var(--brand-c-text-dark);
    margin-bottom: var(--space-md);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
  }

  .a11y-stepper-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .a11y-section__title {
    }

    .a11y-stepper-grid {
      gap: var(--space-sm);
    }
  }
</style>
