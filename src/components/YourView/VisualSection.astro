---
/**
 * VisualSection - Visual & Navigation Settings Section
 *
 * Contains visual accessibility settings and navigation/motion controls.
 *
 * Usage:
 * <VisualSection />
 */
import ToggleCard from './ToggleCard.astro';
---

<div class="a11y-section a11y-section--visual">
  <h3 class="a11y-section__title">Access</h3>

  <div class="a11y-toggle-grid">
    <ToggleCard
      id="a11y-text-only"
      setting="textOnly"
      icon="a11y/eye-slash-fill"
      label="Text Only"
    />

    <ToggleCard
      id="a11y-highlight-links"
      setting="highlightLinks"
      icon="a11y/link-fill"
      label="Highlight Links"
    />

    <ToggleCard
      id="a11y-reduce-motion"
      setting="reduceMotion"
      icon="a11y/lightning-fill"
      label="Reduce Motion"
    />

    <ToggleCard
      id="a11y-enhanced-focus"
      setting="enhancedFocus"
      icon="a11y/gear-fill"
      label="Enhanced Focus"
    />

    <ToggleCard
      id="a11y-focus-dim"
      setting="focusDim"
      icon="a11y/eye-fill"
      label="Focus Dim"
    />

    <ToggleCard
      id="a11y-focus-scroll"
      setting="focusScroll"
      icon="a11y/arrows-in-fill"
      label="Focus Scroll"
    />

    <ToggleCard
      id="a11y-focus-pulse"
      setting="focusPulse"
      icon="a11y/heart-fill"
      label="Focus Pulse"
    />

    <ToggleCard
      id="a11y-focus-label"
      setting="focusLabel"
      icon="a11y/chat-text-fill"
      label="Focus Label"
    />

    <ToggleCard
      id="a11y-focus-rainbow"
      setting="focusRainbow"
      icon="a11y/heart-fill"
      label="Rainbow Focus"
    />

    <ToggleCard
      id="a11y-focus-color-journey"
      setting="focusColorJourney"
      icon="a11y/palette-fill"
      label="Colour Journey"
    />

    <ToggleCard
      id="a11y-rainbow-highlight"
      setting="rainbowHighlight"
      icon="a11y/heart-fill"
      label="Rainbow Links"
    />

    <ToggleCard
      id="a11y-screen-reader"
      setting="screenReaderMode"
      icon="a11y/bell-fill"
      label="Screen Reader"
    />

    <ToggleCard
      id="a11y-scrollbar-enhanced"
      setting="scrollbarEnhanced"
      icon="a11y/plus-fill"
      label="Big Scrollbar"
    />
  </div>
</div>

<style>
  .a11y-section {
    margin-bottom: var(--space-md);
  }

  .a11y-section:last-child {
    margin-bottom: 0;
  }

  .a11y-section__title {
    font-weight: var(--font-bold);
    color: var(--neutral-900);
    margin-bottom: var(--space-md);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
  }

  .a11y-toggle-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Mobile */
  /* @media-stripped-0 */</style>
