---
/**
 * ToggleCard - Accessible Toggle Button Card
 *
 * A button-style toggle with icon for better cognitive accessibility.
 * Visually similar to preset buttons but functions as an on/off toggle.
 *
 * Usage:
 * <ToggleCard
 *   id="text-only"
 *   setting="textOnly"
 *   icon="eye-slash-fill"
 *   label="Text Only"
 *   description="Hide images"
 * />
 */
import Icon from '../atoms/Icon/Icon.astro';

interface Props {
  id: string;
  setting: string;
  icon: string;
  label: string;
  description?: string;
  checked?: boolean;
  iconSize?: number;
}

const { id, setting, icon, label, description, checked = false, iconSize = 28 } = Astro.props;
---

<button
  type="button"
  class="a11y-toggle-card"
  id={id}
  data-setting={setting}
  aria-pressed={checked ? 'true' : 'false'}
  aria-label={`${label}${description ? ` - ${description}` : ''}`}
>
  <Icon name={icon} size={iconSize} color="var(--primary-600)" class="a11y-toggle-card__icon" />
  <div class="a11y-toggle-card__text">
    <small class="a11y-toggle-card__label">{label}</small>
    {description && <span class="a11y-toggle-card__desc">{description}</span>}
  </div>
  <span class="a11y-toggle-card__indicator" aria-hidden="true">
    <Icon name="check" weight="bold" semanticRole="decorative" class="a11y-toggle-card__check" />
  </span>
</button>

<style>
  .a11y-toggle-card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    width: 100%;
    padding: var(--space-md) var(--space-lg);
    background: var(--page-bg);
    border: 2px solid color-mix(in srgb, var(--neutral-900) 20%, transparent);
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: var(--transition-fast);
    text-align: left;
    box-shadow: 0 2px 8px color-mix(in oklch, var(--color-Black) 8%, transparent);
  }

  .a11y-toggle-card:hover {
    background: var(--page-bg);
    border-color: var(--primary-600);
    box-shadow: 0 4px 12px color-mix(in oklch, var(--color-Black) 12%, transparent);
  }

  .a11y-toggle-card:focus-visible {
    outline: 2px solid var(--primary-600);
    outline-offset: 2px;
  }

  /* Active/On state */
  .a11y-toggle-card[aria-pressed="true"] {
    background: var(--page-bg);
    border-color: var(--primary-600);
    box-shadow: 0 4px 12px color-mix(in oklch, var(--color-Black) 15%, transparent);
  }

  .a11y-toggle-card[aria-pressed="true"] .a11y-toggle-card__icon {
    color: var(--primary-600);
  }

  .a11y-toggle-card[aria-pressed="true"] .a11y-toggle-card__indicator {
    background: var(--primary-600);
    border-color: var(--primary-600);
  }

  .a11y-toggle-card[aria-pressed="true"] .a11y-toggle-card__check {
    opacity: 1;
    transform: scale(1);
  }

  .a11y-toggle-card__icon {
    flex-shrink: 0;
    transition: var(--transition-fast);
  }

  .a11y-toggle-card__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    min-width: 0;
  }

  .a11y-toggle-card__label {
    font-weight: var(--font-bold);
    color: var(--neutral-900);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .a11y-toggle-card__desc {
    color: var(--neutral-900);
    opacity: 0.7;
  }

  .a11y-toggle-card__indicator {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: var(--page-bg);
    border: var(--border-width-2) solid color-mix(in srgb, var(--neutral-900) 25%, transparent);
    border-radius: var(--radius-sm);
    transition: var(--transition-fast);
  }

  .a11y-toggle-card__check {
    color: var(--page-bg);
    opacity: 0;
    transform: scale(0.5);
    transition: var(--transition-fast);
  }

  /* Responsive - tablet */
  /* @media-stripped-0 */  /* Responsive - mobile */
  /* @media-stripped-1 */  /* Very small screens */
  /* @media-stripped-2 */  /* ========== REDUCED MOTION ========== */
  :global(#a11y-content-wrapper.a11y-reduce-motion) .a11y-toggle-card,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .a11y-toggle-card__icon,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .a11y-toggle-card__indicator,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .a11y-toggle-card__check {
    transition: none !important;
  }

  /* @media-stripped-3 */</style>
