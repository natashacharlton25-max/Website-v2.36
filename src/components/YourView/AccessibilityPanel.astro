---
/**
 * AccessibilityPanel - Test controls modal
 *
 * Plain text buttons for testing themes, toggles, alt text, AAC, cognitive levels.
 * Rendered on every page via BaseLayout.
 */
import { Announcer } from './Announcer';

const btn = "padding:8px 14px;border:1px solid #999;border-radius:4px;cursor:pointer;background:#222;color:#eee;";
const sep = "margin-top:16px;padding-top:16px;border-top:1px solid #555;";
const row = "display:flex;flex-wrap:wrap;gap:8px;";
---

<Announcer />

<div
  class="a11y-panel"
  id="a11y-panel"
  role="dialog"
  aria-label="Test controls"
  aria-modal="true"
  hidden
>
  <div class="a11y-panel__header">
    <h2 class="a11y-panel__title">Test Controls</h2>
    <div class="a11y-panel__header-actions">
      <button id="a11y-reset" type="button" style={btn}>Reset All</button>
      <button class="a11y-panel__close" type="button" aria-label="Close panel" style="background:transparent;color:#eee;border:none;font-size:24px;cursor:pointer;">&times;</button>
    </div>
  </div>

  <div class="a11y-panel__body">

    <!-- Themes -->
    <div class="a11y-panel__section">
      <h3>Theme</h3>
      <div style={row}>
        <button data-test-theme="default" type="button" style={btn}>Light</button>
        <button data-test-theme="default-dark" type="button" style={btn}>Dark</button>
        <button data-test-theme="high-contrast-light" type="button" style={btn}>High Viz Light</button>
        <button data-test-theme="high-contrast" type="button" style={btn}>High Viz Dark</button>
        <button data-test-theme="monochrome-warm" type="button" style={btn}>Mono Light</button>
        <button data-test-theme="monochrome-warm-dark" type="button" style={btn}>Mono Dark</button>
        <button data-test-theme="candy" type="button" style={btn}>Candy</button>
        <button data-test-theme="candy-dark" type="button" style={btn}>Candy Dark</button>
        <button data-test-theme="neon-light" type="button" style={btn}>Neon Light</button>
        <button data-test-theme="neon" type="button" style={btn}>Neon Dark</button>
      </div>
    </div>

    <!-- Toggles -->
    <div class="a11y-panel__section" style={sep}>
      <h3>Toggles</h3>
      <div style={row}>
        <button data-test-toggle="textOnly" type="button" style={btn}>Text Only</button>
        <button data-test-toggle="highlightLinks" type="button" style={btn}>Highlight Links</button>
        <button data-test-toggle="reduceMotion" type="button" style={btn}>Reduced Motion</button>
        <button data-test-toggle="scrollbarEnhanced" type="button" style={btn}>Large Scrollbar</button>
        <button data-test-toggle="xlText" type="button" style={btn}>XL Text</button>
      </div>
    </div>

    <!-- Hover Mode -->
    <div class="a11y-panel__section" style={sep}>
      <h3>Hover Mode</h3>
      <div style={row}>
        <button data-test-hover="full" type="button" style={btn}>Full</button>
        <button data-test-hover="gentle" type="button" style={btn}>Gentle</button>
        <button data-test-hover="instant" type="button" style={btn}>Instant</button>
        <button data-test-hover="none" type="button" style={btn}>None</button>
      </div>
    </div>

    <!-- Motion Speed -->
    <div class="a11y-panel__section" style={sep}>
      <h3>Motion Speed</h3>
      <div style={row}>
        <button data-test-motion="full" type="button" style={btn}>Full</button>
        <button data-test-motion="gentle" type="button" style={btn}>Gentle</button>
        <button data-test-motion="none" type="button" style={btn}>None</button>
      </div>
    </div>

    <!-- Image Alt Text — what to show -->
    <div class="a11y-panel__section" style={sep}>
      <h3>Image Alt Text (what to show)</h3>
      <div style={row}>
        <button data-test-alt="none" type="button" style={btn}>None</button>
        <button data-test-alt="word" type="button" style={btn}>Word</button>
        <button data-test-alt="descriptive" type="button" style={btn}>Descriptive</button>
        <button data-test-alt="aac" type="button" style={btn}>Image AAC</button>
      </div>
    </div>

    <!-- Image Alt Text — how to show -->
    <div class="a11y-panel__section" style={sep}>
      <h3>Image Alt Text (how to show)</h3>
      <div style={row}>
        <button data-test-display="hidden" type="button" style={btn}>Hidden</button>
        <button data-test-display="subtitle" type="button" style={btn}>Subtitle</button>
        <button data-test-display="tooltip" type="button" style={btn}>Tooltip</button>
        <button data-test-display="enlarge" type="button" style={btn}>Enlarge</button>
        <button data-test-display="inline" type="button" style={btn}>Inline</button>
      </div>
    </div>

    <!-- Symbol Set -->
    <div class="a11y-panel__section" style={sep}>
      <h3>Symbol Set</h3>
      <div style={row}>
        <button data-test-symbolset="openaac" type="button" style={btn}>OpenAAC</button>
        <button data-test-symbolset="bliss" type="button" style={btn}>Bliss</button>
        <button data-test-symbolset="widgit" type="button" style={btn}>Widgit</button>
        <button data-test-symbolset="pcs" type="button" style={btn}>PCS</button>
        <button data-test-symbolset="makaton" type="button" style={btn}>Makaton</button>
      </div>
    </div>

    <!-- Cognitive Level -->
    <div class="a11y-panel__section" style={sep}>
      <h3>AAC Cognitive Level</h3>
      <div style={row}>
        <button data-test-cognitive="green" type="button" style={btn}>Green (survival)</button>
        <button data-test-cognitive="yellow" type="button" style={btn}>Yellow (combiners)</button>
        <button data-test-cognitive="orange" type="button" style={btn}>Orange (complex)</button>
        <button data-test-cognitive="full" type="button" style={btn}>Full (all)</button>
      </div>
    </div>

    <!-- Content AAC -->
    <div class="a11y-panel__section" style={sep}>
      <h3>Content AAC</h3>
      <div style={row}>
        <button data-test-toggle="contentAac" type="button" style={btn}>Content AAC</button>
      </div>
    </div>

    <!-- Animation Explainer — how to show -->
    <div class="a11y-panel__section" style={sep}>
      <h3>Animation Explainer</h3>
      <div style={row}>
        <button data-test-animexplainer="off" type="button" style={btn}>Off</button>
        <button data-test-animexplainer="inline" type="button" style={btn}>Inline</button>
        <button data-test-animexplainer="subtitle" type="button" style={btn}>Subtitle</button>
        <button data-test-animexplainer="overlay" type="button" style={btn}>Overlay</button>
        <button data-test-animexplainer="tooltip" type="button" style={btn}>Tooltip</button>
      </div>
    </div>

    <!-- Animation Explainer — what to show -->
    <div class="a11y-panel__section" style={sep}>
      <h3>Animation Sequence Content</h3>
      <div style={row}>
        <button data-test-animseq="full" type="button" style={btn}>Full</button>
        <button data-test-animseq="visual" type="button" style={btn}>Visual</button>
        <button data-test-animseq="text" type="button" style={btn}>Text</button>
      </div>
    </div>

    <!-- AAC Pictogram Filter -->
    <div class="a11y-panel__section" style={sep}>
      <h3>AAC Pictogram Filter</h3>
      <div style={row}>
        <button data-test-aacfilter="none" type="button" style={btn}>None</button>
        <button data-test-aacfilter="grayscale" type="button" style={btn}>Grayscale</button>
        <button data-test-aacfilter="sepia" type="button" style={btn}>Sepia</button>
      </div>
    </div>

  </div>
</div>

<div class="a11y-panel__backdrop" hidden></div>

<script>
  import './a11y-modal';
</script>
