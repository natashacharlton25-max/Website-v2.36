---
/**
 * ThemeSidebar - Color Theme Selection Sidebar
 *
 * Displays theme cards for accessibility color themes.
 * Theme cards are dynamically generated by ThemePreviewTokens.js.
 *
 * Usage:
 * <ThemeSidebar />
 */
---

<aside class="a11y-panel__sidebar">
  <!-- Theme cards are dynamically generated by ThemePreviewTokens.js -->
  <div class="a11y-theme-list"></div>
</aside>

<style>
  .a11y-panel__sidebar {
    padding: var(--space-md);
    border-right: var(--border-width) solid color-mix(in srgb, var(--brand-c-text-dark) 15%, transparent);
    overflow-y: auto;
  }

  .a11y-sidebar__title {
    font-weight: var(--font-bold);
    color: var(--brand-c-text-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
    text-align: center;
  }

  .a11y-theme-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Tablet - keep column layout in grid cell */
  @media (min-width: 769px) and (max-width: 1400px) {
    .a11y-panel__sidebar {
      text-align: center;
    }

    .a11y-theme-list {
      flex-direction: column;
      align-items: center;
    }
  }

  /* Mobile - wrap horizontally */
  @media (max-width: 768px) {
    .a11y-panel__sidebar {
      width: 100%;
      border-right: none;
      border-bottom: var(--border-width) solid color-mix(in srgb, var(--brand-c-text-dark) 15%, transparent);
      text-align: center;
    }

    .a11y-theme-list {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
