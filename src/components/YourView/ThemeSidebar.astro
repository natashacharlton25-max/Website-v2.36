---
/**
 * ThemeSidebar - Color Theme Selection Sidebar
 *
 * Displays theme cards for accessibility color themes.
 * Theme cards are dynamically generated by ThemePreviewTokens.js.
 *
 * Usage:
 * <ThemeSidebar />
 */
---

<aside class="a11y-panel__sidebar">
  <!-- Theme cards are dynamically generated by ThemePreviewTokens.js -->
  <div class="a11y-theme-list"></div>
</aside>

<style>
  .a11y-panel__sidebar {
    padding: var(--space-md);
    border-right: var(--border-width) solid color-mix(in srgb, var(--neutral-900) 15%, transparent);
    overflow-y: auto;
  }

  .a11y-sidebar__title {
    font-weight: var(--font-bold);
    color: var(--neutral-900);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
    text-align: center;
  }

  .a11y-theme-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Tablet - keep column layout in grid cell */
  /* @media-stripped-0 */  /* Mobile - wrap horizontally */
  /* @media-stripped-1 */</style>
