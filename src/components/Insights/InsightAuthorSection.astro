---
/**
 * InsightAuthorSection - About the author section for insights
 * Wraps AuthorCard with section-level styling
 */
import AuthorCard from '../molecules/cards/AuthorCard/AuthorCard.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  photo: ImageMetadata;
  role?: string;
  bio: string;
  credentials?: string[];
  specialties?: string[];
  signature?: ImageMetadata;
  signatureText?: string;
  class?: string;
}

const {
  name,
  photo,
  role,
  bio,
  credentials,
  specialties,
  signature,
  signatureText,
  class: className
} = Astro.props;
---

<section class:list={['insight-author', className]}>
  <div class="container">
    <AuthorCard
      name={name}
      photo={photo}
      role={role}
      bio={bio}
      credentials={credentials}
      specialties={specialties}
      signature={signature}
      signatureText={signatureText}
      label="About the Author"
      href="/about/natasha-charlton"
    />
  </div>
</section>
