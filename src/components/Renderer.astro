---
/**
 * Renderer — Generic JSON → Astro component renderer
 *
 * Reads the "component" key, looks up the atom, spreads props, recurses children.
 * Every page uses this. No manual prop mapping. JSON is the single source of truth.
 *
 * Validates JSON against atom schemas in DEV mode — logs errors to terminal.
 *
 * Usage:
 *   import Renderer from '../../components/Renderer.astro';
 *   import data from '../../data/test/badge.json';
 *
 *   <Renderer node={data} />
 */
import { componentRegistry, resolveNode, type RenderNode } from '../lib/render';
import { validateComponent, type ComponentSchema } from '../lib/schema-validator';

// DEV: load all atom schemas for validation
let schemaMap: Map<string, ComponentSchema> | null = null;
if (import.meta.env.DEV) {
  const schemas = import.meta.glob('../components/atoms/*/*.schema.json', { eager: true });
  schemaMap = new Map();
  for (const [, mod] of Object.entries(schemas)) {
    const schema = (mod as any).default || mod;
    if (schema?.component) {
      schemaMap.set(schema.component, schema as ComponentSchema);
    }
  }
  // Expose for _ref validation in nested objects
  (globalThis as any).__schemaMap = schemaMap;
}

interface Props {
  node: RenderNode;
}

const { node } = Astro.props;
const resolved = resolveNode(node, componentRegistry);

// DEV: validate JSON against schema. Errors are hard (bad input must
// not silently render); warnings are advisory (no-op props, etc.).
if (import.meta.env.DEV && schemaMap && node.component) {
  const schema = schemaMap.get(node.component);
  if (schema) {
    const result = validateComponent(node, schema);
    if (!result.valid) {
      for (const err of result.errors) {
        const prefix = `[Validator] ${node.component}.${err.prop}:`;
        if (err.severity === 'warn') {
          console.warn(prefix, err.message);
        } else {
          console.error(prefix, err.message);
        }
      }
      // Hard errors block rendering — throw so Astro's DEV overlay surfaces
      // it in the browser. Author/AI can't miss it. Warnings keep rendering
      // (they're advisory: no-op prop for the type, etc.).
      const hardErrors = result.errors.filter((e) => e.severity !== 'warn');
      if (hardErrors.length > 0) {
        const ident = node.id ? `${node.component} id="${node.id}"` : node.component;
        throw new Error(
          `${ident} failed schema validation (${hardErrors.length} error${hardErrors.length === 1 ? '' : 's'}):\n` +
            hardErrors.map((e) => `  • ${e.prop}: ${e.message}`).join('\n')
        );
      }
    }
  }
}
---

{resolved && (
  resolved.children.length > 0 ? (
    <resolved.Component {...resolved.props}>
      {resolved.children.map((child: RenderNode) => (
        <Astro.self node={child} />
      ))}
    </resolved.Component>
  ) : (
    <resolved.Component {...resolved.props} />
  )
)}
