---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  image: ImageMetadata;
  imageAlt: string;
  content: string[];
}

const { title, image, imageAlt, content } = Astro.props;
---

<section class="story">
  <div class="container">
    <div class="story__content">
      <!-- Image Card with Title -->
      <div class="img-wide-xl story__image-card">
        <Image src={image} alt={imageAlt} loading="lazy" />
        <div class="story__image-overlay">
          <h2 class="story__image-title">{title}</h2>
        </div>
      </div>

      <!-- Story Text -->
      <div class="story__text">
        {content.map(paragraph => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .story__content {
    max-width: 1400px;
    text-align: left;
  }

  .story__image-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-2xl);
    width: 100%;
    aspect-ratio: 3 / 1;
  }

  .story__image-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .story__image-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-xl);
    background: linear-gradient(transparent, rgba(0,0,0,0.5));
  }

  .story__image-title {
    color: var(--color-Background-50);
    margin: 0;
    font-size: var(--text-7xl);
    font-weight: var(--font-bold);
  }

  .story__text {
    max-width: 1400px;
  }

  .story__text p {
    font-size: var(--text-xl);
    font-weight: var(--font-medium);
    color: var(--color-Text-600);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-lg);
  }

  .story__text p:last-child {
    margin-bottom: 0;
  }

</style>
