---
import SectionTitle from '../Typography/SectionTitle.astro';

interface Value {
  number: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  values: Value[];
  icon?: string;
}

const { title, values, icon } = Astro.props;
---

<section class="values-section section">
  <div class="container">
    <div class="values-section__header">
      <SectionTitle
        title={title}
        size="lg"
        dividerColor="primary"
        icon={icon}
        iconColor="primary"
        iconStyle="bare"
      />
    </div>

    <div class="values-section__list">
      {values.map((value) => (
        <div class="values-section__item">
          <div class="values-section__number">{value.number}</div>
          <div class="values-section__content">
            <h3 class="values-section__item-title">{value.title}</h3>
            <p class="values-section__item-text">{value.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
