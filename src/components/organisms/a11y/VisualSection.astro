---
/**
 * VisualSection - Visual & Navigation Settings Section
 *
 * Contains visual accessibility settings and navigation/motion controls.
 *
 * Usage:
 * <VisualSection />
 */
import ToggleCard from '../../molecules/a11y/ToggleCard.astro';
---

<div class="a11y-section a11y-section--visual">
  <h3 class="a11y-section__title">Access</h3>

  <div class="a11y-toggle-grid">
    <ToggleCard
      id="a11y-text-only"
      setting="textOnly"
      icon="a11y/eye-slash-fill"
      label="Text Only"
      description="Hide images"
    />

    <ToggleCard
      id="a11y-highlight-links"
      setting="highlightLinks"
      icon="a11y/link-fill"
      label="Highlight Links"
      description="Underline all"
    />

    <ToggleCard
      id="a11y-reduce-motion"
      setting="reduceMotion"
      icon="a11y/lightning-fill"
      label="Reduce Motion"
      description="Stop animations"
    />

    <ToggleCard
      id="a11y-enhanced-focus"
      setting="enhancedFocus"
      icon="a11y/gear-fill"
      label="Enhanced Focus"
      description="Larger indicators"
    />

    <ToggleCard
      id="a11y-screen-reader"
      setting="screenReaderMode"
      icon="a11y/bell-fill"
      label="Screen Reader"
      description="Announce actions"
    />
  </div>
</div>

<style>
  .a11y-section {
    margin-bottom: var(--space-md);
  }

  .a11y-section:last-child {
    margin-bottom: 0;
  }

  .a11y-section__title {
    font-weight: var(--font-bold);
    color: var(--brand-c-text-dark);
    margin-bottom: var(--space-md);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
  }

  .a11y-toggle-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .a11y-section__title {
    }
  }
</style>
