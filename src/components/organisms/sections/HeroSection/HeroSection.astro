---
/**
 * HeroSection - Unified hero/intro section organism
 *
 * Consolidates: HeroSection, PresentationHeroSection, TitleSection, IntroTextSection
 *
 * Variants:
 * - simple:       Plain background with text content (insights, services, projects, assets)
 * - image:        Background image with overlay — full, left, or right position
 * - gradient:     Gradient background using theme tokens (contact, landing pages)
 * - presentation: Full viewport title slide for reader/presentations (replaces TitleSection + PresentationHeroSection)
 * - intro:        Minimal text-only section — lead paragraph + subtitles (replaces IntroTextSection)
 *
 * Usage:
 * <HeroSection title="Welcome" variant="simple" />
 * <HeroSection title="About" variant="image" image={heroImg} />
 * <HeroSection title="Contact" variant="gradient" gradient="primary" />
 * <HeroSection title="Article" variant="presentation" category="Insights" date="Feb 2026" image="/img/hero.jpg" />
 * <HeroSection variant="intro" lead="Opening paragraph" subtitles={['Point one', 'Point two']} />
 *
 * CSS: HeroSection.style.css, HeroSection.responsive.css, HeroSection.a11y.css
 */
import { Image } from 'astro:assets';
import Button from '../../../atoms/Button/Button.astro';

interface Props {
  /* ---- Core content ---- */
  title?: string;
  subtitle?: string;
  description?: string;
  extraText?: string;

  /* ---- Intro variant ---- */
  lead?: string;
  subtitles?: string[];

  /* ---- Presentation meta ---- */
  category?: string;
  date?: string;
  readingTime?: number;

  /* ---- Image ---- */
  image?: ImageMetadata | string;
  imageAlt?: string;
  imagePosition?: 'full' | 'left' | 'right';
  overlayOpacity?: number;

  /* ---- Variant / theme ---- */
  variant?: 'simple' | 'image' | 'gradient' | 'presentation' | 'intro';
  gradient?: 'hero' | 'primary' | 'primary-soft' | 'primary-light' | 'secondary' | 'secondary-soft' | 'neutral';
  alignment?: 'left' | 'center';
  containerSize?: '6xl' | '7xl' | 'full';
  pattern?: boolean;

  /* ---- Buttons ---- */
  buttons?: Array<{
    text: string;
    href: string;
    variant?: 'primary' | 'secondary' | 'outline';
  }>;
}

const {
  title,
  subtitle,
  description,
  extraText,
  lead,
  subtitles = [],
  category,
  date,
  readingTime,
  image,
  imageAlt = '',
  imagePosition = 'full',
  overlayOpacity = 0.6,
  variant = 'simple',
  gradient = 'hero',
  alignment = 'left',
  containerSize = '6xl',
  pattern = false,
  buttons = [],
} = Astro.props;

const alignmentClass = alignment === 'center' ? 'hero-section--centered' : '';
const patternClass = pattern ? 'hero-section--pattern' : '';
const hasImage = !!image;
const isAstroImage = hasImage && typeof image !== 'string';
const hasActions = buttons.length > 0;
const hasMeta = !!(category || date || readingTime);
---

{/* ============================================================
    INTRO VARIANT — minimal text section
    ============================================================ */}
{variant === 'intro' ? (
  <section class={`hero-section hero-section--intro ${alignmentClass}`}>
    <div class="container">
      <div class="hero-section__intro-content">
        {lead && <p class="hero-section__lead">{lead}</p>}
        {subtitles.map((sub) => (
          <p class="hero-section__intro-subtitle">{sub}</p>
        ))}
        <slot />
      </div>
    </div>
  </section>

) : variant === 'presentation' ? (
  /* ============================================================
     PRESENTATION VARIANT — full viewport title slide
     ============================================================ */
  <section class={`hero-section hero-section--presentation ${hasImage ? 'hero-section--has-image' : ''} ${alignmentClass}`}>

    {/* Background image */}
    {hasImage && (
      <div class="hero-section__pres-image-wrapper">
        {isAstroImage ? (
          <Image src={image as ImageMetadata} alt={imageAlt} class="hero-section__pres-image" />
        ) : (
          <img src={image as string} alt={imageAlt} class="hero-section__pres-image" />
        )}
        <div class="hero-section__pres-overlay" style={`--overlay-opacity: ${overlayOpacity}`}></div>
      </div>
    )}

    {/* Content */}
    <div class="hero-section__pres-content">
      {hasMeta && (
        <div class="hero-section__meta">
          {category && <span class="hero-section__category">{category}</span>}
          {date && <span class="hero-section__date">{date}</span>}
          {readingTime && (
            <span class="hero-section__reading-time">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
              </svg>
              {readingTime} min read
            </span>
          )}
        </div>
      )}

      {title && <h1 class="hero-section__pres-title" set:html={title} />}
      {description && <p class="hero-section__pres-description">{description}</p>}

      {hasActions && (
        <div class="hero-section__buttons">
          {buttons.map(button => (
            <Button href={button.href} variant={button.variant || 'primary'}>
              {button.text}
            </Button>
          ))}
        </div>
      )}
      <slot />
    </div>

    {/* Decorative circles (only when no image) */}
    {!hasImage && (
      <div class="hero-section__decor" aria-hidden="true">
        <div class="hero-section__circle hero-section__circle--1"></div>
        <div class="hero-section__circle hero-section__circle--2"></div>
      </div>
    )}
  </section>

) : variant === 'image' && hasImage && imagePosition === 'full' ? (
  /* ============================================================
     IMAGE VARIANT — full-width background image with overlay
     ============================================================ */
  <section class={`hero-section hero-section--image ${alignmentClass} ${patternClass}`}>
    <div class="hero-section__image-wrapper">
      {isAstroImage ? (
        <Image src={image as ImageMetadata} alt={imageAlt} class="hero-section__image" />
      ) : (
        <img src={image as string} alt={imageAlt} class="hero-section__image" />
      )}
      <div class="hero-section__overlay" style={`--overlay-opacity: ${overlayOpacity}`}></div>
      <div class="hero-section__fade"></div>
      <div class="container">
        <div class="hero-section__content">
          <h1 class="hero-section__title" set:html={title} />
          {subtitle && <p class="hero-section__subtitle">{subtitle}</p>}
          {description && <p class="hero-section__description">{description}</p>}
          {extraText && <p class="hero-section__extra">{extraText}</p>}
          {hasActions && (
            <div class="hero-section__buttons">
              {buttons.map(button => (
                <Button href={button.href} variant={button.variant || 'primary'}>
                  {button.text}
                </Button>
              ))}
            </div>
          )}
          <slot />
        </div>
      </div>
    </div>
  </section>

) : variant === 'image' && hasImage && (imagePosition === 'left' || imagePosition === 'right') ? (
  /* ============================================================
     IMAGE VARIANT — split layout with image left or right
     ============================================================ */
  <section class={`hero-section hero-section--image-split hero-section--image-${imagePosition} ${patternClass}`}>
    <div class="container">
      <div class="hero-section__split-wrapper">
        <div class="hero-section__split-image">
          {isAstroImage ? (
            <Image src={image as ImageMetadata} alt={imageAlt} class="hero-section__image" />
          ) : (
            <img src={image as string} alt={imageAlt} class="hero-section__image" />
          )}
        </div>
        <div class="hero-section__split-content">
          <h1 class="hero-section__title" set:html={title} />
          {subtitle && <p class="hero-section__subtitle">{subtitle}</p>}
          {description && <p class="hero-section__description">{description}</p>}
          {extraText && <p class="hero-section__extra">{extraText}</p>}
          {hasActions && (
            <div class="hero-section__buttons">
              {buttons.map(button => (
                <Button href={button.href} variant={button.variant || 'primary'}>
                  {button.text}
                </Button>
              ))}
            </div>
          )}
          <slot />
        </div>
      </div>
    </div>
  </section>

) : variant === 'gradient' ? (
  /* ============================================================
     GRADIENT VARIANT — gradient background
     ============================================================ */
  <section
    class={`hero-section hero-section--gradient hero-section--gradient-${gradient} ${alignmentClass} ${patternClass}`}
  >
    <div class="container">
      <div class="hero-section__content">
        <h1 class="hero-section__title" set:html={title} />
        {subtitle && <p class="hero-section__subtitle">{subtitle}</p>}
        {description && <p class="hero-section__description">{description}</p>}
        {extraText && <p class="hero-section__extra">{extraText}</p>}
        {hasActions && (
          <div class="hero-section__buttons">
            {buttons.map(button => (
              <Button href={button.href} variant={button.variant || 'primary'}>
                {button.text}
              </Button>
            ))}
          </div>
        )}
        <slot />
      </div>
    </div>
  </section>

) : (
  /* ============================================================
     SIMPLE VARIANT — plain background (default)
     ============================================================ */
  <section class={`hero-section hero-section--simple ${alignmentClass} ${patternClass}`}>
    <div class="container">
      <div class="hero-section__content">
        <h1 class="hero-section__title" set:html={title} />
        {subtitle && <p class="hero-section__subtitle">{subtitle}</p>}
        {description && <p class="hero-section__description">{description}</p>}
        {extraText && <p class="hero-section__extra">{extraText}</p>}
        {hasActions && (
          <div class="hero-section__buttons">
            {buttons.map(button => (
              <Button href={button.href} variant={button.variant || 'primary'}>
                {button.text}
              </Button>
            ))}
          </div>
        )}
        <slot />
      </div>
    </div>
  </section>
)}
