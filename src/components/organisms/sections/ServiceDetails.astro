---
/**
 * ServiceDetails - Card grid with titled bullet lists
 *
 * Used on service detail pages to show "Who This Is For",
 * "What's Included", "Areas Covered" etc.
 *
 * Props:
 * @param cards - Array of card objects with title and items
 */

interface Props {
  cards: Array<{
    title: string;
    items: string[];
  }>;
}

const { cards } = Astro.props;
---

{cards.length > 0 && (
  <section class="service-details section">
    <div class="container container-6xl">
      <div class="details-grid">
        {cards.map(card => (
          <div class="card details-card">
            <h3 class="details-card__title">{card.title}</h3>
            <ul class="details-card__list">
              {card.items.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .service-details {
    background: var(--page-bg);
  }

  .details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-2xl);
  }

  .details-card {
    background: linear-gradient(145deg, var(--neutral-400), var(--color-White));
    box-shadow: var(--shadow-sm);
    border-radius: var(--border-radius-xl);
    padding: var(--space-2xl);
  }

  .details-card__title {
    font-family: var(--font-heading);
    font-weight: var(--font-bold);
    color: var(--neutral-800);
    margin: 0 0 var(--space-lg) 0;
    padding-bottom: var(--space-md);
    border-bottom: 2px solid var(--primary-800);
  }

  .details-card__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .details-card__list li {
    position: relative;
    padding: var(--space-sm) 0 var(--space-sm) var(--space-xl);
    color: var(--neutral-800);
    line-height: var(--leading-relaxed);
  }

  .details-card__list li::before {
    content: '';
    position: absolute;
    left: var(--space-xs);
    top: calc(var(--space-sm) + 8px);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--primary-600);
  }

  /* ========== RESPONSIVE - TABLET (968px) ========== */
  /* @media-stripped-0 */  /* ========== RESPONSIVE - SMALL (400px) ========== */
  /* @media-stripped-1 */  /* ========== RESPONSIVE - VERY SMALL (300px) ========== */
  /* @media-stripped-2 */  /* ========== RESPONSIVE - TINY (200px) ========== */
  /* @media-stripped-3 */</style>
