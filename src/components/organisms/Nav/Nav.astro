---
// JSON Schema-driven Navigation Component
import CartIcon from '../../molecules/shop/CartIcon.astro';
import { Icon } from '../../atoms/Icon';
import type {
  BrandColour, RainbowColour, ColourTier,
  Variant, Shadow
} from '../../../lib/shared-enums';
import './Nav.css';

export interface Props {
  logo?: string;
  links?: Array<{
    label?: string;
    text?: string;
    url?: string;
    href?: string;
  }>;
  actions?: Array<{
    type: "search" | "accessibility" | "contact" | "cart";
    ariaLabel: string;
  }>;
  brandColor?: BrandColour;
  rainbowColor?: RainbowColour;
  colorTier?: ColourTier;
  variant?: Variant;
  shadow?: Shadow;
}

const {
  logo = '/Logo/BrandLogoFooter.png',
  links = [
    { label: 'Home', url: '/' },
    { label: 'About', url: '/about' },
    { label: 'Contact', url: '/contact' }
  ],
  actions = [],
  brandColor = 'neutral',
  rainbowColor,
  colorTier,
  variant = 'glass',
  shadow
} = Astro.props;

const color = rainbowColor || brandColor;
---

<nav 
  class:list={[
    'nav-container',
    color && `color--${color}`,
    variant && `variant-${variant}`,
    shadow && `shadow-${shadow}`,
  ]} 
  id="main-nav"
>
  <div class="nav-content">
    <!-- Mobile Hamburger Menu -->
    <button class="hamburger-menu mobile-only" id="hamburger-btn" aria-label="Toggle menu" type="button">
      <svg viewBox="0 0 64 48">
        <path d="M19,15 L45,15 C70,15 58,-2 49.0177126,7 L19,37"></path>
        <path d="M19,24 L45,24 C61.2371586,24 57,49 41,33 L32,24"></path>
        <path d="M45,33 L19,33 C-8,33 6,-2 22,14 L45,37"></path>
      </svg>
    </button>

    <!-- Logo -->
    <a href="/" class="nav-logo" aria-label="Home">
      <img src={logo} alt="Brand Logo" class="logo-image" />
    </a>

    <!-- Desktop Navigation Links -->
    <ul class="nav-links desktop-only">
      {links.map((link) => {
        const label = link.label || link.text || '';
        const url = link.url || link.href || '#';
        return (
          <li class="nav-item">
            <a href={url} class="nav-link">{label}</a>
          </li>
        );
      })}
    </ul>

    <!-- Action Icons -->
    <div class="nav-actions desktop-only">
      <div class="nav-icon-group">
        <button class="nav-icon-btn" aria-label="Search" type="button">
          <Icon name="magnifying-glass" size={22} />
        </button>
        <button class="nav-icon-btn" aria-label="Accessibility settings" id="a11y-trigger" type="button">
          <Icon name="eye-fill" size={22} />
        </button>
        <a href="/contact" class="nav-icon-btn" aria-label="Contact Us">
          <Icon name="envelope-fill" size={22} />
        </a>
      </div>
      <CartIcon />
    </div>

    <!-- Mobile Navigation Icons -->
    <div class="mobile-nav-icons mobile-only">
      <CartIcon />
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-menu-drawer mobile-only">
    <div class="mobile-menu-icons">
      <button class="mobile-menu-icon-btn" aria-label="Search" type="button">
        <Icon name="magnifying-glass" size={24} />
      </button>
      <button class="mobile-menu-icon-btn" aria-label="Accessibility settings" id="mobile-a11y-trigger" type="button">
        <Icon name="eye-fill" size={24} />
      </button>
      <a href="/contact" class="mobile-menu-icon-btn" aria-label="Contact Us">
        <Icon name="envelope-fill" size={24} />
      </a>
    </div>

    <ul class="mobile-menu-list">
      {links.map((link) => {
        const label = link.label || link.text || '';
        const url = link.url || link.href || '#';
        return (
          <li>
            <a href={url}>{label}</a>
          </li>
        );
      })}
    </ul>
  </div>
</nav>

<script>
  // Setup mobile menu toggle logic
  const nav = document.getElementById('main-nav');
  const btn = document.getElementById('hamburger-btn');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      btn.classList.toggle('active');
      nav.classList.toggle('menu-opened');
    });
  }

  // Scroll detection for navbar blur / background change
  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;
    if (nav) {
      if (currentScroll > 20) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    }
  }, { passive: true });
</script>
