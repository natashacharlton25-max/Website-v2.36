---
/**
 * ForYouGrid - Compact recommendation cards for insights pages
 *
 * 3-column grid of small cards with overlapping images
 * Used specifically on insight article pages for "For You" recommendations
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionTitle from '../../../components/Typography/SectionTitle.astro';

interface ForYouItem {
  slug?: string;
  url?: string;
  title: string;
  description?: string;
  category?: string;
  type?: string;
  cardImage?: ImageMetadata;
}

interface Props {
  items: ForYouItem[];
  basePath?: string;
  maxItems?: number;
}

const { items, basePath = '', maxItems = 4 } = Astro.props;

// Limit items
const displayItems = items.slice(0, maxItems);

if (!displayItems || displayItems.length === 0) return null;

// Get item URL
const getItemUrl = (item: ForYouItem): string => {
  if (item.url) return item.url;
  if (item.slug && basePath) return `${basePath}/${item.slug}`;
  return '#';
};
---

<section class="for-you-section section">
  <div class="container container-7xl">
    <SectionTitle title="Recommended for You" size="sm" dividerColor="primary" icon="star-fill" iconColor="primary" iconStyle="bare" />
    <div class="for-you-grid">
      {displayItems.map(item => (
        <a href={getItemUrl(item)} class="card for-you-card">
          {item.cardImage ? (
            <div class="for-you-card__image">
              <Image
                src={item.cardImage}
                alt={item.title}
                width={400}
                height={500}
              />
            </div>
          ) : (
            <div class="for-you-card__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
              </svg>
            </div>
          )}
          <div class="for-you-card__content">
            <h3 class="for-you-card__title">{item.title}</h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .for-you-section {
    padding: var(--space-3xl) 0;
    background: var(--brand-c-bg);
  }

  .for-you-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .for-you-card {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    text-decoration: none;
    height: 100%;
    background-color: transparent;
    box-shadow: none;
  }

  .for-you-card__image {
    flex-shrink: 0;
    width: 80px;
    height: 100px;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 6px 16px color-mix(in oklch, var(--color-Black) 20%, transparent);
    position: relative;
    z-index: 2;
    margin-right: -12px;
    align-self: center;
    border: 3px solid var(--color-White);
    transition: border-color var(--transition-base);
  }

  .for-you-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .for-you-card__icon {
    flex-shrink: 0;
    width: 80px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, var(--brand-c-primary), var(--brand-c-primary-dark));
    border-radius: var(--radius-md);
    box-shadow: 0 6px 16px color-mix(in oklch, var(--color-Black) 20%, transparent);
    color: var(--color-White);
    position: relative;
    z-index: 2;
    margin-right: -12px;
    align-self: center;
    border: 3px solid var(--color-White);
    transition: border-color var(--transition-base);
  }

  .for-you-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    padding-left: calc(var(--space-md) + 12px);
    background: linear-gradient(135deg, var(--brand-c-primary-dark) 0%, var(--brand-c-primary-dark) 100%);
    border-radius: var(--radius-lg);
    box-shadow: 0 4px 12px color-mix(in oklch, var(--color-Black) 10%, transparent);
    min-height: 100px;
    justify-content: center;
    position: relative;
  }

  .for-you-card__title {
    margin: 0;
    font-weight: var(--font-semibold);
    color: var(--color-White);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Hover: no movement, border goes green */
  .for-you-card:hover {
    transform: none;
    box-shadow: none;
  }

  .for-you-card:hover .for-you-card__image {
    border-color: var(--brand-c-primary);
  }

  .for-you-card:hover .for-you-card__icon {
    border-color: var(--brand-c-primary);
  }


  /* ========== RESPONSIVE - MOBILE (600px) ========== */
  @media (max-width: 600px) {
    .for-you-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .for-you-card {
      flex-direction: column;
      align-items: center;
    }

    .for-you-card__image {
      width: 100%;
      height: 140px;
      margin-right: 0;
      margin-bottom: -16px;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      border: none;
    }

    .for-you-card__icon {
      width: 100%;
      height: 100px;
      margin-right: 0;
      margin-bottom: -16px;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      border: none;
    }

    .for-you-card__content {
      width: 100%;
      padding: var(--space-md);
      min-height: auto;
      border-radius: 0 0 var(--radius-lg) var(--radius-lg);
      text-align: center;
      align-items: center;
    }

    .for-you-card__title {
      -webkit-line-clamp: 2;
    }
  }

  /* ========== RESPONSIVE - SMALL (400px) ========== */
  @media (max-width: 400px) {
    .for-you-section {
      padding: var(--space-xl) 0;
    }

    .for-you-card__image {
      height: 120px;
    }

    .for-you-card__content {
      padding: var(--space-sm);
    }
  }

  /* ========== REDUCED MOTION ========== */
  :global(#a11y-content-wrapper.a11y-reduce-motion) .for-you-card__content,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .for-you-card__image,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .for-you-card__icon {
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .for-you-card__content,
    .for-you-card__image,
    .for-you-card__icon {
      transition: none;
    }
  }
</style>
