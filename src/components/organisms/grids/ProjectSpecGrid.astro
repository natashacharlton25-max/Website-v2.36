---
/**
 * ProjectSpecGrid - 4-column grid for project spec cards
 * Uses vertical stacked ProjectSpecCard component
 */
import ProjectSpecCard from '../../molecules/cards/ProjectSpecCard.astro';

interface SpecItem {
  iconName: string;
  label: string;
  value: string;
  variant?: 'primary' | 'secondary' | 'accent';
}

interface Props {
  specs: SpecItem[];
}

const { specs } = Astro.props;
---

<div class="project-spec-grid">
  {specs.map(spec => (
    <div class="project-spec-wrapper">
      <ProjectSpecCard
        iconName={spec.iconName}
        label={spec.label}
        value={spec.value}
        variant={spec.variant}
      />
    </div>
  ))}
</div>

<style>
  .project-spec-grid {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    grid-template-columns: repeat(4, 1fr);
  }

  .project-spec-wrapper {
    display: flex;
    height: 100%;
  }

  .project-spec-wrapper :global(.project-spec-card) {
    flex: 1;
    height: 100%;
  }

