---
/**
 * ScrollMorphZone
 * src/components/organisms/ScrollMorph/ScrollMorphZone.astro
 *
 * Section-scoped composition: sticky pattern grid that morphs icons +
 * shifts colour as sections scroll past.
 *
 * Uses shared atoms:
 *   ZonePalette.css        — colour tokens
 *   scroll-color-driver.ts — GSAP bg + pattern colour transitions
 *   pattern-morph.ts       — MorphSVG icon morphing
 *   stellar-parallax.ts    — ParallaxDecor depth movement
 *
 * Colours use palette tokens:
 *   bg:      'var(--zone-bg-primary-deep)'
 *   pattern: 'var(--zone-pattern-secondary)'
 */
// Zone palette tokens are now pre-computed hex, embedded in each theme's :root block.
// No separate ZonePalette.css import needed.
import './ScrollMorphZone.style.css';
import './ScrollMorphZone.responsive.css';
import './ScrollMorphZone.a11y.css';

import { PatternOverlay } from '../../effects/PatternOverlay';
import Card from '../../atoms/Card/Card.astro';
import { ParallaxDecor } from '../../effects/ParallaxDecor';

interface ScrollSection {
  bg: string;
  pattern: string;
  icon: string;
  title?: string;
  body?: string;
  cardVariant?: string;
  drawEffect?: string;
  decor?: {
    icons?: Array<{ name: string; size?: 'sm' | 'md' | 'lg'; depth: number; top?: string; left?: string; right?: string; bottom?: string }>;
    rings?: Array<{ size: 'sm' | 'md' | 'lg'; depth: number; top?: string; left?: string; right?: string; bottom?: string }>;
    dots?: Array<{ size?: 'sm' | 'md'; depth: number; top?: string; left?: string; right?: string; bottom?: string }>;
  };
}

interface Props {
  sections?: ScrollSection[];
  patternIcon?: string;
  patternScale?: number;
  patternOpacity?: number;
  cardDepth?: number;
  dark?: boolean;
  /**
   * 'section' — pattern sticky within this zone only (default, safe).
   *             Nav/footer unaffected.
   * 'page'    — pattern fixed to viewport; nav/footer need own z-index.
   */
  scope?: 'page' | 'section';
  class?: string;
}

const {
  sections = [],
  patternIcon = 'wellness/heart-fill',
  patternScale = 120,
  patternOpacity = 0.3,
  cardDepth = 1.3,
  dark = true,
  scope = 'section',
  class: className = '',
} = Astro.props;

const hasSlot = Astro.slots.has('default');
---

<div class={`scroll-morph-zone ${className}`} data-scroll-morph data-scope={scope} style={`--zone-pattern-url: url('/Icons/phosphor/${patternIcon}.svg')`}>
  <!--
    interactive: renders individual DOM <svg><path> icons.
    MorphSVG needs real <path> elements — without interactive,
    PatternOverlay renders CSS mask-image which cannot be morphed.
  -->
  <PatternOverlay icons={[patternIcon]} opacity={patternOpacity} scale={patternScale} interactive />

  {hasSlot ? (
    <slot />
  ) : (
    sections.map((section) => (
      <section
        class={`scroll-morph-zone__section ${dark ? 'scroll-morph-zone__section--dark' : ''}`}
        data-zone-bg={section.bg}
        data-scroll-pattern={section.pattern}
        data-scroll-icon={section.icon}
        data-scroll-effect={section.drawEffect || undefined}
      >
        {section.decor && (
          <ParallaxDecor icons={section.decor.icons} rings={section.decor.rings} dots={section.decor.dots} />
        )}

        {(section.title || section.body) && (
          <Card variant={(section.cardVariant as any) || 'liquid-glass'} radius="xl" padding="xl" data-depth={cardDepth}>
            {section.title && <h3 class="card__title" style="text-transform:none; letter-spacing:normal;">{section.title}</h3>}
            {section.body && <p class="card__text">{section.body}</p>}
          </Card>
        )}
      </section>
    ))
  )}
</div>

<script>
  /**
   * ScrollMorphZone — client wiring
   * Uses shared atoms: pattern-morph + scroll-color-driver + stellar-parallax
   */
  import '../../../lib/animation/pattern-morph';
  import '../../../lib/animation/stellar-parallax';
  import { gsap } from 'gsap';
  import { resolveColor, initScrollColorDriver } from '../../../lib/animation/scroll-color-driver';

  function initScrollMorphZones() {
    const wrapper = document.getElementById('a11y-content-wrapper');
    const textOnly = wrapper?.classList.contains('a11y-text-only');

    document.querySelectorAll<HTMLElement>('[data-scroll-morph]').forEach(zone => {
      // Double-init guard — prevent stacked listeners/triggers
      if ((zone as any).__smzInit) return;
      (zone as any).__smzInit = true;

      const sections = zone.querySelectorAll<HTMLElement>('[data-zone-bg]');
      if (!sections.length) return;

      // Text-only: zone bg is CSS-driven, no inline styles
      if (textOnly) return;

      // Drive zone background colour via shared driver
      initScrollColorDriver(zone, sections, { paletteEl: zone });

      // --- a11y: text-only toggle (class change is synchronous, no CSS load needed) ---
      if (wrapper) {
        const obs = new MutationObserver(() => {
          if (wrapper.classList.contains('a11y-text-only')) {
            gsap.killTweensOf(zone);
            zone.style.setProperty('background-color', 'var(--page-bg, #faf8f7)');
          }
        });
        obs.observe(wrapper, { attributes: true, attributeFilter: ['class'] });
      }

      // --- Theme switch: re-resolve zone bg after CSS has fully loaded ---
      // ThemeSwitcher dispatches 'themeChanged' only after the new CSS file's
      // load event, so getComputedStyle reads the correct token values here.
      // Icon colour is owned by pattern-morph.ts — not handled here.
      window.addEventListener('themeChanged', () => {
        if (wrapper?.classList.contains('a11y-text-only')) return;

        const viewCenter = window.innerHeight / 2;
        let current = sections[0];
        sections.forEach(s => {
          const r = s.getBoundingClientRect();
          if (r.top < viewCenter && r.bottom > viewCenter) current = s;
        });

        const rawBg = current?.dataset.zoneBg;
        if (rawBg) {
          const bg = resolveColor(rawBg, zone);
          gsap.to(zone, { backgroundColor: bg, duration: 0.4, ease: 'power2.inOut' });
        }
      });
    });
  }

  // Delay: OverlayScrollbars must create [data-overlayscrollbars-viewport]
  // before ScrollTrigger can use it as scroller. 300ms matches pattern-morph.
  function setup(): void {
    setTimeout(initScrollMorphZones, 300);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
  document.addEventListener('astro:page-load', setup);
</script>
