---
/**
 * Footer — Base footer with optional canvas reveal
 *
 * <Footer />                    — plain dark footer
 * <Footer animated />           — with canvas reveal
 * <Footer animated backgroundImage="/custom.jpg" />
 *
 * @param animated        - Enable canvas reveal (default false)
 * @param backgroundImage - Image for reveal effect
 */
import RevealCanvas from '../../../atoms/canvas/RevealCanvas/RevealCanvas.astro';
import { BRAND_CONFIG } from '../../../../lib/config/brand';

interface Props {
  animated?: boolean;
  backgroundImage?: string;
}

const {
  animated = false,
  backgroundImage = BRAND_CONFIG.footer.defaultImage
} = Astro.props;

const variant = animated ? 'light' : 'dark';

const footerLinks = [
  { label: 'Legal', href: '/legal/terms' },
  { label: 'Contact Us', href: '#', id: 'contactUsBtn', isAction: true },
  { label: 'Cookie Settings', href: '#', id: 'cookieSettings', isAction: true }
];
---

{animated ? (
  <div class="footer-mask">
    <RevealCanvas
      backgroundImage={backgroundImage}
      canvasId="footer-canvas"
    />
    <div class="footer-mask__content">
      <footer class={`footer footer--${variant}`}>
        <div class="footer__container container container-7xl">
          <div class="footer__brand-section">
            <img
              src="/Logo/BrandLogoFooter.png"
              alt={`${BRAND_CONFIG.name} logo`}
              class="footer__logo"
              width="120"
              height="120"
            />
            <h2 class="footer__brand-name">{BRAND_CONFIG.name}</h2>
          </div>

          <nav class="footer__nav" aria-label="Footer navigation">
            {footerLinks.map((link, index) => (
              <>
                <a
                  href={link.href}
                  class="footer__link"
                  id={link.id}
                  role={link.isAction ? 'button' : undefined}
                >
                  {link.label}
                </a>
                {index < footerLinks.length - 1 && (
                  <span class="footer__nav-dot" aria-hidden="true"></span>
                )}
              </>
            ))}
          </nav>

          <p class="footer__copyright">
            ©&nbsp;{new Date().getFullYear()}&nbsp;<strong>{BRAND_CONFIG.name}</strong>. All rights reserved.
          </p>
        </div>
      </footer>
    </div>
  </div>
) : (
  <footer class={`footer footer--${variant}`}>
    <div class="footer__container container container-7xl">
      <div class="footer__brand-section">
        <img
          src="/Logo/BrandLogoFooter.png"
          alt={`${BRAND_CONFIG.name} logo`}
          class="footer__logo"
          width="120"
          height="120"
        />
        <h2 class="footer__brand-name">{BRAND_CONFIG.name}</h2>
      </div>

      <nav class="footer__nav" aria-label="Footer navigation">
        {footerLinks.map((link, index) => (
          <>
            <a
              href={link.href}
              class="footer__link"
              id={link.id}
              role={link.isAction ? 'button' : undefined}
            >
              {link.label}
            </a>
            {index < footerLinks.length - 1 && (
              <span class="footer__nav-dot" aria-hidden="true"></span>
            )}
          </>
        ))}
      </nav>

      <p class="footer__copyright">
        © {new Date().getFullYear()} <strong>{BRAND_CONFIG.name}</strong>. All rights reserved.
      </p>
    </div>
  </footer>
)}

<script>
  function initFooter() {
    const contactBtn = document.getElementById('contactUsBtn');
    contactBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      (window as any).openContactPopup?.();
    });

    const cookieBtn = document.getElementById('cookieSettings');
    cookieBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      const banner = document.getElementById('cookieBanner');
      if (banner) {
        banner.classList.remove('hidden');
        banner.style.display = '';
      }
    });

    const footerMask = document.querySelector('.footer-mask');
    const footer = document.querySelector('.footer--light');
    if (footerMask && footer) {
      footerMask.addEventListener('mouseenter', () => footer.classList.add('footer--reveal-active'));
      footerMask.addEventListener('mouseleave', () => footer.classList.remove('footer--reveal-active'));
    }
  }

  document.addEventListener('astro:page-load', initFooter);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooter);
  } else {
    initFooter();
  }
</script>