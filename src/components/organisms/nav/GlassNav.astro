---
// Glassmorphic Navigation Component
import CartIcon from '../../molecules/shop/CartIcon.astro';
import { Icon } from '../../atoms/Icon';
import { LottieIcon } from '../../atoms/LottieIcon';
import { MAIN_NAV_LINKS, NAV_ITEMS_WITH_MENUS, MEGA_MENUS } from '../../../lib/config/navigation';
import './GlassNav.css';
---

<nav class="nav-container" id="main-nav">
  <div class="nav-content">
    <!-- Mobile Hamburger Menu -->
    <button class="hamburger-menu mobile-only" id="hamburger-btn" aria-label="Toggle menu">
      <svg viewBox="0 0 64 48">
        <path d="M19,15 L45,15 C70,15 58,-2 49.0177126,7 L19,37"></path>
        <path d="M19,24 L45,24 C61.2371586,24 57,49 41,33 L32,24"></path>
        <path d="M45,33 L19,33 C-8,33 6,-2 22,14 L45,37"></path>
      </svg>
    </button>

    <!-- Logo -->
    <a href="/" class="nav-logo">
      <img src="/Logo/BrandLogoFooter.png" alt="Walking With A Smile" class="logo-image" />
    </a>

    <!-- Mobile Cart Icon -->
    <div class="mobile-nav-icons mobile-only">
      <a href="/checkout" class="mobile-icon-btn mobile-cart-btn" aria-label="Cart">
        <Icon name="basket-fill" size={24} class="mobile-basket-icon" />
      </a>
    </div>

    <!-- Desktop Navigation Links -->
    <div class="nav-links desktop-only">
      {MAIN_NAV_LINKS.map(link => (
        NAV_ITEMS_WITH_MENUS.includes(link.text) ? (
          <a
            href={link.href}
            class="nav-item-expandable"
            data-expand={link.text.toLowerCase()}
          >
            {link.text}
          </a>
        ) : (
          <a href={link.href}>{link.text}</a>
        )
      ))}

      <!-- Nav Icon Buttons -->
      <div class="nav-icon-group">
        <!-- Search Icon -->
        <button class="nav-icon-btn nav-icon-btn--lottie" data-action="open-search" aria-label="Search">
          <LottieIcon slug="lottie-search" size={24} class="nav-lottie-icon" />
          <Icon name="magnifying-glass-fill" size={24} class="nav-static-icon" />
        </button>

        <!-- Accessibility Icon — hover: preset menu, click: full panel -->
        <button class="nav-icon-btn nav-icon-btn--lottie" data-expand="accessibility" data-action="open-a11y-panel" aria-label="Your View" aria-expanded="false">
          <LottieIcon slug="lottie-visibility" size={24} class="nav-lottie-icon" />
          <Icon name="eye-fill" size={24} class="nav-static-icon" />
        </button>

        <!-- Contact Page Link -->
        <a href="/contact" class="nav-icon-btn nav-icon-btn--lottie" aria-label="Contact Us">
          <LottieIcon slug="lottie-mail" size={24} class="nav-lottie-icon" />
          <Icon name="envelope-fill" size={24} class="nav-static-icon" />
        </a>
      </div>

      <CartIcon />
    </div>
  </div>

  <!-- Expandable Mega Menus -->
  {Object.entries(MEGA_MENUS).map(([key, items]) => (
    <div class={`expandable-menu expandable-menu-${key}`}>
      <div class="expandable-menu-wrapper">
        {items.map(item => (
          <a
            href={item.href}
            class={`expandable-item ${item.icon ? 'expandable-item--icon' : ''} ${item.image ? 'expandable-item--has-media' : ''}`}
            data-action={
              item.href === '#share' ? 'copy-link' :
              item.href === '#search' ? 'open-search' :
              item.href === '#accessibility' ? 'open-a11y-panel' :
              null
            }
          >
            {item.image && (
              <div class="expandable-media">
                <img src={item.image} alt="" class="expandable-media__img" />
              </div>
            )}
            {item.icon === 'mail' && (
              <Icon name="envelope-fill" size={20} class="expandable-icon" />
            )}
            {item.icon === 'share' && (
              <Icon name="share-network-fill" size={20} class="expandable-icon" />
            )}
            {item.icon === 'search' && (
              <Icon name="magnifying-glass-fill" size={20} class="expandable-icon" />
            )}
            {item.icon === 'eye' && (
              <Icon name="eye-fill" size={20} class="expandable-icon" />
            )}
            <div class="expandable-item__content">
              <h3>{item.title}</h3>
              {item.description && <p>{item.description}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  ))}

  <!-- Accessibility Mega Menu — preset slots -->
  <div class="expandable-menu expandable-menu-accessibility">
    <div class="expandable-menu-wrapper a11y-presets-nav">
      <button class="a11y-preset-slot" data-preset-slot="1" aria-label="Preset 1">
        <Icon name="sliders-fill" size={20} class="a11y-preset-slot__icon" />
        <span class="a11y-preset-slot__name">Preset 1</span>
        <span class="a11y-preset-slot__empty">Empty — set up on Your View page</span>
      </button>
      <button class="a11y-preset-slot" data-preset-slot="2" aria-label="Preset 2">
        <Icon name="sliders-fill" size={20} class="a11y-preset-slot__icon" />
        <span class="a11y-preset-slot__name">Preset 2</span>
        <span class="a11y-preset-slot__empty">Empty — set up on Your View page</span>
      </button>
      <button class="a11y-preset-slot" data-preset-slot="3" aria-label="Preset 3">
        <Icon name="sliders-fill" size={20} class="a11y-preset-slot__icon" />
        <span class="a11y-preset-slot__name">Preset 3</span>
        <span class="a11y-preset-slot__empty">Empty — set up on Your View page</span>
      </button>
      <a href="/accessibility" class="a11y-preset-slot a11y-preset-slot--link">
        <Icon name="gear-fill" size={20} class="a11y-preset-slot__icon" />
        <span class="a11y-preset-slot__name">Open Your View</span>
      </a>
    </div>
  </div>

  <!-- Mobile Menu Items -->
  <div class="mobile-menu-icons mobile-only">
    <button class="mobile-menu-icon-btn" data-action="open-search" aria-label="Search">
      <Icon name="magnifying-glass-fill" size={24} />
    </button>
    <a href="/contact" class="mobile-menu-icon-btn" aria-label="Contact Us">
      <Icon name="envelope-fill" size={24} />
    </a>
    <button class="mobile-menu-icon-btn" data-action="open-a11y-panel" aria-label="Accessibility">
      <Icon name="eye-fill" size={24} />
    </button>
    <a href="/checkout" class="mobile-menu-icon-btn mobile-menu-cart" aria-label="Cart">
      <Icon name="basket-fill" size={24} />
    </a>
  </div>
  <ul class="mobile-menu-list mobile-only">
    {MAIN_NAV_LINKS.map(link => (
      <li><a href={link.href}>{link.text}</a></li>
    ))}
  </ul>

</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    let menuOpen = false;

    const hamburgerBtn = document.getElementById('hamburger-btn');
    const nav = document.getElementById('main-nav');

    // Handle scroll to add/remove background
    let lastScroll = 0;
    window.addEventListener('scroll', () => {
      const currentScroll = window.pageYOffset;

      if (currentScroll > 50) {
        nav?.classList.add('scrolled');
      } else {
        nav?.classList.remove('scrolled');
      }

      // Hide nav on scroll down, show on scroll up
      if (currentScroll > lastScroll && currentScroll > 100) {
        nav?.classList.add('nav-hidden');
      } else {
        nav?.classList.remove('nav-hidden');
      }

      lastScroll = currentScroll;
    });

    function openMobileMenu() {
      menuOpen = true;
      hamburgerBtn?.classList.add('active');
      hamburgerBtn?.setAttribute('aria-expanded', 'true');
      nav?.classList.add('menu-opened');
      document.body.style.overflow = 'hidden';
      // Focus first menu item
      const firstLink = document.querySelector('.mobile-menu-list a') as HTMLElement | null;
      firstLink?.focus();
    }

    function closeMobileMenu() {
      menuOpen = false;
      hamburgerBtn?.classList.remove('active');
      hamburgerBtn?.setAttribute('aria-expanded', 'false');
      nav?.classList.remove('menu-opened');
      document.body.style.overflow = '';
    }

    hamburgerBtn?.setAttribute('aria-expanded', 'false');

    hamburgerBtn?.addEventListener('click', () => {
      if (menuOpen) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    });

    // Keyboard: Escape closes mobile menu, returns focus to hamburger
    hamburgerBtn?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuOpen) {
        closeMobileMenu();
        hamburgerBtn?.focus();
      }
    });

    // Close menu when clicking on a link
    const mobileLinks = document.querySelectorAll('.mobile-menu-list a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeMobileMenu();
      });

      // Escape from inside menu → close + focus hamburger
      link.addEventListener('keydown', (e: Event) => {
        if ((e as KeyboardEvent).key === 'Escape') {
          closeMobileMenu();
          hamburgerBtn?.focus();
        }
      });
    });

    // Tab past last mobile menu item → close menu
    const allMobileLinks = document.querySelectorAll('.mobile-menu-list a, .mobile-menu-icons a, .mobile-menu-icons button');
    if (allMobileLinks.length > 0) {
      const lastItem = allMobileLinks[allMobileLinks.length - 1];
      lastItem.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Tab' && !(e as KeyboardEvent).shiftKey && menuOpen) {
          closeMobileMenu();
        }
      });
    }

    // Handle resize to clean up menu state below 200px
    window.addEventListener('resize', () => {
      if (window.innerWidth <= 200 && menuOpen) {
        closeMobileMenu();
      }
    });

    // Expandable mega menu functionality - hover based
    const expandButtons = document.querySelectorAll('[data-expand]');
    const expandableMenus = document.querySelectorAll('.expandable-menu');
    const menuTypes = ['assets', 'insights', 'services', 'settings', 'accessibility'];
    let currentExpanded: string | null = null;
    let hoverTimeout: ReturnType<typeof setTimeout> | null = null;

    function closeAllMenus() {
      menuTypes.forEach(type => {
        nav?.classList.remove(`expanded-${type}`);
      });
      expandButtons.forEach(btn => {
        btn.setAttribute('aria-expanded', 'false');
        btn.classList.remove('active');
      });
      currentExpanded = null;
    }

    function openMenu(menuType: string, button: Element) {
      if (currentExpanded === menuType) return;
      closeAllMenus();
      nav?.classList.add(`expanded-${menuType}`);
      button.setAttribute('aria-expanded', 'true');
      button.classList.add('active');
      currentExpanded = menuType;
    }

    // Hover events for nav buttons
    expandButtons.forEach(button => {
      button.addEventListener('mouseenter', () => {
        if (hoverTimeout) clearTimeout(hoverTimeout);
        const menuType = button.getAttribute('data-expand');
        if (menuType) {
          openMenu(menuType, button);
        }
      });

      button.addEventListener('mouseleave', () => {
        hoverTimeout = setTimeout(() => {
          closeAllMenus();
        }, 150);
      });
    });

    // Keep menu open when hovering over the expandable menu area
    expandableMenus.forEach(menu => {
      menu.addEventListener('mouseenter', () => {
        if (hoverTimeout) clearTimeout(hoverTimeout);
      });

      menu.addEventListener('mouseleave', () => {
        hoverTimeout = setTimeout(() => {
          closeAllMenus();
        }, 150);
      });
    });

    // Keep menu open when hovering back to nav-content
    const navContent = document.querySelector('.nav-content');
    navContent?.addEventListener('mouseenter', () => {
      // Don't close if we re-enter nav area
    });

    // Close menus when mouse leaves the entire nav container
    nav?.addEventListener('mouseleave', () => {
      hoverTimeout = setTimeout(() => {
        closeAllMenus();
      }, 150);
    });

    // Keyboard: Enter/Space on nav link → toggle mega menu, don't navigate
    expandButtons.forEach(button => {
      button.addEventListener('keydown', (e: Event) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') {
          ke.preventDefault();
          const menuType = button.getAttribute('data-expand');
          if (!menuType) return;

          if (currentExpanded === menuType) {
            closeAllMenus();
          } else {
            openMenu(menuType, button);
            // Focus first item in the expanded menu
            const menu = document.querySelector(`.expandable-menu-${menuType}`);
            const firstLink = menu?.querySelector('a') as HTMLElement | null;
            firstLink?.focus();
          }
        }
      });
    });

    // Keyboard: Escape closes menu, returns focus to parent nav link
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && currentExpanded) {
        const activeBtn = document.querySelector(`[data-expand="${currentExpanded}"]`) as HTMLElement | null;
        closeAllMenus();
        activeBtn?.focus();
      }
    });

    // Keyboard: Tab past last mega menu item → collapse menu
    expandableMenus.forEach(menu => {
      const links = menu.querySelectorAll('a');
      if (links.length > 0) {
        const lastLink = links[links.length - 1];
        lastLink.addEventListener('keydown', (e: Event) => {
          const ke = e as KeyboardEvent;
          if (ke.key === 'Tab' && !ke.shiftKey) {
            closeAllMenus();
          }
        });

        // Shift+Tab on first item → collapse and focus parent
        const firstLink = links[0];
        firstLink.addEventListener('keydown', (e: Event) => {
          const ke = e as KeyboardEvent;
          if (ke.key === 'Tab' && ke.shiftKey) {
            const activeBtn = document.querySelector(`[data-expand="${currentExpanded}"]`) as HTMLElement | null;
            closeAllMenus();
            if (activeBtn) {
              ke.preventDefault();
              activeBtn.focus();
            }
          }
        });
      }
    });

    // Handle special actions in menu items

    // Accessibility panel
    const a11yLinks = document.querySelectorAll('[data-action="open-a11y-panel"]');
    a11yLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        closeAllMenus();
        closeMobileMenu();
        // Open the accessibility panel
        const panel = document.getElementById('a11y-panel');
        const backdrop = document.querySelector('.a11y-panel__backdrop') as HTMLElement;
        if (panel && backdrop) {
          panel.classList.add('is-open');
          backdrop.classList.add('is-visible');
          panel.removeAttribute('hidden');
          backdrop.removeAttribute('hidden');
        }
      });
    });

    // Accessibility preset slots — load from localStorage
    function initPresetSlots() {
      const slots = document.querySelectorAll<HTMLElement>('[data-preset-slot]');
      slots.forEach(slot => {
        const slotNum = slot.dataset.presetSlot;
        const key = `a11y-preset-${slotNum}`;
        const saved = localStorage.getItem(key);
        const nameEl = slot.querySelector('.a11y-preset-slot__name');
        const emptyEl = slot.querySelector('.a11y-preset-slot__empty');

        if (saved) {
          try {
            const preset = JSON.parse(saved);
            if (nameEl) nameEl.textContent = preset.name || `Preset ${slotNum}`;
            if (emptyEl) (emptyEl as HTMLElement).style.display = 'none';
            slot.classList.add('a11y-preset-slot--saved');

            slot.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              // Apply the saved settings
              const { applySettings, saveSettings } = (window as any).__a11yPanel || {};
              if (applySettings && saveSettings) {
                saveSettings(preset.settings);
                applySettings(preset.settings);
              }
              closeAllMenus();
            });
          } catch { /* invalid JSON */ }
        } else {
          if (nameEl) (nameEl as HTMLElement).style.display = 'none';
          slot.classList.add('a11y-preset-slot--empty');
        }
      });
    }
    initPresetSlots();
    document.addEventListener('astro:page-load', initPresetSlots);

    // Copy link to clipboard
    const copyLinks = document.querySelectorAll('[data-action="copy-link"]');
    copyLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        closeAllMenus();
        const url = window.location.href;
        navigator.clipboard.writeText(url).then(() => {
          if ((window as any).showToast) {
            (window as any).showToast({
              message: 'Link copied to clipboard!',
              theme: 'professional',
              animation: 'slide',
              duration: 3000
            });
          }
        }).catch(err => {
          console.error('Failed to copy link:', err);
        });
      });
    });

    // Open search - navigate to search page
    const searchLinks = document.querySelectorAll('[data-action="open-search"]');
    searchLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        closeAllMenus();
        closeMobileMenu();
        window.location.href = '/search';
      });
    });

    // Lottie icon hover animations for nav buttons
    const lottieButtons = document.querySelectorAll('.nav-icon-btn--lottie');
    lottieButtons.forEach(btn => {
      const lottieIcon = btn.querySelector('[data-lottie-icon]') as HTMLElement;
      if (!lottieIcon) return;

      btn.addEventListener('mouseenter', () => {
        lottieIcon.dispatchEvent(new CustomEvent('lottie:play'));
      });

      btn.addEventListener('mouseleave', () => {
        lottieIcon.dispatchEvent(new CustomEvent('lottie:stop'));
      });
    });

  });
</script>
