---
/**
 * Custom Scrollbar Component
 * Styles the native browser scrollbar with brand colors
 *
 * Features:
 * - Gradient thumb (Primary → Secondary)
 * - Hover and active states
 * - Reduced motion support
 * - Mobile optimizations
 * - Firefox support
 *
 * Usage: Add <CustomScrollbar /> to BaseLayout
 */
---

<style is:global>
  /* =========================================================
     CUSTOM SCROLLBAR
     Native browser scrollbar with brand styling
     ========================================================= */

  /* ========== WebKit (Chrome, Safari, Edge) ========== */
  ::-webkit-scrollbar {
    width: 12px;
    height: 12px;
  }

  ::-webkit-scrollbar-track {
    background: var(--brand-c-bg);
    border-radius: var(--radius-md);
  }

  ::-webkit-scrollbar-thumb {
    background: linear-gradient(
      180deg,
      var(--brand-c-primary) 0%,
      var(--brand-c-secondary) 100%
    );
    border-radius: var(--radius-md);
    border: var(--border-width-2) solid var(--brand-c-bg);
    transition: background var(--transition-fast);
  }

  ::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(
      180deg,
      var(--brand-c-primary) 0%,
      var(--brand-c-secondary) 100%
    );
  }

  ::-webkit-scrollbar-thumb:active {
    background: linear-gradient(
      180deg,
      var(--brand-c-primary-dark) 0%,
      var(--brand-c-secondary-dark) 100%
    );
  }

  ::-webkit-scrollbar-corner {
    background: var(--brand-c-bg);
  }

  /* ========== Firefox ========== */
  html {
    scrollbar-width: thin;
    scrollbar-color: var(--brand-c-primary) var(--brand-c-bg);
  }

  /* ========== Smooth Scrolling ========== */
  html {
    scroll-behavior: smooth;
  }

  /* ========== Reduced Motion ========== */
  @media (prefers-reduced-motion: reduce) {
    ::-webkit-scrollbar-thumb {
      transition: none;
    }

    html {
      scroll-behavior: auto;
    }
  }

  /* ========== Mobile ========== */
  @media (max-width: 768px) {
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }

    ::-webkit-scrollbar-thumb {
      border-radius: var(--radius-sm);
      border-width: var(--border-width);
    }
  }
</style>
