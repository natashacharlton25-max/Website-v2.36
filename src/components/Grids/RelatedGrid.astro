---
/**
 * RelatedGrid - Unified component for displaying related content
 *
 * Consolidates SuggestedPostsGrid, RelatedProductsGrid, and LinkedAssetsGrid
 * into a single flexible component with content-type-specific card rendering
 *
 * Props:
 * @param items - Array of content items to display
 * @param contentType - Type of content: 'posts', 'products', 'resources'
 * @param title - Section title
 * @param basePath - Base URL path for links (used with slug)
 * @param columns - Grid columns: 'auto' (default), '2', '3', '4'
 * @param cardStyle - Card style: 'vertical' (default), 'horizontal', 'minimal'
 * @param background - Background: 'default', 'light', 'none'
 * @param containerSize - Container width: '6xl' (default), '7xl', '4xl'
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '../Button/Button.astro';
import SectionTitle from '../Typography/SectionTitle.astro';

// Unified item interface - maps different content types
interface RelatedItem {
  // Common fields
  slug?: string;
  url?: string;
  title: string;
  description?: string;
  // For posts
  category?: string;
  publishDate?: string;
  cardImage?: ImageMetadata;
  // For products
  name?: string;
  // For resources
  type?: string;
}

type ContentType = 'posts' | 'products' | 'resources';
type ColumnOption = 'auto' | '1' | '2' | '3' | '4';
type CardStyle = 'vertical' | 'horizontal' | 'minimal' | 'featured';
type BackgroundOption = 'default' | 'light' | 'neutral' | 'none';
type ContainerSize = '4xl' | '6xl' | '7xl';

interface Props {
  items: RelatedItem[];
  contentType?: ContentType;
  title?: string;
  basePath?: string;
  columns?: ColumnOption;
  cardStyle?: CardStyle;
  background?: BackgroundOption;
  containerSize?: ContainerSize;
  class?: string;
  /** Use SectionTitle component instead of plain h2 */
  useSectionTitle?: boolean;
  /** SectionTitle icon name */
  sectionTitleIcon?: string;
  /** SectionTitle variant: 'default' for vertical divider, 'underline' for underline */
  sectionTitleVariant?: 'default' | 'underline' | 'minimal';
  /** SectionTitle divider color */
  sectionTitleDividerColor?: 'primary' | 'secondary' | 'neutral';
  /** SectionTitle icon color */
  sectionTitleIconColor?: 'primary' | 'secondary' | 'neutral' | 'text';
  /** SectionTitle icon style */
  sectionTitleIconStyle?: 'contained' | 'bare';
}

const {
  items,
  contentType = 'posts',
  title,
  basePath = '',
  columns = 'auto',
  cardStyle = 'vertical',
  background = 'default',
  containerSize = '6xl',
  class: className,
  useSectionTitle = false,
  sectionTitleIcon,
  sectionTitleVariant = 'underline',
  sectionTitleDividerColor = 'primary',
  sectionTitleIconColor = 'primary',
  sectionTitleIconStyle = 'bare'
} = Astro.props;

if (!items || items.length === 0) return null;

// Get item URL
const getItemUrl = (item: RelatedItem): string => {
  if (item.url) return item.url;
  if (item.slug && basePath) return `${basePath}/${item.slug}`;
  return '#';
};

// Get item title (handles name vs title)
const getItemTitle = (item: RelatedItem): string => {
  return item.name || item.title;
};

// Get badge/category text
const getItemCategory = (item: RelatedItem): string => {
  return item.category || item.type || '';
};

// Get button text based on item type
const getButtonText = (item: RelatedItem): string => {
  if (item.type) return 'View Resource';
  return 'Read more';
};

// Classes
const sectionClasses = [
  'related-grid-section',
  `related-grid-section--bg-${background}`,
  className
].filter(Boolean);

const gridClasses = [
  'related-grid',
  `related-grid--cols-${columns}`,
  `related-grid--${cardStyle}`
];
---

<section class:list={sectionClasses}>
  <div class={`container container-${containerSize}`}>
    {title && (
      useSectionTitle ? (
        <div class="related-grid__title-wrapper">
          <SectionTitle
            title={title}
            size="lg"
            align="center"
            variant={sectionTitleVariant}
            dividerColor={sectionTitleDividerColor}
            icon={sectionTitleIcon}
            iconColor={sectionTitleIconColor}
            iconStyle={sectionTitleIconStyle}
            underlineStyle="gradient"
          />
        </div>
      ) : (
        <h2 class="related-grid__title">{title}</h2>
      )
    )}
    <div class:list={gridClasses}>
      {items.map(item => (
        <a href={getItemUrl(item)} class={`card related-card related-card--${cardStyle}`}>
          {/* Image - for posts and products with cardImage */}
          {item.cardImage && cardStyle !== 'minimal' && (
            <div class="related-card__image">
              <Image
                src={item.cardImage}
                alt={getItemTitle(item)}
                width={cardStyle === 'featured' ? 600 : (cardStyle === 'horizontal' ? 440 : 400)}
                height={cardStyle === 'featured' ? 450 : (cardStyle === 'horizontal' ? 480 : 225)}
              />
            </div>
          )}

          {/* Placeholder icon for resources without images */}
          {!item.cardImage && (cardStyle === 'horizontal' || cardStyle === 'featured') && (
            <div class="related-card__icon-placeholder">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
              </svg>
            </div>
          )}

          <div class="related-card__content">
            {/* FOR YOU badge - horizontal only */}
            {cardStyle === 'horizontal' && (
              <span class="related-card__badge">FOR YOU</span>
            )}

            {/* Title */}
            <h3 class="related-card__title">{getItemTitle(item)}</h3>

            {/* Description - hidden by default for horizontal, can be shown via CSS override */}
            {item.description && (
              <p class="related-card__description">{item.description}</p>
            )}

            {/* Action button - Button component for horizontal and featured, span for others */}
            {cardStyle === 'horizontal' && (
              <Button variant="neutral" size="sm">Explore</Button>
            )}
            {cardStyle === 'featured' && (
              <Button variant="secondary" size="md" className="featured-btn">Learn More</Button>
            )}
            {cardStyle !== 'horizontal' && cardStyle !== 'featured' && (
              <span class="related-card__button">{getButtonText(item)}</span>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* ========== SECTION STYLES ========== */
  /* Box model */
  .related-grid-section {
    padding: var(--space-4xl) 0;
  }

  /* Visual - Background modifiers */
  .related-grid-section--bg-default {
    background: var(--brand-c-bg);
  }

  .related-grid-section--bg-light {
    background: var(--brand-c-bg);
  }

  .related-grid-section--bg-neutral {
    background: var(--brand-c-neutral);
  }

  .related-grid-section--bg-none {
    background: transparent;
  }

  /* ========== TITLE ========== */
  .related-grid__title {
    margin-bottom: var(--space-2xl);
    text-align: center;
  }

  .related-grid__title-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-xl);
  }

  /* ========== GRID LAYOUT ========== */
  .related-grid {
    display: grid;
    gap: var(--space-xl);
  }

  /* Column modifiers */
  .related-grid--cols-auto {
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    align-items: stretch;
  }

  .related-grid--cols-1 {
    grid-template-columns: 1fr;
    gap: var(--space-3xl);
  }

  .related-grid--cols-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .related-grid--cols-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .related-grid--cols-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  /* ========== CARD BASE ========== */
  .related-card {
    display: flex;
    overflow: hidden;
    text-decoration: none;
    border-radius: var(--radius-lg);
    background: var(--brand-c-neutral-light);
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .related-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .related-card:focus-visible {
    outline: 2px solid var(--brand-c-primary-dark);
    outline-offset: 2px;
  }

  /* ========== CARD STYLE: VERTICAL ========== */
  .related-card--vertical {
    flex-direction: column;
  }

  .related-card--vertical .related-card__image {
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .related-card--vertical .related-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .related-card--vertical:hover .related-card__image img {
    transform: scale(1.05);
  }

  .related-card--vertical .related-card__content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-xl);
  }

  /* ========== CARD STYLE: HORIZONTAL ========== */
  /* Left-overlapping square image design */
  .related-card--horizontal {
    position: relative;
    flex-direction: row;
    align-items: stretch;
    overflow: visible;
    background: transparent;
    box-shadow: none;
    min-width: 400px;
  }

  .related-card--horizontal:hover {
    transform: none;
    box-shadow: none;
  }

  .related-card--horizontal .related-card__image {
    flex-shrink: 0;
    width: 95px;
    height: 125px;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 8px 24px color-mix(in oklch, var(--color-Black) 25%, transparent);
    position: relative;
    z-index: 2;
    margin-right: -14px;
    align-self: center;
    border: 3px solid var(--color-White);
  }

  .related-card--horizontal .related-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-card--horizontal .related-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-md) var(--space-xl);
    padding-left: calc(var(--space-xl) + 14px);
    background: linear-gradient(135deg, var(--brand-c-primary-dark) 0%, var(--brand-c-primary-dark) 100%);
    border-radius: var(--radius-lg);
    box-shadow: 0 4px 12px color-mix(in oklch, var(--color-Black) 10%, transparent);
    height: 130px;
  }

  .related-card--horizontal .related-card__badge {
    display: inline-block;
    padding: 3px 10px;
    font-size: 9px;
    font-weight: var(--font-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-White);
    background: color-mix(in oklch, var(--color-White) 15%, transparent);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-xs);
    flex-shrink: 0;
  }

  .related-card--horizontal .related-card__title {
    margin: 0;
    font-weight: var(--font-semibold);
    color: var(--color-White);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-shrink: 0;
  }

  /* Hide description by default for horizontal cards */
  .related-card--horizontal .related-card__description {
    display: none;
  }

  /* Button pushed to bottom-right with glass styling */
  .related-card--horizontal :global(.btn) {
    margin-top: auto;
    align-self: flex-end;
    flex-shrink: 0;
    background: color-mix(in oklch, var(--color-White) 15%, transparent);
    border: 1px solid color-mix(in oklch, var(--color-White) 30%, transparent);
    color: var(--color-White);
    backdrop-filter: blur(4px);
  }

  .related-card--horizontal:hover :global(.btn) {
    background: color-mix(in oklch, var(--color-White) 25%, transparent);
    border-color: color-mix(in oklch, var(--color-White) 40%, transparent);
  }


  /* Icon placeholder for resources without images */
  .related-card__icon-placeholder {
    flex-shrink: 0;
    width: 95px;
    height: 125px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, var(--brand-c-primary), var(--brand-c-primary-dark));
    border-radius: var(--radius-md);
    box-shadow: 0 8px 24px color-mix(in oklch, var(--color-Black) 25%, transparent);
    color: var(--color-White);
    position: relative;
    z-index: 2;
    margin-right: -14px;
    align-self: center;
    border: 3px solid var(--color-White);
  }

  .related-card__icon-placeholder svg {
    width: 28px;
    height: 28px;
  }


  /* ========== CARD STYLE: FEATURED ========== */
  /* Large top-offset image design */
  .related-card--featured {
    position: relative;
    flex-direction: column;
    overflow: visible;
    margin-top: calc(var(--space-4xl) + 40px);
    padding-top: 140px;
    background: linear-gradient(165deg, var(--brand-c-primary-dark) 0%, var(--brand-c-primary-dark) 100%);
    border-radius: var(--radius-xl);
    box-shadow: 0 20px 40px color-mix(in oklch, var(--color-Black) 15%, transparent);
    min-height: 280px;
  }

  .related-card--featured:hover {
    box-shadow: 0 25px 50px color-mix(in oklch, var(--color-Black) 20%, transparent);
  }

  .related-card--featured .related-card__image {
    position: absolute;
    top: -50px;
    left: 50%;
    transform: translateX(-50%);
    width: 85%;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: var(--radius-xl);
    box-shadow: 0 15px 35px color-mix(in oklch, var(--color-Black) 25%, transparent);
    border: 4px solid var(--color-White);
  }

  .related-card--featured .related-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .related-card--featured:hover .related-card__image img {
    transform: scale(1.05);
  }

  .related-card--featured:hover .related-card__image {
    box-shadow: 0 20px 45px color-mix(in oklch, var(--color-Black) 30%, transparent);
  }

  .related-card--featured .related-card__content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }

  .related-card--featured .related-card__title {
    margin: 0 0 var(--space-md) 0;
    font-weight: var(--font-bold);
    color: var(--color-White);
    line-height: 1.3;
  }

  .related-card--featured .related-card__description {
    flex: 1;
    line-height: var(--leading-relaxed);
    color: color-mix(in oklch, var(--color-White) 75%, transparent);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: var(--space-lg);
  }

  /* Featured card Button component styling */
  .related-card--featured :global(.btn) {
    background: color-mix(in oklch, var(--color-White) 15%, transparent);
    backdrop-filter: blur(4px);
    border: 1px solid color-mix(in oklch, var(--color-White) 30%, transparent);
    color: var(--color-White);
  }

  .related-card--featured:hover :global(.btn) {
    background: var(--color-White);
    color: var(--brand-c-primary-dark);
    border-color: var(--color-White);
  }

  /* Featured icon placeholder */
  .related-card--featured .related-card__icon-placeholder {
    position: absolute;
    top: -60px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    aspect-ratio: 4/3;
    height: auto;
    margin-right: 0;
  }

  .related-card--featured .related-card__icon-placeholder svg {
    width: 48px;
    height: 48px;
  }

  /* ========== CARD STYLE: MINIMAL ========== */
  .related-card--minimal {
    flex-direction: column;
    padding: var(--space-xl);
    box-shadow: var(--shadow);
  }

  .related-card--minimal:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .related-card--minimal .related-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* ========== CARD ELEMENTS ========== */
  .related-card__title {
    margin: var(--space-sm) 0;
    line-height: 1.3;
  }

  .related-card__description {
    flex: 1;
    margin: 0;
    color: var(--brand-c-text);
  }

  .related-card__date {
    color: var(--brand-c-text-light);
  }

  .related-card__button {
    display: inline-block;
    margin-top: var(--space-md);
    padding: var(--space-sm) var(--space-lg);
    background: var(--brand-c-primary);
    color: var(--color-White);
    font-weight: 500;
    border-radius: var(--radius-md);
    transition: background var(--transition-base), transform var(--transition-base);
  }

  .related-card:hover .related-card__button {
    background: var(--brand-c-primary-dark);
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 768px) {
    .related-grid--cols-2,
    .related-grid--cols-3,
    .related-grid--cols-4 {
      grid-template-columns: 1fr;
    }

    .related-grid-section {
      padding: var(--space-2xl) 0;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .related-grid--cols-3,
    .related-grid--cols-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ========== RESPONSIVE - HORIZONTAL CARDS STACK (500px) ========== */
  @media (max-width: 500px) {
    .related-grid--horizontal {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .related-card--horizontal {
      flex-direction: column;
      align-items: center;
      min-width: 0;
    }

    .related-card--horizontal .related-card__image {
      width: 100%;
      height: 160px;
      margin-right: 0;
      margin-bottom: -20px;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }

    .related-card--horizontal .related-card__icon-placeholder {
      width: 100%;
      height: 120px;
      margin-right: 0;
      margin-bottom: -20px;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }

    .related-card--horizontal .related-card__content {
      width: 100%;
      padding: var(--space-lg);
      padding-top: calc(var(--space-lg) + 20px);
      padding-bottom: calc(var(--space-lg) + 8px);
      height: auto;
      min-height: 140px;
      border-radius: 0 0 var(--radius-lg) var(--radius-lg);
      text-align: center;
      align-items: center;
      gap: var(--space-sm);
      overflow: visible;
    }

    .related-card--horizontal .related-card__badge {
      align-self: center;
      margin-bottom: var(--space-xs);
    }

    .related-card--horizontal .related-card__title {
      margin-bottom: var(--space-sm);
    }

    .related-card--horizontal :global(.btn) {
      align-self: center;
      margin-top: var(--space-sm);
    }
  }

  /* ========== RESPONSIVE - SMALL (400px) ========== */
  @media (max-width: 400px) {
    .related-grid-section {
      padding: var(--space-xl) 0;
    }

    .related-grid {
      gap: var(--space-md);
    }

    .related-grid__title {
      margin-bottom: var(--space-lg);
    }

    .related-card--horizontal .related-card__image {
      height: 120px;
    }

    .related-card--horizontal .related-card__content {
      padding: var(--space-sm);
      padding-top: calc(var(--space-sm) + 16px);
    }

    .related-card--horizontal .related-card__title {
    }
  }

  /* ========== RESPONSIVE - VERY SMALL (300px) ========== */
  @media (max-width: 300px) {
    .related-grid-section {
      padding: var(--space-lg) 0;
    }

    .related-grid {
      gap: var(--space-sm);
    }

    .related-grid__title {
      margin-bottom: var(--space-md);
    }

    .related-card--horizontal .related-card__image {
      height: 120px;
    }

    .related-card--horizontal .related-card__icon-placeholder {
      height: 100px;
    }

    .related-card--horizontal .related-card__content {
      padding: var(--space-sm);
      padding-top: calc(var(--space-sm) + 20px);
      min-height: 100px;
    }

    .related-card--horizontal .related-card__badge {
      font-size: 8px;
      padding: 2px 8px;
    }

    .related-card--horizontal .related-card__title {
    }

    .related-card--horizontal :global(.btn) {
      padding: var(--space-xs) var(--space-sm);
    }
  }

  /* ========== RESPONSIVE - TINY (200px) ========== */
  @media (max-width: 200px) {
    .related-grid-section {
      padding: var(--space-md) 0;
    }

    .related-card--horizontal .related-card__image {
      height: 100px;
    }

    .related-card--horizontal .related-card__icon-placeholder {
      height: 80px;
    }

    .related-card--horizontal .related-card__icon-placeholder svg {
      width: 20px;
      height: 20px;
    }

    .related-card--horizontal .related-card__content {
      padding: var(--space-xs);
      padding-top: calc(var(--space-xs) + 16px);
      min-height: 80px;
    }

    .related-card--horizontal .related-card__title {
      font-size: calc(var(--text-fine) * 0.9);
      -webkit-line-clamp: 3;
    }
  }

  /* ========== REDUCED MOTION ========== */
  /* No visual change on hover - keep base state */
  :global(#a11y-content-wrapper.a11y-reduce-motion) .related-card {
    transition: none !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .related-card:hover {
    transform: none !important;
    box-shadow: var(--shadow-md) !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .related-card--horizontal,
  :global(#a11y-content-wrapper.a11y-reduce-motion) .related-card--horizontal:hover {
    background: transparent !important;
    box-shadow: none !important;
  }


  :global(#a11y-content-wrapper.a11y-reduce-motion) .related-card--horizontal:hover :global(.btn) {
    background: color-mix(in oklch, var(--color-White) 15%, transparent) !important;
    border-color: color-mix(in oklch, var(--color-White) 30%, transparent) !important;
  }

  /* Services page: solid button stays solid on reduced-motion hover */
  :global(#a11y-content-wrapper.a11y-reduce-motion .services-offerings) .related-card--horizontal:hover :global(.btn) {
    background: var(--brand-c-primary-dark) !important;
    border-color: var(--brand-c-primary-dark) !important;
    color: var(--color-White) !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .related-card--vertical .related-card__image img {
    transition: none !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .related-card--vertical:hover .related-card__image img {
    transform: none !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .related-card--featured .related-card__image img {
    transition: none !important;
  }

  :global(#a11y-content-wrapper.a11y-reduce-motion) .related-card--featured:hover .related-card__image img {
    transform: none !important;
  }

