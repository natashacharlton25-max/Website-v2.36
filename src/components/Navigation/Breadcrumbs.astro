---
interface BreadcrumbItem {
  label: string;
  href?: string; // If no href, it's the current page
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<section class="breadcrumbs-section">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      {items.map((item, index) => (
        <>
          {item.href ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span class="current" aria-current="page">{item.label}</span>
          )}
          {index < items.length - 1 && <span class="separator" aria-hidden="true">›</span>}
        </>
      ))}
    </nav>
  </div>
</section>

<style>

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .breadcrumbs a {
    color: var(--brand-c-primary-dark);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .breadcrumbs a:hover {
    color: var(--brand-c-primary-dark);
    text-decoration: underline;
  }

  .breadcrumbs .separator {
    color: var(--brand-c-text-light);
    user-select: none;
  }

  .breadcrumbs .current {
    color: var(--brand-c-text);
    font-weight: var(--font-medium);
  }

  /* ========== RESPONSIVE - TABLET ========== */
  @media (max-width: 768px) {
    .breadcrumbs {
      gap: var(--space-xs);
    }
  }

  /* ========== RESPONSIVE - MOBILE ========== */
  @media (max-width: 480px) {
    .breadcrumbs {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-xs);
    }

    .breadcrumbs .separator {
      display: none;
    }
  }

  /* ========== RESPONSIVE - SMALL (400px) ========== */
  @media (max-width: 400px) {
    .breadcrumbs {
      font-size: calc(var(--text-fine) * 0.9);
    }
  }

  /* ========== RESPONSIVE - VERY SMALL (300px) ========== */
  @media (max-width: 300px) {
    .breadcrumbs-section {
      padding: var(--space-sm) 0;
    }

    .breadcrumbs {
      font-size: calc(var(--text-fine) * 0.85);
      gap: calc(var(--space-xs) * 0.5);
    }
  }

  /* ========== RESPONSIVE - TINY (200px) ========== */
  @media (max-width: 200px) {
    .breadcrumbs {
      font-size: calc(var(--text-fine) * 0.8);
    }

    .breadcrumbs .current {
      word-break: break-word;
    }
  }
</style>
