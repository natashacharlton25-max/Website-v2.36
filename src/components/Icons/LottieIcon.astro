---
/**
 * LottieIcon - Animated icon using Lottie
 *
 * Usage:
 * <LottieIcon src="/Icons/Animated Icons/Menu V2/menuV2.json" size={24} />
 *
 * Control via JavaScript:
 * const icon = document.querySelector('[data-lottie-icon]');
 * icon.dispatchEvent(new CustomEvent('lottie:play'));
 * icon.dispatchEvent(new CustomEvent('lottie:playReverse'));
 * icon.dispatchEvent(new CustomEvent('lottie:stop'));
 * icon.dispatchEvent(new CustomEvent('lottie:goToFrame', { detail: { frame: 0 } }));
 */

interface Props {
  src: string;
  size?: number;
  loop?: boolean;
  autoplay?: boolean;
  class?: string;
  id?: string;
}

const {
  src,
  size = 24,
  loop = false,
  autoplay = false,
  class: className = '',
  id,
} = Astro.props;
---

<div
  class={`lottie-icon ${className}`}
  data-lottie-icon
  data-lottie-src={src}
  data-lottie-loop={loop}
  data-lottie-autoplay={autoplay}
  style={`width: ${size}px; height: ${size}px;`}
  id={id}
>
  <div class="lottie-icon__container" data-lottie-container></div>
</div>

<style>
  .lottie-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
  }

  .lottie-icon__container {
    width: 100%;
    height: 100%;
  }

  .lottie-icon__container :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* Apply current color to strokes */
  .lottie-icon__container :global(svg path),
  .lottie-icon__container :global(svg rect),
  .lottie-icon__container :global(svg circle),
  .lottie-icon__container :global(svg line) {
    stroke: currentColor !important;
  }
</style>

<script>
  import lottie from 'lottie-web';
  import type { AnimationItem } from 'lottie-web';

  interface LottieIconElement extends HTMLElement {
    _lottieAnim?: AnimationItem;
    _lottieDirection?: 1 | -1;
  }

  function initLottieIcon(element: LottieIconElement) {
    const container = element.querySelector('[data-lottie-container]') as HTMLElement;
    if (!container || element._lottieAnim) return;

    const src = element.dataset.lottieSrc;
    const loop = element.dataset.lottieLoop === 'true';
    const autoplay = element.dataset.lottieAutoplay === 'true';

    if (!src) return;

    try {
      const anim = lottie.loadAnimation({
        container,
        renderer: 'svg',
        loop,
        autoplay,
        path: src,
      });

      element._lottieAnim = anim;
      element._lottieDirection = 1;

      // Custom events for control
      element.addEventListener('lottie:play', () => {
        element._lottieDirection = 1;
        anim.setDirection(1);
        anim.play();
      });

      element.addEventListener('lottie:playReverse', () => {
        element._lottieDirection = -1;
        anim.setDirection(-1);
        anim.play();
      });

      element.addEventListener('lottie:stop', () => {
        anim.stop();
      });

      element.addEventListener('lottie:pause', () => {
        anim.pause();
      });

      element.addEventListener('lottie:goToFrame', ((e: CustomEvent) => {
        const frame = e.detail?.frame ?? 0;
        anim.goToAndStop(frame, true);
      }) as EventListener);

      element.addEventListener('lottie:toggle', () => {
        // Toggle direction and play
        if (element._lottieDirection === 1) {
          element._lottieDirection = -1;
          anim.setDirection(-1);
        } else {
          element._lottieDirection = 1;
          anim.setDirection(1);
        }
        anim.play();
      });

    } catch (e) {
      console.error('Failed to load Lottie animation:', e);
    }
  }

  function initAllLottieIcons() {
    const icons = document.querySelectorAll('[data-lottie-icon]') as NodeListOf<LottieIconElement>;
    icons.forEach(initLottieIcon);
  }

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllLottieIcons);
  } else {
    initAllLottieIcons();
  }

  // Support Astro page transitions
  document.addEventListener('astro:page-load', initAllLottieIcons);
</script>
