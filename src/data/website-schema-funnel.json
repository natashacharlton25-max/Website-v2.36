{
  "version": "1.0",
  "description": "5-layer funnel that narrows AI choices from brand → rendered page JSON",

  "layers": {
    "1-brand": {
      "name": "Brand Identity",
      "input": "Client brief or 2 hex codes + keywords",
      "output": {
        "primaryHex": "#hex",
        "secondaryHex": "#hex",
        "mood": ["warm", "cool", "bold", "soft", "playful", "professional", "minimal", "expressive"],
        "fontRegister": ["pro", "fun"],
        "intensity": ["full", "soft", "pastel"],
        "darkDefault": false
      },
      "feeds": "2-pages",
      "worker": "brand-identity",
      "notes": "Theme engine generates 112 themes from 2 hex codes. This layer picks the starting point."
    },

    "2-pages": {
      "name": "Page Map",
      "input": "Layer 1 output + client brief",
      "output": {
        "pages": [
          {
            "slug": "string",
            "title": "string",
            "purpose": ["first-impression", "trust", "inform", "convert", "engage", "support", "legal"],
            "order": "number",
            "priority": ["primary", "secondary", "utility"]
          }
        ]
      },
      "feeds": "3-content",
      "worker": "page-planner",
      "notes": "No design decisions here. Just what pages exist and why."
    },

    "3-content": {
      "name": "Content Blocks",
      "input": "Layer 2 page + client brief",
      "output": {
        "page": "slug",
        "blocks": [
          {
            "id": "string",
            "order": "number",
            "type": ["hero", "text", "features", "testimonial", "gallery", "form", "cta", "stats", "team", "faq", "pricing", "comparison", "timeline", "process", "logos", "footer"],
            "content": {
              "heading": "string | null",
              "subheading": "string | null",
              "body": "string | null",
              "items": ["string array | null"],
              "quote": "string | null",
              "author": "string | null",
              "label": "string | null",
              "placeholder": "string | null",
              "cta": "string | null",
              "href": "string | null",
              "image": "string | null",
              "icon": "string | null"
            }
          }
        ]
      },
      "feeds": "4-intention",
      "worker": "content-writer",
      "notes": "Pure content. No design. No components. Just words, order, and block type."
    },

    "4-intention": {
      "name": "Block Intentions",
      "input": "Layer 3 content block + Layer 1 brand mood",
      "decisions_per_block": {
        "animated": { "type": "boolean", "question": "Does this block need motion to communicate?" },
        "interactive": { "type": "boolean", "question": "Does the user need to do something here?" },
        "decorative": { "type": "boolean", "question": "Is visual flair part of the message?" },
        "density": { "type": "enum", "values": ["minimal", "normal", "rich"], "question": "How much visual weight?" },
        "emphasis": { "type": "enum", "values": ["hero", "primary", "secondary", "supporting"], "question": "How important is this block?" },
        "media": { "type": "enum", "values": ["none", "icon", "image", "lottie", "video"], "question": "What media type if any?" }
      },
      "output": {
        "blockId": "string",
        "intentions": {
          "animated": "boolean",
          "interactive": "boolean",
          "decorative": "boolean",
          "density": "string",
          "emphasis": "string",
          "media": "string"
        },
        "candidateAtoms": ["filtered list based on intentions"]
      },
      "feeds": "5-assembly",
      "worker": "intention-resolver",
      "notes": "This is where the funnel narrows. Each intention eliminates components. animated=false kills TextEffect, LottieIcon, all button effects. interactive=false kills FormField, Button dropdowns. media=none kills Image, Icon."
    },

    "5-assembly": {
      "name": "Component Assembly",
      "input": "Layer 4 intentions + candidateAtoms + schema-vocabulary.json",
      "output": {
        "component": "string (from candidates)",
        "content": "object (from Layer 3)",
        "visual": "object (enums from schema-vocabulary)",
        "colour": "object (tokens only, var(--token-name) format)",
        "animation": "object | {} (only if Layer 4 animated=true)"
      },
      "validation": {
        "enums": "Every enum value checked against schema-vocabulary.json",
        "tokens": "Every colour value matches /^var\\(--[a-z0-9-]+\\)$/",
        "locked": "renders block cannot be modified",
        "required": "All required content fields present"
      },
      "feeds": "render pipeline (Astro or Worker SSR)",
      "worker": "component-assembler",
      "notes": "Final output is valid page JSON. Passes schema validation. Ready for Astro render."
    }
  },

  "intentionFilters": {
    "animated=false": {
      "removes": ["TextEffect", "LottieIcon"],
      "strips": ["animation group from all components", "effect prop from Button"],
      "keeps": ["all content atoms", "all containers"]
    },
    "interactive=false": {
      "removes": ["FormField"],
      "strips": ["dropdownItems from Button", "href from Button (becomes display-only)"],
      "keeps": ["Button as visual element (no click action)"]
    },
    "decorative=false": {
      "removes": ["TextEffect"],
      "strips": ["maskIcon from Image", "maskShape from Image", "bgFill glass from Image"],
      "keeps": ["Image (informational)", "Icon (functional)"]
    },
    "media=none": {
      "removes": ["Image", "Icon", "LottieIcon"],
      "keeps": ["Heading", "Text", "Button", "Badge", "Card", "Section", "FormField", "Link", "List"]
    },
    "media=icon": {
      "removes": ["Image", "LottieIcon"],
      "keeps": ["Icon + everything from media=none"]
    },
    "media=image": {
      "removes": ["LottieIcon"],
      "keeps": ["Image", "Icon + everything from media=none"]
    },
    "media=lottie": {
      "keeps": ["everything"]
    },
    "density=minimal": {
      "strips": ["shadow from Card", "border from Card", "effect from Button"],
      "prefers": ["ghost/outline variants", "sm sizes", "clean spacing"]
    },
    "density=rich": {
      "prefers": ["glass/neumorphic/comic variants", "lg sizes", "effects", "confetti"]
    },
    "emphasis=hero": {
      "prefers": ["h1 size", "lg/xl spacing", "primary colours", "bold weight", "effects"]
    },
    "emphasis=supporting": {
      "prefers": ["h4-h6 size", "sm spacing", "neutral/muted colours", "normal weight"]
    }
  }
}
