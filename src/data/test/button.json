{
  "page": {
    "title": "Test Page — Button Atom",
    "hideFooter": true,
    "container": "7xl"
  },
  "colour": {
    "btnBorder": "var(--primary-700)"
  },
  "layout": {
    "sectionGap": "6xl",
    "itemGap": "lg"
  },
  "title": { "level": 1, "contentHeading": "Button Atom Test", "align": "center", "flush": true },
  "sections": [
    { "label": "Variants", "items": [
      { "label": "Primary", "variant": "fill", "color": "primary" },
      { "label": "Secondary", "variant": "fill", "color": "secondary" },
      { "label": "Neutral", "variant": "fill", "color": "neutral" },
      { "label": "Outline", "variant": "outline" },
      { "label": "Ghost", "variant": "ghost" },
      { "label": "Glass", "variant": "glass" },
      { "label": "Glow", "variant": "glow" },
      { "label": "Neumorphic", "variant": "neumorphic" },
      { "label": "Neumorphic 3D", "variant": "neumorphic-3d" },
      { "label": "Neumorphic Inner", "variant": "neumorphic-inner" },
      { "label": "Liquid Glass", "variant": "liquid-glass" },
      { "label": "Glassic", "variant": "glassic" },
      { "label": "Rainbow Glow", "variant": "rainbow-glow", "shape": "pill" },
      { "label": "Brand Glow", "variant": "rainbow-glow", "shape": "pill", "glowColors": ["var(--primary-400)", "var(--secondary-400)", "var(--primary-600)"] }
    ]},
    { "label": "Sizes", "items": [
      { "label": "Small", "size": "sm" },
      { "label": "Medium", "size": "md" },
      { "label": "Large", "size": "lg" }
    ]},
    { "label": "Shapes", "items": [
      { "label": "Sharp", "shape": "sharp" },
      { "label": "Subtle", "shape": "subtle" },
      { "label": "Soft", "shape": "soft" },
      { "label": "Rounded", "shape": "rounded" },
      { "label": "Pill", "shape": "pill" },
      { "label": "I-Sharp", "icon": "star-fill", "shape": "i-sharp", "ariaLabel": "Star" },
      { "label": "I-Subtle", "icon": "heart-fill", "shape": "i-subtle", "ariaLabel": "Like" },
      { "label": "I-Soft", "icon": "gear-fill", "shape": "i-soft", "ariaLabel": "Settings" },
      { "label": "I-Rounded", "icon": "star-fill", "shape": "i-rounded", "ariaLabel": "Favourite" },
      { "label": "Circle", "icon": "heart-fill", "shape": "circle", "ariaLabel": "Like" },
      { "label": "Circle Spin", "icon": "gear-fill", "shape": "circle", "ariaLabel": "Settings", "iconSpin": true },
      { "label": "Circle Bounce", "icon": "arrow-down", "shape": "circle", "ariaLabel": "Download", "iconBounce": true },
      { "label": "I-Soft Lottie", "shape": "i-soft", "ariaLabel": "Star", "lottieIcon": "lottie-toast-star" }
    ]},
    { "label": "Icons", "items": [
      { "label": "Icon Left", "icon": "heart-fill" },
      { "label": "Icon Right", "icon": "arrow-right", "iconPosition": "right" },
      { "label": "Icon Only", "icon": "star-fill", "ariaLabel": "Star", "shape": "circle" },
      { "label": "Download", "icon": "download-simple", "iconPosition": "left" }
    ]},
    { "label": "Links (href)", "items": [
      { "label": "Link Button", "href": "#", "variant": "fill", "color": "primary" },
      { "label": "External Link", "href": "#", "target": "_blank", "variant": "outline", "icon": "arrow-square-out", "iconPosition": "right" },
      { "label": "Ghost Link", "href": "#", "variant": "ghost" }
    ]},
    { "label": "States", "items": [
      { "label": "Disabled Primary", "disabled": true, "variant": "fill", "color": "primary" },
      { "label": "Disabled Outline", "disabled": true, "variant": "outline" },
      { "label": "Disabled Ghost", "disabled": true, "variant": "ghost" }
    ]},
    { "label": "Effects", "items": [
      { "label": "Glint", "effect": "glint" },
      { "label": "Colour Flow", "effect": "colour-flow" },
      { "label": "Jump", "effect": "jump" },
      { "label": "Comic", "effect": "comic" },
      { "label": "Tech", "effect": "tech" },
      { "label": "Expand", "effect": "expand" },
      { "label": "Expand + Icon", "effect": "expand", "icon": "arrow-right" },
      { "label": "Magnetic", "effect": "magnetic" },
      { "label": "Spotlight", "effect": "spotlight" },
      { "label": "Split", "effect": "split" },
      { "label": "Hover Me", "effect": "split", "splitText": "Welcome!" }
    ]},
    { "label": "Confetti", "items": [
      { "label": "Confetti Click", "confetti": "confetti", "confettiTrigger": "click" },
      { "label": "Hearts Hover", "confetti": "hearts", "confettiTrigger": "hover" },
      { "label": "Celebration", "confetti": "celebration", "confettiTrigger": "click" }
    ]},
    { "label": "Speed", "items": [
      { "label": "Slow Glint", "effect": "glint", "speed": "slow" },
      { "label": "Normal Glint", "effect": "glint", "speed": "normal" },
      { "label": "Fast Glint", "effect": "glint", "speed": "fast" }
    ]},
    { "label": "Dropdown", "items": [
      { "label": "Choose Option", "shape": "dropdown", "dropdownItems": [
        { "label": "Option One", "value": "1" },
        { "label": "Option Two", "value": "2" },
        { "label": "Option Three", "value": "3" }
      ]},
      { "label": "Secondary Dropdown", "shape": "dropdown", "variant": "fill", "color": "secondary", "dropdownItems": [
        { "label": "Alpha", "value": "a" },
        { "label": "Beta", "value": "b" }
      ]}
    ]},
    { "label": "Combinations", "items": [
      { "label": "CTA Primary", "variant": "fill", "color": "primary", "shape": "pill", "size": "lg", "icon": "arrow-right", "iconPosition": "right", "effect": "glint" },
      { "label": "Ghost Small", "variant": "ghost", "size": "sm", "icon": "heart-fill" },
      { "label": "Glass Glow", "variant": "glass", "shape": "pill", "icon": "star-fill", "effect": "spotlight" },
      { "label": "Neumorphic Jump", "variant": "neumorphic", "effect": "jump", "icon": "download-simple" },
      { "label": "Outline Tech", "variant": "outline", "shape": "sharp", "effect": "tech" },
      { "label": "Comic Secondary", "variant": "fill", "color": "secondary", "effect": "comic", "shape": "rounded", "size": "lg" }
    ]},
    { "label": "Schema-Driven (Full Pipeline)", "items": [
      {
        "label": "Save",
        "id": "save-btn",
        "icon": "floppy-disk",
        "iconPosition": "left",
        "variant": "fill",
        "color": "primary",
        "shape": "rounded",
        "size": "md",
        "effect": "glint",
        "speed": "normal",
        "confetti": "confetti",
        "confettiTrigger": "click",
        "confettiCount": 30,
        "confettiSpread": 150,
        "style": "--btn-bg: var(--primary-600); --btn-text: var(--color-White); --btn-hover-bg: var(--primary-800); --btn-light-bg: var(--primary-200)"
      },
      {
        "label": "Delete",
        "id": "delete-btn",
        "icon": "trash",
        "iconPosition": "left",
        "variant": "outline",
        "shape": "rounded",
        "size": "md",
        "effect": "comic",
        "speed": "normal",
        "style": "--btn-bg: var(--color-Error); --btn-text: var(--color-Error); --btn-hover-bg: var(--color-Error); --btn-light-bg: var(--primary-200)"
      },
      {
        "label": "Download",
        "id": "download-btn",
        "icon": "download-simple",
        "iconPosition": "right",
        "variant": "fill",
        "color": "secondary",
        "shape": "pill",
        "size": "lg",
        "effect": "expand",
        "style": "--btn-bg: var(--secondary-600); --btn-text: var(--color-White); --btn-hover-bg: var(--secondary-800)"
      },
      {
        "label": "Share",
        "id": "share-btn",
        "icon": "share-network",
        "variant": "glass",
        "shape": "circle",
        "size": "md",
        "ariaLabel": "Share this page",
        "effect": "spotlight"
      },
      {
        "label": "Submit",
        "id": "submit-btn",
        "type": "submit",
        "icon": "paper-plane-tilt",
        "iconPosition": "right",
        "variant": "fill",
        "color": "primary",
        "shape": "pill",
        "size": "lg",
        "effect": "colour-flow",
        "confetti": "celebration",
        "confettiTrigger": "click",
        "confettiCount": 50,
        "confettiSpread": 200,
        "style": "--btn-bg: var(--primary-600); --btn-text: var(--color-White); --btn-hover-bg: var(--primary-800)"
      }
    ]}
  ]
}
