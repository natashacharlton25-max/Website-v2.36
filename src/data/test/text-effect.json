{
  "page": {
    "title": "TextEffect Atom Test",
    "hideFooter": true,
    "container": "container-7xl"
  },
  "title": {
    "level": 2,
    "text": "TextEffect Atom Test",
    "align": "left",
    "flush": true
  },
  "layout": {
    "sectionGap": "6xl",
    "itemGap": "xl"
  },
  "sections": [
    {
      "label": "Image Fill",
      "items": [
        { "text": "NATURE", "fillImage": "/_Unused Images/3.jpg", "size": "6rem", "tracking": "wide" },
        { "text": "OCEAN", "fillImage": "/_Unused Images/7.jpg", "size": "6rem", "tracking": "wide" },
        { "text": "HEARTS", "fillImage": "/_Unused Images/1.png", "size": "6rem" }
      ]
    },
    {
      "label": "Gradient Fill (static)",
      "items": [
        { "text": "GRADIENT", "fillGradient": "linear-gradient(90deg, var(--primary-600), var(--secondary-600))", "size": "5rem" },
        { "text": "RAINBOW", "fillGradient": "linear-gradient(90deg, var(--rainbow-1), var(--rainbow-2-base), var(--rainbow-3), var(--rainbow-4-base), var(--rainbow-5), var(--rainbow-6-base), var(--rainbow-7))", "size": "5rem" }
      ]
    },
    {
      "label": "Animated Gradient",
      "items": [
        { "text": "FAST FLOW", "gradientColors": ["var(--rainbow-1)", "var(--rainbow-3)", "var(--rainbow-5)", "var(--rainbow-7)", "var(--rainbow-1)"], "gradientSpeed": "fast", "size": "5rem" },
        { "text": "SLOW FLOW", "gradientColors": ["var(--primary-400)", "var(--secondary-600)", "var(--primary-800)", "var(--primary-400)"], "gradientSpeed": "slow", "size": "5rem" },
        { "text": "BRAND FLOW", "gradientColors": ["var(--primary-400)", "var(--secondary-600)", "var(--primary-800)", "var(--secondary-400)", "var(--primary-400)"], "gradientSpeed": "slow", "size": "5rem" }
      ]
    },
    {
      "label": "Shadows",
      "items": [
        { "text": "DROP SHADOW", "size": "5rem", "dropShadow": "var(--shadow-lg)" },
        { "text": "TEXT SHADOW", "size": "5rem", "textShadow": "var(--shadow-md)" },
        { "text": "GLOW", "size": "5rem", "textShadow": "0 0 20px var(--primary-600), 0 0 40px var(--primary-400)" },
        { "text": "INNER SHADOW", "size": "5rem", "innerShadow": true }
      ]
    },
    {
      "label": "Stroke",
      "items": [
        { "text": "OUTLINE", "size": "5rem", "textStroke": "2px var(--primary-600)", "fillGradient": "transparent" },
        { "text": "THICK OUTLINE", "size": "5rem", "textStroke": "4px var(--neutral-800)", "fillGradient": "transparent" },
        { "text": "IMAGE + STROKE", "size": "5rem", "fillImage": "/_Unused Images/3.jpg", "textStroke": "var(--border-width) var(--neutral-400)" }
      ]
    },
    {
      "label": "Combinations",
      "items": [
        { "text": "GLOWING GRADIENT", "gradientColors": ["var(--rainbow-1)", "var(--rainbow-3)", "var(--rainbow-5)", "var(--rainbow-1)"], "gradientSpeed": "slow", "size": "5rem", "textShadow": "0 0 20px var(--primary-600), 0 0 40px var(--primary-400)" },
        { "text": "OUTLINED IMAGE", "fillImage": "/_Unused Images/7.jpg", "size": "5rem", "textStroke": "var(--border-width-2) var(--neutral-400)", "dropShadow": "var(--shadow-lg)" }
      ]
    },
    {
      "label": "Letter Drop — Both (drop + hover)",
      "type": "letter-drop",
      "config": {
        "mode": "both",
        "family": "heading",
        "lines": [
          { "text": "TURNING", "color": "var(--primary-600)" },
          { "text": "OBSTACLES", "color": "var(--secondary-600)" },
          { "text": "INTO", "color": "var(--neutral-800)" },
          { "text": "OPPORTUNITIES", "color": "var(--primary-400)" }
        ]
      }
    },
    {
      "label": "Letter Drop — Drop-In Only",
      "type": "letter-drop",
      "config": {
        "mode": "drop-in",
        "family": "heading",
        "size": "6vw",
        "lines": [
          { "text": "HELLO", "color": "var(--rainbow-4)" },
          { "text": "WORLD", "color": "var(--rainbow-6)" }
        ]
      }
    },
    {
      "label": "Letter Drop — Hover Only",
      "type": "letter-drop",
      "config": {
        "mode": "hover",
        "family": "heading",
        "size": "5vw",
        "lines": [
          { "text": "HOVER", "color": "var(--secondary-600)" },
          { "text": "EACH", "color": "var(--primary-600)" },
          { "text": "LETTER", "color": "var(--rainbow-1)" }
        ]
      }
    },
    {
      "label": "TypeWriter",
      "type": "typewriter",
      "config": {
        "family": "heading",
        "words": ["All About Us.", "Hey There!", "So Glad You Found Us.", "Lovely to meet you here :)", "How are you Today?"]
      }
    },
    {
      "label": "Word Rotate",
      "type": "word-rotate",
      "config": {
        "family": "heading",
        "words": [
          { "text": "Love wins.", "color": "var(--primary-600)" },
          { "text": "Joy wins.", "color": "var(--secondary-600)" },
          { "text": "Happiness wins.", "color": "var(--primary-400)" },
          { "text": "Comfort wins.", "color": "var(--secondary-400)" },
          { "text": "Safety wins.", "color": "var(--neutral-700)" },
          { "text": "Peace wins.", "color": "var(--primary-800)" }
        ]
      }
    },
    {
      "label": "Scroll Scramble (Linear)",
      "type": "scroll-scramble",
      "config": {
        "mode": "linear",
        "words": [
          { "text": "Meaning", "color": "primary" },
          { "text": "emerges,", "color": "secondary" },
          { "text": "one", "color": "neutral" },
          { "text": "letter", "color": "teal" },
          { "text": "at", "color": "neutral" },
          { "text": "a", "color": "neutral" },
          { "text": "time.", "color": "purple" }
        ]
      }
    }
  ]
}
