{
  "component": "Page",
  "margin": "comfortable",
  "children": [
    {
      "component": "Section", "gap": "none", "container": "5xl",
      "children": [
        { "component": "Heading", "level": 1, "contentHeading": "Getting Started with Mind the Box", "subtitle": "Everything you need to know to begin your journey", "divider": "left", "brandColor": "primary" }
      ]
    },

    { "component": "Section", "gap": "none", "container": "5xl", "children": [
      { "component": "Text", "contentText": "Welcome to Mind the Box. We believe that technology should adapt to people, not the other way around. This guide walks you through the platform, explains what makes it different, and helps you find the settings that work best for you." },

      { "component": "Text", "contentText": "Whether you're a parent looking for accessible learning tools, a teacher building inclusive lesson plans, or someone who just wants a calmer internet experience — you're in the right place." },

      { "component": "Image", "src": "/_Unused Images/Articles hero Image.png", "alt": "Featured content illustration", "altDescriptive": "A colourful illustration used as a hero image to introduce the content page.", "semanticRole": "content-symbol" },

      { "component": "Grid", "variant": "inline", "gap": "sm", "children": [
        { "component": "Badge", "contentBadge": "New", "variant": "fill", "rainbowColor": "rainbow-4", "media": { "component": "Icon", "name": "sparkle-fill", "semanticRole": "decorative" } },
        { "component": "Badge", "contentBadge": "Free", "variant": "outline", "brandColor": "primary" },
        { "component": "Badge", "contentBadge": "Accessible", "variant": "fill", "brandColor": "secondary", "media": { "component": "Icon", "name": "heart-fill", "semanticRole": "decorative" } },
        { "component": "Badge", "contentBadge": "Gradient", "variant": "outline", "gradient": true, "rainbowColor": "rainbow-2", "animatedGradient": true, "media": { "component": "Icon", "name": "paint-brush-fill", "semanticRole": "decorative" } },
        { "component": "Badge", "contentBadge": "Emerge", "variant": "glass", "gradient": true, "gradientEmerge": true, "brandColor": "secondary" }
      ]}
    ]},

    { "component": "Section", "gap": "none", "container": "5xl", "children": [
      { "component": "Heading", "level": 2, "contentHeading": "What is the Your View Panel?", "media": { "component": "Shape", "shape": "hexagon", "size": "lg", "variant": "glass", "brandColor": "primary", "semanticRole": "decorative", "media": { "component": "Icon", "name": "sliders-horizontal-fill", "semanticRole": "decorative" } } },

      { "component": "Text", "contentText": "The Your View panel is the control centre for how the site looks and feels. It's not about accessibility in the medical sense — it's about giving you choices. Think of it like adjusting the seat, mirrors, and steering wheel in a car. The car works without those adjustments, but it works better when it fits you." },

      { "component": "Heading", "level": 3, "contentHeading": "The Three Axes", "media": { "component": "Icon", "name": "sliders-horizontal-fill", "semanticRole": "decorative", "animation": "wiggle", "animationTrigger": "viewport" } },

      { "component": "Text", "contentText": "Every setting falls into one of three independent axes. You can combine them however you like — they don't interfere with each other." },

      { "component": "List", "icon": "arrows-out-fill", "color": "primary", "contentList": [
        "Render — controls how much visual fidelity you see. Full mode shows everything. Calm strips animation and gradients. Easy Click makes touch targets huge. Reading Mode turns the page into a clean printable document.",
        "Hover — controls what happens when you move your mouse over things. Full gives you all the hover effects. Gentle tones them down. Off removes them entirely, which is helpful if you use switch access or find hover effects distracting.",
        "Highlight Links — when turned on, every clickable thing on the page gets a visible outline. Useful if you want to scan a page and quickly see what's interactive."
      ]},

      { "component": "Text", "contentText": "These three settings stack. You could run Full render + No hover + Highlight links, or Calm render + Gentle hover with no link highlights. Any combination works." }
    ]},

    { "component": "Section", "gap": "none", "container": "5xl", "children": [
      { "component": "Heading", "level": 2, "contentHeading": "Choosing a Theme", "variant": "underline", "underlineColor": "secondary", "media": { "component": "Icon", "name": "palette-fill", "semanticRole": "decorative", "draw": true, "drawMode": "fade", "drawGhost": true } },

      { "component": "Text", "contentText": "Mind the Box ships with over a hundred themes. Each theme changes the colour palette, and some themes come with special properties like reduced chroma (fewer bright colours) or dark backgrounds." },

      { "component": "Text", "as": "blockquote", "contentText": "A theme is not an accessibility setting. It's a preference. Like choosing wallpaper for your room — it doesn't change the furniture, just the atmosphere." },

      { "component": "Grid", "variant": "inline", "gap": "sm", "children": [
        { "component": "Shape", "shape": "circle", "size": "xl", "variant": "fill", "brandColor": "primary", "semanticRole": "decorative", "animation": "pulse", "animationTrigger": "loop" },
        { "component": "Shape", "shape": "circle", "size": "xl", "variant": "fill", "brandColor": "secondary", "semanticRole": "decorative", "animation": "pulse", "animationTrigger": "loop" },
        { "component": "Shape", "shape": "circle", "size": "xl", "variant": "fill", "rainbowColor": "rainbow-1", "semanticRole": "decorative" },
        { "component": "Shape", "shape": "circle", "size": "xl", "variant": "fill", "rainbowColor": "rainbow-2", "semanticRole": "decorative" },
        { "component": "Shape", "shape": "circle", "size": "xl", "variant": "fill", "rainbowColor": "rainbow-3", "semanticRole": "decorative" },
        { "component": "Shape", "shape": "circle", "size": "xl", "variant": "fill", "rainbowColor": "rainbow-4", "semanticRole": "decorative" },
        { "component": "Shape", "shape": "circle", "size": "xl", "variant": "fill", "rainbowColor": "rainbow-5", "semanticRole": "decorative" }
      ]},

      { "component": "Heading", "level": 3, "contentHeading": "Dark Mode", "media": { "component": "Icon", "name": "moon-fill", "semanticRole": "decorative", "animation": "pulse", "animationTrigger": "viewport" } },
      { "component": "Text", "contentText": "Any theme can flip to dark mode. Dark mode swaps the background to a deep colour and adjusts text, shadows, and surfaces to stay readable. It's not a separate theme — it's a luminance axis that applies to whichever theme you've chosen." },

      { "component": "Heading", "level": 3, "contentHeading": "High Contrast", "media": { "component": "Icon", "name": "sun-fill", "semanticRole": "decorative", "animation": "glint", "animationTrigger": "viewport" } },
      { "component": "Text", "contentText": "High contrast maximises the difference between text and background. Borders become sharper, colours become bolder, and subtle effects like glass blur are replaced with solid fills. Good for bright environments, low-vision users, or anyone who just prefers clarity over subtlety." },

      { "component": "Heading", "level": 3, "contentHeading": "Calm Mode", "media": { "component": "Icon", "name": "leaf-fill", "semanticRole": "decorative", "animation": "float", "animationTrigger": "loop" } },
      { "component": "Text", "contentText": "Calm mode reduces visual intensity without removing information. Gradients flatten to gentle glass effects. Shadows soften. Animations stop. Badges all normalise to the same quiet style. The content is the same — it just feels quieter." }
    ]},

    { "component": "Section", "gap": "none", "container": "5xl", "children": [
      { "component": "Heading", "level": 2, "contentHeading": "Shapes and Containers", "media": { "component": "Shape", "shape": "star", "size": "lg", "variant": "fill", "gradient": true, "gradientBlend": "sunset", "gradientAnimate": true, "semanticRole": "decorative" } },

      { "component": "Text", "contentText": "Shapes are versatile building blocks that can act as standalone decorative elements, icon containers, or image masks. They come in geometric and organic forms and support the full gradient, draw, and animation systems." },

      { "component": "Grid", "variant": "inline", "gap": "md", "children": [
        { "component": "Shape", "shape": "hexagon", "size": "3xl", "variant": "fill", "gradient": true, "gradientBlend": "hero", "gradientAnimate": true, "gradientAnimateDirection": "cw", "semanticRole": "decorative", "media": { "component": "Icon", "name": "lightning-fill", "semanticRole": "decorative" } },
        { "component": "Shape", "shape": "diamond", "size": "3xl", "variant": "outline", "brandColor": "secondary", "borderWeight": "md", "semanticRole": "decorative", "draw": true, "drawMode": "yoyo", "drawGhost": true, "media": { "component": "Icon", "name": "star-fill", "semanticRole": "decorative" } },
        { "component": "Shape", "shape": "blob", "size": "3xl", "variant": "glass", "rainbowColor": "rainbow-5", "semanticRole": "decorative", "animation": "float", "animationTrigger": "loop", "media": { "component": "Icon", "name": "flower-fill", "semanticRole": "decorative" } },
        { "component": "Shape", "shape": "circle", "size": "3xl", "variant": "fill", "gradient": true, "gradientBlend": "rainbow", "gradientAnimate": true, "gradientAnimateDirection": "sway", "semanticRole": "decorative", "media": { "component": "Icon", "name": "globe-fill", "semanticRole": "decorative" } }
      ]},

      { "component": "Heading", "level": 3, "contentHeading": "Draw Animations", "media": { "component": "Icon", "name": "pencil-line-fill", "semanticRole": "decorative", "draw": true, "drawMode": "yoyo", "drawLaser": true } },

      { "component": "Text", "contentText": "The draw system traces SVG paths to life using GSAP's DrawSVGPlugin. Icons and shapes can draw on viewport entry, hover, or scrub with scroll. Combine with ghost strokes, laser trails, and gradient lines for rich visual storytelling." },

      { "component": "Grid", "variant": "inline", "gap": "md", "children": [
        { "component": "Icon", "name": "rocket-fill", "semanticRole": "content-symbol", "label": "Launch", "size": "4xl", "draw": true, "drawMode": "static", "drawGhost": true, "rainbowColor": "rainbow-1" },
        { "component": "Icon", "name": "compass-fill", "semanticRole": "decorative", "size": "4xl", "draw": "drawcenter", "drawMode": "yoyo", "drawLaser": true, "brandColor": "secondary" },
        { "component": "Icon", "name": "gear-six-fill", "semanticRole": "content-symbol", "label": "Settings", "size": "4xl", "fillAnimation": true, "fillOutline": true, "fillMode": "reduced", "brandColor": "primary" }
      ]},

      { "component": "Heading", "level": 3, "contentHeading": "Morph Transitions" },

      { "component": "Text", "contentText": "Icons can morph between two shapes on hover using GSAP's MorphSVGPlugin. The goo convergence technique creates smooth organic transitions between any two icon forms." },

      { "component": "Grid", "variant": "inline", "gap": "md", "children": [
        { "component": "Icon", "name": "sun-fill", "semanticRole": "content-symbol", "label": "Light mode", "size": "4xl", "morphTo": "moon-fill", "brandColor": "primary" },
        { "component": "Icon", "name": "moon-fill", "semanticRole": "content-symbol", "label": "Dark mode", "size": "4xl", "morphTo": "sun-fill", "brandColor": "primary" },
        { "component": "Icon", "name": "heart-fill", "semanticRole": "decorative", "size": "4xl", "morphTo": "heart-break-fill", "rainbowColor": "rainbow-1" },
        { "component": "Icon", "name": "play-fill", "semanticRole": "decorative", "size": "4xl", "morphTo": "pause-fill", "rainbowColor": "rainbow-3" }
      ]}
    ]},

    { "component": "Section", "gap": "none", "container": "5xl", "children": [
      { "component": "Heading", "level": 2, "contentHeading": "Gradient Badges", "media": { "component": "Icon", "name": "paint-bucket-fill", "semanticRole": "decorative", "gradient": true, "gradientBlend": "hero" } },

      { "component": "Text", "contentText": "Badges support the full gradient system. Fill badges get gradient backgrounds, outline and glass badges get gradient text. The gradientFlip prop reverses the gradient direction on text so it reads naturally opposite to the border." },

      { "component": "Grid", "variant": "inline", "gap": "sm", "children": [
        { "component": "Badge", "contentBadge": "Hero blend", "variant": "fill", "gradient": true, "gradientBlend": "hero", "media": { "component": "Icon", "name": "fire-fill", "semanticRole": "decorative" } },
        { "component": "Badge", "contentBadge": "Sunset", "variant": "fill", "gradient": true, "gradientBlend": "sunset" },
        { "component": "Badge", "contentBadge": "Rainbow", "variant": "outline", "gradient": true, "gradientBlend": "rainbow", "animatedGradient": true },
        { "component": "Badge", "contentBadge": "Animated", "variant": "fill", "gradient": true, "rainbowColor": "rainbow-3", "animatedGradient": true, "gradientAnimateDirection": "sway" },
        { "component": "Badge", "contentBadge": "Cycle", "variant": "glass", "gradient": true, "brandColor": "primary", "gradientCycle": true, "animatedGradient": true },
        { "component": "Badge", "contentBadge": "Emerge", "variant": "outline", "gradient": true, "gradientEmerge": true, "brandColor": "secondary" },
        { "component": "Badge", "contentBadge": "Fade out", "variant": "glass", "gradient": true, "gradientFade": true, "rainbowColor": "rainbow-6" },
        { "component": "Badge", "contentBadge": "Flip text", "variant": "outline", "gradient": true, "gradientFlip": true, "rainbowColor": "rainbow-4" }
      ]},

      { "component": "Text", "contentText": "Badges with a heading level render through the Heading atom for semantic structure. Gradient text uses the Heading atom's gradient pipeline regardless of level." },

      { "component": "Grid", "variant": "inline", "gap": "sm", "children": [
        { "component": "Badge", "contentBadge": "Heading badge", "level": 4, "variant": "outline", "gradient": true, "gradientBlend": "hero" },
        { "component": "Badge", "contentBadge": "Tier tint", "variant": "fill", "gradient": true, "rainbowColor": "rainbow-1", "colorTier": "tint" },
        { "component": "Badge", "contentBadge": "Tier emphasis", "variant": "fill", "gradient": true, "brandColor": "primary", "colorTier": "emphasis" },
        { "component": "Badge", "contentBadge": "Radial", "variant": "fill", "gradient": true, "gradientType": "radial", "rainbowColor": "rainbow-5" }
      ]}
    ]},

    { "component": "Section", "gap": "none", "container": "5xl", "children": [
      { "component": "Heading", "level": 2, "contentHeading": "Working with Content", "media": { "component": "Icon", "name": "article-fill", "semanticRole": "decorative" } },

      { "component": "Text", "contentText": "Every piece of text on the platform goes through one of two atoms: Text for body content, and Heading for titles. This guarantees consistent typography across every page, in every theme, in every render mode." },

      { "component": "Heading", "level": 3, "contentHeading": "Lists with Shape Markers" },

      { "component": "Text", "contentText": "Lists can use shapes as markers instead of icons or dots. Pass a media object with a Shape component to get geometric markers that participate in the full colour and gradient system." },

      { "component": "List", "contentList": [
        "First item with a shape marker — shapes scale with text using em-based tokens",
        "Second item — the shape inherits the list's colour unless overridden",
        "Third item — shapes can also contain icons for compound markers"
      ], "media": { "component": "Shape", "shape": "diamond", "variant": "fill", "brandColor": "primary", "semanticRole": "decorative" } },

      { "component": "List", "contentList": [
        "Gradient shape markers work beautifully in lists",
        "Each marker is a Shape atom with its own gradient props",
        "The list component renders each marker consistently"
      ], "media": { "component": "Shape", "shape": "circle", "variant": "fill", "gradient": true, "gradientBlend": "hero", "semanticRole": "decorative" } },

      { "component": "Heading", "level": 4, "contentHeading": "Workbook Printing" },
      { "component": "Text", "contentText": "Parents and teachers often want to print pages as workbooks. Reading Mode turns any page into a clean, single-column layout that prints beautifully. Decorative shapes, gradients, and animations are stripped. Icons with meaning stay. Links are underlined so you can see them on paper." },

      { "component": "Text", "contentText": "To print a page:" },
      { "component": "List", "as": "ol", "contentList": [
        "Open the Your View panel",
        "Set Render to Reading Mode",
        "Use your browser's Print function",
        "Choose 'Save as PDF' for a digital workbook"
      ]},

      { "component": "Heading", "level": 4, "contentHeading": "Navigation" },
      { "component": "Text", "contentText": "The platform uses keyboard navigation throughout. Every interactive element is focusable, and the tab order follows the visual layout. If you use switch access or eye gaze, the Easy Click render mode enlarges all targets to at least 64 pixels." },

      { "component": "List", "variant": "none", "contentList": [
        { "contentLink": "Keyboard shortcuts reference", "href": "/docs/keyboard" },
        { "contentLink": "Switch access setup guide", "href": "/docs/switch" },
        { "contentLink": "Eye gaze compatibility", "href": "/docs/eyegaze" },
        { "contentLink": "Screen reader tips", "href": "/docs/screenreader" }
      ]}
    ]},

    { "component": "Section", "gap": "none", "container": "5xl", "children": [
      { "component": "Heading", "level": 2, "contentHeading": "Icon Animations", "media": { "component": "Shape", "shape": "rounded", "size": "lg", "variant": "glass", "brandColor": "secondary", "semanticRole": "decorative", "media": { "component": "Icon", "name": "sparkle-fill", "semanticRole": "decorative", "animation": "twinkle", "animationTrigger": "loop" } } },

      { "component": "Text", "contentText": "Icons support 30 named animations, each with configurable triggers. Viewport-triggered animations play once as the icon scrolls into view. Loop animations repeat continuously. Hover and click triggers respond to user interaction." },

      { "component": "Grid", "variant": "inline", "gap": "md", "children": [
        { "component": "Icon", "name": "rocket-launch-fill", "semanticRole": "decorative", "size": "3xl", "animation": "bounce", "animationTrigger": "loop", "rainbowColor": "rainbow-1" },
        { "component": "Icon", "name": "heart-fill", "semanticRole": "decorative", "size": "3xl", "animation": "heartbeat", "animationTrigger": "loop", "rainbowColor": "rainbow-1" },
        { "component": "Icon", "name": "bell-fill", "semanticRole": "decorative", "size": "3xl", "animation": "swing", "animationTrigger": "loop", "rainbowColor": "rainbow-2" },
        { "component": "Icon", "name": "lightning-fill", "semanticRole": "decorative", "size": "3xl", "animation": "flash", "animationTrigger": "loop", "rainbowColor": "rainbow-3" },
        { "component": "Icon", "name": "star-fill", "semanticRole": "decorative", "size": "3xl", "animation": "spin", "animationTrigger": "loop", "rainbowColor": "rainbow-4" },
        { "component": "Icon", "name": "hand-waving-fill", "semanticRole": "decorative", "size": "3xl", "animation": "wiggle", "animationTrigger": "loop", "rainbowColor": "rainbow-5" },
        { "component": "Icon", "name": "confetti-fill", "semanticRole": "decorative", "size": "3xl", "animation": "celebrate", "animationTrigger": "loop", "rainbowColor": "rainbow-6" },
        { "component": "Icon", "name": "ghost-fill", "semanticRole": "decorative", "size": "3xl", "animation": "float", "animationTrigger": "loop", "rainbowColor": "rainbow-7" }
      ]},

      { "component": "Heading", "level": 3, "contentHeading": "Fill Animations" },

      { "component": "Text", "contentText": "Fill animations bloom colour from the centre of an icon on hover. Combine with outline draws, laser trails, and custom easing for sophisticated reveal sequences." },

      { "component": "Grid", "variant": "inline", "gap": "md", "children": [
        { "component": "Icon", "name": "shield-check-fill", "semanticRole": "content-symbol", "label": "Verified", "size": "4xl", "fillAnimation": true, "fillMode": "yoyo", "fillTrigger": "hover", "brandColor": "primary" },
        { "component": "Icon", "name": "trophy-fill", "semanticRole": "decorative", "size": "4xl", "fillAnimation": true, "fillMode": "once", "fillOutline": true, "fillDrawLaser": true, "rainbowColor": "rainbow-4" },
        { "component": "Icon", "name": "crown-fill", "semanticRole": "decorative", "size": "4xl", "fillAnimation": true, "fillMode": "twinkle", "fillTrigger": "loop", "rainbowColor": "rainbow-2" }
      ]}
    ]},

    { "component": "Section", "gap": "none", "container": "5xl", "children": [
      { "component": "Heading", "level": 2, "contentHeading": "Getting Help", "media": { "component": "Shape", "shape": "circle", "size": "lg", "variant": "fill", "gradient": true, "gradientBlend": "rainbow", "gradientAnimate": true, "gradientAnimateDirection": "sway", "semanticRole": "decorative", "media": { "component": "Icon", "name": "lifebuoy-fill", "semanticRole": "decorative" } } },

      { "component": "Text", "contentText": "If something doesn't work, or if you have ideas for how we could make the platform better, we'd love to hear from you. The feedback form is always available from the main menu." },

      { "component": "Grid", "variant": "inline", "gap": "sm", "children": [
        { "component": "Badge", "contentBadge": "Email us", "variant": "outline", "brandColor": "primary", "media": { "component": "Icon", "name": "envelope-fill", "semanticRole": "decorative" }, "semanticRole": "label" },
        { "component": "Badge", "contentBadge": "Community", "variant": "outline", "brandColor": "secondary", "media": { "component": "Icon", "name": "users-fill", "semanticRole": "decorative" }, "semanticRole": "label" },
        { "component": "Badge", "contentBadge": "Documentation", "variant": "outline", "gradient": true, "gradientBlend": "rainbow", "animatedGradient": true, "media": { "component": "Icon", "name": "book-open-fill", "semanticRole": "decorative" }, "semanticRole": "label" }
      ]},

      { "component": "Text", "contentText": "Thank you for being part of this. Every person who uses the platform makes it better for the next person who arrives.", "weight": "medium", "family": "handwriting", "size": "lg", "highlight": true, "highlightColor": "primary", "highlightOpacity": "faint", "highlightHeight": "full" }
    ]}
  ]
}
