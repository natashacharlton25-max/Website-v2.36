{
  "page": {
    "title": "Test Page — Badge Atom",
    "hideFooter": true,
    "container": "7xl"
  },
  "colour": {
    "badgeBorder": "var(--primary-700)"
  },
  "layout": {
    "sectionGap": "6xl",
    "itemGap": "lg"
  },
  "title": { "level": 1, "text": "Badge Atom Test", "align": "center", "flush": true },
  "sections": [
    { "label": "Variants", "items": [
      { "label": "Fill (default)", "variant": "fill" },
      { "label": "Fill Secondary", "variant": "fill", "color": "secondary", "style": "--badge-bg: var(--secondary-200); --badge-text: var(--secondary-800)" },
      { "label": "Outline", "variant": "outline" },
      { "label": "Outline Secondary", "variant": "outline", "color": "secondary", "style": "--badge-border: var(--secondary-400); --badge-text: var(--secondary-800)" },
      { "label": "Glass", "variant": "glass" }
    ]},
    { "label": "Sizes", "items": [
      { "label": "Small Badge", "size": "sm" },
      { "label": "Medium Badge", "size": "md" },
      { "label": "Large Badge", "size": "lg" }
    ]},
    { "label": "Shapes", "items": [
      { "label": "Rounded", "shape": "rounded" },
      { "label": "Pill", "shape": "pill" },
      { "label": "Squared", "shape": "squared" }
    ]},
    { "label": "Icons", "items": [
      { "label": "With Icon", "icon": "shield-check-fill" },
      { "label": "Star", "icon": "star-fill", "color": "secondary", "style": "--badge-bg: var(--secondary-200); --badge-text: var(--secondary-800)" },
      { "label": "Warning", "icon": "warning-fill", "color": "warning", "variant": "outline", "style": "--badge-border: var(--color-Warning); --badge-text: var(--color-Warning)" },
      { "label": "Error", "icon": "x-circle-fill", "color": "error", "variant": "fill", "style": "--badge-bg: var(--color-Error); --badge-text: var(--color-White)" },
      { "label": "Success", "icon": "check-circle-fill", "color": "success", "variant": "fill", "style": "--badge-bg: var(--color-Success); --badge-text: var(--color-White)" },
      { "label": "Info", "icon": "info-fill", "color": "info", "variant": "fill", "style": "--badge-bg: var(--color-Info); --badge-text: var(--color-White)" }
    ]},
    { "label": "Colours (theme tokens)", "items": [
      { "label": "Primary", "color": "primary" },
      { "label": "Secondary", "color": "secondary", "style": "--badge-bg: var(--secondary-200); --badge-text: var(--secondary-800)" },
      { "label": "Neutral", "color": "neutral", "style": "--badge-bg: var(--neutral-300); --badge-text: var(--neutral-800)" },
      { "label": "Success", "color": "success", "style": "--badge-bg: var(--color-Success); --badge-text: var(--color-White)" },
      { "label": "Warning", "color": "warning", "style": "--badge-bg: var(--color-Warning); --badge-text: var(--color-Black)" },
      { "label": "Error", "color": "error", "style": "--badge-bg: var(--color-Error); --badge-text: var(--color-White)" },
      { "label": "Info", "color": "info", "style": "--badge-bg: var(--color-Info); --badge-text: var(--color-White)" }
    ]},
    { "label": "Uppercase & Case", "items": [
      { "label": "UPPERCASE (default)", "uppercase": true },
      { "label": "Normal case", "uppercase": false }
    ]},
    { "label": "With Heading Level", "items": [
      { "label": "Badge as H2", "level": 2, "size": "lg" },
      { "label": "Badge as H3", "level": 3, "color": "secondary", "style": "--badge-bg: var(--secondary-200); --badge-text: var(--secondary-800)" },
      { "label": "Badge as H4", "level": 4, "size": "sm", "color": "neutral", "style": "--badge-bg: var(--neutral-300); --badge-text: var(--neutral-800)" }
    ]},
    { "label": "Semantic Roles", "items": [
      { "label": "Status", "semanticRole": "status", "color": "success", "icon": "check-circle-fill", "style": "--badge-bg: var(--color-Success); --badge-text: var(--color-White)" },
      { "label": "Tag", "semanticRole": "tag" },
      { "label": "Label", "semanticRole": "label", "color": "neutral", "variant": "outline", "style": "--badge-border: var(--neutral-400); --badge-text: var(--neutral-800)" },
      { "label": "None (decorative)", "semanticRole": "none", "color": "neutral", "style": "--badge-bg: var(--neutral-300); --badge-text: var(--neutral-800)" }
    ]},
    { "label": "Combinations", "items": [
      { "label": "Featured", "icon": "star-fill", "variant": "fill", "shape": "pill", "size": "lg", "style": "--badge-bg: var(--primary-600); --badge-text: var(--color-White)" },
      { "label": "NEW", "color": "success", "variant": "fill", "shape": "pill", "size": "sm", "style": "--badge-bg: var(--color-Success); --badge-text: var(--color-White)" },
      { "label": "Premium", "icon": "crown-fill", "variant": "glass", "shape": "pill" },
      { "label": "Draft", "color": "neutral", "variant": "outline", "shape": "squared", "uppercase": false, "style": "--badge-border: var(--neutral-400); --badge-text: var(--neutral-600)" },
      { "label": "Verified", "color": "info", "icon": "seal-check-fill", "variant": "fill", "shape": "rounded", "style": "--badge-bg: var(--color-Info); --badge-text: var(--color-White)" }
    ]}
  ]
}
