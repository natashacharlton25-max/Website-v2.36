---
import { Font } from 'astro:assets';
import '../styles/global.css';
import '../styles/themes/brand/mind-the-box/brand-overrides.css';
import GlassNav from '../components/organisms/nav/GlassNav.astro';
import Footer from '../components/organisms/Footer/Footer.astro';
import CookieBanner from '../components/molecules/global/CookieBanner.astro';
import MiniCart from '../components/organisms/shop/MiniCart.astro';
import AccessibilityPanel from '../components/YourView/AccessibilityPanel.astro';
import ContactPopup from '../components/molecules/contact/ContactPopup.astro';
import CustomScrollbar from '../components/molecules/global/CustomScrollbar/CustomScrollbar.astro';
import SvgGradientDefs from '../components/atoms/SvgGradientDefs.astro';
import { Toast } from '../components/molecules/Toast';
import { BRAND_CONFIG } from '../lib/config/brand';


interface Props {
  title?: string;
  description?: string;
  image?: string;
  hideFooter?: boolean;
}

const {
  title = BRAND_CONFIG.seo.defaultTitle,
  description = BRAND_CONFIG.seo.defaultDescription,
  image = BRAND_CONFIG.seo.defaultImage,
  hideFooter = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>

  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={image}>

  <!-- Twitter/X sharing -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={image}>

  <title>{title}</title>

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/Logo/Favicon.png">

  <!-- Astro Fonts — preload + @font-face injected at build time -->
  <Font cssVariable="--font-quicksand" />
  <Font cssVariable="--font-caveat" />
  <Font cssVariable="--font-lora" />
  <Font cssVariable="--font-atkinson" />
  <Font cssVariable="--font-sukar" />
  <Font cssVariable="--font-crumbo" />
  <Font cssVariable="--font-opendyslexic" />

  <!-- Font Awesome (for icons) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <!-- Lottie Player for animated icons -->
  <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>

  <!-- Prevent flash of default theme -->
  <script is:inline>
    try {
      var st = localStorage.getItem('color-theme');
      if (st && st !== 'default') {
        document.documentElement.style.opacity = '0';
        document.documentElement.style.transition = 'opacity 0.15s ease';
        setTimeout(function() { document.documentElement.style.opacity = ''; }, 1500);
      }
    } catch(e) {}
  </script>

  <!-- Early accessibility restoration (prevents flash) -->
  <script is:inline>
    // Restore text-only mode immediately before body renders
    try {
      var settings = JSON.parse(localStorage.getItem('a11y-settings') || '{}');
      if (settings.textOnly) {
        document.documentElement.classList.add('a11y-text-only-pending');
        document.documentElement.setAttribute('data-render', 'textonly');
      } else if (settings.reduceMotion) {
        document.documentElement.setAttribute('data-render', 'reduced');
      }
    } catch (e) {}
  </script>
</head>
<body data-btn-theme="flat">
  <SvgGradientDefs />
  <!-- Early a11y state restoration - adds classes to wrapper when it exists -->
  <script is:inline>
    // Wait for wrapper to exist, then apply saved a11y classes
    const observer = new MutationObserver((mutations, obs) => {
      const wrapper = document.getElementById('a11y-content-wrapper');
      if (wrapper) {
        obs.disconnect();
        try {
          const settings = JSON.parse(localStorage.getItem('a11y-settings') || '{}');
          if (settings.textOnly) wrapper.classList.add('a11y-text-only');
          if (settings.highlightLinks) wrapper.classList.add('a11y-highlight-links');
          if (settings.reduceMotion) wrapper.classList.add('a11y-reduce-motion');
          if (settings.fontFamily && settings.fontFamily !== 'default') {
            wrapper.classList.add('a11y-font-' + settings.fontFamily);
          }
          if (settings.fontSize && settings.fontSize !== 100) {
            wrapper.style.fontSize = settings.fontSize + '%';
          }
        } catch (e) {}
      }
    });
    observer.observe(document.body, { childList: true, subtree: true });
  </script>

  <!-- Focus dim overlay — GSAP controls colour, sits above wrapper -->
  <div class="focus-dim-overlay" aria-hidden="true"></div>

  <!-- A11Y CONTENT WRAPPER - All a11y settings apply to this wrapper, NOT body -->
  <!-- This keeps the AccessibilityPanel immune from its own settings -->
  <div id="a11y-content-wrapper">
    <!-- Navigation -->
    <GlassNav />

    <!-- Main Content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    {!hideFooter && (
      <Footer animated />
    )}

    <!-- Cookie Consent Banner — DEV: temporarily disabled, RE-ENABLE BEFORE PRODUCTION -->
    {/* <CookieBanner /> */}

    <!-- Toast Notifications Container (toasts are shown dynamically via JavaScript) -->
    <div id="toast-container"></div>

    <!-- Pre-rendered toast template — LottieIcon + theme baked in at build -->
    <template id="toast-tpl">
      <Toast message="" />
    </template>

    <!-- Mini Cart Dropdown -->
    <MiniCart />

    <!-- Contact Popup -->
    <ContactPopup />
  </div>

  <!-- Accessibility Panel - OUTSIDE the content wrapper so it's immune to settings -->
  <AccessibilityPanel />

  <!-- Custom Scrollbar - brand styled native scrollbar -->
  <CustomScrollbar />

  <!-- Global Scripts -->
  <script>
    // Import toast notification system
    import { showToast } from '../lib/ui/toast';
    // scroll-animations — loaded by components that need it
    // (PatternOverlay, MasonryGrid, MasonryCard), not globally
    // Import focus system (keyboard focus detection, rainbow, dim, scroll)
    import '../lib/focus/focus-system';
    // Render controller — runtime DOM transforms per render mode
    import '../lib/render-controller';
    // Reload overlay — covers the page during data-motion/hover/render/mode
    // changes so the user never sees the default-then-target jerk while the
    // page reloads with the new setting applied. CSS imported as side-effect.
    // Inject brand reloadOverlay config into globalThis BEFORE the lib loads
    // so it picks up loader + message overrides on its first read.
    import { BRAND_CONFIG } from '../lib/config/brand';
    (globalThis as any).__RELOAD_OVERLAY_CONFIG__ = BRAND_CONFIG.reloadOverlay;
    import '../lib/reload-overlay/reload-overlay.css';
    import '../lib/reload-overlay/reload-overlay';
    // Import custom caret (hides OS caret, renders tokenised custom caret)
    import { initCustomCaret } from '../lib/caret/custom-caret';
    initCustomCaret();
    // Import bookmark (save/restore form position across sessions)
    import { initBookmarkRestore } from '../lib/caret/bookmark';
    initBookmarkRestore();
    // Import smooth scroll (handles anchor links)
    import '../lib/ui/smooth-scroll';
    // Import theme switcher for accessibility themes
    import '../scripts/ThemeSwitcher.js';
    // Import image enlarge modal
    import '../scripts/image-enlarge';
    // Import figcaption alt text tooltip
    import '../components/atoms/FigCaption/figcaption';
    // Import animation explainer display controller
    import '../components/molecules/aac/AnimExplainer/anim-explainer';
    // Import icon draw/morph animations (GSAP)
    import '../lib/animation/icon-animation';
    // Micro-animations now handled by GSAP (icon-animation/micro.ts)
    // via registerTrigger — no separate anim-trigger needed
    // Import theme preview card renderer
    import '../styles/themes/Preview/ThemePreviewTokens.js';
    // Make showToast globally available
    (window as any).showToast = showToast;

    // Global add-to-cart handler
    document.addEventListener('click', function(e) {
      const target = e.target as HTMLElement;
      if (target.matches('.add-to-cart-btn') || target.closest('.add-to-cart-btn')) {
        const button = target.matches('.add-to-cart-btn') ? target : target.closest('.add-to-cart-btn');
        if (!button) return;

        const productId = button.getAttribute('data-product-id');
        const productName = button.getAttribute('data-product-name');
        const productPrice = parseFloat(button.getAttribute('data-product-price') || '0');
        const productImage = button.getAttribute('data-product-image');

        if (productId && productName && (window as any).cart) {
          (window as any).cart.addItem({
            id: productId,
            name: productName,
            price: productPrice,
            image: productImage || '/placeholder.jpg'
          });
        }
      }
    });
  </script>

  <!-- Analytics Placeholder -->
  <script>
    // Add your analytics code here (Google Analytics, Plausible, etc.)
    // Only load if user has given analytics consent
    const consent = (window as any).getCookieConsent?.();
    if (consent?.analytics) {
      // Initialize analytics
      console.log('Analytics enabled');
    }
  </script>
</body>
</html>
