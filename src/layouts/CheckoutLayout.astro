---
/**
 * CheckoutLayout - Layout for the checkout page
 *
 * Provides the checkout page structure: trust header, title, form + summary grid.
 *
 * Props:
 * - title: Page heading text
 *
 * Slots:
 * - trust: Trust badges header
 * - form: Checkout form card (left column)
 * - summary: Download summary card (right column)
 */

interface Props {
  title?: string;
}

const { title = 'Checkout Your Items' } = Astro.props;
---

<section class="checkout-section section">
  <div class="container container-7xl">
    <div class="checkout-trust-header">
      <slot name="trust" />
    </div>

    <div class="checkout-header">
      <h1 class="checkout-title">{title}</h1>
    </div>

    <div class="checkout-content">
      <div class="checkout-forms">
        <div class="card checkout-card">
          <slot name="form" />
        </div>
      </div>

      <div class="order-summary-container">
        <div class="card checkout-card checkout-card--summary">
          <slot name="summary" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ========== PAGE LAYOUT ========== */
  .checkout-section {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-3xl);
    background: var(--page-bg);
    min-height: 100vh;
  }

  .checkout-section.section {
    padding-top: var(--space-2xl);
  }

  .checkout-header {
    margin-bottom: var(--space-3xl);
    text-align: center;
  }

  .checkout-title {
    font-family: var(--font-heading);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-xs);
    color: var(--primary-600);
  }

  .checkout-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  /* ========== TRUST HEADER ========== */
  .checkout-trust-header {
    margin-bottom: var(--space-md);
  }

  .checkout-trust-header :global(.trust-badges) {
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    justify-content: center;
    gap: var(--space-md);
  }

  /* ========== CARD ========== */
  .checkout-card {
    background: transparent;
    background-color: transparent;
    border-radius: var(--border-radius-xl);
    padding: var(--space-xl);
    box-shadow: none;
  }

  .checkout-card:hover {
    transform: none;
    box-shadow: none;
  }

  .checkout-card--summary {
    background: transparent;
  }

  /* ========== FORMS ========== */
  .checkout-forms {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .checkout-card :global(.form-row) {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  .checkout-card :global(.checkout-form .form-input) {
    background: var(--neutral-400);
    border: 1px solid var(--neutral-400);
    transition: all 0.2s ease;
  }

  .checkout-card :global(.checkout-form .form-input:hover) {
    border-color: var(--neutral-700);
  }

  .checkout-card :global(.checkout-form .form-input:focus) {
    background: var(--color-White);
    border-color: var(--primary-600);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--primary-600) 15%, transparent);
  }

  .checkout-card :global(.checkout-form .form-label) {
    font-weight: var(--font-medium);
    color: var(--neutral-800);
  }

  .checkout-card :global(.checkbox-label) {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    cursor: pointer;
    color: var(--neutral-800);
    font-family: var(--font-body);
    line-height: 1.5;
    padding: var(--space-md);
    background: var(--neutral-400);
    border-radius: var(--border-radius-md);
    margin-top: var(--space-sm);
    transition: background 0.2s ease;
  }

  .checkout-card :global(.checkbox-label:hover) {
    background: var(--neutral-400);
  }

  .checkout-card :global(.checkbox-label input[type="checkbox"]) {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: var(--primary-600);
    margin-top: 2px;
    flex-shrink: 0;
  }

  .checkout-card :global(.form-hint) {
    color: var(--neutral-400);
    margin-top: var(--space-xs);
  }

  /* ========== ACTIONS & FOOTER ========== */
  .checkout-card :global(.checkout-actions) {
    text-align: center;
    margin-top: var(--space-xl);
  }

  .checkout-card :global(.checkout-actions .btn) {
    width: 100%;
  }

  .checkout-card :global(.checkout-footer) {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--neutral-400);
    text-align: center;
  }

  .checkout-card :global(.checkout-info) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    color: var(--neutral-800);
    margin-bottom: var(--space-sm);
  }

  .checkout-card :global(.checkout-terms) {
    color: var(--neutral-400);
    text-align: center;
    margin: 0;
  }

  .checkout-card :global(.checkout-terms a) {
    color: var(--primary-800);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .checkout-card :global(.checkout-terms a:hover) {
    color: var(--primary-800);
  }

  /* ========== ORDER SUMMARY ========== */
  .order-summary-container {
    position: relative;
    order: -1;
  }

  .order-summary-container .checkout-card {
    position: static;
  }

  /* ========== RESPONSIVE - TABLET (768px) ========== */
  @media (min-width: 768px) {
    .checkout-card :global(.form-row) {
      grid-template-columns: repeat(2, 1fr);
    }

    .checkout-card {
      padding: var(--space-2xl);
    }
  }

  /* ========== RESPONSIVE - DESKTOP (1024px) ========== */
  @media (min-width: 1024px) {
    .checkout-content {
      grid-template-columns: 1fr 480px;
      gap: var(--space-xl);
    }

    .checkout-forms .checkout-card {
      padding: var(--space-lg);
    }
  }

  /* ========== RESPONSIVE - MEDIUM-SMALL (600px) ========== */
  @media (max-width: 600px) {
    .checkout-card {
      padding: var(--space-lg);
    }

    .checkout-section {
      padding-left: var(--space-sm);
      padding-right: var(--space-sm);
    }
  }

  /* ========== RESPONSIVE - SMALL (400px) ========== */
  @media (max-width: 400px) {
    .checkout-section {
      padding-top: var(--space-xl);
      padding-bottom: var(--space-2xl);
    }

    .checkout-header {
      margin-bottom: var(--space-xl);
    }

    .checkout-card {
      padding: var(--space-md);
    }

    .checkout-card :global(.checkout-form .form-input) {
      padding: var(--space-sm);
    }

    .checkout-card :global(.checkbox-label) {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: var(--space-sm);
      gap: var(--space-xs);
    }

    .checkout-card :global(.checkbox-label input[type="checkbox"]) {
      width: 16px;
      height: 16px;
      margin-top: 0;
    }

    .checkout-card :global(.checkout-actions) {
      margin-top: var(--space-lg);
    }

    .checkout-trust-header {
      margin-bottom: var(--space-md);
      padding-bottom: var(--space-sm);
    }

    .checkout-trust-header :global(.trust-badges) {
      gap: var(--space-xs) !important;
    }

    .checkout-card :global(.checkout-info) {
      flex-direction: column;
      gap: var(--space-xs);
    }

    .checkout-card :global(.checkout-footer) {
      margin-top: var(--space-md);
      padding-top: var(--space-md);
    }
  }

  /* ========== RESPONSIVE - VERY SMALL (300px) ========== */
  @media (max-width: 300px) {
    .checkout-section {
      padding-top: var(--space-lg);
      padding-bottom: var(--space-xl);
    }

    .checkout-header {
      margin-bottom: var(--space-lg);
    }

    .checkout-card {
      padding: var(--space-sm);
    }

    .checkout-card :global(.checkout-form .form-label) {
      text-align: center;
      display: block;
    }

    .checkout-card :global(.checkout-form .form-input) {
      text-align: center;
    }

    .checkout-card :global(.checkbox-label) {
      padding: var(--space-xs);
      gap: var(--space-xs);
    }

    .checkout-card :global(.checkbox-label input[type="checkbox"]) {
      width: 12px;
      height: 12px;
    }

    .checkout-card :global(.checkout-info) {
      text-align: center;
    }

    .checkout-card :global(.checkout-terms) {
      line-height: 1.4;
    }

    .checkout-trust-header :global(.trust-badges) {
      flex-direction: column !important;
      align-items: center !important;
      gap: var(--space-xs) !important;
    }

    .checkout-card :global(.checkout-footer) {
      margin-top: var(--space-sm);
      padding-top: var(--space-sm);
    }
  }

  /* ========== RESPONSIVE - TINY (200px) ========== */
  @media (max-width: 200px) {
    .checkout-section {
      padding-top: var(--space-md);
      padding-bottom: var(--space-lg);
    }

    .checkout-header {
      margin-bottom: var(--space-md);
    }

    .checkout-title {
      word-break: break-word;
    }

    .checkout-content {
      gap: var(--space-md);
    }

    .checkout-card {
      padding: var(--space-xs);
    }

    .checkout-card :global(.checkout-form .form-input) {
      padding: var(--space-xs);
      min-width: 0;
      width: 100%;
      box-sizing: border-box;
    }

    .checkout-card :global(.form-row) {
      gap: var(--space-sm);
    }

    .checkout-card :global(.checkbox-label) {
      padding: var(--space-xs);
      word-break: break-word;
    }

    .checkout-card :global(.checkbox-label input[type="checkbox"]) {
      width: 10px;
      height: 10px;
    }

    .checkout-card :global(.checkout-actions .btn) {
      padding: var(--space-xs) var(--space-sm);
      word-break: break-word;
      white-space: normal;
    }

    .checkout-trust-header {
      margin-bottom: var(--space-sm);
      padding-bottom: var(--space-xs);
    }

    .checkout-trust-header :global(.trust-badges) {
      gap: 4px !important;
    }

    .checkout-card :global(.checkout-info) {
      word-break: break-word;
    }

    .checkout-card :global(.checkout-terms) {
      word-break: break-word;
    }

    .checkout-card :global(.checkout-footer) {
      margin-top: var(--space-xs);
      padding-top: var(--space-xs);
    }
  }
</style>
