---
/**
 * ProductDetailLayout - Layout for product detail pages (assets/[slug])
 *
 * Provides two-section structure:
 * 1. Product gallery + info (2-column grid)
 * 2. Tabbed content area (description, specs, individuals, professionals)
 *
 * Slots:
 * - gallery: Image gallery component (left column)
 * - info: Product info component (right column)
 * - switcher: Tab navigation component
 * - tabs: Tab panel content
 * - (default): Additional sections (share, related products, etc.)
 */
---

<section class="product-detail-section section">
  <div class="container">
    <div class="product-layout">
      <slot name="gallery" />
      <slot name="info" />
    </div>
  </div>
</section>

<section class="product-content-section section">
  <div class="container">
    <div class="content-wrapper">
      <slot name="switcher" />
      <div class="tabs-content">
        <slot name="tabs" />
      </div>
    </div>
  </div>
</section>

<slot />

<style>
  /* Product Detail Section */
  .product-detail-section.section {
    padding-top: var(--space-md);
    padding-bottom: var(--space-2xl);
    position: relative;
    z-index: 1;
  }

  .product-content-section.section {
    position: relative;
    z-index: 2;
    background: var(--page-bg);
  }

  /* Product Layout */
  .product-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3xl);
  }

  /* @media-stripped-0 */  /* @media-stripped-1 */  /* Center the tab switcher */
  .content-wrapper :global(.switcher-container) {
    display: flex;
    justify-content: center;
  }

  /* Neumorphic style for switcher on this page */
  .content-wrapper :global(.switcher-nav) {
    background: linear-gradient(145deg, var(--neutral-400), var(--color-White));
    border: none;
    box-shadow: 4px 4px 12px color-mix(in oklch, var(--neutral-900) 25%, transparent),
                -4px -4px 12px var(--color-White);
  }

  /* @media-stripped-2 */  /* Tab Panels */
  .tabs-content {
    min-height: 400px;
  }

  /* @media-stripped-3 */  .tabs-content :global(.tab-panel) {
    display: none;
    animation: fadeIn 0.3s ease-in;
    color: var(--neutral-800);
  }

  .tabs-content :global(.tab-panel.active) {
    display: block;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Tab Panel Typography */
  .tabs-content :global(.tab-panel h2) {
    font-family: var(--font-heading);
    font-weight: var(--font-bold);
    color: var(--neutral-800);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-lg);
  }

  .tabs-content :global(.tab-panel h3) {
    font-family: var(--font-heading);
    font-weight: var(--font-bold);
    color: var(--neutral-800);
    line-height: var(--leading-tight);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .tabs-content :global(.tab-panel h3:first-child) {
    margin-top: 0;
  }

  .tabs-content :global(.tab-panel p),
  .tabs-content :global(.tab-panel li),
  .tabs-content :global(.tab-panel span),
  .tabs-content :global(.tab-panel div) {
    font-family: var(--font-body);
    color: var(--neutral-800);
    line-height: var(--leading-relaxed);
  }

  .tabs-content :global(.tab-panel p) {
    margin-bottom: var(--space-md);
  }

  .tabs-content :global(.tab-panel p:last-child) {
    margin-bottom: 0;
  }

  .tabs-content :global(.tab-panel ul),
  .tabs-content :global(.tab-panel ol) {
    color: var(--neutral-800);
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
  }

  .tabs-content :global(.tab-panel li) {
    margin-bottom: var(--space-xs);
  }

  .tabs-content :global(.tab-panel a) {
    color: var(--primary-800);
  }

  .tabs-content :global(.tab-panel a:hover) {
    color: var(--primary-800);
  }

  .tabs-content :global(.tab-panel strong),
  .tabs-content :global(.tab-panel b) {
    color: var(--neutral-800);
    font-weight: var(--font-semibold);
  }

  /* Content Sections - For Individuals/Professionals tabs */
  .tabs-content :global(.content-sections) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }

  .tabs-content :global(.content-section) {
    border: none;
    border-radius: var(--border-radius-xl);
    overflow: hidden;
    background: var(--page-bg);
    box-shadow: inset 0 2px 6px color-mix(in oklch, var(--color-Black) 6%, transparent),
                inset 0 1px 3px color-mix(in oklch, var(--color-Black) 4%, transparent);
  }

  .tabs-content :global(.content-section-grid) {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  /* @media-stripped-4 */  /* @media-stripped-5 */  /* @media-stripped-6 */  /* @media-stripped-7 */  .tabs-content :global(.content-section--highlight) {
    border-color: var(--primary-200);
  }

  .tabs-content :global(.content-section .badge) {
    margin: var(--space-lg);
    margin-bottom: 0;
  }

  .tabs-content :global(.content-section__body) {
    padding: var(--space-lg);
    color: var(--neutral-800);
    line-height: var(--leading-relaxed);
  }

  .tabs-content :global(.content-section__body p) {
    margin: 0;
    color: var(--neutral-800);
  }

  .tabs-content :global(.content-section__body p + p) {
    margin-top: var(--space-md);
  }

  /* Very small screens */
  /* @media-stripped-8 */</style>
