---
import BaseLayout from './BaseLayout.astro';
import { BRAND_CONFIG } from '../lib/config/brand';
import LegalNav from '../components/organisms/nav/LegalNav.astro';

interface Props {
  title: string;
  description: string;
  lastUpdated: string;
  currentSlug: string;
}

const { title, description, lastUpdated, currentSlug } = Astro.props;
---

<BaseLayout title={`${title} | ${BRAND_CONFIG.name}`} description={description}>
  <article class="legal-page">
    <section class="legal-header section-sm">
      <div class="container container-prose">
        <h1 class="legal-title">{title}</h1>
        <p class="legal-meta">Last updated: {lastUpdated}</p>
      </div>
    </section>

    <section class="legal-content section">
      <div class="container container-prose">
        <div class="prose">
          <slot />
        </div>

        <LegalNav currentSlug={currentSlug} />
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .legal-header {
    background: transparent;
    border-bottom: 1px solid color-mix(in oklch, var(--color-Black) 10%, transparent);
  }

  .legal-title {
    font-weight: var(--font-bold);
    margin-bottom: var(--space-md);
    color: var(--neutral-800);
  }

  .legal-meta {
    color: var(--neutral-400);
    margin: 0;
  }
</style>
