{
  "_description": "Shared enums — single source of truth. Grouped by canonical schema sections.",

  "colour": {
    "brand": ["primary", "secondary", "neutral"],
    "rainbow": ["red", "orange", "yellow", "teal", "blue", "purple", "pink"],
    "all": ["primary", "secondary", "neutral", "red", "orange", "yellow", "teal", "blue", "purple", "pink"],
    "colourTier": ["tint", "mid", "base", "emphasis"]
  },

  "visual": {
    "variant": ["fill", "outline", "glass", "liquid-glass"],
    "shape": ["sharp", "subtle", "soft", "rounded", "pill"],
    "size": ["sm", "md", "lg"],
    "shadow": ["none", "out", "drop", "in", "elevated", "glow", "glow-intense", "glow-inner"],
    "textShadow": ["none", "out", "drop", "in", "elevated", "glow", "glow-intense", "glow-inner"],
    "borderWeight": ["thin", "thick"],
    "fontFamily": ["heading", "body", "body-alt", "handwriting", "mono"],
    "fontWeight": ["normal", "medium", "semibold", "bold", "extrabold"],
    "iconWeight": ["brand", "fill", "duotone", "regular", "bold", "thin", "light"]
  },

  "gradient": {
    "_description": "gradient: boolean enables gradient. gradientBlend selects named blends. direction/spread control composable gradients.",
    "blend": ["hero", "sunset", "brand-emerge", "brand-fade", "emerge", "fade", "preset-tint", "preset-mid", "preset-base", "preset-emphasis"],
    "direction": ["vertical", "vertical-reverse", "horizontal", "horizontal-reverse", "diagonal", "diagonal-reverse", "diagonal-alt", "diagonal-alt-reverse"],
    "type": ["linear", "radial"],
    "focus": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"],
    "spread": ["soft", "balanced", "tight"],
    "rules": {
      "gradient": "boolean — enables gradient from tier tokens",
      "gradientBlend": "named blend — overrides computed gradient",
      "emerge": "page-bg → colour (appears from background)",
      "fade": "colour → page-bg (dissolves into background)",
      "presets": "fixed 135deg curated gradients (preset-tint/mid/base/emphasis)",
      "fillText": "soft → --color-Black, balanced/tight → --color-White",
      "outlineText": "background-clip:text, sized at --_grad-size (25rem)",
      "iconInGradient": "always solid colour, never gradient",
      "animatedGradient": "boolean — independent of animation prop"
    }
  },

  "animation": {
    "animation": ["spin", "bounce", "shake", "float", "drift", "slide-up", "slide-down", "slide-left", "slide-right", "flip", "pulse", "ping", "pop", "squish", "heartbeat", "rubber-band", "fade", "blink", "flash", "glint", "shimmer", "twinkle", "wiggle", "swing", "rock", "nod", "attention", "celebrate", "enter", "exit"],
    "animationTrigger": ["viewport", "autoplay", "loop", "interval", "none"],
    "animationTriggerInteractive": ["hover", "viewport", "autoplay", "loop", "interval", "click", "focus", "none"]
  },

  "content": {
    "semanticRole": ["status", "tag", "label", "none"]
  }
}
