{
  "_description": "Shared enums — single source of truth. Grouped by canonical schema sections.",

  "colour": {
    "brand": ["primary", "secondary", "neutral"],
    "rainbow": ["red", "orange", "yellow", "teal", "blue", "purple", "pink"],
    "all": ["primary", "secondary", "neutral", "red", "orange", "yellow", "teal", "blue", "purple", "pink"],
    "colourTier": ["tint", "mid", "base", "emphasis"]
  },

  "visual": {
    "variant": ["fill", "outline", "glass", "liquid-glass"],
    "headingVariant": ["default", "underline", "highlight", "minimal"],
    "shape": ["sharp", "subtle", "soft", "rounded", "pill"],
    "size": ["sm", "md", "lg"],
    "headingSize": ["h1", "h2", "h3", "h4", "h5", "h6"],
    "textSize": ["xs", "sm", "base", "lg", "xl"],
    "shadow": ["none", "out", "drop", "in", "elevated", "glow", "glow-intense", "glow-inner"],
    "textShadow": ["none", "out", "drop", "in", "elevated", "glow", "glow-intense", "glow-inner"],
    "borderWeight": ["thin", "thick"],
    "fontFamily": ["heading", "body", "body-alt", "handwriting", "mono"],
    "fontWeight": ["normal", "medium", "semibold", "bold", "extrabold"],
    "iconWeight": ["light", "regular", "bold", "fill", "duotone"],
    "alignment": ["left", "center", "right"],
    "tracking": ["normal", "wide", "wider"],
    "spacing": ["tight", "normal", "loose"],
    "highlightHeight": ["sm", "md", "lg", "full"],
    "highlightOpacity": ["faint", "soft", "bold", "solid"],
    "underlineStyle": ["solid", "gradient", "dashed", "dotted"],
    "underlineGap": ["close", "default", "loose"],
    "underlineThickness": ["sm", "md", "lg"],
    "dividerPosition": ["left", "right", "both", "none"],
    "dividerEnds": ["rounded", "square"],
    "mediaPosition": ["left", "right"],
    "mediaSize": ["sm", "md", "lg", "auto"]
  },

  "gradient": {
    "_description": "gradient: boolean enables gradient. gradientBlend selects named blends. direction/spread control composable gradients.",
    "blend": ["hero", "sunset", "brand-emerge", "brand-fade", "preset-tint", "preset-mid", "preset-base", "preset-emphasis"],
    "direction": ["vertical", "vertical-reverse", "horizontal", "horizontal-reverse", "diagonal", "diagonal-reverse", "diagonal-alt", "diagonal-alt-reverse"],
    "type": ["linear", "radial"],
    "focus": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"],
    "spread": ["soft", "balanced", "tight"]
  },

  "animation": {
    "animation": ["spin", "bounce", "shake", "float", "drift", "slide-up", "slide-down", "slide-left", "slide-right", "flip", "pulse", "ping", "pop", "squish", "heartbeat", "rubber-band", "fade", "blink", "flash", "glint", "shimmer", "twinkle", "wiggle", "swing", "rock", "nod", "attention", "celebrate", "enter", "exit"],
    "animationTrigger": ["viewport", "autoplay", "loop", "interval", "none"],
    "animationTriggerInteractive": ["hover", "viewport", "autoplay", "loop", "interval", "click", "focus", "none"],
    "drawVariant": ["draw", "drawcenter", "pulse"],
    "drawMode": ["once", "static", "yoyo", "reverse-yoyo"]
  },

  "content": {
    "semanticRole": ["status", "tag", "label", "none"],
    "iconSemanticRole": ["decorative", "ui-control", "content-symbol"]
  },

  "behaviour": {
    "_description": "Input behaviour and HTML form attributes. WCAG-driven enums.",
    "inputType": ["text", "email", "textarea", "checkbox", "radio", "toggle", "search", "select", "number", "tel", "url", "password", "card-select"],
    "inputMode": ["none", "text", "decimal", "numeric", "tel", "search", "email", "url"],
    "checkDisplay": ["checkbox", "radio", "toggle"],
    "autocomplete": [
      "off", "on",
      "name", "honorific-prefix", "given-name", "additional-name", "family-name", "honorific-suffix", "nickname",
      "email", "username", "new-password", "current-password", "one-time-code",
      "organization-title", "organization",
      "street-address", "address-line1", "address-line2", "address-line3",
      "address-level4", "address-level3", "address-level2", "address-level1",
      "country", "country-name", "postal-code",
      "cc-name", "cc-given-name", "cc-additional-name", "cc-family-name",
      "cc-number", "cc-exp", "cc-exp-month", "cc-exp-year", "cc-csc", "cc-type",
      "transaction-currency", "transaction-amount",
      "language",
      "bday", "bday-day", "bday-month", "bday-year", "sex",
      "tel", "tel-country-code", "tel-national", "tel-area-code", "tel-local", "tel-extension",
      "impp", "url", "photo"
    ]
  },

  "identity": {
    "_description": "Patterns for technical identifiers. WCAG 4.1.1 — IDs must be unique and valid.",
    "idPattern": "^[a-z][a-z0-9-]*$",
    "_idPatternDescription": "Kebab-case, leading letter. Matches CSS-safe and HTML-id-safe naming."
  }
}
